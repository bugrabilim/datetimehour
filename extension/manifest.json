{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Saat Tarih",
  "description": "__MSG_description__",
  "version": "1.0.0",
  "default_locale": "en",
  "homepage_url": "https://time.bumba.tr",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup.html",
