    "alarm.preAlarmNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmdan önce kısık yağmur sesi ve hafif bir çan sizi yavaşça uyandırmaya başlar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before the alarm, soft rain and a gentle chime start waking you slowly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Wecker beginnen leiser Regen und ein sanfter Klang, Sie langsam zu wecken."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəngdən əvvəl zəif yağış səsi və yüngül zınqırov səsi sizi yavaş-yavaş oyatmağa başlayır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل المنبّه يبدأ صوت مطر خافت وجرس رقيق بإيقاظك تدريجيًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelum alarm, suara hujan pelan dan denting lembut mulai membangunkan Anda perlahan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم سے پہلے ہلکی بارش اور نرم گھنٹی آپ کو آہستہ جگانا شروع کرتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از زنگ، صدای آرام باران و زنگی ملایم کم‌کم بیدارتان می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant l’alarme, une pluie douce et un léger carillon commencent à vous réveiller doucement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед будильником тихий дождь и мягкий звон начинают постепенно будить вас."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームの前に、静かな雨音とやさしいチャイムでゆっくり起こし始めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 전에 잔잔한 빗소리와 은은한 종소리로 천천히 깨우기 시작합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟响起前，轻柔的雨声和铃声会慢慢唤醒你。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bago ang alarm, mahinang ulan at banayad na tunog ang dahan-dahang gigising sa iyo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนปลุก เสียงฝนเบาๆ และเสียงกระดิ่งนุ่มๆ จะค่อยๆ ปลุกคุณ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de la alarma, una lluvia suave y una campanilla tenue empiezan a despertarle poco a poco."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes do alarme, uma chuva leve e um sino suave começam a acordar você aos poucos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म से पहले हल्की बारिश और धीमी घंटी आपको धीरे-धीरे जगाना शुरू करती हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্মের আগে নরম বৃষ্টির শব্দ ও কোমল ঘণ্টাধ্বনি আপনাকে ধীরে জাগাতে শুরু করে।"
          }
        }
      }
    },
