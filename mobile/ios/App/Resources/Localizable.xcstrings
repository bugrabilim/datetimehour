    "track.whenNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız aynı gün Vakitler ekranından işaretlenen vakitlerden hesaplanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only from prayers checked on the prayer times screen on the same day."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur aus Gebeten, die am selben Tag auf dem Gebetszeiten-Bildschirm markiert wurden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız həmin gün Vaxtlar ekranından işarələnən vaxtlardan hesablanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب فقط من الصلوات المعلَّمة في شاشة المواقيت في اليوم نفسه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya dari salat yang ditandai di layar waktu salat pada hari yang sama."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف انہی نمازوں سے جو اسی دن اوقات کی اسکرین پر نشان لگائی گئیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط از وقت‌هایی که همان روز در صفحه اوقات علامت خورده‌اند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé uniquement à partir des prières cochées le jour même sur l’écran des horaires."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только по намазам, отмеченным на экране времени в тот же день."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当日に礼拝時刻の画面でチェックした礼拝のみから計算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 날 기도 시간 화면에서 표시한 예배만으로 계산합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅根据当天在礼拜时间页面勾选的记录计算。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mula lamang sa mga dasal na minarkahan sa screen ng oras ng dasal sa parehong araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำนวณจากเวลาที่ทำเครื่องหมายในหน้าจอเวลาละหมาดในวันเดียวกันเท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con las oraciones marcadas en la pantalla de horarios el mismo día."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só com as orações marcadas na tela de horários no mesmo dia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल उन नमाज़ों से जिन पर उसी दिन नमाज़ समय स्क्रीन पर निशान लगाया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু একই দিনে নামাজের সময়ের পর্দায় চিহ্নিত নামাজ থেকে।"
          }
        }
      }
    },
