    "perms.notify.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verirseniz vakitler, alarmlar ve hatırlatmalar zamanında gelir. Vermezseniz yalnız uygulamayı açınca görürsünüz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you allow them, prayer times, alarms and reminders arrive on time. If not, you only see them when you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie zustimmen, kommen Gebetszeiten, Wecker und Erinnerungen pünktlich. Sonst sehen Sie sie nur beim Öffnen der App."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcazə versəniz, vaxtlar, zəngli saatlar və xatırlatmalar vaxtında gəlir. Verməsəniz, onları yalnız tətbiqi açanda görərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن سمحت، تصلك أوقات الصلاة والمنبّهات والتذكيرات في وقتها. وإن لم تسمح، لا تراها إلا عند فتح التطبيق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diizinkan, waktu salat, alarm, dan pengingat datang tepat waktu. Jika tidak, Anda hanya melihatnya saat membuka aplikasi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازت دیں تو اوقات، الارم اور یاد دہانیاں وقت پر آئیں گی۔ نہ دیں تو صرف ایپ کھولنے پر دکھیں گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اجازه دهید، اوقات، هشدارها و یادآورها به‌موقع می‌رسند. اگر ندهید، فقط با باز کردن برنامه آن‌ها را می‌بینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous les autorisez, heures de prière, alarmes et rappels arrivent à l'heure. Sinon, vous ne les voyez qu'en ouvrant l'appli."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если разрешите, время намаза, будильники и напоминания будут приходить вовремя. Если нет, вы увидите их, только открыв приложение."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可すると、礼拝時刻やアラーム、リマインダーが時間どおりに届きます。許可しない場合はアプリを開いたときにだけ表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 기도 시간, 알람, 알림이 제때 와요. 허용하지 않으면 앱을 열었을 때만 볼 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许后，礼拜时间、闹钟和提醒会准时送达；不允许则只能在打开应用时看到。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung papayagan, darating sa oras ang oras ng dasal, alarm at paalala. Kung hindi, makikita mo lang ang mga ito pagbukas ng app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าอนุญาต เวลาละหมาด การปลุก และการเตือนจะมาตรงเวลา ถ้าไม่อนุญาต คุณจะเห็นเมื่อเปิดแอปเท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo permite, los horarios de oración, alarmas y recordatorios llegan a tiempo. Si no, solo los verá al abrir la app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se permitir, horários de oração, alarmes e lembretes chegam na hora. Se não, você só os vê ao abrir o app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति दें तो नमाज़ के समय, अलार्म और रिमाइंडर समय पर आएँगे। न दें तो सिर्फ़ ऐप खोलने पर दिखेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি দিলে নামাজের সময়, অ্যালার্ম ও রিমাইন্ডার সময়মতো আসে। না দিলে শুধু অ্যাপ খুললে দেখবেন।"
          }
        }
      }
    },
    "perms.notify.whyN": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verirseniz alarmlar, zamanlayıcılar ve hatırlatmalar zamanında gelir. Vermezseniz yalnız uygulamayı açınca görürsünüz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you allow them, alarms, timers and reminders arrive on time. If not, you only see them when you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie zustimmen, kommen Wecker, Timer und Erinnerungen pünktlich. Sonst sehen Sie sie nur beim Öffnen der App."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcazə versəniz, zəngli saatlar, taymerlər və xatırlatmalar vaxtında gəlir. Verməsəniz, onları yalnız tətbiqi açanda görərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن سمحت، تصلك المنبّهات والمؤقّتات والتذكيرات في وقتها. وإن لم تسمح، لا تراها إلا عند فتح التطبيق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diizinkan, alarm, pengatur waktu, dan pengingat datang tepat waktu. Jika tidak, Anda hanya melihatnya saat membuka aplikasi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازت دیں تو الارم، ٹائمر اور یاد دہانیاں وقت پر آئیں گی۔ نہ دیں تو صرف ایپ کھولنے پر دکھیں گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اجازه دهید، هشدارها، زمان‌سنج‌ها و یادآورها به‌موقع می‌رسند. اگر ندهید، فقط با باز کردن برنامه آن‌ها را می‌بینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous les autorisez, alarmes, minuteurs et rappels arrivent à l'heure. Sinon, vous ne les voyez qu'en ouvrant l'appli."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если разрешите, будильники, таймеры и напоминания будут приходить вовремя. Если нет, вы увидите их, только открыв приложение."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可すると、アラームやタイマー、リマインダーが時間どおりに届きます。許可しない場合はアプリを開いたときにだけ表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 알람, 타이머, 알림이 제때 와요. 허용하지 않으면 앱을 열었을 때만 볼 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许后，闹钟、计时器和提醒会准时送达；不允许则只能在打开应用时看到。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung papayagan, darating sa oras ang alarm, timer at paalala. Kung hindi, makikita mo lang ang mga ito pagbukas ng app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าอนุญาต การปลุก ตัวจับเวลา และการเตือนจะมาตรงเวลา ถ้าไม่อนุญาต คุณจะเห็นเมื่อเปิดแอปเท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo permite, las alarmas, temporizadores y recordatorios llegan a tiempo. Si no, solo los verá al abrir la app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se permitir, alarmes, timers e lembretes chegam na hora. Se não, você só os vê ao abrir o app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति दें तो अलार्म, टाइमर और रिमाइंडर समय पर आएँगे। न दें तो सिर्फ़ ऐप खोलने पर दिखेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি দিলে অ্যালার্ম, টাইমার ও রিমাইন্ডার সময়মতো আসে। না দিলে শুধু অ্যাপ খুললে দেখবেন।"
          }
        }
      }
    },
