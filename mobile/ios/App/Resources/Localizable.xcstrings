    "tools.countdown.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri Sayım Sayacı ve Zamanlayıcı: Süre ve Tarihe Göre | Saat Tarih"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown Timer: By Duration or Date | Saat Tarih"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown-Timer: nach Dauer oder bis zu einem Datum | Saat Tarih"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Geriyə sayım taymeri: müddətə və ya tarixə görə | Saat Tarih"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّ تنازلي: بالمدة أو حتى تاريخ محدد | Saat Tarih"
          }
        }
      }
    },
    "tools.countdown.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz geri sayım: dakika zamanlayıcısı ya da belirlediğiniz tarihe kalan süre. Yeni yıla ve bayrama geri sayım, sesli uyarı ve tam ekran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free countdown: a minute timer or the time left until a date you choose. Countdown to New Year and bayram, sound alert and full screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenloser Countdown: Minuten-Timer oder die Zeit bis zu einem Wunschdatum. Countdown bis Neujahr und zum Bayram, mit Tonsignal und Vollbild."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsuz geriyə sayım: dəqiqə taymeri və ya seçdiyiniz tarixə qalan vaxt. Yeni ilə və bayrama geriyə sayım, səsli xəbərdarlıq və tam ekran."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّ تنازلي مجاني: مؤقت بالدقائق أو الوقت المتبقي حتى تاريخ تختاره. عدّ تنازلي لرأس السنة والعيد، مع تنبيه صوتي وملء الشاشة."
          }
        }
      }
    },
    "tools.countdown.h1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri sayım"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Geriyə sayım"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العدّ التنازلي"
          }
        }
      }
    },
    "tools.countdown.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri sayım iki biçimde çalışır: belirlediğiniz süre dolunca uyarı verir (zamanlayıcı) ya da seçtiğiniz tarihe kalan günü, saati ve saniyeyi canlı gösterir. Yeni yıla, bayrama ya da kendi tarihinize sayabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The countdown works in two ways: a timer that alerts you when your chosen duration ends, or a live display of the days, hours and seconds left until a date you pick. Count down to New Year, a bayram or your own date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Countdown funktioniert auf zwei Arten: als Timer, der Sie nach Ablauf der gewählten Dauer benachrichtigt, oder als Live-Anzeige der Tage, Stunden und Sekunden bis zu einem Datum Ihrer Wahl. Zählen Sie bis Neujahr, zu einem Bayram oder zu Ihrem eigenen Termin herunter."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Geriyə sayım iki üsulla işləyir: seçdiyiniz müddət bitəndə xəbərdarlıq edən taymer, yaxud seçdiyiniz tarixə qalan günləri, saatları və saniyələri canlı göstərən sayğac. Yeni ilə, bayrama və ya öz tarixinizə qədər geriyə sayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل العدّ التنازلي بطريقتين: مؤقت ينبّهك عند انتهاء المدة التي اخترتها، أو عرض مباشر للأيام والساعات والثواني المتبقية حتى تاريخ تحدده. ابدأ العدّ التنازلي لرأس السنة أو العيد أو لتاريخك الخاص."
          }
        }
      }
    },
