    "google.step1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da Ayarlar uygulamasını açın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Settings app on your iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die Einstellungen-App auf dem iPhone."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-da Parametrlər tətbiqini açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح تطبيق الإعدادات على iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka aplikasi Pengaturan di iPhone Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے آئی فون پر ترتیبات ایپ کھولیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامهٔ تنظیمات را در آیفون باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app Réglages de votre iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение «Настройки» на iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneの設定アプリを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 설정 앱을 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开iPhone上的“设置”应用。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Settings app sa iyong iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแอปการตั้งค่าบน iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra la app Ajustes del iPhone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o app Ajustes do iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने iPhone पर सेटिंग्स ऐप खोलें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iPhone-এ সেটিংস অ্যাপ খুলুন।"
          }
        }
      }
    },
    "google.step2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar › Takvim › Takvim Hesapları'na girin (eski iOS'ta Takvim › Hesaplar)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Apps › Calendar › Calendar Accounts (on older iOS: Calendar › Accounts)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie zu Apps › Kalender › Kalenderaccounts (bei älterem iOS: Kalender › Accounts)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqlər › Təqvim › Təqvim hesabları bölməsinə keçin (köhnə iOS-da Təqvim › Hesablar)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى التطبيقات › التقويم › حسابات التقويم (في إصدارات iOS الأقدم: التقويم › الحسابات)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka App › Kalender › Akun Kalender (di iOS lama: Kalender › Akun)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپس › کیلنڈر › کیلنڈر اکاؤنٹس میں جائیں (پرانے iOS پر: کیلنڈر › اکاؤنٹس)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به برنامه‌ها › تقویم › حساب‌های تقویم بروید (در iOSهای قدیمی‌تر: تقویم › حساب‌ها)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans Apps › Calendrier › Comptes de calendrier (sur les anciens iOS : Calendrier › Comptes)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите в Приложения › Календарь › Учётные записи календаря (в старых iOS: Календарь › Учётные записи)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ › カレンダー › カレンダーアカウントへ進みます（古いiOSでは カレンダー › アカウント）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 › 캘린더 › 캘린더 계정으로 갑니다(이전 iOS: 캘린더 › 계정)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往 App › 日历 › 日历账户（旧版iOS：日历 › 账户）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumunta sa Apps › Calendar › Calendar Accounts (sa lumang iOS: Calendar › Accounts)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปที่ แอป › ปฏิทิน › บัญชีปฏิทิน (iOS รุ่นเก่า: ปฏิทิน › บัญชี)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaya a Apps › Calendario › Cuentas de calendario (en iOS anteriores: Calendario › Cuentas)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá em Apps › Calendário › Contas do Calendário (no iOS mais antigo: Calendário › Contas)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप्स › कैलेंडर › कैलेंडर खाते पर जाएँ (पुराने iOS में: कैलेंडर › खाते)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ › ক্যালেন্ডার › ক্যালেন্ডার অ্যাকাউন্টে যান (পুরোনো iOS-এ: ক্যালেন্ডার › অ্যাকাউন্ট)।"
          }
        }
      }
    },
    "google.step3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap Ekle › Google'ı seçin ve Google hesabınızla giriş yapın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Add Account › Google and sign in with your Google account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Account hinzufügen › Google und melden Sie sich mit Ihrem Google-Konto an."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesab əlavə et › Google seçin və Google hesabınızla daxil olun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر إضافة حساب › Google وسجّل الدخول بحساب Google."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Tambah Akun › Google dan masuk dengan akun Google Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹ شامل کریں › Google منتخب کریں اور اپنے گوگل اکاؤنٹ سے سائن ان کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "افزودن حساب › Google را برگزینید و با حساب گوگل خود وارد شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Ajouter un compte › Google et connectez-vous avec votre compte Google."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Добавить учётную запись» › Google и войдите в свой аккаунт Google."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを追加 › Google を選び、Googleアカウントでサインインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 추가 › Google을 선택하고 Google 계정으로 로그인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 添加账户 › Google，并用您的Google账户登录。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin ang Add Account › Google at mag-sign in gamit ang iyong Google account."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก เพิ่มบัญชี › Google แล้วลงชื่อเข้าใช้ด้วยบัญชี Google"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija Añadir cuenta › Google e inicie sesión con su cuenta de Google."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Adicionar Conta › Google e entre com sua conta do Google."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता जोड़ें › Google चुनें और अपने Google खाते से साइन इन करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্ট যোগ করুন › Google বেছে নিয়ে আপনার Google অ্যাকাউন্টে সাইন ইন করুন।"
          }
        }
      }
    },
    "google.step4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimler anahtarının açık olduğundan emin olun ve kaydedin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the Calendars switch is on, then save."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achten Sie darauf, dass der Schalter Kalender aktiviert ist, und sichern Sie."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təqvimlər açarının açıq olduğuna əmin olun və yadda saxlayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من تفعيل مفتاح التقويمات ثم احفظ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan sakelar Kalender menyala, lalu simpan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یقینی بنائیں کہ کیلنڈرز کا سوئچ آن ہے، پھر محفوظ کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مطمئن شوید کلید تقویم‌ها روشن است، سپس ذخیره کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que l’interrupteur Calendriers est activé, puis enregistrez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что переключатель «Календари» включён, и сохраните."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーのスイッチがオンになっていることを確認して保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 스위치가 켜져 있는지 확인하고 저장합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认“日历”开关已打开，然后存储。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiyaking naka-on ang switch ng Calendars, saka i-save."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจดูว่าสวิตช์ปฏิทินเปิดอยู่ แล้วบันทึก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compruebe que el interruptor Calendarios está activado y guarde."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira se a chave Calendários está ativada e salve."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पक्का करें कि कैलेंडर स्विच चालू है, फिर सहेजें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডার সুইচ চালু আছে কি না দেখে সংরক্ষণ করুন।"
          }
        }
      }
    },
    "google.step5": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya dönüp “Telefonumdaki takvimleri göster” düğmesine dokunun ve izin verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back here, tap “Show calendars on my phone” and allow access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehren Sie hierher zurück, tippen Sie auf „Kalender auf meinem Telefon anzeigen“ und erlauben Sie den Zugriff."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bura qayıdın, “Telefonumdakı təqvimləri göstər” düyməsinə toxunun və icazə verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عد إلى هنا واضغط «اعرض التقويمات على هاتفي» ثم اسمح بالوصول."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke sini, ketuk \"Tampilkan kalender di ponsel saya\" dan izinkan akses."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں واپس آئیں، «میرے فون کے کیلنڈر دکھائیں» پر ٹیپ کریں اور رسائی کی اجازت دیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به اینجا برگردید، «نمایش تقویم‌های گوشی» را بزنید و دسترسی را مجاز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez ici, touchez « Afficher les calendriers du téléphone » et autorisez l’accès."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь сюда, нажмите «Показать календари телефона» и разрешите доступ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに戻り、「スマホのカレンダーを表示」をタップしてアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기로 돌아와 \"휴대폰의 달력 보기\"를 누르고 접근을 허용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到这里，轻点“显示手机上的日历”并允许访问。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumalik dito, i-tap ang “Ipakita ang mga kalendaryo sa aking telepono” at payagan ang access."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับมาที่นี่ แตะ “แสดงปฏิทินในโทรศัพท์” และอนุญาตการเข้าถึง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva aquí, toque “Mostrar los calendarios de mi teléfono” y permita el acceso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte aqui, toque em “Mostrar os calendários do meu celular” e permita o acesso."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ लौटें, “मेरे फ़ोन के कैलेंडर दिखाएँ” दबाएँ और अनुमति दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে ফিরে এসে “আমার ফোনের ক্যালেন্ডার দেখান” চাপুন এবং অনুমতি দিন।"
          }
        }
      }
    },
