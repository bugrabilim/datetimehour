        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات متوقفة. اسمح بها لهذا التطبيق من الإعدادات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi dimatikan. Izinkan notifikasi untuk aplikasi ini di Pengaturan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات بند ہیں۔ ترتیبات میں اس ایپ کے لیے اطلاعات کی اجازت دیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلان‌ها خاموش‌اند. در تنظیمات، اعلان‌های این برنامه را مجاز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Autorisez-les pour cette application dans Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления выключены. Разрешите их для этого приложения в Настройках."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフになっています。設定でこのアプリの通知を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있습니다. 설정에서 이 앱의 알림을 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭。请在设置中允许此应用的通知。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang mga abiso. Payagan ang abiso para sa app na ito sa Settings."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนปิดอยู่ โปรดอนุญาตการแจ้งเตือนของแอปนี้ในการตั้งค่า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Permita las notificaciones de esta app en Ajustes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Permita as notificações deste app em Ajustes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ बंद हैं। सेटिंग्स में इस ऐप की सूचनाओं की अनुमति दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটিফিকেশন বন্ধ আছে। সেটিংসে এই অ্যাপের নোটিফিকেশনের অনুমতি দিন।"
          }
        }
      }
