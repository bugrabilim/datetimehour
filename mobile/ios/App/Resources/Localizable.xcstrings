        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পবিত্র রাতের আলো আপনার ঘর আলোকিত করুক।"
          }
        }
      }
    },
    "greet.m.kandil.4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gecenin rahmeti üzerinize olsun."
