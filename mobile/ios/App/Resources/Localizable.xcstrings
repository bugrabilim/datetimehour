    },
    "google.android.step2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplar (ya da Şifreler ve hesaplar) bölümüne girin; Google hesabınız yoksa Hesap ekle › Google ile giriş yapın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Accounts (or Passwords & accounts); if your Google account is not there, tap Add account › Google and sign in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie zu Konten (oder Passwörter & Konten); fehlt Ihr Google-Konto, tippen Sie auf Konto hinzufügen › Google und melden Sie sich an."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesablar (və ya Şifrələr və hesablar) bölməsinə keçin; Google hesabınız yoxdursa, Hesab əlavə et › Google ilə daxil olun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادخل إلى الحسابات (أو كلمات المرور والحسابات)؛ وإن لم يكن حساب Google موجودًا فاضغط إضافة حساب › Google وسجّل الدخول."
          }
        }
      }
    },
    "google.android.step3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hesabınıza dokunun › Hesap senkronizasyonu'nda Takvim'in açık olduğundan emin olun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap your Google account › Account sync and make sure Calendar is on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf Ihr Google-Konto › Kontosynchronisierung und prüfen Sie, dass Kalender aktiviert ist."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hesabınıza toxunun › Hesab sinxronizasiyasında Təqvimin açıq olduğuna əmin olun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على حساب Google › مزامنة الحساب وتأكد من تفعيل التقويم."
          }
        }
      }
    },
    "google.android.step4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya dönüp “Telefonumdaki takvimleri göster” düğmesine dokunun ve izin verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back here, tap “Show my phone's calendars” and allow access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehren Sie hierher zurück, tippen Sie auf „Kalender meines Telefons anzeigen“ und erlauben Sie den Zugriff."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bura qayıdıb “Telefonumdakı təqvimləri göstər” düyməsinə toxunun və icazə verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارجع إلى هنا واضغط «عرض تقاويم هاتفي» واسمح بالوصول."
          }
        }
      }
    },
    "google.android.denied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim izni kapalı. Ayarlar › Uygulamalar › Saat Tarih › İzinler'den Takvim'e izin verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is off. Allow Calendar in Settings › Apps › Time & Date › Permissions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalenderzugriff ist aus. Erlauben Sie Kalender unter Einstellungen › Apps › Uhr & Datum › Berechtigungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təqvim icazəsi bağlıdır. Parametrlər › Tətbiqlər › Saat Tarix › İcazələr bölməsində Təqvimə icazə verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن التقويم متوقف. اسمح بالتقويم من الإعدادات › التطبيقات › الوقت والتاريخ › الأذونات."
          }
        }
      }
    },
    "kids.progress": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevsim ne kadar ilerledi?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far along is the season?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit ist die Jahreszeit?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fəsil nə qədər irəliləyib?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم مضى من الفصل؟"
          }
        }
      }
    },
    "kids.why.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevsimler neden olur?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why do we have seasons?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum gibt es Jahreszeiten?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fəsillər niyə olur?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا تحدث الفصول؟"
          }
        }
      }
    },
    "kids.why.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünya bir yılda Güneş'in çevresinde bir tur atar. Ama dik durmaz: ekseni 23,4 derece eğiktir, hep aynı yöne. Yılın bir yarısında kuzey yarımküre Güneş'e doğru eğilir ve yaz olur; öbür yarısında Güneş'ten uzağa eğilir ve kış olur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earth travels once around the Sun every year. But it doesn't stand up straight: its axis is tilted 23.4 degrees, always the same way. For half the year the northern half leans toward the Sun and it's summer; for the other half it leans away and it's winter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erde wandert einmal im Jahr um die Sonne. Aber sie steht nicht gerade: Ihre Achse ist um 23,4 Grad geneigt, immer in dieselbe Richtung. Ein halbes Jahr neigt sich die Nordhalbkugel zur Sonne hin – dann ist Sommer; das andere halbe Jahr neigt sie sich weg – dann ist Winter."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yer bir ildə Günəşin ətrafında bir dövrə vurur. Amma düz durmur: oxu həmişə eyni tərəfə 23,4 dərəcə maildir. İlin bir yarısında şimal yarımkürəsi Günəşə tərəf əyilir və yay olur; o biri yarısında Günəşdən uzağa əyilir və qış olur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدور الأرض حول الشمس دورة واحدة كل عام. لكنها ليست مستقيمة: محورها مائل 23.4 درجة ودائمًا في الاتجاه نفسه. في نصف العام يميل النصف الشمالي نحو الشمس فيكون الصيف، وفي النصف الآخر يميل بعيدًا عنها فيكون الشتاء."
          }
        }
      }
    },
    "kids.why.myth": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanlış bilinen: Mevsimler Güneş'e yaklaşıp uzaklaştığımız için olmaz. Dünya Güneş'e en çok Ocak başında yaklaşır; o sırada bizde kış vardır!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A common mix-up: seasons don't happen because we get closer to or farther from the Sun. Earth is closest to the Sun in early January – right in our winter!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein häufiger Irrtum: Jahreszeiten entstehen nicht, weil wir der Sonne näher oder ferner sind. Am nächsten ist die Erde der Sonne Anfang Januar – mitten in unserem Winter!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səhv bilinən: fəsillər Günəşə yaxınlaşıb-uzaqlaşdığımız üçün olmur. Yer Günəşə ən çox yanvarın əvvəlində yaxınlaşır – o vaxt bizdə qışdır!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ شائع: لا تحدث الفصول لأننا نقترب من الشمس أو نبتعد عنها. تكون الأرض أقرب إلى الشمس في أوائل يناير، أي في عز شتائنا!"
          }
        }
      }
    },
    "kids.tilt": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksen 23,4° eğik"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Axis tilted 23.4°"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achse 23,4° geneigt"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ox 23,4° maildir"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحور مائل 23.4°"
          }
        }
      }
    },
    "kids.light.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işığın açısı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The angle of sunlight"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Winkel des Sonnenlichts"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İşığın bucağı"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زاوية ضوء الشمس"
          }
        }
      }
    },
    "kids.light.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazın Güneş gökyüzünde yüksektedir; ışınlar yere dik gelir ve küçük bir alanı iyice ısıtır. Kışın Güneş alçaktadır; aynı ışık geniş bir alana yayılır ve daha az ısıtır. Kışın gündüzler de kısadır, yer ısınmaya vakit bulamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In summer the Sun is high in the sky; its rays hit the ground straight on and warm a small patch well. In winter the Sun is low; the same light spreads over a bigger area and warms it less. Winter days are also short, so the ground has less time to warm up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Sommer steht die Sonne hoch; ihre Strahlen treffen steil auf den Boden und wärmen eine kleine Fläche kräftig. Im Winter steht sie tief; dasselbe Licht verteilt sich auf eine größere Fläche und wärmt weniger. Außerdem sind Wintertage kurz, der Boden hat weniger Zeit, warm zu werden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayda Günəş göydə yüksəkdə olur; şüalar yerə düz düşür və kiçik sahəni yaxşı qızdırır. Qışda Günəş alçaqda olur; eyni işıq geniş sahəyə yayılır və az qızdırır. Qışda gündüzlər də qısadır, yer qızmağa vaxt tapmır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الصيف تكون الشمس عالية في السماء، فتسقط أشعتها عمودية على الأرض وتدفئ مساحة صغيرة جيدًا. وفي الشتاء تكون منخفضة، فينتشر الضوء نفسه على مساحة أكبر ويدفئها أقل. كما أن نهار الشتاء قصير فلا تجد الأرض وقتًا كافيًا لتسخن."
          }
        }
      }
    },
    "kids.light.summer": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaz: dik ışık"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summer: steep light"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommer: steiles Licht"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yay: düz işıq"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصيف: ضوء عمودي"
          }
        }
      }
    },
    "kids.light.winter": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kış: eğik ışık"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter: slanted light"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter: flaches Licht"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qış: maili işıq"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشتاء: ضوء مائل"
          }
        }
      }
    },
    "kids.dates.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kış 1 Aralık'ta mı başlar, 21 Aralık'ta mı?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does winter start on December 1 or December 21?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnt der Winter am 1. oder am 21. Dezember?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qış 1 dekabrda başlayır, yoxsa 21 dekabrda?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يبدأ الشتاء في 1 ديسمبر أم في 21 ديسمبر؟"
          }
        }
      }
    },
    "kids.dates.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkisi de doğru, çünkü iki ayrı hesap var. Gökbilimciler mevsimi Güneş'in konumuna göre başlatır: kış, gecenin en uzun olduğu gün (21 Aralık, kış gündönümü) başlar. Meteorologlar (hava bilimciler) ise hesap kolay olsun diye tam ayları kullanır: Aralık, Ocak ve Şubat kıştır. Bu yüzden bazı takvimlerde “kış 1 Aralık'ta başlar” yazar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both are right, because there are two ways to count. Astronomers start a season by the Sun's position: winter begins on the longest night (December 21, the winter solstice). Meteorologists (weather scientists) use whole months to keep their numbers simple: December, January and February are winter. That's why some calendars say “winter starts on December 1”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beides stimmt, denn es gibt zwei Zählweisen. Astronomen beginnen eine Jahreszeit nach dem Stand der Sonne: Der Winter beginnt in der längsten Nacht (21. Dezember, Wintersonnenwende). Meteorologen (Wetterforscher) nehmen der Einfachheit halber ganze Monate: Dezember, Januar und Februar sind Winter. Darum steht in manchen Kalendern „Winteranfang 1. Dezember“."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İkisi də doğrudur, çünki iki ayrı hesab var. Astronomlar fəsli Günəşin vəziyyətinə görə başladır: qış ən uzun gecədə (21 dekabr, qış gündönümü) başlayır. Meteoroloqlar (hava alimləri) isə hesab asan olsun deyə tam aylardan istifadə edir: dekabr, yanvar və fevral qışdır. Ona görə bəzi təqvimlərdə “qış 1 dekabrda başlayır” yazılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلاهما صحيح، لأن هناك طريقتين للحساب. يبدأ علماء الفلك الفصل حسب موقع الشمس: يبدأ الشتاء في أطول ليلة (21 ديسمبر، الانقلاب الشتوي). أما علماء الأرصاد الجوية فيستخدمون أشهرًا كاملة لتسهيل الحساب: ديسمبر ويناير وفبراير هي الشتاء. لذلك تكتب بعض التقاويم «يبدأ الشتاء في 1 ديسمبر»."
          }
        }
      }
    },
    "kids.dates.astro": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gökbilim (Güneş'e göre)"
          }
        },
