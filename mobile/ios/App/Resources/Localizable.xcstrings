            "value": "Tam ekran saatı aç"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الساعة بملء الشاشة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Jam Layar Penuh"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوری اسکرین گھڑی کھولیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "باز کردن ساعت تمام‌صفحه"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir l’horloge plein écran"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть полноэкранные часы"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全画面時計を開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
