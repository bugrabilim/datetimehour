    "calendar.showDeviceNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook… telefonunuza ekli bütün takvimler. Etkinlikler yalnız telefonda okunur, hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook… every calendar on your phone. Events are read only on your phone and never sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook … alle Kalender auf Ihrem Telefon. Termine werden nur auf dem Telefon gelesen und nirgendwohin gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook… telefonunuzdakı bütün təqvimlər. Tədbirlər yalnız telefonda oxunur, heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud وGoogle وOutlook… كل التقويمات على هاتفك. تُقرأ الأحداث على هاتفك فقط ولا تُرسل إلى أي جهة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook… semua kalender di ponsel Anda. Acara hanya dibaca di ponsel dan tidak pernah dikirim ke mana pun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud، گوگل، Outlook… آپ کے فون کے تمام کیلنڈر۔ تقریبات صرف فون پر پڑھی جاتی ہیں اور کہیں نہیں بھیجی جاتیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud، گوگل، Outlook… همهٔ تقویم‌های گوشی شما. رویدادها فقط روی گوشی خوانده می‌شوند و به هیچ جا فرستاده نمی‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook… tous les calendriers de votre téléphone. Les événements sont lus uniquement sur le téléphone et ne sont jamais envoyés ailleurs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook… все календари вашего телефона. События читаются только на телефоне и никуда не отправляются."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud、Google、Outlook…スマホにあるすべてのカレンダー。予定はスマホ上でだけ読み取り、どこにも送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook… 휴대폰의 모든 달력. 일정은 휴대폰에서만 읽고 어디에도 보내지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud、Google、Outlook……手机上的所有日历。日程只在手机上读取，绝不发送到任何地方。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook… lahat ng kalendaryo sa iyong telepono. Sa telepono lang binabasa ang mga event at hindi ipinapadala kahit saan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook… ทุกปฏิทินในโทรศัพท์ของคุณ กิจกรรมถูกอ่านบนโทรศัพท์เท่านั้นและไม่ส่งไปที่ใด"
          }
        }
      }
    },
