    "widget.zikir.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget'a dokunarak sayın; sıfırlama düğmesiyle baştan başlayın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the widget to count; start over with the reset button."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf das Widget, um zu zählen; mit der Zurücksetzen-Taste beginnen Sie neu."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saymaq üçün vidcetə toxunun; sıfırlama düyməsi ilə yenidən başlayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الأداة للعدّ، وابدأ من جديد بزر إعادة التعيين."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk widget untuk menghitung; mulai lagi dengan tombol atur ulang."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گننے کے لیے ویجیٹ پر ٹیپ کریں؛ ری سیٹ بٹن سے دوبارہ شروع کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای شمردن روی ابزارک بزنید؛ با دکمهٔ صفر کردن از نو شروع کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le widget pour compter ; recommencez avec le bouton de remise à zéro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажимайте на виджет, чтобы считать; начните заново кнопкой сброса."
          }
        }
      }
    },
