    "widget.moon.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay'ın bugünkü evresi, aydınlık yüzdesi ve sıradaki dolunay ya da yeni ay."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's Moon phase, illumination and the next full or new moon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heutige Mondphase, Beleuchtungsgrad und der nächste Voll- oder Neumond."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayın bugünkü fazası, işıqlı hissəsi və növbəti tam ay ya da yeni ay."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طور القمر اليوم ونسبة الإضاءة والبدر أو المحاق التالي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase Bulan hari ini, persentase terang, dan bulan purnama atau bulan baru berikutnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج چاند کا مرحلہ، روشنی کا تناسب اور اگلا پورا یا نیا چاند۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حالت امروز ماه، درصد روشنایی و ماه کامل یا ماه نو بعدی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phase de la Lune du jour, son illumination et la prochaine pleine ou nouvelle lune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодняшняя фаза Луны, освещённость и ближайшее полнолуние или новолуние."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の月の形、輝面比と次の満月・新月。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 달의 위상, 밝은 부분의 비율과 다음 보름달 또는 신월."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的月相、被照亮的比例以及下一次满月或新月。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang yugto ng Buwan ngayon, liwanag at ang susunod na kabilugan o bagong buwan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้างของดวงจันทร์วันนี้ ความสว่าง และจันทร์เต็มดวงหรือจันทร์ดับครั้งถัดไป"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fase lunar de hoy, la iluminación y la próxima luna llena o nueva."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A fase da Lua de hoje, a iluminação e a próxima lua cheia ou nova."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की चंद्र कला, रोशन हिस्से का प्रतिशत और अगली पूर्णिमा या अमावस्या।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের চাঁদের দশা, আলোকিত অংশ এবং পরের পূর্ণিমা বা অমাবস্যা।"
          }
        }
      }
    },
