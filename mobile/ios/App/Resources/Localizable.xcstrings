    "countdowns.photoNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf yalnız bu telefonda saklanır, geri sayım kartının arkasında gösterilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
