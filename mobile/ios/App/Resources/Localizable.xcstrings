    "calendar.noEvents": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay için özel gün yok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No special days this month."
          }
        },
        "de": {
          "stringUnit": {
