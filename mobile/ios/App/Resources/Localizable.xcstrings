    "account.forgotSent": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adresle bir hesap varsa şifre sıfırlama bağlantısı gönderdik. Bağlantı 1 saat geçerlidir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If there is an account with this address, we sent a password reset link. The link is valid for 1 hour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls es ein Konto mit dieser Adresse gibt, haben wir einen Link zum Zurücksetzen geschickt. Er gilt 1 Stunde."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ünvanla hesab varsa, şifrə sıfırlama keçidi göndərdik. Keçid 1 saat etibarlıdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن كان هناك حساب بهذا العنوان فقد أرسلنا رابط إعادة التعيين. الرابط صالح لمدة ساعة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ada akun dengan alamat ini, kami sudah mengirim tautan pengaturan ulang. Tautan berlaku 1 jam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اس پتے سے کوئی اکاؤنٹ ہے تو ہم نے ری سیٹ کا لنک بھیج دیا ہے۔ لنک 1 گھنٹے تک کارآمد ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر حسابی با این نشانی باشد، پیوند بازنشانی را فرستادیم. پیوند 1 ساعت معتبر است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un compte existe pour cette adresse, nous avons envoyé un lien de réinitialisation. Il est valable 1 heure."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если аккаунт с таким адресом существует, мы отправили ссылку для сброса. Она действует 1 час."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスのアカウントがあれば、再設定用のリンクを送信しました。リンクの有効期限は1時間です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소로 된 계정이 있으면 재설정 링크를 보냈습니다. 링크는 1시간 동안 유효합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果存在使用此地址的账户，我们已发送重置链接。链接 1 小时内有效。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung may account sa address na ito, nagpadala kami ng reset link. May bisa ang link nang 1 oras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากมีบัญชีของอีเมลนี้ เราได้ส่งลิงก์ตั้งรหัสผ่านใหม่แล้ว ลิงก์ใช้ได้ 1 ชั่วโมง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si existe una cuenta con esta dirección, enviamos un enlace para restablecerla. El enlace es válido durante 1 hora."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se houver uma conta com este endereço, enviamos um link de redefinição. O link vale por 1 hora."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर इस पते से कोई खाता है, तो हमने रीसेट लिंक भेज दिया है। लिंक 1 घंटे तक मान्य है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ঠিকানায় কোনো অ্যাকাউন্ট থাকলে আমরা রিসেটের লিংক পাঠিয়েছি। লিংকটি 1 ঘণ্টা কার্যকর।"
          }
        }
      }
    },
