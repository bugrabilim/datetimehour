    "tools.countdown.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz geri sayım: dakika zamanlayıcısı ya da belirlediğiniz tarihe kalan süre. Yeni yıla ve bayrama geri sayım, sesli uyarı ve tam ekran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free countdown: a minute timer or the time left until a date you choose. Countdown to New Year and bayram, sound alert and full screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenloser Countdown: Minuten-Timer oder die Zeit bis zu einem Wunschdatum. Countdown bis Neujahr und zum Bayram, mit Tonsignal und Vollbild."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsuz geriyə sayım: dəqiqə taymeri və ya seçdiyiniz tarixə qalan vaxt. Yeni ilə və bayrama geriyə sayım, səsli xəbərdarlıq və tam ekran."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّ تنازلي مجاني: مؤقت بالدقائق أو الوقت المتبقي حتى تاريخ تختاره. عدّ تنازلي لرأس السنة والعيد، مع تنبيه صوتي وملء الشاشة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung mundur gratis: pengatur waktu menit atau sisa waktu menuju tanggal pilihan Anda. Hitung mundur Tahun Baru dan bayram, peringatan suara, dan layar penuh."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفت الٹی گنتی: منٹوں کا ٹائمر یا آپ کی منتخب تاریخ تک باقی وقت۔ نئے سال اور عید کی الٹی گنتی، آواز والا انتباہ اور پوری اسکرین۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شمارش معکوس رایگان: زمان‌سنج دقیقه‌ای یا زمان مانده تا تاریخی که انتخاب می‌کنید. شمارش معکوس سال نو و عید، هشدار صوتی و تمام‌صفحه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte à rebours gratuit : minuteur ou temps restant jusqu’à la date de votre choix, Nouvel An et bayrams compris. Alerte sonore et plein écran."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный обратный отсчёт: таймер на минуты или время до выбранной даты. Отсчёт до Нового года и байрама, звуковой сигнал и полноэкранный режим."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のカウントダウン：分単位のタイマー、または選んだ日付までの残り時間。新年やバイラムまでのカウントダウン、音の通知、全画面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 카운트다운: 분 단위 타이머 또는 고른 날짜까지 남은 시간. 새해와 바이람 카운트다운, 소리 알림, 전체 화면."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费倒计时：分钟计时器或距所选日期的剩余时间。新年和节日倒计时、声音提醒和全屏。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Libreng countdown: timer sa minuto o natitirang oras bago ang petsang pipiliin mo. Countdown sa Bagong Taon at bayram, tunog na paalala at full screen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับถอยหลังฟรี: ตั้งเวลาเป็นนาทีหรือดูเวลาที่เหลือถึงวันที่ที่เลือก นับถอยหลังถึงปีใหม่และไบรัม พร้อมเสียงเตือนและโหมดเต็มหน้าจอ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta atrás gratis: un temporizador de minutos o el tiempo que falta hasta la fecha que elija. Cuenta atrás para Año Nuevo y el bayram, aviso sonoro y pantalla completa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagem regressiva grátis: um temporizador de minutos ou o tempo que falta até a data que você escolher. Contagem para o Ano-Novo e o bayram, alerta sonoro e tela cheia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त काउंटडाउन: मिनट टाइमर या आपकी चुनी तारीख तक बचा समय। नव वर्ष और बयराम तक काउंटडाउन, ध्वनि संकेत और फ़ुल स्क्रीन।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিনামূল্যের কাউন্টডাউন: মিনিটের টাইমার বা বেছে নেওয়া তারিখ পর্যন্ত বাকি সময়। নববর্ষ ও ঈদ পর্যন্ত কাউন্টডাউন, শব্দের সতর্কতা ও পূর্ণ পর্দা।"
          }
        }
      }
    },
