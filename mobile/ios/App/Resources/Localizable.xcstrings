    "wall.iosNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da alarm Apple'ın kendi ekranında çalar; duvar kâğıdı kapatma görevi ekranında ve uygulama açıldığında görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone the alarm rings on Apple's own screen; the wallpaper shows on the dismiss task screen and when the app opens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem iPhone klingelt der Wecker auf Apples eigenem Bildschirm; der Hintergrund erscheint in der Weckaufgabe und beim Öffnen der App."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-da zəng Apple-ın öz ekranında çalır; divar kağızı söndürmə tapşırığı ekranında və tətbiq açılanda görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على iPhone يرنّ المنبّه في شاشة Apple الخاصة؛ وتظهر الخلفية في شاشة مهمة الإيقاف وعند فتح التطبيق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di iPhone alarm berbunyi di layar milik Apple; wallpaper tampil di layar tugas mematikan dan saat aplikasi dibuka."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئی فون پر الارم ایپل کی اپنی اسکرین پر بجتا ہے؛ وال پیپر بند کرنے کے کام کی اسکرین پر اور ایپ کھلنے پر دکھائی دیتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در آیفون زنگ روی صفحه خود Apple به صدا درمی‌آید؛ تصویر زمینه در صفحه کار خاموش‌کردن و هنگام باز شدن برنامه دیده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPhone, l'alarme sonne sur l'écran d'Apple ; le fond d'écran apparaît sur l'écran de la tâche d'arrêt et à l'ouverture de l'app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iPhone будильник звонит на собственном экране Apple; обои видны на экране задания для отключения и при открытии приложения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneではアラームはApple独自の画面で鳴ります。壁紙は停止タスクの画面とアプリを開いたときに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서는 알람이 Apple 자체 화면에서 울립니다. 배경화면은 끄기 과제 화면과 앱을 열 때 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上闹钟会在 Apple 自己的界面响起；壁纸会显示在关闭任务界面和打开应用时。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa iPhone, tumutunog ang alarm sa sariling screen ng Apple; makikita ang wallpaper sa screen ng gawain sa pagpatay at kapag binuksan ang app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน iPhone นาฬิกาปลุกจะดังบนหน้าจอของ Apple เอง วอลเปเปอร์จะแสดงในหน้าภารกิจปิดปลุกและเมื่อเปิดแอป"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el iPhone la alarma suena en la pantalla propia de Apple; el fondo se ve en la pantalla de la tarea para apagarla y al abrir la app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone o alarme toca na tela da própria Apple; o papel de parede aparece na tela da tarefa para desligar e quando o app abre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone पर अलार्म Apple की अपनी स्क्रीन पर बजता है; वॉलपेपर बंद करने वाले कार्य की स्क्रीन पर और ऐप खुलने पर दिखता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-এ অ্যালার্ম Apple-এর নিজস্ব পর্দায় বাজে; ওয়ালপেপার বন্ধ করার কাজের পর্দায় ও অ্যাপ খুললে দেখা যায়।"
          }
        }
      }
    },
