    "alarm.photo.saved": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı. Alarmı kapatmak için aynı yerin fotoğrafını çekeceksiniz (ör. lavabo, kahve makinesi). Fotoğraf saklanmaz, yalnız küçük bir özeti tutulur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. To turn the alarm off you will photograph the same spot (e.g. the sink or coffee machine). The photo is not kept, only a small fingerprint."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Zum Ausschalten fotografieren Sie dieselbe Stelle (z. B. Waschbecken, Kaffeemaschine). Das Foto wird nicht gespeichert, nur ein kleiner Fingerabdruck."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saxlanıldı. Siqnalı söndürmək üçün eyni yerin fotosunu çəkəcəksiniz (məs. əlüzyuyan, qəhvə maşını). Foto saxlanmır, yalnız kiçik xülasəsi qalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ. لإيقاف المنبه ستلتقط صورة للمكان نفسه (مثل المغسلة أو آلة القهوة). لا تُحفظ الصورة بل بصمة صغيرة منها فقط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tersimpan. Untuk mematikan alarm Anda akan memotret tempat yang sama (mis. wastafel atau mesin kopi). Foto tidak disimpan, hanya sidik kecilnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ ہو گیا۔ الارم بند کرنے کے لیے آپ اسی جگہ (مثلاً سنک یا کافی مشین) کی تصویر لیں گے۔ تصویر خود محفوظ نہیں ہوتی، صرف ایک چھوٹا سا نشان۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ذخیره شد. برای خاموش کردن هشدار از همان جا (مثلاً روشویی یا قهوه‌ساز) عکس می‌گیرید. خود عکس نگه داشته نمی‌شود، فقط اثری کوچک از آن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré. Pour arrêter l’alarme, vous photographierez le même endroit (par ex. le lavabo ou la machine à café). La photo n’est pas conservée, seulement une petite empreinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено. Чтобы выключить будильник, нужно будет сфотографировать то же место (например, раковину или кофемашину). Само фото не хранится, только маленький отпечаток."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました。アラームを止めるには同じ場所（例：洗面台やコーヒーメーカー）を撮影します。写真は保存されず、小さな特徴データだけが残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장했습니다. 알람을 끄려면 같은 곳(예: 세면대나 커피 머신)을 찍습니다. 사진은 저장되지 않고 작은 특징값만 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存。关闭闹钟时需要拍下同一个地方（如洗手池或咖啡机）。照片不会保存，只保留一个很小的特征值。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-save. Para patayin ang alarma, kukunan mo ng larawan ang parehong lugar (hal. lababo o coffee machine). Hindi itinatago ang larawan, maliit na fingerprint lang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกแล้ว หากต้องการปิดนาฬิกาปลุก คุณจะต้องถ่ายรูปจุดเดิม (เช่น อ่างล้างหน้าหรือเครื่องชงกาแฟ) รูปไม่ถูกเก็บไว้ มีเพียงลายนิ้วมือข้อมูลขนาดเล็ก"
          }
        }
      }
    },
    "alarm.photo.missing": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf kaydedilmedi; kaydedilmezse matematik sorulur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No photo saved; without one a math task is used."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Foto gespeichert; ohne Foto gibt es eine Rechenaufgabe."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto saxlanmayıb; saxlanmasa riyaziyyat sualı verilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُحفظ صورة؛ بدونها تُطرح مسألة حسابية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada foto tersimpan; tanpa foto, tugas matematika dipakai."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی تصویر محفوظ نہیں؛ اس کے بغیر ریاضی کا کام استعمال ہوتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکسی ذخیره نشده؛ بدون آن کار ریاضی به کار می‌رود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune photo enregistrée ; à défaut, un calcul est utilisé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото не сохранено; без него используется математика."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真が保存されていません。ない場合は計算の課題を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 사진이 없습니다. 없으면 수학 미션을 씁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未保存照片；没有照片时使用算术任务。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang naka-save na larawan; kung wala, math ang gagamitin."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้บันทึกรูป หากไม่มีจะใช้ภารกิจคณิตศาสตร์"
          }
        }
      }
    },
