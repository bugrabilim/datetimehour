        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ноябрь — от латинского novem, «девять»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "霜月（しもつき）：霜が降りる「霜降り月」から。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "11월(November)은 라틴어 novem(9)에서 왔습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "十一月 November 源自拉丁语 novem（“九”）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Nobyembre ay mula sa Latin na novem, “siyam”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พฤศจิกายน: พฤศจิก (ราศีพิจิก) + อายน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noviembre viene del latín novem, “nueve”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Novembro vem do latim novem, “nove”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नवंबर लैटिन novem, “नौ”, से आया है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নভেম্বর এসেছে লাতিন novem, অর্থাৎ “নয়” থেকে।"
          }
        }
      }
    },
    "calendar.monthOrigin.items.11": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aralık: \"ara\" sözünden; iki yıl arasındaki ay. 1945'e kadar Kânûn-ı evvel denirdi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "December comes from Latin decem, “ten”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezember: von lateinisch decem, „zehn“."
          }
        },
        "az": {
