    "account.productsNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açtığınız üründe aynı e-posta ve şifreyle hesabınız açılır, profiliniz oraya da gelir. Kapatınca o üründeki hesabınız ve verileri silinir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a product you turn on, an account opens with the same email and password, and your profile goes there too. Turning it off deletes your account and its data in that product."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einem Produkt, das Sie einschalten, wird ein Konto mit derselben E-Mail und demselben Passwort eröffnet, und Ihr Profil geht dorthin mit. Beim Ausschalten werden Ihr Konto und seine Daten in jenem Produkt gelöscht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Açdığınız məhsulda eyni e-poçt və şifrə ilə hesabınız açılır, profiliniz də ora gəlir. Bağladıqda o məhsuldakı hesabınız və məlumatları silinir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المنتج الذي تفعّله يُفتح حساب بنفس البريد وكلمة المرور، وينتقل ملفك الشخصي إليه أيضًا. عند الإيقاف يُحذف حسابك وبياناته في ذلك المنتج."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di produk yang Anda aktifkan, akun dibuka dengan email dan kata sandi yang sama, dan profil Anda ikut ke sana. Menonaktifkannya menghapus akun dan datanya di produk itu."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جس پروڈکٹ کو آپ آن کریں اس میں اسی ای میل اور پاس ورڈ سے اکاؤنٹ کھلتا ہے اور آپ کا پروفائل بھی وہاں جاتا ہے۔ بند کرنے پر اس پروڈکٹ میں آپ کا اکاؤنٹ اور اس کا ڈیٹا حذف ہو جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در محصولی که روشن می‌کنید، حسابی با همان ایمیل و گذرواژه باز می‌شود و نمایهٔ شما هم به آنجا می‌رود. با خاموش کردن، حساب و داده‌هایتان در آن محصول پاک می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un produit que vous activez, un compte s'ouvre avec le même e-mail et le même mot de passe, et votre profil y est copié. Le désactiver supprime votre compte et ses données dans ce produit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В продукте, который вы включите, откроется аккаунт с тем же адресом и паролем, туда же перейдёт ваш профиль. При выключении аккаунт и данные в этом продукте удаляются."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにした製品では同じメールアドレスとパスワードでアカウントが開かれ、プロフィールもそこに移ります。オフにするとその製品のアカウントとデータは削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켠 제품에서는 같은 이메일과 비밀번호로 계정이 열리고 프로필도 그곳으로 옮겨집니다. 끄면 그 제품의 계정과 데이터가 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您开启的产品中，会用相同的邮箱和密码开设账户，个人资料也会同步过去。关闭后，该产品中的账户及其数据将被删除。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa produktong bubuksan ninyo, magbubukas ng account gamit ang parehong email at password, at kasama ring mapupunta roon ang inyong profile. Kapag isinara, mabubura ang inyong account at data sa produktong iyon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในผลิตภัณฑ์ที่คุณเปิด จะมีการเปิดบัญชีด้วยอีเมลและรหัสผ่านเดียวกัน และโปรไฟล์จะไปที่นั่นด้วย เมื่อปิด บัญชีและข้อมูลในผลิตภัณฑ์นั้นจะถูกลบ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el producto que active se abre una cuenta con el mismo correo y contraseña, y su perfil también va allí. Al desactivarlo se borran su cuenta y sus datos en ese producto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No produto que você ativar, uma conta é aberta com o mesmo e-mail e senha, e seu perfil vai junto. Ao desativar, sua conta e seus dados naquele produto são apagados."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस उत्पाद को आप चालू करते हैं, उसमें उसी ईमेल और पासवर्ड से खाता खुलता है और आपकी प्रोफ़ाइल भी वहाँ जाती है। बंद करने पर उस उत्पाद में आपका खाता और उसका डेटा मिट जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে পণ্যটি চালু করবেন, সেখানে একই ইমেইল ও পাসওয়ার্ডে অ্যাকাউন্ট খোলে এবং আপনার প্রোফাইলও সেখানে যায়। বন্ধ করলে সেই পণ্যে আপনার অ্যাকাউন্ট ও তার তথ্য মুছে যায়।"
          }
        }
      }
    },
