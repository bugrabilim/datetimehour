    "calendar.projected": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yılın dini günleri Diyanet'in uzun vadeli takvimine dayanır; kesinleşince güncellenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Religious days for this year are based on Diyanet's long-range calendar and will be updated once confirmed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die religiösen Tage dieses Jahres beruhen auf dem Langzeitkalender des Diyanet und werden nach Bestätigung aktualisiert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ilin dini günləri Diyanətin uzunmüddətli təqviminə əsaslanır; dəqiqləşəndə yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستند المناسبات الدينية لهذا العام إلى التقويم طويل المدى لرئاسة الشؤون الدينية، وستُحدَّث عند تأكيدها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari keagamaan tahun ini berasal dari kalender jangka panjang Diyanet dan akan diperbarui setelah dipastikan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سال کے مذہبی دن دیانت کے طویل مدتی کیلنڈر سے لیے گئے ہیں اور تصدیق کے بعد تازہ کیے جائیں گے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روزهای مذهبی امسال از تقویم بلندمدت دیانت گرفته شده‌اند و پس از تأیید به‌روز می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours religieux de cette année proviennent du calendrier à long terme de la Diyanet et seront mis à jour une fois confirmés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Религиозные дни этого года взяты из долгосрочного календаря Diyanet и будут обновлены после подтверждения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この年の宗教上の日はディヤーネットの長期暦に基づいており、確定しだい更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 해의 종교일은 디야넷의 장기 달력을 근거로 하며 확정되면 갱신됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本年的宗教节日依据迪亚内特的远期历法，确认后会更新。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Batay sa pangmatagalang kalendaryo ng Diyanet ang mga relihiyosong araw ngayong taon at ia-update kapag nakumpirma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันสำคัญทางศาสนาของปีนี้อิงตามปฏิทินระยะยาวของดียาเนต และจะอัปเดตเมื่อได้รับการยืนยัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días religiosos de este año se basan en el calendario a largo plazo de Diyanet y se actualizarán cuando se confirmen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas religiosas deste ano se baseiam no calendário de longo prazo da Diyanet e serão atualizadas quando confirmadas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस साल के धार्मिक दिन दियानत के दीर्घकालिक कैलेंडर पर आधारित हैं और पुष्टि होने पर अपडेट होंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বছরের ধর্মীয় দিনগুলো দিয়ানেতের দীর্ঘমেয়াদি ক্যালেন্ডারের ভিত্তিতে এবং নিশ্চিত হলে হালনাগাদ করা হবে।"
          }
        }
      }
    },
