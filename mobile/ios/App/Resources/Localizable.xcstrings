    "tools.stopwatch.hint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayollar: Boşluk başlat/durdur, L tur, R sıfırla."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts: Space start/stop, L lap, R reset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkürzel: Leertaste Start/Stopp, L Runde, R Zurücksetzen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qısayollar: Boşluq – başlat/dayandır, L – dövrə, R – sıfırla."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاختصارات: المسافة للتشغيل والإيقاف، وL للفة، وR لإعادة الضبط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan: Spasi mulai/berhenti, L putaran, R atur ulang."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس: اسپیس شروع/روکیں، L چکر، R ری سیٹ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میان‌برها: فاصله شروع/توقف، L دور، R بازنشانی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcis : Espace démarrer/arrêter, L tour, R réinitialiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши: пробел — старт/стоп, L — круг, R — сброс."
          }
        }
      }
    },
