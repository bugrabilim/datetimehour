    "notify.cat.sky.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteor yağmurları, gezegen yakınlaşmaları, karşı konumlar (o akşam 20.00)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteor showers, close approaches of planets, oppositions (that evening at 20:00)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteorströme, Planetenbegegnungen, Oppositionen (am Abend um 20:00)"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteor yağışları, planet yaxınlaşmaları, qarşıdurmalar (həmin axşam 20:00)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زخات الشهب واقترانات الكواكب والتقابلات (مساء ذلك اليوم 20:00)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hujan meteor, pendekatan planet, oposisi (malam itu pukul 20.00)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شہابیوں کی بارش، سیاروں کا قریب آنا، مقابلہ (اسی شام 20:00)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بارش‌های شهابی، نزدیکی سیاره‌ها، مقابله‌ها (همان شب ساعت 20:00)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluies de météores, rapprochements, oppositions (le soir même à 20 h)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метеорные потоки, сближения планет, противостояния (в тот вечер в 20:00)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "流星群、惑星の接近、衝（当日20:00）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유성우, 행성 근접, 충(그날 저녁 20:00)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流星雨、行星相合、冲日（当晚20:00）"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteor shower, paglapit ng mga planeta, oposisyon (gabing iyon, 20:00)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝนดาวตก ดาวเคราะห์ใกล้กัน ดาวเคราะห์ตรงข้าม (เย็นวันนั้น 20:00)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lluvias de meteoros, acercamientos de planetas, oposiciones (esa tarde a las 20:00)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuvas de meteoros, encontros de planetas, oposições (naquela noite às 20:00)"
