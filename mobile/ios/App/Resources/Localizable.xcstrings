    "cals.nepali.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepal'in resmî takvimi Bikram Sambat'a (BS) göre tarih, Nepal yılbaşı ve yıla bağlı resmî günler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date in Bikram Sambat (BS), Nepal's official calendar, with Nepali New Year and the official days tied to it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum im Bikram Sambat (BS), dem amtlichen Kalender Nepals, mit dem nepalesischen Neujahr und den daran gebundenen amtlichen Tagen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepalın rəsmi təqvimi Bikram Sambata (BS) görə tarix, Nepal yeni ili və ilə bağlı rəsmi günlər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ في بكرم سمبت، التقويم الرسمي في نيبال، ورأس السنة النيبالية والأيام الرسمية المرتبطة به."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal menurut Bikram Sambat (BS), kalender resmi Nepal, beserta Tahun Baru Nepal dan hari-hari resmi yang terkait."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیپال کے سرکاری کیلنڈر بکرم سمبت کے مطابق تاریخ، نیپالی نیا سال اور اس سے جڑے سرکاری دن۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ در بیکرم سمبت، گاه‌شماری رسمی نپال، با سال نو نپالی و روزهای رسمی وابسته به آن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date du Bikram Sambat (BS), le calendrier officiel du Népal, avec le Nouvel An népalais et les jours officiels qui s’y rattachent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата по Бикрам Самбату (BS), официальному календарю Непала, с непальским Новым годом и связанными с ним официальными днями."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネパールの公式暦ビクラム暦（BS）の日付と、ネパール正月および暦に基づく公式の記念日。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네팔의 공식 달력인 비크람 삼밧(BS)의 날짜와 네팔 새해, 이에 따른 공식 기념일."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尼泊尔官方历法超日王历（BS）的日期，以及尼泊尔新年和据此而定的法定纪念日。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang petsa sa Bikram Sambat (BS), ang opisyal na kalendaryo ng Nepal, kasama ang Bagong Taon ng Nepal at ang mga opisyal na araw na nakabatay rito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ตามวิกรมสัมวัต (BS) ปฏิทินทางการของเนปาล พร้อมวันขึ้นปีใหม่เนปาลและวันสำคัญทางราชการ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha en el Bikram Sambat (BS), el calendario oficial de Nepal, con el Año Nuevo nepalí y los días oficiales ligados a él."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A data no Bikram Sambat (BS), o calendário oficial do Nepal, com o Ano-Novo nepalês e os dias oficiais ligados a ele."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेपाल के आधिकारिक पंचांग विक्रम संवत (बि.सं.) के अनुसार तिथि, नेपाली नववर्ष और उससे जुड़े आधिकारिक दिवस।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেপালের সরকারি পঞ্জিকা বিক্রম সংবত (বি.সং.) অনুযায়ী তারিখ, নেপালি নববর্ষ এবং এর সঙ্গে যুক্ত সরকারি দিবস।"
          }
        }
      }
    },
    "cals.nepali.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bikram Sambat güneş takvimidir; ay uzunlukları (29–32 gün) her yıl Nepal Panchang Karar Kurulu'nun yayımladığı takvimden gelir. 2083 BS'ye (Nisan 2027'ye) kadar resmî takvim yayımlandı, sonrası yaygın kullanılan tahmin tablosudur ve resmî takvim çıkınca bir gün değişebilir. Ay'a bağlı bayramlar (Dashain, Tihar…) Hindu takvimindedir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bikram Sambat is a solar calendar; month lengths (29–32 days) come from the calendar published each year by Nepal's Panchang deciding committee. Official calendars are published up to 2083 BS (April 2027); later years use the widely used projected table and may shift by a day once the official calendar is out. Lunar festivals (Dashain, Tihar…) are in the Hindu calendar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bikram Sambat ist ein Sonnenkalender; die Monatslängen (29–32 Tage) stammen aus dem Kalender, den Nepals Panchang-Ausschuss jedes Jahr veröffentlicht. Amtliche Kalender liegen bis 2083 BS (April 2027) vor; spätere Jahre folgen der verbreiteten Vorausberechnung und können sich mit dem amtlichen Kalender um einen Tag verschieben. Mondfeste (Dashain, Tihar …) stehen im Hindu-Kalender."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bikram Sambat günəş təqvimidir; ayların uzunluğu (29–32 gün) hər il Nepalın Pançanq qərar komitəsinin dərc etdiyi təqvimdən gəlir. 2083 BS-ə (2027-ci ilin aprelinə) qədər rəsmi təqvim dərc olunub, sonrası geniş istifadə olunan proqnoz cədvəlidir və rəsmi təqvim çıxanda bir gün dəyişə bilər. Aya bağlı bayramlar (Daşain, Tihar…) Hindu təqvimindədir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بكرم سمبت تقويم شمسي؛ أطوال الشهور (29–32 يومًا) مأخوذة من التقويم الذي تنشره لجنة البانتشانغ في نيبال كل عام. نُشرت التقاويم الرسمية حتى سنة 2083 (أبريل 2027)، وما بعدها جدول تقديري شائع قد يتغير بيوم واحد عند صدور التقويم الرسمي. الأعياد القمرية (داشين، تيهار…) في التقويم الهندوسي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bikram Sambat adalah kalender matahari; panjang bulannya (29–32 hari) berasal dari kalender yang diterbitkan setiap tahun oleh komite Panchang Nepal. Kalender resmi sudah terbit sampai 2083 BS (April 2027); tahun-tahun sesudahnya memakai tabel perkiraan yang lazim dan bisa bergeser sehari saat kalender resmi terbit. Hari raya berdasarkan bulan (Dashain, Tihar…) ada di kalender Hindu."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بکرم سمبت شمسی کیلنڈر ہے؛ مہینوں کی لمبائی (29–32 دن) ہر سال نیپال کی پنچانگ فیصلہ ساز کمیٹی کے شائع کردہ کیلنڈر سے آتی ہے۔ سرکاری کیلنڈر 2083 بی ایس (اپریل 2027) تک شائع ہو چکے ہیں؛ اس کے بعد عام استعمال ہونے والا اندازہ جدول ہے جو سرکاری کیلنڈر آنے پر ایک دن بدل سکتا ہے۔ چاند پر مبنی تہوار (دشین، تہار…) ہندو کیلنڈر میں ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بیکرم سمبت گاه‌شماری خورشیدی است؛ طول ماه‌ها (29 تا 32 روز) از تقویمی می‌آید که کمیتهٔ پنچانگ نپال هر سال منتشر می‌کند. تقویم رسمی تا سال 2083 (آوریل 2027) منتشر شده است؛ سال‌های بعد از جدول پیش‌بینی رایج است و با انتشار تقویم رسمی ممکن است یک روز جابه‌جا شود. جشن‌های قمری (داشین، تیهار…) در گاه‌شماری هندو هستند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bikram Sambat est un calendrier solaire ; la longueur des mois (29 à 32 jours) provient du calendrier publié chaque année par le comité du panchang du Népal. Les calendriers officiels sont publiés jusqu’en 2083 BS (avril 2027) ; les années suivantes suivent la table prévisionnelle courante et peuvent varier d’un jour à la parution du calendrier officiel. Les fêtes lunaires (Dashain, Tihar…) figurent dans le calendrier hindou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бикрам Самбат — солнечный календарь; длина месяцев (29–32 дня) берётся из календаря, который ежегодно публикует непальский комитет панчанги. Официальные календари изданы до 2083 BS (апрель 2027); дальше используется распространённая расчётная таблица, которая с выходом официального календаря может сдвинуться на день. Лунные праздники (Дашайн, Тихар…) — в индуистском календаре."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビクラム暦は太陽暦で、月の長さ（29〜32日）はネパールのパンチャーン決定委員会が毎年発表する暦によります。公式暦は2083年（2027年4月まで）まで発表済みで、それ以降は広く使われる予測表のため、公式暦の発表で1日ずれることがあります。月に基づく祭り（ダサイン、ティハールなど）はヒンドゥー暦にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비크람 삼밧은 태양력이며, 달의 길이(29~32일)는 네팔 판창 결정 위원회가 해마다 발표하는 달력을 따릅니다. 공식 달력은 2083년(2027년 4월)까지 발표되었고, 그 뒤는 널리 쓰이는 예측표이므로 공식 달력이 나오면 하루 달라질 수 있습니다. 달에 따른 축제(다샤인, 티하르 등)는 힌두력에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超日王历是太阳历，各月长度（29至32天）取自尼泊尔历书决定委员会每年发布的历书。官方历书已发布到2083年（2027年4月）；之后采用通行的推算表，官方历书发布后可能相差一天。按月亮计算的节日（德赛节、提哈尔节等）见印度教历。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendaryong solar ang Bikram Sambat; galing ang haba ng mga buwan (29–32 araw) sa kalendaryong inilalabas taon-taon ng komite ng Panchang ng Nepal. May opisyal na kalendaryo hanggang 2083 BS (Abril 2027); ang mga sumunod na taon ay galing sa karaniwang talahanayan ng pagtataya at maaaring maiba nang isang araw kapag lumabas ang opisyal na kalendaryo. Nasa kalendaryong Hindu ang mga pistang batay sa buwan (Dashain, Tihar…)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิกรมสัมวัตเป็นปฏิทินสุริยคติ ความยาวของเดือน (29–32 วัน) มาจากปฏิทินที่คณะกรรมการปัญจางค์ของเนปาลประกาศทุกปี ปฏิทินทางการประกาศแล้วถึงปี 2083 (เมษายน 2027) ปีหลังจากนั้นใช้ตารางคำนวณล่วงหน้าที่นิยมใช้ และอาจคลาดหนึ่งวันเมื่อปฏิทินทางการออกมา เทศกาลตามจันทรคติ (ทศหรา ติหาร ฯลฯ) อยู่ในปฏิทินฮินดู"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Bikram Sambat es un calendario solar; la duración de los meses (29 a 32 días) procede del calendario que publica cada año el comité del panchang de Nepal. Hay calendarios oficiales hasta 2083 BS (abril de 2027); los años siguientes usan la tabla de previsión habitual y pueden variar un día cuando salga el calendario oficial. Las fiestas lunares (Dashain, Tihar…) están en el calendario hindú."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bikram Sambat é um calendário solar; a duração dos meses (29 a 32 dias) vem do calendário publicado todo ano pelo comitê do panchang do Nepal. Há calendários oficiais até 2083 BS (abril de 2027); os anos seguintes usam a tabela de previsão mais comum e podem mudar um dia quando o calendário oficial sair. As festas lunares (Dashain, Tihar…) estão no calendário hindu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विक्रम संवत सौर पंचांग है; महीनों की लंबाई (29–32 दिन) नेपाल की पंचांग निर्णायक समिति द्वारा हर वर्ष प्रकाशित पंचांग से ली जाती है। आधिकारिक पंचांग 2083 बि.सं. (अप्रैल 2027) तक प्रकाशित हैं; उसके बाद के वर्ष प्रचलित अनुमानित तालिका से हैं और आधिकारिक पंचांग आने पर एक दिन बदल सकते हैं। चंद्र पर्व (दशैं, तिहार…) हिंदू पंचांग में हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিক্রম সংবত সৌর পঞ্জিকা; মাসের দৈর্ঘ্য (29–32 দিন) নেপালের পঞ্চাঙ্গ নির্ধারণ কমিটির প্রতি বছর প্রকাশিত পঞ্জিকা থেকে নেওয়া। সরকারি পঞ্জিকা 2083 বি.সং. (এপ্রিল 2027) পর্যন্ত প্রকাশিত; এর পরের বছরগুলো প্রচলিত আনুমানিক সারণি থেকে, সরকারি পঞ্জিকা এলে এক দিন বদলাতে পারে। চান্দ্র উৎসব (দশাইন, তিহার…) হিন্দু পঞ্জিকায় আছে।"
          }
        }
      }
    },
