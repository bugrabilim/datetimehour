    "look.slideNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekran arka planında en çok 10 fotoğraf sırayla gösterilir; fotoğraflar yalnız bu cihazda kalır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 10 photos take turns as the full-screen background; the photos stay on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 10 Fotos wechseln sich als Vollbild-Hintergrund ab; die Fotos bleiben auf diesem Gerät."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekran fonunda ən çox 10 foto növbə ilə göstərilir; fotolar yalnız bu cihazda qalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتناوب حتى 10 صور خلفيةً لملء الشاشة، وتبقى الصور على هذا الجهاز."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga 10 foto bergantian menjadi latar layar penuh; foto tetap di perangkat ini."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ سے زیادہ 10 تصاویر باری باری پوری اسکرین کا پس منظر بنتی ہیں؛ تصاویر اسی آلے پر رہتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا 10 عکس به نوبت پس‌زمینهٔ تمام‌صفحه می‌شوند؛ عکس‌ها روی همین دستگاه می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à 10 photos se succèdent en arrière-plan plein écran ; les photos restent sur cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До 10 фото по очереди служат фоном полноэкранных часов; фото остаются на этом устройстве."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大10枚の写真が全画面の背景として順番に表示されます。写真はこの端末に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 10장의 사진이 전체 화면 배경으로 번갈아 나옵니다. 사진은 이 기기에 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多10张照片轮流作为全屏背景；照片保存在此设备上。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanggang 10 larawan ang magsasalitan bilang background sa full screen; nananatili sa device na ito ang mga larawan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพสูงสุด 10 รูปจะสลับกันเป็นพื้นหลังเต็มจอ รูปภาพอยู่ในอุปกรณ์นี้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta 10 fotos se turnan como fondo a pantalla completa; las fotos se quedan en este dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até 10 fotos se revezam como fundo da tela cheia; as fotos ficam só neste aparelho."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ुल स्क्रीन पृष्ठभूमि में अधिकतम 10 फ़ोटो बारी-बारी से दिखती हैं; फ़ोटो इसी डिवाइस पर रहती हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "10টি পর্যন্ত ছবি পালা করে পূর্ণ পর্দার পটভূমি হয়; ছবিগুলো এই ডিভাইসেই থাকে।"
          }
        }
      }
    },
