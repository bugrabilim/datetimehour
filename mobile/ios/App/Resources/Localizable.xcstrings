    "panchang.wed": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı geleneklerde çarşamba günü uygun sayılmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some traditions do not consider it favourable on Wednesday."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In manchen Traditionen gilt er am Mittwoch nicht als günstig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəzi ənənələrdə çərşənbə günü əlverişli sayılmır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في بعض التقاليد لا يُعدّ مناسبًا يوم الأربعاء."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian tradisi tidak menganggapnya baik pada hari Rabu."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض روایات میں بدھ کے دن اسے موزوں نہیں سمجھا جاتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در برخی سنت‌ها روز چهارشنبه مناسب شمرده نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines traditions ne le jugent pas favorable le mercredi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В некоторых традициях в среду не считается благоприятной."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "伝統によっては水曜日には吉とされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 전통에서는 수요일에 길하다고 보지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些传统认为星期三不吉利。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa ilang tradisyon, hindi ito itinuturing na mabuti tuwing Miyerkules."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บางประเพณีไม่ถือว่าเป็นมงคลในวันพุธ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas tradiciones no lo consideran favorable el miércoles."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas tradições não o consideram favorável na quarta-feira."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ परंपराओं में बुधवार को इसे शुभ नहीं माना जाता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো কোনো ঐতিহ্যে বুধবার একে শুভ বলে ধরা হয় না।"
          }
        }
      }
    },
    "panchang.polar": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerde bu gün Güneş doğmuyor ya da batmıyor; dilimler hesaplanamıyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sun does not rise or set here on this day, so the periods cannot be calculated."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne geht an diesem Ort an diesem Tag nicht auf oder unter; die Abschnitte lassen sich nicht berechnen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerdə bu gün Günəş doğmur və ya batmır; dilimlər hesablana bilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشرق الشمس أو لا تغرب هنا في هذا اليوم، فلا يمكن حساب الفترات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matahari tidak terbit atau tidak terbenam di sini pada hari ini, jadi periode tidak dapat dihitung."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس جگہ آج سورج طلوع یا غروب نہیں ہوتا، اس لیے اوقات کا حساب نہیں ہو سکتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در این مکان امروز خورشید طلوع یا غروب نمی‌کند، پس بازه‌ها حساب نمی‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soleil ne se lève pas ou ne se couche pas ici ce jour-là ; les périodes ne peuvent pas être calculées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месте в этот день Солнце не восходит или не заходит, поэтому периоды рассчитать нельзя."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この場所ではこの日、太陽が昇らないか沈まないため、時間帯を計算できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이곳에서는 이날 해가 뜨거나 지지 않아 시간대를 계산할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此地这一天太阳不升起或不落下，无法计算时段。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sumisikat o lumulubog ang araw dito sa araw na ito, kaya hindi makalkula ang mga yugto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่นี่ในวันนี้พระอาทิตย์ไม่ขึ้นหรือไม่ตก จึงคำนวณช่วงเวลาไม่ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí el sol no sale o no se pone ese día, así que no se pueden calcular los periodos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui o sol não nasce ou não se põe nesse dia, então os períodos não podem ser calculados."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस स्थान पर इस दिन सूर्य उदय या अस्त नहीं होता, इसलिए काल की गणना नहीं हो सकती।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই স্থানে এই দিনে সূর্য ওঠে না বা অস্ত যায় না, তাই কালগুলোর হিসাব করা যায় না।"
          }
        }
      }
    },
