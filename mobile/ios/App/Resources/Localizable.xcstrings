    "place.locationFailed": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum alınamadı. Konum iznini telefonun Ayarlar'ından açabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't get your location. You can allow location access in your phone's Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standort nicht verfügbar. Sie können den Standortzugriff in den Einstellungen des Telefons erlauben."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məkan alınmadı. Məkan icazəsini telefonun Ayarlarından aça bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد موقعك. يمكنك السماح بالوصول إلى الموقع من إعدادات الهاتف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengambil lokasi Anda. Anda dapat mengizinkan akses lokasi di Pengaturan ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مقام معلوم نہیں ہو سکا۔ آپ فون کی ترتیبات میں مقام تک رسائی کی اجازت دے سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موقعیت شما به دست نیامد. می‌توانید دسترسی به موقعیت را در تنظیمات گوشی مجاز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’obtenir votre position. Vous pouvez autoriser l’accès à la position dans les réglages du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить местоположение. Доступ к геопозиции можно разрешить в настройках телефона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地を取得できませんでした。スマホの設定で位置情報へのアクセスを許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 가져오지 못했습니다. 휴대폰 설정에서 위치 접근을 허용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取您的位置。您可以在手机设置中允许访问位置。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makuha ang iyong lokasyon. Maaari mong payagan ang access sa lokasyon sa Settings ng iyong telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถหาตำแหน่งของคุณได้ คุณอนุญาตการเข้าถึงตำแหน่งได้ในการตั้งค่าโทรศัพท์"
          }
        }
      }
    },
