    "tools.alarm.wake": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranı açık tut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the screen on"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirm eingeschaltet lassen"
          }
        },
        "az": {
          "stringUnit": {
