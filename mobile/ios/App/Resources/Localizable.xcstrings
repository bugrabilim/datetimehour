    "datecalc.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki tarih arasındaki gün, hafta ve iş gününü hesaplayın; bir tarihe gün, ay, yıl ya da iş günü ekleyin; yaşınızı ve sonraki doğum gününüzü bulun. İş günü hesabı hafta sonlarını ve Türkiye resmi tatillerini dışarıda bırakır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculate the days, weeks and working days between two dates; add days, months, years or working days to a date; and find your age and next birthday. Working-day counts leave out weekends and Turkish public holidays."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnen Sie Tage, Wochen und Arbeitstage zwischen zwei Daten, addieren Sie Tage, Monate, Jahre oder Arbeitstage zu einem Datum und ermitteln Sie Ihr Alter und Ihren nächsten Geburtstag. Bei Arbeitstagen werden Wochenenden und gesetzliche Feiertage der Türkei nicht mitgezählt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İki tarix arasındakı günləri, həftələri və iş günlərini hesablayın; tarixə gün, ay, il və ya iş günü əlavə edin; yaşınızı və növbəti ad gününüzü tapın. İş günləri hesablanarkən həftə sonları və Türkiyənin rəsmi bayram günləri çıxılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احسب الأيام والأسابيع وأيام العمل بين تاريخين؛ وأضف أيامًا أو شهورًا أو سنوات أو أيام عمل إلى تاريخ؛ واعرف عمرك وموعد عيد ميلادك القادم. ولا يشمل حساب أيام العمل عطلات نهاية الأسبوع والعطل الرسمية في تركيا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung hari, minggu, dan hari kerja antara dua tanggal; tambahkan hari, bulan, tahun, atau hari kerja ke suatu tanggal; dan temukan usia serta ulang tahun berikutnya. Hari kerja tidak menghitung akhir pekan dan hari libur resmi Turki."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دو تاریخوں کے درمیان دن، ہفتے اور کام کے دن نکالیں؛ کسی تاریخ میں دن، مہینے، سال یا کام کے دن جمع کریں؛ اور اپنی عمر اور اگلی سالگرہ معلوم کریں۔ کام کے دنوں میں ہفتہ وار چھٹیاں اور ترکی کی سرکاری تعطیلات شامل نہیں ہوتیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روزها، هفته‌ها و روزهای کاری میان دو تاریخ را حساب کنید؛ روز، ماه، سال یا روز کاری به تاریخی بیفزایید؛ و سن و تولد بعدی خود را بیابید. در شمارش روزهای کاری آخر هفته‌ها و تعطیلات رسمی ترکیه کنار گذاشته می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculez les jours, semaines et jours ouvrés entre deux dates ; ajoutez des jours, mois, années ou jours ouvrés à une date ; trouvez votre âge et votre prochain anniversaire. Les jours ouvrés excluent les week-ends et les jours fériés turcs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посчитайте дни, недели и рабочие дни между двумя датами; прибавьте к дате дни, месяцы, годы или рабочие дни; узнайте свой возраст и дату следующего дня рождения. Рабочие дни считаются без выходных и праздников Турции."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つの日付の間の日数・週数・営業日を求め、日付に日・月・年・営業日を足し引きし、年齢と次の誕生日がわかります。営業日の計算では週末とトルコの祝日を除きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 날짜 사이의 일수, 주 수, 근무일을 계산하고, 날짜에 일·월·년·근무일을 더하거나 빼며, 나이와 다음 생일을 알아봅니다. 근무일 계산에서는 주말과 튀르키예 공휴일을 뺍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算两个日期之间的天数、周数和工作日；在日期上加减天、月、年或工作日；查看年龄和下一个生日。工作日计算不含周末和土耳其公共假日。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulahin ang mga araw, linggo at araw ng trabaho sa pagitan ng dalawang petsa; magdagdag ng araw, buwan, taon o araw ng trabaho sa petsa; at alamin ang iyong edad at susunod na kaarawan. Hindi kasama sa bilang ng araw ng trabaho ang weekend at mga pista opisyal sa Türkiye."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำนวณจำนวนวัน สัปดาห์ และวันทำงานระหว่างสองวันที่ บวกวัน เดือน ปี หรือวันทำงานเข้ากับวันที่ และหาอายุกับวันเกิดครั้งถัดไป การนับวันทำงานไม่รวมวันหยุดสุดสัปดาห์และวันหยุดราชการของตุรกี"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule los días, semanas y días laborables entre dos fechas; sume días, meses, años o días laborables a una fecha, y averigüe su edad y su próximo cumpleaños. El recuento de días laborables excluye los fines de semana y los festivos de Turquía."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule os dias, semanas e dias úteis entre duas datas; some dias, meses, anos ou dias úteis a uma data; e descubra sua idade e seu próximo aniversário. A contagem de dias úteis exclui fins de semana e feriados da Turquia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो तारीखों के बीच दिन, सप्ताह और कार्यदिवस निकालें; किसी तारीख में दिन, महीने, साल या कार्यदिवस जोड़ें; और अपनी उम्र व अगला जन्मदिन जानें। कार्यदिवस गिनती में सप्ताहांत और तुर्किये की सार्वजनिक छुट्टियाँ नहीं गिनी जातीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুই তারিখের মধ্যে দিন, সপ্তাহ ও কর্মদিবস হিসাব করুন; কোনো তারিখে দিন, মাস, বছর বা কর্মদিবস যোগ করুন; আর আপনার বয়স ও পরের জন্মদিন জানুন। কর্মদিবসের হিসাবে সাপ্তাহিক ছুটি ও তুরস্কের সরকারি ছুটি বাদ যায়।"
          }
        }
      }
    },
