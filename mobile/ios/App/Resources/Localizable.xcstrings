    "perms.alarm.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verirseniz alarm ve zamanlayıcı, telefon sessizdeyken de tam zamanında çalar. Vermezseniz çalmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you allow it, alarms and timers ring right on time, even in silent mode. If not, they don't ring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie zustimmen, klingeln Wecker und Timer pünktlich, auch im Stummmodus. Sonst klingeln sie nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcazə versəniz, zəngli saat və taymer telefon səssizdə olanda da vaxtında çalır. Verməsəniz, çalmır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن سمحت، يرنّ المنبّه والمؤقّت في وقتهما حتى والهاتف صامت. وإن لم تسمح، لا يرنّان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diizinkan, alarm dan pengatur waktu berbunyi tepat waktu, bahkan saat ponsel senyap. Jika tidak, keduanya tidak berbunyi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازت دیں تو الارم اور ٹائمر فون خاموش ہونے پر بھی ٹھیک وقت پر بجیں گے۔ نہ دیں تو نہیں بجیں گے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اجازه دهید، هشدار و زمان‌سنج حتی در حالت بی‌صدا سر وقت زنگ می‌زنند. اگر ندهید، زنگ نمی‌زنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous l'autorisez, alarmes et minuteurs sonnent à l'heure, même en mode silencieux. Sinon, ils ne sonnent pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если разрешите, будильник и таймер зазвонят вовремя даже в беззвучном режиме. Если нет, они не зазвонят."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可すると、マナーモードでもアラームとタイマーが時間どおりに鳴ります。許可しないと鳴りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 무음 모드에서도 알람과 타이머가 제때 울려요. 허용하지 않으면 울리지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许后，即使静音，闹钟和计时器也会准时响起；不允许则不会响。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung papayagan, tutunog sa oras ang alarm at timer kahit naka-silent. Kung hindi, hindi sila tutunog."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าอนุญาต นาฬิกาปลุกและตัวจับเวลาจะดังตรงเวลาแม้ปิดเสียงอยู่ ถ้าไม่อนุญาตจะไม่ดัง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo permite, alarmas y temporizadores suenan a su hora, incluso en silencio. Si no, no suenan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se permitir, alarmes e temporizadores tocam na hora, mesmo no modo silencioso. Se não, não tocam."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति दें तो अलार्म और टाइमर फ़ोन साइलेंट होने पर भी ठीक समय पर बजेंगे। न दें तो नहीं बजेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি দিলে অ্যালার্ম ও টাইমার ঠিক সময়ে বাজে, নীরব মোডেও। না দিলে বাজে না।"
          }
        }
      }
    },
