        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগস্টের নাম রোমান সম্রাট অগাস্টাসের নামে।"
          }
        }
      }
    },
    "calendar.monthOrigin.items.8": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eylül: Süryanice ve İbranice Elūl ay adından."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "September comes from Latin septem, “seven”: it was the seventh month of the old Roman calendar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "September: von lateinisch septem, „sieben“ – der siebte Monat des alten römischen Kalenders."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentyabr latınca septem, “yeddi” sözündəndir: köhnə Roma təqviminin yeddinci ayı idi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبتمبر: من اللاتينية septem «سبعة»، فقد كان الشهر السابع في التقويم الروماني القديم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "September berasal dari bahasa Latin septem, “tujuh”: bulan ketujuh kalender Romawi kuno."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ستمبر لاطینی septem یعنی “سات” سے ہے: یہ قدیم رومی تقویم کا ساتواں مہینہ تھا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سپتامبر از واژهٔ لاتین septem به معنای «هفت» است؛ هفتمین ماه تقویم کهن روم بود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Septembre vient du latin septem, « sept » : c'était le septième mois de l'ancien calendrier romain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сентябрь — от латинского septem, «семь»: седьмой месяц древнего римского календаря."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長月（ながつき）：夜がだんだん長くなる「夜長月」から。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "9월(September)은 라틴어 septem(7)에서 왔습니다. 옛 로마력의 일곱째 달이었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "九月 September 源自拉丁语 septem（“七”），曾是古罗马历的第七个月。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Setyembre ay mula sa Latin na septem, “pito”: ikapitong buwan ng lumang kalendaryong Romano."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กันยายน: กันย์ (ราศีกันย์) + อายน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Septiembre viene del latín septem, “siete”: era el séptimo mes del antiguo calendario romano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Setembro vem do latim septem, “sete”: era o sétimo mês do antigo calendário romano."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सितंबर लैटिन septem, “सात”, से आया है: यह पुराने रोमन कैलेंडर का सातवाँ महीना था।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেপ্টেম্বর এসেছে লাতিন septem, অর্থাৎ “সাত” থেকে: পুরোনো রোমান ক্যালেন্ডারে এটি ছিল সপ্তম মাস।"
          }
        }
      }
    },
    "calendar.monthOrigin.items.9": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekim: \"ekin\" sözünden; ekim zamanı. 1945'e kadar Teşrîn-i evvel denirdi."
