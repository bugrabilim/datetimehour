    "account.optionalNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgileri girmek isteğe bağlıdır; [Aydınlatma Metni](https://bumbagroup.com/uyelik-aydinlatma)'ne göre işlenir."
