    "nature.folkNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Halk takvimindeki geleneksel tarihlerdir (eski Rumi takvimden); hava tahmini değildir ve kaynaklara göre birkaç gün değişebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traditional dates from the Turkish folk calendar (based on the old Rumi calendar); not a weather forecast, and sources may differ by a few days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Traditionelle Daten des türkischen Volkskalenders (nach dem alten Rumi-Kalender); keine Wettervorhersage; je nach Quelle können sie um einige Tage abweichen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xalq təqvimindəki ənənəvi tarixlərdir (köhnə Rumi təqvimindən); hava proqnozu deyil və mənbələrə görə bir neçə gün dəyişə bilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تواريخ تقليدية من التقويم الشعبي التركي (من التقويم الرومي القديم)؛ ليست توقعًا للطقس وقد تختلف المصادر ببضعة أيام."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal tradisional dari kalender rakyat Turki (berdasarkan kalender Rumi lama); bukan prakiraan cuaca dan sumber bisa berbeda beberapa hari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترکی کی عوامی تقویم کی روایتی تاریخیں (پرانی رومی تقویم سے)؛ یہ موسم کی پیش گوئی نہیں اور ذرائع میں چند دن کا فرق ہو سکتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ‌های سنتی تقویم عامیانه ترکیه (برگرفته از تقویم رومی قدیم)؛ پیش‌بینی هوا نیست و منابع ممکن است چند روز تفاوت داشته باشند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates traditionnelles du calendrier populaire turc (ancien calendrier roumi) ; ce n’est pas une prévision météo et les sources varient de quelques jours."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Традиционные даты турецкого народного календаря (по старому календарю руми); это не прогноз погоды, источники расходятся на несколько дней."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トルコの民間暦の伝統的な日付（旧ルーミー暦による）。天気予報ではなく、資料により数日異なることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "튀르키예 민간 달력의 전통 날짜입니다(옛 루미 달력 기준). 일기 예보가 아니며 자료에 따라 며칠 차이가 날 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "土耳其民间历的传统日期（依旧鲁米历），并非天气预报，各来源可能相差几天。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tradisyonal na petsa mula sa kalendaryong bayan ng Turkey (batay sa lumang kalendaryong Rumi); hindi ito ulat-panahon at maaaring magkaiba nang ilang araw ang mga sanggunian."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ตามธรรมเนียมจากปฏิทินพื้นบ้านตุรกี (อิงปฏิทินรูมีเดิม) ไม่ใช่การพยากรณ์อากาศ และแหล่งข้อมูลอาจต่างกันไม่กี่วัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechas tradicionales del calendario popular turco (basado en el antiguo calendario rumí); no es una previsión del tiempo y las fuentes pueden variar unos días."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Datas tradicionais do calendário popular turco (baseado no antigo calendário rumi); não é previsão do tempo, e as datas podem variar alguns dias conforme a fonte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुर्की लोक कैलेंडर (पुराने रूमी कैलेंडर पर आधारित) की पारंपरिक तारीखें; यह मौसम पूर्वानुमान नहीं है और स्रोतों में कुछ दिनों का अंतर हो सकता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুর্কি লোক-ক্যালেন্ডারের (পুরোনো রুমি ক্যালেন্ডারভিত্তিক) প্রচলিত তারিখ; এটি আবহাওয়ার পূর্বাভাস নয় এবং উৎসভেদে কয়েক দিন পার্থক্য হতে পারে।"
          }
        }
      }
    },
