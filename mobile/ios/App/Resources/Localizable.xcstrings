            "state": "translated",
            "value": "Ang Oktubre ay mula sa Latin na octo, “walo”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตุลาคม: ตุล (ราศีตุล) + อาคม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Octubre viene del latín octo, “ocho”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outubro vem do latim octo, “oito”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अक्टूबर लैटिन octo, “आठ”, से आया है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অক্টোবর এসেছে লাতিন octo, অর্থাৎ “আট” থেকে।"
          }
        }
      }
    },
    "calendar.monthOrigin.items.10": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasım: Arapça qāsim, \"bölen\"; yılı yaz ve kış yarısına ayıran Kasım günü (8 Kasım). 1945'e kadar Teşrîn-i sânî."
