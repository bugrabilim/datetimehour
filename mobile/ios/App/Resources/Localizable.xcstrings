    "list.popupTitle": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listeye katılım onayı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm joining the list"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beitritt zur Liste bestätigen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siyahıya qoşulmanı təsdiqləyin"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكيد الانضمام إلى القائمة"
          }
        }
      }
    },
    "list.popupText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta adresiniz, yalnızca bu listeye abone edilmeniz için Bumba Teknoloji Limited Şirketi tarafından işlenir. İstediğiniz zaman tek tıkla ayrılabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email address is processed by Bumba Teknoloji Limited Şirketi only to subscribe you to this list. You can unsubscribe at any time with one click."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre E-Mail-Adresse wird von Bumba Teknoloji Limited Şirketi ausschließlich verarbeitet, um Sie in diese Liste einzutragen. Sie können sich jederzeit mit einem Klick abmelden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poçt ünvanınız yalnız bu siyahıya abunə olmağınız üçün Bumba Teknoloji Limited Şirketi tərəfindən emal olunur. İstədiyiniz vaxt bir kliklə ayrıla bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعالج شركة Bumba Teknoloji Limited Şirketi عنوان بريدك الإلكتروني فقط لاشتراكك في هذه القائمة. يمكنك إلغاء الاشتراك في أي وقت بنقرة واحدة."
          }
        }
      }
    },
    "list.readNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aydınlatma metnini oku"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the privacy notice"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutzhinweis lesen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatlandırma mətnini oxu"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرأ نص الإشعار"
          }
        }
      }
    },
    "list.consentText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aydınlatma metnini okudum, e-posta almayı kabul ediyorum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read the privacy notice and agree to receive emails."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe den Datenschutzhinweis gelesen und bin mit dem Erhalt von E-Mails einverstanden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatlandırma mətnini oxudum, e-poçt almağa razıyam."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرأت نص الإشعار وأوافق على استلام رسائل البريد الإلكتروني."
          }
        }
      }
    },
    "list.accept": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabul ediyorum"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I agree"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stimme zu"
          }
        },
        "az": {
