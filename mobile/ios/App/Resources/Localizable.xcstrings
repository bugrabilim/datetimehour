    "onboard.swipe.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saati kaydırarak değiştirin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe to change the clock"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischen Sie, um die Uhr zu wechseln"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatı sürüşdürərək dəyişin"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لتغيير الساعة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser untuk mengganti jam"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی بدلنے کے لیے سوائپ کریں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تغییر ساعت بکشید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez pour changer d'horloge"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните, чтобы сменить часы"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプで時計を切り替え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밀어서 시계 바꾸기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动切换时钟"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-swipe para palitan ang orasan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดเพื่อเปลี่ยนนาฬิกา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslice para cambiar de reloj"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para trocar o relógio"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी बदलने के लिए स्वाइप करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ি বদলাতে সোয়াইপ করুন"
          }
        }
      }
    },
    "onboard.swipe.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ekranında parmağınızı sağa ya da sola kaydırın; her kaydırmada başka bir saat modeli gelir. Saate dokununca saniye açılır ya da kapanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the clock screen, swipe left or right; each swipe brings another clock style. Tap the clock to show or hide the seconds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischen Sie auf dem Uhrbildschirm nach links oder rechts; jedes Wischen zeigt ein anderes Uhrmodell. Tippen Sie auf die Uhr, um die Sekunden ein- oder auszublenden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ekranında barmağınızı sağa və ya sola sürüşdürün; hər dəfə başqa saat modeli gəlir. Saata toxunanda saniyələr açılır və ya bağlanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب يمينًا أو يسارًا على شاشة الساعة؛ كل سحبة تعرض نموذج ساعة آخر. المس الساعة لإظهار الثواني أو إخفائها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di layar jam, geser ke kiri atau kanan; setiap geseran menampilkan model jam lain. Ketuk jam untuk menampilkan atau menyembunyikan detik."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی کی اسکرین پر دائیں یا بائیں سوائپ کریں؛ ہر بار گھڑی کا نیا انداز آتا ہے۔ سیکنڈ دکھانے یا چھپانے کے لیے گھڑی کو چھوئیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در صفحهٔ ساعت به چپ یا راست بکشید؛ هر بار مدل دیگری از ساعت می‌آید. برای نمایش یا پنهان کردن ثانیه‌ها روی ساعت بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l'écran de l'horloge, balayez vers la gauche ou la droite : chaque geste affiche un autre modèle. Touchez l'horloge pour afficher ou masquer les secondes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране часов смахивайте влево или вправо — каждый раз появляется другой вид часов. Коснитесь часов, чтобы показать или скрыть секунды."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計画面で左右にスワイプすると、別のデザインの時計に切り替わります。時計をタップすると秒の表示をオン・オフできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계 화면에서 왼쪽이나 오른쪽으로 밀면 다른 시계 모양이 나타납니다. 시계를 누르면 초가 켜지거나 꺼집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在时钟屏幕上向左或向右滑动，每次都会换成另一种时钟样式。轻点时钟可显示或隐藏秒数。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa screen ng orasan, mag-swipe pakaliwa o pakanan; bawat swipe ay ibang modelo ng orasan. I-tap ang orasan para ipakita o itago ang mga segundo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนหน้าจอนาฬิกา ปัดไปทางซ้ายหรือขวา แต่ละครั้งจะได้นาฬิกาแบบใหม่ แตะที่นาฬิกาเพื่อแสดงหรือซ่อนวินาที"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pantalla del reloj, deslice a la izquierda o a la derecha; cada gesto muestra otro modelo de reloj. Toque el reloj para mostrar u ocultar los segundos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tela do relógio, deslize para a esquerda ou para a direita; cada gesto mostra outro modelo de relógio. Toque no relógio para mostrar ou ocultar os segundos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी स्क्रीन पर बाएँ या दाएँ स्वाइप करें; हर बार घड़ी का नया डिज़ाइन आता है। सेकंड दिखाने या छिपाने के लिए घड़ी को छुएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ির পর্দায় বাঁয়ে বা ডানে সোয়াইপ করুন; প্রতিটি সোয়াইপে অন্য ধরনের ঘড়ি আসে। সেকেন্ড দেখাতে বা লুকাতে ঘড়িতে চাপুন।"
          }
        }
      }
    },
    "onboard.full.title": {
      "extractionState": "manual",
      "localizations": {
