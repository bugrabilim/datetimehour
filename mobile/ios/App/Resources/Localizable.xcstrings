          }
        }
      }
    },
    "perm.location.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakitleri, kıbleyi ve havayı bulunduğunuz yere göre göstermek için. Konumunuz saklanmaz; hava için yalnız yaklaşık konum hava servisine gider."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show prayer times, the Qibla and the weather for where you are. Your location isn't stored; only an approximate location goes to the weather service."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Gebetszeiten, Qibla und Wetter für Ihren Ort anzuzeigen. Ihr Standort wird nicht gespeichert; nur ein ungefährer Standort geht an den Wetterdienst."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtları, qibləni və havanı olduğunuz yerə görə göstərmək üçün. Məkanınız saxlanmır; hava üçün yalnız təxmini məkan hava xidmətinə gedir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعرض مواقيت الصلاة والقبلة والطقس حسب مكانك. لا يُحفظ موقعك؛ ولا يُرسَل إلى خدمة الطقس إلا موقع تقريبي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menampilkan waktu salat, kiblat, dan cuaca sesuai tempat Anda. Lokasi Anda tidak disimpan; hanya lokasi perkiraan yang dikirim ke layanan cuaca."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی جگہ کے مطابق نماز کے اوقات، قبلہ اور موسم دکھانے کے لیے۔ آپ کا مقام محفوظ نہیں کیا جاتا؛ موسم کے لیے صرف تخمینی مقام موسم کی سروس کو جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای نمایش اوقات نماز، قبله و هوا بر اساس محل شما. موقعیت شما ذخیره نمی‌شود؛ فقط موقعیت تقریبی به سرویس هوا می‌رود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour afficher les heures de prière, la qibla et la météo selon l'endroit où vous êtes. Votre position n'est pas enregistrée ; seule une position approximative est envoyée au service météo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы показывать время намаза, киблу и погоду для вашего места. Местоположение не сохраняется; в службу погоды уходит только приблизительное местоположение."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地に合わせて礼拝時刻、キブラ、天気を表示するためです。位置情報は保存されず、天気サービスにはおおよその位置だけが送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치에 맞춰 기도 시간, 키블라, 날씨를 보여 주기 위해서입니다. 위치는 저장되지 않으며 날씨 서비스에는 대략적인 위치만 전송됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于按您所在地点显示礼拜时间、朝拜方向和天气。不会保存您的位置；只有大致位置会发送给天气服务。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para maipakita ang oras ng pagdarasal, Qibla at panahon ayon sa kinaroroonan mo. Hindi iniimbak ang lokasyon mo; tinatayang lokasyon lang ang napupunta sa serbisyo ng panahon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อแสดงเวลาละหมาด ทิศกิบลัต และสภาพอากาศตามที่ที่คุณอยู่ ตำแหน่งของคุณไม่ถูกเก็บไว้ มีเพียงตำแหน่งโดยประมาณที่ส่งไปยังบริการสภาพอากาศ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mostrar los horarios de oración, la alquibla y el tiempo del lugar donde se encuentra. Su ubicación no se guarda; solo se envía una ubicación aproximada al servicio meteorológico."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mostrar os horários de oração, a qibla e o tempo de onde você está. Sua localização não é guardada; só uma localização aproximada vai para o serviço de clima."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जहाँ हैं वहाँ के नमाज़ के समय, क़िबला और मौसम दिखाने के लिए। आपका स्थान सहेजा नहीं जाता; केवल अनुमानित स्थान मौसम सेवा को जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যেখানে আছেন সেখানকার নামাজের সময়, কিবলা ও আবহাওয়া দেখাতে। আপনার অবস্থান সংরক্ষণ হয় না; শুধু আনুমানিক অবস্থান আবহাওয়া পরিষেবায় যায়।"
          }
        }
      }
    },
