    "perm.alarm.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizi tam zamanında uyandırabilmemiz için alarm izni gerekir. Alarm, telefon sessizdeyken ve uygulama kapalıyken de çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need alarm permission to wake you exactly on time. The alarm rings even when the phone is silent and the app is closed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wir Sie pünktlich wecken können, brauchen wir die Weckerberechtigung. Der Wecker klingelt auch im Stumm-Modus und bei geschlossener App."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizi tam vaxtında oyada bilməyimiz üçün zəngli saat icazəsi lazımdır. Zəng telefon səssizdə olanda və tətbiq bağlı olanda da çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحتاج إذن المنبّه لإيقاظك في الوقت المحدد تمامًا. يرنّ المنبّه حتى إن كان الهاتف صامتًا والتطبيق مغلقًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami memerlukan izin alarm agar dapat membangunkan Anda tepat waktu. Alarm tetap berbunyi saat ponsel dalam mode senyap dan aplikasi tertutup."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کو بالکل وقت پر جگانے کے لیے ہمیں الارم کی اجازت درکار ہے۔ الارم فون کے خاموش ہونے اور ایپ کے بند ہونے پر بھی بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای اینکه شما را درست به‌موقع بیدار کنیم، به اجازه زنگ هشدار نیاز داریم. زنگ حتی وقتی گوشی بی‌صداست و برنامه بسته است هم به صدا درمی‌آید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons besoin de l'autorisation des alarmes pour vous réveiller à l'heure exacte. L'alarme sonne même en mode silencieux et application fermée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение нужно, чтобы разбудить вас точно вовремя. Будильник звонит, даже если телефон на беззвучном и приложение закрыто."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間どおりに起こすにはアラームの許可が必要です。消音モードでもアプリを閉じていても鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제시간에 깨워 드리려면 알람 권한이 필요합니다. 휴대폰이 무음이고 앱이 닫혀 있어도 알람이 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们需要闹钟权限才能准时叫醒您。即使手机静音、应用已关闭，闹钟也会响。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan namin ng pahintulot sa alarm para magising ka nang eksakto sa oras. Tutunog ang alarm kahit naka-silent ang telepono at nakasara ang app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราต้องการสิทธิ์นาฬิกาปลุกเพื่อปลุกคุณให้ตรงเวลา นาฬิกาปลุกจะดังแม้โทรศัพท์ปิดเสียงและแอปปิดอยู่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitamos permiso de alarmas para despertarle a la hora exacta. La alarma suena aunque el teléfono esté en silencio y la app cerrada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisamos da permissão de alarmes para acordar você na hora exata. O alarme toca mesmo com o celular no silencioso e o app fechado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको ठीक समय पर जगाने के लिए हमें अलार्म की अनुमति चाहिए। फ़ोन साइलेंट और ऐप बंद होने पर भी अलार्म बजता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাকে ঠিক সময়ে জাগাতে অ্যালার্মের অনুমতি দরকার। ফোন নীরব থাকলে ও অ্যাপ বন্ধ থাকলেও অ্যালার্ম বাজে।"
          }
        }
      }
    },
    "perm.location.title": {
      "extractionState": "manual",
      "localizations": {
