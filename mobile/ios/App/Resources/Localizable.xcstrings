    "nature.ym.namesNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adlar Kuzey Amerika geleneğinden (Old Farmer's Almanac); karşılıklar çeviridir, yerleşik bir Türk geleneği değildir. Hasat Ayı, sonbahar ekinoksuna en yakın dolunaydır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names follow the North American tradition (Old Farmer's Almanac). The Harvest Moon is the full moon closest to the September equinox."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Namen folgen der nordamerikanischen Tradition (Old Farmer's Almanac); die deutschen Formen sind Übersetzungen. Der Erntemond ist der Vollmond, der der Herbst-Tagundnachtgleiche am nächsten liegt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Adlar Şimali Amerika ənənəsindəndir (Old Farmer's Almanac); qarşılıqları tərcümədir, yerli ənənə deyil. Məhsul Ayı payız bərabərgünlüyünə ən yaxın bədirdir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسماء من تقليد أمريكا الشمالية (Old Farmer's Almanac)، والمقابلات العربية ترجمة وليست تقليدًا عربيًا راسخًا. قمر الحصاد هو البدر الأقرب إلى الاعتدال الخريفي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama mengikuti tradisi Amerika Utara (Old Farmer's Almanac); padanannya adalah terjemahan, bukan tradisi Indonesia. Bulan Panen adalah purnama yang paling dekat dengan ekuinoks September."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نام شمالی امریکی روایت سے ہیں (Old Farmer's Almanac)؛ اردو نام ترجمہ ہیں۔ فصل کا چاند ستمبر کے اعتدال کے قریب ترین پورا چاند ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام‌ها از سنت آمریکای شمالی است (Old Farmer's Almanac) و برابرهای فارسی ترجمه‌اند. ماه برداشت نزدیک‌ترین ماه کامل به اعتدال پاییزی است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms suivent la tradition nord-américaine (Old Farmer's Almanac) ; les formes françaises sont des traductions. La Lune des moissons est la pleine lune la plus proche de l'équinoxe de septembre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Названия — из североамериканской традиции (Old Farmer's Almanac); русские варианты — перевод. Урожайная Луна — полнолуние, ближайшее к осеннему равноденствию."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前は北米の伝統（Old Farmer's Almanac）によるものです。ハーベストムーンは秋分に最も近い満月です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 북아메리카 전통(Old Farmer's Almanac)을 따릅니다. 하베스트문은 추분에 가장 가까운 보름달입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称来自北美传统（Old Farmer's Almanac），中文为译名。收获月是最接近秋分的满月。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga pangalan ay mula sa tradisyong Hilagang Amerikano (Old Farmer's Almanac). Ang Harvest Moon ang kabilugang pinakamalapit sa equinox ng Setyembre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อมาจากธรรมเนียมอเมริกาเหนือ (Old Farmer's Almanac) ชื่อภาษาไทยเป็นคำแปล จันทร์เก็บเกี่ยวคือจันทร์เต็มดวงที่ใกล้วิษุวัตเดือนกันยายนที่สุด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres siguen la tradición norteamericana (Old Farmer's Almanac); las formas en español son traducciones. La Luna de la Cosecha es la luna llena más cercana al equinoccio de septiembre."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes seguem a tradição norte-americana (Old Farmer's Almanac); as formas em português são traduções. A Lua da Colheita é a lua cheia mais próxima do equinócio de setembro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम उत्तर अमेरिकी परंपरा (Old Farmer's Almanac) से हैं; हिंदी नाम अनुवाद हैं। फ़सल चाँद सितंबर विषुव के सबसे पास की पूर्णिमा है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামগুলো উত্তর আমেরিকার ঐতিহ্য অনুসরণ করে (Old Farmer's Almanac)। ফসলের চাঁদ হলো সেপ্টেম্বরের বিষুবের সবচেয়ে কাছের পূর্ণিমা।"
          }
        }
      }
    },
