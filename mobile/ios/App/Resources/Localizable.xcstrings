    "geo.noLocation": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum bulunamadı; konum izni ve kesin konum açık mı?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location not found; are location permission and precise location on?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standort nicht gefunden; sind Standortzugriff und genauer Standort aktiv?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məkan tapılmadı; məkan icazəsi və dəqiq məkan açıqdır?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد الموقع؛ هل إذن الموقع والموقع الدقيق مفعّلان؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi tidak ditemukan; apakah izin lokasi dan lokasi tepat aktif?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام نہیں ملا؛ کیا مقام کی اجازت اور درست مقام آن ہیں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موقعیت پیدا نشد؛ آیا اجازهٔ موقعیت و موقعیت دقیق روشن‌اند؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Position introuvable ; l’accès à la position et la position exacte sont-ils activés ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение не найдено; включены ли доступ к геопозиции и точная геопозиция?"
          }
        }
      }
    },
    "geo.mapHint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeri değiştirmek için haritaya dokunun. Harita Apple'dan gelir; hatırlatıcının yeri telefonda kalır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the map to move the place. The map comes from Apple; the reminder's place stays on your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf die Karte, um den Ort zu verschieben. Die Karte stammt von Apple; der Ort der Erinnerung bleibt auf dem Telefon."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeri dəyişmək üçün xəritəyə toxunun. Xəritə Apple-dan gəlir; xatırladıcının yeri telefonda qalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على الخريطة لتغيير المكان. الخريطة من Apple؛ ويبقى مكان التذكير على هاتفك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk peta untuk memindahkan tempat. Peta berasal dari Apple; tempat pengingat tetap di ponsel Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جگہ ہلانے کے لیے نقشے پر ٹیپ کریں۔ نقشہ ایپل کا ہے؛ یاد دہانی کی جگہ آپ کے فون پر رہتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای جابه‌جایی مکان روی نقشه بزنید. نقشه از اپل است؛ مکان یادآور روی گوشی شما می‌ماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la carte pour déplacer le lieu. La carte vient d’Apple ; le lieu du rappel reste sur votre téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на карту, чтобы переместить место. Карта — от Apple; место напоминания остаётся на телефоне."
          }
        }
      }
    },
    "geo.placeHintAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yer, yeni hatırlatıcıda uygulamada seçili konumdur; bulunduğunuz yeri kullanmak için yukarıdaki düğmeye dokunun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new reminder starts at the place selected in the app; tap the button above to use where you are."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Erinnerung beginnt am in der App gewählten Ort; tippen Sie oben, um Ihren aktuellen Standort zu verwenden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni xatırladıcıda yer tətbiqdə seçilmiş məkandır; olduğunuz yeri istifadə etmək üçün yuxarıdakı düyməyə toxunun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ التذكير الجديد بالمكان المحدد في التطبيق؛ انقر الزر أعلاه لاستخدام مكانك الحالي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat baru dimulai di tempat yang dipilih di aplikasi; ketuk tombol di atas untuk memakai lokasi Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئی یاد دہانی ایپ میں منتخب جگہ سے شروع ہوتی ہے؛ اپنا مقام استعمال کرنے کے لیے اوپر کا بٹن دبائیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادآور تازه از مکان انتخابی در برنامه آغاز می‌شود؛ برای استفاده از جایی که هستید دکمهٔ بالا را بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau rappel commence au lieu choisi dans l’app ; touchez le bouton ci-dessus pour utiliser votre position."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новое напоминание начинается с места, выбранного в приложении; нажмите кнопку выше, чтобы взять ваше местоположение."
          }
        }
      }
    },
    "geo.allow": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum iznini ver"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location access"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standortzugriff erlauben"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məkan icazəsi ver"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالوصول إلى الموقع"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses lokasi"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام تک رسائی کی اجازت دیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازهٔ دسترسی به موقعیت"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’accès à la position"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить доступ к геопозиции"
          }
        }
      }
    },
    "geo.allowAlways": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Her zaman izin ver\"i seç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose \"Allow all the time\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Immer zulassen\" wählen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Həmişə icazə ver\"i seç"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر \"السماح طوال الوقت\""
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih \"Izinkan sepanjang waktu\""
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "«ہر وقت اجازت دیں» منتخب کریں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«همیشه مجاز» را برگزینید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez « Toujours autoriser »"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Разрешить в любом режиме»"
          }
        }
      }
    },
    "geo.denied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum izni olmadan hatırlatıcılar çalışmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders do not work without location access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Standortzugriff funktionieren die Erinnerungen nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məkan icazəsi olmadan xatırladıcılar işləmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تعمل التذكيرات دون إذن الوصول إلى الموقع."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat tidak berfungsi tanpa akses lokasi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام تک رسائی کے بغیر یاد دہانیاں کام نہیں کرتیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادآورها بدون دسترسی به موقعیت کار نمی‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels ne fonctionnent pas sans accès à la position."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без доступа к геопозиции напоминания не работают."
          }
        }
      }
    },
    "geo.notPrecise": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Kesin Konum\" kapalı: iPhone bölge hatırlatıcılarını yalnız kesin konumla çalıştırır (Ayarlar › Saat Tarih › Konum)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Precise Location\" is off: iPhone runs place reminders only with precise location (Settings › Time & Date › Location)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Genauer Standort\" ist aus: Das iPhone führt Ortserinnerungen nur mit genauem Standort aus (Einstellungen › Uhr & Datum › Standort)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Dəqiq məkan\" bağlıdır: iPhone yer xatırladıcılarını yalnız dəqiq məkanla işlədir (Ayarlar › Saat Tarix › Məkan)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"الموقع الدقيق\" متوقف: لا يشغّل iPhone تذكيرات المكان إلا بالموقع الدقيق (الإعدادات › الوقت والتاريخ › الموقع)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Lokasi Tepat\" nonaktif: iPhone hanya menjalankan pengingat tempat dengan lokasi tepat (Pengaturan › Jam & Tanggal › Lokasi)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "«درست مقام» بند ہے: آئی فون مقام کی یاد دہانیاں صرف درست مقام کے ساتھ چلاتا ہے (ترتیبات › وقت اور تاریخ › مقام)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«موقعیت دقیق» خاموش است: آیفون یادآورهای مکانی را فقط با موقعیت دقیق اجرا می‌کند (تنظیمات › ساعت و تاریخ › موقعیت)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Position exacte » est désactivée : l’iPhone n’exécute les rappels de lieu qu’avec la position exacte (Réglages › Heure & Date › Position)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Точная геопозиция» выключена: iPhone выполняет напоминания по месту только с точной геопозицией (Настройки › Время и дата › Геопозиция)."
          }
        }
      }
    },
    "geo.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varış ve ayrılışı iPhone kendisi izler; uygulama arka planda çalışmaz, konumunuz hiçbir yere gönderilmez. En çok 20 hatırlatıcı. Bildirim telefonun ses ayarına uyar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone itself watches for arrivals and departures; the app does not run in the background and your location is not sent anywhere. Up to 20 reminders. The alert follows the phone's sound settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone selbst erkennt Ankunft und Verlassen; die App läuft nicht im Hintergrund und Ihr Standort wird nirgendwohin gesendet. Höchstens 20 Erinnerungen. Die Mitteilung folgt den Toneinstellungen des Telefons."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çatma və ayrılmanı iPhone özü izləyir; tətbiq arxa planda işləmir, məkanınız heç yerə göndərilmir. Ən çox 20 xatırladıcı. Bildiriş telefonun səs ayarına uyğundur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يراقب iPhone نفسه الوصول والمغادرة؛ لا يعمل التطبيق في الخلفية ولا يُرسل موقعك إلى أي مكان. 20 تذكيرًا على الأكثر. يتبع التنبيه إعدادات صوت الهاتف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone sendiri yang memantau kedatangan dan kepergian; aplikasi tidak berjalan di latar belakang dan lokasi Anda tidak dikirim ke mana pun. Hingga 20 pengingat. Peringatan mengikuti pengaturan suara ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئی فون خود پہنچنے اور نکلنے پر نظر رکھتا ہے؛ ایپ پس منظر میں نہیں چلتی اور آپ کا مقام کہیں نہیں بھیجا جاتا۔ زیادہ سے زیادہ 20 یاد دہانیاں۔ انتباہ فون کی آواز کی ترتیبات کے مطابق ہوتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خود آیفون رسیدن‌ها و رفتن‌ها را می‌پاید؛ برنامه در پس‌زمینه کار نمی‌کند و موقعیت شما به جایی فرستاده نمی‌شود. حداکثر 20 یادآور. هشدار از تنظیمات صدای گوشی پیروی می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone surveille lui-même les arrivées et les départs ; l’app ne tourne pas en arrière-plan et votre position n’est envoyée nulle part. Jusqu’à 20 rappels. L’alerte suit les réglages sonores du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone сам отслеживает прибытие и уход; приложение не работает в фоне, и ваше местоположение никуда не отправляется. До 20 напоминаний. Сигнал следует настройкам звука телефона."
          }
        }
      }
    },
    "geo.noteAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varış ve ayrılışı Android'in bölge izleme hizmeti izler; uygulama arka planda çalışmaz, konumunuz hiçbir yere gönderilmez. Bunun için \"Her zaman izin ver\" konum izni gerekir. En çok 20 hatırlatıcı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android's geofencing service watches for arrivals and departures; the app does not run in the background and your location is not sent anywhere. This needs the \"Allow all the time\" location permission. Up to 20 reminders."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Geofencing-Dienst von Android erkennt Ankunft und Verlassen; die App läuft nicht im Hintergrund und Ihr Standort wird nirgendwohin gesendet. Dafür ist die Standortberechtigung \"Immer zulassen\" nötig. Höchstens 20 Erinnerungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çatma və ayrılmanı Android-in sahə izləmə xidməti izləyir; tətbiq arxa planda işləmir, məkanınız heç yerə göndərilmir. Bunun üçün \"Həmişə icazə ver\" məkan icazəsi lazımdır. Ən çox 20 xatırladıcı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراقب خدمة السياج الجغرافي في Android الوصول والمغادرة؛ لا يعمل التطبيق في الخلفية ولا يُرسل موقعك إلى أي مكان. يتطلب ذلك إذن الموقع \"السماح طوال الوقت\". 20 تذكيرًا على الأكثر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan geofencing Android memantau kedatangan dan kepergian; aplikasi tidak berjalan di latar belakang dan lokasi Anda tidak dikirim ke mana pun. Memerlukan izin lokasi \"Izinkan sepanjang waktu\". Hingga 20 pengingat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اینڈرائیڈ کی جیوفینسنگ سروس پہنچنے اور نکلنے پر نظر رکھتی ہے؛ ایپ پس منظر میں نہیں چلتی اور آپ کا مقام کہیں نہیں بھیجا جاتا۔ اس کے لیے «ہر وقت اجازت دیں» مقام کی اجازت چاہیے۔ زیادہ سے زیادہ 20 یاد دہانیاں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس حصار جغرافیایی اندروید رسیدن‌ها و رفتن‌ها را می‌پاید؛ برنامه در پس‌زمینه کار نمی‌کند و موقعیت شما به جایی فرستاده نمی‌شود. این به اجازهٔ موقعیت «همیشه مجاز» نیاز دارد. حداکثر 20 یادآور."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de géorepérage d’Android surveille les arrivées et les départs ; l’app ne tourne pas en arrière-plan et votre position n’est envoyée nulle part. Cela nécessite l’autorisation de position « Toujours autoriser ». Jusqu’à 20 rappels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба геозон Android отслеживает прибытие и уход; приложение не работает в фоне, и ваше местоположение никуда не отправляется. Нужно разрешение на геопозицию «Разрешить в любом режиме». До 20 напоминаний."
          }
        }
      }
    },
    "geo.backgroundAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcıların uygulama kapalıyken çalışması için konum izninde \"Her zaman izin ver\" seçilmeli."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For reminders to work while the app is closed, choose \"Allow all the time\" in the location permission."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit Erinnerungen bei geschlossener App funktionieren, wählen Sie in der Standortberechtigung \"Immer zulassen\"."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xatırladıcıların tətbiq bağlı ikən işləməsi üçün məkan icazəsində \"Həmişə icazə ver\" seçilməlidir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكي تعمل التذكيرات والتطبيق مغلق، اختر \"السماح طوال الوقت\" في إذن الموقع."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar pengingat berfungsi saat aplikasi ditutup, pilih \"Izinkan sepanjang waktu\" pada izin lokasi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ بند ہونے پر بھی یاد دہانیاں چلانے کے لیے مقام کی اجازت میں «ہر وقت اجازت دیں» منتخب کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای کار کردن یادآورها وقتی برنامه بسته است، در اجازهٔ موقعیت «همیشه مجاز» را برگزینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que les rappels fonctionnent app fermée, choisissez « Toujours autoriser » dans l’autorisation de position."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы напоминания работали при закрытом приложении, выберите «Разрешить в любом режиме» в разрешении на геопозицию."
          }
        }
      }
    },
    "alarm.calLead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlikten önce"
          }
        },
