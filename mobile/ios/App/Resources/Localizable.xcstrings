    "track.privacy": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgiler yalnız bu cihazda tutulur; hiçbir yere gönderilmez, rozet de verilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is kept only on this device; it is not sent anywhere and earns no badges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Angaben bleiben nur auf diesem Gerät; sie werden nirgendwohin gesendet und bringen keine Abzeichen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu məlumatlar yalnız bu cihazda saxlanılır; heç yerə göndərilmir, nişan da verilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ هذه المعلومات على هذا الجهاز فقط ولا تُرسل إلى أي مكان ولا تمنح شارات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data ini hanya disimpan di perangkat ini; tidak dikirim ke mana pun dan tidak memberi lencana."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ صرف اسی آلے پر رہتا ہے؛ کہیں نہیں بھیجا جاتا اور اس پر کوئی بیج نہیں ملتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این‌ها فقط روی همین دستگاه می‌مانند؛ به جایی فرستاده نمی‌شوند و در کسب نشان‌ها شمرده نمی‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces données restent uniquement sur cet appareil ; elles ne sont envoyées nulle part et ne donnent aucun badge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это хранится только на этом устройстве, никуда не отправляется и значков не даёт."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この記録はこの端末にだけ保存され、どこにも送られません。バッジの対象にもなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기록은 이 기기에만 저장되며 어디에도 보내지 않고 배지도 주어지지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些记录只保存在此设备上，不会发送到任何地方，也不会获得徽章。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa device na ito lang ito nakatago; hindi ipinapadala kahit saan at walang badge."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกนี้เก็บไว้ในอุปกรณ์นี้เท่านั้น ไม่ส่งไปที่ใด และไม่นำไปใช้รับเหรียญตรา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se guarda solo en este dispositivo; no se envía a ninguna parte ni da insignias."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto fica só neste aparelho; não é enviado a lugar nenhum e não gera medalhas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल इसी डिवाइस पर रहता है; कहीं नहीं भेजा जाता और इससे बैज नहीं मिलते।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি শুধু এই ডিভাইসে রাখা হয়; কোথাও পাঠানো হয় না এবং কোনো ব্যাজ দেয় না।"
          }
        }
      }
    },
