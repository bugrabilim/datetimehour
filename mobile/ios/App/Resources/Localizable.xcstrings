    "intent.alarm.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilen saate bir kezlik alarm kurar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets a one-time alarm for the given time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt einen einmaligen Wecker für die angegebene Uhrzeit."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilən saata birdəfəlik zəngli saat qurur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضبط منبهًا لمرة واحدة في الوقت المحدد."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memasang alarm sekali untuk waktu yang ditentukan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیے گئے وقت کے لیے ایک بار کا الارم لگاتا ہے۔"
