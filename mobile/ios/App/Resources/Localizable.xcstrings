    "widget.world8.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekiz şehrin saati, kısa kodları ve gündüz/gece işaretiyle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time in eight cities, with short codes and a day/night mark."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Städte mit Kurzcodes und Tag-/Nacht-Zeichen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səkkiz şəhərin saatı, qısa kodları və gündüz/gecə işarəsi ilə."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوقت في ثماني مدن برموز مختصرة وعلامة نهار/ليل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan kota dengan kode singkat dan tanda siang/malam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آٹھ شہروں کا وقت، مختصر کوڈ اور دن/رات کے نشان کے ساتھ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت هشت شهر با کد کوتاه و نشان روز/شب."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit villes avec codes courts et repère jour/nuit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восемь городов с короткими кодами и отметкой дня и ночи."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8都市の時刻を略号と昼夜マーク付きで表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8개 도시의 시각을 약어와 낮/밤 표시와 함께."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "8 个城市的时间，附简码和昼夜标记。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walong lungsod na may maikling code at tanda ng araw/gabi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาของ 8 เมือง พร้อมรหัสย่อและสัญลักษณ์กลางวัน/กลางคืน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de ocho ciudades, con códigos cortos y una marca de día/noche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A hora de oito cidades, com códigos curtos e uma marca de dia/noite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आठ शहरों का समय, छोटे कोड और दिन/रात के निशान के साथ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আটটি শহরের সময়, ছোট কোড ও দিন/রাতের চিহ্নসহ।"
          }
        }
      }
    },
