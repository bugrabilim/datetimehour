    "notify.sound.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli duyuru kısa bir zilden sonra vakti söyler, örneğin \"Öğle vakti geldi.\" Telefon sessizdeyken bildirim yalnız titreşir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The spoken announcement says the prayer after a short chime, for example \"It is time for Dhuhr.\" When the phone is silenced, notifications only vibrate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ansage nennt nach einem kurzen Gong das Gebet, zum Beispiel „Es ist Zeit für Dhuhr.“ Ist das Telefon stumm geschaltet, vibrieren Benachrichtigungen nur."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səsli elan qısa zəngdən sonra vaxtı deyir, məsələn \"Zöhr vaxtı gəldi.\" Telefon səssiz rejimdə olanda bildiriş yalnız titrəyir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكر الإعلان الصوتي الصلاة بعد رنين قصير، مثل «حان وقت الظهر». عندما يكون الهاتف صامتًا يكتفي الإشعار بالاهتزاز."
          }
        }
      }
    },
    "notify.spoken.now": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vakti geldi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is time for %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist Zeit für %1$@."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vaxtı gəldi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حان وقت %1$@."
          }
        }
      }
    },
    "notify.spoken.before": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vaktine %2$@ dakika kaldı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ minutes until %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %2$@ Minuten bis %1$@."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vaxtına %2$@ dəqiqə qaldı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بقي %2$@ دقيقة على %1$@."
          }
        }
      }
    },
    "notify.sound.better": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha doğal bir ses için: Ayarlar → Erişilebilirlik → Seslendirilen İçerik → Sesler → Türkçe bölümünden \"Gelişmiş\" bir ses indirin (ör. Yelda). Uygulamayı yeniden açınca sesler yenilenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a more natural voice: Settings → Accessibility → Spoken Content → Voices → English, then download an \"Enhanced\" voice. The sounds are renewed the next time you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine natürlichere Stimme: Einstellungen → Bedienungshilfen → Gesprochene Inhalte → Stimmen → Deutsch und eine „Erweitert“-Stimme laden. Beim nächsten Öffnen der App werden die Töne erneuert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha təbii səs üçün: Parametrlər → Əlçatımlılıq → Səsləndirilən məzmun → Səslər → Türkcə bölməsindən \"Təkmil\" səs yükləyin. Tətbiqi yenidən açanda səslər yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لصوت أكثر طبيعية: الإعدادات ← تسهيلات الاستخدام ← المحتوى المنطوق ← الأصوات ← العربية، ثم نزّل صوتًا «محسّنًا». تتجدد الأصوات عند فتح التطبيق مرة أخرى."
          }
        }
      }
    },
