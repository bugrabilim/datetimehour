    "qibla.timeNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu saatte Güneş tam kıble yönündedir: Güneş'e dönen kıbleye dönmüş olur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this time the Sun is exactly in the qibla direction: facing the Sun means facing the qibla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu dieser Zeit steht die Sonne genau in Qibla-Richtung: Wer zur Sonne blickt, blickt zur Qibla."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu vaxt Günəş tam qiblə istiqamətindədir: Günəşə üz tutan qibləyə üz tutmuş olur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في هذا الوقت تكون الشمس في اتجاه القبلة تمامًا: من يستقبل الشمس يستقبل القبلة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada waktu ini Matahari tepat berada di arah kiblat: menghadap Matahari berarti menghadap kiblat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس وقت سورج عین قبلے کی سمت میں ہوتا ہے: سورج کی طرف رخ کرنا قبلے کی طرف رخ کرنا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در این وقت خورشید درست در جهت قبله است: رو به خورشید یعنی رو به قبله."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cette heure, le Soleil est exactement dans la direction de la qibla : faire face au Soleil, c’est faire face à la qibla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В это время Солнце находится точно в направлении киблы: повернувшись к Солнцу, вы повернётесь к кибле."
          }
        }
      }
    },
    "qibla.noTime": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün Güneş kıble yönünden geçmiyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today the Sun does not pass the qibla direction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute steht die Sonne nicht in Qibla-Richtung."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün Günəş qiblə istiqamətindən keçmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تمر الشمس اليوم باتجاه القبلة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari ini Matahari tidak melewati arah kiblat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج سورج قبلے کی سمت سے نہیں گزرتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امروز خورشید از جهت قبله نمی‌گذرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, le Soleil ne passe pas par la direction de la qibla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня Солнце не проходит через направление киблы."
          }
        }
      }
    },
    "qibla.aligned": {
      "extractionState": "manual",
      "localizations": {
