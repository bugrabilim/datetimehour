    "wakegame.sleepText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyuyorum. Alarmınız çalınca kalkın, beni de uyandırın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm asleep. Get up when your alarm rings and wake me too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schlafe. Stehen Sie auf, wenn Ihr Wecker klingelt, und wecken Sie mich mit."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatıram. Zənginiz çalanda qalxın, məni də oyadın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنا نائم. انهض عندما يرنّ منبّهك وأيقظني معك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aku sedang tidur. Bangunlah saat alarm Anda berbunyi dan bangunkan aku juga."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں سو رہا ہوں۔ الارم بجے تو اٹھو اور مجھے بھی جگاؤ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خوابم. وقتی زنگت به صدا درآمد بلند شو و مرا هم بیدار کن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dors. Levez-vous quand votre alarme sonne et réveillez-moi aussi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я сплю. Вставайте, когда зазвонит будильник, и разбудите меня."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま寝ています。アラームが鳴ったら起きて、わたしも起こしてね。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자고 있어요. 알람이 울리면 일어나서 저도 깨워 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我在睡觉。闹钟响了就起床，也把我叫醒吧。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Natutulog ako. Bumangon po kayo kapag tumunog ang inyong alarm at gisingin din ninyo ako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันหลับอยู่ ตื่นเมื่อนาฬิกาปลุกดังแล้วปลุกฉันด้วยนะ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy dormido. Levántese cuando suene su alarma y despiérteme a mí también."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou dormindo. Levante quando o alarme tocar e me acorde também."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं सो रहा हूँ। अलार्म बजने पर उठें और मुझे भी जगाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি ঘুমিয়ে আছি। অ্যালার্ম বাজলে উঠুন আর আমাকেও জাগান।"
          }
        }
      }
    },
