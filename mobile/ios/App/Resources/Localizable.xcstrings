    "esma.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiye'de yaygın liste (Allah ile başlayan 99 isim, Tirmizî rivayeti). Anlamlar kısa açıklamadır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list common in Türkiye (99 names beginning with Allah, as narrated by at-Tirmidhi). Meanings are short explanations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die in der Türkei übliche Liste (99 Namen, beginnend mit Allah, nach at-Tirmidhi). Die Bedeutungen sind kurze Erläuterungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiyədə yayğın siyahı (Allah ilə başlayan 99 ad, Tirmizi rəvayəti). Mənalar qısa izahdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القائمة الشائعة في تركيا (99 اسمًا تبدأ بلفظ الجلالة، برواية الترمذي)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar yang umum di Turki (99 nama diawali Allah, menurut riwayat at-Tirmidzi). Maknanya berupa penjelasan singkat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترکی میں رائج فہرست (اللہ سے شروع ہونے والے 99 نام، ترمذی کی روایت کے مطابق)۔ معانی مختصر وضاحتیں ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرست رایج در ترکیه (99 نام که با «الله» آغاز می‌شود، به روایت ترمذی). معانی توضیحاتی کوتاه‌اند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste courante en Turquie (99 noms commençant par Allah, rapportés par at-Tirmidhi). Les significations sont de courtes explications."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список, принятый в Турции (99 имён, начиная с «Аллах», по передаче ат-Тирмизи). Значения — краткие пояснения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トルコで一般的な一覧（ティルミズィーの伝承による、アッラーで始まる99の名）。意味は短い説明です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "튀르키예에서 널리 쓰는 목록(티르미지의 전승에 따른, 알라로 시작하는 99가지 이름). 뜻은 짧은 설명입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "土耳其通行的列表（据提尔米济传述，以“安拉”开头的99个尊名）。含义为简短说明。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang listahang karaniwan sa Türkiye (99 na pangalang nagsisimula sa Allah, ayon sa salaysay ni at-Tirmidhi). Maiikling paliwanag ang mga kahulugan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการที่ใช้กันทั่วไปในตุรกี (99 พระนามขึ้นต้นด้วยอัลลอฮ์ ตามรายงานของอัตติรมิซี) ความหมายเป็นคำอธิบายสั้น ๆ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista habitual en Turquía (99 nombres, empezando por Alá, según la narración de at-Tirmidhi). Los significados son explicaciones breves."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista comum na Turquia (99 nomes começando por Alá, conforme a narração de at-Tirmidhi). Os significados são explicações curtas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुर्किये में प्रचलित सूची (अल्लाह से शुरू होने वाले 99 नाम, तिर्मिज़ी की रिवायत के अनुसार)। अर्थ संक्षिप्त व्याख्याएँ हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুরস্কে প্রচলিত তালিকা (আল্লাহ দিয়ে শুরু হওয়া 99টি নাম, তিরমিজির বর্ণনা অনুযায়ী)। অর্থগুলো সংক্ষিপ্ত ব্যাখ্যা।"
          }
        }
      }
    },
