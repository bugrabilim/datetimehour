        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your heart be light and your path open this year."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möge Ihr Herz im neuen Jahr leicht und Ihr Weg offen sein."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni ildə qəlbiniz rahat, yolunuz açıq olsun."
