            "state": "translated",
            "value": "韩国阴历"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendaryong lunar ng Korea"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินจันทรคติเกาหลี"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario lunar coreano"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendário lunar coreano"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोरियाई चंद्र कैलेंडर"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোরীয় চান্দ্র ক্যালেন্ডার"
          }
        }
      }
    },
    "cals.korean.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kore'nin geleneksel ay-güneş takvimi: Seollal, Chuseok ve diğer bayramlar ile 24 güneş dönemi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Korea’s traditional lunisolar calendar: Seollal, Chuseok and other festivals, and the 24 solar terms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der traditionelle Lunisolarkalender Koreas: Seollal, Chuseok und weitere Feste sowie die 24 Sonnenperioden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Koreyanın ənənəvi ay-günəş təqvimi: Seollal, Chuseok və digər bayramlar, 24 günəş dövrü."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقويم القمري الشمسي التقليدي في كوريا: سولال وتشوسوك والأعياد الأخرى، والفصول الشمسية الأربعة والعشرون."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender lunisolar tradisional Korea: Seollal, Chuseok, dan perayaan lainnya, serta 24 periode matahari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوریا کا روایتی قمری شمسی کیلنڈر: سیولال، چوسوک اور دوسرے تہوار، اور 24 شمسی ادوار۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گاه‌شماری قمری‌خورشیدی سنتی کره: سولال، چوسوک و جشن‌های دیگر و 24 دوره خورشیدی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier luni-solaire traditionnel de la Corée : Seollal, Chuseok et autres fêtes, et les 24 termes solaires."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Традиционный лунно-солнечный календарь Кореи: Соллаль, Чхусок и другие праздники, 24 солнечных сезона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "韓国の伝統的な太陰太陽暦。ソルラル、チュソクなどの名節と二十四節気を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한국의 전통 태음태양력: 설날, 추석 등 명절과 24절기."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "韩国的传统阴阳历：韩国春节、秋夕等传统节日和二十四节气。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang tradisyonal na lunisolar na kalendaryo ng Korea: Seollal, Chuseok at iba pang pista, at ang 24 na solar term."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินสุริยจันทรคติดั้งเดิมของเกาหลี: ซอลลัล ชูซอก และเทศกาลอื่น ๆ และ 24 ช่วงฤดูกาลตามสุริยคติ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario lunisolar tradicional de Corea: Seollal, Chuseok y otras fiestas, y los 24 términos solares."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário lunissolar tradicional da Coreia: Seollal, Chuseok e outras festas, e os 24 termos solares."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोरिया का पारंपरिक चंद्र-सौर कैलेंडर: सोलाल, चुसोक और दूसरे पर्व, और 24 सौर अवधियाँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোরিয়ার প্রচলিত চান্দ্র-সৌর ক্যালেন্ডার: সল্লাল, চুসক ও অন্যান্য উৎসব এবং 24টি সৌর পর্ব।"
          }
        }
      }
    },
    "cals.korean.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay başları ve güneş dönemleri Kore saatiyle (UTC+9) astronomik hesaptan; Kore Astronomi ve Uzay Bilimi Enstitüsü (KASI) tablolarıyla aynıdır. Seollal ve Chuseok, önceki ve sonraki günle birlikte üç günlük resmî tatildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Month starts and solar terms are calculated astronomically for Korea time (UTC+9) and match the tables of the Korea Astronomy and Space Science Institute (KASI). Seollal and Chuseok are three-day public holidays together with the day before and the day after."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monatsanfänge und Sonnenperioden werden astronomisch für die koreanische Zeit (UTC+9) berechnet und stimmen mit den Tabellen des Korea Astronomy and Space Science Institute (KASI) überein. Seollal und Chuseok sind mit dem Vor- und dem Folgetag dreitägige gesetzliche Feiertage."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay başlanğıcları və günəş dövrləri Koreya vaxtı ilə (UTC+9) astronomik hesablanır və Koreya Astronomiya və Kosmik Elmlər İnstitutunun (KASI) cədvəlləri ilə eynidir. Seollal və Chuseok əvvəlki və sonrakı günlə birlikdə üç günlük rəsmi bayramdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب بدايات الأشهر والفصول الشمسية فلكيًا بتوقيت كوريا (UTC+9) وتطابق جداول معهد كوريا لعلوم الفلك والفضاء (KASI). سولال وتشوسوك عطلتان رسميتان لثلاثة أيام مع اليوم السابق واليوم التالي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Awal bulan dan periode matahari dihitung secara astronomis menurut waktu Korea (UTC+9) dan sesuai dengan tabel Institut Astronomi dan Ilmu Antariksa Korea (KASI). Seollal dan Chuseok adalah libur resmi tiga hari bersama hari sebelum dan sesudahnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مہینوں کا آغاز اور شمسی ادوار کوریا کے وقت (UTC+9) کے مطابق فلکیاتی حساب سے ہیں اور کوریا کے فلکیات و خلائی سائنس کے ادارے (KASI) کی جدولوں سے مطابقت رکھتے ہیں۔ سیولال اور چوسوک پچھلے اور اگلے دن سمیت تین دن کی سرکاری تعطیلات ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آغاز ماه‌ها و دوره‌های خورشیدی به وقت کره (UTC+9) با محاسبه نجومی است و با جدول‌های مؤسسه نجوم و علوم فضایی کره (KASI) یکسان است. سولال و چوسوک با روز پیش و روز پس از آن سه روز تعطیل رسمی‌اند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les débuts de mois et les termes solaires sont calculés astronomiquement pour l’heure de Corée (UTC+9) et concordent avec les tables du Korea Astronomy and Space Science Institute (KASI). Seollal et Chuseok sont des jours fériés de trois jours, avec la veille et le lendemain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начала месяцев и сезоны рассчитаны астрономически по времени Кореи (UTC+9) и совпадают с таблицами Корейского института астрономии и космических наук (KASI). Соллаль и Чхусок — трёхдневные официальные праздники вместе с днём до и днём после."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の始まりと二十四節気は韓国時間（UTC+9）で天文計算しており、韓国天文研究院（KASI）の暦と一致します。ソルラルとチュソクは前日と翌日を含む3日間の祝日です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월의 시작과 24절기는 한국 시간(UTC+9)으로 천문 계산했으며, 한국천문연구원(KASI)의 월력요항과 같습니다. 설날과 추석은 전날과 다음 날을 포함해 사흘 동안 공휴일입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月首和二十四节气按韩国时间（UTC+9）天文计算，与韩国天文研究院（KASI）的历表一致。韩国春节和秋夕连同前一天和后一天为三天公休日。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang simula ng mga buwan at ang mga solar term ay kinakalkula ayon sa astronomiya sa oras ng Korea (UTC+9) at tugma sa mga talaan ng Korea Astronomy and Space Science Institute (KASI). Ang Seollal at Chuseok ay tatlong araw na pista opisyal kasama ang araw bago at pagkatapos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันเริ่มเดือนและฤดูกาลสุริยะคำนวณทางดาราศาสตร์ตามเวลาเกาหลี (UTC+9) และตรงกับตารางของสถาบันดาราศาสตร์และวิทยาศาสตร์อวกาศเกาหลี (KASI) ซอลลัลและชูซอกเป็นวันหยุดราชการสามวันรวมวันก่อนหน้าและวันถัดไป"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de los meses y los términos solares se calculan astronómicamente para la hora de Corea (UTC+9) y coinciden con las tablas del Instituto de Astronomía y Ciencias Espaciales de Corea (KASI). Seollal y Chuseok son festivos de tres días junto con el día anterior y el siguiente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O início dos meses e os termos solares são calculados astronomicamente pelo horário da Coreia (UTC+9) e coincidem com as tabelas do Instituto de Astronomia e Ciências Espaciais da Coreia (KASI). Seollal e Chuseok são feriados de três dias, com o dia anterior e o seguinte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महीनों की शुरुआत और सौर अवधियाँ कोरिया के समय (UTC+9) के अनुसार खगोलीय गणना से हैं और कोरिया खगोल विज्ञान एवं अंतरिक्ष विज्ञान संस्थान (KASI) की तालिकाओं से मेल खाती हैं। सोलाल और चुसोक पिछले और अगले दिन सहित तीन दिन की सार्वजनिक छुट्टियाँ हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাস শুরু ও সৌর পর্বগুলো কোরিয়ার সময়ের (UTC+9) জন্য জ্যোতির্বিজ্ঞানের হিসাবে বের করা এবং কোরিয়া জ্যোতির্বিজ্ঞান ও মহাকাশ বিজ্ঞান ইনস্টিটিউটের (KASI) সারণির সঙ্গে মেলে। সল্লাল ও চুসক আগের ও পরের দিনসহ তিন দিনের সরকারি ছুটি।"
          }
        }
      }
    },
