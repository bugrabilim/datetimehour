    "sync.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarınız, dünya saatleri, geri sayımlar, kayıtlı yerler, pomodoro ve uyku kayıtları ile ibadet kayıtları aynı Apple hesabındaki iPhone, iPad ve Mac'inizde eşitlenir. Veri iCloud hesabınızda durur, bize gelmez. Konum, alarmlar, süren sayaçlar, bildirim ayarları, rozetler ve fotoğraflar her cihazda ayrıdır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings, world clocks, countdowns, saved places, pomodoro and sleep records and worship records are synced across the iPhone, iPad and Mac signed in to the same Apple Account. The data stays in your iCloud account and never reaches us. Location, alarms, running timers, notification settings, badges and photos stay separate on each device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Einstellungen, Weltuhren, Countdowns, gespeicherten Orte, Pomodoro- und Schlafdaten sowie Einträge zur Glaubenspraxis werden zwischen iPhone, iPad und Mac mit demselben Apple-Account synchronisiert. Die Daten bleiben in Ihrem iCloud-Account und erreichen uns nie. Standort, Wecker, laufende Timer, Mitteilungseinstellungen, Abzeichen und Fotos bleiben auf jedem Gerät getrennt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarınız, dünya saatları, geri sayımlar, saxlanmış yerlər, pomodoro və yuxu qeydləri, eləcə də ibadət qeydləri eyni Apple hesabındakı iPhone, iPad və Mac-da sinxronlaşdırılır. Məlumat iCloud hesabınızda qalır, bizə gəlmir. Məkan, zəngli saatlar, işləyən sayğaclar, bildiriş ayarları, nişanlar və fotolar hər cihazda ayrıdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُزامَن إعداداتك وساعات العالم والعدّ التنازلي والأماكن المحفوظة وسجلات بومودورو والنوم وسجلات العبادة بين أجهزة iPhone وiPad وMac المسجّلة بحساب Apple نفسه. تبقى البيانات في حساب iCloud الخاص بك ولا تصل إلينا. الموقع والمنبهات والمؤقتات الجارية وإعدادات الإشعارات والشارات والصور تبقى منفصلة على كل جهاز."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan, jam dunia, hitung mundur, tempat tersimpan, catatan pomodoro dan tidur, serta catatan ibadah Anda disinkronkan antara iPhone, iPad, dan Mac yang masuk dengan Akun Apple yang sama. Data tetap di akun iCloud Anda dan tidak pernah sampai ke kami. Lokasi, alarm, pengatur waktu yang berjalan, pengaturan notifikasi, lencana, dan foto tetap terpisah di tiap perangkat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ترتیبات، عالمی گھڑیاں، الٹی گنتیاں، محفوظ مقامات، پومودورو اور نیند کے ریکارڈ اور عبادت کے ریکارڈ ایک ہی Apple اکاؤنٹ والے آئی فون، آئی پیڈ اور میک میں ہم آہنگ ہوتے ہیں۔ ڈیٹا آپ کے iCloud اکاؤنٹ میں رہتا ہے اور کبھی ہم تک نہیں پہنچتا۔ مقام، الارم، چلتے ٹائمر، اطلاعات کی ترتیبات، بیجز اور تصاویر ہر آلے پر الگ رہتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات، ساعت‌های جهانی، شمارش‌های معکوس، مکان‌های ذخیره‌شده، سوابق پومودورو و خواب و سوابق عبادت شما میان آیفون، آیپد و مکِ شما که با همان حساب Apple وارد شده‌اند همگام می‌شوند. داده‌ها در حساب iCloud شما می‌مانند و هرگز به ما نمی‌رسند. موقعیت، هشدارها، تایمرهای در حال کار، تنظیمات اعلان، نشان‌ها و عکس‌ها برای هر دستگاه جدا می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réglages, horloges mondiales, comptes à rebours, lieux enregistrés, données de pomodoro, de sommeil et de pratique religieuse sont synchronisés entre l’iPhone, l’iPad et le Mac connectés au même compte Apple. Les données restent dans votre compte iCloud et ne nous parviennent jamais. La position, les alarmes, les minuteurs en cours, les réglages de notification, les badges et les photos restent propres à chaque appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки, мировые часы, обратные отсчёты, сохранённые места, записи помидора и сна, а также записи ибадата синхронизируются между iPhone, iPad и Mac с одним Аккаунтом Apple. Данные остаются в вашем iCloud и не попадают к нам. Местоположение, будильники, запущенные таймеры, настройки уведомлений, значки и фото на каждом устройстве свои."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定、世界時計、カウントダウン、保存した場所、ポモドーロと睡眠の記録、信仰の記録が、同じApple AccountでサインインしているiPhone、iPad、Macの間で同期されます。データはあなたのiCloudアカウントにとどまり、私たちには届きません。場所、アラーム、動作中のタイマー、通知の設定、バッジ、写真は端末ごとに別々です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정, 세계 시계, 카운트다운, 저장한 장소, 뽀모도로와 수면 기록, 신앙 기록이 같은 Apple 계정으로 로그인한 iPhone, iPad, Mac 사이에서 동기화됩니다. 데이터는 내 iCloud 계정에 머물며 저희에게 오지 않습니다. 위치, 알람, 실행 중인 타이머, 알림 설정, 배지, 사진은 기기별로 따로 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的设置、世界时钟、倒计时、已保存的地点、番茄钟和睡眠记录以及宗教功课记录，会在登录同一Apple账户的iPhone、iPad和Mac之间同步。数据保存在您的iCloud账户中，我们无法获取。位置、闹钟、正在运行的计时器、通知设置、徽章和照片在每台设备上各自独立。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sini-sync ang iyong settings, world clock, countdown, naka-save na lugar, tala ng pomodoro at tulog, at tala ng pagsamba sa iPhone, iPad at Mac na naka-sign in sa iisang Apple Account. Nananatili ang datos sa iyong iCloud account at hindi umaabot sa amin. Hiwalay sa bawat device ang lokasyon, alarma, tumatakbong timer, settings ng abiso, badge at larawan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า นาฬิกาโลก การนับถอยหลัง สถานที่ที่บันทึก บันทึกโพโมโดโรและการนอน และบันทึกอิบาดะฮ์ จะซิงค์ระหว่าง iPhone, iPad และ Mac ที่ลงชื่อเข้าใช้ด้วยบัญชี Apple เดียวกัน ข้อมูลอยู่ในบัญชี iCloud ของคุณและไม่ถูกส่งมาถึงเรา ตำแหน่ง นาฬิกาปลุก ตัวจับเวลาที่ทำงานอยู่ การตั้งค่าการแจ้งเตือน เหรียญตรา และรูปภาพจะแยกกันในแต่ละอุปกรณ์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus ajustes, relojes mundiales, cuentas atrás, lugares guardados, registros de pomodoro y de sueño y registros de culto se sincronizan entre el iPhone, el iPad y el Mac con la misma cuenta de Apple. Los datos se quedan en su cuenta de iCloud y nunca nos llegan. La ubicación, las alarmas, los temporizadores en marcha, los ajustes de notificaciones, las insignias y las fotos se quedan separados en cada dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas configurações, relógios mundiais, contagens regressivas, locais salvos, registros de pomodoro e de sono e registros de culto são sincronizados entre o iPhone, o iPad e o Mac com a mesma Conta Apple. Os dados ficam na sua conta do iCloud e nunca chegam até nós. Local, alarmes, temporizadores em andamento, configurações de notificação, medalhas e fotos ficam separados em cada aparelho."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सेटिंग्स, विश्व घड़ियाँ, काउंटडाउन, सहेजे स्थान, पोमोडोरो और नींद के रिकॉर्ड और इबादत के रिकॉर्ड उसी Apple खाते वाले iPhone, iPad और Mac के बीच सिंक होते हैं। डेटा आपके iCloud खाते में रहता है और हम तक कभी नहीं पहुँचता। स्थान, अलार्म, चलते टाइमर, सूचना सेटिंग्स, बैज और फ़ोटो हर डिवाइस पर अलग रहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সেটিংস, বিশ্ব ঘড়ি, কাউন্টডাউন, সংরক্ষিত জায়গা, পোমোডোরো ও ঘুমের রেকর্ড এবং ইবাদতের রেকর্ড একই Apple অ্যাকাউন্টে সাইন ইন করা iPhone, iPad ও Mac-এর মধ্যে সিঙ্ক হয়। তথ্য আপনার iCloud অ্যাকাউন্টে থাকে এবং কখনো আমাদের কাছে আসে না। অবস্থান, অ্যালার্ম, চলমান টাইমার, নোটিফিকেশন সেটিংস, ব্যাজ ও ছবি প্রতিটি ডিভাইসে আলাদা থাকে।"
          }
        }
      }
    },
