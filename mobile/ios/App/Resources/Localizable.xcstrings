          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт? Это нельзя отменить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除しますか？元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 삭제할까요? 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除账户吗？此操作无法撤销。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Burahin ang inyong account? Hindi na ito maibabalik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบัญชีหรือไม่ การลบนี้ย้อนกลับไม่ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar su cuenta? No se puede deshacer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir sua conta? Não dá para desfazer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता हटाएं? इसे वापस नहीं किया जा सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্ট মুছবেন? এটি ফেরানো যাবে না।"
          }
        }
      }
    },
