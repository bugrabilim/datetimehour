        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es posible registrarse aquí con esta dirección de correo; puede registrarse con otra dirección."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível se cadastrar aqui com este endereço de e-mail; você pode se cadastrar com outro endereço."
          }
