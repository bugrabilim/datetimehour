    "alarm.keysNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız alarm ekranı açıkken. Görevli alarm tuşla kapanmaz; ertelemek için görev seçiliyse önce görev açılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while the alarm screen is open. An alarm with a task can't be stopped with a button; if snoozing has a task, the task opens first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur bei geöffnetem Weckerbildschirm. Ein Wecker mit Aufgabe lässt sich nicht per Taste ausschalten; hat das Schlummern eine Aufgabe, öffnet sich zuerst diese."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız zəngli saat ekranı açıq olanda. Tapşırıqlı zəngli saat düymə ilə söndürülmür; təxir üçün tapşırıq varsa, əvvəlcə o açılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط عندما تكون شاشة المنبه مفتوحة. لا يُوقف المنبه ذو المهمة بالزر؛ وإذا كانت للغفوة مهمة فتُفتح أولًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya saat layar alarm terbuka. Alarm dengan tugas tidak bisa dimatikan dengan tombol; jika menunda butuh tugas, tugasnya terbuka dulu."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف جب الارم اسکرین کھلی ہو۔ کام والا الارم بٹن سے بند نہیں ہوتا؛ اگر اسنوز کے لیے کام ہو تو پہلے وہ کھلتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط وقتی صفحهٔ هشدار باز است. هشدارِ کاردار با دکمه خاموش نمی‌شود؛ اگر تعویق کار داشته باشد، اول آن باز می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement quand l'écran d'alarme est ouvert. Une alarme avec tâche ne s'arrête pas par bouton ; si la répétition a une tâche, celle-ci s'ouvre d'abord."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только когда открыт экран будильника. Будильник с заданием кнопкой не выключить; если для откладывания есть задание, сначала откроется оно."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラーム画面が開いているときのみ。タスク付きのアラームはボタンで止められず、スヌーズにタスクがある場合は先にタスクが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 화면이 열려 있을 때만 작동합니다. 과제가 있는 알람은 버튼으로 끌 수 없고, 다시 알림 과제가 있으면 과제가 먼저 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在闹钟界面打开时有效。带任务的闹钟无法用按键关闭；若稍后提醒设有任务，会先打开任务。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag bukas lang ang screen ng alarma. Hindi napapatigil sa button ang alarmang may gawain; kung may gawain ang snooze, iyon muna ang lalabas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ได้เฉพาะเมื่อหน้าจอปลุกเปิดอยู่ นาฬิกาปลุกที่มีภารกิจปิดด้วยปุ่มไม่ได้ ถ้าการเลื่อนมีภารกิจ ภารกิจจะเปิดก่อน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con la pantalla de la alarma abierta. Una alarma con tarea no se puede detener con un botón; si hay una tarea para aplazar, primero se abre la tarea."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só com a tela do alarme aberta. Um alarme com tarefa não pode ser parado por botão; se a soneca tiver tarefa, a tarefa abre primeiro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल अलार्म स्क्रीन खुली होने पर। कार्य वाला अलार्म बटन से नहीं रुकता; स्नूज़ के लिए कार्य हो तो पहले वह खुलता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু অ্যালার্মের পর্দা খোলা থাকলে। কাজযুক্ত অ্যালার্ম বোতাম দিয়ে থামানো যায় না; স্নুজে কাজ থাকলে আগে কাজটি খোলে।"
          }
        }
      }
    },
