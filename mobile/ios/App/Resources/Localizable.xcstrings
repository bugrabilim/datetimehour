    "perms.calendar.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verirseniz telefonunuzdaki etkinlikler özel günlerle bir arada görünür; okunanlar telefondan çıkmaz. Vermezseniz yalnız tatiller ve özel günler görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you allow it, your phone's events appear next to special days and never leave your phone. If not, only holidays and special days show."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie zustimmen, erscheinen Ihre Termine neben besonderen Tagen und verlassen Ihr Telefon nie. Sonst sehen Sie nur Feiertage und besondere Tage."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcazə versəniz, telefonunuzdakı tədbirlər xüsusi günlərlə birlikdə görünür və telefondan çıxmır. Verməsəniz, yalnız bayramlar və xüsusi günlər görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن سمحت، تظهر أحداث هاتفك بجانب الأيام الخاصة ولا تغادر هاتفك أبدًا. وإن لم تسمح، تظهر العطلات والأيام الخاصة فقط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diizinkan, acara di ponsel tampil bersama hari istimewa dan tidak pernah keluar dari ponsel. Jika tidak, hanya hari libur dan hari istimewa yang tampil."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازت دیں تو فون کے ایونٹس خاص دنوں کے ساتھ دکھیں گے اور فون سے باہر نہیں جائیں گے۔ نہ دیں تو صرف چھٹیاں اور خاص دن دکھیں گے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اجازه دهید، رویدادهای گوشی کنار روزهای خاص نمایش داده می‌شوند و هرگز از گوشی بیرون نمی‌روند. اگر ندهید، فقط تعطیلات و روزهای خاص دیده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous l'autorisez, les événements de votre téléphone s'affichent à côté des jours particuliers et ne quittent jamais l'appareil. Sinon, seuls les fériés et jours particuliers apparaissent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если разрешите, события из телефона появятся рядом с особыми днями и никуда не уйдут из телефона. Если нет, будут только праздники и особые дни."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可すると、スマートフォンの予定が特別な日と並んで表示され、端末の外に出ることはありません。許可しない場合は祝日と特別な日だけが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 휴대폰 일정이 특별한 날과 함께 보이고, 휴대폰 밖으로 나가지 않아요. 허용하지 않으면 공휴일과 특별한 날만 보여요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许后，手机里的日程会与特别日子一起显示，且不会离开手机；不允许则只显示节假日和特别日子。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung papayagan, lalabas ang mga event sa telepono kasama ng mga espesyal na araw at hindi lalabas sa telepono. Kung hindi, mga holiday at espesyal na araw lang ang makikita."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าอนุญาต กิจกรรมในโทรศัพท์จะแสดงคู่กับวันสำคัญและไม่ออกจากโทรศัพท์ ถ้าไม่อนุญาตจะเห็นเพียงวันหยุดและวันสำคัญ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo permite, los eventos de su teléfono aparecen junto a los días especiales y nunca salen del teléfono. Si no, solo verá festivos y días especiales."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se permitir, os eventos do celular aparecem ao lado das datas especiais e nunca saem do aparelho. Se não, só aparecem feriados e datas especiais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति दें तो फ़ोन के इवेंट खास दिनों के साथ दिखेंगे और फ़ोन से बाहर नहीं जाएँगे। न दें तो सिर्फ़ छुट्टियाँ और खास दिन दिखेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি দিলে আপনার ফোনের ইভেন্ট বিশেষ দিনগুলোর পাশে দেখা যায় এবং কখনো ফোন ছেড়ে যায় না। না দিলে শুধু ছুটি ও বিশেষ দিন দেখা যায়।"
          }
        }
      }
    },
