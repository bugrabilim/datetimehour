    "hijri.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hicri tarih Diyanet takvimine göredir; başka ülkelerde ay başı bir gün farklı olabilir. Gün, akşam değil gece yarısı değişir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Hijri date follows Türkiye's Diyanet calendar; in other countries a month may start a day earlier or later. The day changes at midnight, not at sunset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hidschri-Datum folgt dem Kalender des türkischen Diyanet; in anderen Ländern kann ein Monat einen Tag früher oder später beginnen. Der Tag wechselt um Mitternacht, nicht bei Sonnenuntergang."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hicri tarix Türkiyə Diyanətinin təqviminə görədir; başqa ölkələrdə ay bir gün tez və ya gec başlaya bilər. Gün axşam deyil, gecə yarısı dəyişir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ الهجري وفق تقويم رئاسة الشؤون الدينية التركية؛ وقد يبدأ الشهر في بلدان أخرى قبل يوم أو بعده. يتغير اليوم عند منتصف الليل لا عند الغروب."
          }
        }
      }
    },
