    "alarm.riseNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm sesi ilk 30 saniyede kısıktan tam sese çıkar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm sound rises from quiet to full volume over the first 30 seconds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Weckton steigt in den ersten 30 Sekunden von leise auf volle Lautstärke an."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəng səsi ilk 30 saniyədə zəifdən tam səsə qalxır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرتفع صوت المنبه من الهادئ إلى أعلى مستوى خلال أول 30 ثانية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara alarm naik dari pelan ke volume penuh selama 30 detik pertama."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم کی آواز پہلے 30 سیکنڈ میں دھیمی سے پوری بلند ہو جاتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدای هشدار در 30 ثانیهٔ نخست از آهسته به بلندی کامل می‌رسد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son de l’alarme passe de doux à fort pendant les 30 premières secondes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук будильника нарастает от тихого до полного за первые 30 секунд."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラーム音が最初の30秒で小さな音から最大音量まで上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 소리가 처음 30초 동안 작게 시작해 최대 음량까지 커집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟声音在前30秒内从轻声升到最大音量。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalakas ang tunog ng alarma mula mahina hanggang buong lakas sa unang 30 segundo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงปลุกจะดังขึ้นจากเบาไปจนสุดในช่วง 30 วินาทีแรก"
          }
        }
      }
    },
    "alarm.riseNoteIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumuşak bir melodi 20 saniyede kısıktan tam sese çıkar; açıkken iPhone'un alarm sesi yerine çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A soft melody rises from quiet to full volume over 20 seconds; when on, it plays instead of the iPhone alarm sound."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sanfte Melodie steigt in 20 Sekunden von leise auf volle Lautstärke an; wenn aktiv, ersetzt sie den iPhone-Weckton."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumşaq bir melodiya 20 saniyədə zəifdən tam səsə qalxır; açıq olanda iPhone-un zəng səsinin yerinə çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحن هادئ يرتفع من الخافت إلى أعلى مستوى خلال 20 ثانية؛ وعند تفعيله يُشغَّل بدل صوت منبه iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melodi lembut naik dari pelan ke volume penuh dalam 20 detik; bila aktif, melodi ini menggantikan suara alarm iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک نرم دھن 20 سیکنڈ میں دھیمی سے پوری بلند ہوتی ہے؛ آن ہو تو آئی فون کی الارم آواز کی جگہ بجتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهنگی ملایم در 20 ثانیه از آهسته به بلندی کامل می‌رسد؛ وقتی روشن است به جای صدای هشدار آیفون پخش می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une douce mélodie monte de doux à fort en 20 secondes ; lorsqu’elle est activée, elle remplace le son d’alarme de l’iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкая мелодия нарастает от тихой до полной громкости за 20 секунд; если включено, она звучит вместо звука будильника iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やわらかなメロディーが20秒かけて小さな音から最大音量まで上がります。オンにするとiPhoneのアラーム音の代わりに鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 멜로디가 20초에 걸쳐 작게 시작해 최대 음량까지 커집니다. 켜면 iPhone 알람 소리 대신 재생됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一段柔和的旋律在20秒内从轻声升到最大音量；开启后将代替iPhone闹钟声音播放。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalakas ang malambot na himig mula mahina hanggang buong lakas sa loob ng 20 segundo; kapag naka-on, ito ang tumutugtog sa halip na tunog ng alarma ng iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำนองนุ่มนวลจะดังขึ้นจากเบาไปจนสุดภายใน 20 วินาที เมื่อเปิดไว้จะเล่นแทนเสียงปลุกของ iPhone"
          }
        }
      }
    },
    "alarm.skipHolidays": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
