    "alarm.tzNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon başka bir saat dilimine geçse de alarm bu şehrin saatinde çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even if your phone moves to another time zone, the alarm rings at this city's time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch wenn das Telefon in eine andere Zeitzone wechselt, klingelt der Wecker zur Zeit dieser Stadt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon başqa saat qurşağına keçsə də, zəngli saat bu şəhərin saatı ilə çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى لو انتقل هاتفك إلى منطقة زمنية أخرى، يرن المنبه بتوقيت هذه المدينة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meski ponsel pindah ke zona waktu lain, alarm berbunyi pada waktu kota ini."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون کسی اور ٹائم زون میں چلا جائے تب بھی الارم اسی شہر کے وقت پر بجے گا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حتی اگر گوشی به منطقهٔ زمانی دیگری برود، هشدار به وقت این شهر زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même si le téléphone change de fuseau horaire, l'alarme sonne à l'heure de cette ville."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже если телефон перейдёт в другой часовой пояс, будильник зазвонит по времени этого города."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンが別のタイムゾーンに移っても、この都市の時刻で鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰이 다른 시간대로 바뀌어도 이 도시 시간에 맞춰 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使手机切换到其他时区，闹钟也按该城市时间响铃。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kahit lumipat ang telepono sa ibang time zone, tutunog ang alarma sa oras ng lungsod na ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้โทรศัพท์จะย้ายไปเขตเวลาอื่น นาฬิกาปลุกจะดังตามเวลาของเมืองนี้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aunque su teléfono pase a otra zona horaria, la alarma suena a la hora de esta ciudad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo que o celular mude de fuso horário, o alarme toca no horário desta cidade."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन दूसरे समय क्षेत्र में चला जाए तब भी अलार्म इस शहर के समय पर बजता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফোন অন্য সময় অঞ্চলে গেলেও অ্যালার্ম এই শহরের সময়ে বাজে।"
          }
        }
      }
    },
    "alarm.snoozeShrink": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ertelemede kısalsın"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shorter with each snooze"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit jedem Schlummern kürzer"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər təxirdə qısalsın"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقصر مع كل غفوة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makin singkat tiap kali ditunda"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر اسنوز پر کم ہو"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با هر تعویق کوتاه‌تر شود"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus court à chaque répétition"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короче с каждым откладыванием"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スヌーズごとに短く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 알림마다 짧게"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次稍后提醒时缩短"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikli nang paikli tuwing snooze"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สั้นลงทุกครั้งที่เลื่อน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más corto con cada aplazamiento"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais curto a cada soneca"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर स्नूज़ के साथ छोटा"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি স্নুজে ছোট হবে"
          }
        }
      }
    },
    "alarm.snoozeShrinkNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre her seferinde yarıya iner (10 → 5 → 2 → 1 dk)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time halves each time (10 → 5 → 2 → 1 min)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeit halbiert sich jedes Mal (10 → 5 → 2 → 1 Min.)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Müddət hər dəfə yarıya enir (10 → 5 → 2 → 1 dəq)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنقص المدة إلى النصف في كل مرة (10 ← 5 ← 2 ← 1 د)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktunya jadi setengah tiap kali (10 → 5 → 2 → 1 mnt)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر بار وقت آدھا ہو جاتا ہے (10 → 5 → 2 → 1 منٹ)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مدت هر بار نصف می‌شود (10 → 5 → 2 → 1 دقیقه)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée est divisée par deux à chaque fois (10 → 5 → 2 → 1 min)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время каждый раз сокращается вдвое (10 → 5 → 2 → 1 мин)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎回半分になります（10 → 5 → 2 → 1分）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매번 절반으로 줄어듭니다(10 → 5 → 2 → 1분)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次减半（10 → 5 → 2 → 1分钟）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahahati sa dalawa ang oras bawat beses (10 → 5 → 2 → 1 min)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาลดลงครึ่งหนึ่งทุกครั้ง (10 → 5 → 2 → 1 นาที)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo se reduce a la mitad cada vez (10 → 5 → 2 → 1 min)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo cai pela metade a cada vez (10 → 5 → 2 → 1 min)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर बार समय आधा होता है (10 → 5 → 2 → 1 मिनट)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিবার সময় অর্ধেক হয় (10 → 5 → 2 → 1 মিনিট)।"
          }
        }
      }
    },
