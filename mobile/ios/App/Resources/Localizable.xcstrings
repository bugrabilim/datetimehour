    "alarm.denied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm izni kapalı. Ayarlar'dan bu uygulama için alarmlara izin verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms are not allowed. Allow alarms for this app in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker sind nicht erlaubt. Erlauben Sie sie für diese App in den Einstellungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmlara icazə yoxdur. Parametrlərdə bu tətbiq üçün icazə verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
