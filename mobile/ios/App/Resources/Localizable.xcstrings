    "account.unsubDone": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutlama e-postaları kapatıldı. Önceden gönderime bırakılmış bir e-posta en geç 7 gün içinde gelebilir. Hesap sayfanızdan yeniden açabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Celebration emails are turned off. An email already scheduled may still arrive within 7 days. You can turn them back on from your account page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Glückwunsch-E-Mails sind abbestellt. Eine bereits geplante E-Mail kann noch innerhalb von 7 Tagen kommen. Auf Ihrer Kontoseite können Sie sie wieder einschalten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təbrik e-poçtları bağlandı. Əvvəlcədən göndərişə qoyulmuş e-poçt ən gec 7 gün ərzində gələ bilər. Hesab səhifənizdən yenidən aça bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُوقفت رسائل التهنئة. قد تصل رسالة مجدولة مسبقًا خلال 7 أيام. يمكنك إعادة تفعيلها من صفحة حسابك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Email ucapan telah dimatikan. Email yang sudah dijadwalkan mungkin masih datang dalam 7 hari. Anda dapat menyalakannya lagi dari halaman akun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مبارکباد کی ای میلز بند کر دی گئیں۔ پہلے سے طے شدہ ای میل 7 دن کے اندر آ سکتی ہے۔ آپ اکاؤنٹ کے صفحے سے انہیں دوبارہ آن کر سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایمیل‌های تبریک خاموش شد. ایمیلی که از پیش زمان‌بندی شده ممکن است تا 7 روز برسد. می‌توانید از صفحهٔ حسابتان دوباره روشنش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les e-mails de vœux sont désactivés. Un e-mail déjà programmé peut encore arriver dans les 7 jours. Vous pouvez les réactiver depuis la page de votre compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поздравительные письма отключены. Уже запланированное письмо может прийти в течение 7 дней. Включить их снова можно на странице аккаунта."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お祝いメールを停止しました。予約済みのメールが7日以内に届くことがあります。アカウントページから再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축하 이메일을 껐습니다. 이미 예약된 메일이 7일 안에 올 수 있습니다. 계정 페이지에서 다시 켤 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "祝贺邮件已关闭。已预定发送的邮件可能仍会在 7 天内到达。您可以在账户页面重新开启。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinatay na ang mga email ng pagbati. Puwede pang dumating sa loob ng 7 araw ang naka-iskedyul nang email. Puwede ninyo itong buksan ulit sa page ng inyong account."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดอีเมลแสดงความยินดีแล้ว อีเมลที่ตั้งเวลาไว้แล้วอาจยังมาถึงภายใน 7 วัน เปิดใหม่ได้จากหน้าบัญชี"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los correos de felicitación están desactivados. Un correo ya programado aún puede llegar en 7 días. Puede volver a activarlos desde la página de su cuenta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os e-mails de felicitação foram desativados. Um e-mail já agendado ainda pode chegar em até 7 dias. Você pode reativá-los na página da sua conta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बधाई ईमेल बंद कर दिए गए। पहले से तय ईमेल 7 दिन के भीतर आ सकता है। आप खाता पेज से इन्हें फिर चालू कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুভেচ্ছা ইমেইল বন্ধ করা হয়েছে। আগে থেকে নির্ধারিত ইমেইল 7 দিনের মধ্যে আসতে পারে। অ্যাকাউন্ট পেজ থেকে আবার চালু করতে পারেন।"
          }
        }
      }
    },
