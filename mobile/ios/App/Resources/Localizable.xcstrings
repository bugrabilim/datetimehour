            "value": "Contagem regressiva do sol na tela bloqueada"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक स्क्रीन पर सूरज का काउंटडाउन"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক স্ক্রিনে সূর্যের কাউন্টডাউন"
          }
        }
      }
    },
    "live.sun.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki gün doğumu ya da batımına kalan süre kilit ekranında görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the time left until the next sunrise or sunset on the Lock Screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Zeit bis zum nächsten Sonnenauf- oder -untergang auf dem Sperrbildschirm."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Növbəti gün çıxana və ya batana qədər qalan vaxt kilid ekranında görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر الوقت المتبقي حتى الشروق أو الغروب التالي على شاشة القفل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan sisa waktu hingga matahari terbit atau terbenam berikutnya di Layar Terkunci."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگلے طلوع یا غروب آفتاب تک باقی وقت لاک اسکرین پر دکھاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان باقی تا طلوع یا غروب بعدی خورشید روی صفحه قفل نمایش داده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le temps restant avant le prochain lever ou coucher du Soleil sur l'écran verrouillé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает время до ближайшего восхода или заката на экране блокировки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の日の出または日の入りまでの時間をロック画面に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 일출 또는 일몰까지 남은 시간을 잠금 화면에 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁屏上显示距下一次日出或日落的剩余时间。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita sa Lock Screen ang natitirang oras bago ang susunod na pagsikat o paglubog ng araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเวลาที่เหลือจนถึงพระอาทิตย์ขึ้นหรือตกครั้งถัดไปบนหน้าจอล็อก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra en la pantalla bloqueada el tiempo que falta para la próxima salida o puesta del sol."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra na tela bloqueada o tempo até o próximo nascer ou pôr do sol."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक स्क्रीन पर अगले सूर्योदय या सूर्यास्त तक बचा समय दिखाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরের সূর্যোদয় বা সূর্যাস্তের বাকি সময় লক স্ক্রিনে দেখায়।"
          }
        }
      }
    },
    "widget.sun.turnIn": {
