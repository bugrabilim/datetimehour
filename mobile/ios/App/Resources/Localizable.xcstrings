    "notify.sound.better": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha doğal bir ses için: Ayarlar → Erişilebilirlik → Seslendirilen İçerik → Sesler → Türkçe bölümünden \"Gelişmiş\" bir ses indirin (ör. Yelda). Uygulamayı yeniden açınca sesler yenilenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a more natural voice: Settings → Accessibility → Spoken Content → Voices → English, then download an \"Enhanced\" voice. The sounds are renewed the next time you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine natürlichere Stimme: Einstellungen → Bedienungshilfen → Gesprochene Inhalte → Stimmen → Deutsch und eine „Erweitert“-Stimme laden. Beim nächsten Öffnen der App werden die Töne erneuert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha təbii səs üçün: Parametrlər → Əlçatımlılıq → Səsləndirilən məzmun → Səslər → Türkcə bölməsindən \"Təkmil\" səs yükləyin. Tətbiqi yenidən açanda səslər yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لصوت أكثر طبيعية: الإعدادات ← تسهيلات الاستخدام ← المحتوى المنطوق ← الأصوات ← العربية، ثم نزّل صوتًا «محسّنًا». تتجدد الأصوات عند فتح التطبيق مرة أخرى."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk suara yang lebih alami: Pengaturan → Aksesibilitas → Konten Lisan → Suara → Bahasa Indonesia, lalu unduh suara \"Ditingkatkan\". Suara diperbarui saat aplikasi dibuka berikutnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ قدرتی آواز کے لیے: ترتیبات → رسائی → بولا گیا مواد → آوازیں → اردو، پھر «بہتر» آواز ڈاؤن لوڈ کریں۔ اگلی بار ایپ کھولنے پر آوازیں تازہ ہوں گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای صدای طبیعی‌تر: تنظیمات ← دسترس‌پذیری ← محتوای گفتاری ← صداها ← فارسی، سپس یک صدای «بهبودیافته» دانلود کنید. صداها با باز کردن بعدی برنامه تازه می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour une voix plus naturelle : Réglages → Accessibilité → Contenu énoncé → Voix → Français, puis téléchargez une voix « améliorée ». Les sons sont renouvelés à la prochaine ouverture de l’application."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для более естественного голоса: Настройки → Универсальный доступ → Устный контент → Голоса → Русский, затем загрузите «улучшенный» голос. Звуки обновятся при следующем открытии приложения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より自然な声にするには：設定 → アクセシビリティ → 読み上げコンテンツ → 声 → 日本語 で「拡張」音声をダウンロードしてください。次にアプリを開いたときに音声が更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 자연스러운 음성을 원하면: 설정 → 손쉬운 사용 → 콘텐츠 말하기 → 음성 → 한국어에서 \"향상된\" 음성을 내려받으세요. 다음에 앱을 열 때 소리가 갱신됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想要更自然的声音：设置 → 辅助功能 → 朗读内容 → 声音 → 中文，下载“增强”声音。下次打开应用时声音会更新。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa mas natural na boses: Settings → Accessibility → Spoken Content → Voices → Filipino, saka mag-download ng \"Enhanced\" na boses. Nire-renew ang mga tunog sa susunod na pagbukas mo ng app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับเสียงที่เป็นธรรมชาติขึ้น: การตั้งค่า → การช่วยการเข้าถึง → เนื้อหาที่พูด → เสียง → ไทย แล้วดาวน์โหลดเสียง \"ขั้นสูง\" เสียงจะต่ออายุเมื่อเปิดแอปครั้งถัดไป"
          }
        }
      }
    },
    "notify.sound.betterAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha doğal bir ses için: telefonun Ayarlar › Sistem › Diller › Metin okuma çıkışı (ya da Erişilebilirlik › Metin okuma) bölümünden Türkçe ses verisini indirin. Uygulamayı yeniden açınca sesler yenilenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a more natural voice: in your phone's Settings › System › Languages › Text-to-speech output (or Accessibility › Text-to-speech), download the English voice data. The sounds are renewed the next time you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine natürlichere Stimme: in den Einstellungen des Telefons unter System › Sprachen › Sprachausgabe (oder Bedienungshilfen › Sprachausgabe) die deutschen Sprachdaten laden. Beim nächsten Öffnen der App werden die Töne erneuert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha təbii səs üçün: telefonun Parametrlər › Sistem › Dillər › Mətnin səsləndirilməsi (və ya Əlçatımlılıq › Mətnin səsləndirilməsi) bölməsindən Türkcə səs məlumatını yükləyin. Tətbiqi yenidən açanda səslər yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لصوت أكثر طبيعية: من إعدادات الهاتف › النظام › اللغات › تحويل النص إلى كلام (أو تسهيلات الاستخدام › تحويل النص إلى كلام)، نزّل بيانات الصوت العربية. تتجدد الأصوات عند فتح التطبيق مرة أخرى."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk suara yang lebih alami: di Setelan ponsel › Sistem › Bahasa › Output text-to-speech (atau Aksesibilitas › Text-to-speech), unduh data suara bahasa Indonesia. Suara diperbarui saat aplikasi dibuka berikutnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ قدرتی آواز کے لیے: فون کی ترتیبات › سسٹم › زبانیں › ٹیکسٹ ٹو اسپیچ آؤٹ پٹ (یا رسائی › ٹیکسٹ ٹو اسپیچ) میں اردو آواز کا ڈیٹا ڈاؤن لوڈ کریں۔ اگلی بار ایپ کھولنے پر آوازیں تازہ ہوں گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای صدای طبیعی‌تر: در تنظیمات گوشی › سیستم › زبان‌ها › خروجی تبدیل متن به گفتار (یا دسترس‌پذیری › تبدیل متن به گفتار) دادهٔ صدای فارسی را دانلود کنید. صداها با باز کردن بعدی برنامه تازه می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour une voix plus naturelle : dans Paramètres › Système › Langues › Synthèse vocale (ou Accessibilité › Synthèse vocale) de votre téléphone, téléchargez les données vocales en français. Les sons sont renouvelés à la prochaine ouverture de l’application."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для более естественного голоса: в Настройках телефона › Система › Языки › Синтез речи (или Спец. возможности › Синтез речи) загрузите русские голосовые данные. Звуки обновятся при следующем открытии приложения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より自然な声にするには：スマホの設定 › システム › 言語 › テキスト読み上げの出力（またはユーザー補助 › テキスト読み上げ）で日本語の音声データをダウンロードしてください。次にアプリを開いたときに音声が更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 자연스러운 음성을 원하면: 휴대폰 설정 › 시스템 › 언어 › 텍스트 음성 변환 출력(또는 접근성 › 텍스트 음성 변환)에서 한국어 음성 데이터를 내려받으세요. 다음에 앱을 열 때 소리가 갱신됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想要更自然的声音：在手机的设置 › 系统 › 语言 › 文字转语音输出（或无障碍 › 文字转语音）中下载中文语音数据。下次打开应用时声音会更新。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa mas natural na boses: sa Settings › System › Languages › Text-to-speech output ng iyong telepono (o Accessibility › Text-to-speech), i-download ang voice data para sa Filipino. Nire-renew ang mga tunog sa susunod na pagbukas mo ng app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับเสียงที่เป็นธรรมชาติขึ้น: ในการตั้งค่า › ระบบ › ภาษา › เอาต์พุตการอ่านออกเสียง (หรือการช่วยเหลือพิเศษ › การอ่านออกเสียง) ของโทรศัพท์ ให้ดาวน์โหลดข้อมูลเสียงภาษาไทย เสียงจะต่ออายุเมื่อเปิดแอปครั้งถัดไป"
          }
        }
      }
    },
    "notify.exact": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimlerin tam vaktinde gelmesi için \"Alarmlar ve hatırlatıcılar\" iznini açın. İzin olmadan bildirim birkaç dakika gecikebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on \"Alarms & reminders\" so notifications arrive right on time. Without it they may be a few minutes late."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie „Wecker und Erinnerungen“, damit Mitteilungen pünktlich kommen. Ohne diese Erlaubnis können sie einige Minuten später eintreffen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirişlərin tam vaxtında gəlməsi üçün \"Zəngli saatlar və xatırlatmalar\" icazəsini açın. İcazə olmadan bildiriş bir neçə dəqiqə gecikə bilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل إذن «المنبّهات والتذكيرات» لتصل الإشعارات في وقتها تمامًا. بدونه قد تتأخر بضع دقائق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan \"Alarm & pengingat\" agar notifikasi datang tepat waktu. Tanpanya notifikasi bisa terlambat beberapa menit."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "«الارمز اور یاد دہانیاں» آن کریں تاکہ اطلاعات بالکل وقت پر آئیں۔ اس کے بغیر چند منٹ کی تاخیر ہو سکتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«هشدارها و یادآورها» را روشن کنید تا اعلان‌ها دقیقاً سر وقت برسند. بدون آن ممکن است چند دقیقه دیر برسند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez « Alarmes et rappels » pour que les notifications arrivent à l’heure exacte. Sans cela, elles peuvent avoir quelques minutes de retard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Будильники и напоминания», чтобы уведомления приходили точно вовремя. Без этого они могут опаздывать на несколько минут."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が時刻ちょうどに届くよう「アラームとリマインダー」をオンにしてください。オフだと数分遅れることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 정확한 시간에 오도록 \"알람 및 리마인더\"를 켜세요. 켜지 않으면 몇 분 늦을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开“闹钟和提醒”，让通知准时到达。否则可能会晚几分钟。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-on ang \"Alarms & reminders\" para dumating nang eksakto sa oras ang mga abiso. Kung hindi, maaaring mahuli ito nang ilang minuto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด \"การปลุกและการช่วยเตือน\" เพื่อให้การแจ้งเตือนมาตรงเวลา หากไม่เปิดอาจช้าไปไม่กี่นาที"
          }
        }
      }
    },
    "notify.exactAllow": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzni aç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
