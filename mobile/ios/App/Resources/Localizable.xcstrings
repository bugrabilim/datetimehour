    "widget.year.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yılın kaçıncı günündesiniz ve kaç gün kaldı; her gün bir nokta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which day of the year it is and how many are left; one dot per day."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher Tag des Jahres es ist und wie viele bleiben; ein Punkt pro Tag."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İlin neçənci günündəsiniz və neçə gün qalıb; hər gün bir nöqtə."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي يوم من السنة نحن فيه وكم بقي؛ نقطة لكل يوم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari keberapa dalam tahun ini dan berapa yang tersisa; satu titik per hari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سال کا کون سا دن ہے اور کتنے باقی ہیں؛ ہر دن ایک نقطہ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روز چندم سال است و چند روز مانده؛ هر روز یک نقطه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel jour de l'année nous sommes et combien il en reste ; un point par jour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой сейчас день года и сколько осталось; одна точка — один день."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日が1年の何日目か、残り何日か。1日1つの点。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올해 며칠째인지, 며칠 남았는지 하루 한 점으로 보여줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天是一年中的第几天、还剩几天；每天一个点。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ika-ilang araw na ng taon at ilan pa ang natitira; isang tuldok bawat araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้เป็นวันที่เท่าไรของปีและเหลืออีกกี่วัน หนึ่งจุดต่อวัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué día del año es y cuántos quedan; un punto por día."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que dia do ano é e quantos faltam; um ponto por dia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साल का कौन-सा दिन है और कितने बचे; हर दिन का एक बिंदु।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বছরের কততম দিন এবং কত দিন বাকি; প্রতিদিনের জন্য একটি বিন্দু।"
          }
        }
      }
    },
