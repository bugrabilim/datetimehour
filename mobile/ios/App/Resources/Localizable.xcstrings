        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta listesi üyelikten ayrıdır; listeye ayrıca katılırsınız ve ayrıca ayrılırsınız."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The email list is separate from membership; you join and leave it separately."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die E-Mail-Liste ist von der Mitgliedschaft getrennt; Sie treten ihr gesondert bei und verlassen sie gesondert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poçt siyahısı üzvlükdən ayrıdır; siyahıya ayrıca qoşulur və ayrıca çıxırsınız."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القائمة البريدية منفصلة عن العضوية؛ تنضم إليها وتغادرها بشكل منفصل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Milis email terpisah dari keanggotaan; Anda bergabung dan keluar secara terpisah."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ای میل فہرست رکنیت سے الگ ہے؛ اس میں الگ سے شامل ہوتے اور الگ سے نکلتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرست ایمیل از عضویت جداست؛ جداگانه به آن می‌پیوندید و جداگانه از آن بیرون می‌آیید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste de diffusion est distincte de l'adhésion ; vous la rejoignez et la quittez séparément."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рассылка не связана с членством; на неё подписываются и от неё отписываются отдельно."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールリストは会員登録とは別です。登録も解除も別々に行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 목록은 회원 가입과 별개입니다. 구독과 해지를 따로 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件列表与会员身份分开；需单独订阅和退订。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiwalay sa membership ang email list; hiwalay kayong sumasali at umaalis dito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายชื่ออีเมลแยกจากการเป็นสมาชิก สมัครและยกเลิกแยกกัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de correo es independiente de la membresía; se une y se da de baja por separado."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de e-mails é separada da associação; você entra e sai dela separadamente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ईमेल सूची सदस्यता से अलग है; इसमें अलग से जुड़ते और अलग से निकलते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইমেইল তালিকা সদস্যপদ থেকে আলাদা; এতে আলাদাভাবে যুক্ত হন ও আলাদাভাবে বেরিয়ে যান।"
          }
        }
      }
    },
