    "alarm.code.missing": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kod kaydedilmedi; kaydetmezseniz matematik görevi kullanılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No code saved yet; without one, the maths task is used."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Code gespeichert; ohne Code wird die Rechenaufgabe verwendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ kod yadda saxlanılmayıb; saxlanılmasa riyaziyyat tapşırığı istifadə olunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحفظ رمز بعد؛ دونه تُستخدم المسائل الحسابية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada kode tersimpan; tanpa kode, tugas matematika dipakai."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی کوڈ محفوظ نہیں؛ اس کے بغیر ریاضی کا کام استعمال ہوتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز کدی ذخیره نشده؛ بدون آن کار ریاضی به کار می‌رود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun code enregistré ; à défaut, la tâche de calcul est utilisée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код ещё не сохранён; без него используется математика."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードがまだ保存されていません。保存しない場合は計算の課題を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 저장한 코드가 없습니다. 없으면 수학 미션을 씁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有保存码；没有码时使用算术任务。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang naka-save na code; kung wala, math ang gagamitin."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้บันทึกโค้ด หากไม่มีจะใช้ภารกิจคณิตศาสตร์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay código guardado; sin él se usa la tarea de matemáticas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há código salvo; sem ele, é usada a tarefa de matemática."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई कोड सहेजा नहीं; उसके बिना गणित वाला कार्य इस्तेमाल होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো কোড সংরক্ষিত নেই; না থাকলে গণিতের কাজ ব্যবহৃত হয়।"
          }
        }
      }
    },
    "alarm.code.hint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yataktan kalkınca ulaşabileceğiniz bir kod seçin: banyodaki bir ürünün barkodu ya da kapıya astığınız bir QR kod gibi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a code you can only reach once you're up: a barcode on something in the bathroom, or a QR code stuck on a door."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Code, den Sie erst nach dem Aufstehen erreichen: etwa einen Barcode im Bad oder einen QR-Code an einer Tür."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yataqdan qalxanda çata biləcəyiniz kod seçin: hamamdakı bir məhsulun barkodu ya da qapıya yapışdırdığınız QR kod kimi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر رمزًا لا تصل إليه إلا بعد النهوض: كباركود منتج في الحمّام أو رمز QR ملصق على باب."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kode yang hanya bisa dijangkau setelah Anda bangun: barcode pada barang di kamar mandi, atau kode QR yang ditempel di pintu."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایسا کوڈ چنیں جس تک صرف اٹھ کر پہنچ سکیں: غسل خانے میں کسی چیز کا بارکوڈ، یا دروازے پر چپکا QR کوڈ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کدی برگزینید که فقط پس از بیدار شدن به آن برسید: بارکد چیزی در حمام یا کد QR چسبیده روی در."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un code que vous ne pouvez atteindre qu’une fois levé : un code-barres sur un objet de la salle de bains ou un QR code collé sur une porte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите код, до которого можно дойти, только встав: штрихкод на чём-то в ванной или QR-код на двери."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起き上がらないと届かないコードを選びましょう。洗面所にある物のバーコードや、ドアに貼ったQRコードなど。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어나야만 닿는 코드를 고르세요. 예를 들어 욕실에 있는 물건의 바코드나 문에 붙인 QR 코드가 좋습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一个只有起床后才能够到的码：浴室里某件物品上的条形码，或贴在门上的二维码。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng code na maaabot mo lang kapag bumangon ka: barcode sa isang bagay sa banyo, o QR code na nakadikit sa pinto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโค้ดที่ต้องลุกจากเตียงจึงจะไปถึง เช่น บาร์โค้ดบนของในห้องน้ำ หรือ QR โค้ดที่ติดไว้ที่ประตู"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un código al que solo llegue ya levantado: un código de barras de algo del baño o un código QR pegado en una puerta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um código que você só alcance depois de levantar: um código de barras de algo no banheiro ou um QR colado numa porta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसा कोड चुनें जिस तक आप उठकर ही पहुँच सकें: बाथरूम की किसी चीज़ का बारकोड या दरवाज़े पर चिपका QR कोड।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এমন একটি কোড বেছে নিন যা শুধু উঠে গেলেই নাগালে পাওয়া যায়: বাথরুমের কোনো জিনিসের বারকোড বা দরজায় লাগানো QR কোড।"
          }
        }
      }
    },
