        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این رمضان به دلتان آرامش ببخشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que ce Ramadan apaise votre cœur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть этот Рамадан успокоит ваше сердце."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このラマダンが心に静けさをもたらしますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 라마단이 마음에 고요함을 주길 바랍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "愿这个斋月让您的心平静。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawa'y magdala ang Ramadan na ito ng katahimikan sa inyong puso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้รอมฎอนนี้นำความสงบมาสู่ใจคุณ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que este Ramadán dé calma a su corazón."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que este Ramadã traga calma ao seu coração."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रमज़ान आपके दिल को सुकून दे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রমজান আপনার হৃদয়ে প্রশান্তি আনুক।"
          }
        }
      }
    },
    "greet.m.ramadan.5": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İftar sofralarınız bereketli, sahurlarınız huzurlu olsun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your iftars be abundant and your suhoors peaceful."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mögen Ihre Iftar-Tische reich gedeckt und Ihr Sahur friedlich sein."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İftar süfrəniz bərəkətli, sahurunuz rahat olsun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جعل الله إفطاركم عامرًا وسحوركم هانئًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga buka puasa Anda berlimpah dan sahur Anda tenang."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی افطاری بابرکت اور سحری پرسکون ہو۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "افطارتان پربرکت و سحرتان آرام باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que vos iftars soient généreux et vos sohours paisibles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть ваши ифтары будут щедрыми, а сухуры спокойными."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イフタールは豊かに、スフールは穏やかでありますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이프타르는 풍성하고 수후르는 평안하길 바랍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "愿您的开斋饭丰盛，封斋饭安宁。"
