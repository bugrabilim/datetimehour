    "widget.moon.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay'ın bugünkü evresi, aydınlık yüzdesi ve sıradaki dolunay ya da yeni ay."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's Moon phase, illumination and the next full or new moon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heutige Mondphase, Beleuchtung und der nächste Voll- oder Neumond."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayın bu günkü fazası, işıqlı hissəsi və növbəti bədirlənmə ya da təzə ay."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طور القمر اليوم ونسبة الإضاءة والبدر أو المحاق التالي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase Bulan hari ini, persentase terang, dan bulan purnama atau bulan baru berikutnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج چاند کا مرحلہ، روشنی کا تناسب اور اگلا پورا یا نیا چاند۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اهلّهٔ امروز ماه، درصد روشنایی و ماه کامل یا ماه نو بعدی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phase de la Lune du jour, son éclairement et la prochaine pleine ou nouvelle lune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодняшняя фаза Луны, освещённость и ближайшее полнолуние или новолуние."
          }
        }
      }
    },
