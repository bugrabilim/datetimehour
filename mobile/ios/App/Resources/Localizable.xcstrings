        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的财产达到满贯标准，应缴天课。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Abot ng iyong yaman ang nisab; may zakat kang dapat ibigay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทรัพย์สินของคุณถึงนิศอบแล้ว ต้องจ่ายซะกาต"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su patrimonio alcanza el nisab; debe pagar zakat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu patrimônio atinge o nisab; o zakat é devido."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी संपत्ति निसाब तक पहुँचती है; ज़कात देनी है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সম্পদ নিসাব পূর্ণ করে; জাকাত ফরজ।"
          }
        }
      }
    },
    "zakat.notDue": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlığınız nisabın altında; zekât düşmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your wealth is below the nisab; no zakat is due."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Vermögen liegt unter dem Nisab; keine Zakat fällig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlığınız nisabdan aşağıdır; zəkat düşmür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مالك دون النصاب؛ لا تجب الزكاة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harta Anda di bawah nisab; tidak wajib zakat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مال نصاب سے کم ہے؛ زکوٰۃ واجب نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دارایی شما کمتر از نصاب است؛ زکات واجب نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos biens sont sous le nisab ; aucune zakat n’est due."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше имущество ниже нисаба; закят не обязателен."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資産がニサーブに達していません。ザカートの義務はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자산이 니삽에 못 미칩니다. 자카트 의무가 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的财产未达满贯标准，无须缴纳天课。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulang sa nisab ang iyong yaman; walang zakat na dapat ibigay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทรัพย์สินของคุณยังไม่ถึงนิศอบ ไม่ต้องจ่ายซะกาต"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su patrimonio no llega al nisab; no debe zakat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu patrimônio está abaixo do nisab; não há zakat a pagar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी संपत्ति निसाब से कम है; ज़कात नहीं बनती।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সম্পদ নিসাবের কম; জাকাত ফরজ নয়।"
          }
        }
      }
    },
