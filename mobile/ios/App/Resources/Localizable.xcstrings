    "look.secondsNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tık sesi yalnız saat ekranı açıkken duyulur; telefon sessizdeyken çalmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ticking is heard only while the clock screen is open, and not when the phone is on silent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ticken ist nur bei geöffneter Uhr zu hören, nicht im Stummmodus."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tıqqıltı yalnız saat ekranı açıq olanda eşidilir; telefon səssiz rejimdə olanda çalmır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُسمع التكّة فقط وشاشة الساعة مفتوحة، ولا تُسمع والهاتف صامت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak hanya terdengar saat layar jam terbuka, dan tidak saat ponsel dalam mode senyap."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹک ٹک صرف گھڑی کی اسکرین کھلی ہونے پر سنائی دیتی ہے، فون خاموش ہو تو نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدای تیک فقط وقتی صفحه ساعت باز است شنیده می‌شود و در حالت بی‌صدا پخش نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tic-tac ne s’entend que lorsque l’horloge est ouverte, et pas en mode silencieux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тиканье слышно только при открытом экране часов и не звучит в беззвучном режиме."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秒の音は時計画面を開いている間だけ鳴り、マナーモードでは鳴りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초침 소리는 시계 화면이 열려 있을 때만 들리며 무음 모드에서는 나지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滴答声只在时钟界面打开时播放，静音模式下不响。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maririnig lang ang tik-tak habang bukas ang orasan, at hindi kapag naka-silent ang telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงติ๊กต็อกจะดังเฉพาะตอนเปิดหน้านาฬิกา และไม่ดังเมื่อโทรศัพท์อยู่ในโหมดเงียบ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tictac solo se oye con la pantalla del reloj abierta, y no con el teléfono en silencio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tique-taque só é ouvido com a tela do relógio aberta, e não com o celular no silencioso."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टिक-टिक केवल घड़ी स्क्रीन खुली रहने पर सुनाई देती है, और फ़ोन साइलेंट हो तो नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিক টিক শব্দ শুধু ঘড়ির পর্দা খোলা থাকলে শোনা যায়, ফোন নীরব থাকলে নয়।"
          }
        }
      }
    },
    "look.banner": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni tabela gibi büyük göster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the text as a big banner"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text groß wie ein Banner zeigen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mətni lövhə kimi böyük göstər"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض النص كبيرًا كلافتة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan teks besar seperti spanduk"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "متن کو بینر کی طرح بڑا دکھائیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متن را مثل تابلو بزرگ نشان بده"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le texte en grand, comme une banderole"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать текст крупно, как табло"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを横断幕のように大きく表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자를 현수막처럼 크게 표시"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文字像横幅一样放大显示"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipakita ang teksto nang malaki na parang banner"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงข้อความขนาดใหญ่แบบป้าย"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar el texto como pancarta grande"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar o texto como faixa grande"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट बड़े बैनर के रूप में दिखाएँ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেখাটি বড় ব্যানার হিসেবে দেখান"
          }
        }
      }
    },
    "look.bannerNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekranda metin ekranın üst yarısını doldurur, saat altında küçülür (ör. İYİ Kİ DOĞDUN)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In full screen the text fills the top half and the clock gets smaller below it (e.g. HAPPY BIRTHDAY)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Vollbild füllt der Text die obere Hälfte, die Uhr wird darunter kleiner (z. B. ALLES GUTE)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekranda mətn ekranın yuxarı yarısını doldurur, saat aşağıda kiçilir (məs. AD GÜNÜN MÜBARƏK)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في ملء الشاشة يملأ النص النصف العلوي وتصغر الساعة تحته (مثل: عيد ميلاد سعيد)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam layar penuh, teks memenuhi separuh atas layar dan jam mengecil di bawahnya (mis. SELAMAT ULANG TAHUN)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فل اسکرین میں متن اوپر کا آدھا حصہ بھر دیتا ہے اور گھڑی نیچے چھوٹی ہو جاتی ہے (جیسے سالگرہ مبارک)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تمام‌صفحه متن نیمه بالا را پر می‌کند و ساعت زیر آن کوچک می‌شود (مثلاً تولدت مبارک)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En plein écran, le texte remplit la moitié haute et l’horloge rétrécit dessous (ex. JOYEUX ANNIVERSAIRE)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В полноэкранном режиме текст занимает верхнюю половину, часы уменьшаются под ним (например, С ДНЁМ РОЖДЕНИЯ)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全画面では文字が上半分を埋め、時計はその下に小さく表示されます（例：お誕生日おめでとう）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면에서 글자가 위쪽 절반을 채우고 시계는 아래에 작게 표시됩니다(예: 생일 축하해)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏时文字占满上半屏，时钟在下方缩小（例如：生日快乐）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa full screen, pinupuno ng teksto ang itaas na kalahati at lumiliit ang orasan sa ibaba (hal. MALIGAYANG KAARAWAN)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในโหมดเต็มจอ ข้อความจะเต็มครึ่งบนและนาฬิกาจะเล็กลงด้านล่าง (เช่น สุขสันต์วันเกิด)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A pantalla completa, el texto ocupa la mitad superior y el reloj se hace más pequeño debajo (p. ej., FELIZ CUMPLEAÑOS)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em tela cheia, o texto ocupa a metade de cima e o relógio fica menor embaixo (ex.: FELIZ ANIVERSÁRIO)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ुल स्क्रीन में टेक्स्ट ऊपर का आधा हिस्सा भरता है और घड़ी नीचे छोटी हो जाती है (जैसे, जन्मदिन मुबारक)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্ণ পর্দায় লেখাটি ওপরের অর্ধেক জুড়ে থাকে এবং ঘড়ি নিচে ছোট হয়ে যায় (যেমন শুভ জন্মদিন)।"
          }
        }
      }
    },
