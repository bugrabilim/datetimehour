    "prayer.kerahatNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürelerde nafile namaz kılınmaz. Diyanet'in yayımladığı bir dakika ölçüsü yok; takvimlerde yaygın olan yaklaşık 45 dakika kullanıldı (öğle öncesi kerahat süresi kaynaklarda 10–45 dakika arasında değişir)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voluntary prayers are not performed in these windows. The Diyanet publishes no exact minutes; the common calendar convention of about 45 minutes is used (sources give 10–45 minutes for the window before noon)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesen Zeiten werden keine freiwilligen Gebete verrichtet. Der Diyanet nennt keine genauen Minuten; verwendet wird der in Kalendern übliche Wert von etwa 45 Minuten (für die Zeit vor Mittag nennen Quellen 10–45 Minuten)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu vaxtlarda nafilə namaz qılınmır. Diyanətin açıqladığı dəqiq dəqiqə ölçüsü yoxdur; təqvimlərdə geniş yayılmış təxminən 45 dəqiqə istifadə olunub (günorta öncəsi üçün mənbələr 10–45 dəqiqə göstərir)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُصلّى النوافل في هذه الأوقات. لا تنشر رئاسة الشؤون الدينية مدة محددة بالدقائق؛ استُخدمت المدة الشائعة في التقاويم وهي نحو 45 دقيقة (تذكر المصادر 10–45 دقيقة لما قبل الظهر)."
          }
        }
      }
    },
