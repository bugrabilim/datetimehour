    "onboard.welcome.hint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş kısa soruyla uygulamayı size göre hazırlayalım."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five short questions and the app is set up just for you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf kurze Fragen, und die App ist für Sie eingerichtet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş qısa sualla tətbiqi sizə uyğun hazırlayaq."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خمسة أسئلة قصيرة ونجهّز التطبيق لك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lima pertanyaan singkat, lalu aplikasi siap untuk Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پانچ مختصر سوالوں سے ایپ آپ کے مطابق تیار کرتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با پنج پرسش کوتاه، برنامه را برای شما آماده می‌کنیم."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq petites questions et l'appli est prête pour vous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять коротких вопросов — и приложение настроено под вас."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5つの短い質問で、アプリをあなた向けに整えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 질문 다섯 개로 앱을 맞춤 설정해 드려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答五个小问题，应用即按您的需要准备好。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Limang maikling tanong at handa na ang app para sa iyo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอบคำถามสั้น ๆ 5 ข้อ แล้วแอปจะพร้อมสำหรับคุณ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco preguntas breves y la app queda lista para usted."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco perguntas rápidas e o app fica pronto para você."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाँच छोटे सवाल, और ऐप आपके हिसाब से तैयार।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাঁচটি ছোট প্রশ্নে অ্যাপটি শুধু আপনার জন্য সাজানো হবে।"
          }
        }
      }
    },
