    "list.ok": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay e-postası gönderdik; gelen kutunuzdaki bağlantıya tıklayınca listeye katılmış olursunuz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We have sent you a confirmation email; click the link in your inbox to complete joining the list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben Ihnen eine Bestätigungs-E-Mail gesendet; klicken Sie auf den Link darin, um die Anmeldung abzuschließen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizə təsdiq e-məktubu göndərdik; siyahıya qoşulmağı tamamlamaq üçün poçt qutunuzdakı keçidə klikləyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلنا إليك رسالة تأكيد؛ انقر الرابط في بريدك الوارد لإتمام الاشتراك في القائمة."
          }
        }
      }
    },
    "list.err": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydınız alınamadı. E-posta adresini ve onay kutusunu kontrol edip biraz sonra tekrar deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't save your sign-up. Please check the email address and the checkbox, then try again in a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Anmeldung konnte nicht gespeichert werden. Bitte prüfen Sie die E-Mail-Adresse und das Kontrollkästchen und versuchen Sie es gleich noch einmal."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeydiyyatınızı saxlaya bilmədik. E-poçt ünvanını və qeyd xanasını yoxlayın, sonra bir az sonra yenidən cəhd edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ اشتراكك. يُرجى التحقق من عنوان البريد الإلكتروني ومربع الاختيار، ثم المحاولة مرة أخرى بعد قليل."
          }
        }
      }
    },
