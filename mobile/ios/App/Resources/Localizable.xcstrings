    "geo.denied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum izni olmadan hatırlatıcılar çalışmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders do not work without location access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Standortzugriff funktionieren die Erinnerungen nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məkan icazəsi olmadan xatırladıcılar işləmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تعمل التذكيرات دون إذن الوصول إلى الموقع."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat tidak berfungsi tanpa akses lokasi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام تک رسائی کے بغیر یاد دہانیاں کام نہیں کرتیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادآورها بدون دسترسی به موقعیت کار نمی‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels ne fonctionnent pas sans accès à la position."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без доступа к геопозиции напоминания не работают."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報へのアクセスがないとリマインダーは動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 접근이 없으면 미리 알림이 작동하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有位置访问权限，提醒无法工作。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi gumagana ang mga paalala kung walang access sa lokasyon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเตือนใช้ไม่ได้หากไม่มีการเข้าถึงตำแหน่ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios no funcionan sin acceso a la ubicación."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes não funcionam sem acesso à localização."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान की पहुँच के बिना रिमाइंडर काम नहीं करते।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থানের অনুমতি ছাড়া রিমাইন্ডার কাজ করে না।"
          }
        }
      }
    },
    "geo.notPrecise": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Kesin Konum\" kapalı: iPhone bölge hatırlatıcılarını yalnız kesin konumla çalıştırır (Ayarlar › Saat Tarih › Konum)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Precise Location\" is off: iPhone runs place reminders only with precise location (Settings › Time & Date › Location)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Genauer Standort“ ist aus: Das iPhone führt Ortserinnerungen nur mit genauem Standort aus (Einstellungen › Uhr & Datum › Standort)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Dəqiq məkan\" bağlıdır: iPhone yer xatırladıcılarını yalnız dəqiq məkanla işlədir (Parametrlər › Saat Tarix › Məkan)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"الموقع الدقيق\" متوقف: لا يشغّل iPhone تذكيرات المكان إلا بالموقع الدقيق (الإعدادات › الوقت والتاريخ › الموقع)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Lokasi Tepat\" nonaktif: iPhone hanya menjalankan pengingat tempat dengan lokasi tepat (Pengaturan › Jam & Tanggal › Lokasi)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "«درست مقام» بند ہے: آئی فون مقام کی یاد دہانیاں صرف درست مقام کے ساتھ چلاتا ہے (ترتیبات › وقت اور تاریخ › مقام)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«موقعیت دقیق» خاموش است: آیفون یادآورهای مکانی را فقط با موقعیت دقیق اجرا می‌کند (تنظیمات › ساعت و تاریخ › موقعیت)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Position exacte » est désactivée : l’iPhone n’exécute les rappels de lieu qu’avec la position exacte (Réglages › Heure & Date › Position)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Точная геопозиция» выключена: iPhone выполняет напоминания по месту только с точной геопозицией (Настройки › Время и дата › Геопозиция)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「正確な位置情報」がオフです。iPhoneは正確な位置情報があるときだけ場所のリマインダーを動かします（設定 › 時刻と日付 › 位置情報）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"정확한 위치\"가 꺼져 있습니다. iPhone은 정확한 위치일 때만 장소 미리 알림을 실행합니다(설정 › 시간과 날짜 › 위치)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“精确位置”已关闭：iPhone仅在开启精确位置时才能运行位置提醒（设置 › 时间与日期 › 位置）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang \"Precise Location\": gumagana lang sa iPhone ang mga paalala ayon sa lokasyon kapag precise ang lokasyon (Settings › Oras at Petsa › Location)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ตำแหน่งที่แม่นยำ\" ปิดอยู่: iPhone เรียกใช้การเตือนตามสถานที่เฉพาะเมื่อใช้ตำแหน่งที่แม่นยำ (การตั้งค่า › เวลาและวันที่ › ตำแหน่ง)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Ubicación exacta\" está desactivada: el iPhone solo ejecuta recordatorios por ubicación con la ubicación exacta (Ajustes › Hora y Fecha › Ubicación)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Localização Exata\" está desativada: o iPhone só executa lembretes por local com a localização exata (Ajustes › Hora e Data › Localização)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"सटीक स्थान\" बंद है: iPhone स्थान रिमाइंडर केवल सटीक स्थान के साथ चलाता है (सेटिंग्स › समय और तारीख › स्थान)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "\"সঠিক অবস্থান\" বন্ধ: iPhone জায়গাভিত্তিক রিমাইন্ডার শুধু সঠিক অবস্থান দিয়ে চালায় (সেটিংস › সময় ও তারিখ › অবস্থান)।"
          }
        }
      }
    },
    "geo.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varış ve ayrılışı iPhone kendisi izler; uygulama arka planda çalışmaz, konumunuz hiçbir yere gönderilmez. En çok 20 hatırlatıcı. Bildirim telefonun ses ayarına uyar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone itself watches for arrivals and departures; the app does not run in the background and your location is not sent anywhere. Up to 20 reminders. The alert follows the phone's sound settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone selbst erkennt Ankunft und Verlassen; die App läuft nicht im Hintergrund und Ihr Standort wird nirgendwohin gesendet. Höchstens 20 Erinnerungen. Die Mitteilung folgt den Toneinstellungen des Telefons."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çatma və ayrılmanı iPhone özü izləyir; tətbiq arxa planda işləmir, məkanınız heç yerə göndərilmir. Ən çox 20 xatırladıcı. Bildiriş telefonun səs ayarına uyğundur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يراقب iPhone نفسه الوصول والمغادرة؛ لا يعمل التطبيق في الخلفية ولا يُرسل موقعك إلى أي مكان. 20 تذكيرًا على الأكثر. يتبع التنبيه إعدادات صوت الهاتف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone sendiri yang memantau kedatangan dan kepergian; aplikasi tidak berjalan di latar belakang dan lokasi Anda tidak dikirim ke mana pun. Hingga 20 pengingat. Peringatan mengikuti pengaturan suara ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئی فون خود پہنچنے اور نکلنے پر نظر رکھتا ہے؛ ایپ پس منظر میں نہیں چلتی اور آپ کا مقام کہیں نہیں بھیجا جاتا۔ زیادہ سے زیادہ 20 یاد دہانیاں۔ انتباہ فون کی آواز کی ترتیبات کے مطابق ہوتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خود آیفون رسیدن‌ها و رفتن‌ها را می‌پاید؛ برنامه در پس‌زمینه کار نمی‌کند و موقعیت شما به جایی فرستاده نمی‌شود. حداکثر 20 یادآور. هشدار از تنظیمات صدای گوشی پیروی می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone surveille lui-même les arrivées et les départs ; l’app ne tourne pas en arrière-plan et votre position n’est envoyée nulle part. Jusqu’à 20 rappels. L’alerte suit les réglages sonores du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone сам отслеживает прибытие и уход; приложение не работает в фоне, и ваше местоположение никуда не отправляется. До 20 напоминаний. Сигнал зависит от настроек звука телефона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到着と出発はiPhone自体が見守ります。アプリはバックグラウンドで動かず、位置情報はどこにも送られません。リマインダーは最大20件。通知はスマホのサウンド設定に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착과 출발은 iPhone이 직접 지켜봅니다. 앱은 백그라운드에서 돌지 않으며 위치는 어디에도 보내지 않습니다. 미리 알림은 최대 20개입니다. 알림은 휴대폰의 소리 설정을 따릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达和离开由iPhone本身监测；应用不在后台运行，您的位置不会发送到任何地方。最多20个提醒。提醒遵循手机的声音设置。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang iPhone mismo ang nagbabantay sa pagdating at pag-alis; hindi tumatakbo sa background ang app at hindi ipinapadala kahit saan ang iyong lokasyon. Hanggang 20 paalala. Sumusunod ang abiso sa sound settings ng telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone เป็นผู้เฝ้าดูการมาถึงและการออกไปเอง แอปไม่ทำงานในเบื้องหลังและตำแหน่งของคุณไม่ถูกส่งไปที่ใด การเตือนสูงสุด 20 รายการ การแจ้งเตือนเป็นไปตามการตั้งค่าเสียงของโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El propio iPhone vigila las llegadas y salidas; la app no funciona en segundo plano y su ubicación no se envía a ninguna parte. Hasta 20 recordatorios. El aviso sigue los ajustes de sonido del teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O próprio iPhone acompanha chegadas e saídas; o app não roda em segundo plano e sua localização não é enviada a lugar nenhum. Até 20 lembretes. O aviso segue as configurações de som do celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहुँचना और निकलना iPhone ख़ुद देखता है; ऐप बैकग्राउंड में नहीं चलता और आपका स्थान कहीं नहीं भेजा जाता। 20 तक रिमाइंडर। सूचना फ़ोन की आवाज़ सेटिंग के अनुसार आती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone নিজেই পৌঁছানো ও ছেড়ে যাওয়া লক্ষ রাখে; অ্যাপ পটভূমিতে চলে না এবং আপনার অবস্থান কোথাও পাঠানো হয় না। সর্বোচ্চ 20টি রিমাইন্ডার। সতর্কবার্তা ফোনের শব্দ সেটিংস মেনে চলে।"
          }
        }
      }
    },
    "geo.noteAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varış ve ayrılışı Android'in bölge izleme hizmeti izler; uygulama arka planda çalışmaz, konumunuz hiçbir yere gönderilmez. Bunun için \"Her zaman izin ver\" konum izni gerekir. En çok 20 hatırlatıcı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android's geofencing service watches for arrivals and departures; the app does not run in the background and your location is not sent anywhere. This needs the \"Allow all the time\" location permission. Up to 20 reminders."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Geofencing-Dienst von Android erkennt Ankunft und Verlassen; die App läuft nicht im Hintergrund und Ihr Standort wird nirgendwohin gesendet. Dafür ist die Standortberechtigung „Immer zulassen“ nötig. Höchstens 20 Erinnerungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çatma və ayrılmanı Android-in sahə izləmə xidməti izləyir; tətbiq arxa planda işləmir, məkanınız heç yerə göndərilmir. Bunun üçün \"Həmişə icazə ver\" məkan icazəsi lazımdır. Ən çox 20 xatırladıcı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراقب خدمة السياج الجغرافي في Android الوصول والمغادرة؛ لا يعمل التطبيق في الخلفية ولا يُرسل موقعك إلى أي مكان. يتطلب ذلك إذن الموقع \"السماح طوال الوقت\". 20 تذكيرًا على الأكثر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan geofencing Android memantau kedatangan dan kepergian; aplikasi tidak berjalan di latar belakang dan lokasi Anda tidak dikirim ke mana pun. Memerlukan izin lokasi \"Izinkan sepanjang waktu\". Hingga 20 pengingat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اینڈرائیڈ کی جیوفینسنگ سروس پہنچنے اور نکلنے پر نظر رکھتی ہے؛ ایپ پس منظر میں نہیں چلتی اور آپ کا مقام کہیں نہیں بھیجا جاتا۔ اس کے لیے «ہر وقت اجازت دیں» مقام کی اجازت چاہیے۔ زیادہ سے زیادہ 20 یاد دہانیاں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس حصار جغرافیایی اندروید رسیدن‌ها و رفتن‌ها را می‌پاید؛ برنامه در پس‌زمینه کار نمی‌کند و موقعیت شما به جایی فرستاده نمی‌شود. این به اجازهٔ موقعیت «همیشه مجاز» نیاز دارد. حداکثر 20 یادآور."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de géorepérage d’Android surveille les arrivées et les départs ; l’app ne tourne pas en arrière-plan et votre position n’est envoyée nulle part. Cela nécessite l’autorisation de position « Toujours autoriser ». Jusqu’à 20 rappels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба геозон Android отслеживает прибытие и уход; приложение не работает в фоне, и ваше местоположение никуда не отправляется. Нужно разрешение на геопозицию «Разрешить в любом режиме». До 20 напоминаний."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到着と出発はAndroidのジオフェンスサービスが見守ります。アプリはバックグラウンドで動かず、位置情報はどこにも送られません。位置情報の「常に許可」が必要です。リマインダーは最大20件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착과 출발은 Android의 지오펜싱 서비스가 지켜봅니다. 앱은 백그라운드에서 돌지 않으며 위치는 어디에도 보내지 않습니다. 위치 권한 \"항상 허용\"이 필요합니다. 미리 알림은 최대 20개입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达和离开由Android的地理围栏服务监测；应用不在后台运行，您的位置不会发送到任何地方。需要“始终允许”位置权限。最多20个提醒。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang geofencing service ng Android ang nagbabantay sa pagdating at pag-alis; hindi tumatakbo sa background ang app at hindi ipinapadala kahit saan ang iyong lokasyon. Kailangan nito ang pahintulot sa lokasyon na \"Allow all the time\". Hanggang 20 paalala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการจีโอเฟนซ์ของ Android เป็นผู้เฝ้าดูการมาถึงและการออกไป แอปไม่ทำงานในเบื้องหลังและตำแหน่งของคุณไม่ถูกส่งไปที่ใด ต้องใช้สิทธิ์ตำแหน่ง \"อนุญาตตลอดเวลา\" การเตือนสูงสุด 20 รายการ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de geovallas de Android vigila las llegadas y salidas; la app no funciona en segundo plano y su ubicación no se envía a ninguna parte. Necesita el permiso de ubicación \"Permitir todo el tiempo\". Hasta 20 recordatorios."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de geofencing do Android acompanha chegadas e saídas; o app não roda em segundo plano e sua localização não é enviada a lugar nenhum. É preciso a permissão de localização \"Permitir o tempo todo\". Até 20 lembretes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहुँचना और निकलना Android की जियोफ़ेंसिंग सेवा देखती है; ऐप बैकग्राउंड में नहीं चलता और आपका स्थान कहीं नहीं भेजा जाता। इसके लिए \"हर समय अनुमति दें\" वाली स्थान अनुमति चाहिए। 20 तक रिमाइंडर।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Android-এর জিওফেন্সিং পরিষেবা পৌঁছানো ও ছেড়ে যাওয়া লক্ষ রাখে; অ্যাপ পটভূমিতে চলে না এবং আপনার অবস্থান কোথাও পাঠানো হয় না। এর জন্য \"সবসময় অনুমতি দিন\" অবস্থান অনুমতি লাগে। সর্বোচ্চ 20টি রিমাইন্ডার।"
          }
        }
      }
    },
    "geo.backgroundAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcıların uygulama kapalıyken çalışması için konum izninde \"Her zaman izin ver\" seçilmeli."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For reminders to work while the app is closed, choose \"Allow all the time\" in the location permission."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit Erinnerungen bei geschlossener App funktionieren, wählen Sie in der Standortberechtigung „Immer zulassen“."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xatırladıcıların tətbiq bağlı ikən işləməsi üçün məkan icazəsində \"Həmişə icazə ver\" seçilməlidir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكي تعمل التذكيرات والتطبيق مغلق، اختر \"السماح طوال الوقت\" في إذن الموقع."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar pengingat berfungsi saat aplikasi ditutup, pilih \"Izinkan sepanjang waktu\" pada izin lokasi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ بند ہونے پر بھی یاد دہانیاں چلانے کے لیے مقام کی اجازت میں «ہر وقت اجازت دیں» منتخب کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای کار کردن یادآورها وقتی برنامه بسته است، در اجازهٔ موقعیت «همیشه مجاز» را برگزینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que les rappels fonctionnent lorsque l’app est fermée, choisissez « Toujours autoriser » dans l’autorisation de position."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы напоминания работали при закрытом приложении, выберите «Разрешить в любом режиме» в разрешении на геопозицию."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを閉じていてもリマインダーが動くよう、位置情報の権限で「常に許可」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 닫혀 있어도 미리 알림이 작동하도록 위치 권한에서 \"항상 허용\"을 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了让应用关闭时提醒仍能工作，请在位置权限中选择“始终允许”。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gumana ang mga paalala habang sarado ang app, piliin ang \"Allow all the time\" sa pahintulot sa lokasyon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้การเตือนทำงานขณะปิดแอป ให้เลือก \"อนุญาตตลอดเวลา\" ในสิทธิ์ตำแหน่ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que los recordatorios funcionen con la app cerrada, elija \"Permitir todo el tiempo\" en el permiso de ubicación."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para os lembretes funcionarem com o app fechado, escolha \"Permitir o tempo todo\" na permissão de localização."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप बंद होने पर भी रिमाइंडर चलें, इसके लिए स्थान अनुमति में \"हर समय अनुमति दें\" चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ বন্ধ থাকলেও রিমাইন্ডার কাজ করতে অবস্থান অনুমতিতে \"সবসময় অনুমতি দিন\" বাছুন।"
          }
        }
      }
    },
