    "home.customizeNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatin altında görünecek alanları seçin; sağdaki tutamaçla sürükleyerek sıralayın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what appears under the clock; drag the handle on the right to reorder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, was unter der Uhr erscheint; ziehen Sie den Griff rechts, um die Reihenfolge zu ändern."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatın altında görünəcək sahələri seçin; sağdakı tutacaqla sürükləyərək sıralayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما يظهر أسفل الساعة، واسحب المقبض على اليمين لتغيير الترتيب."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apa yang tampil di bawah jam; seret pegangan di kanan untuk mengubah urutan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کریں کہ گھڑی کے نیچے کیا دکھے؛ ترتیب بدلنے کے لیے دائیں طرف کا ہینڈل گھسیٹیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب کنید زیر ساعت چه نمایش داده شود؛ برای تغییر ترتیب، دستگیرهٔ کنار هر مورد را بکشید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ce qui s’affiche sous l’horloge ; faites glisser la poignée à droite pour réordonner."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, что показывать под часами; перетащите маркер справа, чтобы изменить порядок."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計の下に表示するものを選び、右のハンドルをドラッグして並べ替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계 아래에 나올 항목을 고르고 오른쪽 핸들을 끌어 순서를 바꾸세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择时钟下方显示的内容；拖动右侧手柄调整顺序。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin ang lalabas sa ilalim ng orasan; hilahin ang hawakan sa kanan para baguhin ang pagkakasunod-sunod."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกสิ่งที่จะแสดงใต้นาฬิกา ลากที่จับทางขวาเพื่อจัดลำดับ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija qué aparece bajo el reloj; arrastre el asa de la derecha para cambiar el orden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que aparece abaixo do relógio; arraste a alça à direita para mudar a ordem."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि घड़ी के नीचे क्या दिखे; क्रम बदलने के लिए दाईं ओर का हैंडल खींचें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ির নিচে কী দেখাবে বেছে নিন; ক্রম বদলাতে ডানের হাতল টেনে নিন।"
          }
        }
      }
    },
