    "nature.eclLocalNone": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: bu tutulma buradan görülmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: this eclipse is not visible from here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Diese Finsternis ist von hier nicht sichtbar."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: bu tutulma buradan görünmür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: لا يُرى هذا الكسوف من هنا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: gerhana ini tidak terlihat dari sini."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: یہ گرہن یہاں سے نظر نہیں آتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: این گرفت از اینجا دیده نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : cette éclipse n'est pas visible d'ici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: это затмение отсюда не видно."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：この日食はここからは見えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 이 일식은 이곳에서 보이지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：此地看不到这次日食。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: hindi makikita mula rito ang eklipseng ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: มองไม่เห็นอุปราคาครั้งนี้จากที่นี่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: este eclipse no es visible desde aquí."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: este eclipse não é visível daqui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: यह ग्रहण यहाँ से नहीं दिखेगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: এই গ্রহণ এখান থেকে দেখা যায় না।"
          }
        }
      }
    },
    "nature.eclLocalLow": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: tutulma sırasında Güneş ufkun altında."
          }
