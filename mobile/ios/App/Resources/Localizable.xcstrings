    "onboard.q.prayer.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz vakitlerini takip ediyor musunuz?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you follow prayer times?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgen Sie die Gebetszeiten?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz vaxtlarını izləyirsinizmi?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تتابع أوقات الصلاة؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda mengikuti jadwal salat?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ نماز کے اوقات کا خیال رکھتے ہیں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آیا اوقات شرعی را دنبال می‌کنید؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez-vous les heures de prière ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы следите за временем намаза?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拝時刻を確認しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도 시간을 챙기시나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您关注礼拜时间吗？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusunod mo ba ang oras ng dasal?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณติดตามเวลาละหมาดไหม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sigue los horarios de oración?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você acompanha os horários de oração?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप नमाज़ के समय देखते हैं?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি নামাজের সময় অনুসরণ করেন?"
          }
        }
      }
    },
    "onboard.q.prayer.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evet derseniz Vakitler alt çubuğa gelir, saatin altında sıradaki vakit görünür ve vakit bildirimleri açılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If yes, the Prayer tab joins the tab bar, the next prayer shows under the clock and prayer notifications turn on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Ja kommt „Gebet“ in die Leiste, das nächste Gebet erscheint unter der Uhr und Gebetsbenachrichtigungen werden eingeschaltet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəli desəniz, Vaxtlar alt paneldə görünər, saatın altında növbəti vaxt göstərilər və vaxt bildirişləri açılar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن أجبت بنعم، تنضم «الصلاة» إلى الشريط السفلي، وتظهر الصلاة التالية تحت الساعة، وتُفعَّل إشعارات الصلاة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ya, tab Salat masuk ke bilah bawah, salat berikutnya tampil di bawah jam, dan notifikasi salat dinyalakan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہاں کہیں تو نماز کا ٹیب نیچے کی پٹی میں آ جائے گا، گھڑی کے نیچے اگلی نماز دکھے گی اور نماز کی اطلاعات چالو ہو جائیں گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر بله، «اوقات شرعی» به نوار پایین می‌آید، وقت بعدی زیر ساعت نمایش داده می‌شود و اعلان‌های اوقات روشن می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si oui, l'onglet Prière rejoint la barre, la prochaine prière s'affiche sous l'horloge et les notifications de prière s'activent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если да, вкладка «Намаз» появится в нижней панели, под часами будет ближайший намаз, а уведомления о намазе включатся."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「はい」なら下のバーに礼拝が加わり、時計の下に次の礼拝時刻が表示され、礼拝の通知がオンになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예를 고르면 하단 막대에 기도 탭이 추가되고, 시계 아래에 다음 기도 시간이 보이며 기도 알림이 켜져요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选“是”后，底栏会加入“礼拜”，时钟下方显示下一次礼拜时间，并开启礼拜通知。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung oo, papasok ang Dasal sa bar sa ibaba, lalabas sa ilalim ng orasan ang susunod na dasal at bubuksan ang mga abiso ng dasal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าใช่ แท็บละหมาดจะอยู่ในแถบด้านล่าง เวลาละหมาดถัดไปจะแสดงใต้นาฬิกา และเปิดการแจ้งเตือนละหมาด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si responde sí, Oración entra en la barra inferior, la próxima oración aparece bajo el reloj y se activan los avisos de oración."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sim, Oração entra na barra inferior, a próxima oração aparece abaixo do relógio e as notificações de oração são ativadas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाँ कहें तो नमाज़ टैब नीचे की पट्टी में आ जाएगा, घड़ी के नीचे अगली नमाज़ दिखेगी और नमाज़ की सूचनाएँ चालू होंगी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হ্যাঁ হলে নামাজ ট্যাব ট্যাব বারে যোগ হয়, ঘড়ির নিচে পরের নামাজ দেখা যায় এবং নামাজের নোটিফিকেশন চালু হয়।"
          }
        }
      }
    },
    "onboard.q.weather.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava durumuna sık bakar mısınız?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you often check the weather?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schauen Sie oft aufs Wetter?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava proqnozuna tez-tez baxırsınızmı?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تتابع حالة الطقس كثيرًا؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda sering melihat cuaca?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ اکثر موسم دیکھتے ہیں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آیا زیاد به آب‌وهوا سر می‌زنید؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez-vous souvent la météo ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы часто смотрите погоду?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気をよく確認しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨를 자주 확인하시나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您经常看天气吗？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Madalas mo bang tingnan ang panahon?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณดูสภาพอากาศบ่อยไหม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Consulta el tiempo a menudo?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você confere o clima com frequência?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप अक्सर मौसम देखते हैं?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি প্রায়ই আবহাওয়া দেখেন?"
          }
        }
      }
    },
    "onboard.q.weather.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evet derseniz Hava alt çubuğa gelir ve sabahları kısa bir hava özeti alırsınız."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If yes, Weather joins the tab bar and you get a short weather summary each morning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Ja kommt „Wetter“ in die Leiste und Sie erhalten morgens eine kurze Wetterübersicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəli desəniz, Hava alt paneldə görünər və səhərlər qısa hava xülasəsi alarsınız."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن أجبت بنعم، ينضم «الطقس» إلى الشريط السفلي وتصلك كل صباح خلاصة قصيرة للطقس."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ya, Cuaca masuk ke bilah bawah dan setiap pagi Anda mendapat ringkasan cuaca singkat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہاں کہیں تو موسم نیچے کی پٹی میں آ جائے گا اور ہر صبح موسم کا مختصر خلاصہ ملے گا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر بله، «آب‌وهوا» به نوار پایین می‌آید و هر صبح خلاصه‌ای کوتاه از هوا دریافت می‌کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si oui, Météo rejoint la barre et vous recevez chaque matin un bref résumé météo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если да, «Погода» появится в нижней панели, а по утрам будет приходить короткая сводка."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「はい」なら下のバーに天気が加わり、毎朝短い天気のまとめが届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예를 고르면 하단 막대에 날씨가 추가되고 아침마다 짧은 날씨 요약을 받아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选“是”后，底栏会加入“天气”，每天早上还会收到简短的天气摘要。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung oo, papasok ang Panahon sa bar sa ibaba at may maikling buod ng panahon tuwing umaga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าใช่ แท็บอากาศจะอยู่ในแถบด้านล่าง และคุณจะได้รับสรุปอากาศสั้น ๆ ทุกเช้า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si responde sí, Tiempo entra en la barra inferior y cada mañana recibe un breve resumen del tiempo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sim, Clima entra na barra inferior e você recebe um breve resumo do tempo toda manhã."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाँ कहें तो मौसम नीचे की पट्टी में आ जाएगा और हर सुबह मौसम का छोटा सार मिलेगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হ্যাঁ হলে আবহাওয়া ট্যাব বারে যোগ হয় এবং প্রতিদিন সকালে আবহাওয়ার একটি ছোট সারাংশ পান।"
          }
        }
      }
    },
    "onboard.q.calendar.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatilleri ve özel günleri takip etmek ister misiniz?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Would you like to keep track of holidays and special days?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie Feiertage und besondere Tage im Blick behalten?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayramları və xüsusi günləri izləmək istəyirsinizmi?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد متابعة العطلات والأيام الخاصة؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingin memantau hari libur dan hari istimewa?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ چھٹیوں اور خاص دنوں کا خیال رکھنا چاہیں گے؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌خواهید تعطیلات و روزهای خاص را دنبال کنید؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous suivre les jours fériés et les jours particuliers ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите следить за праздниками и особыми днями?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "祝日や特別な日をチェックしたいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공휴일과 특별한 날을 챙기고 싶으신가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想关注节假日和特别的日子吗？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusto mo bang subaybayan ang mga holiday at espesyal na araw?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยากติดตามวันหยุดและวันสำคัญไหม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quiere seguir los festivos y los días especiales?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quer acompanhar feriados e datas especiais?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप छुट्टियों और खास दिनों पर नज़र रखना चाहेंगे?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছুটি ও বিশেষ দিনগুলোর খোঁজ রাখতে চান?"
          }
        }
      }
    },
    "onboard.q.calendar.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evet derseniz Takvim alt çubuğa gelir; tatiller, dini ve özel günler telefonunuzun takvimiyle bir arada görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If yes, Calendar joins the tab bar; holidays, religious and special days appear together with your phone's calendar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Ja kommt „Kalender“ in die Leiste; Feiertage, religiöse und besondere Tage erscheinen zusammen mit Ihrem Telefonkalender."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəli desəniz, Təqvim alt paneldə görünər; bayramlar, dini və xüsusi günlər telefonunuzun təqvimi ilə birlikdə göstərilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن أجبت بنعم، ينضم «التقويم» إلى الشريط السفلي، وتظهر العطلات والمناسبات الدينية والخاصة مع تقويم هاتفك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ya, Kalender masuk ke bilah bawah; hari libur, hari keagamaan dan hari istimewa tampil bersama kalender ponsel Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہاں کہیں تو کیلنڈر نیچے کی پٹی میں آ جائے گا؛ چھٹیاں، مذہبی اور خاص دن آپ کے فون کے کیلنڈر کے ساتھ دکھیں گے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر بله، «تقویم» به نوار پایین می‌آید و تعطیلات، مناسبت‌های دینی و روزهای خاص کنار تقویم گوشی‌تان نمایش داده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si oui, Calendrier rejoint la barre ; jours fériés, fêtes religieuses et jours particuliers s'affichent avec le calendrier de votre téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если да, «Календарь» появится в нижней панели; праздники, религиозные и особые дни будут рядом с календарём телефона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「はい」なら下のバーにカレンダーが加わり、祝日や宗教行事、特別な日がスマートフォンの予定と一緒に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예를 고르면 하단 막대에 달력이 추가되고, 공휴일과 종교 기념일, 특별한 날이 휴대폰 일정과 함께 보여요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选“是”后，底栏会加入“日历”，节假日、宗教节日和特别的日子会与手机日历一起显示。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung oo, papasok ang Kalendaryo sa bar sa ibaba; makikita ang mga holiday, araw-panrelihiyon at espesyal na araw kasama ng kalendaryo ng iyong telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าใช่ แท็บปฏิทินจะอยู่ในแถบด้านล่าง วันหยุด วันสำคัญทางศาสนา และวันพิเศษจะแสดงคู่กับปฏิทินในโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si responde sí, Calendario entra en la barra inferior; festivos, fechas religiosas y días especiales aparecen junto al calendario de su teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sim, Calendário entra na barra inferior; feriados, datas religiosas e especiais aparecem junto com a agenda do seu celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाँ कहें तो कैलेंडर नीचे की पट्टी में आ जाएगा; छुट्टियाँ, धार्मिक और खास दिन आपके फ़ोन के कैलेंडर के साथ दिखेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হ্যাঁ হলে ক্যালেন্ডার ট্যাব বারে যোগ হয়; ছুটি, ধর্মীয় ও বিশেষ দিনগুলো আপনার ফোনের ক্যালেন্ডারের সঙ্গে একসঙ্গে দেখা যায়।"
          }
        }
      }
    },
    "onboard.q.world.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka şehirlerin saatine bakar mısınız?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you check the time in other cities?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schauen Sie auf die Uhrzeit in anderen Städten?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqa şəhərlərin saatına baxırsınızmı?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تنظر إلى الوقت في مدن أخرى؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda melihat waktu di kota lain?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ دوسرے شہروں کا وقت دیکھتے ہیں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آیا ساعت شهرهای دیگر را نگاه می‌کنید؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez-vous l'heure dans d'autres villes ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите время в других городах?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの都市の時刻を見ますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 도시의 시간을 보시나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您会查看其他城市的时间吗？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinitingnan mo ba ang oras sa ibang lungsod?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณดูเวลาของเมืองอื่นไหม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Consulta la hora de otras ciudades?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você confere o horário de outras cidades?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप दूसरे शहरों का समय देखते हैं?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি অন্য শহরের সময় দেখেন?"
          }
        }
      }
    },
    "onboard.q.world.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evet derseniz dünya saatleri ve dönen dünya hep elinizin altında olur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If yes, world clocks and the spinning globe are always at hand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Ja sind Weltuhren und der drehende Globus immer griffbereit."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəli desəniz, dünya saatları və fırlanan dünya həmişə əlinizin altında olar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن أجبت بنعم، تكون ساعات العالم والكرة الأرضية الدوّارة في متناولك دائمًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ya, jam dunia dan bola dunia yang berputar selalu siap di tangan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہاں کہیں تو دنیا کی گھڑیاں اور گھومتا ہوا گلوب ہمیشہ آپ کے پاس رہیں گے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر بله، ساعت‌های جهانی و کره‌ی چرخان همیشه دم دستتان است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si oui, les horloges mondiales et le globe qui tourne sont toujours à portée de main."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если да, мировые часы и вращающийся глобус всегда будут под рукой."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「はい」なら世界時計と回る地球儀をいつでもすぐ見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예를 고르면 세계 시계와 돌아가는 지구본을 언제든 바로 볼 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选“是”后，世界时钟和旋转地球仪随时可用。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung oo, laging abot-kamay ang mga world clock at umiikot na globo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าใช่ นาฬิกาโลกและลูกโลกหมุนจะพร้อมใช้เสมอ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si responde sí, los relojes mundiales y el globo giratorio estarán siempre a mano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sim, os relógios mundiais e o globo girando ficam sempre à mão."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाँ कहें तो दुनिया की घड़ियाँ और घूमता ग्लोब हमेशा आपके पास रहेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হ্যাঁ হলে বিশ্ব ঘড়ি ও ঘূর্ণায়মান গ্লোব সবসময় হাতের কাছে থাকে।"
          }
        }
      }
    },
    "onboard.q.seasons.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevsimler, Ay ve gökyüzü ilginizi çeker mi?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you curious about the seasons, the Moon and the sky?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Interessieren Sie sich für Jahreszeiten, Mond und Himmel?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fəsillər, Ay və səma sizi maraqlandırırmı?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تهتم بالفصول والقمر والسماء؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda tertarik pada musim, Bulan, dan langit?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا موسم، چاند اور آسمان آپ کو دلچسپ لگتے ہیں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آیا فصل‌ها، ماه و آسمان برایتان جالب است؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les saisons, la Lune et le ciel vous intéressent-ils ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам интересны времена года, Луна и небо?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "季節や月、星空に興味はありますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계절, 달, 하늘에 관심이 있으신가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您对季节、月亮和星空感兴趣吗？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Interesado ka ba sa mga panahon, Buwan at kalangitan?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสนใจฤดูกาล ดวงจันทร์ และท้องฟ้าไหม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Le interesan las estaciones, la Luna y el cielo?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estações, Lua e céu despertam seu interesse?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या ऋतुओं, चाँद और आसमान में आपकी रुचि है?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঋতু, চাঁদ ও আকাশ সম্পর্কে কৌতূহলী?"
          }
        }
      }
    },
    "onboard.q.seasons.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evet derseniz Ay'ın evreleri, tutulmalar, gün doğumu ve gece gökyüzü bir dokunuş uzağınızda olur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If yes, Moon phases, eclipses, sunrise and the night sky are one tap away."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Ja sind Mondphasen, Finsternisse, Sonnenaufgang und Nachthimmel nur einen Tipp entfernt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəli desəniz, Ayın fazaları, tutulmalar, gün çıxışı və gecə səması bir toxunuşla açılar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن أجبت بنعم، تصبح أطوار القمر والكسوف والخسوف والشروق وسماء الليل على بُعد لمسة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ya, fase Bulan, gerhana, matahari terbit, dan langit malam hanya sejauh satu sentuhan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہاں کہیں تو چاند کی منزلیں، گرہن، طلوعِ آفتاب اور رات کا آسمان ایک ٹچ کی دوری پر ہوں گے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر بله، اهلّه‌ی ماه، گرفت‌ها، طلوع آفتاب و آسمان شب با یک لمس در دسترس است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si oui, phases de la Lune, éclipses, lever du soleil et ciel nocturne sont à portée de doigt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если да, фазы Луны, затмения, восход и ночное небо будут в одном касании."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「はい」なら月の満ち欠け、日食・月食、日の出、夜空をすぐに見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예를 고르면 달의 위상, 일식과 월식, 일출, 밤하늘을 한 번에 볼 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选“是”后，月相、日月食、日出和夜空一点即达。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung oo, isang pindot lang ang mga yugto ng Buwan, eklipse, pagsikat ng araw at kalangitan sa gabi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าใช่ ข้างขึ้นข้างแรม สุริยุปราคาและจันทรุปราคา เวลาพระอาทิตย์ขึ้น และท้องฟ้ายามค่ำจะอยู่ใกล้แค่แตะเดียว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si responde sí, las fases lunares, los eclipses, la salida del sol y el cielo nocturno estarán a un toque."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sim, fases da Lua, eclipses, nascer do sol e céu noturno ficam a um toque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाँ कहें तो चाँद की कलाएँ, ग्रहण, सूर्योदय और रात का आसमान एक टैप की दूरी पर होंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হ্যাঁ হলে চাঁদের দশা, গ্রহণ, সূর্যোদয় ও রাতের আকাশ এক চাপ দূরে।"
          }
        }
      }
    },
    "onboard.q.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayır derseniz o bölüm gizlenir ve bildirim göndermez. İstediğiniz an Ayarlar › Özellikler'den açarsınız."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If no, that section is hidden and sends no notifications. Turn it on any time in Settings › Features."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Nein wird der Bereich ausgeblendet und sendet keine Benachrichtigungen. Sie können ihn jederzeit unter Einstellungen › Funktionen einschalten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xeyr desəniz, o bölmə gizlənər və bildiriş göndərməz. İstədiyiniz an Parametrlər › Xüsusiyyətlər bölməsindən açarsınız."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن أجبت بلا، يُخفى ذلك القسم ولا يرسل إشعارات. يمكنك تفعيله متى شئت من الإعدادات › الميزات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tidak, bagian itu disembunyikan dan tidak mengirim notifikasi. Nyalakan kapan saja di Pengaturan › Fitur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نہیں کہیں تو وہ حصہ چھپ جائے گا اور اطلاع نہیں بھیجے گا۔ جب چاہیں ترتیبات › خصوصیات سے چالو کر لیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر خیر، آن بخش پنهان می‌شود و اعلانی نمی‌فرستد. هر وقت خواستید از تنظیمات › ویژگی‌ها روشنش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si non, cette section est masquée et n'envoie aucune notification. Activez-la quand vous voulez dans Réglages › Fonctions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если нет, раздел будет скрыт и не будет присылать уведомления. Включить его можно в любой момент: Настройки › Функции."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「いいえ」ならその項目は非表示になり、通知も届きません。いつでも 設定 › 機能 からオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아니요를 고르면 그 항목은 숨겨지고 알림도 오지 않아요. 언제든 설정 › 기능에서 켤 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选“否”后，该部分会隐藏，也不会发送通知。随时可在 设置 › 功能 中开启。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung hindi, itatago ang bahaging iyon at walang abiso. Buksan ito anumang oras sa Settings › Mga feature."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าไม่ ส่วนนั้นจะถูกซ่อนและไม่ส่งการแจ้งเตือน เปิดได้ทุกเมื่อที่ การตั้งค่า › ฟีเจอร์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si responde no, esa sección se oculta y no envía avisos. Actívela cuando quiera en Ajustes › Funciones."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se não, essa seção fica oculta e não envia notificações. Ative quando quiser em Ajustes › Recursos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नहीं कहें तो वह हिस्सा छिप जाएगा और सूचना नहीं भेजेगा। जब चाहें सेटिंग्स › सुविधाएँ से चालू करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "না হলে সেই অংশটি লুকানো থাকে এবং কোনো নোটিফিকেশন পাঠায় না। যেকোনো সময় সেটিংস › বৈশিষ্ট্যে চালু করুন।"
          }
        }
      }
    },
    "onboard.summary.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanız hazır"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your app is ready"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre App ist bereit"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqiniz hazırdır"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيقك جاهز"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi Anda siap"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ایپ تیار ہے"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه‌ی شما آماده است"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre appli est prête"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение готово"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備ができました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 준비됐어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已准备好"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Handa na ang app mo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปของคุณพร้อมแล้ว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su app está lista"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu app está pronto"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका ऐप तैयार है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাপ প্রস্তুত"
          }
        }
      }
    },
    "onboard.summary.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt çubuk yanıtlarınıza göre hazırlandı. Saat hep ilk sırada; bütün araçlar Tümü'nde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is set from your answers. The clock always comes first; every tool is in All."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leiste ist nach Ihren Antworten eingerichtet. Die Uhr steht immer vorn; alle Werkzeuge finden Sie unter „Alle“."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt panel cavablarınıza görə hazırlandı. Saat həmişə birincidir; bütün alətlər Hamısı bölməsindədir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جُهّز الشريط السفلي حسب إجاباتك. الساعة أولًا دائمًا، وكل الأدوات في «الكل»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah bawah disusun dari jawaban Anda. Jam selalu di depan; semua alat ada di Semua."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیچے کی پٹی آپ کے جوابات کے مطابق تیار ہے۔ گھڑی ہمیشہ پہلے؛ سب ٹولز «سب» میں ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نوار پایین بر اساس پاسخ‌هایتان آماده شد. ساعت همیشه اول است و همه‌ی ابزارها در «همه» هستند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre est réglée selon vos réponses. L'horloge vient toujours en premier ; tous les outils sont dans Tout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижняя панель настроена по вашим ответам. Часы всегда первые, все инструменты — во вкладке «Все»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のバーは回答に合わせて整いました。時計はいつも先頭、すべてのツールは「すべて」にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 막대가 답변에 맞춰 준비됐어요. 시계는 항상 맨 앞, 모든 도구는 전체에 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底栏已按您的回答设置好。时钟始终在最前，所有工具都在“全部”里。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naayos ang bar sa ibaba ayon sa mga sagot mo. Laging una ang orasan; nasa Lahat ang lahat ng tool."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบด้านล่างจัดตามคำตอบของคุณแล้ว นาฬิกาอยู่หน้าสุดเสมอ เครื่องมือทั้งหมดอยู่ใน ทั้งหมด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra inferior se ajustó según sus respuestas. El reloj va siempre primero; todas las herramientas están en Todo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra inferior foi montada com base nas suas respostas. O relógio vem sempre primeiro; todas as ferramentas estão em Tudo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे की पट्टी आपके जवाबों से तैयार हो गई। घड़ी हमेशा पहले; सारे टूल \"सब\" में हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্যাব বার আপনার উত্তর অনুযায়ী সাজানো হয়েছে। ঘড়ি সবসময় প্রথমে আসে; প্রতিটি টুল সব-এ আছে।"
          }
        }
      }
    },
