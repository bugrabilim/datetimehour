    "qibla.cameraNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu dik tutup çevirin; Kâbe işareti ortaya geldiğinde kıble önünüzdedir. Görüntü telefonda kalır, kaydedilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the phone upright and turn; when the Kaaba marker reaches the centre, the qibla is in front of you. The image stays on the phone and is not saved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie das Telefon aufrecht und drehen Sie sich; steht das Kaaba-Zeichen in der Mitte, liegt die Qibla vor Ihnen. Das Bild bleibt auf dem Telefon und wird nicht gespeichert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu dik tutub dönün; Kəbə işarəsi ortaya gələndə qiblə qarşınızdadır. Görüntü telefonda qalır, yadda saxlanmır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أمسك الهاتف عموديًا واستدر؛ عندما تصل علامة الكعبة إلى المنتصف تكون القبلة أمامك. تبقى الصورة على الهاتف ولا تُحفظ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang ponsel tegak lalu berputar; saat penanda Ka'bah di tengah, kiblat ada di depan Anda. Gambar tetap di ponsel dan tidak disimpan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون سیدھا پکڑ کر گھومیں؛ جب کعبہ کا نشان بیچ میں آئے تو قبلہ آپ کے سامنے ہے۔ تصویر فون پر رہتی ہے، محفوظ نہیں ہوتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی را عمودی بگیرید و بچرخید؛ وقتی نشانه کعبه به وسط رسید، قبله روبه‌روی شماست. تصویر روی گوشی می‌ماند و ذخیره نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez le téléphone droit et tournez ; quand le repère de la Kaaba est au centre, la qibla est devant vous. L'image reste sur le téléphone et n'est pas enregistrée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите телефон вертикально и поворачивайтесь; когда знак Каабы окажется в центре, кибла перед вами. Изображение остаётся на телефоне и не сохраняется."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末を縦に持って向きを変え、カアバの印が中央に来たらキブラは正面です。映像は端末内にとどまり、保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 세워 들고 돌아보세요. 카바 표시가 가운데에 오면 키블라가 앞쪽입니다. 영상은 휴대폰에만 있고 저장되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "竖直握住手机并转身；天房标记到达中央时，朝向就在您正前方。画面只留在手机上，不会保存。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hawakan nang patayo ang telepono at umikot; kapag nasa gitna na ang marka ng Kaaba, nasa harap mo ang qibla. Nananatili sa telepono ang larawan at hindi sine-save."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถือโทรศัพท์ตั้งตรงแล้วหมุนตัว เมื่อเครื่องหมายกะอ์บะฮ์อยู่ตรงกลาง กิบลัตอยู่ตรงหน้าคุณ ภาพอยู่ในโทรศัพท์และไม่ถูกบันทึก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostenga el teléfono en vertical y gire; cuando la marca de la Kaaba llegue al centro, la alquibla está delante de usted. La imagen se queda en el teléfono y no se guarda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o celular em pé e gire; quando a marca da Caaba chegar ao centro, a qibla está à sua frente. A imagem fica no celular e não é salva."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन को सीधा खड़ा पकड़कर घूमें; जब काबा का निशान बीच में आए, क़िबला आपके सामने है। तस्वीर फ़ोन पर ही रहती है और सहेजी नहीं जाती।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোনটি সোজা করে ধরে ঘুরুন; কাবার চিহ্ন মাঝখানে এলে কিবলা আপনার সামনে। ছবিটি ফোনেই থাকে এবং সংরক্ষণ হয় না।"
          }
        }
      }
    },
    "qibla.cameraDenied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera izni yok. Ayarlar'dan izin verebilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera permission. You can allow it in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kameraberechtigung. Sie können sie in den Einstellungen erlauben."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera icazəsi yoxdur. Ayarlardan icazə verə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد إذن للكاميرا. يمكنك السماح به من الإعدادات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada izin kamera. Anda dapat mengizinkannya di Pengaturan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیمرا کی اجازت نہیں۔ آپ ترتیبات سے اجازت دے سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازه دوربین نیست. می‌توانید از تنظیمات اجازه دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'autorisation caméra. Vous pouvez l'accorder dans Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к камере. Его можно разрешить в настройках."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの許可がありません。設定で許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 권한이 없습니다. 설정에서 허용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有相机权限。可在“设置”中允许。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang pahintulot sa camera. Maaari mo itong payagan sa Settings."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีสิทธิ์ใช้กล้อง คุณอนุญาตได้ในการตั้งค่า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay permiso de cámara. Puede permitirlo en Ajustes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem permissão de câmera. Você pode permitir nos Ajustes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा अनुमति नहीं है। आप सेटिंग में अनुमति दे सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরার অনুমতি নেই। সেটিংসে অনুমতি দিতে পারেন।"
          }
        }
      }
    },
