            "state": "translated",
            "value": "这个季节过了多少？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaano na kalayo ang panahon?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฤดูนี้ผ่านไปเท่าไรแล้ว?"
          }
        }
      }
    },
    "kids.why.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevsimler neden olur?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why do we have seasons?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum gibt es Jahreszeiten?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fəsillər niyə olur?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا تحدث الفصول؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengapa ada musim?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موسم کیوں ہوتے ہیں؟"
          }
        },
        "fa": {
          "stringUnit": {
