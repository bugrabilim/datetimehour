    "hijriConv.outsideApp": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyanet tablosunun dışında; Ümmü'l-Kurâ takvimiyle hesaplandı, bir gün fark olabilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside the Diyanet table; calculated with the Umm al-Qura calendar, may differ by a day."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Außerhalb der Diyanet-Tabelle; mit dem Umm-al-Qura-Kalender berechnet, Abweichung um einen Tag möglich."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyanət cədvəlindən kənarda; Ümmül-Qura təqvimi ilə hesablandı, bir gün fərq ola bilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خارج جدول ديانت؛ حُسب بتقويم أم القرى وقد يختلف بيوم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di luar tabel Diyanet; dihitung dengan kalender Umm al-Qura, bisa berbeda sehari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیانت کے جدول سے باہر؛ ام القریٰ کیلنڈر سے حساب کیا گیا، ایک دن کا فرق ہو سکتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بیرون از جدول دیانت؛ با تقویم ام‌القری محاسبه شده و ممکن است یک روز فرق کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors de la table de la Diyanet ; calculé avec le calendrier Umm al-Qura, peut différer d’un jour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне таблицы Diyanet; рассчитано по календарю Умм аль-Кура, возможна разница в день."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディヤーネットの表の範囲外のため、ウンム・アル＝クラー暦で計算しました。1日ずれることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디야넷 표 범위 밖이어서 움 알쿠라 달력으로 계산했습니다. 하루 차이가 날 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出迪亚内特表的范围；已按乌姆古拉历计算，可能相差一天。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Labas sa talaan ng Diyanet; kinuwenta gamit ang kalendaryong Umm al-Qura, maaaring magkaiba ng isang araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่นอกตารางของดียาเนต คำนวณด้วยปฏิทินอุมมุลกุรอ อาจต่างกันหนึ่งวัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de la tabla de Diyanet; calculada con el calendario Umm al-Qura, puede diferir en un día."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fora da tabela da Diyanet; calculada com o calendário Umm al-Qura, pode diferir em um dia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दियानत तालिका के बाहर; उम्म अल-क़ुरा कैलेंडर से निकाली गई, एक दिन का अंतर हो सकता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিয়ানেত তালিকার বাইরে; উম্মুল কুরা ক্যালেন্ডারে হিসাব করা, এক দিন পার্থক্য হতে পারে।"
          }
        }
      }
    },
