    "perms.locationBg.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız konuma bağlı hatırlatıcılar için: bir yere varınca ya da ayrılınca haber verir. Vermezseniz bu hatırlatıcılar çalışmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for location reminders: they alert you when you arrive at or leave a place. Without it, these reminders don't work."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Ortserinnerungen, die sich melden, wenn Sie einen Ort erreichen oder verlassen. Ohne diese Berechtigung funktionieren sie nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız məkana bağlı xatırladıcılar üçün: bir yerə çatanda və ya oradan ayrılanda xəbər verir. Verməsəniz, bu xatırladıcılar işləmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتذكيرات الموقع فقط: تنبّهك عند الوصول إلى مكان أو مغادرته. وإن لم تسمح، لا تعمل هذه التذكيرات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk pengingat lokasi: memberi tahu saat Anda tiba atau meninggalkan suatu tempat. Jika tidak diizinkan, pengingat ini tidak berfungsi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف مقام کی یاد دہانیوں کے لیے: کسی جگہ پہنچنے یا نکلنے پر بتاتی ہیں۔ نہ دیں تو یہ یاد دہانیاں کام نہیں کریں گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط برای یادآورهای مکانی: هنگام رسیدن به جایی یا ترک آن خبر می‌دهند. اگر ندهید، این یادآورها کار نمی‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour les rappels de lieu : ils vous préviennent quand vous arrivez quelque part ou en partez. Sinon, ces rappels ne fonctionnent pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для напоминаний по месту: они срабатывают, когда вы приходите куда-то или уходите. Без этого такие напоминания не работают."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所のリマインダー専用です。ある場所に着いたときや離れたときに知らせます。許可しないとこのリマインダーは動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 알림에만 써요. 어떤 장소에 도착하거나 떠날 때 알려 줘요. 허용하지 않으면 이 알림은 작동하지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于位置提醒：到达或离开某地时提醒您。不允许则此类提醒无法使用。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lang sa mga paalala ayon sa lokasyon: aabisuhan ka pagdating o pag-alis sa isang lugar. Kung hindi, hindi gagana ang mga paalalang ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เฉพาะการเตือนตามสถานที่ เพื่อแจ้งเมื่อคุณไปถึงหรือออกจากสถานที่ ถ้าไม่อนุญาต การเตือนนี้จะใช้ไม่ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para los recordatorios por ubicación: le avisan al llegar a un lugar o al salir de él. Si no, estos recordatorios no funcionan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para lembretes por local: avisam quando você chega ou sai de um lugar. Se não, esses lembretes não funcionam."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ स्थान रिमाइंडर के लिए: किसी जगह पहुँचने या निकलने पर बताते हैं। न दें तो ये रिमाइंडर काम नहीं करेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু অবস্থানভিত্তিক রিমাইন্ডারের জন্য: কোনো জায়গায় পৌঁছালে বা ছেড়ে গেলে জানায়। এটি ছাড়া এই রিমাইন্ডারগুলো কাজ করে না।"
          }
        }
      }
    },
