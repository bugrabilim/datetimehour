          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses Jangan Ganggu"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈسٹرب نہ کریں تک رسائی"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به «مزاحم نشوید»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès à Ne pas déranger"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к «Не беспокоить»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おやすみモードへのアクセス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해 금지 접근"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勿扰权限"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Access sa Huwag Istorbohin"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงห้ามรบกวน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso a No molestar"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso ao Não perturbe"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"परेशान न करें\" तक पहुँच"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিরক্ত করবেন না অ্যাক্সেস"
          }
        }
      }
    },
    "perms.dnd.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız vakit girince telefonu sessize almak için. Vermezseniz sessize alma çalışmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only to silence your phone at prayer time. Without it, auto-silence doesn't work."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur um das Telefon zur Gebetszeit stummzuschalten. Ohne diese Berechtigung funktioniert die Stummschaltung nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız vaxt girəndə telefonu səssizə almaq üçün. Verməsəniz, səssizə alma işləmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكتم الهاتف عند دخول وقت الصلاة فقط. وإن لم تسمح، لا يعمل الكتم التلقائي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk menyenyapkan ponsel saat waktu salat tiba. Jika tidak diizinkan, fitur senyap otomatis tidak berfungsi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف نماز کا وقت ہونے پر فون خاموش کرنے کے لیے۔ نہ دیں تو خودکار خاموشی کام نہیں کرے گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط برای بی‌صدا کردن گوشی هنگام رسیدن وقت نماز. اگر ندهید، بی‌صدا شدن خودکار کار نمی‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour couper le son du téléphone à l'heure de la prière. Sinon, la mise en silence automatique ne marche pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только чтобы выключать звук телефона во время намаза. Без этого автоматическое отключение звука не работает."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拝時刻にスマートフォンを消音するためだけに使います。許可しないと自動消音は動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도 시간에 휴대폰을 무음으로 바꾸는 데만 써요. 허용하지 않으면 자동 무음이 작동하지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于礼拜时间到时让手机静音。不允许则自动静音无法使用。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lang patahimikin ang telepono sa oras ng dasal. Kung hindi, hindi gagana ang awtomatikong pagpapatahimik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เพื่อปิดเสียงโทรศัพท์เมื่อถึงเวลาละหมาดเท่านั้น ถ้าไม่อนุญาต การปิดเสียงอัตโนมัติจะใช้ไม่ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para silenciar el teléfono a la hora de la oración. Si no, el silencio automático no funciona."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para silenciar o celular na hora da oração. Se não, o silêncio automático não funciona."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ नमाज़ का समय होने पर फ़ोन साइलेंट करने के लिए। न दें तो अपने-आप साइलेंट होना काम नहीं करेगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু নামাজের সময় ফোন নীরব করতে। এটি ছাড়া স্বয়ংক্রিয় নীরবতা কাজ করে না।"
          }
        }
      }
    },
    "onboard.more.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka neler var, öğrenmek ister misiniz?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Would you like to see what else is here?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie sehen, was es sonst noch gibt?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqa nələr var, öyrənmək istəyirsinizmi?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد أن تعرف ما الذي يقدّمه التطبيق أيضًا؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingin tahu fitur apa lagi yang ada?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ جاننا چاہیں گے کہ اور کیا کچھ ہے؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌خواهید ببینید چه امکانات دیگری هست؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous découvrir ce qu'il y a d'autre ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите узнать, что ещё есть в приложении?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかにどんな機能があるか見てみますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 기능이 더 있는지 알아볼까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想了解还有哪些功能吗？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusto mo bang malaman kung ano pa ang narito?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยากรู้ไหมว่ามีอะไรอีกบ้าง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quiere conocer qué más ofrece la app?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quer conhecer o que mais o app oferece?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप जानना चाहेंगे कि और क्या-क्या है?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে আর কী আছে দেখতে চান?"
          }
        }
      }
    },
    "onboard.more.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer özellikleri birkaç kısa sayfada tek tek gösterelim. Hayır derseniz hepsi Tümü'nde sizi bekler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll show the other features one by one on a few short pages. If you say no, they're all waiting under All."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir zeigen Ihnen die weiteren Funktionen nacheinander auf ein paar kurzen Seiten. Wenn nicht, finden Sie alles unter „Alle“."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Digər imkanları bir neçə qısa səhifədə bir-bir göstərək. Xeyr desəniz, hamısı \"Hamısı\" bölməsində sizi gözləyir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنعرض لك بقية الميزات واحدة تلو الأخرى في صفحات قصيرة. وإن قلت لا، تجدها كلها في «الكل»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tunjukkan fitur lainnya satu per satu dalam beberapa halaman singkat. Jika tidak, semuanya menunggu di Semua."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم دوسری خصوصیات چند مختصر صفحوں میں ایک ایک کر کے دکھائیں گے۔ نہیں کہیں تو سب کچھ «سب» میں آپ کا منتظر ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امکانات دیگر را یکی‌یکی در چند صفحهٔ کوتاه نشان می‌دهیم. اگر نه، همه در «همه» منتظر شما هستند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous présentons les autres fonctions une à une sur quelques pages courtes. Sinon, tout vous attend dans « Tout »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажем остальные возможности по одной на нескольких коротких страницах. Если нет — всё ждёт вас во вкладке «Все»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの機能を短いページで1つずつご紹介します。「いいえ」の場合も、すべて「すべて」にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기능을 짧은 페이지로 하나씩 보여 드릴게요. 아니요를 누르면 모든 기능은 '전체'에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会用几页简短的介绍逐一展示其他功能。如果不需要，所有功能都在“全部”里。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipapakita namin ang iba pang feature isa-isa sa ilang maiikling pahina. Kung hindi, naghihintay ang lahat sa Lahat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะแนะนำฟีเจอร์อื่น ๆ ทีละอย่างในไม่กี่หน้า หากไม่ต้องการ ทุกอย่างรออยู่ใน \"ทั้งหมด\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mostramos las demás funciones una a una en unas pocas páginas breves. Si no, todo le espera en «Todo»."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos mostrar os outros recursos um a um, em poucas páginas curtas. Se não quiser, todos eles esperam por você em \"Tudo\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम बाक़ी सुविधाएँ कुछ छोटे पन्नों में एक-एक करके दिखाएँगे। नहीं चाहें तो सब कुछ \"सब\" में आपका इंतज़ार कर रहा है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কয়েকটি ছোট পাতায় অন্য বৈশিষ্ট্যগুলো একে একে দেখাব। না বললে সেগুলো সব-এ আপনার অপেক্ষায় থাকবে।"
          }
        }
      }
    },
