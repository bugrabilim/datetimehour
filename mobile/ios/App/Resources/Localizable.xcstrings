    "wake.checkRing": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre dolunca alarm yeniden çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When time runs out, the alarm rings again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Zeit abläuft, klingelt der Wecker erneut."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxt bitəndə zəngli saat yenidən çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند انتهاء الوقت يرن المنبه مرة أخرى."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat waktunya habis, alarm berbunyi lagi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت ختم ہونے پر الارم دوبارہ بجے گا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی زمان تمام شود، هشدار دوباره زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le temps est écoulé, l'alarme sonne à nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда время выйдет, будильник зазвонит снова."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間切れになるとアラームが再び鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 끝나면 알람이 다시 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间到后闹钟会再次响起。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag naubos ang oras, tutunog ulit ang alarma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อหมดเวลา นาฬิกาปลุกจะดังอีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se acabe el tiempo, la alarma vuelve a sonar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o tempo acabar, o alarme toca de novo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
