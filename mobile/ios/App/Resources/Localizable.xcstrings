    "nature.eclipseLead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önümüzdeki Güneş ve Ay tutulmaları. Saat, en büyük tutulma anıdır (%1$@ saatiyle)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upcoming solar and lunar eclipses. The time is the moment of greatest eclipse (%1$@ time)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommende Sonnen- und Mondfinsternisse. Die Uhrzeit ist der Zeitpunkt der größten Verfinsterung (%1$@)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarşıdakı Günəş və Ay tutulmaları. Saat ən böyük tutulma anıdır (%1$@ vaxtı ilə)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكسوفات والخسوفات القادمة. الوقت هو لحظة ذروة الكسوف أو الخسوف (بتوقيت %1$@)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerhana Matahari dan Bulan mendatang. Waktunya adalah puncak gerhana (waktu %1$@)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آنے والے سورج اور چاند گرہن۔ وقت گرہن کے عروج کا لمحہ ہے (%1$@ کا وقت)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خورشیدگرفتگی‌ها و ماه‌گرفتگی‌های پیش رو. زمان، لحظهٔ اوج گرفت است (به وقت %1$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prochaines éclipses de Soleil et de Lune. L’heure est celle du maximum de l’éclipse (heure de %1$@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ближайшие солнечные и лунные затмения. Указано время максимальной фазы (время места %1$@)."
          }
        }
      }
    },
