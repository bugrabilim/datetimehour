          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz, qəza və oruc qeydləri bu cihazdan silinsin?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف سجلات الصلاة والقضاء والصيام من هذا الجهاز؟"
          }
        },
        "id": {
