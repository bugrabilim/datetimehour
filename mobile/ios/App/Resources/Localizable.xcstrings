        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر روزی که با هم می‌گذرانید زیباتر شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que chaque jour partagé soit encore plus beau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть каждый общий день будет ещё прекраснее."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共に過ごす毎日がもっと素敵になりますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함께하는 하루하루가 더 아름다워지길."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "愿共度的每一天都更加美好。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawa'y lalong gumanda ang bawat araw na magkasama kayo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้ทุกวันที่อยู่ด้วยกันงดงามยิ่งขึ้น"
