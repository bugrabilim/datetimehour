    "onboard.tour.widgets.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ekrana ve kilit ekranına saat, sıradaki vakit, hava, Ay ve hicri tarih ekleyin; akıllı saatinizde de görün."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the clock, next prayer, weather, the Moon and the Hijri date to your Home and Lock Screen, and see them on your watch too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhr, nächstes Gebet, Wetter, Mond und Hidschri-Datum auf Home- und Sperrbildschirm – und auch auf Ihrer Smartwatch."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas ekrana və kilid ekranına saat, növbəti vaxt, hava, Ay və hicri tarix əlavə edin; ağıllı saatınızda da görün."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف الساعة والصلاة التالية والطقس والقمر والتاريخ الهجري إلى الشاشة الرئيسية وشاشة القفل، وشاهدها على ساعتك الذكية أيضًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan jam, salat berikutnya, cuaca, Bulan, dan tanggal Hijriah ke layar utama dan layar kunci; lihat juga di jam tangan pintar Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہوم اور لاک اسکرین پر گھڑی، اگلی نماز، موسم، چاند اور ہجری تاریخ لگائیں؛ اپنی اسمارٹ واچ پر بھی دیکھیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت، نماز بعدی، هوا، ماه و تاریخ هجری را به صفحهٔ اصلی و صفحهٔ قفل بیفزایید؛ روی ساعت هوشمندتان هم ببینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez l'heure, la prochaine prière, la météo, la Lune et la date hégirienne à l'écran d'accueil et verrouillé, et retrouvez-les sur votre montre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте часы, следующий намаз, погоду, Луну и дату по хиджре на экран «Домой» и экран блокировки — и смотрите их на часах."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面とロック画面に時計、次の礼拝、天気、月、ヒジュラ暦を追加。スマートウォッチでも見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면과 잠금 화면에 시계, 다음 기도, 날씨, 달, 히즈라력을 추가하고 스마트워치에서도 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主屏幕和锁屏上添加时钟、下一次礼拜、天气、月相和伊斯兰历日期，智能手表上也能看到。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Idagdag ang orasan, susunod na dasal, panahon, Buwan at petsang Hijri sa Home at Lock Screen, at makita rin sa relo mo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มนาฬิกา ละหมาดถัดไป อากาศ ดวงจันทร์ และวันที่ฮิจเราะห์ลงในหน้าจอโฮมและหน้าจอล็อก ดูบนสมาร์ทวอทช์ได้ด้วย"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada el reloj, la próxima oración, el tiempo, la Luna y la fecha de la Hégira a la pantalla de inicio y de bloqueo, y véalos también en su reloj inteligente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o relógio, a próxima oração, o clima, a Lua e a data da Hégira à Tela de Início e à Tela Bloqueada, e veja tudo também no seu smartwatch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम और लॉक स्क्रीन पर घड़ी, अगली नमाज़, मौसम, चाँद और हिजरी तारीख़ जोड़ें; अपनी स्मार्टवॉच पर भी देखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ি, পরের নামাজ, আবহাওয়া, চাঁদ ও হিজরি তারিখ আপনার হোম ও লক স্ক্রিনে যোগ করুন, আর ঘড়িতেও দেখুন।"
          }
        }
      }
    },
    "onboard.tour.widgets.textN": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ekrana ve kilit ekranına saat, dünya saatleri, hava, Ay ve takvim ekleyin; akıllı saatinizde de görün."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the clock, world clocks, weather, the Moon and your calendar to your Home and Lock Screen, and see them on your watch too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhr, Weltuhren, Wetter, Mond und Kalender auf Home- und Sperrbildschirm – und auch auf Ihrer Smartwatch."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas ekrana və kilid ekranına saat, dünya saatları, hava, Ay və təqvim əlavə edin; ağıllı saatınızda da görün."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف الساعة وساعات العالم والطقس والقمر والتقويم إلى الشاشة الرئيسية وشاشة القفل، وشاهدها على ساعتك الذكية أيضًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan jam, jam dunia, cuaca, Bulan, dan kalender ke layar utama dan layar kunci; lihat juga di jam tangan pintar Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہوم اور لاک اسکرین پر گھڑی، عالمی گھڑیاں، موسم، چاند اور کیلنڈر لگائیں؛ اپنی اسمارٹ واچ پر بھی دیکھیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت، ساعت‌های جهانی، هوا، ماه و تقویم را به صفحهٔ اصلی و صفحهٔ قفل بیفزایید؛ روی ساعت هوشمندتان هم ببینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez l'heure, les horloges du monde, la météo, la Lune et le calendrier à l'écran d'accueil et verrouillé, et retrouvez-les sur votre montre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте часы, мировое время, погоду, Луну и календарь на экран «Домой» и экран блокировки — и смотрите их на часах."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面とロック画面に時計、世界時計、天気、月、カレンダーを追加。スマートウォッチでも見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면과 잠금 화면에 시계, 세계 시계, 날씨, 달, 캘린더를 추가하고 스마트워치에서도 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主屏幕和锁屏上添加时钟、世界时钟、天气、月相和日历，智能手表上也能看到。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Idagdag ang orasan, mga orasan sa mundo, panahon, Buwan at kalendaryo sa Home at Lock Screen, at makita rin sa relo mo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มนาฬิกา นาฬิกาโลก อากาศ ดวงจันทร์ และปฏิทินลงในหน้าจอโฮมและหน้าจอล็อก ดูบนสมาร์ทวอทช์ได้ด้วย"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada el reloj, relojes mundiales, el tiempo, la Luna y el calendario a la pantalla de inicio y de bloqueo, y véalos también en su reloj inteligente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o relógio, relógios mundiais, o clima, a Lua e o calendário à Tela de Início e à Tela Bloqueada, e veja tudo também no seu smartwatch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम और लॉक स्क्रीन पर घड़ी, विश्व घड़ियाँ, मौसम, चाँद और कैलेंडर जोड़ें; अपनी स्मार्टवॉच पर भी देखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ি, বিশ্ব ঘড়ি, আবহাওয়া, চাঁদ ও আপনার ক্যালেন্ডার হোম ও লক স্ক্রিনে যোগ করুন, আর ঘড়িতেও দেখুন।"
          }
        }
      }
    },
