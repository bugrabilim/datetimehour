    "meet.rangeHint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir saate dokunun; aralık için ikinci bir saate dokunun. Şehir adına dokununca o sütun 12/24 saat olur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap an hour; tap a second hour for a range. Tap a city name to switch that column between 12 and 24 hours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf eine Stunde, für einen Zeitraum auf eine zweite. Ein Tipp auf den Stadtnamen schaltet die Spalte zwischen 12 und 24 Stunden um."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir saata toxunun; aralıq üçün ikinci saata toxunun. Şəhər adına toxunanda həmin sütun 12/24 saat olur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس ساعة، ولتحديد فترة المس ساعة ثانية. المس اسم المدينة لتبديل العمود بين نظامي 12 و24 ساعة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk satu jam; ketuk jam kedua untuk rentang. Ketuk nama kota untuk mengganti kolom itu antara 12 dan 24 jam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک گھنٹے کو چھوئیں؛ دورانیے کے لیے دوسرا گھنٹہ چھوئیں۔ شہر کے نام کو چھونے سے وہ کالم 12/24 گھنٹے میں بدلتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک ساعت را لمس کنید؛ برای بازه ساعت دوم را لمس کنید. با لمس نام شهر، آن ستون بین 12 و 24 ساعته عوض می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une heure ; touchez-en une seconde pour une plage. Touchez le nom d’une ville pour passer sa colonne en 12 ou 24 h."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь часа; для интервала — второго часа. Коснитесь названия города, чтобы переключить столбец между 12 и 24 часами."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻をタップし、範囲には2つ目の時刻をタップします。都市名をタップするとその列が12/24時間表示に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 누르고, 범위는 두 번째 시간을 누르세요. 도시 이름을 누르면 그 열이 12/24시간으로 바뀝니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按一个小时；选择时段再点按第二个小时。点按城市名可在12/24小时制之间切换该列。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang isang oras; i-tap ang pangalawa para sa saklaw. I-tap ang pangalan ng lungsod para palitan ang kolum sa 12 o 24 oras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะหนึ่งชั่วโมง แตะชั่วโมงที่สองเพื่อเลือกช่วง แตะชื่อเมืองเพื่อสลับคอลัมน์นั้นระหว่าง 12 และ 24 ชั่วโมง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque una hora; toque una segunda hora para un intervalo. Toque el nombre de una ciudad para cambiar esa columna entre 12 y 24 horas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num horário; toque num segundo horário para um intervalo. Toque no nome de uma cidade para alternar aquela coluna entre 12 e 24 horas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक घंटे पर टैप करें; अवधि के लिए दूसरे घंटे पर टैप करें। किसी कॉलम को 12 और 24 घंटे के बीच बदलने के लिए शहर के नाम पर टैप करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ঘণ্টায় চাপুন; পরিসরের জন্য দ্বিতীয় একটি ঘণ্টায় চাপুন। কলামটি 12 ও 24 ঘণ্টার মধ্যে বদলাতে শহরের নামে চাপুন।"
          }
        }
      }
    },
