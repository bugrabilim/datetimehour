    "alarm.fromCalendar": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimdeki etkinliğe alarm kur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set an alarm for a calendar event"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker für einen Kalendertermin stellen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təqvimdəki tədbirə zəng qur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط منبّهًا لحدث في التقويم"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang alarm untuk acara kalender"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر کی تقریب کے لیے الارم لگائیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
