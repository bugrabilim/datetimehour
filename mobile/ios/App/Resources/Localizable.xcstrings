    "widget.dual.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burası ve seçtiğiniz şehir, iki analog kadranda."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here and a city you choose, on two analog dials."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier und eine Stadt Ihrer Wahl auf zwei analogen Zifferblättern."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bura və seçdiyiniz şəhər, iki analoq siferblatda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا ومدينة تختارها، على ميناءين تناظريين."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi Anda dan kota pilihan, pada dua muka jam analog."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں اور آپ کا منتخب شہر، دو اینالاگ ڈائلز پر۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اینجا و شهری که انتخاب می‌کنید، روی دو صفحه عقربه‌ای."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici et une ville de votre choix, sur deux cadrans analogiques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь и выбранный город на двух аналоговых циферблатах."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地と選んだ都市を2つのアナログ文字盤で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기와 선택한 도시를 두 개의 아날로그 문자판으로."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地和你选择的城市，两个指针表盘。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dito at ang lungsod na pipiliin mo, sa dalawang analog na dial."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่นี่และเมืองที่คุณเลือก บนหน้าปัดเข็มสองเรือน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí y una ciudad que elija, en dos esferas analógicas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui e uma cidade que você escolher, em dois mostradores analógicos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ और आपका चुना शहर, दो एनालॉग डायल पर।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানকার ও আপনার বাছা একটি শহরের সময়, দুটি অ্যানালগ ডায়ালে।"
          }
        }
      }
    },
