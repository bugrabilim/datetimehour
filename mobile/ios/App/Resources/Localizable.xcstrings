    "tools.alarm.wake": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranı açık tut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the screen on"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirm eingeschaltet lassen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranı açıq saxla"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبقاء الشاشة مضاءة"
          }
        }
      }
    },
    "tools.alarm.wakeNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kapanırsa tarayıcı sekmeyi uyutabilir; bu seçenek alarm kuruluyken ekranın kapanmasını engeller."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the screen turns off the browser may put the tab to sleep; this option stops the screen from turning off while an alarm is set."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich der Bildschirm ausschaltet, kann der Browser den Tab in den Ruhezustand versetzen; diese Option verhindert, dass sich der Bildschirm ausschaltet, solange ein Wecker gestellt ist."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran sönərsə, brauzer tabı yuxu rejiminə keçirə bilər; bu seçim zəngli saat qurulu olduğu müddətdə ekranın sönməsinin qarşısını alır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا انطفأت الشاشة فقد يُعلّق المتصفح التبويب؛ ويمنع هذا الخيار انطفاء الشاشة ما دام هناك منبّه مضبوط."
          }
        }
      }
    },
    "tools.alarm.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önemli uyanışlar için telefonun kendi alarmını da kurun; tarayıcı alarmı sayfa kapanırsa çalmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For important wake-ups also set your phone's own alarm; a browser alarm will not ring if the page is closed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie für wichtige Weckzeiten zusätzlich den Wecker Ihres Telefons; ein Browser-Wecker klingelt nicht, wenn die Seite geschlossen ist."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacib oyanışlar üçün telefonunuzun öz zəngli saatını da qurun; səhifə bağlı olarsa, brauzerdəki zəngli saat çalmayacaq."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للاستيقاظ في المواعيد المهمة اضبط أيضًا منبّه هاتفك؛ فمنبّه المتصفح لا يرنّ إذا كانت الصفحة مغلقة."
          }
        }
      }
    },
