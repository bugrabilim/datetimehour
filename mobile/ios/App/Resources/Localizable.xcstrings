          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your badges and progress are stored only on this device until you delete them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Abzeichen und dein Fortschritt werden nur auf diesem Gerät gespeichert, bis du sie löschst."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nişanların və irəliləyişin yalnız bu cihazda, sən silənə qədər saxlanılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ شاراتك وتقدّمك على هذا الجهاز فقط إلى أن تحذفها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lencana dan kemajuan Anda hanya disimpan di perangkat ini sampai Anda menghapusnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے بیجز اور پیش رفت حذف کرنے تک صرف اسی آلے پر محفوظ رہتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشان‌ها و پیشرفت شما تا وقتی آن‌ها را حذف نکنید فقط روی همین دستگاه ذخیره می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos badges et votre progression restent uniquement sur cet appareil jusqu’à ce que vous les supprimiez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значки и ваш прогресс хранятся только на этом устройстве, пока вы их не удалите."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッジと進み具合は、削除するまでこの端末にだけ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배지와 진행 상황은 삭제할 때까지 이 기기에만 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的徽章和进度只保存在此设备上，直到您删除。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa device na ito lang nakatago ang iyong mga badge at progreso hanggang burahin mo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหรียญตราและความคืบหน้าเก็บไว้ในอุปกรณ์นี้เท่านั้นจนกว่าคุณจะลบ"
          }
        }
      }
    },
    "badges.deleteText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki bütün rozetlerin ve ilerlemen (gördüğün saat modelleri, kullanım serin) silinir. Geri alınamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your badges and progress on this device (the clock styles you have seen, your streak) will be deleted. This cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle deine Abzeichen und dein Fortschritt auf diesem Gerät (gesehene Uhrstile, deine Serie) werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdakı bütün nişanların və irəliləyişin (gördüyün saat modelləri, istifadə seriyan) silinəcək. Geri qaytarmaq olmur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف كل شاراتك وتقدّمك على هذا الجهاز (أنماط الساعة التي رأيتها وسلسلة استخدامك). لا يمكن التراجع عن ذلك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua lencana dan kemajuan Anda di perangkat ini (gaya jam yang sudah dilihat, rangkaian hari) akan dihapus. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلے پر آپ کے تمام بیجز اور پیش رفت (دیکھے گئے گھڑی کے انداز، مسلسل دن) حذف ہو جائیں گے۔ یہ واپس نہیں ہو سکتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همهٔ نشان‌ها و پیشرفت شما روی این دستگاه (سبک‌های ساعتی که دیده‌اید، روزهای پیاپی) حذف می‌شوند. این کار برگشت‌پذیر نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous vos badges et votre progression sur cet appareil (styles d’horloge vus, série de jours) seront supprimés. Cette action est irréversible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все значки и прогресс на этом устройстве (увиденные стили часов, серия дней) будут удалены. Это нельзя отменить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末のすべてのバッジと進み具合（見た時計のスタイル、連続日数）が削除されます。元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 모든 배지와 진행 상황(본 시계 스타일, 연속 일수)이 삭제됩니다. 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的所有徽章和进度（看过的时钟样式、连续天数）都将被删除，且无法撤销。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mabubura ang lahat ng iyong badge at progreso sa device na ito (mga istilo ng orasang nakita mo, ang iyong streak). Hindi na ito maibabalik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหรียญตราและความคืบหน้าทั้งหมดในอุปกรณ์นี้ (รูปแบบนาฬิกาที่เคยดู จำนวนวันต่อเนื่อง) จะถูกลบ และย้อนกลับไม่ได้"
          }
        }
      }
    },
