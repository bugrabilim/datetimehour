    "datecalc.diffNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş günü hesabında hafta sonları ve resmi tatiller çıkarılır; bayram arifesi yarım günleri 0,5 sayılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working days leave out weekends and public holidays; bayram eve half days count as 0.5."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wochenenden und gesetzliche Feiertage zählen nicht als Arbeitstage; halbe Vorabendtage vor den Bayram-Festen zählen als 0,5."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İş günlərinə həftəsonları və rəsmi bayramlar daxil edilmir; bayram ərəfəsindəki yarım iş günləri 0,5 sayılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشمل أيام العمل عطلات نهاية الأسبوع والعطل الرسمية؛ ويُحتسب نصف يوم وقفة العيد 0.5 يوم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari kerja tidak menghitung akhir pekan dan hari libur resmi; setengah hari menjelang bayram dihitung 0,5."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام کے دنوں میں ہفتہ وار چھٹیاں اور سرکاری تعطیلات شامل نہیں؛ عید سے پہلے کی آدھی چھٹیاں 0.5 شمار ہوتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روزهای کاری بدون آخر هفته‌ها و تعطیلات رسمی شمرده می‌شوند؛ نیمه‌تعطیل‌های پیش از عید 0.5 حساب می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours ouvrés excluent les week-ends et les jours fériés ; les demi-journées de veille de bayram comptent pour 0,5."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочие дни считаются без выходных и праздников; сокращённые кануны байрамов считаются как 0,5."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "営業日は週末と祝日を除きます。バイラム前日の半日休みは0.5日と数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근무일에서는 주말과 공휴일을 빼며, 바이람 전날 반일 휴무는 0.5일로 셉니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作日不含周末和公共假日；节日前夕的半天假按 0.5 天计。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kasama sa araw ng trabaho ang weekend at pista opisyal; 0.5 ang bilang ng kalahating araw sa bisperas ng bayram."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันทำงานไม่รวมวันหยุดสุดสัปดาห์และวันหยุดราชการ ครึ่งวันก่อนไบรัมนับเป็น 0.5"
          }
        }
      }
    },
