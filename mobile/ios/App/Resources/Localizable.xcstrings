    "sw.multi.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kronometre ayrı sayar; uygulama kapansa da süre kaybolmaz. Kilit ekranında yalnız üstteki kronometre görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each stopwatch counts on its own and keeps its time even if the app closes. Only the top stopwatch appears on the lock screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Stoppuhr zählt für sich und behält ihre Zeit, auch wenn die App geschlossen wird. Auf dem Sperrbildschirm erscheint nur die obere Stoppuhr."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər saniyəölçən ayrıca sayır; tətbiq bağlansa da vaxt itmir. Kilid ekranında yalnız yuxarıdakı saniyəölçən görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعدّ كل ساعة إيقاف وحدها وتحتفظ بوقتها حتى لو أُغلق التطبيق. لا تظهر على شاشة القفل إلا الساعة العلوية."
          }
        }
      }
    },
