        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 태양이 키블라 방향을 지나지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天太阳不会经过朝向方向。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngayong araw, hindi dumaraan ang Araw sa direksiyon ng qibla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้ดวงอาทิตย์ไม่ผ่านทิศกิบลัต"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy el Sol no pasa por la dirección de la alquibla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje o Sol não passa pela direção da qibla."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज सूरज क़िबला की दिशा से नहीं गुज़रता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ সূর্য কিবলার দিক অতিক্রম করে না।"
          }
        }
      }
    },
