          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ چرخه · %2$@ ساعت"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cycles · %2$@ h"
          }
        },
        "ru": {
          "stringUnit": {
