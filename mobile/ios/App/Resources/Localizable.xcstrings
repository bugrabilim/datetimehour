    "nature.crescentLead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ için %2$@ yeni ayından sonraki akşamlar. Hesap Yallop (1997) ölçütüyle yapılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evenings after the new moon of %2$@ for %1$@, calculated with Yallop's (1997) criterion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abende nach dem Neumond vom %2$@ für %1$@, berechnet nach dem Kriterium von Yallop (1997)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ üçün %2$@ yeni ayından sonrakı axşamlar, Yallop (1997) meyarı ilə hesablanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأمسيات التالية لمحاق %2$@ في %1$@، محسوبة وفق معيار يالوب (1997)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Petang-petang setelah bulan baru %2$@ untuk %1$@, dihitung dengan kriteria Yallop (1997)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کے لیے %2$@ کے نئے چاند کے بعد کی شامیں، یالوپ (1997) کے معیار سے حساب کی گئیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شامگاه‌های پس از ماه نوِ %2$@ برای %1$@، محاسبه‌شده با معیار یالوپ (1997)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soirs suivant la nouvelle lune du %2$@ pour %1$@, calculés selon le critère de Yallop (1997)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечера после новолуния %2$@ для места %1$@, рассчитанные по критерию Яллопа (1997)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@の新月の後の夕方、%1$@で月が見えるかどうかを Yallop（1997）の基準で計算しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 삭 이후 저녁에 %1$@에서 초승달이 보이는지 Yallop(1997) 기준으로 계산했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@新月之后的几个傍晚在%1$@的新月可见度，按 Yallop（1997）判据计算。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga gabi pagkatapos ng bagong buwan ng %2$@ para sa %1$@, kinakalkula gamit ang pamantayan ni Yallop (1997)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่ำหลังจันทร์ดับวันที่ %2$@ สำหรับ%1$@ คำนวณด้วยเกณฑ์ของ Yallop (1997)"
          }
        }
      }
    },
