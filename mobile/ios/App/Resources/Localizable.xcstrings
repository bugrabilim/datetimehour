    "tools.pomodoro.noiseNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses yalnız çalışma süresi işlerken çalar; tarayıcıda üretilir, dosya indirilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound plays only while a work session is running; it is generated in the browser, nothing is downloaded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geräusch läuft nur während einer Arbeitsphase; es wird im Browser erzeugt, nichts wird heruntergeladen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səs yalnız iş müddəti gedərkən çalır; brauzerdə yaradılır, heç nə yüklənmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل الصوت فقط أثناء فترة العمل؛ ويُولَّد في المتصفح دون تنزيل أي ملف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara hanya diputar selama sesi kerja berjalan; suara dibuat di peramban, tidak ada yang diunduh."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آواز صرف کام کے سیشن کے دوران چلتی ہے؛ یہ براؤزر میں بنتی ہے، کچھ ڈاؤن لوڈ نہیں ہوتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدا فقط هنگام جلسهٔ کار پخش می‌شود؛ در مرورگر ساخته می‌شود و چیزی بارگیری نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son n’est diffusé que pendant une séance de travail ; il est généré dans le navigateur, rien n’est téléchargé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук воспроизводится только во время рабочего интервала; он создаётся в браузере, ничего не загружается."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音は作業時間中だけ鳴ります。ブラウザ内で生成されるため、ダウンロードは発生しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 집중 시간에만 재생되며 브라우저에서 만들어져 아무것도 내려받지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音只在工作时段播放；它在浏览器中生成，不会下载任何内容。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumutugtog lang ang tunog habang may tumatakbong sesyon ng trabaho; ginagawa ito sa browser at walang dina-download."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะเล่นเฉพาะขณะอยู่ในช่วงทำงาน สร้างในเบราว์เซอร์และไม่ดาวน์โหลดสิ่งใด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido solo suena mientras hay una sesión de trabajo en marcha; se genera en el navegador y no se descarga nada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O som só toca enquanto uma sessão de trabalho está em andamento; ele é gerado no navegador e nada é baixado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ केवल काम का सत्र चलते समय बजती है; यह ब्राउज़र में बनती है, कुछ डाउनलोड नहीं होता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শব্দটি শুধু কাজের সেশন চলার সময় বাজে; এটি ব্রাউজারেই তৈরি হয়, কিছু নামানো হয় না।"
          }
        }
      }
    },
