          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مقام معلوم نہیں ہو سکا۔ آپ فون کی ترتیبات میں مقام تک رسائی کی اجازت دے سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موقعیت شما به دست نیامد. می‌توانید دسترسی به موقعیت را در تنظیمات گوشی مجاز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’obtenir votre position. Vous pouvez autoriser l’accès à la position dans les réglages du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить местоположение. Доступ к геопозиции можно разрешить в настройках телефона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地を取得できませんでした。スマホの設定で位置情報へのアクセスを許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 가져오지 못했습니다. 휴대폰 설정에서 위치 접근을 허용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取您的位置。您可以在手机设置中允许访问位置。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makuha ang iyong lokasyon. Maaari mong payagan ang access sa lokasyon sa Settings ng iyong telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถหาตำแหน่งของคุณได้ คุณอนุญาตการเข้าถึงตำแหน่งได้ในการตั้งค่าโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener su ubicación. Puede permitir el acceso a la ubicación en los Ajustes del teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter sua localização. Você pode permitir o acesso à localização nos Ajustes do celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका स्थान नहीं मिल सका। फ़ोन की सेटिंग्स में स्थान की अनुमति दे सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অবস্থান পাওয়া যায়নি। ফোনের সেটিংসে অবস্থানের অনুমতি দিতে পারেন।"
          }
        }
      }
    },
