    "dial.newText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "25 kadran: kronograf, pilot, dalgıç, Roma ve Doğu Arap rakamı, İznik çini, geometrik yıldız, ahşap, neon, çocuklar için gökkuşağı ve daha fazlası. Her birinde 5 renk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "25 dials: chronograph, pilot, diver, Roman and Eastern Arabic numerals, İznik tile, geometric star, wood, neon, a rainbow dial for kids and more. 5 colors each."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "25 Zifferblätter: Chronograph, Flieger, Taucheruhr, römische und ostarabische Ziffern, İznik-Fliese, geometrischer Stern, Holz, Neon, Regenbogen für Kinder und mehr. Je 5 Farben."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "25 siferblat: xronoqraf, pilot, dalğıc, Roma və Şərq ərəb rəqəmləri, İznik kaşısı, həndəsi ulduz, taxta, neon, uşaqlar üçün göy qurşağı və daha çoxu. Hər birində 5 rəng."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "25 ميناءً: كرونوغراف، طيار، غواص، أرقام رومانية وعربية مشرقية، قيشاني إزنيق، نجمة هندسية، خشب، نيون، قوس قزح للأطفال والمزيد. لكلٍّ منها 5 ألوان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "25 muka jam: kronograf, pilot, penyelam, angka Romawi dan Arab Timur, ubin İznik, bintang geometris, kayu, neon, pelangi untuk anak-anak, dan lainnya. Masing-masing 5 warna."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "25 ڈائلز: کرونوگراف، پائلٹ، غوطہ خور، رومن اور مشرقی عربی ہندسے، ازنیق ٹائل، ہندسی ستارہ، لکڑی، نیون، بچوں کے لیے قوس قزح اور مزید۔ ہر ایک میں 5 رنگ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "25 صفحه ساعت: کرونوگراف، خلبانی، غواصی، اعداد رومی و عربی شرقی، کاشی ایزنیک، ستاره هندسی، چوب، نئون، رنگین‌کمان برای کودکان و بیشتر. هر کدام 5 رنگ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "25 cadrans : chronographe, aviateur, plongée, chiffres romains et arabes orientaux, céramique d'İznik, étoile géométrique, bois, néon, arc-en-ciel pour les enfants et plus. 5 couleurs chacun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "25 циферблатов: хронограф, пилот, дайверские, римские и восточноарабские цифры, изникская плитка, геометрическая звезда, дерево, неон, радуга для детей и другие. По 5 цветов."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字盤25種: クロノグラフ、パイロット、ダイバー、ローマ数字と東アラビア数字、イズニック・タイル、幾何学の星、木目、ネオン、こども向けの虹など。各5色。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계 판 25종: 크로노그래프, 파일럿, 다이버, 로마·동아랍 숫자, 이즈니크 타일, 기하학 별, 나무, 네온, 어린이용 무지개 등. 각 5가지 색."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "25 款表盘：计时码表、飞行员、潜水、罗马与东阿拉伯数字、伊兹尼克瓷砖、几何星纹、木纹、霓虹、儿童彩虹等。每款 5 种颜色。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "25 dial: chronograph, piloto, diver, Romano at Silangang Arabong numero, tile ng İznik, heometrikong bituin, kahoy, neon, bahaghari para sa mga bata at iba pa. Tig-5 kulay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "25 หน้าปัด: โครโนกราฟ นักบิน นักดำน้ำ เลขโรมันและเลขอารบิกตะวันออก กระเบื้องอิซนิก ดาวเรขาคณิต ไม้ นีออน สายรุ้งสำหรับเด็ก และอื่น ๆ แต่ละแบบมี 5 สี"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "25 esferas: cronógrafo, piloto, buceo, números romanos y arábigos orientales, azulejo de İznik, estrella geométrica, madera, neón, arcoíris para niños y más. 5 colores cada una."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "25 mostradores: cronógrafo, piloto, mergulho, algarismos romanos e arábicos orientais, azulejo de İznik, estrela geométrica, madeira, neon, arco-íris para crianças e mais. 5 cores cada."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "25 डायल: क्रोनोग्राफ़, पायलट, गोताखोर, रोमन और पूर्वी अरबी अंक, इज़्निक टाइल, ज्यामितीय तारा, लकड़ी, नियॉन, बच्चों के लिए इंद्रधनुष और भी बहुत कुछ। हर एक में 5 रंग।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "25টি ডায়াল: ক্রোনোগ্রাফ, পাইলট, ডাইভার, রোমান ও পূর্ব আরবি সংখ্যা, ইজনিক টাইল, জ্যামিতিক তারা, কাঠ, নিয়ন, শিশুদের জন্য রংধনু ডায়াল ও আরও অনেক। প্রতিটিতে 5টি রং।"
          }
        }
      }
    },
    "dial.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadran, uygulamadaki rakamlı analog saatlerde ve tam ekranda kullanılır; renk ibreleri boyar. Widget'lar kendi görünümleriyle klasik kadranda kalır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dial is used by the app's analog clocks with numerals and in full screen; the color tints the hands. Widgets keep the classic dial with their own styles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zifferblatt gilt für die analogen Uhren der App und im Vollbild; die Farbe färbt die Zeiger. Widgets behalten das klassische Zifferblatt in ihrem eigenen Stil."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siferblat tətbiqdəki rəqəmli analoq saatlarda və tam ekranda istifadə olunur; rəng əqrəbləri boyayır. Vidcetlər öz görünüşləri ilə klassik siferblatda qalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم الميناء في الساعات التناظرية ذات الأرقام داخل التطبيق وفي وضع ملء الشاشة؛ ويلوّن اللونُ العقارب. تبقى الأدوات على الميناء الكلاسيكي بأنماطها الخاصة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muka jam dipakai pada jam analog di aplikasi dan layar penuh; warnanya mewarnai jarum. Widget tetap memakai muka klasik dengan gayanya sendiri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈائل ایپ کی اینالاگ گھڑیوں اور پوری اسکرین میں استعمال ہوتا ہے؛ رنگ سوئیوں پر لگتا ہے۔ ویجیٹ اپنے انداز کے ساتھ کلاسیکی ڈائل پر رہتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحه ساعت در ساعت‌های عقربه‌ای برنامه و تمام‌صفحه به کار می‌رود؛ رنگ، عقربه‌ها را رنگ می‌کند. ابزارک‌ها با ظاهر خودشان روی صفحه کلاسیک می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cadran s'applique aux horloges analogiques de l'app et au plein écran ; la couleur teinte les aiguilles. Les widgets gardent le cadran classique avec leur propre style."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Циферблат используется аналоговыми часами приложения и в полноэкранном режиме; цвет окрашивает стрелки. Виджеты сохраняют классический циферблат в своём стиле."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字盤はアプリのアナログ時計と全画面で使われ、色は針に付きます。ウィジェットはそれぞれのスタイルでクラシック文字盤のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계 판은 앱의 아날로그 시계와 전체 화면에 쓰이며 색은 바늘에 적용됩니다. 위젯은 각자의 스타일로 클래식 시계 판을 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表盘用于应用内的指针时钟和全屏；颜色作用于指针。小组件保持各自样式的经典表盘。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit ang dial sa mga analog na orasan ng app at sa full screen; kinukulayan ng kulay ang mga kamay. Nananatili sa klasikong dial ang mga widget sa sarili nilang istilo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าปัดใช้กับนาฬิกาเข็มในแอปและโหมดเต็มจอ สีจะใช้กับเข็ม วิดเจ็ตยังคงเป็นหน้าปัดคลาสสิกตามสไตล์ของตัวเอง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La esfera la usan los relojes analógicos de la app y la pantalla completa; el color tiñe las agujas. Los widgets mantienen la esfera clásica con sus propios estilos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mostrador é usado pelos relógios analógicos do app e na tela cheia; a cor tinge os ponteiros. Os widgets mantêm o mostrador clássico com os próprios estilos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डायल ऐप की एनालॉग घड़ियों और फ़ुल स्क्रीन में इस्तेमाल होता है; रंग सुइयों को रँगता है। विजेट अपनी शैलियों के साथ क्लासिक डायल रखते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপের সংখ্যাযুক্ত অ্যানালগ ঘড়ি ও পূর্ণ পর্দা এই ডায়াল ব্যবহার করে; রং কাঁটাগুলোকে রাঙায়। উইজেট নিজের ধরনের সঙ্গে ক্লাসিক ডায়াল রাখে।"
          }
        }
      }
    },
