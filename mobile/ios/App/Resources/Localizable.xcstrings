          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametrləri aç"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح الإعدادات"
          }
        }
      }
    },
    "google.ready": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim izni açık: Google etkinlikleriniz takvimde görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is on: your Google events appear in the calendar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderzugriff ist aktiv: Ihre Google-Termine erscheinen im Kalender."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təqvim icazəsi açıqdır: Google tədbirləriniz təqvimdə görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى التقويم مفعّل: تظهر أحداث Google في التقويم."
          }
        }
      }
    },
    "google.denied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim izni kapalı. Ayarlar'da bu uygulamanın Takvimler iznini “Tam Erişim” yapın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is off. In Settings, set this app's Calendars permission to “Full Access”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderzugriff ist aus. Stellen Sie in den Einstellungen die Kalender-Berechtigung dieser App auf „Vollzugriff“."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təqvim icazəsi bağlıdır. Parametrlərdə bu tətbiqin Təqvimlər icazəsini “Tam giriş” edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى التقويم متوقف. في الإعدادات اجعل إذن التقويمات لهذا التطبيق «وصول كامل»."
          }
        }
      }
    },
    "google.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni etkinlik eklerken düzenleyicide Google takviminizi seçerseniz etkinlik Google Takvimi'ne de kaydedilir. Outlook ve diğer hesaplar da aynı yolla eklenebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you add an event, pick your Google calendar in the editor and it is saved to Google Calendar too. Outlook and other accounts can be added the same way."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie beim Hinzufügen eines Termins Ihren Google-Kalender wählen, wird er auch im Google Kalender gespeichert. Outlook und andere Konten lassen sich genauso hinzufügen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni tədbir əlavə edərkən redaktorda Google təqviminizi seçsəniz, tədbir Google Təqviminə də yazılır. Outlook və digər hesablar da eyni yolla əlavə edilə bilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إضافة حدث، اختر تقويم Google في المحرر فيُحفظ في تقويم Google أيضًا. يمكن إضافة Outlook والحسابات الأخرى بالطريقة نفسها."
          }
        }
      }
    },
    "google.android.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android telefonlarda Google hesabı genellikle zaten eklidir ve Google Takvimi'ndeki etkinlikler telefonun takvimine gelir. Uygulama Google'a doğrudan bağlanmaz ve şifrenizi görmez; etkinlikleri izninizle telefonun takviminden okur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Android phones your Google account is usually already added, and Google Calendar events sync to the phone's calendar. The app never connects to Google directly or sees your password; it reads events from the phone's calendar with your permission."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Android-Telefonen ist Ihr Google-Konto meist schon eingerichtet, und Termine aus Google Kalender werden mit dem Telefonkalender synchronisiert. Die App verbindet sich nie direkt mit Google und sieht Ihr Passwort nicht; sie liest Termine mit Ihrer Erlaubnis aus dem Telefonkalender."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Android telefonlarda Google hesabı adətən artıq əlavə olunub və Google Təqvimindəki tədbirlər telefonun təqviminə gəlir. Tətbiq Google-a birbaşa qoşulmur və şifrənizi görmür; tədbirləri icazənizlə telefonun təqvimindən oxuyur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على هواتف أندرويد يكون حساب Google مضافًا عادةً، وتُزامَن أحداث تقويم Google مع تقويم الهاتف. لا يتصل التطبيق بـGoogle مباشرةً ولا يرى كلمة مرورك؛ بل يقرأ الأحداث من تقويم الهاتف بإذنك."
          }
        }
      }
    },
    "google.android.step1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun Ayarlar uygulamasını açın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the phone's Settings app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die Einstellungen-App des Telefons."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun Parametrlər tətbiqini açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح تطبيق الإعدادات في الهاتف."
          }
        }
