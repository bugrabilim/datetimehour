    "widget.events.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün ve yarının özel günleri ile telefonunuzdaki takvim etkinlikleri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's and tomorrow's special days and the events in your phone's calendars."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besondere Tage von heute und morgen und Termine aus den Kalendern des Telefons."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu günün və sabahın xüsusi günləri və telefon təqvimindəki tədbirlər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المناسبات الخاصة لليوم والغد وأحداث تقويمات هاتفك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari istimewa hari ini dan besok serta acara di kalender ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج اور کل کے خاص دن اور فون کیلنڈر کی تقریبات۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روزهای ویژهٔ امروز و فردا و رویدادهای تقویم گوشی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours particuliers d'aujourd'hui et de demain et événements des calendriers du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Особые дни сегодня и завтра и события из календарей телефона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日と明日の記念日、スマートフォンのカレンダーの予定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘과 내일의 특별한 날, 휴대폰 캘린더 일정."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今明两天的特殊日子和手机日历中的日程。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga espesyal na araw ngayon at bukas at mga event sa kalendaryo ng telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันสำคัญของวันนี้และพรุ่งนี้ รวมถึงกิจกรรมในปฏิทินของโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días especiales de hoy y mañana y los eventos de los calendarios de su teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas especiais de hoje e amanhã e os eventos dos calendários do seu celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज और कल के विशेष दिन और आपके फ़ोन के कैलेंडरों के इवेंट।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ ও কালের বিশেষ দিন এবং আপনার ফোনের ক্যালেন্ডারের ইভেন্ট।"
          }
        }
      }
    },
