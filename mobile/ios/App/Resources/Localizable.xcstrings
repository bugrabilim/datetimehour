    "notify.all.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat başı dışında her özelliğin bildirimi varsayılan olarak açıktır; istemediklerinizi buradan kapatabilir, saat başını açabilirsiniz. Bildirimler telefonda hazırlanır; yalnız hava özeti için hava servisine sorulur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications for every feature except on-the-hour are on by default; turn off the ones you don't want, or turn on the hourly one, here. Notifications are prepared on your phone; only the weather summary asks the weather service."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind für jede Funktion außer der vollen Stunde standardmäßig an; schalten Sie hier ab, was Sie nicht möchten, oder die volle Stunde ein. Sie werden auf dem Telefon vorbereitet; nur für die Wetterübersicht wird der Wetterdienst abgefragt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat başından başqa hər funksiyanın bildirişi standart olaraq açıqdır; istəmədiklərinizi burada bağlaya, saat başını aça bilərsiniz. Bildirişlər telefonda hazırlanır; yalnız hava xülasəsi üçün hava xidmətinə müraciət olunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعارات كل ميزة مفعّلة افتراضيًا ما عدا إشعار بداية كل ساعة؛ يمكنك هنا إيقاف ما لا تريده أو تفعيل إشعار كل ساعة. تُجهَّز الإشعارات على هاتفك، ولا يُستعلم إلا عن ملخص الطقس من خدمة الطقس."
          }
        }
      }
    },
    "notify.all.limit": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone önceden en çok 64 bildirim kurabilir; liste arka planda ve uygulamayı her açışınızda yenilenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone can schedule at most 64 notifications in advance; the list is refreshed in the background and each time you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone kann höchstens 64 Benachrichtigungen im Voraus planen; die Liste wird im Hintergrund und bei jedem Öffnen der App erneuert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone əvvəlcədən ən çox 64 bildiriş qura bilər; siyahı arxa planda və tətbiqi hər açanda yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لجهاز iPhone جدولة 64 إشعارًا كحد أقصى مسبقًا، وتُحدَّث القائمة في الخلفية وعند كل فتح للتطبيق."
          }
        }
