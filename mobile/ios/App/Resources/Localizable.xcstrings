    "alarm.riseNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm sesi ilk 30 saniyede kısıktan tam sese çıkar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm sound rises from quiet to full volume over the first 30 seconds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Weckton steigt in den ersten 30 Sekunden von leise auf volle Lautstärke an."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəng səsi ilk 30 saniyədə zəifdən tam səsə qalxır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرتفع صوت المنبه من الهادئ إلى أعلى مستوى خلال أول 30 ثانية."
          }
        }
      }
    },
    "alarm.riseNoteIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumuşak bir melodi 20 saniyede kısıktan tam sese çıkar; açıkken iPhone'un alarm sesi yerine çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A soft melody rises from quiet to full volume over 20 seconds; when on, it plays instead of the iPhone alarm sound."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sanfte Melodie steigt in 20 Sekunden von leise auf volle Lautstärke an; wenn aktiv, ersetzt sie den iPhone-Weckton."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumşaq bir melodiya 20 saniyədə zəifdən tam səsə qalxır; açıq olanda iPhone-un zəng səsinin yerinə çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحن هادئ يرتفع من الخافت إلى أعلى مستوى خلال 20 ثانية؛ وعند تفعيله يُشغَّل بدل صوت منبه iPhone."
          }
        }
      }
    },
    "alarm.skipHolidays": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resmî tatillerde çalmasın"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not on public holidays"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht an Feiertagen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rəsmi bayramlarda çalmasın"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرن في العطلات الرسمية"
          }
        }
      }
    },
    "alarm.skipHolidaysNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiye'deki resmî tatillerde (bayramlar dahil) çalmaz; yarım gün arifelerde çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays silent on Turkish public holidays (including the Eids); still rings on half-day eves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt an türkischen gesetzlichen Feiertagen (auch an den Bayram-Festen) still; an halben Vorabend-Tagen klingelt er."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiyədəki rəsmi bayramlarda (bayramlar daxil) çalmır; yarımgünlük bayram ərəfələrində çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرن في العطلات الرسمية في تركيا (ومنها العيدان)؛ ويرن في أيام الوقفة ذات نصف الدوام."
          }
        }
      }
    },
