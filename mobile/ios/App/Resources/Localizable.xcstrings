    "cals.japanese.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Japonya'nın geleneksel günleri, rokuyō (altı günlük uğur döngüsü) ve Reiwa dönemi yılı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traditional Japanese days, rokuyō (the six-day luck cycle) and the Reiwa era year."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Traditionelle japanische Tage, Rokuyō (der sechstägige Glückszyklus) und das Jahr der Reiwa-Ära."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaponiyanın ənənəvi günləri, rokuyō (altı günlük uğur dövrü) və Reiwa dövrünün ili."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأيام اليابانية التقليدية، والروكويو (دورة الحظ ذات الأيام الستة)، وسنة عصر ريوا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari-hari tradisional Jepang, rokuyō (siklus keberuntungan enam hari), dan tahun era Reiwa."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاپان کے روایتی دن، روکویو (چھ دن کا خوش قسمتی کا چکر) اور ریوا دور کا سال۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روزهای سنتی ژاپن، روکویو (چرخهٔ شش‌روزهٔ بخت) و سال دوران ریوا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours traditionnels japonais, le rokuyō (cycle de chance de six jours) et l’année de l’ère Reiwa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Традиционные японские дни, рокуё (шестидневный цикл удачи) и год эпохи Рэйва."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日本の伝統行事・雑節、六曜、令和の年を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일본의 전통 행사와 절기, 로쿠요(6일 길흉 순환), 레이와 연호의 해를 보여 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日本传统节日与杂节、六曜（六日吉凶循环）以及令和年号纪年。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga tradisyonal na araw ng Japan, rokuyō (anim na araw na siklo ng suwerte), at taon ng panahong Reiwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันตามประเพณีญี่ปุ่น โระกุโย (วงจรโชคหกวัน) และปีศักราชเรวะ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días tradicionales japoneses, el rokuyō (ciclo de suerte de seis días) y el año de la era Reiwa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias tradicionais japoneses, o rokuyō (ciclo de sorte de seis dias) e o ano da era Reiwa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जापान के पारंपरिक दिन, रोकुयो (छह दिनों का शुभ-अशुभ चक्र) और रेइवा युग का वर्ष।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রচলিত জাপানি দিন, রোকুইয়ো (ছয় দিনের সৌভাগ্য চক্র) ও রেইওয়া যুগের বছর।"
          }
        }
      }
    },
    "cals.japanese.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rokuyō, Japonya saatiyle (UTC+9) hesaplanan eski ay-güneş takviminden (kyūreki) bulunur. Obon, Tokyo'nun bazı bölgelerinde temmuzda, Okinawa'da eski takvime göre kutlanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rokuyō comes from the old lunisolar calendar (kyūreki), calculated for Japan time (UTC+9). Obon is held in July in parts of Tokyo and by the old calendar in Okinawa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rokuyō ergibt sich aus dem alten Lunisolarkalender (Kyūreki), berechnet nach japanischer Zeit (UTC+9). Obon wird in Teilen Tokios im Juli und auf Okinawa nach dem alten Kalender gefeiert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rokuyō Yaponiya vaxtı ilə (UTC+9) hesablanan köhnə ay-günəş təqvimindən (kyūreki) tapılır. Obon Tokionun bəzi yerlərində iyulda, Okinavada isə köhnə təqvimlə qeyd olunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخرج الروكويو من التقويم القمري الشمسي القديم (كيوريكي) محسوبًا بتوقيت اليابان (UTC+9). ويُحتفل بأوبون في يوليو في أجزاء من طوكيو، وحسب التقويم القديم في أوكيناوا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rokuyō diturunkan dari kalender lunisolar lama (kyūreki) yang dihitung dengan waktu Jepang (UTC+9). Obon dirayakan pada bulan Juli di sebagian Tokyo dan menurut kalender lama di Okinawa."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روکویو پرانے قمری شمسی کیلنڈر (کیوریکی) سے نکالا جاتا ہے جس کا حساب جاپان کے وقت (UTC+9) سے ہوتا ہے۔ اوبون ٹوکیو کے کچھ حصوں میں جولائی میں اور اوکیناوا میں پرانے کیلنڈر کے مطابق منایا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روکویو از تقویم قمری‌خورشیدی قدیم (کیورکی) به وقت ژاپن (UTC+9) به دست می‌آید. اوبون در بخش‌هایی از توکیو در ژوئیه و در اوکیناوا بر پایهٔ تقویم قدیم برگزار می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rokuyō découle de l’ancien calendrier luni-solaire (kyūreki), calculé à l’heure du Japon (UTC+9). Obon est célébré en juillet dans une partie de Tokyo et selon l’ancien calendrier à Okinawa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рокуё выводится из старого лунно-солнечного календаря (кюрэки), рассчитанного по японскому времени (UTC+9). Обон в части Токио отмечают в июле, а на Окинаве — по старому календарю."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "六曜は日本時間（UTC+9）で計算した旧暦から求めています。お盆は東京の一部などでは7月、沖縄では旧暦で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로쿠요는 일본 시간(UTC+9)으로 계산한 옛 음력(규레키)에서 구합니다. 오봉은 도쿄 일부 지역에서는 7월에, 오키나와에서는 음력으로 지냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "六曜由以日本时间（UTC+9）计算的旧历推算。东京部分地区在7月过盂兰盆节，冲绳则按旧历。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinango ang rokuyō sa lumang kalendaryong lunisolar (kyūreki) na kinuwenta sa oras ng Japan (UTC+9). Ipinagdiriwang ang Obon tuwing Hulyo sa ilang bahagi ng Tokyo at ayon sa lumang kalendaryo sa Okinawa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โระกุโยคำนวณจากปฏิทินจันทรคติสุริยคติแบบเก่า (คีวเรกิ) ตามเวลาญี่ปุ่น (UTC+9) ส่วนโอบ้งในบางพื้นที่ของโตเกียวจัดในเดือนกรกฎาคม และในโอกินาวะจัดตามปฏิทินเก่า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rokuyō se obtiene del antiguo calendario lunisolar (kyūreki), calculado en hora de Japón (UTC+9). El Obon se celebra en julio en parte de Tokio y según el antiguo calendario en Okinawa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O rokuyō vem do antigo calendário lunissolar (kyūreki), calculado no horário do Japão (UTC+9). O Obon é celebrado em julho em parte de Tóquio e pelo calendário antigo em Okinawa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोकुयो पुराने चांद्र-सौर कैलेंडर (क्यूरेकी) से निकाला जाता है, जिसकी गणना जापान के समय (UTC+9) से होती है। ओबोन टोक्यो के कुछ हिस्सों में जुलाई में और ओकिनावा में पुराने कैलेंडर के अनुसार मनाया जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রোকুইয়ো পুরোনো চান্দ্র-সৌর ক্যালেন্ডার (কিউরেকি) থেকে আসে, জাপানের সময়ের (UTC+9) জন্য হিসাব করা। টোকিওর কিছু অংশে ওবোন জুলাইয়ে এবং ওকিনাওয়ায় পুরোনো ক্যালেন্ডার অনুযায়ী পালিত হয়।"
          }
        }
      }
    },
