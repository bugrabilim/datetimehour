          "stringUnit": {
            "state": "translated",
            "value": "May your heart be light and your face smiling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möge Ihr Herz leicht und Ihr Gesicht fröhlich sein."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qəlbiniz rahat, üzünüz gülər olsun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دامت قلوبكم مطمئنة ووجوهكم باسمة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga hati Anda lapang dan wajah Anda selalu tersenyum."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا دل شاد اور چہرہ مسکراتا رہے۔"
