    "list.ok": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay e-postası gönderdik; gelen kutunuzdaki bağlantıya tıklayınca listeye katılmış olursunuz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We have sent you a confirmation email; click the link in your inbox to complete joining the list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben Ihnen eine Bestätigungs-E-Mail gesendet; klicken Sie auf den Link darin, um die Anmeldung abzuschließen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizə təsdiq e-məktubu göndərdik; siyahıya qoşulmağı tamamlamaq üçün poçt qutunuzdakı keçidə klikləyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلنا إليك رسالة تأكيد؛ انقر الرابط في بريدك الوارد لإتمام الاشتراك في القائمة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami telah mengirim email konfirmasi; klik tautan di dalamnya untuk menyelesaikan pendaftaran."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم نے آپ کو تصدیقی ای میل بھیج دی ہے؛ فہرست میں شامل ہونے کے لیے اس میں دیے گئے لنک پر کلک کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایمیل تأیید برایتان فرستادیم؛ برای کامل شدن عضویت روی پیوند داخل آن کلیک کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous avons envoyé un e-mail de confirmation ; cliquez sur le lien qu’il contient pour terminer votre inscription."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы отправили вам письмо с подтверждением; перейдите по ссылке в нём, чтобы завершить подписку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認メールを送りました。受信トレイのリンクをクリックすると登録が完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 이메일을 보냈습니다. 받은편지함의 링크를 누르면 구독이 완료됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们已向您发送确认邮件；点击收件箱中的链接即可完成订阅。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagpadala kami ng email para sa kumpirmasyon; i-click ang link sa iyong inbox para matapos ang pagsali sa listahan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราส่งอีเมลยืนยันให้คุณแล้ว คลิกลิงก์ในกล่องจดหมายเพื่อสมัครให้เสร็จ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le hemos enviado un correo de confirmación; pulse el enlace de su bandeja de entrada para terminar de unirse a la lista."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviamos um e-mail de confirmação; clique no link na sua caixa de entrada para concluir a inscrição na lista."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने आपको पुष्टि ईमेल भेजा है; सूची में जुड़ना पूरा करने के लिए अपने इनबॉक्स में लिंक दबाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা আপনাকে একটি নিশ্চিতকরণ ইমেইল পাঠিয়েছি; তালিকায় যোগ দেওয়া শেষ করতে আপনার ইনবক্সের লিংকে চাপুন।"
          }
        }
      }
    },
    "list.err": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydınız alınamadı. E-posta adresini ve onay kutusunu kontrol edip biraz sonra tekrar deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't save your sign-up. Please check the email address and the checkbox, then try again in a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Anmeldung konnte nicht gespeichert werden. Bitte prüfen Sie die E-Mail-Adresse und das Kontrollkästchen und versuchen Sie es gleich noch einmal."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeydiyyatınızı saxlaya bilmədik. E-poçt ünvanını və qeyd xanasını yoxlayıb bir az sonra yenidən cəhd edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ اشتراكك. يُرجى التحقق من عنوان البريد الإلكتروني ومربع الاختيار، ثم المحاولة مرة أخرى بعد قليل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaftaran Anda tidak dapat disimpan. Periksa alamat email dan kotak centang, lalu coba lagi beberapa saat kemudian."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی رکنیت محفوظ نہیں ہو سکی۔ ای میل پتہ اور رضامندی کا خانہ چیک کریں، پھر کچھ دیر بعد دوبارہ کوشش کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عضویت شما ثبت نشد. نشانی ایمیل و کادر تأیید را بررسی کنید و کمی بعد دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre inscription n’a pas pu être enregistrée. Vérifiez l’adresse e-mail et la case à cocher, puis réessayez dans un instant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить подписку. Проверьте адрес и отметку согласия и через минуту попробуйте снова."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録を保存できませんでした。メールアドレスとチェックボックスを確認し、少し後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독을 저장하지 못했습니다. 이메일 주소와 체크박스를 확인한 뒤 잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存您的订阅。请检查电子邮箱和复选框，稍后再试。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi namin ma-save ang iyong pag-sign up. Tingnan ang email address at ang checkbox, saka subukan muli mamaya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการสมัครไม่ได้ โปรดตรวจสอบอีเมลและช่องทำเครื่องหมาย แล้วลองอีกครั้งในอีกสักครู่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos guardar su suscripción. Revise la dirección de correo y la casilla y vuelva a intentarlo en un momento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos salvar sua inscrição. Confira o endereço de e-mail e a caixa de seleção e tente de novo daqui a pouco."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपका साइन-अप सहेज नहीं सके। कृपया ईमेल पता और चेकबॉक्स जाँचें और थोड़ी देर बाद फिर कोशिश करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নিবন্ধন সংরক্ষণ করা যায়নি। ইমেইল ঠিকানা ও চেকবক্স দেখে একটু পরে আবার চেষ্টা করুন।"
          }
        }
      }
    },
