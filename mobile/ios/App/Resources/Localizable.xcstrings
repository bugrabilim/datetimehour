    "notify.reopen": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakit bildirimlerinin sürmesi için uygulamayı açın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app to keep prayer time notifications coming."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die App, damit die Benachrichtigungen weiterlaufen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxt bildirişlərinin davam etməsi üçün tətbiqi açın."
