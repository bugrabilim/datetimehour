        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คาดว่าฝนจะตกราว %1$@ อย่าลืมพกร่ม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se espera lluvia hacia las %1$@; no olvide el paraguas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuva prevista por volta das %1$@; não esqueça o guarda-chuva."
