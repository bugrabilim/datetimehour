    "badges.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozetlerin ve ilerlemen yalnız bu cihazda, sen silene kadar saklanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your badges and progress are stored only on this device until you delete them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Abzeichen und dein Fortschritt werden nur auf diesem Gerät gespeichert, bis du sie löschst."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nişanların və irəliləyişin yalnız bu cihazda, sən silənə qədər saxlanılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ شاراتك وتقدّمك على هذا الجهاز فقط إلى أن تحذفها."
          }
        }
      }
    },
    "badges.deleteText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki bütün rozetlerin ve ilerlemen (gördüğün saat modelleri, kullanım serin) silinir. Geri alınamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your badges and progress on this device (the clock styles you have seen, your streak) will be deleted. This cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle deine Abzeichen und dein Fortschritt auf diesem Gerät (gesehene Uhrstile, deine Serie) werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdakı bütün nişanların və irəliləyişin (gördüyün saat modelləri, istifadə seriyan) silinəcək. Geri qaytarmaq olmur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف كل شاراتك وتقدّمك على هذا الجهاز (أنماط الساعة التي رأيتها وسلسلة استخدامك). لا يمكن التراجع عن ذلك."
          }
        }
      }
    },
