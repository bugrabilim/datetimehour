    "widget.sunArc.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğuştan batışa yay ve 24 saatlik gündüz/gece halkası"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc from sunrise to sunset and a 24-hour day/night ring"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bogen von Sonnenauf- bis -untergang und 24-Stunden-Ring für Tag und Nacht"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğuşdan batışa qövs və 24 saatlıq gündüz/gecə halqası"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوس من الشروق إلى الغروب وحلقة الليل والنهار لـ 24 ساعة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Busur dari terbit hingga terbenam dan cincin siang/malam 24 jam"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "طلوع سے غروب تک قوس اور 24 گھنٹے کا دن/رات حلقہ"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کمان طلوع تا غروب و حلقه 24 ساعته روز و شب"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc du lever au coucher et anneau jour/nuit sur 24 heures"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуга от восхода до заката и 24-часовое кольцо дня и ночи"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日の出から日の入りまでの弧と24時間の昼夜リング"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일출부터 일몰까지의 호와 24시간 낮/밤 링"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日出到日落的弧线和 24 小时昼夜环"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Arko mula pagsikat hanggang paglubog at 24 na oras na singsing ng araw at gabi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนโค้งจากขึ้นถึงตก และวงกลางวัน/กลางคืน 24 ชั่วโมง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arco de la salida a la puesta del sol y un anillo de día/noche de 24 horas"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arco do nascer ao pôr do sol e um anel de dia/noite de 24 horas"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूर्योदय से सूर्यास्त तक का चाप और 24 घंटे का दिन/रात छल्ला"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সূর্যোদয় থেকে সূর্যাস্ত পর্যন্ত বৃত্তচাপ এবং 24 ঘণ্টার দিন/রাত বলয়"
          }
        }
      }
    },
