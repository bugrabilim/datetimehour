        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ विमुखता पर: पूरी रात दिखेगा, साल की सबसे ज़्यादा चमक के साथ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ প্রতিযোগে: সারা রাত দেখা যায়, বছরের সবচেয়ে উজ্জ্বল"
