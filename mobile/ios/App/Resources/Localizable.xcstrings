    "sunpath.now": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an: %1$@° yükseklik, %2$@ yönünde (%3$@°)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now: %1$@° high, toward %2$@ (%3$@°)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt: %1$@° hoch, Richtung %2$@ (%3$@°)"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İndi: %1$@° hündürlük, %2$@ istiqamətində (%3$@°)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن: ارتفاع %1$@°، باتجاه %2$@ (%3$@°)"
          }
        },
        "id": {
