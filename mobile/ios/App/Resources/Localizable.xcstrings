    "account.deleteLead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız hemen ve kalıcı olarak silinir. Arkadaki işlemler (önceden gönderime bırakılmış bir kutlama e-postası gibi) en geç 7 gün içinde tamamlanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is deleted immediately and permanently. Background steps (such as a celebration email already scheduled) are completed within 7 days at the latest."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto wird sofort und endgültig gelöscht. Hintergrundschritte (etwa eine bereits geplante Glückwunsch-E-Mail) sind spätestens nach 7 Tagen abgeschlossen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız dərhal və birdəfəlik silinir. Arxa plandakı işlər (əvvəlcədən göndərişə qoyulmuş təbrik e-poçtu kimi) ən gec 7 gün ərzində tamamlanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحذف حسابك فورًا ونهائيًا. تكتمل الخطوات الخلفية (مثل رسالة تهنئة مجدولة مسبقًا) خلال 7 أيام على الأكثر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun Anda dihapus segera dan permanen. Langkah di latar belakang (seperti email ucapan yang sudah dijadwalkan) selesai paling lambat dalam 7 hari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا اکاؤنٹ فوراً اور مستقل طور پر حذف ہو جاتا ہے۔ پس منظر کے کام (جیسے پہلے سے طے شدہ مبارکباد ای میل) زیادہ سے زیادہ 7 دن میں مکمل ہوتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب شما بی‌درنگ و برای همیشه پاک می‌شود. کارهای پس‌زمینه (مانند ایمیل تبریکی که از پیش زمان‌بندی شده) حداکثر ظرف 7 روز تمام می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte est supprimé immédiatement et définitivement. Les étapes en arrière-plan (comme un e-mail de vœux déjà programmé) s'achèvent au plus tard en 7 jours."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт удаляется сразу и безвозвратно. Фоновые действия (например, уже запланированное поздравительное письмо) завершаются не позднее чем через 7 дней."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントはすぐに完全に削除されます。裏側の処理（予約済みのお祝いメールなど）は遅くとも7日以内に終わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정은 즉시 영구적으로 삭제됩니다. 백그라운드 작업(이미 예약된 축하 이메일 등)은 늦어도 7일 안에 끝납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的账户会立即永久删除。后台步骤（如已预定发送的祝贺邮件）最迟在 7 天内完成。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Agad at permanenteng mabubura ang inyong account. Matatapos ang mga hakbang sa background (gaya ng naka-iskedyul nang email ng pagbati) sa loob ng 7 araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีของคุณจะถูกลบทันทีและถาวร ขั้นตอนเบื้องหลัง (เช่น อีเมลแสดงความยินดีที่ตั้งเวลาไว้แล้ว) จะเสร็จภายใน 7 วัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cuenta se borra de inmediato y para siempre. Los pasos en segundo plano (como un correo de felicitación ya programado) terminan en 7 días como máximo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta é apagada na hora e para sempre. As etapas em segundo plano (como um e-mail de felicitação já agendado) terminam em até 7 dias."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका खाता तुरंत और हमेशा के लिए मिटा दिया जाता है। पृष्ठभूमि के काम (जैसे पहले से तय बधाई ईमेल) ज़्यादा से ज़्यादा 7 दिन में पूरे होते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাকাউন্ট সঙ্গে সঙ্গে স্থায়ীভাবে মুছে যায়। পেছনের কাজগুলো (যেমন আগে থেকে নির্ধারিত শুভেচ্ছা ইমেইল) সর্বোচ্চ 7 দিনের মধ্যে শেষ হয়।"
          }
        }
      }
    },
