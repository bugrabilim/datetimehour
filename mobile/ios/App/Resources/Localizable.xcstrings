    "countdowns.empty": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz geri sayım yok. Doğum günü, tatil, sınav… eklemek için + düğmesine dokunun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No countdowns yet. Tap + to add a birthday, holiday, exam…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Countdowns. Tippen Sie auf +, um Geburtstag, Urlaub, Prüfung … hinzuzufügen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
