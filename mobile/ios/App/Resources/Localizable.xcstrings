    "notify.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler seçili ilin vakitlerine göre telefonda hazırlanır, internet gerekmez. Liste uygulamayı her açışınızda yenilenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are prepared on your phone from the selected province's times; no internet needed. The list is renewed each time you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Benachrichtigungen werden auf Ihrem Telefon aus den Zeiten der gewählten Provinz erstellt, ohne Internet. Die Liste wird bei jedem Öffnen der App erneuert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirişlər seçilmiş vilayətin vaxtlarına görə telefonda hazırlanır, internet lazım deyil. Siyahı tətbiqi hər açanda yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُجهَّز الإشعارات على هاتفك وفق أوقات الولاية المختارة دون الحاجة إلى الإنترنت، وتتجدد القائمة كلما فتحت التطبيق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi disiapkan di ponsel Anda dari jadwal provinsi pilihan; tidak perlu internet. Daftarnya diperbarui setiap kali aplikasi dibuka."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات آپ کے فون پر منتخب صوبے کے اوقات سے تیار ہوتی ہیں؛ انٹرنیٹ کی ضرورت نہیں۔ ہر بار ایپ کھولنے پر فہرست تازہ ہوتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلان‌ها روی گوشی شما از اوقات استان انتخابی آماده می‌شوند؛ اینترنت لازم نیست. فهرست با هر بار باز کردن برنامه تازه می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont préparées sur votre téléphone à partir des heures de la province choisie ; aucune connexion n’est nécessaire. La liste est renouvelée à chaque ouverture de l’application."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления готовятся на телефоне по времени намаза для выбранной провинции; интернет не нужен. Список обновляется при каждом открытии приложения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は選んだ県の時刻をもとにスマホ上で準備されます。インターネットは不要です。アプリを開くたびに一覧が更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 선택한 주의 시간으로 휴대폰에서 준비되며 인터넷이 필요 없습니다. 앱을 열 때마다 목록이 갱신됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知根据所选省份的时间在手机上生成，无需联网。每次打开应用都会更新列表。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Inihahanda sa iyong telepono ang mga abiso mula sa oras ng napiling lalawigan; hindi kailangan ng internet. Nire-refresh ang listahan tuwing bubuksan mo ang app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนจัดเตรียมบนโทรศัพท์ของคุณตามเวลาของจังหวัดที่เลือก ไม่ต้องใช้อินเทอร์เน็ต รายการจะอัปเดตใหม่ทุกครั้งที่เปิดแอป"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones se preparan en su teléfono con los horarios de la provincia elegida; no hace falta internet. La lista se renueva cada vez que abre la app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações são preparadas no seu celular com os horários da província escolhida; não precisa de internet. A lista é renovada cada vez que você abre o app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ चुने प्रांत के समय से आपके फ़ोन पर ही बनती हैं; इंटरनेट की ज़रूरत नहीं। हर बार ऐप खोलने पर सूची नई हो जाती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটিফিকেশনগুলো বেছে নেওয়া প্রদেশের সময় থেকে আপনার ফোনেই তৈরি হয়; ইন্টারনেট লাগে না। প্রতিবার অ্যাপ খুললে তালিকা নতুন হয়।"
          }
        }
      }
    },
