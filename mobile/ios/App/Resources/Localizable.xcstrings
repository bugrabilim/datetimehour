    "countdowns.photoNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf yalnız bu telefonda saklanır, geri sayım kartının arkasında gösterilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is kept only on this phone and shown behind the countdown card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto bleibt nur auf diesem Telefon und erscheint hinter der Countdown-Karte."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto yalnız bu telefonda saxlanılır, geri sayım kartının arxasında göstərilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الصورة على هذا الهاتف فقط وتظهر خلف بطاقة العدّ التنازلي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto hanya disimpan di ponsel ini dan ditampilkan di belakang kartu hitung mundur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر صرف اسی فون پر رہتی ہے اور الٹی گنتی کے کارڈ کے پیچھے دکھائی دیتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکس فقط روی همین گوشی می‌ماند و پشت کارت شمارش معکوس نمایش داده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo reste uniquement sur ce téléphone et s’affiche derrière la carte du compte à rebours."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото хранится только на этом телефоне и показывается за карточкой отсчёта."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はこのスマホにだけ保存され、カウントダウンのカードの後ろに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 이 휴대폰에만 저장되며 카운트다운 카드 뒤에 보입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片只保存在这部手机上，显示在倒计时卡片后面。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa teleponong ito lang nakatago ang larawan at ipinapakita ito sa likod ng card ng countdown."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพเก็บไว้ในโทรศัพท์นี้เท่านั้น และแสดงด้านหลังการ์ดนับถอยหลัง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto se guarda solo en este teléfono y se muestra detrás de la tarjeta de la cuenta atrás."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto fica só neste celular e aparece atrás do cartão da contagem regressiva."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो केवल इसी फ़ोन पर रहती है और काउंटडाउन कार्ड के पीछे दिखती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিটি শুধু এই ফোনে থাকে এবং কাউন্টডাউন কার্ডের পেছনে দেখানো হয়।"
          }
        }
      }
    },
