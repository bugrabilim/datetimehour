    "list.popupTitle": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta listesi aydınlatma metni"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email list privacy notice"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutzhinweis zur E-Mail-Liste"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poçt siyahısı üzrə məlumatlandırma mətni"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار الخصوصية للقائمة البريدية"
          }
        }
      }
    },
    "list.popupText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta adresiniz, yalnızca bu listeye abone edilmeniz için Bumba Teknoloji Limited Şirketi tarafından işlenir. İstediğiniz zaman tek tıkla ayrılabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email address is processed by Bumba Teknoloji Limited Şirketi only to subscribe you to this list. You can unsubscribe at any time with one click."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre E-Mail-Adresse wird von Bumba Teknoloji Limited Şirketi ausschließlich verarbeitet, um Sie in diese Liste einzutragen. Sie können sich jederzeit mit einem Klick abmelden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poçt ünvanınız yalnız bu siyahıya abunə olmağınız üçün Bumba Teknoloji Limited Şirketi tərəfindən emal olunur. İstədiyiniz vaxt bir kliklə ayrıla bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعالج شركة Bumba Teknoloji Limited Şirketi عنوان بريدك الإلكتروني فقط لاشتراكك في هذه القائمة. يمكنك إلغاء الاشتراك في أي وقت بنقرة واحدة."
          }
        }
      }
    },
    "list.readNote": {
      "extractionState": "manual",
