    "account.intro": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üyelik isteğe bağlıdır; Saat Tarih'in her özelliği hesapsız çalışır. Hesapla rozetleriniz ve kayıtlarınız bütün cihazlarınızda görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Membership is optional; every Saat Tarih feature works without an account. With an account, your badges and records show up on all your devices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitgliedschaft ist freiwillig; jede Funktion von Saat Tarih funktioniert ohne Konto. Mit einem Konto erscheinen Ihre Abzeichen und Einträge auf all Ihren Geräten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzvlük könüllüdür; Saat Tarix-in hər funksiyası hesabsız işləyir. Hesabla nişanlarınız və qeydləriniz bütün cihazlarınızda görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العضوية اختيارية؛ كل ميزات Saat Tarih تعمل بلا حساب. مع الحساب تظهر شاراتك وسجلاتك على جميع أجهزتك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keanggotaan bersifat opsional; semua fitur Saat Tarih berjalan tanpa akun. Dengan akun, lencana dan catatan Anda tampil di semua perangkat Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رکنیت اختیاری ہے؛ Saat Tarih کی ہر سہولت اکاؤنٹ کے بغیر چلتی ہے۔ اکاؤنٹ سے آپ کے بیج اور ریکارڈ آپ کے تمام آلات پر نظر آتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عضویت اختیاری است؛ همهٔ امکانات Saat Tarih بدون حساب کار می‌کند. با حساب، نشان‌ها و ثبت‌های شما در همهٔ دستگاه‌هایتان دیده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adhésion est facultative ; toutes les fonctions de Saat Tarih marchent sans compte. Avec un compte, vos badges et vos données s'affichent sur tous vos appareils."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Членство необязательно: все функции Saat Tarih работают без аккаунта. С аккаунтом ваши значки и записи видны на всех ваших устройствах."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会員登録は任意です。Saat Tarih のすべての機能はアカウントなしで使えます。アカウントがあると、バッジや記録がすべての端末に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회원 가입은 선택입니다. Saat Tarih의 모든 기능은 계정 없이도 작동합니다. 계정이 있으면 배지와 기록이 모든 기기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册会员是自愿的；Saat Tarih 的所有功能无需账户即可使用。有了账户，您的徽章和记录会显示在您的所有设备上。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsyonal ang membership; gumagana ang bawat feature ng Saat Tarih kahit walang account. Kapag may account kayo, makikita ninyo ang inyong mga badge at record sa lahat ng inyong device."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเป็นสมาชิกเป็นทางเลือก ทุกฟีเจอร์ของ Saat Tarih ใช้ได้โดยไม่ต้องมีบัญชี เมื่อมีบัญชี เหรียญตราและบันทึกของคุณจะแสดงในทุกอุปกรณ์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser miembro es opcional; todas las funciones de Saat Tarih funcionan sin cuenta. Con una cuenta, sus insignias y registros aparecen en todos sus dispositivos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser membro é opcional; todos os recursos do Saat Tarih funcionam sem conta. Com uma conta, seus selos e registros aparecem em todos os seus aparelhos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यता वैकल्पिक है; Saat Tarih की हर सुविधा बिना खाते के चलती है। खाते के साथ आपके बैज और रिकॉर्ड आपके सभी डिवाइस पर दिखते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সদস্যপদ ঐচ্ছিক; Saat Tarih-এর প্রতিটি সুবিধা অ্যাকাউন্ট ছাড়াই চলে। অ্যাকাউন্ট থাকলে আপনার ব্যাজ ও রেকর্ড আপনার সব ডিভাইসে দেখা যায়।"
          }
        }
      }
    },
