    "kidsmoon.q5": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuzey yarımkürede büyüyen hilalin hangi yanı aydınlıktır?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the northern hemisphere, which side of a growing crescent is lit?"
          }
        },
