            "state": "translated",
            "value": "أدخل سعر غرام الذهب لحساب النصاب."
          }
        }
      }
    },
    "zakat.due": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlığınız nisaba ulaşıyor; zekât düşer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your wealth reaches the nisab; zakat is due."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Vermögen erreicht den Nisab; Zakat ist fällig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlığınız nisaba çatır; zəkat düşür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مالك يبلغ النصاب؛ تجب الزكاة."
          }
        }
      }
    },
    "zakat.notDue": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlığınız nisabın altında; zekât düşmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your wealth is below the nisab; no zakat is due."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Vermögen liegt unter dem Nisab; keine Zakat fällig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlığınız nisabdan aşağıdır; zəkat düşmür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مالك دون النصاب؛ لا تجب الزكاة."
          }
        }
      }
    },
