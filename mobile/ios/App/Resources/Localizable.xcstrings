    "onboard.tour.weather.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatlik ve günlük tahmin, hava kalitesi; ekran havaya göre canlanır. Ay takvimi, tutulmalar, mevsimler ve gece gökyüzü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hourly and daily forecasts and air quality; the screen comes alive with the weather. Moon calendar, eclipses, seasons and the night sky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stündliche und tägliche Vorhersage, Luftqualität; der Bildschirm verändert sich mit dem Wetter. Mondkalender, Finsternisse, Jahreszeiten und Nachthimmel."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatlıq və günlük proqnoz, havanın keyfiyyəti; ekran havaya görə canlanır. Ay təqvimi, tutulmalar, fəsillər və gecə səması."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقعات كل ساعة وكل يوم وجودة الهواء، وشاشة تتغير مع الطقس. التقويم القمري والكسوف والخسوف والفصول وسماء الليل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prakiraan per jam dan harian, kualitas udara; layar ikut hidup sesuai cuaca. Kalender bulan, gerhana, musim, dan langit malam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھنٹہ وار اور روزانہ پیش گوئی، ہوا کا معیار؛ اسکرین موسم کے ساتھ بدلتی ہے۔ چاند کا کیلنڈر، گرہن، موسم اور رات کا آسمان۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌بینی ساعتی و روزانه، کیفیت هوا؛ صفحه با هوا جان می‌گیرد. تقویم ماه، گرفت‌ها، فصل‌ها و آسمان شب."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévisions heure par heure et jour par jour, qualité de l'air ; l'écran s'anime avec la météo. Calendrier lunaire, éclipses, saisons et ciel nocturne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почасовой и дневной прогноз, качество воздуха; экран оживает вместе с погодой. Лунный календарь, затмения, времена года и ночное небо."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1時間ごと・毎日の予報と大気質。天気に合わせて画面が変わります。月のカレンダー、日食と月食、季節、夜空も。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간별·일별 예보와 대기질, 날씨에 따라 화면이 살아나요. 달 달력, 일식과 월식, 계절, 밤하늘도 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐小时与每日预报、空气质量，屏幕随天气而变化。还有月历、日食与月食、季节和夜空。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Oras-oras at araw-araw na forecast at kalidad ng hangin; sumasabay sa panahon ang screen. Kalendaryo ng buwan, eklipse, mga season at langit sa gabi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พยากรณ์รายชั่วโมงและรายวัน คุณภาพอากาศ หน้าจอเปลี่ยนตามสภาพอากาศ ปฏิทินดวงจันทร์ สุริยุปราคาและจันทรุปราคา ฤดูกาล และท้องฟ้ายามค่ำคืน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronóstico por horas y por días y calidad del aire; la pantalla cobra vida con el tiempo. Calendario lunar, eclipses, estaciones y cielo nocturno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsão por hora e por dia e qualidade do ar; a tela ganha vida com o clima. Calendário lunar, eclipses, estações e céu noturno."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घंटेवार और रोज़ाना पूर्वानुमान, हवा की गुणवत्ता; स्क्रीन मौसम के साथ बदलती है। चंद्र कैलेंडर, ग्रहण, ऋतुएँ और रात का आसमान।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘণ্টাভিত্তিক ও দৈনিক পূর্বাভাস এবং বাতাসের মান; আবহাওয়ার সঙ্গে পর্দা জীবন্ত হয়ে ওঠে। চাঁদের ক্যালেন্ডার, গ্রহণ, ঋতু ও রাতের আকাশ।"
          }
        }
      }
    },
