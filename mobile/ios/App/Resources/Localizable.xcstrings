    "tools.pomodoro.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro Zamanlayıcı: 25 Dakika Çalış, 5 Dakika Mola | Saat Tarih"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro Timer: Work 25 Minutes, Break 5 | Saat Tarih"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro-Timer: 25 Minuten Arbeit, 5 Minuten Pause | Saat Tarih"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro taymeri: 25 dəqiqə iş, 5 dəqiqə fasilə | Saat Tarih"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مؤقت بومودورو: 25 دقيقة عمل و5 دقائق راحة | Saat Tarih"
          }
        }
      }
    },
    "tools.pomodoro.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz pomodoro zamanlayıcı: 25 dakika çalışma, 5 dakika kısa mola, 4 turda bir uzun mola. Süreler ayarlanabilir, sesli uyarı ve tam ekran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free pomodoro timer: 25 minutes of work, a 5-minute short break and a long break every 4 rounds. Adjustable times, sound alerts and full screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenloser Pomodoro-Timer: 25 Minuten Arbeit, 5 Minuten kurze Pause und alle 4 Runden eine lange Pause. Anpassbare Zeiten, Tonsignal und Vollbild."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsuz pomodoro taymeri: 25 dəqiqə iş, 5 dəqiqəlik qısa fasilə və hər 4 dövrdən sonra uzun fasilə. Dəyişən müddətlər, səsli xəbərdarlıq, tam ekran."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مؤقت بومودورو مجاني: 25 دقيقة عمل، واستراحة قصيرة 5 دقائق، واستراحة طويلة كل 4 جولات. مدد قابلة للتعديل وتنبيهات صوتية وملء الشاشة."
          }
        }
      }
    },
    "tools.pomodoro.h1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro zamanlayıcı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro timer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro-Timer"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro taymeri"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مؤقت بومودورو"
          }
        }
      }
    },
    "tools.pomodoro.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro tekniği, 25 dakikalık odaklı çalışma ile 5 dakikalık kısa molaları art arda uygular; 4 turun ardından uzun mola verilir. Süreler değiştirilebilir, geçişlerde sesli uyarı çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pomodoro technique alternates 25 minutes of focused work with 5-minute short breaks, followed by a long break after 4 rounds. The times can be changed and a sound plays at each switch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Pomodoro-Technik wechseln sich 25 Minuten konzentrierte Arbeit und 5-minütige kurze Pausen ab; nach 4 Runden folgt eine lange Pause. Die Zeiten lassen sich ändern, und bei jedem Wechsel ertönt ein Ton."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro texnikası 25 dəqiqəlik diqqətli işi 5 dəqiqəlik qısa fasilələrlə növbələşdirir, 4 dövrdən sonra isə uzun fasilə verilir. Müddətləri dəyişmək olar və hər keçiddə səs çalınır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقوم تقنية بومودورو على التناوب بين 25 دقيقة من العمل المركّز واستراحات قصيرة مدتها 5 دقائق، تليها استراحة طويلة بعد 4 جولات. ويمكن تغيير المدد، ويُشغَّل صوت عند كل انتقال."
          }
        }
      }
    },
    "tools.pomodoro.work": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
