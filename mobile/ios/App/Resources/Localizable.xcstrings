        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Junio debe su nombre a Juno, reina de los dioses romanos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Junho deve seu nome a Juno, rainha dos deuses romanos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जून का नाम रोमन देवताओं की रानी जूनो के नाम पर है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জুনের নাম রোমান দেবতাদের রানি জুনোর নামে।"
          }
        }
      }
