        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้แถบเลื่อนเพื่อเลือกว่าจะเล่นช่วง 30 วินาทีใดของเพลง หากเปิดค่อย ๆ ดังขึ้น ช่วงนั้นจะเริ่มเบา ๆ"
          }
        }
      }
    },
