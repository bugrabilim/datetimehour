    "atmo.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün uygulamanın zemini renk geçişiyle boyanır; düğme ve vurgu rengi aşağıdaki uygulama renginden gelir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paints the background of the whole app with a gradient; buttons and highlights keep the app color chosen below."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt den Hintergrund der ganzen App mit einem Verlauf; Schaltflächen und Akzente behalten die unten gewählte App-Farbe."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün tətbiqin fonu rəng keçidi ilə boyanır; düymələr və vurğular aşağıda seçilən tətbiq rəngini saxlayır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلوّن خلفية التطبيق كله بتدرّج لوني، وتبقى الأزرار والإبرازات بلون التطبيق المختار أدناه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mewarnai latar seluruh aplikasi dengan gradasi; tombol dan sorotan tetap memakai warna aplikasi yang dipilih di bawah."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوری ایپ کا پس منظر رنگوں کی ملاوٹ سے رنگ دیتا ہے؛ بٹن اور نمایاں حصے نیچے منتخب ایپ کا رنگ رکھتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس‌زمینه کل برنامه را با یک طیف رنگی رنگ می‌کند؛ دکمه‌ها و تأکیدها رنگ برنامه‌ای را که پایین‌تر انتخاب می‌کنید نگه می‌دارند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore le fond de toute l'application d'un dégradé ; les boutons et les accents gardent la couleur de l'application choisie plus bas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окрашивает фон всего приложения градиентом; кнопки и акценты сохраняют цвет приложения, выбранный ниже."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ全体の背景をグラデーションで彩ります。ボタンや強調色は下で選ぶアプリカラーのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 전체 배경을 그라데이션으로 칠합니다. 버튼과 강조색은 아래에서 고른 앱 색상을 따릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用渐变色铺满整个应用的背景；按钮和强调色仍使用下方选择的应用颜色。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinukulayan ng gradient ang background ng buong app; nananatili sa kulay ng app na pipiliin sa ibaba ang mga button at highlight."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบายพื้นหลังของทั้งแอปด้วยไล่สี ส่วนปุ่มและสีเน้นยังใช้สีแอปที่เลือกด้านล่าง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta el fondo de toda la app con un degradado; los botones y los resaltados conservan el color de la app elegido abajo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta o fundo de todo o app com um degradê; os botões e destaques mantêm a cor do app escolhida abaixo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे ऐप की पृष्ठभूमि को ग्रेडिएंट से रँगता है; बटन और उभरे हिस्से नीचे चुना ऐप का रंग रखते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুরো অ্যাপের পটভূমি একটি রঙের মিশ্রণে রাঙায়; বোতাম ও হাইলাইট নিচে বাছা অ্যাপের রং রাখে।"
          }
        }
      }
    },
