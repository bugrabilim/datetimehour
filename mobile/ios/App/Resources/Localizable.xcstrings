    "notify.reopen": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakit bildirimlerinin sürmesi için uygulamayı açın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app to keep prayer time notifications coming."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die App, damit die Benachrichtigungen weiterlaufen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxt bildirişlərinin davam etməsi üçün tətbiqi açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح التطبيق لتستمر إشعارات أوقات الصلاة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka aplikasi agar notifikasi waktu salat tetap muncul."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقاتِ نماز کی اطلاعات جاری رکھنے کے لیے ایپ کھولیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ادامهٔ اعلان‌های اوقات شرعی، برنامه را باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’application pour continuer à recevoir les notifications des heures de prière."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение, чтобы уведомления о времени намаза продолжали приходить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拝時刻の通知を続けて受け取るにはアプリを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도 시간 알림을 계속 받으려면 앱을 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开应用，以继续接收礼拜时间通知。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang app para patuloy na makatanggap ng abiso sa oras ng dasal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแอปเพื่อรับการแจ้งเตือนเวลาละหมาดต่อไป"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra la app para seguir recibiendo notificaciones de los horarios de oración."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o app para continuar recebendo as notificações dos horários de oração."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमाज़ के समय की सूचनाएँ मिलती रहें, इसके लिए ऐप खोलें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজের সময়ের নোটিফিকেশন চালু রাখতে অ্যাপটি খুলুন।"
          }
        }
      }
    },
    "notify.denied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim izni kapalı. Ayarlar'dan bu uygulama için bildirimlere izin verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off. Allow notifications for this app in Settings."
          }
