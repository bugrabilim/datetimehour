    "planner.noCommon": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili şehirlerde ortak mesai saati yok; en az uygun saatleri çizelgeden seçebilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected cities have no overlapping working hours; pick the least inconvenient hours from the timeline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewählten Städte haben keine gemeinsamen Arbeitszeiten; wählen Sie anhand der Zeitleiste die am wenigsten ungünstigen Stunden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş şəhərlərin ortaq iş saatları yoxdur; zaman xəttindən ən az narahatlıq yaradan saatları seçin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد ساعات عمل مشتركة بين المدن المختارة؛ اختر أقل الساعات إزعاجًا من الخط الزمني."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kota-kota pilihan tidak memiliki jam kerja yang bertepatan; pilih jam yang paling tidak merepotkan dari garis waktu."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب شہروں کے درمیان کام کے کوئی مشترکہ اوقات نہیں؛ ٹائم لائن سے سب سے کم تکلیف دہ اوقات چنیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شهرهای انتخابی ساعت کاری مشترکی ندارند؛ کم‌دردسرترین ساعت‌ها را از خط زمانی انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les villes choisies n’ont pas d’heures de travail communes ; choisissez sur la frise les heures les moins gênantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У выбранных городов нет общих рабочих часов; выберите на шкале наименее неудобное время."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ都市に重なる勤務時間はありません。タイムラインから負担の少ない時間を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 도시들 사이에 겹치는 근무 시간이 없습니다. 타임라인에서 가장 무리가 적은 시간을 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选城市没有重叠的工作时间；请从时间轴中选择相对最合适的时段。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang sabayang oras ng trabaho ang mga napiling lungsod; piliin sa timeline ang mga oras na hindi gaanong abala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมืองที่เลือกไม่มีเวลาทำงานที่ตรงกัน เลือกช่วงที่ไม่สะดวกน้อยที่สุดจากเส้นเวลา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ciudades elegidas no tienen horas de trabajo en común; elija en la línea horaria las horas menos incómodas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As cidades escolhidas não têm horário de trabalho em comum; escolha na linha do tempo os horários menos incômodos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने शहरों में कोई साझा कामकाजी घंटा नहीं है; टाइमलाइन से सबसे कम असुविधाजनक घंटे चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেছে নেওয়া শহরগুলোর কোনো মিলে যাওয়া কর্মঘণ্টা নেই; সময়রেখা থেকে সবচেয়ে কম অসুবিধার ঘণ্টা বেছে নিন।"
          }
        }
      }
    },
