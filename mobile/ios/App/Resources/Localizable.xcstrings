    "dua.ramadanNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün Kur'an'daki dualardan biri sırayla gösterilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each day shows one of the Quranic supplications in turn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Tag wird der Reihe nach eines der koranischen Bittgebete gezeigt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər gün Qurandakı dualardan biri növbə ilə göstərilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعرض كل يوم أحد الأدعية القرآنية بالتناوب."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap hari ditampilkan salah satu doa dari Al-Qur'an secara bergiliran."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر روز قرآنی دعاؤں میں سے ایک باری باری دکھائی جاتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر روز یکی از دعاهای قرآنی به نوبت نمایش داده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour, l’une des invocations coraniques est présentée à tour de rôle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый день по очереди показывается одно из коранических дуа."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日、クルアーンの祈りの一つを順番に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 꾸란의 기도문을 하나씩 차례로 보여 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天依次显示一段出自古兰经的祈祷词。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Araw-araw, isa sa mga panalangin mula sa Quran ang ipinapakita nang salitan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละวันจะแสดงดุอาอ์จากอัลกุรอานหนึ่งบทตามลำดับ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día muestra por turno una de las súplicas coránicas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada dia, uma das súplicas do Alcorão é mostrada, em sequência."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन बारी-बारी से क़ुरआन की एक दुआ दिखाई जाती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিদিন পালাক্রমে কুরআনের একটি দোয়া দেখানো হয়।"
          }
        }
      }
    },
