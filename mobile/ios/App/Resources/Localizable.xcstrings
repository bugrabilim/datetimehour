          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o app Configurações do celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन का सेटिंग्स ऐप खोलें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোনের সেটিংস অ্যাপ খুলুন।"
          }
        }
      }
    },
    "google.android.step2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplar (ya da Şifreler ve hesaplar) bölümüne girin; Google hesabınız yoksa Hesap ekle › Google ile giriş yapın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Accounts (or Passwords & accounts); if your Google account is not there, tap Add account › Google and sign in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie zu Konten (oder Passwörter & Konten); fehlt Ihr Google-Konto, tippen Sie auf Konto hinzufügen › Google und melden Sie sich an."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesablar (və ya Şifrələr və hesablar) bölməsinə keçin; Google hesabınız yoxdursa, Hesab əlavə et › Google ilə daxil olun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادخل إلى الحسابات (أو كلمات المرور والحسابات)؛ وإن لم يكن حساب Google موجودًا فاضغط إضافة حساب › Google وسجّل الدخول."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Akun (atau Sandi & akun); jika akun Google Anda tidak ada, ketuk Tambahkan akun › Google lalu masuk."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹس (یا پاس ورڈز اور اکاؤنٹس) میں جائیں؛ اگر آپ کا گوگل اکاؤنٹ وہاں نہیں تو اکاؤنٹ شامل کریں › Google پر ٹیپ کر کے سائن ان کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به حساب‌ها (یا گذرواژه‌ها و حساب‌ها) بروید؛ اگر حساب گوگل شما نیست، افزودن حساب › Google را بزنید و وارد شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans Comptes (ou Mots de passe et comptes) ; si votre compte Google n’y est pas, touchez Ajouter un compte › Google et connectez-vous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите в «Аккаунты» (или «Пароли и аккаунты»); если аккаунта Google там нет, нажмите «Добавить аккаунт» › Google и войдите."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント（またはパスワードとアカウント）へ進みます。Googleアカウントがなければ、アカウントを追加 › Google をタップしてサインインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정(또는 비밀번호 및 계정)으로 갑니다. Google 계정이 없으면 계정 추가 › Google을 눌러 로그인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往“账号”（或“密码和账号”）；如果没有Google账号，轻点 添加账号 › Google 并登录。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumunta sa Accounts (o Passwords & accounts); kung wala roon ang iyong Google account, i-tap ang Add account › Google at mag-sign in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปที่ บัญชี (หรือ รหัสผ่านและบัญชี) หากไม่มีบัญชี Google ให้แตะ เพิ่มบัญชี › Google แล้วลงชื่อเข้าใช้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaya a Cuentas (o Contraseñas y cuentas); si su cuenta de Google no está, toque Añadir cuenta › Google e inicie sesión."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá em Contas (ou Senhas e contas); se sua conta do Google não estiver lá, toque em Adicionar conta › Google e entre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते (या पासवर्ड और खाते) पर जाएँ; अगर आपका Google खाता वहाँ नहीं है, तो खाता जोड़ें › Google दबाकर साइन इन करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্টে (বা পাসওয়ার্ড ও অ্যাকাউন্টে) যান; আপনার Google অ্যাকাউন্ট না থাকলে অ্যাকাউন্ট যোগ করুন › Google চেপে সাইন ইন করুন।"
          }
        }
      }
    },
    "google.android.step3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hesabınıza dokunun › Hesap senkronizasyonu'nda Takvim'in açık olduğundan emin olun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap your Google account › Account sync and make sure Calendar is on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf Ihr Google-Konto › Kontosynchronisierung und prüfen Sie, ob Kalender aktiviert ist."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hesabınıza toxunun › Hesab sinxronizasiyasında Təqvimin açıq olduğuna əmin olun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على حساب Google › مزامنة الحساب وتأكد من تفعيل التقويم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk akun Google Anda › Sinkronisasi akun dan pastikan Kalender aktif."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے گوگل اکاؤنٹ › اکاؤنٹ ہم آہنگی پر ٹیپ کریں اور یقینی بنائیں کہ کیلنڈر آن ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی حساب گوگل خود › همگام‌سازی حساب بزنید و مطمئن شوید تقویم روشن است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez votre compte Google › Synchronisation du compte et vérifiez qu’Agenda est activé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на аккаунт Google › «Синхронизация аккаунта» и убедитесь, что «Календарь» включён."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleアカウント › アカウントの同期 をタップし、カレンダーがオンになっていることを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 계정 › 계정 동기화를 누르고 캘린더가 켜져 있는지 확인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点您的Google账号 › 账号同步，确认“日历”已开启。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang iyong Google account › Account sync at tiyaking naka-on ang Calendar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะบัญชี Google › ซิงค์บัญชี และตรวจดูว่าปฏิทินเปิดอยู่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque su cuenta de Google › Sincronización de la cuenta y compruebe que Calendario está activado."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na sua conta do Google › Sincronização da conta e confira se Agenda está ativada."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Google खाते › खाता सिंक पर टैप करें और पक्का करें कि कैलेंडर चालू है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Google অ্যাকাউন্ট › অ্যাকাউন্ট সিঙ্কে চেপে দেখুন ক্যালেন্ডার চালু আছে কি না।"
          }
        }
      }
    },
    "google.android.step4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya dönüp “Telefonumdaki takvimleri göster” düğmesine dokunun ve izin verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back here, tap “Show calendars on my phone” and allow access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehren Sie hierher zurück, tippen Sie auf „Kalender meines Telefons anzeigen“ und erlauben Sie den Zugriff."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bura qayıdıb “Telefonumdakı təqvimləri göstər” düyməsinə toxunun və icazə verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارجع إلى هنا واضغط «اعرض التقويمات على هاتفي» واسمح بالوصول."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke sini, ketuk \"Tampilkan kalender ponsel saya\" dan izinkan akses."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں واپس آئیں، «میرے فون کے کیلنڈر دکھائیں» پر ٹیپ کریں اور رسائی کی اجازت دیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به اینجا برگردید، «نمایش تقویم‌های گوشی» را بزنید و دسترسی را مجاز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez ici, touchez « Afficher les calendriers du téléphone » et autorisez l’accès."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь сюда, нажмите «Показать календари телефона» и разрешите доступ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに戻り、「スマホのカレンダーを表示」をタップしてアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기로 돌아와 \"휴대폰의 달력 보기\"를 누르고 접근을 허용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到这里，轻点“显示手机上的日历”并允许访问。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumalik dito, i-tap ang “Ipakita ang mga kalendaryo ng aking telepono” at payagan ang access."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับมาที่นี่ แตะ “แสดงปฏิทินในโทรศัพท์” และอนุญาตการเข้าถึง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva aquí, toque “Mostrar los calendarios de mi teléfono” y permita el acceso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte aqui, toque em “Mostrar os calendários do meu celular” e permita o acesso."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ लौटें, “मेरे फ़ोन के कैलेंडर दिखाएँ” दबाएँ और अनुमति दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে ফিরে এসে “আমার ফোনের ক্যালেন্ডার দেখান” চাপুন এবং অনুমতি দিন।"
          }
        }
      }
    },
    "google.android.denied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim izni kapalı. Ayarlar › Uygulamalar › Saat Tarih › İzinler'den Takvim'e izin verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is off. Allow Calendar in Settings › Apps › Time & Date › Permissions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalenderzugriff ist aus. Erlauben Sie Kalender unter Einstellungen › Apps › Uhr & Datum › Berechtigungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təqvim icazəsi bağlıdır. Parametrlər › Tətbiqlər › Saat Tarix › İcazələr bölməsində Təqvimə icazə verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن التقويم متوقف. اسمح بالتقويم من الإعدادات › التطبيقات › الوقت والتاريخ › الأذونات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kalender nonaktif. Izinkan Kalender di Setelan › Aplikasi › Jam & Tanggal › Izin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر تک رسائی بند ہے۔ ترتیبات › ایپس › وقت اور تاریخ › اجازتیں میں کیلنڈر کی اجازت دیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به تقویم خاموش است. تقویم را در تنظیمات › برنامه‌ها › ساعت و تاریخ › اجازه‌ها مجاز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier est désactivé. Autorisez Agenda dans Paramètres › Applications › Heure & Date › Autorisations."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю выключен. Разрешите «Календарь» в Настройках › Приложения › Время и дата › Разрешения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスがオフです。設定 › アプリ › 時刻と日付 › 権限 でカレンダーを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력 접근이 꺼져 있습니다. 설정 › 앱 › 시간과 날짜 › 권한에서 캘린더를 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历访问已关闭。请在 设置 › 应用 › 时间与日期 › 权限 中允许日历。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang access sa kalendaryo. Payagan ang Calendar sa Settings › Apps › Oras at Petsa › Permissions."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงปฏิทินปิดอยู่ อนุญาตปฏิทินได้ที่ การตั้งค่า › แอป › เวลาและวันที่ › สิทธิ์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al calendario está desactivado. Permita Calendario en Ajustes › Aplicaciones › Hora y Fecha › Permisos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao calendário está desativado. Permita Agenda em Configurações › Apps › Hora e Data › Permissões."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर की पहुँच बंद है। सेटिंग्स › ऐप्स › समय और तारीख › अनुमतियाँ में कैलेंडर की अनुमति दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডারের অনুমতি বন্ধ। সেটিংস › অ্যাপ › সময় ও তারিখ › অনুমতি থেকে ক্যালেন্ডারের অনুমতি দিন।"
          }
        }
      }
    },
    "kids.progress": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
