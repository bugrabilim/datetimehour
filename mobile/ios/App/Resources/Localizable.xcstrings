    "notify.n.isbatBody": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ başı açıklanacak. Kemenag takvimine göre 1 %1$@: %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The start of %1$@ will be announced. By the Kemenag calendar, 1 %1$@ is %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beginn des %1$@ wird bekannt gegeben. Nach dem Kemenag-Kalender ist der 1. %1$@ am %2$@."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ayının başlanğıcı elan olunacaq. Kemenag təqviminə görə 1 %1$@: %2$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُعلَن بدء شهر %1$@. وفق تقويم وزارة الشؤون الدينية الإندونيسية (كيميناغ) يوافق 1 %1$@: %2$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Awal %1$@ akan diumumkan. Menurut kalender Kemenag, 1 %1$@ jatuh pada %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کے آغاز کا اعلان ہوگا۔ کیمیناگ کیلنڈر کے مطابق 1 %1$@: %2$@۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آغاز ماه %1$@ اعلام می‌شود. طبق تقویم وزارت امور دینی اندونزی (کمناگ)، 1 %1$@: %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le début de %1$@ sera annoncé. Selon le calendrier du Kemenag, le 1er %1$@ tombe le %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет объявлено начало месяца %1$@. По календарю Kemenag первый день месяца %1$@: %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の始まりが発表されます。ケメナグの暦では%1$@の1日は%2$@です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 시작일이 발표됩니다. 케메낙 달력으로는 %1$@ 1일이 %2$@입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将宣布%1$@的开始。按印尼宗教部（Kemenag）历法，%1$@1日为%2$@。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iaanunsyo ang simula ng %1$@. Ayon sa kalendaryo ng Kemenag, ang 1 %1$@ ay sa %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะมีการประกาศวันเริ่มเดือน%1$@ ตามปฏิทินของ Kemenag วันที่ 1 %1$@ คือ %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se anunciará el comienzo de %1$@. Según el calendario del Kemenag, el 1 de %1$@ es el %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de %1$@ será anunciado. Pelo calendário do Kemenag, 1 de %1$@ cai em %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ की शुरुआत की घोषणा होगी। केमेनाग कैलेंडर के अनुसार 1 %1$@: %2$@।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ মাসের শুরু ঘোষণা করা হবে। কেমেনাগ ক্যালেন্ডার অনুযায়ী 1 %1$@: %2$@।"
          }
        }
      }
    },
