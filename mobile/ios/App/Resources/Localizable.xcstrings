    "sky.eventsNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteor yağmuru zirveleri Uluslararası Meteor Örgütü'nün (IMO) Güneş boylamı değerlerinden hesaplanır; gerçek zirve birkaç saat oynayabilir. Yakınlaşma açıları Dünya'nın merkezinden; bulunduğunuz yerden bir derece kadar farklı görünebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteor shower peaks are calculated from the solar longitudes published by the International Meteor Organization (IMO); the actual peak may shift by a few hours. Separations are geocentric; from your location they may differ by about a degree."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Maxima der Meteorströme werden aus den Sonnenlängen der International Meteor Organization (IMO) berechnet; das tatsächliche Maximum kann einige Stunden abweichen. Abstände sind geozentrisch; von Ihrem Standort aus können sie um etwa ein Grad abweichen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteor yağışlarının zirvələri Beynəlxalq Meteor Təşkilatının (IMO) Günəş uzunluğu dəyərlərindən hesablanır; həqiqi zirvə bir neçə saat sürüşə bilər. Yaxınlaşma bucaqları Yerin mərkəzindəndir; olduğunuz yerdən bir dərəcə qədər fərqli görünə bilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب ذروات زخات الشهب من قيم خط طول الشمس التي تنشرها المنظمة الدولية للشهب (IMO)؛ وقد تتغير الذروة الفعلية بضع ساعات. المسافات الزاوية محسوبة من مركز الأرض، وقد تختلف من موقعك بنحو درجة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Puncak hujan meteor dihitung dari bujur Matahari yang diterbitkan International Meteor Organization (IMO); puncak sebenarnya bisa bergeser beberapa jam. Jarak sudut dihitung dari pusat Bumi; dari lokasi Anda bisa berbeda sekitar satu derajat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شہابیوں کی بارش کا عروج بین الاقوامی شہابیہ تنظیم (IMO) کی شائع کردہ سورج کی طول بلد سے حساب کیا جاتا ہے؛ اصل عروج چند گھنٹے آگے پیچھے ہو سکتا ہے۔ زاویائی فاصلے زمین کے مرکز سے ہیں؛ آپ کی جگہ سے تقریباً ایک درجہ مختلف ہو سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اوج بارش‌های شهابی از طول خورشیدی منتشرشده توسط سازمان بین‌المللی شهاب (IMO) محاسبه می‌شود؛ اوج واقعی ممکن است چند ساعت جابه‌جا شود. فاصله‌های زاویه‌ای از مرکز زمین است و از محل شما ممکن است حدود یک درجه فرق کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pics des pluies de météores sont calculés à partir des longitudes solaires publiées par l'International Meteor Organization (IMO) ; le pic réel peut varier de quelques heures. Les écarts sont géocentriques ; depuis votre lieu, ils peuvent différer d'environ un degré."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимумы метеорных потоков рассчитаны по долготам Солнца, опубликованным Международной метеорной организацией (IMO); реальный максимум может сместиться на несколько часов. Угловые расстояния геоцентрические; из вашего места они могут отличаться примерно на градус."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "流星群の極大は国際流星機構（IMO）が公表する太陽黄経から計算しています。実際の極大は数時間ずれることがあります。角距離は地心から見た値で、観測地からは1°ほど異なることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유성우 극대는 국제유성기구(IMO)가 발표한 태양 황경으로 계산합니다. 실제 극대는 몇 시간 차이가 날 수 있습니다. 각거리는 지구 중심 기준이며 관측지에서는 1°쯤 다를 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流星雨极大时刻根据国际流星组织（IMO）公布的太阳黄经计算，实际极大可能相差数小时。角距离为地心值，从您所在地点看可能相差约1°。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinukuwenta ang rurok ng mga meteor shower mula sa solar longitude na inilathala ng International Meteor Organization (IMO); maaaring maiba ng ilang oras ang tunay na rurok. Geocentric ang mga anggulo; mula sa lugar mo, maaaring maiba nang mga isang digri."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงสูงสุดของฝนดาวตกคำนวณจากลองจิจูดดวงอาทิตย์ที่องค์การดาวตกสากล (IMO) เผยแพร่ ช่วงสูงสุดจริงอาจคลาดได้หลายชั่วโมง ระยะเชิงมุมวัดจากศูนย์กลางโลก จากที่ของคุณอาจต่างไปราวหนึ่งองศา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los máximos de las lluvias de meteoros se calculan a partir de las longitudes solares publicadas por la Organización Internacional de Meteoros (IMO); el máximo real puede desplazarse unas horas. Las separaciones son geocéntricas; desde su ubicación pueden diferir en un grado aprox."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os picos das chuvas de meteoros são calculados a partir das longitudes solares publicadas pela Organização Internacional de Meteoros (IMO); o pico real pode mudar algumas horas. As separações são geocêntricas; do seu local podem diferir cerca de um grau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उल्का वर्षा के चरम अंतरराष्ट्रीय उल्का संगठन (IMO) के प्रकाशित सौर देशांतरों से निकाले जाते हैं; असली चरम कुछ घंटे खिसक सकता है। कोणीय दूरियाँ पृथ्वी के केंद्र से मापी गई हैं; आपके स्थान से लगभग एक डिग्री का अंतर हो सकता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উল্কাবৃষ্টির চূড়া আন্তর্জাতিক উল্কা সংস্থার (IMO) প্রকাশিত সৌর দ্রাঘিমা থেকে হিসাব করা; প্রকৃত চূড়া কয়েক ঘণ্টা সরতে পারে। ব্যবধানগুলো ভূকেন্দ্রিক; আপনার অবস্থান থেকে প্রায় এক ডিগ্রি আলাদা হতে পারে।"
          }
        }
      }
    },
