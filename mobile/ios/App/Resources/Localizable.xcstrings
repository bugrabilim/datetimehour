    "cals.jewish.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yahudi bayramları ve İbrani tarihi: Roş Aşana, Yom Kipur, Hanuka, Pesah ve diğerleri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jewish holidays and the Hebrew date: Rosh Hashana, Yom Kippur, Hanukkah, Passover and more."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jüdische Feiertage und das hebräische Datum: Rosch ha-Schana, Jom Kippur, Chanukka, Pessach und weitere."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yəhudi bayramları və İbrani tarixi: Roş-Haşana, Yom-Kippur, Xanuka, Pesax və digərləri."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأعياد اليهودية والتاريخ العبري: روش هشناه ويوم الغفران وحانوكا وعيد الفصح اليهودي وغيرها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari raya Yahudi dan tanggal Ibrani: Rosh Hashanah, Yom Kippur, Hanukkah, Paskah Yahudi, dan lainnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہودی تہوار اور عبرانی تاریخ: روش ہشانہ، یوم کپور، حنوکا، عید فسح اور دیگر۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعیاد یهودی و تاریخ عبری: روش هشانا، یوم کیپور، حانوکا، پسح و اعیاد دیگر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fêtes juives et date hébraïque : Roch Hachana, Yom Kippour, Hanoucca, Pessah et d’autres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Еврейские праздники и дата по еврейскому календарю: Рош ха-Шана, Йом-Кипур, Ханука, Песах и другие."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユダヤ教の祝祭日とユダヤ暦の日付：ロシュ・ハシャナ、ヨム・キプル、ハヌカー、過越祭など。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유대교 명절과 유대력 날짜: 로쉬 하샤나, 욤 키푸르, 하누카, 유월절 등."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "犹太节日与犹太历日期：犹太新年、赎罪日、光明节、逾越节等。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga pista ng mga Hudyo at petsang Hebreo: Rosh Hashanah, Yom Kippur, Hanukkah, Paskuwa, at iba pa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันสำคัญของชาวยิวและวันที่ตามปฏิทินฮีบรู: โรช ฮาชานาห์ ยมคิปปูร์ ฮานุกกาห์ ปัสกา และอื่น ๆ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Festividades judías y fecha hebrea: Rosh Hashaná, Yom Kipur, Janucá, Pésaj y otras."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Festas judaicas e a data hebraica: Rosh Hashaná, Yom Kipur, Chanucá, Pessach e outras."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहूदी त्योहार और हिब्रू तारीख: रोश हशाना, योम किप्पुर, हनुक्का, पेसाख़ और अन्य।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইহুদি ছুটি ও হিব্রু তারিখ: রোশ হাশানা, ইয়োম কিপুর, হানুকা, পাসওভার ও আরও।"
          }
        }
      }
    },
    "cals.jewish.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yahudi günü önceki akşam gün batımında başlar; bayramlar burada ilk tam günlerinde gösterilir, İbrani tarih de günün gündüzüne göredir. Süreler diasporaya göredir: İsrail'de Pesah 7 gün, Şavuot 1 gün sürer ve Simhat Tora, Şemini Atzeret ile aynı gündür. Tarihler İbrani takviminin hesap kurallarından üretilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jewish days begin at sunset the evening before; holidays are shown on their first full day, and the Hebrew date follows the daytime. Durations follow the Diaspora: in Israel Passover lasts 7 days, Shavuot 1 day, and Simchat Torah falls on Shemini Atzeret. Dates are calculated with the rules of the Hebrew calendar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jüdische Tage beginnen am Vorabend mit Sonnenuntergang; Feiertage stehen hier an ihrem ersten vollen Tag, und das hebräische Datum gilt für den Tag. Die Dauer folgt der Diaspora: In Israel dauert Pessach 7 Tage, Schawuot 1 Tag, und Simchat Tora fällt auf Schemini Azeret. Die Daten werden nach den Regeln des hebräischen Kalenders berechnet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yəhudi günü əvvəlki axşam gün batanda başlayır; bayramlar burada ilk tam günündə göstərilir, İbrani tarixi də günün gündüz vaxtına görədir. Müddətlər diasporaya görədir: İsraildə Pesax 7 gün, Şavuot 1 gün davam edir, Simxat-Tora isə Şemini Atseretlə eyni gündür. Tarixlər İbrani təqviminin hesablama qaydalarından alınır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ اليوم اليهودي عند غروب الشمس في المساء السابق؛ تظهر الأعياد هنا في أول يوم كامل لها، ويتبع التاريخ العبري نهار اليوم. المدد حسب يهود الشتات: في إسرائيل يستمر عيد الفصح 7 أيام وعيد الأسابيع يومًا واحدًا، ويقع سمحات توراه في يوم شميني عتسيرت نفسه. تُحسب التواريخ بقواعد التقويم العبري."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari Yahudi dimulai saat matahari terbenam pada malam sebelumnya; hari raya ditampilkan pada hari penuh pertamanya, dan tanggal Ibrani mengikuti siang hari. Lama perayaan mengikuti diaspora: di Israel Paskah Yahudi berlangsung 7 hari, Shavuot 1 hari, dan Simchat Torah jatuh bersamaan dengan Shemini Atzeret. Tanggal dihitung dengan kaidah kalender Ibrani."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہودی دن پچھلی شام غروبِ آفتاب سے شروع ہوتا ہے؛ تہوار یہاں اپنے پہلے پورے دن پر دکھائے جاتے ہیں اور عبرانی تاریخ دن کے اجالے کے مطابق ہے۔ مدتیں بیرونِ اسرائیل (ڈائسپورا) کے مطابق ہیں: اسرائیل میں عید فسح 7 دن اور شاووعوت 1 دن کی ہوتی ہے، اور سمخات تورات شمینی عتصیرت کے دن ہی آتی ہے۔ تاریخیں عبرانی کیلنڈر کے حسابی قواعد سے نکالی جاتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روز یهودی از غروب آفتاب شب پیش آغاز می‌شود؛ اعیاد اینجا در نخستین روز کاملشان نشان داده می‌شوند و تاریخ عبری مطابق روزِ روشن است. مدت‌ها مطابق یهودیان بیرون از اسرائیل (دیاسپورا) است: در اسرائیل پسح 7 روز و شاووعوت 1 روز است و سیمحات تورا با شمینی عصرت در یک روز است. تاریخ‌ها با قواعد محاسبهٔ تقویم عبری به دست می‌آیند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jour juif commence au coucher du soleil la veille ; les fêtes sont indiquées à leur premier jour complet et la date hébraïque correspond à la journée. Les durées suivent la diaspora : en Israël, Pessah dure 7 jours, Chavouot 1 jour, et Simhat Torah tombe le jour de Chemini Atseret. Les dates sont calculées selon les règles du calendrier hébraïque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Еврейский день начинается накануне с заходом солнца; праздники показаны в их первый полный день, а еврейская дата относится к светлому времени суток. Продолжительность — как в диаспоре: в Израиле Песах длится 7 дней, Шавуот — 1 день, а Симхат Тора совпадает со Шмини Ацерет. Даты рассчитываются по правилам еврейского календаря."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユダヤ暦の1日は前日の日没に始まります。祝祭日は最初の丸1日の日付で表示し、ユダヤ暦の日付も日中に合わせています。期間はディアスポラ（イスラエル国外）の慣習によります。イスラエルでは過越祭は7日間、七週の祭りは1日で、シムハット・トーラーはシェミニ・アツェレトと同じ日です。日付はユダヤ暦の計算規則によるものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유대력의 하루는 전날 해 질 녘에 시작됩니다. 명절은 첫 온전한 날에 표시하며, 유대력 날짜는 낮을 기준으로 합니다. 기간은 디아스포라(이스라엘 밖) 기준이며, 이스라엘에서는 유월절이 7일, 칠칠절이 1일이고 심하트 토라는 셰미니 아체레트와 같은 날입니다. 날짜는 유대력의 계산 규칙으로 구합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "犹太历的一天从前一天日落时开始；节日显示在其第一个完整的日子，犹太历日期也按白天显示。节期长度按散居地（以色列境外）习俗：在以色列，逾越节为7天，七七节为1天，西姆哈托拉节与圣会节同日。日期按犹太历的推算规则计算。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagsisimula ang araw ng mga Hudyo sa paglubog ng araw sa gabi bago nito; ipinapakita rito ang mga pista sa una nilang buong araw, at ang petsang Hebreo ay ayon sa maghapon. Ang haba ng mga pista ay ayon sa diaspora: sa Israel, 7 araw ang Paskuwa, 1 araw ang Shavuot, at kasabay ng Shemini Atzeret ang Simchat Torah. Kinukuwenta ang mga petsa ayon sa mga tuntunin ng kalendaryong Hebreo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันของชาวยิวเริ่มเมื่อดวงอาทิตย์ตกในค่ำวันก่อนหน้า วันสำคัญจึงแสดงในวันเต็มวันแรก และวันที่ตามปฏิทินฮีบรูเป็นไปตามช่วงกลางวัน ระยะเวลาเทศกาลเป็นแบบชาวยิวนอกอิสราเอล (ไดแอสพอรา) ในอิสราเอลปัสกามี 7 วัน ชาวูออตมี 1 วัน และซิมฮัต โทราห์ตรงกับวันเชมินี อัทเซเรท วันที่คำนวณตามกฎของปฏิทินฮีบรู"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día judío comienza al atardecer de la víspera; las festividades se muestran en su primer día completo y la fecha hebrea corresponde al día. Las duraciones siguen la diáspora: en Israel, Pésaj dura 7 días, Shavuot 1 día y Simjat Torá coincide con Sheminí Atzéret. Las fechas se calculan con las reglas del calendario hebreo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia judaico começa ao pôr do sol da véspera; as festas aparecem no primeiro dia completo, e a data hebraica corresponde ao dia. As durações seguem a diáspora: em Israel, Pessach dura 7 dias, Shavuot 1 dia, e Simchat Torá cai no mesmo dia que Shemini Atseret. As datas são calculadas pelas regras do calendário hebraico."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहूदी दिन पिछली शाम सूर्यास्त से शुरू होता है; त्योहार यहाँ अपने पहले पूरे दिन पर दिखाए जाते हैं और हिब्रू तारीख दिन के उजाले के अनुसार है। अवधि प्रवासी (डायस्पोरा) परंपरा के अनुसार है: इज़राइल में पेसाख़ 7 दिन और शावूओत 1 दिन का होता है, और सिमख़त तोरा शमीनी अत्सेरेत के दिन ही पड़ता है। तारीखें हिब्रू कैलेंडर के गणना नियमों से निकाली जाती हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইহুদি দিন আগের সন্ধ্যার সূর্যাস্তে শুরু হয়; ছুটিগুলো তাদের প্রথম পূর্ণ দিনে দেখানো হয়েছে এবং হিব্রু তারিখ দিনের বেলা অনুসরণ করে। সময়কাল প্রবাসের রীতি অনুসরণ করে: ইসরায়েলে পাসওভার 7 দিন, শাভুয়োত 1 দিন এবং সিমখাত তোরা শেমিনি আতসেরেতের দিনে পড়ে। তারিখগুলো হিব্রু ক্যালেন্ডারের নিয়মে হিসাব করা।"
          }
        }
      }
    },
