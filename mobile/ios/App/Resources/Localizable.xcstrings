          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот день солнце не заходит (полярный день)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日は太陽が沈みません（白夜）。"
