            "value": "Décembre vient du latin decem, « dix »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Декабрь — от латинского decem, «десять»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "師走（しわす）：年末に僧（師）が忙しく走り回る月とされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
