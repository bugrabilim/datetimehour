    "sw.multi.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kronometre ayrı sayar; uygulama kapansa da süre kaybolmaz. Kilit ekranında yalnız üstteki kronometre görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each stopwatch counts on its own and keeps its time even if the app closes. Only the top stopwatch appears on the lock screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Stoppuhr zählt für sich und behält ihre Zeit, auch wenn die App geschlossen wird. Auf dem Sperrbildschirm erscheint nur die obere Stoppuhr."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər saniyəölçən ayrıca sayır; tətbiq bağlansa da vaxt itmir. Kilid ekranında yalnız yuxarıdakı saniyəölçən görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعدّ كل ساعة إيقاف وحدها وتحتفظ بوقتها حتى لو أُغلق التطبيق. لا تظهر على شاشة القفل إلا الساعة العلوية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap stopwatch menghitung sendiri dan menyimpan waktunya meski aplikasi ditutup. Hanya stopwatch teratas yang tampil di layar kunci."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر اسٹاپ واچ الگ گنتی ہے اور ایپ بند ہو جائے تب بھی اپنا وقت رکھتی ہے۔ لاک اسکرین پر صرف سب سے اوپر والی دکھتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر کرنومتر جداگانه می‌شمارد و حتی اگر برنامه بسته شود زمانش را نگه می‌دارد. فقط کرنومتر بالایی روی صفحهٔ قفل دیده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque chronomètre compte de son côté et garde son temps même si l’app se ferme. Seul le chronomètre du haut apparaît sur l’écran verrouillé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый секундомер считает сам по себе и сохраняет время, даже если приложение закроется. На экране блокировки виден только верхний секундомер."
          }
        }
      }
    },
