    "list.loadFail": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin yüklenemedi. Tam metni aşağıdaki bağlantıdan okuyabilir, biraz sonra tekrar deneyebilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text could not be loaded. You can read the full text from the link below and try again a little later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text konnte nicht geladen werden. Sie können den vollständigen Text über den Link unten lesen und es etwas später erneut versuchen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mətn yüklənmədi. Tam mətni aşağıdakı keçiddən oxuya və bir az sonra yenidən cəhd edə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل النص. يمكنك قراءة النص الكامل من الرابط أدناه والمحاولة مرة أخرى بعد قليل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks tidak dapat dimuat. Anda dapat membaca teks lengkap melalui tautan di bawah dan mencoba lagi nanti."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "متن لوڈ نہیں ہو سکا۔ آپ نیچے دیے گئے لنک سے پورا متن پڑھ سکتے ہیں اور کچھ دیر بعد دوبارہ کوشش کر سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متن بارگیری نشد. می‌توانید متن کامل را از پیوند زیر بخوانید و کمی بعد دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte n’a pas pu être chargé. Vous pouvez lire le texte complet via le lien ci-dessous et réessayer un peu plus tard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить текст. Полный текст можно прочитать по ссылке ниже; попробуйте снова чуть позже."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを読み込めませんでした。下のリンクから全文を読み、少し後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글을 불러오지 못했습니다. 아래 링크에서 전문을 읽고 잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载文本。您可以通过下面的链接阅读全文，稍后再试。"
