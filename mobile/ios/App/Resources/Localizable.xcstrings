    "quran.hatimConfirm": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldığınız yer Fâtiha'nın başına alınır. Yeni hatim başlatılsın mı?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bookmark moves to the start of al-Fatiha. Start a new khatm?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Lesezeichen springt an den Anfang der Fatiha. Neues Khatm beginnen?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaldığınız yer Fatihənin əvvəlinə keçir. Yeni xətm başlansın?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينتقل موضع القراءة إلى بداية الفاتحة. أتبدأ ختمة جديدة؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penanda pindah ke awal Al-Fatihah. Mulai khatam baru?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نشان سورۂ فاتحہ کے شروع پر چلا جائے گا۔ نیا ختم شروع کریں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشانه به آغاز فاتحه می‌رود. ختم تازه شروع شود؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre signet revient au début d’al-Fatiha. Commencer un nouveau khatm ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закладка вернётся к началу «аль-Фатихи». Начать новый хатм?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しおりが開端章の最初に戻ります。新しい完読を始めますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책갈피가 개경장 처음으로 이동합니다. 새 완독을 시작할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书签将移到开端章开头。开始新的通读吗？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lilipat ang bookmark sa simula ng al-Fatiha. Magsimula ng bagong khatm?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่คั่นจะกลับไปต้นซูเราะฮ์อัลฟาติฮะฮ์ เริ่มคอตัมใหม่หรือไม่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su marcador pasará al inicio de al-Fátiha. ¿Empezar un jatm nuevo?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu marcador vai para o início de al-Fátiha. Começar um novo khatm?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका बुकमार्क अल-फ़ातिहा की शुरुआत पर चला जाएगा। नया ख़त्म शुरू करें?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বুকমার্ক সূরা ফাতিহার শুরুতে যাবে। নতুন খতম শুরু করবেন?"
          }
        }
      }
    },
