    "zakat.fitreText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyanet İşleri Başkanlığı Din İşleri Yüksek Kurulu %1$@ yılı için fitreyi kişi başı %2$@ TL olarak açıkladı (%3$@). Geçerlilik: %1$@ Ramazan ayından bir sonraki Ramazan'a kadar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turkey's Presidency of Religious Affairs (High Board of Religious Affairs) set the %1$@ fitra at %2$@ TL per person (%3$@), valid from Ramadan %1$@ until the next Ramadan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hohe Rat für Religionsangelegenheiten des Diyanet hat die Fitra für %1$@ auf %2$@ TL pro Person festgelegt (%3$@); gültig ab Ramadan %1$@ bis zum nächsten Ramadan."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiyə Diyanət İşləri Başqanlığının Din İşləri Ali Şurası %1$@ ili üçün fitrəni adambaşına %2$@ TL açıqladı (%3$@). Etibarlıdır: %1$@ Ramazanından növbəti Ramazana qədər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حددت الهيئة العليا للشؤون الدينية في رئاسة الشؤون الدينية التركية زكاة الفطر لعام %1$@ بمبلغ %2$@ ليرة للشخص (%3$@)، وتسري من رمضان %1$@ حتى رمضان التالي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kepresidenan Urusan Agama Turki (Dewan Tinggi Urusan Agama) menetapkan zakat fitrah %1$@ sebesar %2$@ TL per orang (%3$@), berlaku sejak Ramadan %1$@ hingga Ramadan berikutnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترکی کی ریاستِ امورِ دینیہ (اعلیٰ مجلسِ امورِ دینیہ) نے %1$@ کا فطرانہ فی کس %2$@ لیرا مقرر کیا (%3$@)، جو رمضان %1$@ سے اگلے رمضان تک معتبر ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ریاست امور دینی ترکیه (شورای عالی امور دینی) فطریهٔ %1$@ را %2$@ لیر برای هر نفر تعیین کرد (%3$@)؛ از رمضان %1$@ تا رمضان بعدی معتبر است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Présidence des affaires religieuses de Turquie (Haut Conseil des affaires religieuses) a fixé la fitra %1$@ à %2$@ TL par personne (%3$@), valable du Ramadan %1$@ jusqu’au Ramadan suivant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управление по делам религии Турции (Высший совет по делам религии) установило фитр на %1$@ год в размере %2$@ TL с человека (%3$@); он действует с Рамадана %1$@ года до следующего Рамадана."
          }
        }
      }
    },
