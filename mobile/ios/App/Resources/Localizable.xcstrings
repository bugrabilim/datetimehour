    "badges.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozetlerin ve ilerlemen yalnız bu cihazda, sen silene kadar saklanır."
          }
