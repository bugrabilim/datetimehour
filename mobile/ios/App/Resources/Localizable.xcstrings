        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que cada día compartido sea aún más bonito."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que cada dia compartilhado fique ainda mais bonito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साथ बिताया हर दिन और भी सुंदर हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একসাথে কাটানো প্রতিটি দিন আরও সুন্দর হোক।"
          }
        }
      }
    },
    "greet.m.anniversary.3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevginiz hep böyle taze kalsın."
