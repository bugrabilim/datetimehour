        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জন্য কল্যাণের দরজা খুলে যাক।"
          }
        }
      }
    },
    "greet.bless.5": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofranız bereketli, eviniz neşeli olsun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your table be abundant and your home joyful."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möge Ihr Tisch reich gedeckt und Ihr Zuhause fröhlich sein."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Süfrəniz bərəkətli, eviniz şən olsun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دامت موائدكم عامرة وبيوتكم سعيدة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga meja Anda berlimpah dan rumah Anda ceria."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا دسترخوان بابرکت اور گھر خوش رہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سفره‌تان پربرکت و خانه‌تان شاد باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que votre table soit généreuse et votre foyer joyeux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть ваш стол будет щедрым, а дом радостным."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食卓は豊かに、家庭は明るくありますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식탁은 풍성하고 가정은 즐겁길 바랍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "愿您餐桌丰盛，家中欢乐。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawa'y masagana ang inyong hapag at masaya ang tahanan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
