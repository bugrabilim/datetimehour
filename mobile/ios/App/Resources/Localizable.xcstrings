    },
    "prayer.alarm.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili vakitlerde gerçek alarm çalar: telefon sessizde ya da Odak açıkken de duyulur. Önümüzdeki günler için kurulur, uygulama açıldıkça yenilenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A real alarm rings at the selected prayer times, even when the phone is silent or in Focus. Alarms are set for the coming days and renewed whenever you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu den gewählten Gebetszeiten klingelt ein echter Wecker, auch wenn das Telefon stummgeschaltet oder ein Fokus aktiv ist. Die Wecker werden für die nächsten Tage gestellt und bei jedem Öffnen der App erneuert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş vaxtlarda əsl siqnal çalır: telefon səssizdə və ya Fokusda olsa da eşidilir. Növbəti günlər üçün qurulur, tətbiq açıldıqca yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرنّ منبه حقيقي عند المواقيت المختارة حتى لو كان الهاتف صامتًا أو في وضع التركيز. تُضبط المنبهات للأيام القادمة وتُجدَّد كلما فتحت التطبيق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm sungguhan berbunyi pada waktu salat yang dipilih, meski ponsel senyap atau dalam mode Fokus. Alarm dipasang untuk hari-hari mendatang dan diperbarui setiap kali aplikasi dibuka."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب اوقاتِ نماز پر اصل الارم بجتا ہے، فون خاموش یا فوکس موڈ میں ہو تب بھی۔ الارم آنے والے دنوں کے لیے لگتے ہیں اور ہر بار ایپ کھولنے پر تازہ ہوتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در اوقات نماز انتخابی هشداری واقعی زنگ می‌زند، حتی وقتی گوشی بی‌صدا یا در حالت تمرکز است. هشدارها برای روزهای پیش رو تنظیم و با هر بار باز کردن برنامه تازه می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vraie alarme sonne aux heures de prière choisies, même en silencieux ou en mode Concentration. Les alarmes sont programmées pour les jours à venir et renouvelées à chaque ouverture de l’app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выбранное время намаза звонит настоящий будильник, даже в беззвучном режиме или режиме фокусирования. Будильники ставятся на ближайшие дни и обновляются при каждом открытии приложения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ礼拝時刻に、マナーモードや集中モードでも本物のアラームが鳴ります。アラームは数日先まで設定され、アプリを開くたびに更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기도 시간에 휴대폰이 무음이거나 집중 모드여도 실제 알람이 울립니다. 알람은 며칠 앞까지 맞춰지며 앱을 열 때마다 갱신됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所选礼拜时间，即使手机静音或处于专注模式，也会响起真正的闹钟。闹钟会提前为接下来几天设好，并在每次打开应用时更新。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumutunog ang tunay na alarma sa mga napiling oras ng dasal, kahit naka-silent o nasa Focus ang telepono. Itinatakda ang mga alarma para sa mga susunod na araw at nire-refresh tuwing bubuksan mo ang app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาปลุกจริงจะดังในเวลาละหมาดที่เลือก แม้โทรศัพท์ปิดเสียงหรืออยู่ในโหมดโฟกัส นาฬิกาปลุกตั้งไว้สำหรับวันข้างหน้าและจะอัปเดตทุกครั้งที่เปิดแอป"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A las horas de oración elegidas suena una alarma de verdad, aunque el teléfono esté en silencio o en modo Concentración. Las alarmas se ponen para los próximos días y se renuevan cada vez que abre la app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos horários de oração escolhidos toca um alarme de verdade, mesmo com o celular no silencioso ou em Foco. Os alarmes são criados para os próximos dias e renovados sempre que você abre o app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने नमाज़ के समय पर असली अलार्म बजता है, फ़ोन साइलेंट या फ़ोकस में हो तब भी। अलार्म अगले दिनों के लिए लगते हैं और हर बार ऐप खोलने पर फिर से लगाए जाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেছে নেওয়া নামাজের সময়ে আসল অ্যালার্ম বাজে, ফোন নীরব বা ফোকাসে থাকলেও। সামনের দিনগুলোর অ্যালার্ম দেওয়া হয় এবং অ্যাপ খুললেই নবায়ন হয়।"
          }
        }
      }
    },
    "prayer.alarm.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakit alarmı iOS 26 ve sonrasında kullanılabilir; bu sürümde bildirimler kullanılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer alarms need iOS 26 or later; this version uses notifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebetswecker benötigen iOS 26 oder neuer; diese Version nutzt Benachrichtigungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxt siqnalı iOS 26 və sonrasında işləyir; bu versiyada bildirişlər istifadə olunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب منبه المواقيت iOS 26 أو أحدث؛ يُستخدم الإشعار في هذا الإصدار."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm salat memerlukan iOS 26 atau yang lebih baru; versi ini memakai notifikasi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز کے الارم کے لیے iOS 26 یا بعد کا ورژن چاہیے؛ یہ ورژن اطلاعات استعمال کرتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هشدارهای نماز به iOS 26 یا بالاتر نیاز دارند؛ این نسخه از اعلان استفاده می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes de prière nécessitent iOS 26 ou version ultérieure ; cette version utilise des notifications."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильникам намаза нужна iOS 26 или новее; в этой версии используются уведомления."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拝のアラームにはiOS 26以降が必要です。このバージョンでは通知を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도 알람에는 iOS 26 이상이 필요합니다. 이 버전에서는 알림을 씁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拜闹钟需要iOS 26或更高版本；此版本使用通知。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng iOS 26 o mas bago para sa alarma ng dasal; abiso ang gamit ng bersiyong ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาปลุกเวลาละหมาดต้องใช้ iOS 26 ขึ้นไป เวอร์ชันนี้ใช้การแจ้งเตือน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
