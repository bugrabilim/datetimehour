    "alarm.music.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz şarkının 30 saniyelik bir bölümü alarm sesi olur (iPhone alarm ve bildirim seslerini 30 sn ile sınırlar). Yalnız telefonda duran korumasız şarkılar ve ses dosyaları kullanılabilir; Apple Music'ten indirilen şarkılar korumalıdır. Şarkı telefonda kalır. Saati sesli söyleme açıksa o çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 30-second part of the song you choose becomes the alarm sound (iPhone limits alarm and notification sounds to 30 s). Only unprotected songs stored on the phone and audio files can be used; songs downloaded from Apple Music are protected. The song stays on your phone. If speaking the time is on, that plays instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein 30-Sekunden-Ausschnitt des gewählten Titels wird zum Weckton (iPhone begrenzt Wecker- und Mitteilungstöne auf 30 s). Nur ungeschützte, auf dem Telefon gespeicherte Titel und Audiodateien sind möglich; aus Apple Music geladene Titel sind geschützt. Der Titel bleibt auf dem Telefon. Ist die Zeitansage an, wird diese abgespielt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçdiyiniz mahnının 30 saniyəlik hissəsi zəng səsi olur (iPhone zəng və bildiriş səslərini 30 san ilə məhdudlaşdırır). Yalnız telefonda saxlanan qorunmayan mahnılar və səs faylları istifadə oluna bilər; Apple Music-dən endirilən mahnılar qorunur. Mahnı telefonda qalır. Saatı səsli demək açıqdırsa, o səslənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصبح جزء مدته 30 ثانية من الأغنية التي تختارها صوتَ المنبّه (يحدّ iPhone أصوات المنبّه والإشعارات بـ30 ثانية). لا يمكن استخدام إلا الأغاني غير المحمية المخزنة على الهاتف والملفات الصوتية؛ الأغاني المنزّلة من Apple Music محمية. تبقى الأغنية على هاتفك. إذا كان نطق الوقت مفعّلًا فهو الذي يُسمع."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Potongan 30 detik dari lagu pilihan menjadi suara alarm (iPhone membatasi suara alarm dan notifikasi hingga 30 dtk). Hanya lagu tanpa proteksi yang tersimpan di ponsel dan file audio yang bisa dipakai; lagu yang diunduh dari Apple Music diproteksi. Lagu tetap di ponsel Anda. Jika ucapkan waktu aktif, itulah yang diputar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب گانے کا 30 سیکنڈ کا حصہ الارم کی آواز بن جاتا ہے (آئی فون الارم اور اطلاع کی آواز کو 30 سیکنڈ تک محدود کرتا ہے)۔ صرف فون پر محفوظ غیر محفوظ شدہ گانے اور آڈیو فائلیں استعمال ہو سکتی ہیں؛ Apple Music سے ڈاؤن لوڈ گانے محفوظ (پروٹیکٹڈ) ہوتے ہیں۔ گانا آپ کے فون پر رہتا ہے۔ اگر وقت بولنا آن ہو تو وہی بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بخشی 30 ثانیه‌ای از آهنگ انتخابی صدای هشدار می‌شود (آیفون صدای هشدار و اعلان را به 30 ثانیه محدود می‌کند). فقط آهنگ‌های بدون محافظت ذخیره‌شده روی گوشی و فایل‌های صوتی قابل استفاده‌اند؛ آهنگ‌های دانلودشده از Apple Music محافظت‌شده‌اند. آهنگ روی گوشی شما می‌ماند. اگر گفتن ساعت روشن باشد، همان پخش می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un extrait de 30 secondes du morceau choisi devient le son de l’alarme (l’iPhone limite les sons d’alarme et de notification à 30 s). Seuls les morceaux non protégés enregistrés sur le téléphone et les fichiers audio sont utilisables ; les morceaux téléchargés depuis Apple Music sont protégés. Le morceau reste sur votre téléphone. Si l’annonce de l’heure est activée, c’est elle qui est jouée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "30-секундный отрывок выбранной песни становится звуком будильника (iPhone ограничивает звуки будильника и уведомлений 30 с). Подходят только незащищённые песни, хранящиеся на телефоне, и аудиофайлы; песни, загруженные из Apple Music, защищены. Песня остаётся на телефоне. Если включено называние времени, звучит оно."
          }
        }
      }
    },
    "alarm.music.protected": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şarkı korumalı (Apple Music) ya da telefonda değil; başka bir şarkı ya da Dosyalar'dan bir ses dosyası seçin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This song is protected (Apple Music) or not on the phone; choose another song or an audio file from Files."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Titel ist geschützt (Apple Music) oder nicht auf dem Telefon; wählen Sie einen anderen Titel oder eine Audiodatei aus Dateien."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mahnı qorunur (Apple Music) ya da telefonda deyil; başqa mahnı ya da Fayllardan səs faylı seçin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الأغنية محمية (Apple Music) أو ليست على الهاتف؛ اختر أغنية أخرى أو ملفًا صوتيًا من الملفات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagu ini diproteksi (Apple Music) atau tidak ada di ponsel; pilih lagu lain atau file audio dari File."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ گانا محفوظ (Apple Music) ہے یا فون پر نہیں؛ کوئی اور گانا یا فائلز سے آڈیو فائل چنیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این آهنگ محافظت‌شده (Apple Music) است یا روی گوشی نیست؛ آهنگ دیگری یا فایلی صوتی از فایل‌ها برگزینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce morceau est protégé (Apple Music) ou absent du téléphone ; choisissez-en un autre ou un fichier audio dans Fichiers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта песня защищена (Apple Music) или отсутствует на телефоне; выберите другую песню или аудиофайл в «Файлах»."
          }
        }
      }
    },
