    "greet.m.rb.2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayramınız sevinç ve huzurla dolsun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your Eid be full of joy and peace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möge Ihr Fest voller Freude und Frieden sein."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayramınız sevinc və dincliklə dolsun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جعل الله عيدكم مليئًا بالفرح والسكينة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga Lebaran Anda penuh sukacita dan kedamaian."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی عید خوشی اور سکون سے بھری ہو۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عیدتان سرشار از شادی و آرامش باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que votre Aïd soit rempli de joie et de paix."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть праздник будет полон радости и покоя."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "喜びと安らぎに満ちたイードでありますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기쁨과 평안이 가득한 명절 되세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "愿您的节日充满欢乐与安宁。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawa'y puno ng saya at kapayapaan ang inyong Eid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้วันอีดของคุณเต็มไปด้วยความสุขและความสงบ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que su Eid esté lleno de alegría y paz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que o seu Eid seja cheio de alegria e paz."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी ईद ख़ुशी और सुकून से भरी हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ঈদ আনন্দ ও শান্তিতে ভরে উঠুক।"
          }
        }
      }
    },
    "greet.m.rb.3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruçlarınızın sevabıyla bayramınız kutlu olsun."
