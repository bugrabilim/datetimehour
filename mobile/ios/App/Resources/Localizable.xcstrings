    "alarm.music.trimNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırıcıyla şarkının hangi 30 saniyesinin çalacağını seçin. Kademeli ses açıksa bölüm kısık başlar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the slider to choose which 30 seconds of the song play. If gradual volume is on, the part starts quietly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie mit dem Regler, welche 30 Sekunden des Titels erklingen. Ist ansteigende Lautstärke an, beginnt der Ausschnitt leise."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüşdürücü ilə mahnının hansı 30 saniyəsinin səslənəcəyini seçin. \"Tədricən yüksələn səs\" açıqdırsa, hissə zəif başlayır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بشريط التمرير أي 30 ثانية من الأغنية ستُسمع. إذا كان «صوت متصاعد» مفعّلًا يبدأ الجزء هادئًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan penggeser, pilih 30 detik lagu yang diputar. Jika volume bertahap aktif, potongan dimulai pelan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سلائیڈر سے چنیں کہ گانے کے کون سے 30 سیکنڈ بجیں۔ اگر بتدریج آواز آن ہو تو حصہ دھیمے سے شروع ہوتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با لغزنده برگزینید کدام 30 ثانیهٔ آهنگ پخش شود. اگر افزایش تدریجی صدا روشن باشد، بخش انتخابی آرام آغاز می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le curseur, choisissez les 30 secondes du morceau à jouer. Si le volume progressif est activé, l’extrait commence doucement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ползунком выберите, какие 30 секунд песни будут звучать. Если включена нарастающая громкость, отрывок начинается тихо."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライダーで曲のどの30秒を流すか選びます。「だんだん大きく」がオンなら、区間は小さな音から始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이더로 곡의 어느 30초를 재생할지 고르세요. \"점점 크게\"가 켜져 있으면 구간이 작게 시작합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用滑块选择播放歌曲中的哪30秒。如果开启了音量渐强，片段会从轻声开始。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang slider para piliin kung aling 30 segundo ng kanta ang tutugtog. Kung naka-on ang unti-unting paglakas, mahina ang simula ng bahagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้แถบเลื่อนเพื่อเลือกว่าจะเล่นช่วง 30 วินาทีใดของเพลง หากเปิด \"ค่อย ๆ ดังขึ้น\" ไว้ ช่วงนั้นจะเริ่มเบา ๆ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use el control deslizante para elegir qué 30 segundos de la canción suenan. Si el volumen gradual está activado, el fragmento empieza bajo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o controle deslizante para escolher quais 30 segundos da música tocam. Se o volume gradual estiver ativado, o trecho começa baixo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्लाइडर से चुनें कि गाने के कौन-से 30 सेकंड बजें। धीरे-धीरे बढ़ती आवाज़ चालू हो तो हिस्सा धीमी आवाज़ से शुरू होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গানের কোন 30 সেকেন্ড বাজবে তা স্লাইডার দিয়ে বাছুন। ধীরে বাড়া শব্দ চালু থাকলে অংশটি আস্তে শুরু হয়।"
          }
        }
      }
    },
