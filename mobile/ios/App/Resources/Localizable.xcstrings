          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্ণ পর্দা ও রাত মোড"
          }
        }
      }
    },
    "onboard.full.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekran düğmesine dokunun ya da telefonu yan çevirin; saat bütün ekranı kaplar. Gece modunda yazı kısık kırmızıya döner, yatak başında göz almaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Full screen or turn your phone sideways and the clock fills the screen. Night mode turns it a dim red that won't dazzle you at the bedside."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf Vollbild oder drehen Sie das Telefon quer, dann füllt die Uhr den Bildschirm. Im Nachtmodus leuchtet sie gedämpft rot und blendet am Bett nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekran düyməsinə toxunun və ya telefonu yan çevirin; saat bütün ekranı tutur. Gecə rejimində yazı sönük qırmızı olur, çarpayı başında göz qamaşdırmır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس «ملء الشاشة» أو أدر الهاتف أفقيًا فتملأ الساعة الشاشة. في الوضع الليلي يصبح لونها أحمر خافتًا لا يزعج العين بجانب السرير."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Layar penuh atau putar ponsel ke samping, jam akan memenuhi layar. Mode malam membuatnya merah redup sehingga tidak menyilaukan di samping tempat tidur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوری اسکرین کو چھوئیں یا فون کو آڑا کریں، گھڑی پوری اسکرین پر آ جائے گی۔ رات کے موڈ میں رنگ مدھم سرخ ہو جاتا ہے اور بستر کے پاس آنکھوں کو نہیں چبھتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی «تمام‌صفحه» بزنید یا گوشی را افقی کنید تا ساعت کل صفحه را بگیرد. در حالت شب رنگ آن قرمز کم‌نور می‌شود و کنار تخت چشم را نمی‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Plein écran ou tournez le téléphone à l'horizontale : l'horloge occupe tout l'écran. Le mode nuit la passe en rouge tamisé qui n'éblouit pas au chevet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Во весь экран» или поверните телефон горизонтально — часы займут весь экран. В ночном режиме они светятся тусклым красным и не слепят у кровати."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「全画面」をタップするか、スマホを横にすると時計が画面いっぱいに表示されます。ナイトモードでは暗い赤色になり、枕元でもまぶしくありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면을 누르거나 휴대폰을 가로로 돌리면 시계가 화면을 가득 채웁니다. 야간 모드에서는 은은한 빨간색으로 바뀌어 머리맡에서도 눈부시지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“全屏”或把手机横过来，时钟就会占满屏幕。夜间模式会变成暗红色，放在床头也不刺眼。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang Full screen o ipahiga ang telepono, at sasakupin ng orasan ang buong screen. Sa night mode, nagiging malamlam na pula ito kaya hindi nakasisilaw sa tabi ng kama."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเต็มจอหรือหมุนโทรศัพท์เป็นแนวนอน นาฬิกาจะเต็มหน้าจอ โหมดกลางคืนจะเป็นสีแดงสลัว ไม่แสบตาเมื่อวางข้างเตียง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque Pantalla completa o gire el teléfono en horizontal y el reloj ocupará toda la pantalla. El modo nocturno lo vuelve de un rojo tenue que no deslumbra junto a la cama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Tela cheia ou gire o celular na horizontal e o relógio ocupa a tela toda. O modo noturno deixa tudo em um vermelho suave que não ofusca ao lado da cama."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ुल स्क्रीन को छुएँ या फ़ोन को आड़ा करें, घड़ी पूरी स्क्रीन पर आ जाएगी। रात्रि मोड में रंग हल्का लाल हो जाता है, बिस्तर के पास आँखें नहीं चुभतीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্ণ পর্দা চাপুন বা ফোন পাশে ঘোরান, ঘড়ি পুরো পর্দা জুড়ে যাবে। রাত মোড এটিকে ম্লান লাল করে, যা বিছানার পাশে চোখ ধাঁধায় না।"
          }
        }
      }
    },
    "onboard.all.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer her şey Tümü'nde"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything else is under All"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles Weitere unter „Alle“"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qalan hər şey \"Hamısı\" bölməsində"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما تبقّى في «الكل»"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selebihnya ada di Semua"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باقی سب کچھ «سب» میں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بقیهٔ همه‌چیز در «همه»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le reste est dans « Tout »"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остальное — во вкладке «Все»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのすべては「すべて」に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나머지는 모두 '전체'에"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其余一切都在“全部”里"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa Lahat ang lahat ng iba pa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างที่เหลืออยู่ใน \"ทั้งหมด\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo demás está en «Todo»"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o resto está em \"Tudo\""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाक़ी सब कुछ «सब» में"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাকি সবকিছু সব-এ"
          }
        }
      }
    },
    "onboard.all.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt çubuktaki Tümü'nde bütün araçlar, arama ve Ayarlar var; sık kullandıklarınızı uzun basarak öne alın. Saatin altına tarih, vakit ya da hava eklemek için: Ayarlar › Saat ekranını düzenle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All in the bottom bar has every tool, search and Settings; long-press your favourites to pin them at the top. To add the date, prayer times or weather under the clock: Settings › Edit clock screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Alle“ in der unteren Leiste finden Sie alle Werkzeuge, die Suche und die Einstellungen; halten Sie Favoriten gedrückt, um sie oben anzuheften. Datum, Gebetszeiten oder Wetter unter der Uhr: Einstellungen › Uhrbildschirm bearbeiten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt paneldəki \"Hamısı\" bölməsində bütün alətlər, axtarış və Parametrlər var; tez-tez istifadə etdiklərinizi uzun basaraq önə çəkin. Saatın altına tarix, vaxt və ya hava əlavə etmək üçün: Parametrlər › Saat ekranını redaktə et."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في «الكل» بالشريط السفلي كل الأدوات والبحث والإعدادات؛ اضغط مطولًا على ما تستخدمه كثيرًا لتثبيته في الأعلى. لإضافة التاريخ أو أوقات الصلاة أو الطقس تحت الساعة: الإعدادات › تعديل شاشة الساعة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua di bilah bawah berisi semua alat, pencarian, dan Pengaturan; tekan lama favorit Anda untuk menyematkannya di atas. Untuk menambahkan tanggal, waktu salat, atau cuaca di bawah jam: Pengaturan › Edit layar jam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیچے کی پٹی میں «سب» میں تمام ٹولز، تلاش اور ترتیبات ہیں؛ پسندیدہ چیزوں کو اوپر رکھنے کے لیے دیر تک دبائیں۔ گھڑی کے نیچے تاریخ، نماز کے اوقات یا موسم شامل کرنے کے لیے: ترتیبات › گھڑی کی اسکرین میں ترمیم۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در «همه» در نوار پایین همهٔ ابزارها، جست‌وجو و تنظیمات هست؛ موارد پرکاربرد را با لمس طولانی به بالا سنجاق کنید. برای افزودن تاریخ، اوقات نماز یا آب‌وهوا زیر ساعت: تنظیمات › ویرایش صفحهٔ ساعت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Tout », dans la barre du bas, réunit tous les outils, la recherche et les Réglages ; appuyez longuement sur vos favoris pour les épingler en haut. Pour ajouter la date, les heures de prière ou la météo sous l'horloge : Réglages › Modifier l'écran de l'horloge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во вкладке «Все» на нижней панели — все инструменты, поиск и настройки; удерживайте избранное, чтобы закрепить его сверху. Чтобы добавить под часы дату, время намаза или погоду: Настройки › Изменить экран часов."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のバーの「すべて」に、すべてのツール、検索、設定があります。よく使うものは長押しで上に固定できます。時計の下に日付、礼拝時刻、天気を表示するには：設定 › 時計画面を編集。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 막대의 '전체'에 모든 도구, 검색, 설정이 있습니다. 자주 쓰는 것은 길게 눌러 위에 고정하세요. 시계 아래에 날짜, 예배 시간, 날씨를 넣으려면: 설정 › 시계 화면 편집."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底部栏的“全部”里有所有工具、搜索和设置；长按常用项可将其固定在顶部。要在时钟下方添加日期、礼拜时间或天气：设置 › 编辑时钟屏幕。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa Lahat sa ibabang bar ang lahat ng tool, ang paghahanap at ang Settings; pindutin nang matagal ang mga paborito para i-pin sa itaas. Para magdagdag ng petsa, oras ng pagdarasal o panahon sa ilalim ng orasan: Settings › I-edit ang screen ng orasan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ทั้งหมด\" ในแถบด้านล่างมีเครื่องมือทุกอย่าง การค้นหา และการตั้งค่า กดค้างรายการที่ใช้บ่อยเพื่อปักหมุดไว้ด้านบน หากต้องการเพิ่มวันที่ เวลาละหมาด หรือสภาพอากาศใต้นาฬิกา: การตั้งค่า › แก้ไขหน้าจอนาฬิกา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En «Todo», en la barra inferior, están todas las herramientas, la búsqueda y los Ajustes; mantenga pulsados sus favoritos para fijarlos arriba. Para añadir la fecha, los horarios de oración o el tiempo bajo el reloj: Ajustes › Editar pantalla del reloj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em \"Tudo\", na barra inferior, ficam todas as ferramentas, a busca e os Ajustes; toque e segure seus favoritos para fixá-los no topo. Para pôr a data, os horários de oração ou o clima abaixo do relógio: Ajustes › Editar tela do relógio."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे की पट्टी में «सब» में सारे टूल, खोज और सेटिंग्स हैं; पसंदीदा चीज़ों को ऊपर पिन करने के लिए देर तक दबाएँ। घड़ी के नीचे तारीख़, नमाज़ के समय या मौसम जोड़ने के लिए: सेटिंग्स › घड़ी स्क्रीन संपादित करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিচের বারের সব-এ আছে প্রতিটি টুল, অনুসন্ধান ও সেটিংস; প্রিয়গুলো ওপরে রাখতে চেপে ধরুন। ঘড়ির নিচে তারিখ, নামাজের সময় বা আবহাওয়া যোগ করতে: সেটিংস › ঘড়ির পর্দা সম্পাদনা করুন।"
          }
        }
      }
    },
