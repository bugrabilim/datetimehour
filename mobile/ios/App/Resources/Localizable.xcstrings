        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블루문: %1$@ (같은 달의 두 번째 보름달)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝月：%1$@（同一公历月份的第二次满月）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Blue Moon: %1$@ (ikalawang kabilugan sa isang buwan ng kalendaryo)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บลูมูน: %1$@ (จันทร์เต็มดวงครั้งที่สองในเดือนเดียวกัน)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna azul: %1$@ (la segunda luna llena de un mes del calendario)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lua azul: %1$@ (a segunda lua cheia de um mês do calendário)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लू मून: %1$@ (किसी कैलेंडर महीने की दूसरी पूर्णिमा)।"
