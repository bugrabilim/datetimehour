    "list.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Tarih'teki yenilikleri e-postayla almak ister misiniz? İstediğiniz zaman tek tıkla ayrılabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want updates about Saat Tarih by email? You can unsubscribe at any time with one click."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie Neuigkeiten zu Saat Tarih per E-Mail erhalten? Sie können sich jederzeit mit einem Klick wieder abmelden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Tarih yenilikləri barədə e-poçtla məlumat almaq istəyirsiniz? İstənilən vaxt bir kliklə abunəlikdən çıxa bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد تلقي أخبار Saat Tarih عبر البريد الإلكتروني؟ يمكنك إلغاء الاشتراك في أي وقت بنقرة واحدة."
          }
        }
      }
    },
