    "tools.stopwatch.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz online kronometre: tur kaydı, en iyi ve en yavaş tur, tam ekran ve klavye kısayolları. Sayfayı yenileseniz de süre kaybolmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free online stopwatch: lap times, best and slowest lap, full screen and keyboard shortcuts. Your time is kept even if you reload the page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose Online-Stoppuhr: Rundenzeiten, schnellste und langsamste Runde, Vollbild und Tastenkürzel. Ihre Zeit bleibt auch beim Neuladen erhalten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsuz onlayn saniyəölçən: dövrə vaxtları, ən yaxşı və ən yavaş dövrə, tam ekran və klaviatura qısayolları. Səhifəni yeniləsəniz də vaxt itmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعة إيقاف مجانية على الإنترنت: أوقات اللفات، وأسرع لفة وأبطؤها، وملء الشاشة، واختصارات لوحة المفاتيح. ويُحفظ وقتك حتى لو أعدت تحميل الصفحة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopwatch daring gratis: waktu putaran, putaran terbaik dan terlama, layar penuh, dan pintasan papan ketik. Waktu Anda tetap tersimpan walaupun halaman dimuat ulang."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفت آن لائن اسٹاپ واچ: چکر کے اوقات، بہترین اور سست ترین چکر، پوری اسکرین اور کی بورڈ شارٹ کٹس۔ صفحہ دوبارہ لوڈ کرنے پر بھی آپ کا وقت محفوظ رہتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کرنومتر آنلاین رایگان: زمان دورها، بهترین و کندترین دور، تمام‌صفحه و میان‌برهای صفحه‌کلید. حتی اگر صفحه را تازه کنید زمان شما حفظ می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronomètre en ligne gratuit : temps au tour, meilleur tour et tour le plus lent, plein écran, raccourcis clavier. Temps conservé si vous rechargez la page."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный онлайн-секундомер: время кругов, лучший и самый медленный круг, полный экран и горячие клавиши. Время сохраняется после перезагрузки страницы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のオンライン ストップウォッチ：ラップタイム、最速・最遅ラップ、全画面、キーボードショートカット。ページを再読み込みしても時間は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 온라인 스톱워치: 랩 타임, 가장 빠른·느린 랩, 전체 화면, 키보드 단축키. 페이지를 새로 고쳐도 시간이 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费在线秒表：计圈时间、最快和最慢一圈、全屏和键盘快捷键。刷新页面后时间仍会保留。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Libreng online stopwatch: mga lap time, pinakamabilis at pinakamabagal na lap, full screen at keyboard shortcuts. Nananatili ang oras kahit i-reload ang pahina."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาจับเวลาออนไลน์ฟรี: เวลาแต่ละรอบ รอบเร็วสุดและช้าสุด เต็มหน้าจอ และคีย์ลัด เวลายังอยู่แม้โหลดหน้าใหม่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronómetro online gratis: tiempos de vuelta, vuelta más rápida y más lenta, pantalla completa y atajos de teclado. Su tiempo se conserva aunque recargue la página."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronômetro on-line grátis: tempos de volta, volta mais rápida e mais lenta, tela cheia e atalhos de teclado. Seu tempo é mantido mesmo se você recarregar a página."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त ऑनलाइन स्टॉपवॉच: लैप समय, सबसे तेज़ और सबसे धीमा लैप, फ़ुल स्क्रीन और कीबोर्ड शॉर्टकट। पेज दोबारा लोड करने पर भी आपका समय बना रहता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিনামূল্যের অনলাইন স্টপওয়াচ: ল্যাপের সময়, সবচেয়ে দ্রুত ও ধীর ল্যাপ, পূর্ণ পর্দা ও কীবোর্ড শর্টকাট। পাতা রিলোড করলেও সময় থেকে যায়।"
          }
        }
      }
    },
