        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos efforts ont payé : félicitations."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш труд принёс плоды — поздравляю."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "努力が実りましたね。おめでとうございます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노력의 결실을 맺었네요. 축하합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "努力终有回报，恭喜！"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbunga ang iyong pagsisikap; binabati kita."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความพยายามของคุณสัมฤทธิ์ผลแล้ว ขอแสดงความยินดี"
