    "tools.stopwatch.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz online kronometre: tur kaydı, en iyi ve en yavaş tur, tam ekran ve klavye kısayolları. Sayfayı yenileseniz de süre kaybolmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free online stopwatch: lap times, best and slowest lap, full screen and keyboard shortcuts. Your time is kept even if you reload the page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose Online-Stoppuhr: Rundenzeiten, schnellste und langsamste Runde, Vollbild und Tastenkürzel. Ihre Zeit bleibt auch beim Neuladen erhalten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsuz onlayn saniyəölçən: dövrə vaxtları, ən yaxşı və ən yavaş dövrə, tam ekran və klaviatura qısayolları. Səhifəni yeniləsəniz də vaxt itmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعة إيقاف مجانية على الإنترنت: أوقات اللفات، وأسرع لفة وأبطؤها، وملء الشاشة، واختصارات لوحة المفاتيح. ويُحفظ وقتك حتى لو أعدت تحميل الصفحة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopwatch daring gratis: waktu putaran, putaran terbaik dan terlambat, layar penuh, dan pintasan papan ketik. Waktu Anda tetap tersimpan walaupun halaman dimuat ulang."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفت آن لائن اسٹاپ واچ: چکر کے اوقات، بہترین اور سست ترین چکر، پوری اسکرین اور کی بورڈ شارٹ کٹس۔ صفحہ دوبارہ لوڈ کرنے پر بھی آپ کا وقت محفوظ رہتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کرنومتر آنلاین رایگان: زمان دورها، بهترین و کندترین دور، تمام‌صفحه و میان‌برهای صفحه‌کلید. حتی اگر صفحه را تازه کنید زمان شما حفظ می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronomètre en ligne gratuit : temps au tour, meilleur et plus lent tour, plein écran et raccourcis clavier. Votre temps est conservé même si vous rechargez la page."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный онлайн-секундомер: время кругов, лучший и самый медленный круг, полноэкранный режим и горячие клавиши. Время сохраняется даже после перезагрузки страницы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のオンライン ストップウォッチ：ラップタイム、最速・最遅ラップ、全画面、キーボードショートカット。ページを再読み込みしても時間は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 온라인 스톱워치: 랩 타임, 가장 빠른·느린 랩, 전체 화면, 키보드 단축키. 페이지를 새로 고쳐도 시간이 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费在线秒表：计圈时间、最快和最慢一圈、全屏和键盘快捷键。刷新页面后时间仍会保留。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Libreng online stopwatch: mga lap time, pinakamabilis at pinakamabagal na lap, full screen at keyboard shortcuts. Nananatili ang oras kahit i-reload ang pahina."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาจับเวลาออนไลน์ฟรี: เวลาแต่ละรอบ รอบเร็วสุดและช้าสุด เต็มหน้าจอ และคีย์ลัด เวลายังอยู่แม้โหลดหน้าใหม่"
          }
        }
      }
    },
