          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رد کردن این هشدار"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauter cette alarme"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропустить этот будильник"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアラームをスキップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 알람 건너뛰기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过这次闹钟"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Laktawan ang alarmang ito"
          }
        },
        "th": {
