      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arapça metin İmam Nevevî'nin Kırk Hadis'inden (kamu malı açık veri). Anlamlar Saat Tarih'in çevirisidir; ayrıntılı açıklama için bir din görevlisine danışın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arabic text from Imam an-Nawawi's Forty Hadith (public domain open data). The meanings are Saat Tarih's translation; consult a scholar for detailed explanation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arabischer Text aus den Vierzig Hadithen von Imam an-Nawawi (gemeinfreie offene Daten). Die Bedeutungen sind die Übersetzung von Saat Tarih; für ausführliche Erläuterungen wenden Sie sich an einen Gelehrten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ərəb mətni İmam Nəvəvinin Qırx hədisindən (ictimai mülkiyyətdə açıq məlumat). Mənalar Saat Tarih-in tərcüməsidir; ətraflı izah üçün din xadiminə müraciət edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص من الأربعين النووية للإمام النووي (بيانات مفتوحة في الملك العام)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks Arab dari Hadis Arbain Imam an-Nawawi (data terbuka, domain publik). Maknanya terjemahan Saat Tarih; untuk penjelasan rinci, tanyakan kepada ulama."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عربی متن امام نووی کی اربعین سے (کھلا ڈیٹا، پبلک ڈومین)۔ معانی Saat Tarih کا ترجمہ ہیں؛ تفصیلی شرح کے لیے کسی عالم سے رجوع کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متن عربی از اربعین امام نووی (دادهٔ باز، مالکیت عمومی). معانی ترجمهٔ Saat Tarih است؛ برای شرح مفصل از عالم دینی بپرسید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte arabe tiré des Quarante hadiths de l’imam an-Nawawi (données ouvertes, domaine public). Les sens sont une traduction de Saat Tarih ; pour une explication détaillée, consultez un savant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Арабский текст из «Сорока хадисов» имама ан-Навави (открытые данные, общественное достояние). Значения — перевод Saat Tarih; за подробным толкованием обратитесь к знающему человеку."
          }
        }
      }
    },
