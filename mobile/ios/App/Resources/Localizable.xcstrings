          }
        }
      }
    },
    "features.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat her zaman açık. Açtığın özellikler alt çubukta görünür; hepsi kapalıysa alt çubuk gizlenir, ayarlar saat ekranındaki dişliden açılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is always on. Features you turn on appear in the bottom bar; with all of them off the bar is hidden and settings open from the gear on the clock screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr ist immer an. Eingeschaltete Funktionen erscheinen in der unteren Leiste; sind alle aus, wird die Leiste ausgeblendet und die Einstellungen öffnen sich über das Zahnrad auf dem Uhrbildschirm."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat həmişə açıqdır. Açdığın xüsusiyyətlər alt zolaqda görünür; hamısı bağlı olduqda alt zolaq gizlənir, ayarlar saat ekranındakı dişli ilə açılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة مفعّلة دائمًا. تظهر الميزات التي تفعّلها في الشريط السفلي؛ وإذا عُطّلت كلها يختفي الشريط وتُفتح الإعدادات من رمز الترس في شاشة الساعة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam selalu aktif. Fitur yang Anda nyalakan muncul di bilah bawah; jika semuanya mati, bilah disembunyikan dan pengaturan dibuka dari ikon roda gigi di layar jam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی ہمیشہ آن رہتی ہے۔ آپ کی آن کی ہوئی خصوصیات نیچے کی بار میں دکھتی ہیں؛ سب بند ہوں تو بار چھپ جاتی ہے اور ترتیبات گھڑی کی اسکرین کے گیئر سے کھلتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت همیشه روشن است. ویژگی‌هایی که روشن می‌کنید در نوار پایین ظاهر می‌شوند؛ اگر همه خاموش باشند نوار پنهان است و تنظیمات از چرخ‌دندهٔ صفحهٔ ساعت باز می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’horloge est toujours active. Les fonctions que vous activez apparaissent dans la barre du bas ; si elles sont toutes désactivées, la barre est masquée et les réglages s’ouvrent avec la roue dentée de l’écran de l’horloge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы включены всегда. Включённые функции появляются в нижней панели; если все выключены, панель скрыта, а настройки открываются шестерёнкой на экране часов."
          }
        }
      }
    },
    "features.clock.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman açık: 20 saat modeli, tam ekran, saat ekranı alanları"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always on: 20 clock styles, full screen, clock screen items"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer an: 20 Uhrenmodelle, Vollbild, Felder auf dem Uhrbildschirm"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həmişə açıq: 20 saat modeli, tam ekran, saat ekranı sahələri"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفعّلة دائمًا: 20 نمطًا للساعة وملء الشاشة وعناصر شاشة الساعة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu aktif: 20 gaya jam, layar penuh, item layar jam"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہمیشہ آن: گھڑی کے 20 انداز، پوری اسکرین، گھڑی کی اسکرین کی چیزیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همیشه روشن: 20 سبک ساعت، تمام‌صفحه، موارد صفحهٔ ساعت"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours active : 20 styles d’horloge, plein écran, éléments de l’écran de l’horloge"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда включено: 20 стилей часов, полный экран, элементы экрана часов"
          }
        }
      }
    },
    "features.weather.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlık hava, saatlik ve 7 günlük tahmin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current conditions, hourly and 7-day forecast"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelles Wetter, stündliche und 7-Tage-Vorhersage"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari hava, saatlıq və 7 günlük proqnoz"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطقس الحالي والتوقعات بالساعة ولسبعة أيام"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuaca saat ini, prakiraan per jam dan 7 hari"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودہ حال، گھنٹہ وار اور 7 دن کی پیش گوئی"
          }
        },
        "fa": {
