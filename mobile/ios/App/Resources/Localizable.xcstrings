    "guide.pic.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çizimler temsilîdir; farklar Hanefî mezhebine göredir (Diyanet)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawings are illustrative; differences follow the Hanafi school (Diyanet)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeichnungen sind schematisch; Unterschiede nach der hanafitischen Schule (Diyanet)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rəsmlər şərtidir; fərqlər Hənəfi məzhəbinə görədir (Diyanət)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرسوم توضيحية؛ والفروق وفق المذهب الحنفي (ديانت)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar bersifat ilustrasi; perbedaan mengikuti mazhab Hanafi (Diyanet)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر وضاحتی ہیں؛ فرق حنفی مسلک کے مطابق ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر نمادین‌اند؛ تفاوت‌ها طبق مذهب حنفی است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessins indicatifs ; les différences suivent l'école hanafite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисунки схематичны; различия по ханафитскому мазхабу."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図はイメージです。違いはハナフィー派によります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림은 예시이며 차이는 하나피 학파를 따릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示仅供参考；差异依据哈乃斐学派。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Paglalarawan lamang ang mga guhit; ayon sa mazhab Hanafi ang mga pagkakaiba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพเป็นเพียงตัวอย่าง ความต่างเป็นไปตามมัซฮับฮะนะฟี"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dibujos son orientativos; las diferencias siguen la escuela hanafí (Diyanet)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os desenhos são ilustrativos; as diferenças seguem a escola hanafita (Diyanet)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्र केवल समझाने के लिए हैं; अंतर हनफ़ी मसलक (दियानत) के अनुसार हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিগুলো বোঝানোর জন্য; পার্থক্যগুলো হানাফি মাজহাব (দিয়ানেত) অনুযায়ী।"
          }
        }
      }
    },
    "guide.pic.m.1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkekler ellerini başparmaklar kulak memelerine değecek kadar kaldırır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Men raise their hands until the thumbs touch the earlobes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Männer heben die Hände, bis die Daumen die Ohrläppchen berühren."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişilər əllərini baş barmaqları qulaq məməsinə dəyənə qədər qaldırır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرفع الرجال أيديهم حتى تلامس الإبهامان شحمتي الأذنين."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laki-laki mengangkat tangan hingga ibu jari menyentuh cuping telinga."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مرد ہاتھ اتنے اٹھاتے ہیں کہ انگوٹھے کانوں کی لو کو چھوئیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مردان دست‌ها را تا جایی بالا می‌برند که شست‌ها به نرمه گوش برسد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hommes lèvent les mains jusqu'à ce que les pouces touchent les lobes des oreilles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мужчины поднимают руки, пока большие пальцы не коснутся мочек ушей."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "男性は親指が耳たぶに触れるまで手を上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남성은 엄지가 귓불에 닿을 때까지 손을 올립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "男性举手至拇指触及耳垂。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinataas ng lalaki ang kamay hanggang dumampi ang hinlalaki sa dulo ng tainga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ชายยกมือจนนิ้วโป้งแตะติ่งหู"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hombres levantan las manos hasta que los pulgares tocan los lóbulos de las orejas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os homens levantam as mãos até os polegares tocarem os lóbulos das orelhas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुरुष हाथ इतने उठाते हैं कि अँगूठे कान की लौ को छू लें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুরুষেরা বুড়ো আঙুল কানের লতি ছোঁয়া পর্যন্ত হাত তোলেন।"
          }
        }
      }
    },
