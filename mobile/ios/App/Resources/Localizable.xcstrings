    "wakegame.awakeText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün birlikte uyandık. Yarın da görüşürüz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We woke up together today. See you again tomorrow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute sind wir zusammen aufgewacht. Bis morgen!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün birlikdə oyandıq. Sabah da görüşərik."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيقظنا معًا اليوم. نلتقي غدًا أيضًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari ini kita bangun bersama. Sampai jumpa besok."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج ہم ساتھ جاگے۔ کل پھر ملیں گے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امروز با هم بیدار شدیم. فردا هم می‌بینمت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd'hui, on s'est réveillés ensemble. À demain !"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня мы проснулись вместе. До завтра!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は一緒に起きられたね。また明日。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 함께 일어났어요. 내일 또 만나요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天我们一起醒来了，明天见。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabay tayong nagising ngayon. Kita tayo bukas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้เราตื่นพร้อมกันแล้ว พรุ่งนี้เจอกันนะ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy nos despertamos juntos. Nos vemos mañana también."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje acordamos juntos. Até amanhã!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज हम साथ जागे। कल फिर मिलेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ আমরা একসঙ্গে জেগেছি। কাল আবার দেখা হবে।"
          }
        }
      }
    },
