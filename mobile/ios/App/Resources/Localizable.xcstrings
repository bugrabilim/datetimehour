    "notify.cat.bedtime.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku planı kuruluysa yatma saatinden önce hatırlatır (Araçlar › Uyku)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminds you before bedtime if a sleep schedule is set (Tools › Sleep)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert vor der Schlafenszeit, wenn ein Schlafplan eingerichtet ist (Werkzeuge › Schlaf)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuxu planı qurulubsa, yatma vaxtından əvvəl xatırladır (Alətlər › Yuxu)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكّرك قبل وقت النوم إذا كان جدول النوم مضبوطًا (الأدوات › النوم)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengingatkan sebelum waktu tidur jika jadwal tidur dipasang (Alat › Tidur)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر نیند کا شیڈول طے ہو (ٹولز › نیند) تو سونے کے وقت سے پہلے یاد دلاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر برنامهٔ خواب تنظیم شده باشد (ابزارها › خواب)، پیش از وقت خواب یادآوری می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous le rappelle avant l’heure du coucher si un programme de sommeil est défini (Outils › Sommeil)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминает перед временем сна, если задан режим сна (Инструменты › Сон)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠スケジュールを設定していれば（ツール › 睡眠）、就寝前に知らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 일정을 정해 두었다면(도구 › 수면) 잠자리에 들기 전에 알려 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果设置了睡眠计划（工具 › 睡眠），会在就寝前提醒您。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinapaalalahanan ka bago ang oras ng pagtulog kung may sleep schedule (Kagamitan › Tulog)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตือนก่อนเวลานอนหากตั้งตารางการนอนไว้ (เครื่องมือ › การนอน)"
          }
        }
      }
    },
