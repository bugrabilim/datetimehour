        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "June is named after Juno, queen of the Roman gods."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Juni: nach Juno, der Königin der römischen Götter."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İyun Roma tanrılarının kraliçası Yunonanın adını daşıyır."
