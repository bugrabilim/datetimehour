    "account.closed": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üyelik şu an kapalı. Biraz sonra yeniden deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Membership is closed at the moment. Please try again later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitgliedschaft ist gerade geschlossen. Bitte versuchen Sie es später erneut."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzvlük hazırda bağlıdır. Bir az sonra yenidən cəhd edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العضوية مغلقة حاليًا. أعد المحاولة بعد قليل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keanggotaan sedang ditutup. Silakan coba lagi nanti."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رکنیت فی الحال بند ہے۔ کچھ دیر بعد دوبارہ کوشش کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عضویت فعلاً بسته است. کمی بعد دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adhésion est fermée pour le moment. Réessayez un peu plus tard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрация сейчас закрыта. Попробуйте чуть позже."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、会員登録は停止中です。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 회원 가입이 닫혀 있습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会员注册目前已关闭。请稍后再试。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarado muna ang membership. Subukan ulit mamaya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้ปิดรับสมัครสมาชิก โปรดลองใหม่ภายหลัง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro está cerrado por ahora. Inténtelo de nuevo más tarde."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O cadastro está fechado no momento. Tente de novo mais tarde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यता अभी बंद है। थोड़ी देर बाद फिर कोशिश करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সদস্যপদ এখন বন্ধ আছে। একটু পরে আবার চেষ্টা করুন।"
          }
        }
      }
    },
