    "prayer.imNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakitler hesaplanmıştır; resmî vakit için Diyanet İşleri Başkanlığı esas alınır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times are calculated; for official times follow the Presidency of Religious Affairs (Diyanet)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeiten sind berechnet; maßgeblich sind die Angaben des Präsidiums für religiöse Angelegenheiten (Diyanet)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtlar hesablanmışdır; rəsmi vaxt üçün Diyanət İşləri Başqanlığının məlumatı əsasdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأوقات محسوبة؛ والمعتمد هو ما تنشره رئاسة الشؤون الدينية (ديانت)."
          }
        }
      }
    },
