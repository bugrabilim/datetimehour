    "sleep.plan.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkış saatinizden ve istediğiniz uyku süresinden yatma saati hesaplanır; isterseniz yatmadan önce hatırlatılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bedtime is worked out from your wake-up time and how long you want to sleep; you can get a reminder before bed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlafenszeit wird aus Ihrer Weckzeit und der gewünschten Schlafdauer berechnet; auf Wunsch werden Sie vorher erinnert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatma vaxtı oyanma saatınızdan və istədiyiniz yuxu müddətindən hesablanır; istəsəniz yatmazdan əvvəl xatırladılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحسب وقت النوم من وقت الاستيقاظ ومدة النوم التي تريدها، ويمكن أن تتلقى تذكيرًا قبل النوم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu tidur dihitung dari jam bangun dan lama tidur yang Anda inginkan; Anda bisa mendapat pengingat sebelum tidur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سونے کا وقت آپ کے جاگنے کے وقت اور مطلوبہ نیند کی مدت سے نکالا جاتا ہے؛ آپ سونے سے پہلے یاد دہانی لے سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت خواب از ساعت بیداری و مدت خوابی که می‌خواهید حساب می‌شود؛ می‌توانید پیش از خواب یادآوری بگیرید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure du coucher est calculée d’après votre heure de réveil et la durée de sommeil voulue ; vous pouvez recevoir un rappel avant d’aller au lit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время отхода ко сну считается по времени подъёма и желаемой длительности сна; перед сном может приходить напоминание."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる時刻と眠りたい時間から就寝時刻を割り出し、寝る前に知らせを受け取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기상 시간과 원하는 수면 시간으로 취침 시간을 계산하며, 자기 전에 알림을 받을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据起床时间和想睡的时长算出就寝时间；睡前可以收到提醒。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinukuwenta ang oras ng pagtulog mula sa oras ng paggising at kung gaano katagal mo gustong matulog; maaari kang makatanggap ng paalala bago matulog."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำนวณเวลานอนจากเวลาตื่นและระยะเวลาที่อยากนอน และรับการเตือนก่อนนอนได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su hora de acostarse se calcula a partir de la hora de despertar y de cuánto quiere dormir; puede recibir un aviso antes de acostarse."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu horário de dormir é calculado a partir do horário de acordar e de quanto você quer dormir; você pode receber um lembrete antes de deitar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जागने के समय और आपकी चाही नींद की अवधि से सोने का समय निकाला जाता है; चाहें तो सोने से पहले आपको याद दिलाया जाएगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জাগার সময় ও কতক্ষণ ঘুমাতে চান তা থেকে শোয়ার সময় বের করা হয়; শোয়ার আগে রিমাইন্ডার পেতে পারেন।"
          }
        }
      }
    },
