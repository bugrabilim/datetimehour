    "google.step1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da Ayarlar uygulamasını açın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Settings app on your iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die Einstellungen-App auf dem iPhone."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-da Parametrlər tətbiqini açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح تطبيق الإعدادات على iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka aplikasi Pengaturan di iPhone Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے آئی فون پر ترتیبات ایپ کھولیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامهٔ تنظیمات را در آیفون باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app Réglages de votre iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение «Настройки» на iPhone."
          }
        }
      }
    },
    "google.step2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar › Takvim › Takvim Hesapları'na girin (eski iOS'ta Takvim › Hesaplar)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Apps › Calendar › Calendar Accounts (on older iOS: Calendar › Accounts)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie zu Apps › Kalender › Kalenderaccounts (bei älterem iOS: Kalender › Accounts)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqlər › Təqvim › Təqvim hesabları bölməsinə keçin (köhnə iOS-da Təqvim › Hesablar)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى التطبيقات › التقويم › حسابات التقويم (في إصدارات iOS الأقدم: التقويم › الحسابات)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Apps › Kalender › Akun Kalender (di iOS lama: Kalender › Akun)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپس › کیلنڈر › کیلنڈر اکاؤنٹس میں جائیں (پرانے iOS پر: کیلنڈر › اکاؤنٹس)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به برنامه‌ها › تقویم › حساب‌های تقویم بروید (در iOSهای قدیمی‌تر: تقویم › حساب‌ها)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans Apps › Calendrier › Comptes de calendrier (sur les anciens iOS : Calendrier › Comptes)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите в Приложения › Календарь › Учётные записи календаря (в старых iOS: Календарь › Учётные записи)."
          }
        }
      }
    },
    "google.step3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap Ekle › Google'ı seçin ve Google hesabınızla giriş yapın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Add Account › Google and sign in with your Google account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Account hinzufügen › Google und melden Sie sich mit Ihrem Google-Konto an."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesab əlavə et › Google seçin və Google hesabınızla daxil olun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر إضافة حساب › Google وسجّل الدخول بحساب Google."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Tambah Akun › Google dan masuk dengan akun Google Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹ شامل کریں › Google منتخب کریں اور اپنے گوگل اکاؤنٹ سے سائن ان کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "افزودن حساب › Google را برگزینید و با حساب گوگل خود وارد شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Ajouter un compte › Google et connectez-vous avec votre compte Google."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Добавить учётную запись» › Google и войдите в свой аккаунт Google."
          }
        }
      }
    },
    "google.step4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimler anahtarının açık olduğundan emin olun ve kaydedin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the Calendars switch is on, then save."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achten Sie darauf, dass der Schalter Kalender aktiviert ist, und sichern Sie."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təqvimlər açarının açıq olduğuna əmin olun və yadda saxlayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من تفعيل مفتاح التقويمات ثم احفظ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan sakelar Kalender menyala, lalu simpan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یقینی بنائیں کہ کیلنڈرز کا سوئچ آن ہے، پھر محفوظ کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مطمئن شوید کلید تقویم‌ها روشن است، سپس ذخیره کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que l’interrupteur Calendriers est activé, puis enregistrez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что переключатель «Календари» включён, и сохраните."
          }
        }
      }
    },
    "google.step5": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya dönüp “Telefonumdaki takvimleri göster” düğmesine dokunun ve izin verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back here, tap “Show calendars on my phone” and allow access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehren Sie hierher zurück, tippen Sie auf „Kalender auf meinem Telefon anzeigen“ und erlauben Sie den Zugriff."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bura qayıdın, “Telefonumdakı təqvimləri göstər” düyməsinə toxunun və icazə verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عد إلى هنا واضغط «اعرض التقويمات على هاتفي» ثم اسمح بالوصول."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke sini, ketuk \"Tampilkan kalender di ponsel saya\" dan izinkan akses."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں واپس آئیں، «میرے فون کے کیلنڈر دکھائیں» پر ٹیپ کریں اور رسائی کی اجازت دیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به اینجا برگردید، «نمایش تقویم‌های گوشی» را بزنید و دسترسی را مجاز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez ici, touchez « Afficher les calendriers du téléphone » et autorisez l’accès."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь сюда, нажмите «Показать календари телефона» и разрешите доступ."
          }
        }
      }
    },
