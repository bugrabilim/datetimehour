    "sleep.cycles.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku yaklaşık 90 dakikalık döngülerle ilerler; uykuya dalmak için 15 dakika eklenir. Bir döngünün sonunda uyanmak daha kolay olabilir. Bu bir öneridir, tıbbi bilgi değildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep moves in cycles of about 90 minutes; 15 minutes are added to fall asleep. Waking at the end of a cycle may feel easier. This is a suggestion, not medical advice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlaf verläuft in Zyklen von etwa 90 Minuten; zum Einschlafen werden 15 Minuten addiert. Am Ende eines Zyklus aufzuwachen kann leichter fallen. Das ist ein Vorschlag, kein medizinischer Rat."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuxu təxminən 90 dəqiqəlik dövrlərlə gedir; yuxuya getmək üçün 15 dəqiqə əlavə olunur. Dövrün sonunda oyanmaq daha asan ola bilər. Bu tövsiyədir, tibbi məlumat deyil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسير النوم في دورات مدتها نحو 90 دقيقة، وتُضاف 15 دقيقة للخلود إلى النوم. قد يكون الاستيقاظ في نهاية دورة أسهل. هذا اقتراح وليس نصيحة طبية."
          }
        }
      }
    },
    "sleep.sounds.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesler telefonda üretilir, dosya indirilmez. Ekran kilitliyken de sürer; seçilen sürenin sonunda son 30 saniyede kısılarak kapanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds are generated on your phone, nothing is downloaded. They keep playing with the screen locked and fade out over the last 30 seconds of the chosen time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geräusche werden auf dem Telefon erzeugt, nichts wird heruntergeladen. Sie laufen auch bei gesperrtem Bildschirm weiter und werden in den letzten 30 Sekunden ausgeblendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səslər telefonda yaradılır, fayl endirilmir. Ekran kilidli olanda da davam edir və seçilən müddətin son 30 saniyəsində səsi azalaraq bağlanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُولَّد الأصوات على هاتفك ولا يُنزَّل أي ملف. تستمر والشاشة مقفلة وتخفت تدريجيًا في آخر 30 ثانية من المدة المختارة."
          }
        }
      }
    },
