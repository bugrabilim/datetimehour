        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "«دوسری ایپس کے اوپر دکھائیں» کی اجازت دیں ›"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازهٔ «نمایش روی برنامه‌های دیگر» ›"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser « Afficher par-dessus les autres applis » ›"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить «Поверх других приложений» ›"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「他のアプリの上に重ねて表示」を許可 ›"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
