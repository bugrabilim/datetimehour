    "prayer.silent.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili vakitlerden sonra telefon belirtilen süre boyunca titreşime ya da Rahatsız Etmeyin'e geçer, sonra önceki hâline döner. Rahatsız Etmeyin için Android bir kez izin ister."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the selected prayer times the phone switches to vibrate or Do Not Disturb for the chosen duration, then returns to its previous state. Do Not Disturb needs a one-time permission."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach den gewählten Gebetszeiten wechselt das Telefon für die gewählte Dauer auf Vibration oder Bitte nicht stören und kehrt danach zurück. Bitte nicht stören erfordert einmalig eine Berechtigung."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş vaxtlardan sonra telefon göstərilən müddət ərzində titrəməyə və ya Narahat etməyin rejiminə keçir, sonra əvvəlki vəziyyətinə qayıdır. Narahat etməyin üçün bir dəfə icazə lazımdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد المواقيت المختارة ينتقل الهاتف إلى الاهتزاز أو عدم الإزعاج للمدة المختارة ثم يعود. يتطلب عدم الإزعاج إذنًا لمرة واحدة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah waktu salat yang dipilih, ponsel beralih ke getar atau Jangan Ganggu selama durasi yang dipilih, lalu kembali ke keadaan semula. Jangan Ganggu memerlukan izin satu kali."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب اوقاتِ نماز کے بعد فون منتخب مدت کے لیے وائبریٹ یا «ڈسٹرب نہ کریں» پر چلا جاتا ہے، پھر پچھلی حالت پر لوٹ آتا ہے۔ «ڈسٹرب نہ کریں» کے لیے ایک بار اجازت درکار ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از اوقات نماز انتخابی، گوشی برای مدت انتخابی به لرزش یا «مزاحم نشوید» می‌رود و سپس به حالت پیشین برمی‌گردد. «مزاحم نشوید» یک بار اجازه می‌خواهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après les heures de prière choisies, le téléphone passe en vibreur ou en Ne pas déranger pour la durée choisie, puis revient à son état précédent. Ne pas déranger nécessite une autorisation unique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После выбранного времени намаза телефон переходит в режим вибрации или «Не беспокоить» на выбранное время, а затем возвращается в прежнее состояние. Для «Не беспокоить» нужно разовое разрешение."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ礼拝時刻の後、選んだ時間だけスマホがバイブまたはサイレントモードになり、その後元の状態に戻ります。サイレントモードには1回だけ許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기도 시간 뒤 정한 시간 동안 휴대폰이 진동이나 방해 금지로 바뀌고, 그 뒤 이전 상태로 돌아갑니다. 방해 금지에는 한 번 권한이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所选礼拜时间之后，手机会在选定时长内切换为振动或勿扰，然后恢复原来的状态。勿扰需要一次性授权。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagkatapos ng mga napiling oras ng dasal, lilipat ang telepono sa vibrate o Huwag Istorbohin sa napiling tagal, saka babalik sa dati. Kailangan ng Huwag Istorbohin ng isang beses na pahintulot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังเวลาละหมาดที่เลือก โทรศัพท์จะเปลี่ยนเป็นสั่นหรือห้ามรบกวนตามระยะเวลาที่เลือก แล้วกลับเป็นสถานะเดิม โหมดห้ามรบกวนต้องอนุญาตครั้งเดียว"
          }
        }
      }
    },
