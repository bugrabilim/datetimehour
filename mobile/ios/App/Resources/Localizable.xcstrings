    "meet.calendarHint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi takviminizdeki etkinlikleri burada görmek için Takvim'de \"Telefonumdaki takvimleri göster\"i açın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see your own events here, turn on “Show calendars on my phone” in Calendar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Ihre Termine hier zu sehen, aktivieren Sie im Kalender „Kalender auf meinem Telefon anzeigen“."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Öz tədbirlərinizi burada görmək üçün Təqvimdə \"Telefonumdakı təqvimləri göstər\"i açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لرؤية أحداثك هنا، فعّل «عرض التقاويم على هاتفي» في التقويم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat acara Anda di sini, aktifkan \"Tampilkan kalender di ponsel saya\" di Kalender."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی تقریبات یہاں دیکھنے کے لیے کیلنڈر میں \"میرے فون کے کیلنڈر دکھائیں\" آن کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای دیدن رویدادهای خود اینجا، در تقویم «نمایش تقویم‌های گوشی من» را روشن کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour voir vos événements ici, activez « Afficher les agendas du téléphone » dans Calendrier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы видеть здесь свои события, включите «Показать календари телефона» в Календаре."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の予定をここに表示するには、カレンダーで「端末のカレンダーを表示」をオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 일정을 여기에 보려면 캘린더에서 '내 휴대전화 캘린더 표시'를 켜세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在此查看你的活动，请在日历中打开“显示手机上的日历”。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para makita rito ang mga event mo, i-on ang “Ipakita ang mga kalendaryo sa phone ko” sa Kalendaryo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเห็นกิจกรรมของคุณที่นี่ ให้เปิด \"แสดงปฏิทินในโทรศัพท์\" ในปฏิทิน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver aquí sus propios eventos, active “Mostrar los calendarios de mi teléfono” en Calendario."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver aqui seus próprios eventos, ative “Mostrar os calendários do meu celular” em Calendário."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ अपने इवेंट देखने के लिए कैलेंडर में “मेरे फ़ोन के कैलेंडर दिखाएँ” चालू करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিজের ইভেন্ট এখানে দেখতে ক্যালেন্ডারে “আমার ফোনের ক্যালেন্ডার দেখান” চালু করুন।"
          }
        }
      }
    },
