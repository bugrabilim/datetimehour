            "value": "%1$@ مقابلے میں: ساری رات نظر آتا ہے، سال میں سب سے روشن"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ در مقابله: تمام شب دیده می‌شود و در پرنورترین حالت سال است"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ à l'opposition : visible toute la nuit, au plus brillant de l'année"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ в противостоянии: видна всю ночь, самая яркая в году"
