    "sky.eventsLead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteor yağmuru zirveleri, gezegenlerin ve Ay'ın yakınlaşmaları, karşı konumlar ve en büyük uzanımlar; saatler seçili yerin saatiyle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteor shower peaks, close approaches of the planets and the Moon, oppositions and greatest elongations; times are local to the selected place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maxima von Meteorströmen, Begegnungen von Planeten und Mond, Oppositionen und größte Elongationen; Uhrzeiten in der Zeitzone des gewählten Ortes."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteor yağışlarının zirvələri, planetlərin və Ayın yaxınlaşmaları, qarşıdurmalar və ən böyük uzanmalar; vaxtlar seçilmiş yerin saatı ilə."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذروات زخات الشهب، واقترانات الكواكب والقمر، والتقابلات وأقصى الاستطالات؛ الأوقات بتوقيت المكان المختار."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Puncak hujan meteor, pendekatan planet dan Bulan, oposisi, dan elongasi terbesar; waktu menurut lokasi yang dipilih."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شہابیوں کی بارش کا عروج، سیاروں اور چاند کا قریب آنا، مقابلہ اور سب سے بڑی دوری؛ اوقات منتخب جگہ کے وقت کے مطابق۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اوج بارش‌های شهابی، نزدیکی سیاره‌ها و ماه، مقابله‌ها و بیشترین کشیدگی‌ها؛ زمان‌ها به وقت مکان انتخاب‌شده."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pics des pluies de météores, rapprochements des planètes et de la Lune, oppositions et plus grandes élongations ; heures du lieu choisi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимумы метеорных потоков, сближения планет и Луны, противостояния и наибольшие элонгации; время — по выбранному месту."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "流星群の極大、惑星と月の接近、衝、最大離角。時刻は選択した場所の時刻です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유성우 극대, 행성과 달의 근접, 충과 최대 이각. 시간은 선택한 장소 기준입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流星雨极大、行星与月亮的相合、冲日和大距；时间为所选地点的当地时间。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Rurok ng mga meteor shower, paglapit ng mga planeta at ng Buwan, oposisyon at pinakamalaking elongasyon; oras ayon sa napiling lugar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงสูงสุดของฝนดาวตก ดาวเคราะห์และดวงจันทร์เข้าใกล้กัน ดาวเคราะห์ตรงข้ามดวงอาทิตย์ และมุมห่างมากที่สุด เวลาเป็นเวลาของสถานที่ที่เลือก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Máximos de lluvias de meteoros, acercamientos de los planetas y la Luna, oposiciones y máximas elongaciones; horas locales del lugar elegido."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Picos de chuvas de meteoros, aproximações dos planetas e da Lua, oposições e máximas elongações; horários no fuso do local escolhido."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उल्का वर्षा के चरम, ग्रहों और चंद्रमा का पास आना, विमुखता और अधिकतम दीर्घीकरण; समय चुने स्थान के समय में।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উল্কাবৃষ্টির চূড়া, গ্রহ ও চাঁদের কাছাকাছি আসা, প্রতিযোগ ও সর্বোচ্চ কৌণিক দূরত্ব; সময়গুলো বেছে নেওয়া জায়গার স্থানীয় সময়ে।"
          }
        }
      }
    },
