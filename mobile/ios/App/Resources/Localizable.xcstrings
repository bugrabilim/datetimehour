        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que a sua vida seja longa, saudável e cheia de bem."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी उम्र भलाई और सेहत के साथ लंबी हो।"
