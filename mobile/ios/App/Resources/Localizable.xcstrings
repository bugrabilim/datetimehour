          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ nişan yoxdur. Nişanlar telefon tətbiqində qazanılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شارات بعد. تُكسب الشارات في تطبيق الهاتف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada lencana. Lencana diperoleh di aplikasi ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی بیج نہیں۔ بیج فون ایپ میں حاصل ہوتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز نشانی ندارید. نشان‌ها در برنامهٔ گوشی به دست می‌آیند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de badge. Les badges se gagnent dans l'application mobile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значков пока нет. Значки зарабатываются в мобильном приложении."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだバッジはありません。バッジはスマートフォンアプリで獲得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 배지가 없습니다. 배지는 휴대전화 앱에서 얻습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有徽章。徽章在手机应用中获得。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang badge. Nakukuha ang mga badge sa phone app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีเหรียญตรา เหรียญตราได้จากแอปบนโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay insignias. Las insignias se ganan en la app del teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há selos. Os selos são conquistados no app do celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई बैज नहीं। बैज फ़ोन ऐप में मिलते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো ব্যাজ নেই। ব্যাজ ফোন অ্যাপে অর্জিত হয়।"
          }
        }
      }
    },
