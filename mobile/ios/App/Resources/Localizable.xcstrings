        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজের অ্যালার্মের জন্য iOS 26 বা পরের সংস্করণ লাগে; এই সংস্করণে নোটিফিকেশন ব্যবহৃত হয়।"
