    "perms.health.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsterseniz biten aralık antrenmanı sağlık uygulamanıza yazılır. Uygulama sağlık verilerinizi okumaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you wish, finished interval workouts are written to your health app. The app never reads your health data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Wunsch werden beendete Intervall-Trainings in Ihre Gesundheits-App geschrieben. Die App liest Ihre Gesundheitsdaten nie."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstəsəniz, bitən interval məşqi sağlamlıq tətbiqinizə yazılır. Tətbiq sağlamlıq məlumatlarınızı oxumur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن شئت، يُسجَّل تمرين الفترات المنتهي في تطبيق الصحة لديك. لا يقرأ التطبيق بياناتك الصحية أبدًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda mau, latihan interval yang selesai dicatat ke aplikasi kesehatan. Aplikasi tidak pernah membaca data kesehatan Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چاہیں تو مکمل وقفہ وار ورزش آپ کی صحت ایپ میں لکھ دی جائے گی۔ ایپ آپ کا صحت کا ڈیٹا نہیں پڑھتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر بخواهید، تمرین اینتروال تمام‌شده در برنامه‌ی سلامت شما ثبت می‌شود. برنامه هرگز داده‌های سلامت شما را نمی‌خواند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous le souhaitez, les entraînements fractionnés terminés sont inscrits dans votre app santé. L'appli ne lit jamais vos données de santé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По желанию завершённые интервальные тренировки записываются в приложение «Здоровье». Приложение никогда не читает ваши данные о здоровье."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "希望すれば、終わったインターバルトレーニングをヘルスケアアプリに記録します。健康データを読むことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하면 끝난 인터벌 운동을 건강 앱에 기록해요. 건강 데이터를 읽지는 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如您愿意，完成的间歇训练会写入健康应用。本应用从不读取您的健康数据。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung gusto mo, isusulat sa health app mo ang natapos na interval workout. Hindi kailanman binabasa ng app ang health data mo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการ การออกกำลังกายแบบเป็นช่วงที่จบแล้วจะถูกบันทึกลงแอปสุขภาพ แอปจะไม่อ่านข้อมูลสุขภาพของคุณ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo desea, los entrenamientos por intervalos terminados se guardan en su app de salud. La app nunca lee sus datos de salud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quiser, os treinos intervalados concluídos são gravados no seu app de saúde. O app nunca lê seus dados de saúde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चाहें तो पूरा हुआ इंटरवल वर्कआउट आपके सेहत ऐप में लिखा जाएगा। ऐप आपका सेहत का डेटा कभी नहीं पढ़ता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চাইলে শেষ হওয়া ইন্টারভাল ব্যায়াম আপনার স্বাস্থ্য অ্যাপে লেখা হয়। অ্যাপটি কখনো আপনার স্বাস্থ্য তথ্য পড়ে না।"
          }
        }
      }
    },
    "perms.music.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
