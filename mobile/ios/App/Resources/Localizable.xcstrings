        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تقریباً %1$@ بجے بارش متوقع ہے؛ چھتری نہ بھولیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حدود ساعت %1$@ باران پیش‌بینی می‌شود؛ چترتان را فراموش نکنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluie attendue vers %1$@ ; n'oubliez pas votre parapluie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Около %1$@ ожидается дождь; не забудьте зонт."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ごろ雨の見込み。傘をお忘れなく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@경 비가 예상됩니다. 우산을 챙기세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
