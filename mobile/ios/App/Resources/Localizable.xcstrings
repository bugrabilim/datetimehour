            "value": "ژوئن از نام ژونو، ملکهٔ خدایان رومی است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Juin vient de Junon, reine des dieux romains."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Июнь назван в честь Юноны, царицы римских богов."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水無月（みなづき）：「無」は「の」の意で、田に水を張る「水の月」とされます。"
          }
        },
        "ko": {
          "stringUnit": {
