    "perms.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her izin yalnız o özelliği ilk kullandığınızda sorulur. Bir izni kapatmak ya da açmak için satırına dokunun; telefonunuzun ayarları açılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each permission is requested only when you first use that feature. To turn one off or on, tap its row; your phone's settings open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Berechtigung wird erst abgefragt, wenn Sie die Funktion zum ersten Mal nutzen. Zum Ein- oder Ausschalten tippen Sie auf die Zeile; die Telefoneinstellungen öffnen sich."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər icazə yalnız o funksiyadan ilk dəfə istifadə edəndə soruşulur. İcazəni bağlamaq və ya açmaq üçün sətrinə toxunun; telefonunuzun parametrləri açılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُطلب أي إذن إلا عند أول استخدام للميزة. لإيقاف إذن أو تفعيله، المس سطره فتُفتح إعدادات هاتفك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap izin hanya diminta saat Anda pertama kali memakai fiturnya. Untuk mematikan atau menyalakan, ketuk barisnya; pengaturan ponsel akan terbuka."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر اجازت صرف تب مانگی جاتی ہے جب آپ وہ سہولت پہلی بار استعمال کریں۔ بند یا چالو کرنے کے لیے اس کی قطار پر ٹیپ کریں؛ فون کی ترتیبات کھل جائیں گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر مجوز فقط وقتی پرسیده می‌شود که آن ویژگی را برای اولین بار به کار ببرید. برای خاموش یا روشن کردن، روی ردیفش بزنید تا تنظیمات گوشی باز شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque autorisation n'est demandée qu'au premier usage de la fonction. Pour la retirer ou l'accorder, touchez sa ligne : les réglages du téléphone s'ouvrent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое разрешение запрашивается только при первом использовании функции. Чтобы выключить или включить его, коснитесь строки — откроются настройки телефона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可はその機能を初めて使うときにだけ確認します。オン・オフを変えるには行をタップすると、スマートフォンの設定が開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한은 그 기능을 처음 쓸 때만 요청해요. 끄거나 켜려면 해당 줄을 누르세요. 휴대폰 설정이 열려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每项权限只会在您第一次使用相应功能时请求。要关闭或开启，请轻点该行，手机设置会打开。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hihingin lang ang bawat pahintulot sa unang paggamit mo ng feature. Para isara o buksan ito, i-tap ang hilera; bubukas ang settings ng telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์แต่ละอย่างจะถูกขอเฉพาะเมื่อคุณใช้ฟีเจอร์นั้นครั้งแรก หากต้องการปิดหรือเปิด ให้แตะที่แถวนั้น แล้วการตั้งค่าโทรศัพท์จะเปิดขึ้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada permiso se pide solo la primera vez que usa esa función. Para desactivarlo o activarlo, toque su fila: se abrirán los ajustes del teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada permissão só é pedida quando você usa o recurso pela primeira vez. Para desativar ou ativar uma permissão, toque na linha dela; os ajustes do celular se abrem."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर अनुमति तभी माँगी जाती है जब आप वह सुविधा पहली बार इस्तेमाल करें। बंद या चालू करने के लिए उसकी पंक्ति पर टैप करें; फ़ोन की सेटिंग्स खुल जाएँगी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি অনুমতি শুধু সেই বৈশিষ্ট্য প্রথম ব্যবহারের সময় চাওয়া হয়। বন্ধ বা চালু করতে তার সারিতে চাপুন; আপনার ফোনের সেটিংস খুলবে।"
          }
        }
      }
    },
