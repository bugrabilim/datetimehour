    "look.bg.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gökyüzü seçili konumda Güneş'in yüksekliğine göre gündüz, gün doğumu/batımı ya da gece olur. Telefonda \"hareketi azalt\" açıksa hareketli arka planlar durağan görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sky follows the Sun's height at the selected location: day, sunrise/sunset or night. If \"reduce motion\" is on, animated backgrounds are shown still."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Himmel folgt dem Sonnenstand am gewählten Ort: Tag, Sonnenauf-/-untergang oder Nacht. Ist „Bewegung reduzieren“ an, bleiben bewegte Hintergründe still."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səma seçilmiş yerdə Günəşin hündürlüyünə görə gündüz, gün doğuşu/batışı və ya gecə olur. Telefonda \"hərəkəti azalt\" açıqdırsa hərəkətli arxa fonlar sabit görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع السماء ارتفاع الشمس في الموقع المحدد: نهار أو شروق/غروب أو ليل. إذا كان «تقليل الحركة» مفعّلًا تظهر الخلفيات المتحركة ثابتة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langit mengikuti ketinggian Matahari di tempat pilihan: siang, terbit/terbenam, atau malam. Jika \"kurangi gerakan\" aktif, latar animasi ditampilkan diam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آسمان منتخب جگہ پر سورج کی بلندی کے مطابق بدلتا ہے: دن، طلوع/غروب یا رات۔ اگر «حرکت کم کریں» آن ہو تو متحرک پس منظر ساکن دکھائے جاتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آسمان از ارتفاع خورشید در مکان انتخابی پیروی می‌کند: روز، طلوع/غروب یا شب. اگر «کاهش حرکت» روشن باشد، پس‌زمینه‌های متحرک ثابت نمایش داده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ciel suit la hauteur du Soleil au lieu choisi : jour, lever/coucher ou nuit. Si « Réduire les animations » est activé, les arrière-plans animés restent fixes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Небо следует за высотой Солнца в выбранном месте: день, восход/закат или ночь. Если включено «Уменьшение движения», анимированные фоны неподвижны."
          }
        }
      }
    },
    "features.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
