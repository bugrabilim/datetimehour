    },
    "greet.m.anniversary.2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaştığınız her gün daha da güzelleşsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May every day you share grow even sweeter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möge jeder gemeinsame Tag noch schöner werden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşdığınız hər gün daha da gözəlləşsin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عسى أن يزداد كل يوم تتشاركانه جمالًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga setiap hari yang dilalui bersama makin indah."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر وہ دن جو آپ ساتھ گزاریں اور خوبصورت ہو۔"
