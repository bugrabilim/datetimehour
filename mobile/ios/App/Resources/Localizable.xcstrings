          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une heure sur le graphique ou un jour dans la liste pour plus de détails."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на час на графике или день в списке, чтобы увидеть подробности."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
