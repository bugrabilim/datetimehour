    "wallpaper.ready": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır. Duvar kâğıdını değiştirirseniz yeni bir ekran görüntüsü seçin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready. If you change your wallpaper, choose a new screenshot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig. Wenn Sie das Hintergrundbild ändern, wählen Sie ein neues Bildschirmfoto."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırdır. Divar kağızını dəyişsəniz, yeni ekran şəkli seçin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاهز. إذا غيّرت خلفية الشاشة، فاختر لقطة شاشة جديدة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siap. Jika Anda mengganti wallpaper, pilih tangkapan layar baru."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تیار ہے۔ وال پیپر بدلیں تو نیا اسکرین شاٹ چنیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آماده است. اگر تصویر زمینه را عوض کردید، عکس صفحهٔ تازه‌ای انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est prêt. Si vous changez de fond d’écran, choisissez une nouvelle capture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово. Если смените обои, выберите новый снимок экрана."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備できました。壁紙を変えたら、新しいスクリーンショットを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비되었습니다. 배경화면을 바꾸면 새 스크린샷을 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已就绪。如果更换了壁纸，请选择新的截图。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Handa na. Kung papalitan mo ang wallpaper, pumili ng bagong screenshot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร้อมแล้ว หากเปลี่ยนวอลเปเปอร์ ให้เลือกภาพหน้าจอใหม่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. Si cambia el fondo de pantalla, elija una captura nueva."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto. Se mudar o papel de parede, escolha uma nova captura."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तैयार है। वॉलपेपर बदलें तो नया स्क्रीनशॉट चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রস্তুত। ওয়ালপেপার বদলালে নতুন একটি স্ক্রিনশট বাছুন।"
          }
        }
      }
    },
    "wallpaper.estimated": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonun widget yerleri tahminidir; kenarlar tutmazsa ince ayarı kullanın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget positions on this iPhone are estimated; if the edges don't line up, use fine-tuning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Widget-Positionen auf diesem iPhone sind geschätzt; passen die Kanten nicht, nutzen Sie die Feinabstimmung."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonun vidjet yerləri təxminidir; kənarlar uyğun gəlməsə, dəqiq ayardan istifadə edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مواضع الأدوات على هذا الـ iPhone تقديرية؛ إذا لم تتطابق الحواف، استخدم الضبط الدقيق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisi widget di iPhone ini perkiraan; jika tepinya tidak pas, gunakan penyesuaian halus."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فون پر وجیٹس کی جگہیں اندازاً ہیں؛ کنارے نہ ملیں تو باریک ترتیب استعمال کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جای ابزارک‌ها در این گوشی تقریبی است؛ اگر لبه‌ها جور نشد، از تنظیم دقیق استفاده کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les positions des widgets sur cet iPhone sont estimées ; si les bords ne correspondent pas, utilisez le réglage fin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Положение виджетов на этом iPhone приблизительное; если края не совпадают, используйте точную настройку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneのウィジェット位置は推定値です。端が合わなければ微調整を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 위젯 위치는 추정값입니다. 가장자리가 맞지 않으면 미세 조정을 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 上的小组件位置为估算值；如果边缘对不齐，请使用微调。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tantiya lang ang posisyon ng mga widget sa iPhone na ito; kung hindi tugma ang gilid, gamitin ang fine-tuning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตำแหน่งวิดเจ็ตใน iPhone เครื่องนี้เป็นค่าประมาณ หากขอบไม่ตรง ให้ใช้การปรับละเอียด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las posiciones de los widgets en este iPhone son aproximadas; si los bordes no coinciden, use el ajuste fino."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As posições dos widgets neste iPhone são estimadas; se as bordas não coincidirem, use o ajuste fino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone पर विजेट की जगहें अनुमानित हैं; किनारे न मिलें तो बारीक समायोजन का उपयोग करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই iPhone-এ উইজেটের অবস্থান আনুমানিক; কিনারা না মিললে সূক্ষ্ম সমন্বয় ব্যবহার করুন।"
          }
        }
      }
    },
    "wallpaper.wrongSize": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görüntü bu telefonun tam ekran görüntüsü değil. Ana ekranın dik tutulmuş ekran görüntüsünü seçin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a full-screen screenshot from this iPhone. Choose a portrait screenshot of the Home Screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein vollständiges Bildschirmfoto dieses iPhones. Wählen Sie ein Hochformat-Bildschirmfoto des Home-Bildschirms."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şəkil bu telefonun tam ekran şəkli deyil. Ana ekranın şaquli ekran şəklini seçin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه ليست لقطة شاشة كاملة من هذا الـ iPhone. اختر لقطة رأسية للشاشة الرئيسية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini bukan tangkapan layar penuh dari iPhone ini. Pilih tangkapan layar tegak dari Layar Utama."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اس فون کا پورا اسکرین شاٹ نہیں ہے۔ ہوم اسکرین کا سیدھا (عمودی) اسکرین شاٹ چنیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تصویر عکس کامل صفحهٔ همین گوشی نیست. عکس عمودی صفحهٔ اصلی را انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas une capture plein écran de cet iPhone. Choisissez une capture verticale de l’écran d’accueil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не полный снимок экрана этого iPhone. Выберите вертикальный снимок экрана «Домой»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneの全画面スクリーンショットではありません。縦向きのホーム画面のスクリーンショットを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 전체 화면 스크린샷이 아닙니다. 세로 방향 홈 화면 스크린샷을 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是此 iPhone 的全屏截图。请选择主屏幕的竖屏截图。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ito buong screenshot mula sa iPhone na ito. Pumili ng patayong screenshot ng Home Screen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่ไม่ใช่ภาพหน้าจอเต็มจาก iPhone เครื่องนี้ ให้เลือกภาพหน้าจอโฮมแนวตั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es una captura de pantalla completa de este iPhone. Elija una captura vertical de la pantalla de inicio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta não é uma captura de tela inteira deste iPhone. Escolha uma captura vertical da Tela de Início."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस iPhone का पूरा स्क्रीनशॉट नहीं है। होम स्क्रीन का सीधा (पोर्ट्रेट) स्क्रीनशॉट चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি এই iPhone-এর পূর্ণ পর্দার স্ক্রিনশট নয়। হোম স্ক্রিনের একটি খাড়া স্ক্রিনশট বাছুন।"
          }
        }
      }
    },
