    "act.none": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önümüzdeki 12 saatte uygun saat yok"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No suitable hour in the next 12 hours"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den nächsten 12 Stunden keine geeignete Stunde"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Növbəti 12 saatda uyğun saat yoxdur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد ساعة مناسبة خلال الساعات الـ12 القادمة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada jam yang cocok dalam 12 jam ke depan"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگلے 12 گھنٹوں میں کوئی مناسب گھنٹہ نہیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در 12 ساعت آینده ساعت مناسبی نیست"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune heure favorable dans les 12 prochaines heures"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ближайшие 12 часов подходящего времени нет"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後12時間に適した時間はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 12시간 동안 적합한 시간이 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来 12 小时内没有适宜的时段"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang angkop na oras sa susunod na 12 oras"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีช่วงที่เหมาะใน 12 ชั่วโมงข้างหน้า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna hora adecuada en las próximas 12 horas"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum horário adequado nas próximas 12 horas"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले 12 घंटों में कोई उपयुक्त घंटा नहीं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরের 12 ঘণ্টায় কোনো উপযুক্ত ঘণ্টা নেই"
          }
        }
      }
    },
    "act.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hissedilen sıcaklık, yağış, rüzgâr, gece ve UV'ye göre kabaca hesaplanır; kendi durumunuza göre karar verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rough estimate from feels-like temperature, rain, wind, darkness and UV; use your own judgement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grobe Schätzung aus gefühlter Temperatur, Regen, Wind, Dunkelheit und UV; entscheiden Sie selbst."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiss edilən temperatur, yağış, külək, gecə və UV-yə görə təxmini hesablanır; özünüz qərar verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدير تقريبي حسب الحرارة المحسوسة والمطر والرياح والظلام والأشعة فوق البنفسجية؛ القرار لك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkiraan kasar dari suhu terasa, hujan, angin, gelap, dan UV; putuskan sendiri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محسوس درجہ حرارت، بارش، ہوا، اندھیرے اور یو وی سے موٹا اندازہ؛ فیصلہ آپ کا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تخمینی تقریبی از دمای احساسی، بارش، باد، تاریکی و پرتو فرابنفش؛ خودتان تصمیم بگیرید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation approximative d'après la température ressentie, la pluie, le vent, l'obscurité et l'UV ; à vous de juger."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Грубая оценка по ощущаемой температуре, осадкам, ветру, темноте и УФ; решайте сами."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体感温度・雨・風・暗さ・紫外線からの大まかな目安です。最終判断はご自身で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체감 온도, 비, 바람, 어둠, 자외선으로 대략 계산합니다. 판단은 직접 하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据体感温度、降水、风、昼夜和紫外线粗略估算，请自行判断。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tantiyang batay sa ramdam na init, ulan, hangin, dilim at UV; kayo ang magpasya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประเมินคร่าว ๆ จากอุณหภูมิที่รู้สึก ฝน ลม ความมืด และ UV โปรดใช้วิจารณญาณ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una estimación aproximada a partir de la sensación térmica, la lluvia, el viento, la oscuridad y el índice UV; use su propio criterio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma estimativa aproximada a partir da sensação térmica, chuva, vento, escuridão e UV; decida conforme a sua situação."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महसूस होने वाले तापमान, बारिश, हवा, अँधेरे और UV से मोटा अनुमान; अपनी समझ से फ़ैसला करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুভূত তাপমাত্রা, বৃষ্টি, বাতাস, অন্ধকার ও UV থেকে একটি মোটামুটি অনুমান; নিজের বিচারবুদ্ধি ব্যবহার করুন।"
          }
        }
      }
    },
