            "value": "次の礼拝時刻"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 기도 시간"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一次礼拜时间"
          }
        },
        "fil": {
          "stringUnit": {
