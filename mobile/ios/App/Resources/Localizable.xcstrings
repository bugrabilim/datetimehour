    "weather.alert.rainSoon": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat %1$@ civarı yağmur bekleniyor; şemsiyenizi unutmayın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rain expected around %1$@; don't forget your umbrella."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regen gegen %1$@ erwartet; Schirm nicht vergessen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat %1$@ radələrində yağış gözlənilir; çətirinizi unutmayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُتوقع المطر نحو الساعة %1$@؛ لا تنسَ مظلتك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hujan diperkirakan sekitar pukul %1$@; jangan lupa payung."
