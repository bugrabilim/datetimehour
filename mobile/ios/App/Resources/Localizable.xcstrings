    "look.photo.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf yalnız bu telefonda saklanır; tam ekran saatin arkasında koyulaştırılarak gösterilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is kept only on this phone and shown darkened behind the full-screen clock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto bleibt nur auf diesem Telefon und wird abgedunkelt hinter der Vollbilduhr gezeigt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto yalnız bu telefonda saxlanır; tam ekran saatın arxasında tündləşdirilərək göstərilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الصورة على هذا الهاتف فقط وتظهر معتمة خلف الساعة بملء الشاشة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto hanya disimpan di ponsel ini dan ditampilkan lebih gelap di belakang jam layar penuh."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر صرف اسی فون پر رہتی ہے اور پوری اسکرین گھڑی کے پیچھے مدھم دکھائی دیتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکس فقط روی همین گوشی می‌ماند و تیره‌شده پشت ساعت تمام‌صفحه نمایش داده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo reste uniquement sur ce téléphone et s’affiche assombrie derrière l’horloge plein écran."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото хранится только на этом телефоне и показывается затемнённым за полноэкранными часами."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はこのスマホにだけ保存され、全画面時計の後ろに暗くして表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 이 휴대폰에만 저장되며 전체 화면 시계 뒤에 어둡게 보입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片只保存在这部手机上，并以调暗的方式显示在全屏时钟后面。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa teleponong ito lang nakatago ang larawan at ipinapakita itong pinadilim sa likod ng full-screen na orasan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพเก็บไว้ในโทรศัพท์นี้เท่านั้น และแสดงแบบมืดลงด้านหลังนาฬิกาเต็มจอ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto se guarda solo en este teléfono y se muestra oscurecida detrás del reloj a pantalla completa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto fica só neste celular e aparece escurecida atrás do relógio em tela cheia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो केवल इसी फ़ोन पर रहती है और फ़ुल स्क्रीन घड़ी के पीछे गहरी करके दिखाई जाती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিটি শুধু এই ফোনে থাকে এবং পূর্ণ পর্দার ঘড়ির পেছনে গাঢ় করে দেখানো হয়।"
          }
        }
      }
    },
