    "sky.darkNone": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gece tam karanlık olmuyor (Güneş ufkun 18° altına inmiyor)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No full darkness tonight (the Sun does not sink 18° below the horizon)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute Nacht wird es nicht ganz dunkel (die Sonne sinkt nicht 18° unter den Horizont)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gecə tam qaranlıq olmur (Günəş üfüqdən 18° aşağı enmir)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحل الظلام التام الليلة (لا تنخفض الشمس 18° تحت الأفق)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Malam ini tidak gelap total (Matahari tidak turun hingga 18° di bawah cakrawala)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج رات مکمل اندھیرا نہیں ہوگا (سورج افق سے 18° نیچے نہیں جاتا)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امشب تاریکی کامل نیست (خورشید 18 درجه زیر افق نمی‌رود)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de nuit noire cette nuit (le Soleil ne descend pas à 18° sous l'horizon)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня ночью полной темноты нет (Солнце не опускается на 18° под горизонт)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜は完全には暗くなりません（太陽が地平線下18°まで沈みません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 밤은 완전히 어두워지지 않습니다(태양이 지평선 아래 18°까지 내려가지 않음)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今晚不会完全黑暗（太阳未降到地平线下18°）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang ganap na dilim ngayong gabi (hindi bumababa ang Araw nang 18° sa ilalim ng abot-tanaw)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนนี้ไม่มืดสนิท (ดวงอาทิตย์ไม่ลงต่ำกว่าขอบฟ้า 18°)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta noche no hay oscuridad total (el Sol no baja 18° bajo el horizonte)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje à noite não há escuridão total (o Sol não desce 18° abaixo do horizonte)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज रात पूरा अँधेरा नहीं होगा (सूरज क्षितिज से 18° नीचे नहीं जाता)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ রাতে পূর্ণ অন্ধকার নেই (সূর্য দিগন্তের 18° নিচে নামে না)।"
          }
        }
      }
    },
    "sky.moonUpDark": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aydınlık; karanlıkta %2$@–%3$@ arası gökte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lit; up during darkness from %2$@ to %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "zu %1$@ beleuchtet; bei Dunkelheit von %2$@ bis %3$@ am Himmel"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ işıqlı; qaranlıqda %2$@–%3$@ arası səmada"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مضاء بنسبة %1$@؛ في السماء أثناء الظلام من %2$@ إلى %3$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ terang; di langit saat gelap pukul %2$@–%3$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ روشن؛ اندھیرے میں %2$@ سے %3$@ تک آسمان پر"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ روشن؛ در تاریکی از %2$@ تا %3$@ در آسمان"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "éclairée à %1$@ ; dans le ciel de nuit de %2$@ à %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "освещена на %1$@; в темноте на небе с %2$@ до %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輝面%1$@・暗い時間帯は%2$@〜%3$@に空にある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝기 %1$@, 어두운 시간 %2$@~%3$@에 하늘에 있음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照亮%1$@；黑暗时段%2$@至%3$@在天空中"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ maliwanag; nasa langit sa dilim mula %2$@ hanggang %3$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สว่าง %1$@ อยู่บนฟ้าช่วงมืดเวลา %2$@–%3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ iluminada; sobre el horizonte en la oscuridad de %2$@ a %3$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ iluminada; acima do horizonte no escuro das %2$@ às %3$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ रोशन; अँधेरे में %2$@ से %3$@ तक ऊपर"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ আলোকিত; অন্ধকারে %2$@ থেকে %3$@ পর্যন্ত আকাশে"
          }
        }
      }
    },
