    "onboard.setup.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakitler, kıble ve hava bulunduğunuz yere göre hesaplanır. Bildirimler vakitleri ve alarmları zamanında haber verir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times, the Qibla and the weather are worked out for where you are. Notifications tell you about prayer times and alarms on time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebetszeiten, Qibla und Wetter werden für Ihren Ort berechnet. Mitteilungen erinnern Sie rechtzeitig an Gebetszeiten und Wecker."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtlar, qiblə və hava olduğunuz yerə görə hesablanır. Bildirişlər vaxtları və zəngli saatları vaxtında xəbər verir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب مواقيت الصلاة والقبلة والطقس حسب مكانك، وتنبّهك الإشعارات إلى المواقيت والمنبهات في وقتها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu salat, kiblat, dan cuaca dihitung sesuai tempat Anda. Notifikasi memberi tahu waktu salat dan alarm tepat waktu."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز کے اوقات، قبلہ اور موسم آپ کی جگہ کے مطابق نکالے جاتے ہیں۔ اطلاعات اوقات اور الارم وقت پر بتاتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات نماز، قبله و هوا بر اساس محل شما محاسبه می‌شوند. اعلان‌ها اوقات و زنگ‌ها را به‌موقع خبر می‌دهند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures de prière, la qibla et la météo sont calculées pour l'endroit où vous êtes. Les notifications vous préviennent à temps des prières et des alarmes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время намаза, кибла и погода рассчитываются для вашего места. Уведомления вовремя сообщают о намазе и будильниках."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拝時刻、キブラ、天気は現在地に合わせて計算されます。通知で礼拝時刻やアラームを時間どおりにお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도 시간, 키블라, 날씨는 현재 위치에 맞춰 계산됩니다. 알림으로 기도 시간과 알람을 제때 알려 드립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拜时间、朝拜方向和天气会按您所在地点计算。通知会准时提醒礼拜时间和闹钟。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinakalkula ang oras ng pagdarasal, Qibla at panahon ayon sa kinaroroonan mo. Ipinapaalam ng mga notification ang mga oras ng pagdarasal at alarm sa tamang oras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาละหมาด ทิศกิบลัต และสภาพอากาศคำนวณตามที่ที่คุณอยู่ การแจ้งเตือนจะบอกเวลาละหมาดและนาฬิกาปลุกตรงเวลา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los horarios de oración, la alquibla y el tiempo se calculan según el lugar donde se encuentra. Las notificaciones le avisan a tiempo de los horarios de oración y las alarmas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os horários de oração, a qibla e o tempo são calculados para onde você está. As notificações avisam na hora sobre os horários de oração e os alarmes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमाज़ के समय, क़िबला और मौसम आपकी जगह के लिए निकाले जाते हैं। सूचनाएँ नमाज़ के समय और अलार्म के बारे में समय पर बताती हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজের সময়, কিবলা ও আবহাওয়া আপনার অবস্থান অনুযায়ী হিসাব করা হয়। নোটিফিকেশন আপনাকে নামাজের সময় ও অ্যালার্ম সময়মতো জানায়।"
          }
        }
      }
    },
