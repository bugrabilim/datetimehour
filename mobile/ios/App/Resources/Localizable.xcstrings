    "tools.alarm.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıda çalışan ücretsiz alarm: saat, etiket, hafta günlerine göre tekrar, 5 dakika erteleme ve bildirim. Alarm sayfa açıkken çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free alarm that runs in your browser: time, label, repeat on chosen weekdays, 5-minute snooze and notifications. The alarm rings while the page is open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenloser Wecker im Browser: Uhrzeit, Bezeichnung, Wiederholung an gewählten Wochentagen, 5 Minuten Schlummern und Benachrichtigungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Brauzerdə işləyən pulsuz zəngli saat: vaxt, ad, seçilmiş günlərdə təkrar, 5 dəqiqəlik təxirə salma və bildirişlər. Səhifə açıq olduqca çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منبّه مجاني يعمل في متصفحك: الوقت، والتسمية، والتكرار في أيام تختارها، وغفوة 5 دقائق، وإشعارات. يرنّ المنبّه ما دامت الصفحة مفتوحة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm gratis yang berjalan di peramban: waktu, label, ulangi pada hari pilihan, tunda 5 menit, dan notifikasi. Alarm berbunyi selama halaman terbuka."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "براؤزر میں چلنے والا مفت الارم: وقت، لیبل، منتخب دنوں پر دہرانا، 5 منٹ کا اسنوز اور اطلاعات۔ صفحہ کھلا رہنے تک الارم بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زنگ رایگانی که در مرورگر کار می‌کند: ساعت، برچسب، تکرار در روزهای دلخواه، تعویق 5 دقیقه‌ای و اعلان. زنگ تا وقتی صفحه باز است به صدا درمی‌آید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réveil en ligne gratuit dans votre navigateur : heure, libellé, répétition, rappel de 5 minutes et notifications. Il sonne tant que la page est ouverte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный будильник в браузере: время, подпись, повтор по выбранным дням, отсрочка на 5 минут и уведомления. Будильник звонит, пока страница открыта."
          }
        }
      }
    },
    "tools.alarm.h1": {
      "extractionState": "manual",
      "localizations": {
