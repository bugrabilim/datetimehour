    "look.textNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ekranında ve tam ekranda saatin altında görünür; yalnız bu cihazda saklanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown under the clock on the clock screen and in full screen; stored only on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint auf dem Uhrbildschirm und im Vollbild unter der Uhr; nur auf diesem Gerät gespeichert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ekranında və tam ekranda saatın altında görünür; yalnız bu cihazda saxlanılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر تحت الساعة في شاشة الساعة وفي ملء الشاشة، ويُحفظ على هذا الجهاز فقط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditampilkan di bawah jam di layar jam dan layar penuh; hanya disimpan di perangkat ini."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی کی اسکرین اور پوری اسکرین میں گھڑی کے نیچے دکھتا ہے؛ صرف اسی آلے پر محفوظ ہوتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زیر ساعت در صفحهٔ ساعت و تمام‌صفحه نمایش داده می‌شود؛ فقط روی همین دستگاه ذخیره می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché sous l’horloge sur l’écran de l’horloge et en plein écran ; enregistré uniquement sur cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывается под часами на экране часов и в полноэкранном режиме; хранится только на этом устройстве."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計画面と全画面で時計の下に表示され、この端末にだけ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계 화면과 전체 화면에서 시계 아래에 나오며 이 기기에만 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在时钟界面和全屏时钟下方；只保存在此设备上。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita sa ilalim ng orasan sa screen ng orasan at sa full screen; sa device na ito lang nakatago."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงใต้นาฬิกาบนหน้าจอนาฬิกาและเต็มจอ เก็บไว้ในอุปกรณ์นี้เท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra bajo el reloj en la pantalla del reloj y a pantalla completa; solo se guarda en este dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece abaixo do relógio na tela do relógio e em tela cheia; fica salvo só neste aparelho."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी स्क्रीन और फ़ुल स्क्रीन में घड़ी के नीचे दिखता है; केवल इसी डिवाइस पर सहेजा जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ির পর্দায় ও পূর্ণ পর্দায় ঘড়ির নিচে দেখানো হয়; শুধু এই ডিভাইসে সংরক্ষিত থাকে।"
          }
        }
      }
    },
