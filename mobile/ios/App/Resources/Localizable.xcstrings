    "alarm.preNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessiz bildirim; dokunup alarmı atlayabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A silent notification; you can skip the alarm from it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine stille Mitteilung; Sie können den Wecker darüber überspringen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səssiz bildiriş; oradan zəngli saatı keçə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار صامت يمكنك منه تخطي المنبه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi senyap; Anda bisa melewati alarm darinya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خاموش اطلاع؛ اس سے آپ الارم چھوڑ سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلانی بی‌صدا؛ از آن می‌توانید هشدار را رد کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification silencieuse ; vous pouvez sauter l’alarme depuis celle-ci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Беззвучное уведомление; из него можно пропустить будильник."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音の出ない通知です。そこからアラームをスキップできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리 없는 알림이며, 여기서 알람을 건너뛸 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静音通知；可从通知中跳过闹钟。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahimik na abiso; maaari mong laktawan ang alarma mula rito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนแบบเงียบ คุณข้ามการปลุกได้จากการแจ้งเตือนนี้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación silenciosa; desde ella puede saltarse la alarma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação silenciosa; por ela você pode pular o alarme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बिना आवाज़ की सूचना; इससे आप अलार्म छोड़ सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি নীরব নোটিফিকেশন; এখান থেকে অ্যালার্ম বাদ দিতে পারেন।"
          }
        }
      }
    },
