          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホの設定アプリを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰의 설정 앱을 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
