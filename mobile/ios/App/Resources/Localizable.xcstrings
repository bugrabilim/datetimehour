    "pomo.todoEmpty": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görev ekleyin; dokunduğunuz görev şu anki görev olur ve biten her tur onun sayacına yazılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add tasks; tap one to make it the current task, and every finished session counts towards it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Aufgaben hinzu; tippen Sie auf eine, um sie zur aktuellen Aufgabe zu machen – jede beendete Phase zählt für sie."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapşırıq əlavə edin; toxunduğunuz tapşırıq cari tapşırıq olur və bitən hər dövr onun sayğacına yazılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مهامك؛ المس مهمة لتصبح المهمة الحالية، وتُحسب لها كل فترة عمل مكتملة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan tugas; ketuk salah satunya agar menjadi tugas saat ini, dan setiap sesi yang selesai dihitung untuknya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام شامل کریں؛ کسی پر ٹیپ کر کے اسے موجودہ کام بنائیں، ہر مکمل دور اسی میں گنا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارها را بیفزایید؛ روی یکی بزنید تا کار کنونی شود و هر نوبت تمام‌شده برای آن شمرده شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des tâches ; touchez-en une pour en faire la tâche en cours : chaque séance terminée lui est comptée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте задачи; нажмите на задачу, чтобы сделать её текущей, — каждый завершённый отрезок засчитывается ей."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを追加し、タップして今のタスクにすると、終えた作業時間がそのタスクに加算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 추가하고 하나를 눌러 현재 할 일로 정하면, 마친 작업 시간이 그 할 일에 더해집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加任务；轻点一个设为当前任务，每完成一个时段都会记到它上面。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng mga gawain; i-tap ang isa para gawin itong kasalukuyang gawain, at bawat natapos na session ay bibilangin dito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มงาน แตะงานหนึ่งเพื่อตั้งเป็นงานปัจจุบัน แล้วทุกช่วงที่ทำเสร็จจะนับให้งานนั้น"
          }
        }
      }
    },
