          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderzugriff ist aus; aktivieren Sie ihn im Kalender-Tab mit „Kalender meines Telefons anzeigen“."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon təqviminə icazə verilməyib; Təqvim bölməsindəki \"Telefonumdakı təqvimləri göstər\" ilə aça bilərsiniz."
          }
