        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدخال هذه المعلومات اختياري؛ وتُعالج وفق [إشعار الخصوصية](https://bumbagroup.com/uyelik-aydinlatma?dil=en)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengisi informasi ini bersifat opsional; informasi diproses sesuai [Pemberitahuan Privasi](https://bumbagroup.com/uyelik-aydinlatma?dil=en)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ معلومات دینا اختیاری ہے؛ یہ [رازداری نوٹس](https://bumbagroup.com/uyelik-aydinlatma?dil=en) کے مطابق پروسیس ہوتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وارد کردن این اطلاعات اختیاری است؛ طبق [اطلاعیهٔ حریم خصوصی](https://bumbagroup.com/uyelik-aydinlatma?dil=en) پردازش می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces informations sont facultatives ; elles sont traitées selon la [Notice de confidentialité](https://bumbagroup.com/uyelik-aydinlatma?dil=en)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти сведения указываются по желанию; они обрабатываются в соответствии с [Уведомлением о конфиденциальности](https://bumbagroup.com/uyelik-aydinlatma?dil=en)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの情報の入力は任意です。[プライバシー通知](https://bumbagroup.com/uyelik-aydinlatma?dil=en)に従って処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 정보 입력은 선택입니다. [개인정보 고지](https://bumbagroup.com/uyelik-aydinlatma?dil=en)에 따라 처리됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写这些信息是自愿的；它们依据[隐私声明](https://bumbagroup.com/uyelik-aydinlatma?dil=en)处理。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsyonal ang paglalagay ng impormasyong ito; pinoproseso ito ayon sa [Abiso sa Privacy](https://bumbagroup.com/uyelik-aydinlatma?dil=en)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกรอกข้อมูลเหล่านี้เป็นทางเลือก และได้รับการประมวลผลตาม[ประกาศความเป็นส่วนตัว](https://bumbagroup.com/uyelik-aydinlatma?dil=en)"
