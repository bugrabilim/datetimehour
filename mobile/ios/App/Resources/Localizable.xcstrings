    "track.kazaNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Borcunuzu + ile ekleyin, kıldıkça − ile düşün."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add what you owe with +, and lower it with − as you make them up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Nachzuholendes mit + hinzu und verringern Sie es mit −, wenn Sie es nachholen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Borcunuzu + ilə əlavə edin, qıldıqca − ilə azaldın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ما عليك بـ + وأنقصه بـ − كلما قضيت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan utang salat dengan +, dan kurangi dengan − saat Anda mengqadanya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باقی نمازیں + سے شامل کریں، اور ادا کرتے ہوئے − سے کم کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمازهای قضای بر عهده‌تان را با + بیفزایید و هر بار که یکی را به‌جا آوردید، با − کم کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez ce que vous devez avec +, et réduisez le compte avec − à mesure que vous rattrapez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте долги кнопкой +, а по мере восполнения уменьшайте кнопкой −."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未済の分を＋で加え、補ったら−で減らします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "못 한 만큼 +로 더하고, 보충하면 −로 줄이세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用+添加所欠的次数，补礼后用−减少。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Idagdag ang utang gamit ang +, at bawasan gamit ang − kapag nabayaran."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มที่ค้างด้วย + และลดด้วย − เมื่อชดใช้แล้ว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada lo que debe con + y redúzcalo con − a medida que lo recupere."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o que deve com + e diminua com − conforme for repondo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो बाकी है उसे + से जोड़ें, और अदा करते हुए − से घटाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যা বাকি তা + দিয়ে যোগ করুন, আর আদায় করার সঙ্গে সঙ্গে − দিয়ে কমান।"
          }
        }
      }
    },
