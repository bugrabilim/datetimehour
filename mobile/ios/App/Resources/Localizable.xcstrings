    "alarm.advanced.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatma görevi, kademeli ses, erteleme sınırı, müzik, gün doğumu ışığı, akıllı alarm, saati söyleme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss task, gradual volume, snooze limit, music, sunrise light, smart alarm, speak the time"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgabe zum Ausschalten, ansteigende Lautstärke, Schlummer-Limit, Musik, Sonnenaufgangslicht, intelligenter Wecker, Zeitansage"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Söndürmə tapşırığı, tədricən yüksələn səs, təxirə salma həddi, musiqi, gün çıxışı işığı, ağıllı zəng, vaxtı demək"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهمة الإيقاف، صوت متدرّج، حدّ الغفوة، موسيقى، ضوء الشروق، منبّه ذكي، نطق الوقت"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas mematikan alarm, volume bertahap, batas tunda, musik, cahaya matahari terbit, alarm pintar, ucapkan waktu"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بند کرنے کا کام، بتدریج آواز، اسنوز حد، موسیقی، طلوع کی روشنی، اسمارٹ الارم، وقت بولنا"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مأموریت خاموش‌کردن، صدای تدریجی، سقف چرت، موسیقی، نور طلوع، زنگ هوشمند، گفتن ساعت"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tâche d'arrêt, volume progressif, limite de répétition, musique, lumière d'aube, réveil intelligent, annonce de l'heure"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задание для отключения, нарастающая громкость, лимит повторов, музыка, свет рассвета, умный будильник, озвучивание времени"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止タスク・音量の段階的上昇・スヌーズ上限・音楽・日の出ライト・スマートアラーム・時刻の読み上げ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄기 미션, 점점 커지는 소리, 다시 알림 제한, 음악, 일출 조명, 스마트 알람, 시간 읽기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭任务、渐强音量、贪睡上限、音乐、日出光、智能闹钟、报时"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gawain sa pagpatay, unti-unting lakas, limitasyon ng snooze, musika, liwanag ng pagsikat, smart alarm, pagsabi ng oras"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภารกิจปิดปลุก เสียงค่อย ๆ ดังขึ้น จำกัดการเลื่อน เพลง แสงอาทิตย์ขึ้น ปลุกอัจฉริยะ บอกเวลา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarea para apagarla, volumen gradual, límite de aplazamientos, música, luz de amanecer, alarma inteligente, decir la hora"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarefa para desligar, volume gradual, limite de sonecas, música, luz do amanhecer, alarme inteligente, falar a hora"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद करने का कार्य, धीरे बढ़ती आवाज़, स्नूज़ सीमा, संगीत, सूर्योदय की रोशनी, स्मार्ट अलार्म, समय बोलना"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ করার কাজ, ধীরে বাড়া শব্দ, স্নুজের সীমা, সংগীত, সূর্যোদয়ের আলো, স্মার্ট অ্যালার্ম, সময় বলা"
          }
        }
      }
    },
