    "journal.tagsNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notunuza #kahve, #spor gibi etiketler yazın; son 30 gün burada sayılır, dokununca o günler süzülür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write tags like #coffee or #sport in your note; the last 30 days are counted here, tap one to filter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie Schlagwörter wie #kaffee oder #sport in Ihre Notiz; die letzten 30 Tage werden hier gezählt, antippen filtert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeydinizə #qəhvə, #idman kimi etiketlər yazın; son 30 gün burada sayılır, birinə toxunanda həmin günlər süzülür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب وسومًا مثل #قهوة أو #رياضة في ملاحظتك؛ تُحسب آخر 30 يومًا هنا، والمس وسمًا للتصفية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis tag seperti #kopi atau #olahraga di catatan; 30 hari terakhir dihitung di sini, ketuk untuk menyaring."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے نوٹ میں #کافی، #ورزش جیسے ٹیگ لکھیں؛ پچھلے 30 دن یہاں گنے جاتے ہیں، ٹیپ کریں تو فلٹر ہوتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در یادداشت برچسب‌هایی مثل #قهوه یا #ورزش بنویسید؛ 30 روز اخیر اینجا شمرده می‌شود و با لمس فیلتر می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez des étiquettes comme #café ou #sport dans votre note ; les 30 derniers jours sont comptés ici, touchez pour filtrer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишите метки вроде #кофе или #спорт в заметке; здесь считаются последние 30 дней, нажмите для фильтра."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモに #コーヒー や #運動 のようなタグを書くと、直近30日分をここで数えます。タップで絞り込み。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모에 #커피, #운동 같은 태그를 쓰면 최근 30일이 여기에서 집계되며 누르면 걸러집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在笔记中写下 #咖啡、#运动 等标签；这里统计最近 30 天，点按可筛选。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsulat ng tag tulad ng #kape o #ehersisyo sa tala; binibilang dito ang huling 30 araw, i-tap para i-filter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนแท็กเช่น #กาแฟ หรือ #ออกกำลังกาย ในบันทึก ระบบนับ 30 วันล่าสุดที่นี่ แตะเพื่อกรอง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba etiquetas como #café o #deporte en su nota; aquí se cuentan los últimos 30 días, toque una para filtrar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva etiquetas como #café ou #esporte na sua nota; aqui são contados os últimos 30 dias, toque numa para filtrar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने नोट में #कॉफ़ी या #खेल जैसे टैग लिखें; यहाँ पिछले 30 दिन गिने जाते हैं, छाँटने के लिए किसी पर टैप करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটে #কফি বা #খেলা ধরনের ট্যাগ লিখুন; গত 30 দিনের হিসাব এখানে, ফিল্টার করতে একটিতে চাপুন।"
          }
        }
      }
    },
