    "notify.cat.hourly.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz saatler arasında her saat başında kısa bildirim."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short notification on the hour between the hours you choose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Benachrichtigung zu jeder vollen Stunde im gewählten Zeitraum."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçdiyiniz saatlar arasında hər saat başı qısa bildiriş."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار قصير عند بداية كل ساعة بين الساعتين اللتين تختارهما."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi singkat setiap jam tepat di antara jam yang Anda pilih."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے منتخب اوقات کے درمیان ہر گھنٹے کے آغاز پر مختصر اطلاع۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلانی کوتاه سر هر ساعت، میان ساعت‌هایی که برمی‌گزینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une courte notification à chaque heure pile, entre les heures choisies."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткое уведомление в начале каждого часа в выбранном промежутке."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ時間帯の毎正時に短い通知。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 시간대에 정각마다 짧은 알림."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您选择的时段内，每逢整点发一条简短通知。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maikling abiso tuwing eksaktong oras sa pagitan ng mga oras na pinili mo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนสั้น ๆ ทุกต้นชั่วโมงในช่วงเวลาที่คุณเลือก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación breve a cada hora en punto entre las horas que elija."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação curta a cada hora cheia entre os horários que você escolher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके चुने घंटों के बीच हर घंटे पर एक छोटी सूचना।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বেছে নেওয়া সময়ের মধ্যে প্রতি ঘণ্টার শুরুতে একটি ছোট নোটিফিকেশন।"
          }
        }
      }
    },
