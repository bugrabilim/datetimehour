    "prayer.bayramNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyanet'in yayımladığı saatlerle aynı kural (güneş vaktinden 38 dk sonra); kesin saat il müftülüğünün duyurusudur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same rule as Diyanet’s published times (38 min after sunrise); the provincial mufti’s announcement is authoritative."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleiche Regel wie die von Diyanet veröffentlichten Zeiten (38 Min. nach Sonnenaufgang); maßgeblich ist die Bekanntgabe des Provinzmuftis."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyanətin dərc etdiyi saatlarla eyni qayda (gün çıxandan 38 dəq sonra); dəqiq saat vilayət müftiliyinin elanıdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القاعدة نفسها في مواقيت رئاسة الشؤون الدينية (بعد الشروق بـ 38 دقيقة)؛ والمعتمد إعلان مفتي الولاية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aturan yang sama dengan waktu terbitan Diyanet (38 menit setelah matahari terbit); yang resmi adalah pengumuman mufti provinsi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیانت کے شائع کردہ اوقات والا اصول (طلوعِ آفتاب کے 38 منٹ بعد)؛ حتمی وقت صوبائی مفتی کا اعلان ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همان قاعده اوقات منتشرشده دیانت (38 دقیقه پس از طلوع)؛ ساعت دقیق اعلام مفتی استان است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même règle que les horaires publiés par la Diyanet (38 min après le lever du soleil) ; l’annonce du mufti provincial fait foi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То же правило, что у опубликованных Диянетом времён (через 38 мин после восхода); точное время объявляет муфтият провинции."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディヤーネットの公表時刻と同じ規則（日の出の38分後）。正式な時刻は県ムフティー庁の発表です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디야넷이 발표하는 시각과 같은 규칙(일출 38분 뒤)이며, 정확한 시각은 주 무프티청의 공지를 따릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与迪亚内特公布时间相同的规则（日出后 38 分钟）；准确时间以省穆夫提办公室公告为准。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaparehong panuntunan ng mga oras ng Diyanet (38 minuto pagkatapos sumikat ang araw); ang anunsyo ng mufti ng lalawigan ang opisyal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กฎเดียวกับเวลาที่ดียาเนตประกาศ (หลังดวงอาทิตย์ขึ้น 38 นาที) เวลาที่แน่นอนให้ยึดประกาศของมุฟตีประจำจังหวัด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Misma regla que los horarios publicados por Diyanet (38 min después de la salida del sol); la referencia es el anuncio del muftí de la provincia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesma regra dos horários publicados pela Diyanet (38 min após o nascer do sol); vale o anúncio do mufti da província."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दियानत के प्रकाशित समय वाला ही नियम (सूर्योदय के 38 मिनट बाद); प्रांत के मुफ़्ती की घोषणा ही मान्य है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিয়ানেতের প্রকাশিত সময়ের মতো একই নিয়ম (সূর্যোদয়ের 38 মিনিট পরে); প্রাদেশিক মুফতির ঘোষণাই প্রামাণ্য।"
          }
        }
      }
    },
