    "timeCalc.overnight": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitiş başlangıçtan önce olduğu için gece yarısı geçildi sayıldı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The end is earlier than the start, so the span was counted past midnight."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ende liegt vor dem Beginn, daher wurde über Mitternacht gerechnet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son saat başlanğıcdan tez olduğu üçün müddət gecə yarısından keçməklə hesablandı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النهاية قبل البداية، لذا حُسبت المدة على أنها تمتد إلى ما بعد منتصف الليل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu selesai lebih awal dari waktu mulai, jadi rentangnya dihitung melewati tengah malam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اختتام آغاز سے پہلے ہے، اس لیے وقفہ آدھی رات سے گزار کر گنا گیا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پایان زودتر از آغاز است، پس بازه با گذشتن از نیمه‌شب حساب شد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure de fin est antérieure à l’heure de début : la durée a été calculée en passant minuit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конец раньше начала, поэтому промежуток посчитан через полночь."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了が開始より早いため、午前0時をまたいだものとして計算しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시각이 시작 시각보다 이르므로 자정을 넘긴 것으로 계산했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束早于开始，因此按跨过午夜计算。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas maaga ang katapusan kaysa simula, kaya binilang itong lampas hatinggabi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาสิ้นสุดเร็วกว่าเวลาเริ่ม จึงนับว่าข้ามเที่ยงคืน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fin es anterior al inicio, así que se considera que cruza la medianoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O fim é anterior ao início, por isso o intervalo foi considerado como passando da meia-noite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंत शुरुआत से पहले है, इसलिए अंतराल आधी रात के पार गिना गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষের সময় শুরুর আগে, তাই ব্যবধান মধ্যরাত পেরিয়ে গোনা হয়েছে।"
          }
        }
      }
    },
