    "hiit.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kilitliyken ya da başka bir uygulamadayken de evre geçişleri ve son 3 saniye sesli duyurulur, bitişte alarm çalar. Müzik çalıyorsa duyurular müziğin üstüne söylenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase changes and the last 3 seconds are announced even with the screen locked or while you use another app, and an alarm rings at the end. If music is playing, the announcements play over it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phasenwechsel und die letzten 3 Sekunden werden auch bei gesperrtem Bildschirm oder in einer anderen App angesagt, am Ende klingelt ein Alarm. Läuft Musik, erklingen die Ansagen darüber."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kilidli olanda və ya başqa tətbiqdə olanda da mərhələ keçidləri və son 3 saniyə səsli elan edilir, sonda zəng çalır. Musiqi çalırsa, elanlar musiqinin üstündən səslənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعلَن عن تغيّر المراحل والثواني الثلاث الأخيرة حتى مع قفل الشاشة أو أثناء استخدام تطبيق آخر، ويرن المنبّه عند النهاية. إذا كانت الموسيقى تعمل فستُسمع الإعلانات فوقها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergantian fase dan 3 detik terakhir diumumkan meski layar terkunci atau saat Anda memakai aplikasi lain, dan alarm berbunyi di akhir. Jika musik sedang diputar, pengumuman terdengar di atasnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحلوں کی تبدیلی اور آخری 3 سیکنڈ اسکرین لاک ہونے یا دوسری ایپ استعمال کرتے وقت بھی بولے جاتے ہیں، اور آخر میں الارم بجتا ہے۔ اگر موسیقی چل رہی ہو تو اعلانات اس کے اوپر سنائی دیتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییر مرحله‌ها و 3 ثانیهٔ آخر حتی با صفحهٔ قفل یا هنگام کار با برنامهٔ دیگر اعلام می‌شوند و در پایان هشدار زنگ می‌زند. اگر موسیقی پخش شود، اعلام‌ها روی آن شنیده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements de phase et les 3 dernières secondes sont annoncés même écran verrouillé ou dans une autre app, et une alarme sonne à la fin. Si de la musique joue, les annonces passent par-dessus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смена этапов и последние 3 секунды объявляются даже на заблокированном экране и в другом приложении, а в конце звонит сигнал. Если играет музыка, объявления звучат поверх неё."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フェーズの切り替えと最後の3秒は、画面がロック中でも別のアプリを使っていても読み上げられ、終わるとアラームが鳴ります。音楽を再生中なら、その上に読み上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구간이 바뀔 때와 마지막 3초는 화면이 잠겨 있거나 다른 앱을 쓰는 중에도 안내되며 끝나면 알람이 울립니다. 음악이 나오고 있으면 그 위에 안내합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使锁屏或在使用其他应用，也会播报阶段切换和最后3秒，结束时闹钟会响。正在播放音乐时，播报会叠加在音乐上。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaanunsiyo ang pagpapalit ng yugto at ang huling 3 segundo kahit naka-lock ang screen o gumagamit ka ng ibang app, at tumutunog ang alarma sa dulo. Kung may tumutugtog na musika, sa ibabaw nito naririnig ang anunsiyo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนช่วงและ 3 วินาทีสุดท้ายจะประกาศแม้หน้าจอล็อกหรือใช้แอปอื่นอยู่ และนาฬิกาปลุกจะดังเมื่อจบ หากเปิดเพลงอยู่ เสียงประกาศจะดังทับเพลง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de fase y los últimos 3 segundos se anuncian aunque la pantalla esté bloqueada o use otra app, y al final suena una alarma. Si hay música, los avisos suenan por encima."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mudanças de fase e os últimos 3 segundos são anunciados mesmo com a tela bloqueada ou usando outro app, e um alarme toca no fim. Se houver música tocando, os avisos tocam por cima."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन लॉक होने या दूसरा ऐप इस्तेमाल करते समय भी चरण बदलने और आख़िरी 3 सेकंड की घोषणा होती है, और अंत में अलार्म बजता है। संगीत चल रहा हो तो घोषणाएँ उसके ऊपर बजती हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পর্দা লক থাকলে বা অন্য অ্যাপ ব্যবহারের সময়ও ধাপের পরিবর্তন ও শেষ 3 সেকেন্ড ঘোষণা করা হয় এবং শেষে একটি অ্যালার্ম বাজে। গান বাজলে ঘোষণাগুলো তার ওপরে বাজে।"
          }
        }
      }
    },
