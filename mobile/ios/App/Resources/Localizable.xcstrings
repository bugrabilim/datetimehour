    "nature.crescentCats.A": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıplak gözle kolayca görülür"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easily visible to the naked eye"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit bloßem Auge leicht sichtbar"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çılpaq gözlə asanlıqla görünür"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرى بالعين المجردة بسهولة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudah terlihat dengan mata telanjang"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ننگی آنکھ سے آسانی سے نظر آتا ہے"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌آسانی با چشم غیرمسلح دیده می‌شود"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facilement visible à l’œil nu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Легко виден невооружённым глазом"
          }
        }
      }
    },
    "nature.crescentCats.B": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyi havada çıplak gözle görülür"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible to the naked eye in perfect conditions"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei besten Bedingungen mit bloßem Auge sichtbar"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaxşı havada çılpaq gözlə görünür"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرى بالعين المجردة في ظروف مثالية"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlihat dengan mata telanjang dalam kondisi sempurna"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مثالی حالات میں ننگی آنکھ سے نظر آتا ہے"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در شرایط عالی با چشم غیرمسلح دیده می‌شود"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible à l’œil nu dans des conditions parfaites"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виден невооружённым глазом в идеальных условиях"
          }
        }
      }
    },
    "nature.crescentCats.C": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce dürbünle bulunursa gözle görülebilir"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May need binoculars to find, then naked eye"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst mit Fernglas finden, dann mit bloßem Auge"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəl durbinlə tapılsa gözlə görünə bilər"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يحتاج منظارًا لتحديده ثم يُرى بالعين"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mungkin perlu teropong untuk menemukan, lalu mata telanjang"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاش کے لیے دوربین کی ضرورت پڑ سکتی ہے، پھر ننگی آنکھ"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای یافتن شاید دوربین دوچشمی لازم باشد، سپس با چشم"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumelles parfois nécessaires pour le repérer, puis œil nu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найти помогает бинокль, затем виден глазом"
          }
        }
      }
    },
    "nature.crescentCats.D": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız dürbün ya da teleskopla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Binoculars or telescope only"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur mit Fernglas oder Teleskop"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız durbin və ya teleskopla"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالمنظار أو التلسكوب فقط"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya dengan teropong atau teleskop"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف دوربین یا ٹیلی اسکوپ سے"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط با دوربین دوچشمی یا تلسکوپ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumelles ou télescope uniquement"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только в бинокль или телескоп"
          }
        }
      }
    },
    "nature.crescentCats.E": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleskopla bile görülmez"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not visible even with a telescope"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst mit Teleskop nicht sichtbar"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleskopla belə görünmür"
          }
        },
        "ar": {
          "stringUnit": {
