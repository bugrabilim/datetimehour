    "widget.sun.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili yerde güneşin doğuşu, batışı ve gün uzunluğu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise, sunset and day length at the chosen place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonnenaufgang, -untergang und Tageslänge am gewählten Ort."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş yerdə günəşin çıxışı, batışı və günün uzunluğu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشروق والغروب وطول النهار في المكان المختار."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matahari terbit, terbenam, dan panjang hari di tempat pilihan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب جگہ پر طلوع، غروب اور دن کی لمبائی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "طلوع، غروب و طول روز در مکان انتخابی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lever, coucher du soleil et durée du jour au lieu choisi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восход, закат и долгота дня в выбранном месте."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ場所の日の出・日の入りと昼の長さ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 장소의 일출, 일몰, 낮 길이."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选地点的日出、日落和白昼时长。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagsikat, paglubog ng araw at haba ng araw sa napiling lugar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาพระอาทิตย์ขึ้น ตก และความยาวกลางวัน ณ สถานที่ที่เลือก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salida y puesta del sol y duración del día en el lugar elegido."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascer e pôr do sol e duração do dia no local escolhido."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनी जगह पर सूर्योदय, सूर्यास्त और दिन की लंबाई।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
