    "account.changeEmailSent": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay için mevcut adresinize e-posta gönderdik. Onayladıktan sonra yeni adresinize doğrulama bağlantısı gelir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We sent an email to your current address for confirmation. After you confirm, a verification link will arrive at your new address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben zur Bestätigung eine E-Mail an Ihre bisherige Adresse geschickt. Danach erhält Ihre neue Adresse einen Bestätigungslink."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təsdiq üçün hazırkı ünvanınıza e-poçt göndərdik. Təsdiqlədikdən sonra yeni ünvanınıza təsdiq keçidi gələcək."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلنا رسالة إلى عنوانك الحالي للموافقة. بعد الموافقة يصل رابط التأكيد إلى عنوانك الجديد."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami mengirim email ke alamat Anda saat ini untuk konfirmasi. Setelah dikonfirmasi, tautan verifikasi dikirim ke alamat baru Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدیق کے لیے ہم نے آپ کے موجودہ پتے پر ای میل بھیجی ہے۔ تصدیق کے بعد نئے پتے پر تصدیقی لنک آئے گا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تأیید، به نشانی فعلی شما ایمیل فرستادیم. پس از تأیید، پیوند تأیید به نشانی جدید می‌رود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons envoyé un e-mail de confirmation à votre adresse actuelle. Une fois confirmé, un lien de vérification part vers la nouvelle adresse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы отправили письмо на ваш текущий адрес для подтверждения. После подтверждения ссылка придёт на новый адрес."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認のため、現在のアドレスにメールを送信しました。確認後、新しいアドレスに確認用のリンクが届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인을 위해 현재 주소로 이메일을 보냈습니다. 확인하면 새 주소로 확인 링크가 갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们已向您当前的地址发送确认邮件。确认后，验证链接会发到新地址。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagpadala kami ng email sa kasalukuyan ninyong address para kumpirmahin. Pagkatapos, may verification link na ipapadala sa bago ninyong address."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราส่งอีเมลไปยังที่อยู่ปัจจุบันเพื่อยืนยัน เมื่อยืนยันแล้ว ลิงก์ยืนยันจะส่งไปยังที่อยู่ใหม่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviamos un correo a su dirección actual para confirmar. Después de confirmar, llegará un enlace de verificación a la nueva dirección."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviamos um e-mail ao seu endereço atual para confirmar. Depois da confirmação, um link de verificação vai para o novo endereço."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि के लिए हमने आपके मौजूदा पते पर ईमेल भेजा है। पुष्टि के बाद नए पते पर पुष्टि लिंक जाएगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশ্চিত করার জন্য আমরা আপনার বর্তমান ঠিকানায় ইমেইল পাঠিয়েছি। নিশ্চিত করার পর নতুন ঠিকানায় যাচাইয়ের লিংক যাবে।"
          }
        }
      }
    },
