    "notify.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler seçili ilin vakitlerine göre telefonda hazırlanır, internet gerekmez. Liste uygulamayı her açışınızda yenilenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are prepared on your phone from the selected province's times; no internet needed. The list is renewed each time you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Benachrichtigungen werden auf Ihrem Telefon aus den Zeiten der gewählten Provinz erstellt, ohne Internet. Die Liste wird bei jedem Öffnen der App erneuert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirişlər seçilmiş vilayətin vaxtlarına görə telefonda hazırlanır, internet lazım deyil. Siyahı tətbiqi hər açanda yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُجهَّز الإشعارات على هاتفك وفق أوقات الولاية المختارة دون الحاجة إلى الإنترنت، وتتجدد القائمة كلما فتحت التطبيق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi disiapkan di ponsel Anda dari jadwal provinsi pilihan; tidak perlu internet. Daftarnya diperbarui setiap kali aplikasi dibuka."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات آپ کے فون پر منتخب صوبے کے اوقات سے تیار ہوتی ہیں؛ انٹرنیٹ کی ضرورت نہیں۔ ہر بار ایپ کھولنے پر فہرست تازہ ہوتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلان‌ها روی گوشی شما از اوقات استان انتخابی آماده می‌شوند؛ اینترنت لازم نیست. فهرست با هر بار باز کردن برنامه تازه می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont préparées sur votre téléphone à partir des heures de la province choisie ; aucune connexion n’est nécessaire. La liste est renouvelée à chaque ouverture de l’application."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления готовятся на телефоне по времени выбранной провинции; интернет не нужен. Список обновляется при каждом открытии приложения."
          }
        }
      }
    },
