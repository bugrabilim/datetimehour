        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يونيو: نسبةً إلى جونو، ملكة الآلهة عند الرومان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Juni dinamai dari Juno, ratu para dewa Romawi."
          }
