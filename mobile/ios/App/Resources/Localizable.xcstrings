    "focus.needUsage": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanım erişimini ver (öne gelen uygulamayı görmek için) ›"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant usage access (to see the app in front) ›"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzungszugriff erlauben (um die App im Vordergrund zu sehen) ›"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstifadə girişini ver (öndəki tətbiqi görmək üçün) ›"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح إذن الوصول إلى الاستخدام (لمعرفة التطبيق في الواجهة) ›"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri akses penggunaan (untuk melihat aplikasi di depan) ›"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "استعمال تک رسائی دیں (سامنے والی ایپ دیکھنے کے لیے) ›"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازهٔ دسترسی به استفاده (برای دیدن برنامهٔ جلو) ›"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accorder l’accès aux données d’utilisation (pour voir l’app au premier plan) ›"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дать доступ к истории использования (чтобы видеть активное приложение) ›"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用状況へのアクセスを許可（前面のアプリを知るため）›"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 기록 접근 허용(앞에 있는 앱을 알기 위해) ›"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授予使用情况访问权限（以了解前台应用）›"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magbigay ng usage access (para makita ang app sa harap) ›"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้สิทธิ์เข้าถึงการใช้งาน (เพื่อรู้ว่าแอปใดอยู่ด้านหน้า) ›"
          }
        }
      }
    },
    "focus.needOverlay": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Diğer uygulamaların üzerinde göster\" iznini ver ›"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow \"Display over other apps\" ›"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Über anderen Apps einblenden\" erlauben ›"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Digər tətbiqlərin üzərində göstər\" icazəsini ver ›"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بـ\"العرض فوق التطبيقات الأخرى\" ›"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan \"Tampilkan di atas aplikasi lain\" ›"
