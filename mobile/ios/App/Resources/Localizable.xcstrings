    "live.weather.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameranın yanında ve kilit ekranında görünür; × ile ya da Denetim Merkezi'nden kapatılır. iOS 8 saat sonra kaldırır; uygulamayı açınca geri gelir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appears next to the camera and on the Lock Screen; turn it off with × or from Control Center. iOS removes it after 8 hours; opening the app brings it back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anzeige erscheint neben der Kamera und auf dem Sperrbildschirm; mit × oder im Kontrollzentrum ausschalten. iOS entfernt sie nach 8 Stunden; beim Öffnen der App kommt sie zurück."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameranın yanında və kilid ekranında görünür; × ilə ya da İdarəetmə Mərkəzindən bağlanır. iOS 8 saatdan sonra onu silir; tətbiqi açanda geri gəlir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر بجانب الكاميرا وعلى شاشة القفل؛ أوقفها بـ × أو من مركز التحكم. يزيلها iOS بعد 8 ساعات، وتعود عند فتح التطبيق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampil di samping kamera dan di Layar Terkunci; matikan dengan × atau dari Pusat Kontrol. iOS menghapusnya setelah 8 jam; membuka aplikasi memunculkannya lagi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیمرے کے ساتھ اور لاک اسکرین پر دکھتا ہے؛ × سے یا کنٹرول سینٹر سے بند کریں۔ iOS اسے 8 گھنٹے بعد ہٹا دیتا ہے؛ ایپ کھولنے پر واپس آ جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کنار دوربین و روی صفحهٔ قفل دیده می‌شود؛ با × یا از مرکز کنترل خاموشش کنید. iOS پس از 8 ساعت برش می‌دارد؛ با باز کردن برنامه برمی‌گردد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'affiche à côté de la caméra et sur l'écran verrouillé ; désactivez-la avec × ou depuis le Centre de contrôle. iOS la retire après 8 heures ; ouvrir l'app la fait revenir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видна рядом с камерой и на экране блокировки; выключается кнопкой × или в Пункте управления. iOS убирает её через 8 часов; при открытии приложения она возвращается."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの横とロック画面に表示されます。×またはコントロールセンターでオフにできます。iOSは8時間後に消去し、アプリを開くと戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 옆과 잠금 화면에 표시됩니다. × 또는 제어 센터에서 끌 수 있습니다. iOS는 8시간 후 제거하며, 앱을 열면 다시 나타납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在摄像头旁和锁定屏幕上；可用 × 或在控制中心关闭。iOS 会在 8 小时后移除，打开应用即可恢复。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalabas sa tabi ng camera at sa Lock Screen; patayin gamit ang × o sa Control Center. Inaalis ito ng iOS pagkalipas ng 8 oras; babalik kapag binuksan ang app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงข้างกล้องและบนหน้าจอล็อก ปิดได้ด้วย × หรือจากศูนย์ควบคุม iOS จะนำออกหลัง 8 ชั่วโมง เปิดแอปแล้วจะกลับมา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece junto a la cámara y en la pantalla bloqueada; desactívela con × o desde el Centro de control. iOS la quita tras 8 horas; al abrir la app vuelve."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece ao lado da câmera e na tela bloqueada; desative com × ou na Central de Controle. O iOS o remove após 8 horas; ao abrir o app, ele volta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे के पास और लॉक स्क्रीन पर दिखता है; × से या कंट्रोल सेंटर से बंद करें। iOS इसे 8 घंटे बाद हटा देता है; ऐप खोलने पर लौट आता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরার পাশে ও লক স্ক্রিনে দেখা যায়; × দিয়ে বা কন্ট্রোল সেন্টার থেকে বন্ধ করুন। iOS 8 ঘণ্টা পর এটি সরিয়ে দেয়; অ্যাপ খুললে আবার আসে।"
          }
        }
      }
    },
