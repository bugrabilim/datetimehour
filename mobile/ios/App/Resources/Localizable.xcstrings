            "value": "Dekabr latınca decem, “on” sözündəndir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ديسمبر: من اللاتينية decem «عشرة»."
          }
        },
        "id": {
