    "alarm.sunriseNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon şarjda ve tam ekran saat açıkken, alarmdan önce ekran siyahtan sıcak bir gün doğumu rengine yavaşça aydınlanır. Uygulama kapalıyken telefonlar ekranı kendiliğinden açamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the phone is charging with the full-screen clock open, the screen slowly brightens from black to a warm sunrise colour before the alarm. Phones can't turn the screen on by themselves while the app is closed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Telefon lädt und die Vollbilduhr geöffnet ist, wird der Bildschirm vor dem Wecker langsam von Schwarz zu einem warmen Sonnenaufgangston heller. Bei geschlossener App kann das Telefon den Bildschirm nicht selbst einschalten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon şarjda və tam ekran saat açıq olanda, zəngdən əvvəl ekran qaradan isti gün çıxışı rənginə yavaş-yavaş işıqlanır. Tətbiq bağlı olanda telefon ekranı özü aça bilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يكون الهاتف على الشاحن والساعة بملء الشاشة مفتوحة، تضيء الشاشة ببطء من الأسود إلى لون شروق دافئ قبل المنبّه. لا يستطيع الهاتف تشغيل الشاشة بنفسه والتطبيق مغلق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ponsel diisi daya dengan jam layar penuh terbuka, layar perlahan berubah dari hitam ke warna fajar yang hangat sebelum alarm. Ponsel tidak bisa menyalakan layar sendiri saat aplikasi ditutup."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب فون پوری اسکرین گھڑی کھلی ہونے کے ساتھ چارج ہو رہا ہو تو الارم سے پہلے اسکرین آہستہ آہستہ سیاہ سے گرم طلوع کے رنگ میں روشن ہوتی ہے۔ ایپ بند ہو تو فون خود اسکرین آن نہیں کر سکتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی گوشی با ساعت تمام‌صفحهٔ باز در حال شارژ است، صفحه پیش از هشدار آرام‌آرام از سیاه به رنگ گرم طلوع روشن می‌شود. گوشی نمی‌تواند وقتی برنامه بسته است خودش صفحه را روشن کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le téléphone charge avec l’horloge plein écran ouverte, l’écran passe lentement du noir à une chaude couleur d’aube avant l’alarme. Un téléphone ne peut pas allumer l’écran seul quand l’app est fermée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда телефон заряжается с открытыми полноэкранными часами, экран перед будильником медленно светлеет от чёрного до тёплого цвета рассвета. Телефон не может сам включить экран, если приложение закрыто."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを充電しながら全画面時計を開いておくと、アラームの前に画面が黒から暖かい朝焼けの色へゆっくり明るくなります。アプリを閉じているとスマホは自分で画面をつけられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 충전하면서 전체 화면 시계를 열어 두면 알람 전에 화면이 검은색에서 따뜻한 일출 색으로 천천히 밝아집니다. 앱이 닫혀 있으면 휴대폰은 스스로 화면을 켤 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机充电并开着全屏时钟时，闹钟响前屏幕会从黑色慢慢亮成温暖的日出色。应用关闭时，手机无法自行点亮屏幕。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang nagcha-charge ang telepono at bukas ang full-screen na orasan, dahan-dahang lumiliwanag ang screen mula itim papunta sa mainit na kulay ng pagsikat bago ang alarma. Hindi kayang buksan ng telepono ang screen nang kusa habang sarado ang app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะชาร์จโทรศัพท์และเปิดนาฬิกาเต็มจอไว้ หน้าจอจะค่อย ๆ สว่างจากสีดำเป็นสีอรุณอบอุ่นก่อนนาฬิกาปลุก โทรศัพท์เปิดหน้าจอเองไม่ได้ขณะที่แอปปิดอยู่"
          }
        }
      }
    },
