    "kids.facts.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biliyor muydunuz?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you know?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wusstest du schon?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilirdinizmi?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تعلم؟"
          }
        }
      }
    },
    "kids.fact1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "21 Haziran yılın en uzun günü, 21 Aralık en uzun gecesidir (kuzey yarımkürede)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "June 21 is the longest day of the year and December 21 the longest night (in the northern half)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der 21. Juni ist der längste Tag des Jahres, der 21. Dezember die längste Nacht (auf der Nordhalbkugel)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "21 iyun ilin ən uzun günü, 21 dekabr isə ən uzun gecəsidir (şimal yarımkürəsində)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "21 يونيو أطول يوم في السنة و21 ديسمبر أطول ليلة (في النصف الشمالي)."
          }
        }
      }
    },
    "kids.fact2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mart ve Eylül'deki ekinoks günlerinde gece ile gündüz hemen hemen eşittir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the equinoxes in March and September, day and night are almost equal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An den Tagundnachtgleichen im März und September sind Tag und Nacht fast gleich lang."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mart və sentyabrdakı gecə-gündüz bərabərliyində gecə ilə gündüz demək olar ki, bərabərdir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في يومي الاعتدال في مارس وسبتمبر يتساوى الليل والنهار تقريبًا."
          }
        }
      }
    },
    "kids.fact3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuzey Kutbu'nda yazın aylarca Güneş batmaz, kışın da aylarca hiç doğmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the North Pole the Sun doesn't set for months in summer, and doesn't rise for months in winter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Nordpol geht die Sonne im Sommer monatelang nicht unter und im Winter monatelang nicht auf."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimal qütbündə yayda aylarla Günəş batmır, qışda isə aylarla heç doğmur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في القطب الشمالي لا تغرب الشمس لأشهر في الصيف، ولا تشرق لأشهر في الشتاء."
          }
        }
      }
    },
    "kids.fact4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekvatora yakın ülkelerde yaz ile kış arasında fark azdır; orada yağmurlu ve kurak mevsimler vardır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Near the equator summer and winter feel almost the same; instead there are rainy and dry seasons."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Nähe des Äquators sind Sommer und Winter fast gleich; dort gibt es Regen- und Trockenzeiten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekvatora yaxın ölkələrdə yay ilə qış arasında fərq azdır; orada yağışlı və quraq fəsillər olur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرب خط الاستواء يكاد الصيف والشتاء يتشابهان؛ وبدلًا منهما هناك موسم مطير وموسم جاف."
          }
        }
      }
    },
    "kids.fact5": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuzey yarımkürede yaz, kıştan birkaç gün uzundur: Dünya Güneş'ten uzaktayken biraz daha yavaş gider."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the northern half, summer is a few days longer than winter: Earth moves a little slower when it's farther from the Sun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Nordhalbkugel ist der Sommer ein paar Tage länger als der Winter: Weiter weg von der Sonne bewegt sich die Erde etwas langsamer."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimal yarımkürəsində yay qışdan bir neçə gün uzundur: Yer Günəşdən uzaqda olanda bir az yavaş gedir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في النصف الشمالي يكون الصيف أطول من الشتاء ببضعة أيام: فالأرض تتحرك أبطأ قليلًا حين تكون أبعد عن الشمس."
          }
        }
      }
    },
    "kids.more": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki yıllar"
          }
