    "widget.hijri.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün hicri tarihi (Diyanet takvimi) ve miladi tarih."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's Hijri date (Diyanet calendar) and Gregorian date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das heutige Hidschri-Datum (Diyanet-Kalender) und das gregorianische Datum."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün hicri tarixi (Diyanət təqvimi) və miladi tarix."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ الهجري لليوم (تقويم الشؤون الدينية التركية) والتاريخ الميلادي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal Hijriah hari ini (kalender Diyanet) dan tanggal Masehi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کی ہجری تاریخ (دیانت کیلنڈر) اور عیسوی تاریخ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ قمری امروز (تقویم دیانت) و تاریخ میلادی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date hégirienne du jour (calendrier de la Diyanet) et la date grégorienne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодняшняя дата по хиджре (календарь Diyanet) и григорианская дата."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のヒジュラ暦の日付（ディヤーネット暦）と西暦の日付。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 히즈라력 날짜(디야넷 달력)와 양력 날짜."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的伊斯兰历日期（迪亚内特历法）和公历日期。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang petsang Hijri ngayon (kalendaryo ng Diyanet) at petsang Gregorian."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ฮิจเราะห์วันนี้ (ปฏิทินดียาเนต) และวันที่สากล"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de la Hégira de hoy (calendario de Diyanet) y la fecha gregoriana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A data da Hégira de hoje (calendário da Diyanet) e a data gregoriana."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की हिजरी तारीख (दियानत कैलेंडर) और ग्रेगोरियन तारीख।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের হিজরি তারিখ (দিয়ানেতের ক্যালেন্ডার) ও খ্রিস্টীয় তারিখ।"
          }
        }
      }
    },
