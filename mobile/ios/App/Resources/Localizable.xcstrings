    "icon.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ekrandaki simge değişir; iOS değişikliği kısa bir mesajla bildirir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Home Screen icon changes; iOS shows a short message about it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Symbol auf dem Home-Bildschirm ändert sich; iOS zeigt dazu kurz eine Meldung."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas ekrandakı ikon dəyişir; iOS bunu qısa mesajla bildirir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتغير الأيقونة على الشاشة الرئيسية، ويعرض iOS رسالة قصيرة بذلك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon di Layar Utama berubah; iOS menampilkan pesan singkat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہوم اسکرین کا آئیکن بدل جاتا ہے؛ iOS ایک مختصر پیغام دکھاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نماد صفحه اصلی عوض می‌شود و iOS پیام کوتاهی نشان می‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’icône de l’écran d’accueil change ; iOS affiche un court message."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок на экране «Домой» меняется; iOS покажет короткое сообщение."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面のアイコンが変わり、iOSが短いメッセージを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면 아이콘이 바뀌며 iOS가 짧은 메시지를 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主屏幕图标会更换，iOS 会显示一条简短提示。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magbabago ang icon sa Home Screen; magpapakita ang iOS ng maikling mensahe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนบนหน้าจอโฮมจะเปลี่ยน และ iOS จะแสดงข้อความสั้นๆ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el icono de la pantalla de inicio; iOS muestra un breve mensaje al respecto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone da tela inicial muda; o iOS mostra uma mensagem curta sobre isso."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम स्क्रीन का आइकन बदलता है; iOS इसके बारे में एक छोटा संदेश दिखाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হোম স্ক্রিনের আইকন বদলায়; iOS এ বিষয়ে একটি ছোট বার্তা দেখায়।"
          }
        }
      }
    },
    "focus.sched": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirli saatlerde de engelle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also block at set times"
          }
