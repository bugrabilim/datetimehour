    "track.privacy": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgiler yalnız bu cihazda tutulur; hiçbir yere gönderilmez, rozet de verilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is kept only on this device; it is not sent anywhere and earns no badges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Angaben bleiben nur auf diesem Gerät; sie werden nirgendwohin gesendet und bringen keine Abzeichen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu məlumatlar yalnız bu cihazda saxlanılır; heç yerə göndərilmir, nişan da verilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ هذه المعلومات على هذا الجهاز فقط ولا تُرسل إلى أي مكان ولا تمنح شارات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data ini hanya disimpan di perangkat ini; tidak dikirim ke mana pun dan tidak memberi lencana."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ صرف اسی آلے پر رہتا ہے؛ کہیں نہیں بھیجا جاتا اور اس پر کوئی بیج نہیں ملتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این‌ها فقط روی همین دستگاه می‌مانند؛ به جایی فرستاده نمی‌شوند و نشانی نمی‌دهند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces données restent uniquement sur cet appareil ; elles ne sont envoyées nulle part et ne donnent aucun badge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это хранится только на этом устройстве, никуда не отправляется и значков не даёт."
          }
        }
      }
    },
