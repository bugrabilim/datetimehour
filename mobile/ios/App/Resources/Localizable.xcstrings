        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سورج اور زمین کے درمیان|زمین کی سورج سے مخالف سمت میں|سورج کے پیچھے"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بین خورشید و زمین|در سوی مقابل زمین نسبت به خورشید|پشت خورشید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre le Soleil et la Terre|De l'autre côté de la Terre par rapport au Soleil|Derrière le Soleil"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Между Солнцем и Землёй|По другую сторону Земли от Солнца|За Солнцем"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太陽と地球の間|地球をはさんで太陽の反対側|太陽の後ろ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태양과 지구 사이|지구를 사이에 두고 태양 반대편|태양 뒤"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太阳和地球之间|地球背向太阳的一侧|太阳后面"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa pagitan ng Araw at Daigdig|Sa kabilang panig ng Daigdig mula sa Araw|Sa likod ng Araw"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างดวงอาทิตย์กับโลก|ฝั่งตรงข้ามดวงอาทิตย์เมื่อมองจากโลก|ด้านหลังดวงอาทิตย์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre el Sol y la Tierra|Al otro lado de la Tierra respecto al Sol|Detrás del Sol"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre o Sol e a Terra|Do outro lado da Terra em relação ao Sol|Atrás do Sol"
