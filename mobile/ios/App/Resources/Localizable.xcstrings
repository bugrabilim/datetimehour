    "datecalc.diffNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş günü hesabında hafta sonları ve resmi tatiller çıkarılır; bayram arifesi yarım günleri 0,5 sayılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working days leave out weekends and public holidays; bayram eve half days count as 0.5."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wochenenden und gesetzliche Feiertage zählen nicht als Arbeitstage; halbe Vorabendtage vor den Bayram-Festen zählen als 0,5."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İş günlərinə həftəsonları və rəsmi bayramlar daxil edilmir; bayram ərəfəsindəki yarım iş günləri 0,5 sayılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشمل أيام العمل عطلات نهاية الأسبوع والعطل الرسمية؛ ويُحتسب نصف يوم وقفة العيد 0.5 يوم."
          }
        }
      }
    },
