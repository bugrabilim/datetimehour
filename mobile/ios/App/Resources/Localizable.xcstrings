    },
    "cals.vietnamese.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietnam'ın geleneksel ay-güneş takvimi (Âm lịch): Tết ve diğer bayramlar ile 24 güneş dönemi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietnam’s traditional lunisolar calendar (Âm lịch): Tết and other festivals, and the 24 solar terms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der traditionelle Lunisolarkalender Vietnams (Âm lịch): Tết und weitere Feste sowie die 24 Sonnenperioden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyetnamın ənənəvi ay-günəş təqvimi (Âm lịch): Tết və digər bayramlar, 24 günəş dövrü."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقويم القمري الشمسي التقليدي في فيتنام (Âm lịch): تيت والأعياد الأخرى، والفصول الشمسية الأربعة والعشرون."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender lunisolar tradisional Vietnam (Âm lịch): Tết dan perayaan lainnya, serta 24 periode matahari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ویتنام کا روایتی قمری شمسی کیلنڈر (Âm lịch): تیت اور دوسرے تہوار، اور 24 شمسی ادوار۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گاه‌شماری قمری‌خورشیدی سنتی ویتنام (Âm lịch): تت و جشن‌های دیگر و 24 دوره خورشیدی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier luni-solaire traditionnel du Vietnam (Âm lịch) : le Tết et autres fêtes, et les 24 termes solaires."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Традиционный лунно-солнечный календарь Вьетнама (Âm lịch): Тет и другие праздники, 24 солнечных сезона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベトナムの伝統的な太陰太陽暦（Âm lịch）。テトなどの祝祭日と二十四節気を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "베트남의 전통 태음태양력(Âm lịch): 뗏 등 명절과 24절기."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越南的传统阴阳历（Âm lịch）：越南春节（Tết）等传统节日和二十四节气。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang tradisyonal na lunisolar na kalendaryo ng Vietnam (Âm lịch): Tết at iba pang pista, at ang 24 na solar term."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินสุริยจันทรคติดั้งเดิมของเวียดนาม (Âm lịch): เต๊ตและเทศกาลอื่น ๆ และ 24 ช่วงฤดูกาลตามสุริยคติ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario lunisolar tradicional de Vietnam (Âm lịch): el Tết y otras fiestas, y los 24 términos solares."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário lunissolar tradicional do Vietnã (Âm lịch): o Tết e outras festas, e os 24 termos solares."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वियतनाम का पारंपरिक चंद्र-सौर कैलेंडर (Âm lịch): तेत और दूसरे पर्व, और 24 सौर अवधियाँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভিয়েতনামের প্রচলিত চান্দ্র-সৌর ক্যালেন্ডার (Âm lịch): তেত ও অন্যান্য উৎসব এবং 24টি সৌর পর্ব।"
          }
        }
      }
    },
    "cals.vietnamese.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay başları ve güneş dönemleri Vietnam saatiyle (UTC+7) astronomik hesaptan; yeni ay gece yarısına çok yakınsa bazı takvimler ayı bir gün sonra başlatabilir. Tết burada ilk üç günüyle gösterilir; resmî tatilin süresini her yıl hükümet belirler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Month starts and solar terms are calculated astronomically for Vietnam time (UTC+7); when a new moon falls very close to midnight, some calendars start the month one day later. Tết is shown with its first three days; the length of the public holiday is set by the government each year."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monatsanfänge und Sonnenperioden werden astronomisch für die vietnamesische Zeit (UTC+7) berechnet; liegt ein Neumond sehr nahe an Mitternacht, beginnen manche Kalender den Monat einen Tag später. Tết wird mit seinen ersten drei Tagen gezeigt; die Dauer des gesetzlichen Feiertags legt die Regierung jedes Jahr fest."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay başlanğıcları və günəş dövrləri Vyetnam vaxtı ilə (UTC+7) astronomik hesablanır; yeni ay gecə yarısına çox yaxın olduqda bəzi təqvimlər ayı bir gün sonra başladır. Tết burada ilk üç günü ilə göstərilir; rəsmi tətilin müddətini hər il hökumət müəyyən edir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب بدايات الأشهر والفصول الشمسية فلكيًا بتوقيت فيتنام (UTC+7)، وإذا وقع المحاق قريبًا جدًا من منتصف الليل فقد تبدأ بعض التقاويم الشهر بعد يوم. يُعرض تيت بأيامه الثلاثة الأولى، وتحدد الحكومة مدة العطلة الرسمية كل عام."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Awal bulan dan periode matahari dihitung secara astronomis menurut waktu Vietnam (UTC+7); jika bulan baru jatuh sangat dekat dengan tengah malam, beberapa kalender memulai bulan sehari kemudian. Tết ditampilkan dengan tiga hari pertamanya; lama libur resmi ditetapkan pemerintah setiap tahun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مہینوں کا آغاز اور شمسی ادوار ویتنام کے وقت (UTC+7) کے مطابق فلکیاتی حساب سے ہیں؛ اگر نیا چاند آدھی رات کے بہت قریب ہو تو کچھ کیلنڈر مہینہ ایک دن بعد شروع کرتے ہیں۔ تیت یہاں اپنے پہلے تین دنوں کے ساتھ دکھایا گیا ہے؛ سرکاری تعطیل کی مدت ہر سال حکومت طے کرتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آغاز ماه‌ها و دوره‌های خورشیدی به وقت ویتنام (UTC+7) و با محاسبه نجومی است؛ اگر ماه نو بسیار نزدیک نیمه‌شب باشد، برخی تقویم‌ها ماه را یک روز دیرتر آغاز می‌کنند. تت با سه روز نخستش نشان داده می‌شود؛ مدت تعطیلات رسمی را دولت هر سال تعیین می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les débuts de mois et les termes solaires sont calculés astronomiquement pour l’heure du Vietnam (UTC+7) ; quand une nouvelle lune tombe très près de minuit, certains calendriers commencent le mois un jour plus tard. Le Tết est affiché avec ses trois premiers jours ; la durée du congé officiel est fixée chaque année par le gouvernement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начала месяцев и сезоны рассчитаны астрономически по времени Вьетнама (UTC+7); если новолуние приходится почти на полночь, некоторые календари начинают месяц на день позже. Тет показан первыми тремя днями; продолжительность официальных выходных ежегодно устанавливает правительство."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の始まりと二十四節気はベトナム時間（UTC+7）で天文計算しており、新月が真夜中にごく近い月は1日遅く始める暦もあります。テトは最初の3日間を表示し、公休日の長さは毎年政府が定めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월의 시작과 24절기는 베트남 시간(UTC+7)으로 천문 계산했으며, 합삭이 자정에 아주 가까우면 하루 늦게 달을 시작하는 달력도 있습니다. 뗏은 처음 사흘을 표시하며, 공휴일 기간은 해마다 정부가 정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月首和二十四节气按越南时间（UTC+7）天文计算；朔日非常接近午夜时，有些历书会晚一天开始该月。越南春节显示前三天，法定假期长度每年由政府决定。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang simula ng mga buwan at ang mga solar term ay kinakalkula ayon sa astronomiya sa oras ng Vietnam (UTC+7); kapag napakalapit sa hatinggabi ang bagong buwan, may mga kalendaryong nagsisimula ng buwan nang isang araw na mas huli. Ipinapakita ang Tết sa unang tatlong araw nito; ang haba ng opisyal na bakasyon ay itinatakda ng pamahalaan taon-taon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันเริ่มเดือนและฤดูกาลสุริยะคำนวณทางดาราศาสตร์ตามเวลาเวียดนาม (UTC+7) หากจันทร์ดับใกล้เที่ยงคืนมาก ปฏิทินบางฉบับอาจเริ่มเดือนช้ากว่าหนึ่งวัน เต๊ตแสดงสามวันแรก ส่วนจำนวนวันหยุดราชการรัฐบาลกำหนดทุกปี"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de los meses y los términos solares se calculan astronómicamente para la hora de Vietnam (UTC+7); cuando la luna nueva cae muy cerca de la medianoche, algunos calendarios empiezan el mes un día después. El Tết se muestra con sus tres primeros días; la duración del feriado oficial la fija el Gobierno cada año."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O início dos meses e os termos solares são calculados astronomicamente pelo horário do Vietnã (UTC+7); quando a lua nova cai muito perto da meia-noite, alguns calendários começam o mês um dia depois. O Tết aparece com seus três primeiros dias; a duração do feriado oficial é definida pelo governo a cada ano."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महीनों की शुरुआत और सौर अवधियाँ वियतनाम के समय (UTC+7) के अनुसार खगोलीय गणना से हैं; अमावस्या आधी रात के बहुत पास हो तो कुछ कैलेंडर महीना एक दिन बाद शुरू करते हैं। तेत यहाँ अपने पहले तीन दिनों के साथ दिखाया गया है; सार्वजनिक अवकाश की अवधि हर साल सरकार तय करती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাস শুরু ও সৌর পর্বগুলো ভিয়েতনামের সময়ের (UTC+7) জন্য জ্যোতির্বিজ্ঞানের হিসাবে বের করা; অমাবস্যা মধ্যরাতের খুব কাছে পড়লে কিছু ক্যালেন্ডার মাস এক দিন পরে শুরু করে। তেত তার প্রথম তিন দিনসহ দেখানো হয়েছে; সরকারি ছুটির দৈর্ঘ্য প্রতি বছর সরকার নির্ধারণ করে।"
          }
        }
      }
    },
