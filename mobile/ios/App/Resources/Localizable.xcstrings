        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उल्का वर्षा, ग्रहों का मिलन, विमुखता (उसी शाम 20:00 बजे)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উল্কাবৃষ্টি, গ্রহদের কাছাকাছি আসা, প্রতিযোগ (সেদিন সন্ধ্যা 20:00-এ)"
          }
        }
      }
