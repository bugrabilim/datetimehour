    "nature.lightNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altın saat: Güneş ufkun 6° üstü ile 4° altı arasında; yumuşak, sıcak ışık. Mavi saat: Güneş ufkun 4° ile 6° altında; mavi alacakaranlık. Fotoğrafçılar için."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Golden hour: the Sun between 6° above and 4° below the horizon, with soft, warm light. Blue hour: the Sun 4° to 6° below the horizon, a blue twilight. Handy for photographers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldene Stunde: Sonne zwischen 6° über und 4° unter dem Horizont, weiches warmes Licht. Blaue Stunde: Sonne 4° bis 6° unter dem Horizont, blaue Dämmerung. Praktisch für Fotografen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qızıl saat: Günəş üfüqün 6° üstü ilə 4° altı arasında; yumşaq, isti işıq. Mavi saat: Günəş üfüqün 4° ilə 6° altında; mavi alatoran. Fotoqraflar üçün."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة الذهبية: الشمس بين 6° فوق الأفق و4° تحته، بضوء دافئ ناعم. الساعة الزرقاء: الشمس بين 4° و6° تحت الأفق، شفق أزرق. مفيدة للمصورين."
          }
        }
      }
    },
    "zakat.fitreHeading": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitre (sadaka-i fıtr)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitra (zakat al-fitr)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitra (Zakat al-Fitr)"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitrə (sədəqeyi-fitr)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زكاة الفطر"
          }
        }
      }
    },
    "zakat.fitreText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyanet İşleri Başkanlığı Din İşleri Yüksek Kurulu %1$@ yılı için fitreyi kişi başı %2$@ TL olarak açıkladı (%3$@). Geçerlilik: %1$@ Ramazan ayından bir sonraki Ramazan'a kadar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turkey's Presidency of Religious Affairs (High Board of Religious Affairs) set the %1$@ fitra at %2$@ TL per person (%3$@), valid from Ramadan %1$@ until the next Ramadan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hohe Rat für Religionsangelegenheiten des Diyanet hat die Fitra für %1$@ auf %2$@ TL pro Person festgelegt (%3$@); gültig ab Ramadan %1$@ bis zum nächsten Ramadan."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiyə Diyanət İşləri Başqanlığının Din İşləri Ali Şurası %1$@ ili üçün fitrəni adambaşına %2$@ TL açıqladı (%3$@). Etibarlıdır: %1$@ Ramazanından növbəti Ramazana qədər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حددت الهيئة العليا للشؤون الدينية في رئاسة الشؤون الدينية التركية زكاة الفطر لعام %1$@ بمبلغ %2$@ ليرة للشخص (%3$@)، وتسري من رمضان %1$@ حتى رمضان التالي."
          }
        }
      }
    },
    "zakat.fitrePeople": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişi sayısı (bakmakla yükümlü olduklarınız dahil)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Number of people (including your dependants)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzahl der Personen (einschließlich Unterhaltsberechtigter)"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Adam sayı (himayənizdəkilər daxil)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد الأشخاص (بمن تعولهم)"
          }
        }
      }
    },
    "zakat.fitreTotal": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam fitre"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total fitra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitra gesamt"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cəmi fitrə"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجمالي زكاة الفطر"
          }
        }
      }
    },
    "zakat.fitreNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutar Türkiye için ve en düşük ölçüdür; imkânı olan hurma, üzüm gibi daha yüksek ölçüyle verebilir. Fitre bayram namazından önce verilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The amount is for Turkey and is the minimum; those who can may give more (by the measure of dates or raisins). Fitra is given before the Eid prayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betrag gilt für die Türkei und ist das Minimum; wer kann, gibt mehr (nach dem Maß von Datteln oder Rosinen). Die Fitra wird vor dem Festgebet gegeben."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məbləğ Türkiyə üçündür və ən aşağı ölçüdür; imkanı olan xurma, kişmiş kimi daha yüksək ölçü ilə verə bilər. Fitrə bayram namazından əvvəl verilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المبلغ خاص بتركيا وهو الحد الأدنى؛ ومن استطاع أن يعطي أكثر (بمقدار التمر أو الزبيب) فله ذلك. تُخرج قبل صلاة العيد."
          }
        }
      }
    },
