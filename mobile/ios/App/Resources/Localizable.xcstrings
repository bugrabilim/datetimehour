        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виден невооружённым глазом в идеальных условиях"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件が完璧なら肉眼で見える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조건이 완벽하면 맨눈으로 보임"
          }
        },
        "zh-Hans": {
