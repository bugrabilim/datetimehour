    "notify.reopen": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakit bildirimlerinin sürmesi için uygulamayı açın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app to keep prayer time notifications coming."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die App, damit die Benachrichtigungen weiterlaufen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxt bildirişlərinin davam etməsi üçün tətbiqi açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح التطبيق لتستمر إشعارات أوقات الصلاة."
          }
        }
      }
    },
    "notify.denied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim izni kapalı. Ayarlar'dan bu uygulama için bildirimlere izin verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off. Allow notifications for this app in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind deaktiviert. Erlauben Sie sie für diese App in den Einstellungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirişlər bağlıdır. Parametrlərdə bu tətbiq üçün bildirişlərə icazə verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات متوقفة. اسمح بها لهذا التطبيق من الإعدادات."
          }
        }
      }
    },
    "notify.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları aç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametrləri aç"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الإعدادات"
          }
        }
      }
    },
    "notify.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler seçili ilin vakitlerine göre telefonda hazırlanır, internet gerekmez. Liste uygulamayı her açışınızda yenilenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are prepared on your phone from the selected province's times; no internet needed. The list is renewed each time you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Benachrichtigungen werden auf Ihrem Telefon aus den Zeiten der gewählten Provinz erstellt, ohne Internet. Die Liste wird bei jedem Öffnen der App erneuert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirişlər seçilmiş vilayətin vaxtlarına görə telefonda hazırlanır, internet lazım deyil. Siyahı tətbiqi hər açanda yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُجهَّز الإشعارات على هاتفك وفق أوقات الولاية المختارة دون الحاجة إلى الإنترنت، وتتجدد القائمة كلما فتحت التطبيق."
          }
        }
      }
    }
  },
  "version": "1.0"
}
