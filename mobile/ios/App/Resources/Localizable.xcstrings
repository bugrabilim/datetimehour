    "account.photoNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf cihazınızda 512 piksele küçültülür, konum gibi gizli bilgileri silinir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photo is resized to 512 pixels on your device, and hidden information such as location is removed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto wird auf Ihrem Gerät auf 512 Pixel verkleinert, versteckte Angaben wie der Standort werden entfernt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto cihazınızda 512 pikselə kiçildilir, məkan kimi gizli məlumatlar silinir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُصغَّر الصورة على جهازك إلى 512 بكسل وتُحذف منها المعلومات الخفية مثل الموقع."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto diperkecil menjadi 512 piksel di perangkat Anda, dan informasi tersembunyi seperti lokasi dihapus."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر آپ کے آلے پر 512 پکسل تک چھوٹی کی جاتی ہے اور مقام جیسی چھپی معلومات ہٹا دی جاتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکس روی دستگاه شما به 512 پیکسل کوچک می‌شود و اطلاعات پنهانی مانند مکان از آن پاک می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo est réduite à 512 pixels sur votre appareil, et les informations cachées comme la position sont supprimées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото уменьшается до 512 пикселей на вашем устройстве, скрытые сведения, например местоположение, удаляются."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は端末上で512ピクセルに縮小され、位置情報などの隠れた情報は削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 기기에서 512픽셀로 줄어들고 위치 같은 숨은 정보가 지워집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片会在您的设备上缩小到 512 像素，并删除位置等隐藏信息。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinaliliit ang larawan sa 512 pixel sa inyong device at inaalis ang nakatagong impormasyon gaya ng lokasyon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปจะถูกย่อเหลือ 512 พิกเซลบนอุปกรณ์ของคุณ และลบข้อมูลแฝงอย่างตำแหน่งออก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto se reduce a 512 píxeles en su dispositivo y se borran datos ocultos como la ubicación."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto é reduzida para 512 pixels no seu aparelho e informações ocultas como a localização são apagadas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो आपके डिवाइस पर 512 पिक्सेल तक छोटी की जाती है और स्थान जैसी छिपी जानकारी हटा दी जाती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিটি আপনার ডিভাইসে 512 পিক্সেলে ছোট করা হয় এবং অবস্থানের মতো লুকানো তথ্য মুছে ফেলা হয়।"
          }
        }
      }
    },
