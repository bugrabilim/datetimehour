        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রোজা ও নামাজ কবুল হোক।"
          }
        }
      }
    },
    "greet.m.ramadan.4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Ramazan gönlünüze sükûnet getirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May this Ramadan bring calm to your heart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möge dieser Ramadan Ihrem Herzen Ruhe schenken."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Ramazan qəlbinizə rahatlıq gətirsin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جعل الله رمضان هذا راحةً لقلوبكم."
