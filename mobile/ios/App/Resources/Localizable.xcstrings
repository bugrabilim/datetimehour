    "perms.screenTime.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız odak sırasında seçtiğiniz uygulamaları kısıtlamak için. Hangi uygulamaları seçtiğinizi biz göremeyiz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only to limit the apps you choose during focus time. We can't see which apps you chose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur um während der Fokuszeit die ausgewählten Apps zu begrenzen. Welche Apps Sie gewählt haben, sehen wir nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız fokus vaxtında seçdiyiniz tətbiqləri məhdudlaşdırmaq üçün. Hansı tətbiqləri seçdiyinizi biz görə bilmirik."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتقييد التطبيقات التي تختارها أثناء التركيز فقط. لا يمكننا رؤية التطبيقات التي اخترتها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk membatasi aplikasi pilihan Anda saat fokus. Kami tidak bisa melihat aplikasi yang Anda pilih."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف فوکس کے دوران چنی ہوئی ایپس کو محدود کرنے کے لیے۔ ہم نہیں دیکھ سکتے کہ آپ نے کون سی ایپس چنیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط برای محدود کردن برنامه‌های انتخابی شما هنگام تمرکز. ما نمی‌بینیم کدام برنامه‌ها را انتخاب کرده‌اید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour limiter les applis choisies pendant la concentration. Nous ne voyons pas lesquelles vous avez choisies."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только чтобы ограничивать выбранные приложения во время фокуса. Какие приложения вы выбрали, мы не видим."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中している間、選んだアプリを制限するためだけに使います。どのアプリを選んだかは私たちには見えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중하는 동안 고른 앱을 제한하는 데만 써요. 어떤 앱을 골랐는지 저희는 볼 수 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于在专注时限制您选中的应用。我们看不到您选了哪些应用。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lang limitahan ang mga app na pinili mo habang nakatuon. Hindi namin nakikita kung aling mga app ang pinili mo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เพื่อจำกัดแอปที่คุณเลือกระหว่างช่วงโฟกัสเท่านั้น เรามองไม่เห็นว่าคุณเลือกแอปใด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para limitar las apps que elija mientras se concentra. No podemos ver qué apps eligió."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para limitar os apps que você escolher durante o foco. Não conseguimos ver quais apps você escolheu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ फ़ोकस के दौरान चुने गए ऐप सीमित करने के लिए। हम नहीं देख सकते कि आपने कौन-से ऐप चुने।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু মনোযোগের সময় আপনার বাছা অ্যাপ সীমিত রাখতে। আপনি কোন অ্যাপ বেছেছেন আমরা দেখতে পাই না।"
          }
        }
      }
    },
    "perms.overlay.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer uygulamaların üstünde"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display over other apps"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über anderen Apps einblenden"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Digər tətbiqlərin üstündə"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الظهور فوق التطبيقات الأخرى"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampil di atas aplikasi lain"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسری ایپس کے اوپر دکھانا"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایش روی برنامه‌های دیگر"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Superposition"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверх других приложений"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリの上に表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱 위에 표시"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他应用上层显示"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipakita sa ibabaw ng ibang app"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงทับแอปอื่น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar sobre otras apps"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrepor a outros apps"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे ऐप के ऊपर दिखाना"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য অ্যাপের ওপরে দেখানো"
          }
        }
      }
    },
    "perms.overlay.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız yüzen saat ve odak ekranı için. Vermezseniz bu ikisi çalışmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for the floating clock and the focus screen. Without it, these two don't work."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für die schwebende Uhr und den Fokusbildschirm. Ohne diese Berechtigung funktionieren beide nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız üzən saat və fokus ekranı üçün. Verməsəniz, bu ikisi işləmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للساعة العائمة وشاشة التركيز فقط. وإن لم تسمح، لا تعمل هاتان الميزتان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk jam melayang dan layar fokus. Jika tidak diizinkan, keduanya tidak berfungsi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف تیرتی گھڑی اور فوکس اسکرین کے لیے۔ نہ دیں تو یہ دونوں کام نہیں کریں گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط برای ساعت شناور و صفحه‌ی تمرکز. اگر ندهید، این دو کار نمی‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour l'horloge flottante et l'écran de concentration. Sinon, ces deux fonctions ne marchent pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для плавающих часов и экрана фокуса. Без этого они не работают."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フローティング時計と集中画面だけに使います。許可しないとこの2つは動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "떠 있는 시계와 집중 화면에만 써요. 허용하지 않으면 이 두 기능은 작동하지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于悬浮时钟和专注屏幕。不允许则这两项无法使用。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lang sa lumulutang na orasan at focus screen. Kung hindi, hindi gagana ang dalawang ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เฉพาะนาฬิกาลอยและหน้าจอโฟกัส ถ้าไม่อนุญาต ทั้งสองอย่างจะใช้ไม่ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para el reloj flotante y la pantalla de concentración. Si no, ninguna de las dos funciona."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para o relógio flutuante e a tela de foco. Se não, esses dois não funcionam."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ तैरती घड़ी और फ़ोकस स्क्रीन के लिए। न दें तो ये दोनों काम नहीं करेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু ভাসমান ঘড়ি ও মনোযোগের পর্দার জন্য। এটি ছাড়া এই দুটি কাজ করে না।"
          }
        }
      }
    },
    "perms.usage.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
