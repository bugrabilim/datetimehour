    "onboard.tour.alarm.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon sessizdeyken de çalan alarm; kapatmak için matematik, sallama ya da kod okutma gibi görevler. Uyku planı, uyku sesleri ve akıllı alarm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms that ring even in silent mode, with tasks to turn them off such as math, shaking or scanning a code. A sleep plan, sleep sounds and a smart alarm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker, die auch im Stummmodus klingeln, mit Aufgaben zum Ausschalten wie Rechnen, Schütteln oder Code scannen. Schlafplan, Schlafgeräusche und smarter Wecker."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon səssizdə olanda da çalan zəngli saat; söndürmək üçün riyaziyyat, silkələmə ya da kod oxutma kimi tapşırıqlar. Yuxu planı, yuxu səsləri və ağıllı zəngli saat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منبه يرن حتى في الوضع الصامت، مع مهام لإيقافه مثل مسألة حسابية أو هزّ الهاتف أو مسح رمز. خطة النوم وأصوات النوم والمنبه الذكي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm yang tetap berbunyi dalam mode senyap, dengan tugas untuk mematikannya seperti hitungan, mengguncang, atau memindai kode. Rencana tidur, suara tidur, dan alarm pintar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون خاموش ہو تب بھی بجنے والا الارم؛ بند کرنے کے لیے حساب، فون ہلانا یا کوڈ اسکین کرنا جیسے کام۔ نیند کا منصوبہ، نیند کی آوازیں اور اسمارٹ الارم۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زنگی که در حالت بی‌صدا هم به صدا درمی‌آید، با کارهایی برای خاموش کردنش مثل حساب، تکان دادن یا اسکن کد. برنامهٔ خواب، صداهای خواب و زنگ هوشمند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un réveil qui sonne même en mode silencieux, avec des tâches pour l'arrêter : calcul, secousses ou scan d'un code. Plan de sommeil, sons pour dormir et réveil intelligent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильник звонит даже в беззвучном режиме, а для отключения есть задания: пример, встряхивание или сканирование кода. План сна, звуки для сна и умный будильник."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マナーモードでも鳴るアラーム。止めるには計算、振る、コードの読み取りなどのタスク。睡眠プラン、睡眠用サウンド、スマートアラームも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무음 모드에서도 울리는 알람, 끄려면 계산·흔들기·코드 스캔 같은 과제를 해야 해요. 수면 계획, 수면 사운드, 스마트 알람도 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静音模式下也会响的闹钟，关闭时需完成算术、摇动手机或扫码等任务。还有睡眠计划、助眠声音和智能闹钟。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm na tumutunog kahit naka-silent, na may gawain para patayin ito gaya ng math, pag-alog o pag-scan ng code. May plano sa pagtulog, tunog pampatulog at smart alarm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาปลุกที่ดังแม้ในโหมดเงียบ พร้อมภารกิจเพื่อปิด เช่น คิดเลข เขย่าโทรศัพท์ หรือสแกนโค้ด มีแผนการนอน เสียงช่วยนอน และนาฬิกาปลุกอัจฉริยะ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmas que suenan incluso en silencio, con tareas para apagarlas como cálculos, agitar el teléfono o escanear un código. Plan de sueño, sonidos para dormir y alarma inteligente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmes que tocam até no modo silencioso, com tarefas para desligar como fazer contas, chacoalhar o celular ou ler um código. Plano de sono, sons para dormir e alarme inteligente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइलेंट मोड में भी बजने वाला अलार्म; बंद करने के लिए गणित, फ़ोन हिलाना या कोड स्कैन करना जैसे काम। नींद की योजना, नींद की आवाज़ें और स्मार्ट अलार्म।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নীরব মোডেও বাজে এমন অ্যালার্ম, বন্ধ করতে গণিত, ঝাঁকানো বা কোড স্ক্যানের মতো কাজসহ। ঘুমের সূচি, ঘুমের শব্দ ও স্মার্ট অ্যালার্ম।"
          }
        }
      }
    },
