    "sleep.sunriseInfo": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir alarmda \"Gün doğumu ışığı\"nı seçin (Araçlar › Alarm). Yatarken telefonu şarja takıp tam ekran saati açık bırakın (gece modu da olur): alarmdan 10–30 dakika önce ekran yavaşça aydınlanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose \"Sunrise light\" on an alarm (Tools › Alarm). At bedtime, put the phone on its charger and leave the full-screen clock open (night mode works too): the screen slowly brightens 10–30 minutes before the alarm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie bei einem Wecker „Sonnenaufgangslicht“ (Werkzeuge › Wecker). Legen Sie das Telefon zum Schlafen ans Ladegerät und lassen Sie die Vollbilduhr geöffnet (auch im Nachtmodus): 10–30 Minuten vor dem Wecker wird der Bildschirm langsam heller."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəngdə \"Gün çıxışı işığı\"nı seçin (Alətlər › Zəngli saat). Yatanda telefonu şarja qoşub tam ekran saatı açıq saxlayın (gecə rejimi də olar): zəngdən 10–30 dəqiqə əvvəl ekran yavaş-yavaş işıqlanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر \"ضوء الشروق\" في أحد المنبّهات (الأدوات › المنبّه). عند النوم ضع الهاتف على الشاحن واترك الساعة بملء الشاشة مفتوحة (يعمل الوضع الليلي أيضًا): تضيء الشاشة ببطء قبل المنبّه بـ 10–30 دقيقة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih \"Cahaya fajar\" pada alarm (Alat › Alarm). Saat tidur, isi daya ponsel dan biarkan jam layar penuh terbuka (mode malam juga bisa): layar perlahan menjadi terang 10–30 menit sebelum alarm."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی الارم پر «طلوع کی روشنی» منتخب کریں (ٹولز › الارم)۔ سوتے وقت فون چارجر پر لگائیں اور پوری اسکرین گھڑی کھلی رہنے دیں (رات کا موڈ بھی چلتا ہے): الارم سے 10–30 منٹ پہلے اسکرین آہستہ روشن ہوتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«نور طلوع» را روی یک هشدار برگزینید (ابزارها › هشدار). هنگام خواب گوشی را به شارژ بزنید و ساعت تمام‌صفحه را باز بگذارید (حالت شب هم کار می‌کند): صفحه 10 تا 30 دقیقه پیش از هشدار آرام روشن می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez « Lumière de l’aube » sur une alarme (Outils › Alarme). Au coucher, branchez le téléphone et laissez l’horloge plein écran ouverte (le mode nuit fonctionne aussi) : l’écran s’éclaire lentement 10 à 30 minutes avant l’alarme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Свет рассвета» в будильнике (Инструменты › Будильник). Перед сном поставьте телефон на зарядку и оставьте полноэкранные часы открытыми (подойдёт и ночной режим): экран медленно светлеет за 10–30 минут до будильника."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームで「日の出の光」を選びます（ツール › アラーム）。寝るときにスマホを充電器につなぎ、全画面時計を開いたままにします（ナイトモードでも可）。アラームの10～30分前に画面がゆっくり明るくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람에서 \"일출 빛\"을 고르세요(도구 › 알람). 잘 때 휴대폰을 충전기에 꽂고 전체 화면 시계를 열어 두세요(야간 모드도 됩니다). 알람 10~30분 전에 화면이 천천히 밝아집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在闹钟中选择“日出光”（工具 › 闹钟）。睡前把手机接上充电器并开着全屏时钟（夜间模式也可以）：闹钟前10–30分钟屏幕会慢慢变亮。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin ang \"Liwanag ng pagsikat\" sa isang alarma (Kagamitan › Alarma). Sa oras ng pagtulog, ilagay ang telepono sa charger at iwanang bukas ang full-screen na orasan (gumagana rin ang night mode): dahan-dahang lumiliwanag ang screen 10–30 minuto bago ang alarma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก \"แสงอรุณ\" ในนาฬิกาปลุก (เครื่องมือ › นาฬิกาปลุก) ก่อนนอนให้เสียบชาร์จโทรศัพท์และเปิดนาฬิกาเต็มจอทิ้งไว้ (ใช้โหมดกลางคืนได้) หน้าจอจะค่อย ๆ สว่างขึ้น 10–30 นาทีก่อนนาฬิกาปลุก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija \"Luz de amanecer\" en una alarma (Herramientas › Alarma). Al acostarse, ponga el teléfono a cargar y deje abierto el reloj a pantalla completa (también vale el modo nocturno): la pantalla se ilumina poco a poco 10–30 minutos antes de la alarma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha \"Luz do amanhecer\" num alarme (Ferramentas › Alarme). Na hora de dormir, coloque o celular no carregador e deixe o relógio em tela cheia aberto (o modo noturno também funciona): a tela clareia aos poucos 10–30 minutos antes do alarme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी अलार्म में \"सूर्योदय की रोशनी\" चुनें (टूल › अलार्म)। सोते समय फ़ोन चार्जर पर लगाएँ और फ़ुल स्क्रीन घड़ी खुली छोड़ें (रात्रि मोड भी चलेगा): अलार्म से 10–30 मिनट पहले स्क्रीन धीरे-धीरे चमकने लगती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অ্যালার্মে \"সূর্যোদয়ের আলো\" বেছে নিন (টুলস › অ্যালার্ম)। শোয়ার সময় ফোন চার্জারে রেখে পূর্ণ পর্দার ঘড়ি খোলা রাখুন (রাত মোডেও কাজ করে): অ্যালার্মের 10–30 মিনিট আগে পর্দা ধীরে ধীরে উজ্জ্বল হয়।"
          }
        }
      }
    },
    "sleep.privacy": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku takibi yapılmaz, mikrofon kullanılmaz. Akıllı alarm oturumu açıkken yalnız alarm penceresinde hareket algılayıcısı okunur; veri kaydedilmez. Plan ve ayarlar yalnız bu telefonda durur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no sleep tracking and the microphone is not used. While a smart alarm session is on, the motion sensor is read only during the alarm window; nothing is saved. Your schedule and settings stay on this phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Schlafaufzeichnung, das Mikrofon wird nicht verwendet. Während einer Sitzung mit intelligentem Wecker wird der Bewegungssensor nur im Zeitfenster gelesen; nichts wird gespeichert. Plan und Einstellungen bleiben auf diesem Telefon."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuxu izlənmir, mikrofon istifadə olunmur. Ağıllı zəng sessiyası açıq olanda hərəkət sensoru yalnız zəng pəncərəsində oxunur; heç nə saxlanılmır. Plan və ayarlar yalnız bu telefonda qalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد تتبّع للنوم ولا يُستخدم الميكروفون. أثناء جلسة المنبّه الذكي لا يُقرأ مستشعر الحركة إلا خلال نافذة المنبّه؛ ولا يُحفظ شيء. يبقى الجدول والإعدادات على هذا الهاتف فقط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pelacakan tidur dan mikrofon tidak dipakai. Selama sesi alarm pintar, sensor gerak hanya dibaca dalam jendela alarm; tidak ada yang disimpan. Jadwal dan pengaturan Anda tetap di ponsel ini."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیند کی ٹریکنگ نہیں ہوتی اور مائیکروفون استعمال نہیں ہوتا۔ سمارٹ الارم سیشن کے دوران حرکت کا سینسر صرف الارم کے وقفے میں پڑھا جاتا ہے؛ کچھ محفوظ نہیں ہوتا۔ آپ کا شیڈول اور ترتیبات اسی فون پر رہتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ردیابی خواب در کار نیست و از میکروفون استفاده نمی‌شود. در جلسهٔ هشدار هوشمند، حسگر حرکت فقط در بازهٔ هشدار خوانده می‌شود؛ چیزی ذخیره نمی‌شود. برنامه و تنظیمات شما روی همین گوشی می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de suivi du sommeil et le micro n’est pas utilisé. Pendant une session de réveil intelligent, le capteur de mouvement n’est lu que dans la plage de l’alarme ; rien n’est conservé. Votre programme et vos réglages restent sur ce téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживания сна нет, микрофон не используется. Во время сеанса умного будильника данные датчика движения считываются только в окне будильника; ничего не сохраняется. Режим и настройки остаются на этом телефоне."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠の記録はせず、マイクも使いません。スマートアラームのセッション中は、アラームの時間帯だけ動きのセンサーを読み取り、何も保存しません。スケジュールと設定はこのスマホに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 추적은 하지 않고 마이크도 쓰지 않습니다. 스마트 알람 세션 중에는 알람 시간대에만 동작 센서를 읽으며 아무것도 저장하지 않습니다. 일정과 설정은 이 휴대폰에 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不追踪睡眠，也不使用麦克风。智能闹钟会话期间，只在闹钟时间窗口内读取运动传感器，不保存任何内容。您的计划和设置留在这部手机上。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang sleep tracking at hindi ginagamit ang mikropono. Habang may session ng matalinong alarma, binabasa lang ang motion sensor sa window ng alarma; walang sine-save. Nananatili sa teleponong ito ang iyong schedule at settings."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการติดตามการนอนและไม่ใช้ไมโครโฟน ระหว่างเซสชันนาฬิกาปลุกอัจฉริยะ จะอ่านเซนเซอร์การเคลื่อนไหวเฉพาะในช่วงเวลาปลุก และไม่บันทึกสิ่งใด ตารางและการตั้งค่าอยู่บนโทรศัพท์นี้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay seguimiento del sueño y no se usa el micrófono. Mientras hay una sesión de alarma inteligente activa, el sensor de movimiento solo se lee durante la ventana de la alarma; no se guarda nada. Su horario y sus ajustes solo se guardan en este teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há monitoramento do sono e o microfone não é usado. Durante uma sessão de alarme inteligente, o sensor de movimento só é lido na janela do alarme; nada é guardado. Sua rotina e suas configurações ficam só neste celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नींद की ट्रैकिंग नहीं होती और माइक्रोफ़ोन इस्तेमाल नहीं होता। स्मार्ट अलार्म सत्र के दौरान मोशन सेंसर केवल अलार्म की अवधि में पढ़ा जाता है; कुछ सहेजा नहीं जाता। आपकी योजना और सेटिंग्स इसी फ़ोन पर रहती हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ঘুম ট্র্যাকিং নেই এবং মাইক্রোফোন ব্যবহার হয় না। স্মার্ট অ্যালার্ম সেশন চালু থাকলে শুধু অ্যালার্মের সময়সীমায় গতি সেন্সর পড়া হয়; কিছু সংরক্ষণ হয় না। আপনার সূচি ও সেটিংস এই ফোনেই থাকে।"
          }
        }
      }
    },
