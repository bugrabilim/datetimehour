            "value": "節をタップするとしおりを挟めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절을 누르면 책갈피를 꽂습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
