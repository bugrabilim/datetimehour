            "value": "حسابك وملفك الشخصي (مع الصورة) وسجل موافقتك وجلساتك وسجلاتك وشاراتك في ملف JSON."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun, profil (termasuk foto), catatan persetujuan, sesi, catatan, dan lencana Anda dalam berkas JSON."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا اکاؤنٹ، پروفائل (تصویر سمیت)، رضامندی کا ریکارڈ، سیشن، ریکارڈ اور بیج JSON فائل کی صورت میں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب، نمایه (با عکس)، سابقهٔ رضایت، نشست‌ها، ثبت‌ها و نشان‌های شما در یک پروندهٔ JSON."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte, votre profil (photo comprise), la trace de votre consentement, vos sessions, vos données et vos badges dans un fichier JSON."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш аккаунт, профиль (с фото), запись о согласии, сеансы, записи и значки в файле JSON."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント、プロフィール（写真を含む）、同意の記録、セッション、記録、バッジを JSON ファイルで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정, 프로필(사진 포함), 동의 기록, 세션, 기록, 배지를 JSON 파일로."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的账户、个人资料（含照片）、同意记录、会话、记录和徽章，以 JSON 文件提供。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang inyong account, profile (kasama ang larawan), record ng pahintulot, mga session, record at badge bilang JSON file."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี โปรไฟล์ (รวมรูป) บันทึกความยินยอม เซสชัน บันทึก และเหรียญตราของคุณในไฟล์ JSON"
