    "nature.eclipsePrayer": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş tutulmasında küsûf, Ay tutulmasında husûf namazı kılınır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The eclipse prayer is offered during eclipses: salat al-kusuf for a solar eclipse, salat al-khusuf for a lunar eclipse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Finsternissen wird das Finsternisgebet verrichtet: Salat al-Kusuf bei einer Sonnen-, Salat al-Chusuf bei einer Mondfinsternis."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Günəş tutulmasında küsuf, Ay tutulmasında xusuf namazı qılınır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُصلّى صلاة الكسوف عند كسوف الشمس، وصلاة الخسوف عند خسوف القمر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat gerhana matahari dilaksanakan salat kusuf, dan saat gerhana bulan salat khusuf."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سورج گرہن میں نمازِ کسوف اور چاند گرہن میں نمازِ خسوف پڑھی جاتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام خورشیدگرفتگی و ماه‌گرفتگی نماز آیات (کسوف و خسوف) خوانده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant les éclipses, on accomplit la prière de l’éclipse : salat al-kusuf pour le Soleil, salat al-khusuf pour la Lune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время затмений совершают молитву затмения: салят аль-кусуф при солнечном, салят аль-хусуф при лунном затмении."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日食・月食の際には食の礼拝を行います（日食はサラート・アル＝クスーフ、月食はサラート・アル＝フスーフ）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일식과 월식 때에는 식 예배를 드립니다. 일식에는 살라트 알쿠수프, 월식에는 살라트 알후수프입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日食、月食时礼日食拜（Kusuf）和月食拜（Khusuf）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa panahon ng eklipse, isinasagawa ang salat al-kusuf (eklipse ng Araw) at salat al-khusuf (eklipse ng Buwan)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเกิดสุริยุปราคาและจันทรุปราคาจะมีการละหมาดกุซูฟและละหมาดคุซูฟ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante los eclipses se realiza la oración del eclipse: salat al-kusuf en el de Sol y salat al-jusuf en el de Luna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante os eclipses faz-se a oração do eclipse: salat al-kusuf no eclipse do Sol e salat al-khusuf no da Lua."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ग्रहण के समय ग्रहण की नमाज़ पढ़ी जाती है: सूर्य ग्रहण में नमाज़-ए-कुसूफ़ और चंद्र ग्रहण में नमाज़-ए-ख़ुसूफ़।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গ্রহণের সময় গ্রহণের নামাজ পড়া হয়: সূর্যগ্রহণে সালাতুল কুসুফ, চন্দ্রগ্রহণে সালাতুল খুসুফ।"
          }
        }
      }
    },
    "qibla.rashdul": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş Kâbe'nin üstünde"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sun over the Kaaba"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne über der Kaaba"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Günəş Kəbənin üstündə"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشمس فوق الكعبة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matahari di atas Ka'bah (Rashdul Kiblat)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سورج خانۂ کعبہ کے اوپر"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خورشید بالای کعبه"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil au-dessus de la Kaaba"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Солнце над Каабой"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カアバの真上の太陽"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카바 바로 위의 태양"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太阳位于克尔白正上方"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Araw sa ibabaw ng Kaaba"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดวงอาทิตย์อยู่เหนือกะอ์บะฮ์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Sol sobre la Kaaba"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sol sobre a Caaba"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काबा के ठीक ऊपर सूरज"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাবার ঠিক ওপরে সূর্য"
          }
        }
      }
    },
    "qibla.rashdulNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yılda iki kez Güneş Kâbe'nin tam üstünden geçer. O anda Güneş'in göründüğü her yerde güneşe dönen kıbleye dönmüş olur; dik duran bir çubuğun gölgesi kıblenin tam tersini gösterir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twice a year the Sun passes directly over the Kaaba. At that moment, wherever the Sun is visible, facing the Sun means facing the qibla; the shadow of an upright stick points exactly away from the qibla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweimal im Jahr steht die Sonne genau über der Kaaba. In diesem Moment blickt überall, wo die Sonne zu sehen ist, wer sich zur Sonne wendet, zur Qibla; der Schatten eines senkrechten Stabes zeigt genau von der Qibla weg."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İldə iki dəfə Günəş Kəbənin düz üstündən keçir. O anda Günəşin göründüyü hər yerdə Günəşə dönən qibləyə dönmüş olur; şaquli dayanan çubuğun kölgəsi qiblənin tam əksini göstərir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرّ الشمس مرتين في السنة فوق الكعبة تمامًا. في تلك اللحظة، في كل مكان تُرى فيه الشمس، من يتّجه إلى الشمس يتّجه إلى القبلة، وظلّ العصا القائمة يشير إلى عكس القبلة تمامًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua kali setahun Matahari tepat berada di atas Ka'bah. Pada saat itu, di mana pun Matahari terlihat, menghadap Matahari berarti menghadap kiblat; bayangan tongkat yang berdiri tegak menunjuk tepat ke arah sebaliknya dari kiblat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سال میں دو بار سورج عین خانۂ کعبہ کے اوپر سے گزرتا ہے۔ اس لمحے جہاں بھی سورج نظر آئے، سورج کی طرف رخ کرنا قبلے کی طرف رخ کرنا ہے؛ سیدھی کھڑی چھڑی کا سایہ قبلے کی بالکل مخالف سمت دکھاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خورشید سالی دو بار درست از بالای کعبه می‌گذرد. در آن لحظه، هر جا خورشید دیده شود، رو به خورشید ایستادن یعنی رو به قبله ایستادن؛ سایهٔ چوبی که راست ایستاده درست خلاف قبله را نشان می‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux fois par an, le Soleil passe exactement au-dessus de la Kaaba. À cet instant, partout où le Soleil est visible, se tourner vers le Soleil revient à se tourner vers la qibla ; l’ombre d’un bâton vertical pointe exactement à l’opposé de la qibla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды в год Солнце проходит точно над Каабой. В этот момент везде, где видно Солнце, повернуться к Солнцу значит повернуться к кибле; тень вертикального шеста указывает прямо от киблы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太陽は年に2回、カアバの真上を通ります。その瞬間、太陽が見える場所ならどこでも、太陽の方を向けばキブラを向いたことになり、垂直に立てた棒の影はキブラのちょうど反対側を指します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태양은 1년에 두 번 카바 바로 위를 지납니다. 그 순간 태양이 보이는 곳 어디서나 태양을 향하면 키블라를 향하게 되며, 똑바로 세운 막대의 그림자는 키블라의 정반대를 가리킵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太阳每年两次正好经过克尔白上空。此时，凡能看到太阳的地方，面向太阳即面向朝向；直立木杆的影子正好指向朝向的反方向。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalawang beses sa isang taon, dumaraan ang Araw nang eksakto sa ibabaw ng Kaaba. Sa sandaling iyon, saanman nakikita ang Araw, ang pagharap sa Araw ay pagharap sa qibla; ang anino ng patayong patpat ay nakaturo nang eksakto palayo sa qibla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปีละสองครั้งดวงอาทิตย์จะผ่านตรงเหนือกะอ์บะฮ์พอดี ในขณะนั้น ทุกที่ที่มองเห็นดวงอาทิตย์ การหันหน้าไปทางดวงอาทิตย์คือการหันไปทางกิบลัต และเงาของไม้ที่ปักตั้งตรงจะชี้ไปทางตรงข้ามกับกิบลัตพอดี"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos veces al año el Sol pasa exactamente sobre la Kaaba. En ese momento, en cualquier lugar donde se vea el Sol, mirar hacia el Sol es mirar hacia la alquibla; la sombra de un palo vertical señala justo en dirección contraria a la alquibla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas vezes por ano o Sol passa exatamente sobre a Caaba. Nesse momento, em qualquer lugar onde o Sol esteja visível, virar-se para o Sol é virar-se para a qibla; a sombra de uma vara vertical aponta exatamente para o lado oposto da qibla."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साल में दो बार सूरज ठीक काबा के ऊपर से गुज़रता है। उस पल जहाँ भी सूरज दिखे, सूरज की ओर मुँह करना क़िबला की ओर मुँह करना है; सीधी खड़ी छड़ी की परछाईं क़िबला की ठीक उलटी दिशा दिखाती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বছরে দুবার সূর্য ঠিক কাবার ওপর দিয়ে যায়। সেই মুহূর্তে যেখানেই সূর্য দেখা যায়, সূর্যের দিকে মুখ করা মানেই কিবলার দিকে মুখ করা; খাড়া করে রাখা লাঠির ছায়া কিবলার ঠিক উল্টো দিক দেখায়।"
          }
        }
      }
    },
    "qibla.rashdulNight": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anda seçili yerde Güneş ufkun altında; kıble saatini kullanabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this moment the Sun is below the horizon at the selected place; you can use the daily qibla time instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Moment steht die Sonne am gewählten Ort unter dem Horizont; nutzen Sie stattdessen die tägliche Qibla-Zeit."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anda seçilmiş yerdə Günəş üfüqün altındadır; gündəlik qiblə saatından istifadə edə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشمس في هذه اللحظة تحت الأفق في المكان المحدد؛ يمكنك استخدام وقت القبلة اليومي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ini Matahari berada di bawah ufuk di lokasi yang dipilih; Anda dapat memakai waktu kiblat harian."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس لمحے منتخب مقام پر سورج افق سے نیچے ہے؛ آپ روزانہ کا قبلے کا وقت استعمال کر سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در این لحظه خورشید در مکان انتخاب‌شده زیر افق است؛ می‌توانید از وقت قبلهٔ روزانه استفاده کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cet instant, le Soleil est sous l’horizon au lieu choisi ; vous pouvez utiliser l’heure de la qibla du jour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас в выбранном месте Солнце под горизонтом; можно воспользоваться ежедневным временем киблы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この瞬間、選択した場所では太陽が地平線の下にあります。毎日のキブラの時刻を使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 선택한 곳에서는 태양이 지평선 아래에 있습니다. 매일의 키블라 시각을 이용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此刻所选地点的太阳在地平线以下；可以使用每天的朝向时刻。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa sandaling ito, nasa ilalim ng abot-tanaw ang Araw sa napiling lugar; maaari mong gamitin ang araw-araw na oras ng qibla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้ดวงอาทิตย์อยู่ใต้ขอบฟ้าที่ตำแหน่งที่เลือก คุณใช้เวลากิบลัตประจำวันแทนได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este momento el Sol está bajo el horizonte en el lugar elegido; puede usar la hora de la alquibla del día."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento o Sol está abaixo do horizonte no local escolhido; você pode usar o horário da qibla do dia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समय चुनी गई जगह पर सूरज क्षितिज के नीचे है; आप रोज़ का क़िबला समय इस्तेमाल कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে নির্বাচিত স্থানে সূর্য দিগন্তের নিচে; আপনি প্রতিদিনের কিবলার সময় ব্যবহার করতে পারেন।"
          }
        }
      }
    },
