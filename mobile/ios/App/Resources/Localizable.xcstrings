          }
        }
      }
    },
    "empty.alarm.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saati, günleri ve sesi seçerek ilk alarmınızı kurun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a time, days and a sound to set your first alarm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Uhrzeit, Tage und Ton für Ihren ersten Wecker."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk zəngli saatınızı qurmaq üçün vaxtı, günləri və səsi seçin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الوقت والأيام والصوت لضبط أول منبّه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih waktu, hari, dan suara untuk alarm pertama Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا پہلا الارم لگانے کے لیے وقت، دن اور آواز منتخب کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تنظیم نخستین زنگ، ساعت، روزها و صدا را انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l'heure, les jours et le son de votre premier réveil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите время, дни и звук для первого будильника."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻・曜日・サウンドを選んで最初のアラームを設定しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간, 요일, 소리를 골라 첫 알람을 설정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择时间、日期和铃声，设置第一个闹钟。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng oras, mga araw at tunog para sa iyong unang alarm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเวลา วัน และเสียงเพื่อตั้งปลุกครั้งแรก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una hora, días y un sonido para poner su primera alarma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um horário, os dias e um som para criar seu primeiro alarme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पहला अलार्म लगाने के लिए समय, दिन और आवाज़ चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথম অ্যালার্ম দিতে একটি সময়, দিন ও শব্দ বাছুন।"
          }
        }
      }
    },
    "empty.countdown.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz geri sayım yok"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No countdowns yet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Countdowns"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ geri sayım yoxdur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا عدّ تنازلي بعد"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada hitung mundur"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی الٹی گنتی نہیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز شمارش معکوسی نیست"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte à rebours"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет обратных отсчётов"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウントダウンはまだありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 카운트다운이 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有倒计时"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang countdown"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีการนับถอยหลัง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay cuentas atrás"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há contagens regressivas"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई काउंटडाउन नहीं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো কাউন্টডাউন নেই"
          }
        }
      }
    },
    "empty.countdown.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğum günü, tatil, sınav… önemli günleri saymaya başlayın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Birthdays, holidays, exams… start counting down to the days that matter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geburtstage, Urlaub, Prüfungen … zählen Sie die wichtigen Tage herunter."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad günü, tətil, imtahan… vacib günləri saymağa başlayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعياد الميلاد والعطلات والامتحانات… ابدأ العدّ للأيام المهمة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulang tahun, liburan, ujian… mulai hitung mundur ke hari-hari penting."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سالگرہ، چھٹیاں، امتحان… اہم دنوں کی الٹی گنتی شروع کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تولد، تعطیلات، امتحان… شمارش معکوس روزهای مهم را آغاز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anniversaires, vacances, examens… comptez les jours qui comptent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни рождения, отпуск, экзамены… начните отсчёт до важных дней."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誕生日、休暇、試験…大切な日までを数えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생일, 휴가, 시험… 중요한 날까지 세어 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生日、假期、考试……为重要的日子开始倒数。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaarawan, bakasyon, pagsusulit… simulan ang pagbilang sa mahahalagang araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันเกิด วันหยุด วันสอบ… เริ่มนับถอยหลังสู่วันสำคัญ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumpleaños, vacaciones, exámenes… empiece a contar los días que importan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aniversários, férias, provas… comece a contar os dias que importam."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जन्मदिन, छुट्टियाँ, परीक्षाएँ… ज़रूरी दिनों की गिनती शुरू करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জন্মদিন, ছুটি, পরীক্ষা… গুরুত্বপূর্ণ দিনগুলোর কাউন্টডাউন শুরু করুন।"
          }
        }
      }
    },
    "empty.journal.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sabah ruh hâlinizi, uykunuzu ve günün niyetini birkaç dokunuşla yazın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each morning, note your mood, sleep and intention for the day in a few taps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notieren Sie jeden Morgen mit wenigen Fingertipps Stimmung, Schlaf und Tagesvorsatz."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər səhər əhvalınızı, yuxunuzu və günün niyyətini bir neçə toxunuşla yazın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل كل صباح مزاجك ونومك ونية يومك ببضع لمسات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pagi, catat suasana hati, tidur, dan niat hari ini dengan beberapa ketukan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر صبح چند ٹیپ میں اپنا موڈ، نیند اور دن کی نیت لکھیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر صبح با چند لمس حال، خواب و نیت روزتان را بنویسید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque matin, notez votre humeur, votre sommeil et votre intention du jour en quelques touches."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое утро отмечайте настроение, сон и намерение на день в пару касаний."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎朝、気分・睡眠・今日の目標を数タップで記録しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 아침 기분, 수면, 오늘의 다짐을 몇 번의 탭으로 기록하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天早上，轻点几下记录心情、睡眠和当天的目标。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuwing umaga, itala ang iyong mood, tulog at layunin sa araw sa ilang tap."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกเช้า บันทึกอารมณ์ การนอน และความตั้งใจของวันด้วยการแตะไม่กี่ครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mañana, anote su estado de ánimo, su sueño y su intención del día con unos toques."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda manhã, anote seu humor, seu sono e sua intenção do dia com alguns toques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सुबह कुछ टैप में अपना मूड, नींद और दिन का इरादा लिखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিদিন সকালে কয়েকটি চাপে আপনার মেজাজ, ঘুম ও দিনের সংকল্প লিখে রাখুন।"
          }
        }
      }
    },
