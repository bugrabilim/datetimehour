    "sleep.mixNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sesin düzeyini ayrı ayarlayın; 0 kapalıdır. Sesler telefonda üretilir, dosya ya da internet gerekmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set each sound's level separately; 0 is off. Sounds are generated on the phone, with no files or internet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie jeden Klang einzeln ein; 0 ist aus. Die Klänge entstehen auf dem Telefon, ohne Dateien oder Internet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər səsin səviyyəsini ayrıca tənzimləyin; 0 səsi bağlayır. Səslər telefonda yaradılır, fayl və ya internet lazım deyil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط مستوى كل صوت على حدة؛ 0 يعني إيقافه. تُولَّد الأصوات على الهاتف دون ملفات أو إنترنت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur tingkat tiap suara terpisah; 0 berarti mati. Suara dibuat di ponsel, tanpa file atau internet."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر آواز کی سطح الگ مقرر کریں؛ 0 بند ہے۔ آوازیں فون پر بنتی ہیں، فائل یا انٹرنیٹ کی ضرورت نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سطح هر صدا را جداگانه تنظیم کنید؛ 0 یعنی خاموش. صداها روی گوشی ساخته می‌شوند و فایل یا اینترنت لازم نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez le niveau de chaque son séparément ; 0 = coupé. Les sons sont générés sur le téléphone, sans fichiers ni Internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте громкость каждого звука отдельно; 0 — выключено. Звуки создаются на телефоне, без файлов и интернета."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音ごとに音量を設定します（0はオフ）。音は端末内で生成され、ファイルもインターネットも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리마다 크기를 따로 정하세요. 0은 꺼짐입니다. 소리는 휴대폰에서 만들어지며 파일이나 인터넷이 필요 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分别设置每种声音的音量，0 表示关闭。声音在手机上生成，无需文件或网络。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itakda nang hiwalay ang lakas ng bawat tunog; 0 ay patay. Ginagawa ang mga tunog sa telepono, walang file o internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งระดับเสียงแต่ละเสียงแยกกัน 0 คือปิด เสียงสร้างบนโทรศัพท์ ไม่ต้องใช้ไฟล์หรืออินเทอร์เน็ต"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste el nivel de cada sonido por separado; con 0 se apaga. Los sonidos se generan en el teléfono, sin archivos ni internet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o nível de cada som separadamente; 0 é desligado. Os sons são gerados no celular, sem arquivos nem internet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर आवाज़ का स्तर अलग से तय करें; 0 यानी बंद। आवाज़ें फ़ोन पर बनती हैं, बिना फ़ाइल या इंटरनेट के।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি শব্দের মাত্রা আলাদা করে ঠিক করুন; 0 মানে বন্ধ। শব্দগুলো ফোনেই তৈরি হয়, কোনো ফাইল বা ইন্টারনেট লাগে না।"
          }
        }
      }
    },
