    "widget.overlap.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şehirlerin 09.00–18.00 mesai saatlerinin örtüştüğü saatler, 24 saatlik şeritlerde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the cities' 9 am–6 pm working hours overlap, on 24-hour strips."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann sich die Arbeitszeiten der Städte (9–18 Uhr) überschneiden, auf 24-Stunden-Streifen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şəhərlərin 09:00–18:00 iş saatlarının üst-üstə düşdüyü saatlar, 24 saatlıq zolaqlarda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعات التي تتداخل فيها ساعات العمل 9–18 في المدن، على أشرطة 24 ساعة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapan jam kerja 09.00–18.00 kota-kota bertemu, pada pita 24 jam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب شہروں کے 9 تا 18 بجے کے دفتری اوقات ملتے ہیں، 24 گھنٹے کی پٹیوں پر۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت‌هایی که ساعت کاری 9 تا 18 شهرها هم‌پوشانی دارد، روی نوارهای 24 ساعته."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand les heures de bureau 9 h–18 h des villes se chevauchent, sur des bandes de 24 h."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда рабочие часы 9–18 в городах совпадают, на 24-часовых полосах."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各都市の9時〜18時の勤務時間が重なる時間を24時間の帯で表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도시별 9시~18시 근무 시간이 겹치는 시간을 24시간 띠로 표시."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各城市 9:00–18:00 工作时间重叠的时段，以 24 小时条显示。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailan nagtatagpo ang oras ng trabaho (9–18) ng mga lungsod, sa mga 24-oras na guhit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงที่เวลาทำงาน 9:00–18:00 ของแต่ละเมืองตรงกัน แสดงเป็นแถบ 24 ชั่วโมง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo coinciden las jornadas de 9 a 18 h de las ciudades, en franjas de 24 horas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas em que o expediente das cidades (9h–18h) se sobrepõe, em faixas de 24 horas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शहरों के सुबह 9 से शाम 6 बजे तक के कामकाजी घंटे कब मिलते हैं, 24 घंटे की पट्टियों पर।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শহরগুলোর সকাল 9টা–সন্ধ্যা 6টার কর্মঘণ্টা কখন মেলে, 24 ঘণ্টার ফিতায়।"
          }
        }
      }
    },
