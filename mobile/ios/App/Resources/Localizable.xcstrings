    "widget.countdown.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri sayımlarınızın en yakını; yoksa yılbaşı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your nearest countdown; New Year if you have none."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr nächster Countdown; sonst Neujahr."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ən yaxın geri sayımınız; yoxdursa, Yeni il."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقرب عدّ تنازلي لديك؛ وإن لم يوجد فرأس السنة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung mundur terdekat Anda; Tahun Baru jika belum ada."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی قریب ترین الٹی گنتی؛ کوئی نہ ہو تو نیا سال۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نزدیک‌ترین شمارش معکوس شما؛ اگر نباشد سال نو."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte à rebours le plus proche ; le Nouvel An si vous n’en avez pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ближайший обратный отсчёт; если их нет — Новый год."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん近いカウントダウン。なければ新年。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 가까운 카운트다운. 없으면 새해."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的倒计时；没有则显示新年。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pinakamalapit mong countdown; Bagong Taon kung wala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนับถอยหลังที่ใกล้ที่สุด ถ้าไม่มีจะแสดงปีใหม่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cuenta atrás más cercana; Año Nuevo si no tiene ninguna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua contagem regressiva mais próxima; Ano-Novo se não houver nenhuma."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सबसे नज़दीकी काउंटडाउन; कोई न हो तो नव वर्ष।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সবচেয়ে কাছের কাউন্টডাউন; না থাকলে নববর্ষ।"
          }
        }
      }
    },
    "widget.countdown.descIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget ayarından başlık ve tarih seçin; varsayılan yılbaşı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a title and date in the widget settings; New Year by default."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Titel und Datum in den Widget-Einstellungen; standardmäßig Neujahr."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidcet ayarlarından başlıq və tarix seçin; susmaya görə Yeni il."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر عنوانًا وتاريخًا من إعدادات الأداة؛ الافتراضي رأس السنة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih judul dan tanggal di pengaturan widget; bawaannya Tahun Baru."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ویجیٹ کی ترتیبات میں عنوان اور تاریخ منتخب کریں؛ بطورِ طے شدہ نیا سال۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تنظیمات ابزارک عنوان و تاریخ را برگزینید؛ پیش‌فرض سال نو است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un titre et une date dans les réglages du widget ; le Nouvel An par défaut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите название и дату в настройках виджета; по умолчанию — Новый год."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットの設定でタイトルと日付を選びます。初期設定は新年。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯 설정에서 제목과 날짜를 고르세요. 기본은 새해입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在小组件设置中选择标题和日期；默认为新年。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng pamagat at petsa sa setting ng widget; Bagong Taon bilang default."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกชื่อและวันที่ในการตั้งค่าวิดเจ็ต ค่าเริ่มต้นคือปีใหม่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un título y una fecha en los ajustes del widget; Año Nuevo por defecto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um título e uma data nas configurações do widget; Ano-Novo por padrão."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विजेट सेटिंग में शीर्षक और तारीख चुनें; डिफ़ॉल्ट नव वर्ष।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উইজেট সেটিংসে একটি শিরোনাম ও তারিখ বেছে নিন; শুরুতে নববর্ষ।"
          }
        }
      }
    },
