    "world.dialHint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saati kaydırmak için kadranı parmağınızla döndürün; üst yarı gündüz, alt yarı gece."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the dial with your finger to shift the time; the top half is day, the bottom half night."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehen Sie das Zifferblatt mit dem Finger, um die Zeit zu verschieben; oben ist Tag, unten Nacht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatı dəyişmək üçün siferblatı barmağınızla fırladın; yuxarı yarı gündüz, aşağı yarı gecədir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدِر القرص بإصبعك لتغيير الوقت؛ النصف العلوي نهار والسفلي ليل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putar dial dengan jari untuk menggeser waktu; separuh atas siang, separuh bawah malam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت بدلنے کے لیے ڈائل کو انگلی سے گھمائیں؛ اوپر کا آدھا دن اور نیچے کا آدھا رات ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای جابه‌جا کردن زمان، صفحه را با انگشت بچرخانید؛ نیمهٔ بالا روز و نیمهٔ پایین شب است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites tourner le cadran du doigt pour décaler l'heure ; la moitié haute est le jour, la moitié basse la nuit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поворачивайте циферблат пальцем, чтобы сдвинуть время; верхняя половина — день, нижняя — ночь."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字盤を指で回すと時刻をずらせます。上半分が昼、下半分が夜です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다이얼을 손가락으로 돌려 시간을 옮기세요. 위쪽 절반은 낮, 아래쪽 절반은 밤입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手指转动表盘即可调整时间；上半部分是白天，下半部分是夜晚。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iikot ang dial gamit ang daliri para ilipat ang oras; araw ang itaas na kalahati, gabi ang ibaba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมุนหน้าปัดด้วยนิ้วเพื่อเลื่อนเวลา ครึ่งบนคือกลางวัน ครึ่งล่างคือกลางคืน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire la esfera con el dedo para cambiar la hora; la mitad de arriba es de día y la de abajo de noche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire o mostrador com o dedo para mudar a hora; a metade de cima é dia e a de baixo é noite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय खिसकाने के लिए डायल को उँगली से घुमाएँ; ऊपर का आधा दिन है, नीचे का आधा रात।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময় সরাতে আঙুল দিয়ে ডায়াল ঘোরান; ওপরের অর্ধেক দিন, নিচের অর্ধেক রাত।"
          }
        }
      }
    },
    "world.wxNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şehirlerin havası saatte bir güncellenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "City weather is updated hourly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wetter der Städte wird stündlich aktualisiert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şəhərlərin havası saatda bir yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحدَّث طقس المدن كل ساعة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuaca kota diperbarui setiap jam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شہروں کا موسم ہر گھنٹے تازہ ہوتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هوای شهرها هر ساعت به‌روز می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La météo des villes est mise à jour toutes les heures."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Погода в городах обновляется раз в час."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市の天気は1時間ごとに更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도시 날씨는 1시간마다 갱신됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "城市天气每小时更新一次。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ina-update bawat oras ang panahon sa mga lungsod."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สภาพอากาศของเมืองอัปเดตทุกชั่วโมง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de las ciudades se actualiza cada hora."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O clima das cidades é atualizado a cada hora."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शहरों का मौसम हर घंटे अपडेट होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শহরের আবহাওয়া প্রতি ঘণ্টায় হালনাগাদ হয়।"
          }
        }
      }
    },
