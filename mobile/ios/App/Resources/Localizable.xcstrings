    "alarm.task.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm, görev yapılmadan kapatılamaz (ertelemek serbest). Sensör ya da kamera çalışmazsa \"Başka görev\" ile zor matematiğe geçilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm can't be turned off until the task is done (snoozing is still allowed). If the sensor or camera doesn't work, \"Another task\" switches to hard maths."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wecker lässt sich erst nach der Aufgabe ausschalten (Schlummern bleibt möglich). Funktionieren Sensor oder Kamera nicht, wechselt „Andere Aufgabe“ zu schwerem Rechnen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapşırıq yerinə yetirilmədən zəng söndürülmür (təxirə salmaq olar). Sensor ya da kamera işləməsə, \"Başqa tapşırıq\" ilə çətin riyaziyyata keçilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إيقاف المنبّه قبل إنجاز المهمة (تبقى الغفوة متاحة). إذا لم يعمل المستشعر أو الكاميرا فإن «مهمة أخرى» تنتقل إلى مسائل حسابية صعبة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm tidak dapat dimatikan sebelum tugas selesai (menunda tetap boleh). Jika sensor atau kamera tidak berfungsi, \"Tugas lain\" beralih ke matematika sulit."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام مکمل ہونے تک الارم بند نہیں ہوتا (اسنوز کی اجازت ہے)۔ اگر سینسر یا کیمرا کام نہ کرے تو «کوئی اور کام» مشکل ریاضی پر چلا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا کار انجام نشود هشدار خاموش نمی‌شود (چرت مجاز است). اگر حسگر یا دوربین کار نکند، «کار دیگر» به ریاضی سخت می‌رود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alarme ne peut pas être arrêtée tant que la tâche n’est pas faite (la répétition reste possible). Si le capteur ou l’appareil photo ne fonctionne pas, « Autre tâche » passe au calcul difficile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильник нельзя выключить, пока задание не выполнено (отложить можно). Если датчик или камера не работают, «Другое задание» переключит на трудную математику."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "課題を終えるまでアラームは止められません（スヌーズはできます）。センサーやカメラが使えないときは「別の課題」で難しい計算に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미션을 마칠 때까지 알람을 끌 수 없습니다(다시 알림은 됩니다). 센서나 카메라가 작동하지 않으면 \"다른 미션\"을 눌러 어려운 수학으로 바꿀 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成任务前无法关闭闹钟（仍可稍后提醒）。如果传感器或相机不能用，“换个任务”会切换到困难算术。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mapapatay ang alarma hangga't hindi tapos ang gawain (puwede pa rin ang snooze). Kung hindi gumagana ang sensor o camera, lilipat sa mahirap na math ang \"Ibang gawain\"."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดนาฬิกาปลุกไม่ได้จนกว่าจะทำภารกิจเสร็จ (ยังเลื่อนปลุกได้) หากเซนเซอร์หรือกล้องใช้ไม่ได้ \"ภารกิจอื่น\" จะเปลี่ยนเป็นคณิตศาสตร์ระดับยาก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La alarma no se puede apagar hasta hacer la tarea (aplazar sigue permitido). Si el sensor o la cámara no funcionan, \"Otra tarea\" cambia a matemáticas difíciles."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O alarme não pode ser desligado até a tarefa ser feita (a soneca continua permitida). Se o sensor ou a câmera não funcionarem, \"Outra tarefa\" muda para matemática difícil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य पूरा होने तक अलार्म बंद नहीं होता (स्नूज़ फिर भी कर सकते हैं)। सेंसर या कैमरा काम न करे, तो \"दूसरा कार्य\" कठिन गणित पर चला जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাজটি না করা পর্যন্ত অ্যালার্ম বন্ধ করা যায় না (স্নুজ করা যায়)। সেন্সর বা ক্যামেরা কাজ না করলে \"অন্য কাজ\" কঠিন গণিতে চলে যায়।"
          }
        }
      }
    },
    "alarm.task.noteIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmdaki Durdur'a basınca uygulama açılır ve görev istenir; görev yapılmazsa alarm 1 dakika sonra yeniden çalar (en çok 10 kez). Sensör ya da kamera çalışmazsa \"Başka görev\" zor matematiğe geçer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping Stop on the alarm opens the app and asks for the task; if it isn't done, the alarm rings again a minute later (up to 10 times). If the sensor or camera doesn't work, \"Another task\" switches to hard maths."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tippen auf „Stopp“ öffnet die App und verlangt die Aufgabe; wird sie nicht erledigt, klingelt der Wecker eine Minute später erneut (höchstens 10-mal). Funktionieren Sensor oder Kamera nicht, wechselt „Andere Aufgabe“ zu schwerem Rechnen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəngdə \"Dayandır\" düyməsinə basanda tətbiq açılır və tapşırıq istənir; yerinə yetirilməsə, zəng 1 dəqiqə sonra yenidən çalır (ən çox 10 dəfə). Sensor ya da kamera işləməsə, \"Başqa tapşırıq\" çətin riyaziyyata keçir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الضغط على إيقاف في المنبّه التطبيقَ ويطلب المهمة؛ وإن لم تُنجز يرنّ المنبّه مجددًا بعد دقيقة (حتى 10 مرات). إذا لم يعمل المستشعر أو الكاميرا فإن \"مهمة أخرى\" تنتقل إلى مسائل حسابية صعبة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengetuk Berhenti pada alarm akan membuka aplikasi dan meminta Anda menyelesaikan tugas; jika belum selesai, alarm berbunyi lagi semenit kemudian (hingga 10 kali). Jika sensor atau kamera tidak berfungsi, \"Tugas lain\" beralih ke matematika sulit."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم پر روکیں دبانے سے ایپ کھلتی ہے اور کام مانگتی ہے؛ کام نہ ہو تو الارم ایک منٹ بعد پھر بجتا ہے (10 بار تک)۔ اگر سینسر یا کیمرا کام نہ کرے تو «کوئی اور کام» مشکل ریاضی پر چلا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زدن «توقف» روی هشدار برنامه را باز می‌کند و کار را می‌خواهد؛ اگر انجام نشود، هشدار یک دقیقه بعد دوباره زنگ می‌زند (تا 10 بار). اگر حسگر یا دوربین کار نکند، «کار دیگر» به ریاضی سخت می‌رود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher Arrêter sur l’alarme ouvre l’app et demande la tâche ; si elle n’est pas faite, l’alarme sonne de nouveau une minute plus tard (jusqu’à 10 fois). Si le capteur ou l’appareil photo ne fonctionne pas, « Autre tâche » passe au calcul difficile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатие «Стоп» на будильнике открывает приложение, где нужно выполнить задание; если оно не выполнено, будильник снова звонит через минуту (до 10 раз). Если датчик или камера не работают, «Другое задание» переключит на трудную математику."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームの停止をタップするとアプリが開いて課題を求めます。課題を終えないと1分後にまた鳴ります（最大10回）。センサーやカメラが使えないときは「別の課題」で難しい計算に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람에서 정지를 누르면 앱이 열려 미션을 요청합니다. 마치지 않으면 1분 뒤 다시 울립니다(최대 10회). 센서나 카메라가 작동하지 않으면 \"다른 미션\"을 눌러 어려운 수학으로 바꿀 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在闹钟上轻点“停止”会打开应用并要求完成任务；未完成的话，一分钟后闹钟再响（最多10次）。如果传感器或相机不能用，“换个任务”会切换到困难算术。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag in-tap mo ang Stop sa alarma, bubukas ang app at ipagagawa sa iyo ang gawain; kung hindi natapos, tutunog muli ang alarma pagkalipas ng isang minuto (hanggang 10 beses). Kung hindi gumagana ang sensor o camera, lilipat sa mahirap na math ang \"Ibang gawain\"."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อแตะหยุดที่นาฬิกาปลุก แอปจะเปิดขึ้นและขอให้ทำภารกิจ หากไม่ทำ นาฬิกาปลุกจะดังอีกครั้งในหนึ่งนาที (สูงสุด 10 ครั้ง) หากเซนเซอร์หรือกล้องใช้ไม่ได้ \"ภารกิจอื่น\" จะเปลี่ยนเป็นคณิตศาสตร์ระดับยาก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al tocar Detener en la alarma se abre la app y pide la tarea; si no se hace, la alarma vuelve a sonar un minuto después (hasta 10 veces). Si el sensor o la cámara no funcionan, \"Otra tarea\" cambia a matemáticas difíciles."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar em Parar no alarme abre o app e pede a tarefa; se ela não for feita, o alarme toca de novo um minuto depois (até 10 vezes). Se o sensor ou a câmera não funcionarem, \"Outra tarefa\" muda para matemática difícil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म पर \"बंद करें\" दबाने से ऐप खुलता है और कार्य माँगता है; कार्य न हो तो एक मिनट बाद अलार्म फिर बजता है (10 बार तक)। सेंसर या कैमरा काम न करे, तो \"दूसरा कार्य\" कठिन गणित पर चला जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্মে থামান চাপলে অ্যাপ খোলে এবং কাজটি চায়; না করলে এক মিনিট পর অ্যালার্ম আবার বাজে (10 বার পর্যন্ত)। সেন্সর বা ক্যামেরা কাজ না করলে \"অন্য কাজ\" কঠিন গণিতে চলে যায়।"
          }
        }
      }
    },
    "alarm.task.oldIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatma görevi iOS 26 ve sonrasında çalışır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss tasks work on iOS 26 and later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben zum Ausschalten funktionieren ab iOS 26."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Söndürmə tapşırığı iOS 26 və sonrakı versiyalarda işləyir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل مهام الإيقاف على iOS 26 وما بعده."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas mematikan alarm berfungsi di iOS 26 dan yang lebih baru."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بند کرنے کے کام iOS 26 اور بعد کے ورژن پر دستیاب ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای خاموش کردن در iOS 26 و بعد از آن کار می‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches d’arrêt fonctionnent sous iOS 26 ou version ultérieure."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задания для отключения работают в iOS 26 и новее."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止の課題はiOS 26以降で使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄기 미션은 iOS 26 이상에서 작동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闹钟任务需要iOS 26或更高版本。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagana ang gawaing pampatay ng alarma sa iOS 26 at mas bago."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภารกิจปิดนาฬิกาปลุกใช้ได้บน iOS 26 ขึ้นไป"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas para apagar funcionan en iOS 26 y posteriores."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas para desligar funcionam no iOS 26 e posterior."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद करने के कार्य iOS 26 और बाद के संस्करणों में काम करते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ করার কাজ iOS 26 ও তার পরের সংস্করণে কাজ করে।"
          }
        }
      }
    },
