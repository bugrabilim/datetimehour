    "cals.bahai.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahai kutsal günleri ve Bedi takvimi tarihi: Nevruz, Rıdvan, İkiz Doğum Günleri ve oruç."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahá’í Holy Days and the Badí‘ date: Naw-Rúz, Riḍván, the Twin Holy Birthdays and the Fast."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahá’í-Feiertage und das Badí‘-Datum: Naw-Rúz, Riḍván, die Zwillingsgeburtstage und die Fastenzeit."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəhai müqəddəs günləri və Bədi təqvimi tarixi: Novruz, Rizvan, Əkiz Doğum Günləri və oruc."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأيام المقدسة البهائية والتاريخ البديع: عيد النيروز وعيد الرضوان والمولدان المباركان والصيام."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari-hari suci Bahá’í dan tanggal Badí‘: Naw-Rúz, Riḍván, Hari Kelahiran Kembar, dan Puasa."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بہائی مقدس ایام اور بدیع تاریخ: نوروز، رضوان، دو مقدس ولادتیں اور روزہ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایام متبرکهٔ بهائی و تاریخ بدیع: نوروز، رضوان، عید مولودین و روزه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours saints bahá’ís et date badí‘ : Naw-Rúz, Riḍván, les Naissances jumelles et le Jeûne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Святые дни бахаи и дата по календарю Бади: Навруз, Ризван, дни рождения Баба и Бахауллы и Пост."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バハイの聖日とバディー暦の日付：ナウルーズ、リズワン祭、二つの聖誕日、断食など。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바하이 성일과 바디력 날짜: 나우루즈, 리즈반, 두 성탄일, 금식 등을 보여 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "巴哈伊圣日和巴迪历日期：诺鲁孜、里兹万节、巴布诞辰与巴哈欧拉诞辰以及斋戒。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga Banal na Araw ng Bahá’í at petsang Badí‘: Naw-Rúz, Riḍván, ang Kambal na Banal na Kaarawan, at ang Pag-aayuno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันศักดิ์สิทธิ์ของบาไฮและวันที่ตามปฏิทินบะดีอ์ ได้แก่ นาวรูซ ริดวาน วันประสูติคู่ และการถือศีลอด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días sagrados bahá’ís y la fecha badí‘: Naw-Rúz, Riḍván, los Nacimientos Gemelos y el Ayuno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias sagrados bahá’ís e a data badí‘: Naw-Rúz, Riḍván, os Nascimentos Gêmeos e o Jejum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहाई पवित्र दिवस और बदी तारीख़: नौरोज़, रिज़वान, युगल पावन जन्मदिवस और उपवास।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাহাই পবিত্র দিন ও বদি তারিখ: নওরোজ, রিদওয়ান, যুগল পবিত্র জন্মদিন ও রোজা।"
          }
        }
      }
    },
    "cals.bahai.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahai günü önceki akşam gün batımında başlar; günler burada gündüzlerinin tarihiyle gösterilir. Nevruz (ilkbahar ekinoksunun Tahran'a göre düştüğü gün) ve İkiz Doğum Günleri (Nevruz'dan sonraki sekizinci yeni ayı izleyen iki gün) Tahran'a göre hesaplanır ve Bahai Dünya Merkezi'nin tablosuyla karşılaştırılmıştır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bahá’í day begins at sunset the evening before; days are shown here on the date of their daytime. Naw-Rúz (the day of the March equinox in Tehran) and the Twin Holy Birthdays (the two days after the eighth new moon following Naw-Rúz) are calculated for Tehran and checked against the Bahá’í World Centre’s table."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bahá’í-Tag beginnt am Vorabend bei Sonnenuntergang; die Tage stehen hier unter dem Datum ihres Tageslichts. Naw-Rúz (der Tag der Frühlings-Tagundnachtgleiche in Teheran) und die Zwillingsgeburtstage (die zwei Tage nach dem achten Neumond nach Naw-Rúz) werden für Teheran berechnet und wurden mit der Tabelle des Bahá’í-Weltzentrums abgeglichen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəhai günü əvvəlki axşam gün batanda başlayır; günlər burada gündüzlərinin tarixi ilə göstərilir. Novruz (yaz gecə-gündüz bərabərliyinin Tehrana görə düşdüyü gün) və Əkiz Doğum Günləri (Novruzdan sonrakı səkkizinci yeni aydan sonrakı iki gün) Tehrana görə hesablanır və Bəhai Dünya Mərkəzinin cədvəli ilə müqayisə edilib."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ اليوم البهائي عند غروب الشمس في المساء السابق، وتظهر الأيام هنا بتاريخ نهارها. يُحسب عيد النيروز (يوم الاعتدال الربيعي في طهران) والمولدان المباركان (اليومان التاليان للقمر الجديد الثامن بعد النيروز) حسب طهران، وقد قورنت بجدول المركز البهائي العالمي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari Bahá’í dimulai saat matahari terbenam pada malam sebelumnya; hari-hari di sini ditampilkan dengan tanggal siangnya. Naw-Rúz (hari ekuinoks Maret di Teheran) dan Hari Kelahiran Kembar (dua hari setelah bulan baru kedelapan sesudah Naw-Rúz) dihitung untuk Teheran dan telah dicocokkan dengan tabel Pusat Dunia Bahá’í."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بہائی دن پچھلی شام غروبِ آفتاب سے شروع ہوتا ہے؛ یہاں ہر دن اپنے دن کے اجالے کی تاریخ سے دکھایا گیا ہے۔ نوروز (تہران میں مارچ کے اعتدال کا دن) اور دو مقدس ولادتیں (نوروز کے بعد آٹھویں نئے چاند کے بعد کے دو دن) تہران کے مطابق حساب کی جاتی ہیں اور بہائی عالمی مرکز کی جدول سے ملائی گئی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روز بهائی از غروب آفتاب شب پیش آغاز می‌شود و روزها اینجا با تاریخ روزِ روشنشان نشان داده می‌شوند. نوروز (روز اعتدال بهاری در تهران) و عید مولودین (دو روزِ پس از هشتمین ماه نو بعد از نوروز) به افق تهران محاسبه و با جدول مرکز جهانی بهائی مقایسه شده‌اند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jour bahá’í commence au coucher du soleil la veille ; les jours sont indiqués ici à la date de leur journée. Naw-Rúz (le jour de l’équinoxe de mars à Téhéran) et les Naissances jumelles (les deux jours qui suivent la huitième nouvelle lune après Naw-Rúz) sont calculés pour Téhéran et vérifiés avec le tableau du Centre mondial bahá’í."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День бахаи начинается на закате накануне; здесь дни показаны по дате их светлого времени. Навруз (день мартовского равноденствия в Тегеране) и дни рождения Баба и Бахауллы (два дня после восьмого новолуния после Навруза) рассчитываются для Тегерана и сверены с таблицей Всемирного центра бахаи."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バハイ暦の1日は前日の日没に始まり、ここでは各日を日中の日付で表示します。ナウルーズ（テヘランで春分を迎える日）と二つの聖誕日（ナウルーズ後8回目の新月の翌日から2日間）はテヘラン基準で計算し、バハイ世界センターの表と照合しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바하이력의 하루는 전날 해 질 녘에 시작하며, 여기서는 각 날을 낮의 날짜로 표시합니다. 나우루즈(테헤란에서 춘분이 드는 날)와 두 성탄일(나우루즈 이후 여덟 번째 신월 다음 이틀)은 테헤란 기준으로 계산했으며 바하이 세계 센터의 표와 대조했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "巴哈伊历的一天从前一天日落开始，此处各日按其白天的日期显示。诺鲁孜（德黑兰春分所在之日）以及巴布诞辰与巴哈欧拉诞辰（诺鲁孜后第八个新月之后的两天）按德黑兰计算，并已与巴哈伊世界中心的表格核对。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagsisimula ang araw ng Bahá’í sa paglubog ng araw sa gabi bago nito; ipinapakita rito ang bawat araw sa petsa ng liwanag nito. Kinuwenta para sa Tehran ang Naw-Rúz (ang araw ng equinox ng Marso sa Tehran) at ang Kambal na Banal na Kaarawan (ang dalawang araw pagkatapos ng ikawalong bagong buwan mula Naw-Rúz), at itinugma ang mga ito sa talaan ng Bahá’í World Centre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันของบาไฮเริ่มเมื่อดวงอาทิตย์ตกในเย็นวันก่อน และในที่นี้แสดงแต่ละวันตามวันที่ของช่วงกลางวัน นาวรูซ (วันวิษุวัตเดือนมีนาคมที่เตหะราน) และวันประสูติคู่ (สองวันหลังจันทร์ดับครั้งที่ 8 นับจากนาวรูซ) คำนวณตามเตหะรานและได้เทียบกับตารางของศูนย์บาไฮโลกแล้ว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día bahá’í comienza al atardecer de la víspera; aquí cada día se muestra con la fecha de su parte diurna. Naw-Rúz (el día del equinoccio de marzo en Teherán) y los Nacimientos Gemelos (los dos días que siguen a la octava luna nueva después de Naw-Rúz) se calculan para Teherán y se han cotejado con la tabla del Centro Mundial Bahá’í."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia bahá’í começa ao pôr do sol da véspera; aqui cada dia aparece com a data de sua parte diurna. Naw-Rúz (o dia do equinócio de março em Teerã) e os Nascimentos Gêmeos (os dois dias após a oitava lua nova depois de Naw-Rúz) são calculados para Teerã e foram conferidos com a tabela do Centro Mundial Bahá’í."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहाई दिन पिछली शाम सूर्यास्त से शुरू होता है; यहाँ हर दिन उसके उजाले वाले हिस्से की तारीख़ से दिखाया गया है। नौरोज़ (तेहरान में मार्च विषुव का दिन) और युगल पावन जन्मदिवस (नौरोज़ के बाद आठवीं अमावस्या के अगले दो दिन) तेहरान के अनुसार गिने जाते हैं और बहाई विश्व केंद्र की तालिका से मिलाए गए हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাহাই দিন আগের সন্ধ্যার সূর্যাস্তে শুরু হয়; এখানে দিনগুলো তাদের দিনের বেলার তারিখে দেখানো হয়েছে। নওরোজ (তেহরানে মার্চ বিষুবের দিন) ও যুগল পবিত্র জন্মদিন (নওরোজের পরের অষ্টম অমাবস্যার পরের দুই দিন) তেহরানের জন্য হিসাব করা এবং বাহাই বিশ্ব কেন্দ্রের সারণির সঙ্গে মিলিয়ে দেখা।"
          }
        }
      }
    },
    "cals.bahai.ev.nawRuz": {
