            "state": "translated",
            "value": "ข้ามการปลุกครั้งนี้"
          }
        }
      }
    },
    "alarm.preNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessiz bildirim; dokunup alarmı atlayabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A silent notification; you can skip the alarm from it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine stille Mitteilung; Sie können den Wecker darüber überspringen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səssiz bildiriş; oradan zəngli saatı keçə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار صامت يمكنك منه تخطي المنبه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi senyap; Anda bisa melewati alarm darinya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خاموش اطلاع؛ اس سے آپ الارم چھوڑ سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلانی بی‌صدا؛ از آن می‌توانید هشدار را رد کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification silencieuse ; vous pouvez sauter l’alarme depuis celle-ci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Беззвучное уведомление; из него можно пропустить будильник."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音の出ない通知です。そこからアラームをスキップできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리 없는 알림이며, 여기서 알람을 건너뛸 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静音通知；可从通知中跳过闹钟。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahimik na abiso; maaari mong laktawan ang alarma mula rito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนแบบเงียบ ข้ามการปลุกได้จากที่นั่น"
          }
        }
      }
    },
    "alarm.speak": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saati sesli söylesin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak the time"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhrzeit ansagen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtı səsli desin"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نطق الوقت"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucapkan waktu"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت بولیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گفتن ساعت"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annoncer l’heure"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Называть время"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻を読み上げる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 말하기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报时"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabihin ang oras"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกเวลา"
          }
        }
      }
    },
    "alarm.speakNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm çalarken saat telefonun konuşma motoruyla söylenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While ringing, the time is spoken with the phone's speech engine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Klingeln wird die Uhrzeit mit der Sprachausgabe des Telefons angesagt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəngli saat çalarkən vaxt telefonun nitq mühərriki ilə deyilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء الرنين يُنطق الوقت بمحرك الكلام في الهاتف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat berbunyi, waktu diucapkan dengan mesin suara ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بجتے وقت فون کے آواز انجن سے وقت بولا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام زنگ، ساعت با موتور گفتار گوشی گفته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant la sonnerie, l’heure est annoncée avec la synthèse vocale du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время звонка время называется синтезатором речи телефона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鳴っている間、スマホの読み上げエンジンで時刻を伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "울리는 동안 휴대폰 음성 엔진이 시간을 말합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响铃时用手机的语音引擎报出时间。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang tumutunog, sinasabi ang oras gamit ang speech engine ng telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะปลุก จะบอกเวลาด้วยเอนจินเสียงพูดของโทรศัพท์"
          }
        }
      }
    },
    "alarm.speakNoteIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm sesi, saati söyleyen kısa bir kayıtla değişir (kayıt telefonda üretilir)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm sound becomes a short recording that speaks the time (made on the phone)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Weckton wird zu einer kurzen Aufnahme, die die Uhrzeit ansagt (auf dem Telefon erzeugt)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəngli saatın səsi vaxtı deyən qısa bir yazı ilə əvəz olunur (telefonda yaradılır)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصبح صوت المنبه تسجيلًا قصيرًا ينطق الوقت (يُنشأ على الهاتف)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara alarm menjadi rekaman singkat yang mengucapkan waktu (dibuat di ponsel)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم کی آواز ایک مختصر ریکارڈنگ بن جاتی ہے جو وقت بتاتی ہے (فون پر بنتی ہے)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدای هشدار ضبطی کوتاه می‌شود که ساعت را می‌گوید (روی گوشی ساخته می‌شود)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son de l’alarme devient un court enregistrement qui annonce l’heure (créé sur le téléphone)."
          }
