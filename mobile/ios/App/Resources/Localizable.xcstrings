    "forest.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biten her çalışma turu bir ağaç diker: 25 dakikadan kısa olan fidan, 50 dakikaya kadar ağaç, daha uzunu ulu ağaç olur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every finished work session plants a tree: under 25 minutes a sapling, up to 50 minutes a tree, longer a great tree."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede beendete Arbeitsrunde pflanzt einen Baum: unter 25 Minuten ein Setzling, bis 50 Minuten ein Baum, länger ein großer Baum."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitən hər iş dövrəsi bir ağac əkir: 25 dəqiqədən qısa fidan, 50 dəqiqəyə qədər ağac, daha uzunu böyük ağac olur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل جلسة عمل مكتملة تزرع شجرة: أقل من 25 دقيقة شتلة، حتى 50 دقيقة شجرة، وأطول من ذلك شجرة كبيرة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap sesi kerja yang selesai menanam pohon: kurang dari 25 menit bibit, hingga 50 menit pohon, lebih lama pohon besar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر مکمل سیشن ایک درخت لگاتا ہے: 25 منٹ سے کم پودا، 50 منٹ تک درخت، اس سے زیادہ بڑا درخت۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر نوبت کاری کامل یک درخت می‌کارد: کمتر از 25 دقیقه نهال، تا 50 دقیقه درخت و بیشتر از آن درخت تنومند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque session terminée plante un arbre : moins de 25 minutes une pousse, jusqu’à 50 minutes un arbre, au-delà un grand arbre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая завершённая сессия сажает дерево: меньше 25 минут — росток, до 50 минут — дерево, дольше — большое дерево."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業を1回終えるごとに木を1本植えます。25分未満は苗木、50分までは木、それ以上は大木です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 세션을 마칠 때마다 나무를 심습니다. 25분 미만은 묘목, 50분까지는 나무, 그보다 길면 큰 나무입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每完成一次工作都会种下一棵树：不到25分钟是树苗，50分钟以内是树，更长是大树。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawat natapos na sesyon ay nagtatanim ng puno: wala pang 25 minuto ay punla, hanggang 50 minuto ay puno, mas mahaba ay malaking puno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกรอบงานที่จบจะปลูกต้นไม้หนึ่งต้น: ไม่ถึง 25 นาทีเป็นต้นกล้า ไม่เกิน 50 นาทีเป็นต้นไม้ นานกว่านั้นเป็นต้นไม้ใหญ่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sesión de trabajo terminada planta un árbol: menos de 25 minutos, un brote; hasta 50 minutos, un árbol; más, un gran árbol."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sessão de trabalho concluída planta uma árvore: menos de 25 minutos, uma muda; até 50 minutos, uma árvore; mais que isso, uma grande árvore."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा हुआ हर काम सत्र एक पेड़ लगाता है: 25 मिनट से कम पर पौधा, 50 मिनट तक पेड़, उससे ज़्यादा पर बड़ा पेड़।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি শেষ হওয়া কাজের সেশন একটি গাছ লাগায়: 25 মিনিটের কম হলে চারা, 50 মিনিট পর্যন্ত গাছ, তার বেশি হলে বড় গাছ।"
          }
        }
      }
    },
    "forest.empty": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay henüz ağaç yok. Bir çalışma turunu bitirince ilk fidan dikilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No trees yet this month. Finish a work session to plant your first sapling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Monat noch keine Bäume. Beenden Sie eine Arbeitsrunde für den ersten Setzling."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay hələ ağac yoxdur. Bir iş dövrəsini bitirəndə ilk fidan əkilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أشجار بعد هذا الشهر. أكمل جلسة عمل لتزرع أول شتلة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada pohon bulan ini. Selesaikan satu sesi kerja untuk menanam bibit pertama."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس مہینے ابھی کوئی درخت نہیں۔ ایک سیشن مکمل کریں تو پہلا پودا لگے گا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ماه هنوز درختی نیست. یک نوبت کار را تمام کنید تا اولین نهال کاشته شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d’arbre ce mois-ci. Terminez une session pour planter votre première pousse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце деревьев пока нет. Завершите сессию, чтобы посадить первый росток."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月はまだ木がありません。作業を1回終えると最初の苗木が植わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달에는 아직 나무가 없습니다. 작업 세션을 마치면 첫 묘목이 심어집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月还没有树。完成一次工作就能种下第一棵树苗。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang puno ngayong buwan. Tapusin ang isang sesyon para itanim ang unang punla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เดือนนี้ยังไม่มีต้นไม้ ทำงานให้จบหนึ่งรอบเพื่อปลูกต้นกล้าแรก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay árboles este mes. Termine una sesión de trabajo para plantar su primer brote."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há árvores este mês. Conclua uma sessão de trabalho para plantar sua primeira muda."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस महीने अभी कोई पेड़ नहीं। अपना पहला पौधा लगाने के लिए एक काम सत्र पूरा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মাসে এখনো কোনো গাছ নেই। প্রথম চারা লাগাতে একটি কাজের সেশন শেষ করুন।"
          }
        }
      }
    },
