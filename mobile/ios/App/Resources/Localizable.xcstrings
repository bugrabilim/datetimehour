    "place.districtSource": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlçe merkezleri: GeoNames (CC BY 4.0). Resmî vakit için Diyanet esastır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
