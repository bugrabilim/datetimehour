            "value": "Ajustes por oración"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurações por oração"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर नमाज़ की सेटिंग"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি ওয়াক্তের সেটিং"
          }
        }
      }
    },
    "notify.perPrayer.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her vakit için ayrı süre, ses ve gün seçebilirsiniz. Gün seçmezseniz her gün bildirilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a separate lead time, sound and days for each prayer. With no day selected, it notifies every day."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jedes Gebet eigene Vorlaufzeit, eigenen Ton und eigene Tage wählen. Ohne ausgewählten Tag wird täglich benachrichtigt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər vaxt üçün ayrıca müddət, səs və gün seçə bilərsiniz. Gün seçməsəniz hər gün bildiriləcək."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لكل صلاة وقت تنبيه مسبق وصوتًا وأيامًا خاصة بها. إن لم تختر يومًا فسيصل التنبيه كل يوم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih waktu pengingat, suara, dan hari tersendiri untuk tiap salat. Jika tidak ada hari dipilih, pemberitahuan muncul setiap hari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر نماز کے لیے الگ وقت، آواز اور دن منتخب کریں۔ کوئی دن منتخب نہ ہو تو ہر روز اطلاع ملے گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای هر نماز زمان، صدا و روزهای جداگانه انتخاب کنید. اگر روزی انتخاب نشود، هر روز اعلان می‌آید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez pour chaque prière un délai, un son et des jours. Sans jour choisi, la notification arrive chaque jour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для каждого намаза можно выбрать своё время, звук и дни. Если дни не выбраны, уведомление приходит каждый день."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拝ごとに通知のタイミング、音、曜日を選べます。曜日を選ばない場合は毎日通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도마다 알림 시점, 소리, 요일을 따로 고를 수 있습니다. 요일을 고르지 않으면 매일 알립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可为每次礼拜单独选择提前时间、声音和日期。未选日期时每天提醒。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng hiwalay na oras ng paalala, tunog at araw para sa bawat salah. Kung walang napiling araw, aabisuhan araw-araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเวลาแจ้งล่วงหน้า เสียง และวันแยกกันสำหรับแต่ละเวลาละหมาด หากไม่เลือกวันจะแจ้งทุกวัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un aviso previo, un sonido y unos días distintos para cada oración. Sin días elegidos, avisa todos los días."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha antecedência, som e dias separados para cada oração. Sem dia escolhido, avisa todos os dias."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर नमाज़ के लिए अलग अग्रिम समय, आवाज़ और दिन चुनें। कोई दिन न चुनें तो हर दिन सूचना मिलेगी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি নামাজের জন্য আলাদা আগাম সময়, শব্দ ও দিন বাছুন। কোনো দিন না বাছলে প্রতিদিন জানায়।"
          }
        }
      }
    },
