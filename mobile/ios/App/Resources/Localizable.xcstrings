    "intent.prayer.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili yer için sıradaki vakti ve kalan süreyi söyler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells the next prayer time and the time left for the selected place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt die nächste Gebetszeit und die verbleibende Zeit für den gewählten Ort."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş yer üçün növbəti vaxtı və qalan müddəti deyir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك بوقت الصلاة التالية والوقت المتبقي للمكان المحدد."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyebutkan waktu salat berikutnya dan sisa waktunya untuk tempat pilihan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب جگہ کے لیے اگلی نماز کا وقت اور باقی وقت بتاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت نماز بعدی و زمان باقی‌مانده را برای مکان انتخابی می‌گوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne la prochaine heure de prière et le temps restant pour le lieu choisi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщает время следующего намаза и сколько осталось для выбранного места."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ場所の次の礼拝時刻と残り時間を伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 곳의 다음 기도 시간과 남은 시간을 알려 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉您所选地点的下一次礼拜时间和剩余时间。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinasabi ang susunod na oras ng dasal at natitirang oras para sa napiling lugar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกเวลาละหมาดถัดไปและเวลาที่เหลือสำหรับสถานที่ที่เลือก"
          }
        }
      }
    },
