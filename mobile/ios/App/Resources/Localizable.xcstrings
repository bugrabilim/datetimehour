    "qibla.mosquesError": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Camiler yüklenemedi. İnternet bağlantısını denetleyip yeniden deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load mosques. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Moscheen konnten nicht geladen werden. Prüfen Sie die Verbindung und versuchen Sie es erneut."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məscidlər yüklənmədi. İnternet bağlantısını yoxlayıb yenidən cəhd edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل المساجد. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masjid tidak dapat dimuat. Periksa koneksi Anda dan coba lagi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مساجد لوڈ نہیں ہو سکیں۔ کنکشن چیک کر کے دوبارہ کوشش کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسجدها بارگذاری نشدند. اتصال را بررسی کنید و دوباره بکوشید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les mosquées. Vérifiez votre connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить мечети. Проверьте подключение и попробуйте снова."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モスクを読み込めませんでした。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모스크를 불러오지 못했습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载清真寺。请检查网络连接后重试。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-load ang mga masjid. Suriin ang koneksiyon at subukang muli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดมัสยิดไม่ได้ โปรดตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar las mezquitas. Revise su conexión y vuelva a intentarlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar as mesquitas. Verifique sua conexão e tente de novo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मस्जिदें लोड नहीं हो सकीं। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মসজিদ লোড করা যায়নি। সংযোগ দেখে আবার চেষ্টা করুন।"
          }
        }
      }
    },
