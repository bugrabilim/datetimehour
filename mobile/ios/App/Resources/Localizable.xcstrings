          "stringUnit": {
            "state": "translated",
            "value": "赤い光なら目が暗さに慣れたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빨간빛은 눈의 암순응을 지켜 줍니다."
