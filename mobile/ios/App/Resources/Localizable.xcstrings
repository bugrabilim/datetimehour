    "track.clearConfirm": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz, kaza ve oruç kayıtları bu cihazdan silinsin mi?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete prayer, make-up and fasting records from this device?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebets-, Nachhol- und Fastendaten von diesem Gerät löschen?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz, qəza və oruc qeydləri bu cihazdan silinsin?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف سجلات الصلاة والقضاء والصيام من هذا الجهاز؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus catatan salat, qada, dan puasa dari perangkat ini?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلے سے نماز، قضا اور روزے کے ریکارڈ حذف کر دیں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سوابق نماز، قضا و روزه از این دستگاه حذف شوند؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer de cet appareil les données de prière, de rattrapage et de jeûne ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить с этого устройства записи о намазах, каза и постах?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拝、補う礼拝、断食の記録をこの端末から削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도, 보충 기도, 단식 기록을 이 기기에서 삭제할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从此设备删除礼拜、补礼和斋戒记录？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Burahin sa device na ito ang mga tala ng dasal, qada at pag-aayuno?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบันทึกละหมาด การชดใช้ และการถือศีลอดออกจากอุปกรณ์นี้ไหม?"
          }
        }
      }
    },
