    "cals.christian.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paskalya, Noel ve diğer Hristiyan bayramları; Batı ve Ortodoks kiliselerinin tarihleri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easter, Christmas and other Christian feasts, with Western and Orthodox dates."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostern, Weihnachten und weitere christliche Feste, mit westlichen und orthodoxen Terminen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasxa, Milad və digər xristian bayramları; Qərb və Pravoslav kilsələrinin tarixləri."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيد الفصح وعيد الميلاد وسائر الأعياد المسيحية، بتواريخ الكنائس الغربية والأرثوذكسية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paskah, Natal, dan hari raya Kristen lainnya, dengan tanggal gereja Barat dan Ortodoks."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایسٹر، کرسمس اور دیگر مسیحی تہوار، مغربی اور آرتھوڈوکس کلیساؤں کی تاریخوں کے ساتھ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عید پاک، کریسمس و دیگر جشن‌های مسیحی، با تاریخ‌های کلیساهای غربی و ارتدکس."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pâques, Noël et les autres fêtes chrétiennes, aux dates des Églises d’Occident et orthodoxes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пасха, Рождество и другие христианские праздники по датам западных и православных церквей."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復活祭、クリスマスなどキリスト教の祝日を、西方教会と正教会の日付で表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부활절, 성탄절 등 기독교 축일을 서방 교회와 정교회 날짜로 보여 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复活节、圣诞节等基督教节日，包括西方教会和东正教会的日期。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasko ng Pagkabuhay, Pasko, at iba pang Kristiyanong pista, ayon sa petsa ng mga simbahang Kanluranin at Ortodokso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันอีสเตอร์ วันคริสต์มาส และเทศกาลคริสต์อื่น ๆ ตามวันที่ของคริสตจักรตะวันตกและออร์โธดอกซ์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pascua, Navidad y otras fiestas cristianas, con las fechas de las Iglesias occidentales y ortodoxas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Páscoa, Natal e outras festas cristãs, com as datas das Igrejas ocidentais e ortodoxas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ईस्टर, क्रिसमस और अन्य ईसाई पर्व, पश्चिमी और ऑर्थोडॉक्स चर्चों की तारीख़ों के साथ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইস্টার, বড়দিন ও অন্যান্য খ্রিস্টান উৎসব, পশ্চিমা ও অর্থোডক্স তারিখসহ।"
          }
        }
      }
    },
    "cals.christian.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Batı kiliseleri Paskalya'yı Gregoryen, Ortodoks kiliseleri Jülyen takvimine göre hesaplar; tarihler burada Gregoryen takvimde gösterilir. Bazı Ortodoks kiliseleri sabit bayramları (Noel dahil) Jülyen takvimine göre 13 gün sonra kutlar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Western churches calculate Easter with the Gregorian calendar, Orthodox churches with the Julian calendar; all dates are shown on the Gregorian calendar. Some Orthodox churches keep the fixed feasts, Christmas included, 13 days later on the Julian calendar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Westliche Kirchen berechnen Ostern nach dem gregorianischen, orthodoxe Kirchen nach dem julianischen Kalender; alle Daten stehen hier im gregorianischen Kalender. Manche orthodoxe Kirchen feiern die festen Feste, auch Weihnachten, nach dem julianischen Kalender 13 Tage später."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qərb kilsələri Pasxanı Qriqorian, Pravoslav kilsələri isə Yulian təqvimi ilə hesablayır; tarixlər burada Qriqorian təqvimində göstərilir. Bəzi Pravoslav kilsələri sabit bayramları, o cümlədən Miladı, Yulian təqvimi ilə 13 gün sonra qeyd edir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحسب الكنائس الغربية عيد الفصح بالتقويم الغريغوري والكنائس الأرثوذكسية بالتقويم اليولياني، وتُعرض كل التواريخ هنا بالتقويم الغريغوري. وتحتفل بعض الكنائس الأرثوذكسية بالأعياد الثابتة، ومنها عيد الميلاد، بعد 13 يومًا وفق التقويم اليولياني."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereja Barat menghitung Paskah dengan kalender Gregorius, gereja Ortodoks dengan kalender Julius; semua tanggal di sini ditampilkan dalam kalender Gregorius. Sebagian gereja Ortodoks merayakan hari raya tetap, termasuk Natal, 13 hari kemudian menurut kalender Julius."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مغربی کلیسا ایسٹر کا حساب گریگورین کیلنڈر سے اور آرتھوڈوکس کلیسا جولین کیلنڈر سے کرتے ہیں؛ یہاں تمام تاریخیں گریگورین کیلنڈر میں دکھائی گئی ہیں۔ کچھ آرتھوڈوکس کلیسا مقررہ تہوار، بشمول کرسمس، جولین کیلنڈر کے مطابق 13 دن بعد مناتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلیساهای غربی عید پاک را با تقویم گریگوری و کلیساهای ارتدکس با تقویم ژولینی حساب می‌کنند؛ همهٔ تاریخ‌ها اینجا به تقویم گریگوری نشان داده می‌شوند. برخی کلیساهای ارتدکس جشن‌های ثابت، از جمله کریسمس، را طبق تقویم ژولینی 13 روز بعد برگزار می‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Églises d’Occident calculent Pâques selon le calendrier grégorien, les Églises orthodoxes selon le calendrier julien ; toutes les dates sont données ici dans le calendrier grégorien. Certaines Églises orthodoxes célèbrent les fêtes fixes, dont Noël, 13 jours plus tard selon le calendrier julien."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Западные церкви рассчитывают Пасху по григорианскому календарю, православные — по юлианскому; все даты здесь указаны по григорианскому календарю. Некоторые православные церкви отмечают непереходящие праздники, включая Рождество, по юлианскому календарю, на 13 дней позже."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "西方教会は復活祭をグレゴリオ暦で、正教会はユリウス暦で計算します。日付はすべてグレゴリオ暦で表示しています。一部の正教会は、クリスマスを含む固定祝日をユリウス暦に従って13日後に祝います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서방 교회는 그레고리력으로, 정교회는 율리우스력으로 부활절을 계산합니다. 모든 날짜는 그레고리력으로 표시합니다. 일부 정교회는 성탄절을 포함한 고정 축일을 율리우스력에 따라 13일 늦게 지냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "西方教会按格里高利历计算复活节，东正教会按儒略历计算；这里的日期均按格里高利历（公历）显示。部分东正教会按儒略历推迟13天庆祝包括圣诞节在内的固定节日。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinukuwenta ng mga simbahang Kanluranin ang Pasko ng Pagkabuhay ayon sa kalendaryong Gregoryano, at ng mga simbahang Ortodokso ayon sa kalendaryong Huliyano; lahat ng petsa rito ay nasa kalendaryong Gregoryano. Ipinagdiriwang ng ilang simbahang Ortodokso ang mga nakapirming pista, kasama ang Pasko, nang 13 araw na mas huli ayon sa kalendaryong Huliyano."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คริสตจักรตะวันตกคำนวณวันอีสเตอร์ตามปฏิทินเกรโกเรียน ส่วนคริสตจักรออร์โธดอกซ์ใช้ปฏิทินจูเลียน วันที่ทั้งหมดในที่นี้แสดงตามปฏิทินเกรโกเรียน คริสตจักรออร์โธดอกซ์บางแห่งฉลองเทศกาลที่มีวันตายตัว รวมถึงคริสต์มาส ช้ากว่า 13 วันตามปฏิทินจูเลียน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Iglesias occidentales calculan la Pascua con el calendario gregoriano y las ortodoxas con el juliano; todas las fechas se muestran aquí en el calendario gregoriano. Algunas Iglesias ortodoxas celebran las fiestas fijas, incluida la Navidad, 13 días más tarde según el calendario juliano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As Igrejas ocidentais calculam a Páscoa pelo calendário gregoriano, e as ortodoxas, pelo juliano; todas as datas aparecem aqui no calendário gregoriano. Algumas Igrejas ortodoxas celebram as festas fixas, inclusive o Natal, 13 dias depois, segundo o calendário juliano."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पश्चिमी चर्च ईस्टर की गणना ग्रेगोरियन कैलेंडर से और ऑर्थोडॉक्स चर्च जूलियन कैलेंडर से करते हैं; यहाँ सभी तारीख़ें ग्रेगोरियन कैलेंडर में दिखाई गई हैं। कुछ ऑर्थोडॉक्स चर्च क्रिसमस सहित नियत पर्व जूलियन कैलेंडर के अनुसार 13 दिन बाद मनाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পশ্চিমা গির্জাগুলো গ্রেগরীয় ক্যালেন্ডারে, অর্থোডক্স গির্জাগুলো জুলীয় ক্যালেন্ডারে ইস্টার হিসাব করে; সব তারিখ গ্রেগরীয় ক্যালেন্ডারে দেখানো হয়েছে। কিছু অর্থোডক্স গির্জা বড়দিনসহ নির্দিষ্ট উৎসবগুলো জুলীয় ক্যালেন্ডারে 13 দিন পরে পালন করে।"
          }
        }
      }
    },
