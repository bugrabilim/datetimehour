    "perms.location.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verirseniz bulunduğunuz yerin vakitleri ve havası kendiliğinden gelir, seçmekle uğraşmazsınız. Vermezseniz il ya da ilçeyi elle seçersiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you allow it, prayer times and weather for where you are come automatically, so you don't have to pick a place. If not, you pick your province or district by hand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie zustimmen, kommen Gebetszeiten und Wetter für Ihren Ort automatisch, ohne dass Sie etwas auswählen müssen. Sonst wählen Sie Provinz oder Bezirk von Hand."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcazə versəniz, olduğunuz yerin vaxtları və havası özü gəlir, seçməklə məşğul olmazsınız. Verməsəniz, vilayəti və ya rayonu əl ilə seçərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن سمحت، تأتي أوقات الصلاة والطقس لمكانك تلقائيًا دون أن تختار شيئًا. وإن لم تسمح، تختار الولاية أو المنطقة بنفسك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diizinkan, jadwal salat dan cuaca untuk tempat Anda muncul otomatis, tanpa perlu memilih. Jika tidak, Anda memilih provinsi atau distrik secara manual."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازت دیں تو آپ کی جگہ کے اوقات اور موسم خود بخود آ جائیں گے، چننے کی ضرورت نہیں۔ نہ دیں تو شہر خود چنیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اجازه دهید، اوقات و هوای محل شما خودکار می‌آید و لازم نیست انتخاب کنید. اگر ندهید، شهر را دستی انتخاب می‌کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous l'autorisez, les heures de prière et la météo de l'endroit où vous êtes arrivent toutes seules. Sinon, vous choisissez votre ville à la main."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если разрешите, время намаза и погода для вашего места подставятся сами. Если нет, город выбирается вручную."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可すると、今いる場所の礼拝時刻と天気が自動で表示され、選ぶ手間がありません。許可しない場合は都市を手で選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 지금 있는 곳의 기도 시간과 날씨가 자동으로 나와요. 허용하지 않으면 도시를 직접 고르면 돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许后，所在地的礼拜时间和天气会自动出现，无需手动选择；不允许则需自己选择城市。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung papayagan, awtomatikong lalabas ang oras ng dasal at panahon kung nasaan ka. Kung hindi, pipiliin mo ang lungsod nang mano-mano."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าอนุญาต เวลาละหมาดและสภาพอากาศของที่ที่คุณอยู่จะขึ้นเองโดยไม่ต้องเลือก ถ้าไม่อนุญาต คุณเลือกเมืองเองได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo permite, los horarios de oración y el tiempo de donde esté llegan solos. Si no, elige su ciudad a mano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se permitir, os horários de oração e o clima de onde você está chegam sozinhos, sem você precisar escolher. Se não, você escolhe a província ou o distrito manualmente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति दें तो आपकी जगह के नमाज़ के समय और मौसम अपने आप आ जाएँगे, चुनने की ज़रूरत नहीं। न दें तो प्रांत या ज़िला ख़ुद चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি দিলে আপনি যেখানে আছেন সেখানকার নামাজের সময় ও আবহাওয়া নিজে থেকে আসে, জায়গা বাছার ঝামেলা থাকে না। না দিলে প্রদেশ বা জেলা হাতে বাছবেন।"
          }
        }
      }
    },
    "perms.location.whyN": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verirseniz bulunduğunuz yerin havası, gün doğumu ve batımı kendiliğinden gelir, seçmekle uğraşmazsınız. Vermezseniz yeri elle seçersiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you allow it, the weather, sunrise and sunset for where you are come automatically, so you don't have to pick a place. If not, you pick it by hand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie zustimmen, kommen Wetter, Sonnenaufgang und -untergang für Ihren Ort automatisch, ohne dass Sie etwas auswählen müssen. Sonst wählen Sie den Ort von Hand."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcazə versəniz, olduğunuz yerin havası, gün çıxması və batması özü gəlir, seçməklə məşğul olmazsınız. Verməsəniz, yeri əl ilə seçərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن سمحت، يأتي الطقس وأوقات الشروق والغروب لمكانك تلقائيًا دون أن تختار شيئًا. وإن لم تسمح، تختار المكان بنفسك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diizinkan, cuaca serta waktu matahari terbit dan terbenam untuk tempat Anda muncul otomatis, tanpa perlu memilih. Jika tidak, Anda memilih tempat secara manual."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازت دیں تو آپ کی جگہ کا موسم اور طلوع و غروبِ آفتاب خود بخود آ جائیں گے، چننے کی ضرورت نہیں۔ نہ دیں تو جگہ خود چنیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اجازه دهید، هوا و زمان طلوع و غروب آفتاب محل شما خودکار می‌آید و لازم نیست انتخاب کنید. اگر ندهید، مکان را دستی انتخاب می‌کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous l'autorisez, la météo et les heures de lever et de coucher du soleil de l'endroit où vous êtes arrivent toutes seules. Sinon, vous choisissez le lieu à la main."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если разрешите, погода, восход и закат для вашего места подставятся сами. Если нет, место выбирается вручную."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可すると、今いる場所の天気と日の出・日の入りが自動で表示され、選ぶ手間がありません。許可しない場合は場所を手で選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 지금 있는 곳의 날씨와 일출·일몰이 자동으로 나와요. 허용하지 않으면 장소를 직접 고르면 돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许后，所在地的天气和日出日落时间会自动出现，无需手动选择；不允许则需自己选择地点。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung papayagan, awtomatikong lalabas ang panahon at ang pagsikat at paglubog ng araw kung nasaan ka. Kung hindi, pipiliin mo ang lugar nang mano-mano."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าอนุญาต สภาพอากาศและเวลาพระอาทิตย์ขึ้นและตกของที่ที่คุณอยู่จะขึ้นเองโดยไม่ต้องเลือก ถ้าไม่อนุญาต คุณเลือกสถานที่เองได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo permite, el tiempo y las horas de salida y puesta del sol de donde esté llegan solos. Si no, elige el lugar a mano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se permitir, o clima e os horários do nascer e do pôr do sol de onde você está chegam sozinhos, sem você precisar escolher. Se não, você escolhe o lugar manualmente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति दें तो आपकी जगह का मौसम और सूर्योदय-सूर्यास्त अपने आप आ जाएँगे, चुनने की ज़रूरत नहीं। न दें तो जगह ख़ुद चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি দিলে আপনি যেখানে আছেন সেখানকার আবহাওয়া, সূর্যোদয় ও সূর্যাস্ত নিজে থেকে আসে, জায়গা বাছার ঝামেলা থাকে না। না দিলে হাতে বাছবেন।"
          }
        }
      }
    },
