    "cals.myanmar.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Myanmar (Birmanya) ay-güneş takvimine göre tarih, Thingyan su bayramı, Myanmar yılbaşı ve dolunay bayramları."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date in the Myanmar (Burmese) lunisolar calendar, the Thingyan water festival, Myanmar New Year and the full-moon festivals."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum im myanmarischen (birmanischen) Lunisolarkalender, das Wasserfest Thingyan, das myanmarische Neujahr und die Vollmondfeste."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Myanma (Birma) ay-günəş təqviminə görə tarix, Tinqyan su bayramı, Myanma yeni ili və bədirlənmiş ay bayramları."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ في التقويم القمري الشمسي الميانماري (البورمي)، ومهرجان الماء ثينغيان، ورأس السنة الميانمارية، وأعياد البدر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal menurut kalender lunisolar Myanmar (Burma), festival air Thingyan, Tahun Baru Myanmar, dan hari-hari raya purnama."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میانمار (برما) کے قمری شمسی کیلنڈر کے مطابق تاریخ، پانی کا تہوار تھنگیان، میانمار کا نیا سال اور پورے چاند کے تہوار۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ در گاه‌شماری قمری‌خورشیدی میانمار (برمه)، جشن آب تینگیان، سال نو میانماری و جشن‌های ماه کامل."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date du calendrier luni-solaire birman (Myanmar), la fête de l’eau Thingyan, le Nouvel An birman et les fêtes de la pleine lune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата по мьянманскому (бирманскому) лунно-солнечному календарю, праздник воды Тинджан, мьянманский Новый год и праздники полнолуния."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミャンマー（ビルマ）の太陰太陽暦の日付、水祭りティンジャン、ミャンマー正月と満月の祭日。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미얀마(버마) 태음태양력의 날짜, 물 축제 띵잔, 미얀마 새해와 보름 축일."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缅甸阴阳历的日期、泼水节、缅历新年和月圆节日。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang petsa sa kalendaryong lunisolar ng Myanmar (Burma), ang pista ng tubig na Thingyan, ang Bagong Taon ng Myanmar at ang mga pista sa kabilugan ng buwan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ตามปฏิทินจันทรคติ-สุริยคติของเมียนมา (พม่า) เทศกาลน้ำตะจาน ปีใหม่เมียนมา และวันเพ็ญสำคัญ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha del calendario lunisolar de Myanmar (Birmania), el festival del agua Thingyan, el Año Nuevo birmano y las fiestas de luna llena."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A data no calendário lunissolar de Mianmar (Birmânia), o festival da água Thingyan, o Ano-Novo birmanês e as festas de lua cheia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "म्यांमार (बर्मा) के चांद्र-सौर पंचांग के अनुसार तिथि, जल उत्सव थिंग्यान, म्यांमार नववर्ष और पूर्णिमा के पर्व।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিয়ানমারের (বার্মা) চান্দ্র-সৌর পঞ্জিকা অনুযায়ী তারিখ, জল উৎসব থিংইয়ান, মিয়ানমারের নববর্ষ এবং পূর্ণিমার উৎসব।"
          }
        }
      }
    },
    "cals.myanmar.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarihler, ayın büyüyen ya da küçülen yarısının kaçıncı günü olduğuyla yazılır. Artık ay (watat) yıllarında Waso iki kez gelir. Hükümetin su bayramı tatili Thingyan günlerinden uzun olabilir ve her yıl ayrıca ilan edilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates are given as the day of the waxing or waning half of the month. In leap-month (watat) years Waso comes twice. The government's Thingyan holiday can be longer than the Thingyan days and is announced each year."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten werden als Tag der zu- oder abnehmenden Monatshälfte angegeben. In Schaltmonatsjahren (Watat) gibt es Waso zweimal. Die staatlichen Thingyan-Feiertage können länger sein als die Thingyan-Tage und werden jedes Jahr bekanntgegeben."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarixlər ayın böyüyən və ya azalan yarısının neçənci günü olması ilə yazılır. Artıq ay (vatat) illərində Vaso iki dəfə gəlir. Dövlətin su bayramı tətili Tinqyan günlərindən uzun ola bilər və hər il ayrıca elan olunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُكتب التواريخ بعدد أيام النصف المتزايد أو المتناقص من الشهر. في سنوات الشهر الكبيس (واتات) يأتي شهر واسو مرتين. قد تكون عطلة ثينغيان الحكومية أطول من أيام ثينغيان، وتُعلن كل عام."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal ditulis sebagai hari ke berapa pada paruh bulan bertambah atau berkurang. Pada tahun berbulan kabisat (watat), bulan Waso datang dua kali. Libur Thingyan pemerintah bisa lebih panjang daripada hari-hari Thingyan dan diumumkan setiap tahun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخیں مہینے کے بڑھتے یا گھٹتے نصف کے دن کے نمبر سے لکھی جاتی ہیں۔ لوند مہینے (واتات) والے برسوں میں واسو دو بار آتا ہے۔ تھنگیان کی سرکاری تعطیل تھنگیان کے دنوں سے لمبی ہو سکتی ہے اور ہر سال الگ سے اعلان کی جاتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ‌ها با شمارهٔ روز در نیمهٔ فزاینده یا کاهندهٔ ماه نوشته می‌شوند. در سال‌های دارای ماه کبیسه (واتات) ماه واسو دو بار می‌آید. تعطیلی دولتی تینگیان ممکن است از روزهای تینگیان بلندتر باشد و هر سال جداگانه اعلام می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates indiquent le jour de la moitié croissante ou décroissante du mois. Les années à mois intercalaire (watat), Waso revient deux fois. Les congés officiels de Thingyan peuvent dépasser les jours de Thingyan et sont annoncés chaque année."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даты записываются как день растущей или убывающей половины месяца. В годы со вставным месяцем (ватат) Вазо бывает дважды. Государственные выходные на Тинджан могут быть длиннее самих дней Тинджана и объявляются каждый год."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付は月の白分（満ちる半月）または黒分（欠ける半月）の何日目かで表します。閏月（ワタッ）の年はワーゾー月が2回あります。政府のティンジャン休日はティンジャンの日数より長いことがあり、毎年発表されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜는 달이 차는 보름(백월)이나 기우는 보름(흑월)의 며칠째인지로 나타냅니다. 윤달(와탓)이 있는 해에는 와소월이 두 번 옵니다. 정부의 띵잔 휴일은 띵잔 기간보다 길 수 있으며 해마다 발표됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期按月亮的盈半月（白月）或亏半月（黑月）第几天来写。在有闰月（瓦塔）的年份，瓦索月出现两次。政府的泼水节假期可能比泼水节本身更长，每年另行公布。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isinusulat ang petsa bilang ika-ilang araw ng lumalaki o lumiliit na kalahati ng buwan. Sa mga taong may dagdag na buwan (watat), dalawang beses dumarating ang Waso. Maaaring mas mahaba ang opisyal na bakasyon ng Thingyan kaysa sa mga araw ng Thingyan at inaanunsiyo ito taon-taon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่บอกเป็นข้างขึ้นหรือข้างแรมกี่ค่ำ ในปีที่มีอธิกมาส (วะทัต) เดือนวาโซจะมีสองครั้ง วันหยุดราชการช่วงตะจานอาจยาวกว่าวันตะจานและประกาศเป็นปีๆ ไป"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas se indican como el día de la mitad creciente o menguante del mes. En los años con mes intercalar (watat), Waso aparece dos veces. Los días festivos oficiales de Thingyan pueden ser más que los días de Thingyan y se anuncian cada año."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas indicam o dia da metade crescente ou minguante do mês. Nos anos com mês intercalar (watat), Waso aparece duas vezes. O feriado oficial de Thingyan pode ser mais longo que os dias de Thingyan e é anunciado a cada ano."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिथियाँ महीने के शुक्ल या कृष्ण पक्ष के दिन की संख्या से लिखी जाती हैं। अधिक मास (वातत) वाले वर्षों में वासो दो बार आता है। सरकार का थिंग्यान अवकाश थिंग्यान के दिनों से लंबा हो सकता है और हर वर्ष अलग से घोषित होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তারিখ লেখা হয় মাসের শুক্লপক্ষ বা কৃষ্ণপক্ষের কততম দিন, তা দিয়ে। অধিমাস (ওয়াতাত) বছরে ওয়াসো দুবার আসে। সরকারি থিংইয়ান ছুটি থিংইয়ানের দিনগুলোর চেয়ে দীর্ঘ হতে পারে এবং প্রতি বছর আলাদা করে ঘোষণা করা হয়।"
          }
        }
      }
    },
