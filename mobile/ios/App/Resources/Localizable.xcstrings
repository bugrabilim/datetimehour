    "nature.crescentCats.A": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıplak gözle kolayca görülür"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easily visible to the naked eye"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit bloßem Auge leicht sichtbar"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çılpaq gözlə asanlıqla görünür"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرى بالعين المجردة بسهولة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudah terlihat dengan mata telanjang"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ننگی آنکھ سے آسانی سے نظر آتا ہے"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌آسانی با چشم غیرمسلح دیده می‌شود"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facilement visible à l’œil nu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Легко виден невооружённым глазом"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肉眼で簡単に見える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맨눈으로 쉽게 보임"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肉眼容易看到"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Madaling makita ng mata"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เห็นได้ง่ายด้วยตาเปล่า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fácil de ver a simple vista"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fácil de ver a olho nu"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नंगी आँखों से आसानी से दिखता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খালি চোখে সহজে দেখা যায়"
          }
        }
      }
    },
    "nature.crescentCats.B": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyi havada çıplak gözle görülür"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible to the naked eye in perfect conditions"
