    "panchang.hinduNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tithi, nakşatra ve ay Yeni Delhi'deki gün doğumuna göredir; başka yerlerde bir gün farklı olabilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tithi, nakshatra and month are for sunrise in New Delhi; elsewhere they can differ by a day."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tithi, Nakshatra und Monat gelten für den Sonnenaufgang in Neu-Delhi; anderswo können sie um einen Tag abweichen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tithi, nakşatra və ay Yeni Dehlidəki gün çıxmasına görədir; başqa yerlərdə bir gün fərqli ola bilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التيثي والنكشاترا والشهر بحسب شروق الشمس في نيودلهي؛ وقد تختلف بيوم في أماكن أخرى."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tithi, nakshatra, dan bulan mengikuti matahari terbit di New Delhi; di tempat lain bisa berbeda satu hari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تتھی، نکشتر اور مہینہ نئی دہلی کے طلوعِ آفتاب کے مطابق ہیں؛ دوسری جگہوں پر ایک دن کا فرق ہو سکتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تیتی، نکشترا و ماه بر پایهٔ طلوع خورشید در دهلی نو است؛ در جاهای دیگر ممکن است یک روز فرق کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tithi, le nakshatra et le mois correspondent au lever du soleil à New Delhi ; ailleurs, ils peuvent différer d'un jour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Титхи, накшатра и месяц даны для восхода Солнца в Нью-Дели; в других местах они могут отличаться на день."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ティティ、ナクシャトラ、月はニューデリーの日の出時点のものです。ほかの場所では1日ずれることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "티티, 낙샤트라, 달은 뉴델리 일출 기준입니다. 다른 곳에서는 하루 차이가 날 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太阴日、星宿和月份以新德里日出为准；在其他地方可能相差一天。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang tithi, nakshatra at buwan ay ayon sa pagsikat ng araw sa New Delhi; sa ibang lugar maaaring magkaiba nang isang araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดิถี นักษัตร และเดือน อิงเวลาพระอาทิตย์ขึ้นที่นิวเดลี ที่อื่นอาจต่างกันหนึ่งวัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tithi, el nakshatra y el mes corresponden a la salida del sol en Nueva Delhi; en otros lugares pueden diferir en un día."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tithi, o nakshatra e o mês são do nascer do sol em Nova Délhi; em outros lugares podem diferir em um dia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिथि, नक्षत्र और मास नई दिल्ली के सूर्योदय के अनुसार हैं; दूसरी जगहों पर एक दिन का अंतर हो सकता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তিথি, নক্ষত্র ও মাস নয়াদিল্লির সূর্যোদয় অনুযায়ী; অন্য জায়গায় এক দিনের পার্থক্য হতে পারে।"
          }
        }
      }
    },
