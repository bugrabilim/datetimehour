    "dual.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "21. saat modelinde iki kadran var: solda burası, sağda bu şehir. Şehrin adına dokunarak da değiştirebilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clock style 21 has two dials: here on the left, this city on the right. You can also tap the city name to change it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhrmodell 21 hat zwei Zifferblätter: links hier, rechts diese Stadt. Sie können sie auch durch Tippen auf den Stadtnamen ändern."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "21-ci saat modelində iki siferblat var: solda bura, sağda bu şəhər. Şəhərin adına toxunaraq da dəyişə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في نموذج الساعة 21 ميناءان: هنا على اليمين وهذه المدينة على اليسار. يمكنك أيضًا لمس اسم المدينة لتغييرها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model jam 21 memiliki dua muka jam: lokasi Anda di kiri, kota ini di kanan. Anda juga bisa mengetuk nama kota untuk menggantinya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی کے ماڈل 21 میں دو ڈائل ہیں: بائیں یہاں، دائیں یہ شہر۔ شہر کے نام پر ٹیپ کر کے بھی بدل سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مدل ساعت 21 دو صفحه دارد: چپ اینجا، راست این شهر. با لمس نام شهر هم می‌توانید آن را عوض کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle 21 a deux cadrans : ici à gauche, cette ville à droite. Touchez le nom de la ville pour la changer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У модели 21 два циферблата: слева — здесь, справа — этот город. Город можно сменить, нажав на его название."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計モデル21は文字盤が2つ：左が現在地、右がこの都市です。都市名をタップしても変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "21번 시계 모델에는 문자판이 두 개 있습니다. 왼쪽은 여기, 오른쪽은 이 도시입니다. 도시 이름을 눌러 바꿀 수도 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第21款时钟有两个表盘：左边是本地，右边是这座城市。也可以点城市名更换。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May dalawang dial ang modelo 21: dito sa kaliwa, ang lungsod na ito sa kanan. Puwede mo ring i-tap ang pangalan ng lungsod para palitan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาแบบที่ 21 มีสองหน้าปัด: ซ้ายคือที่นี่ ขวาคือเมืองนี้ แตะชื่อเมืองเพื่อเปลี่ยนได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de reloj 21 tiene dos esferas: aquí a la izquierda y esta ciudad a la derecha. También puede tocar el nombre de la ciudad para cambiarla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de relógio 21 tem dois mostradores: aqui à esquerda e esta cidade à direita. Você também pode tocar no nome da cidade para mudá-la."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी मॉडल 21 में दो डायल हैं: बाईं ओर यहाँ, दाईं ओर यह शहर। शहर बदलने के लिए आप उसके नाम पर भी टैप कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ির 21 নম্বর ধরনে দুটি ডায়াল আছে: বাঁয়ে এখানকার, ডানে এই শহরের। শহরের নামে চেপেও বদলাতে পারেন।"
          }
        }
      }
    },
    "fs.toolsNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekranda ilk saatten geriye kaydırınca pomodoro, son saatten sonra kronometre açılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In full screen, swipe back from the first clock for the pomodoro, and past the last clock for the stopwatch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Vollbild: vor der ersten Uhr liegt der Pomodoro, nach der letzten die Stoppuhr."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekranda ilk saatdən geriyə sürüşdürəndə pomodoro, son saatdən sonra saniyəölçən açılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في ملء الشاشة: اسحب للخلف من الساعة الأولى للبومودورو، وبعد الساعة الأخيرة لساعة الإيقاف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di layar penuh, geser mundur dari jam pertama untuk pomodoro, dan lewat jam terakhir untuk stopwatch."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فل اسکرین میں پہلی گھڑی سے پیچھے سوائپ کریں تو پومودورو، آخری گھڑی کے بعد اسٹاپ واچ کھلتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تمام‌صفحه، از ساعت اول به عقب بکشید تا پومودورو و پس از ساعت آخر کرنومتر باز شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En plein écran, revenez avant la première horloge pour le pomodoro, et allez après la dernière pour le chronomètre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В полноэкранном режиме перед первыми часами — помодоро, после последних — секундомер."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全画面では最初の時計より前にポモドーロ、最後の時計の後にストップウォッチがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면에서 첫 시계 앞으로 넘기면 뽀모도로, 마지막 시계 뒤로 넘기면 스톱워치가 나옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏时，在第一款时钟前是番茄钟，最后一款之后是秒表。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa full screen, mag-swipe pabalik mula sa unang orasan para sa pomodoro, at lampas sa huling orasan para sa stopwatch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในโหมดเต็มจอ เลื่อนย้อนจากนาฬิกาแรกเพื่อเปิดโพโมโดโร และเลื่อนเลยนาฬิกาสุดท้ายเพื่อเปิดนาฬิกาจับเวลา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A pantalla completa, deslice hacia atrás desde el primer reloj para el pomodoro, y más allá del último reloj para el cronómetro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em tela cheia, deslize para trás a partir do primeiro relógio para o pomodoro, e além do último relógio para o cronômetro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ुल स्क्रीन में पोमोडोरो के लिए पहली घड़ी से पीछे स्वाइप करें, और स्टॉपवॉच के लिए आख़िरी घड़ी से आगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্ণ পর্দায় প্রথম ঘড়ি থেকে পেছনে সোয়াইপ করলে পোমোডোরো, আর শেষ ঘড়ি পেরোলে স্টপওয়াচ।"
          }
        }
      }
    },
