    "focus.screenNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamayı pomodoro çalışma süresinde engellemeyi seçtiniz. Süre bitince yeniden açılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You chose to block this app during pomodoro work time. It opens again when the time is up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben diese App für die Pomodoro-Arbeitszeit gesperrt. Nach Ablauf der Zeit können Sie sie wieder öffnen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tətbiqi pomodoro iş vaxtında bloklamağı seçdiniz. Vaxt bitəndə yenidən açılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخترت حظر هذا التطبيق أثناء وقت عمل البومودورو. يُفتح مجددًا عند انتهاء الوقت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda memilih memblokir aplikasi ini selama waktu kerja pomodoro. Aplikasi bisa dibuka lagi saat waktu habis."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے پومودورو کے کام کے دوران یہ ایپ بلاک کرنا چنا ہے۔ وقت ختم ہونے پر یہ دوبارہ کھلے گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما انتخاب کرده‌اید این برنامه در زمان کار پومودورو مسدود شود. با پایان زمان دوباره باز می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez choisi de bloquer cette app pendant le travail pomodoro. Elle sera de nouveau accessible une fois le temps écoulé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы решили блокировать это приложение во время работы помидора. Оно снова откроется, когда время выйдет."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポモドーロの作業時間中、このアプリをブロックするよう選びました。時間が終わるとまた開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뽀모도로 작업 시간에 이 앱을 차단하도록 골랐습니다. 시간이 끝나면 다시 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您选择在番茄钟工作时段屏蔽这个应用。时间到后即可再次打开。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinili mong harangin ang app na ito sa pomodoro work time. Bubukas itong muli kapag tapos na ang oras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเลือกบล็อกแอปนี้ในช่วงทำงานโพโมโดโร จะเปิดได้อีกเมื่อหมดเวลา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eligió bloquear esta app durante el tiempo de trabajo del pomodoro. Se vuelve a abrir cuando se acabe el tiempo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você escolheu bloquear este app durante o tempo de trabalho do pomodoro. Ele abre de novo quando o tempo acabar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने पोमोडोरो के काम के समय यह ऐप ब्लॉक करना चुना है। समय पूरा होने पर यह फिर खुलेगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পোমোডোরোর কাজের সময়ে আপনি এই অ্যাপটি ব্লক করা বেছে নিয়েছেন। সময় শেষ হলে এটি আবার খোলে।"
          }
        }
      }
    },
