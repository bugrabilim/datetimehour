    "hijri.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hicri tarih Diyanet takvimine göredir; başka ülkelerde ay başı bir gün farklı olabilir. Gün, akşam değil gece yarısı değişir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Hijri date follows Türkiye's Diyanet calendar; in other countries a month may start a day earlier or later. The day changes at midnight, not at sunset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hidschri-Datum folgt dem Kalender des türkischen Diyanet; in anderen Ländern kann ein Monat einen Tag früher oder später beginnen. Der Tag wechselt um Mitternacht, nicht bei Sonnenuntergang."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hicri tarix Türkiyə Diyanətinin təqviminə görədir; başqa ölkələrdə ay bir gün tez və ya gec başlaya bilər. Gün axşam deyil, gecə yarısı dəyişir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ الهجري وفق تقويم رئاسة الشؤون الدينية التركية؛ وقد يبدأ الشهر في بلدان أخرى قبل يوم أو بعده. يتغير اليوم عند منتصف الليل لا عند الغروب."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal Hijriah mengikuti kalender Diyanet Turki; di negara lain awal bulan bisa sehari lebih awal atau lebih lambat. Hari berganti pada tengah malam, bukan saat matahari terbenam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہجری تاریخ ترکی کی دیانت کے کیلنڈر کے مطابق ہے؛ دوسرے ممالک میں مہینہ ایک دن پہلے یا بعد شروع ہو سکتا ہے۔ دن آدھی رات کو بدلتا ہے، غروب پر نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ قمری از تقویم دیانت ترکیه پیروی می‌کند؛ در کشورهای دیگر ممکن است ماه یک روز زودتر یا دیرتر آغاز شود. روز در نیمه‌شب عوض می‌شود، نه هنگام غروب."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date hégirienne suit le calendrier de la Diyanet de Turquie ; dans d’autres pays, un mois peut commencer un jour plus tôt ou plus tard. Le jour change à minuit, pas au coucher du soleil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата по хиджре дана по календарю Diyanet (Турция); в других странах месяц может начаться на день раньше или позже. День сменяется в полночь, а не на закате."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒジュラ暦の日付はトルコのディヤーネットの暦に従います。他の国では月の始まりが1日前後することがあります。日付は日没ではなく午前0時に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "히즈라력 날짜는 튀르키예 디야넷 달력을 따릅니다. 다른 나라에서는 달의 시작이 하루 이르거나 늦을 수 있습니다. 날짜는 해 질 녘이 아니라 자정에 바뀝니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伊斯兰历日期依据土耳其迪亚内特的历法；在其他国家，月份可能提前或推迟一天开始。日期在午夜而非日落时更换。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumusunod ang petsang Hijri sa kalendaryo ng Diyanet ng Türkiye; sa ibang bansa, maaaring magsimula ang buwan nang isang araw na mas maaga o mas huli. Nagbabago ang araw sa hatinggabi, hindi sa paglubog ng araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ฮิจเราะห์เป็นไปตามปฏิทินดียาเนตของตุรกี ในประเทศอื่นเดือนอาจเริ่มเร็วหรือช้ากว่าหนึ่งวัน วันที่เปลี่ยนตอนเที่ยงคืน ไม่ใช่ตอนดวงอาทิตย์ตก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de la Hégira sigue el calendario de Diyanet de Turquía; en otros países un mes puede empezar un día antes o después. El día cambia a medianoche, no al ponerse el sol."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A data da Hégira segue o calendário da Diyanet da Turquia; em outros países um mês pode começar um dia antes ou depois. O dia muda à meia-noite, não ao pôr do sol."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हिजरी तारीख तुर्किये के दियानत कैलेंडर पर चलती है; दूसरे देशों में महीना एक दिन पहले या बाद में शुरू हो सकता है। दिन आधी रात को बदलता है, सूर्यास्त पर नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হিজরি তারিখ তুরস্কের দিয়ানেতের ক্যালেন্ডার অনুসরণ করে; অন্য দেশে মাস এক দিন আগে বা পরে শুরু হতে পারে। দিন সূর্যাস্তে নয়, মধ্যরাতে বদলায়।"
          }
        }
      }
    },
