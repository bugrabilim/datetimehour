    "qibla.mosquesError": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Camiler yüklenemedi. İnternet bağlantısını denetleyip yeniden deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load mosques. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Moscheen konnten nicht geladen werden. Prüfen Sie die Verbindung und versuchen Sie es erneut."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məscidlər yüklənmədi. İnternet bağlantısını yoxlayıb yenidən cəhd edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل المساجد. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masjid tidak dapat dimuat. Periksa koneksi Anda dan coba lagi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مساجد لوڈ نہیں ہو سکیں۔ کنکشن چیک کر کے دوبارہ کوشش کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسجدها بارگذاری نشدند. اتصال را بررسی کنید و دوباره بکوشید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les mosquées. Vérifiez votre connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить мечети. Проверьте подключение и попробуйте снова."
          }
        }
      }
    },
    "qibla.mosquesNear": {
      "extractionState": "manual",
      "localizations": {
