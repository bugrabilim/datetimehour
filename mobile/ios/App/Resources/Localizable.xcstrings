    "energy.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkış saatinize göre yaklaşıktır; kişiden kişiye değişir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate, based on your wake time; it varies from person to person."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungefähr, nach Ihrer Aufstehzeit; von Mensch zu Mensch verschieden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyanma vaxtınıza görə təxminidir; insandan insana dəyişir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقريبي حسب وقت استيقاظك ويختلف من شخص لآخر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkiraan berdasarkan waktu bangun Anda; berbeda tiap orang."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے جاگنے کے وقت کے مطابق اندازہ؛ ہر شخص میں مختلف۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تقریبی و بر پایه ساعت بیداری شماست و از فردی به فرد دیگر فرق دارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximatif, selon votre heure de lever ; varie d’une personne à l’autre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизительно, по времени подъёма; у всех по-разному."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起床時刻からの目安で、人によって異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기상 시각에 따른 대략적인 값이며 사람마다 다릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据起床时间估算，因人而异。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tantiya batay sa oras ng gising mo; iba-iba sa bawat tao."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประมาณตามเวลาตื่นของคุณ แตกต่างกันในแต่ละคน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproximado, según su hora de despertar; varía de una persona a otra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproximado, com base no seu horário de acordar; varia de pessoa para pessoa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जागने के समय पर आधारित अनुमान; यह हर व्यक्ति में अलग होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আনুমানিক, আপনার জাগার সময়ের ভিত্তিতে; মানুষভেদে আলাদা হয়।"
          }
        }
      }
    },
