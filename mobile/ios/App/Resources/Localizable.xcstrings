    "track.inline": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakitler ekranında \"kıldım\" işareti"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Prayed\" check on the prayer times screen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Gebetet“-Haken auf dem Gebetszeiten-Bildschirm"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtlar ekranında \"qıldım\" işarəsi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علامة \"صلّيت\" في شاشة المواقيت"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda \"sudah salat\" di layar waktu salat"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات کی اسکرین پر \"پڑھ لی\" کا نشان"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "علامت «خواندم» در صفحه اوقات"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coche « prié » sur l’écran des horaires"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметка «совершил» на экране времени намаза"
