            "value": "%1$@: o Sol fica abaixo do horizonte durante o eclipse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: ग्रहण के दौरान सूरज क्षितिज से नीचे है।"
