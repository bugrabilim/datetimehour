    "countdowns.empty": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz geri sayım yok. Doğum günü, tatil, sınav… eklemek için + düğmesine dokunun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No countdowns yet. Tap + to add a birthday, holiday, exam…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Countdowns. Tippen Sie auf +, um Geburtstag, Urlaub, Prüfung … hinzuzufügen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ geri sayım yoxdur. Ad günü, tətil, imtahan… əlavə etmək üçün + düyməsinə toxunun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد عدّات تنازلية بعد. اضغط + لإضافة عيد ميلاد أو عطلة أو امتحان…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada hitung mundur. Ketuk + untuk menambah ulang tahun, liburan, ujian…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی الٹی گنتی نہیں۔ سالگرہ، چھٹی، امتحان… شامل کرنے کے لیے + پر ٹیپ کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز شمارش معکوسی نیست. برای افزودن تولد، تعطیلات، امتحان… روی + بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte à rebours. Touchez + pour ajouter un anniversaire, des vacances, un examen…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратных отсчётов пока нет. Нажмите +, чтобы добавить день рождения, отпуск, экзамен…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだカウントダウンはありません。＋をタップして誕生日、休日、試験などを追加しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 카운트다운이 없습니다. +를 눌러 생일, 휴일, 시험 등을 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有倒计时。轻点+添加生日、假日、考试……"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang countdown. I-tap ang + para magdagdag ng kaarawan, holiday, pagsusulit…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีการนับถอยหลัง แตะ + เพื่อเพิ่มวันเกิด วันหยุด การสอบ…"
          }
        }
      }
    },
