            "state": "translated",
            "value": "No mosques found nearby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Moscheen in der Nähe gefunden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaxınlıqda məscid tapılmadı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على مساجد قريبة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan masjid di dekat sini."
          }
        },
