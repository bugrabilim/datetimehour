        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাসের সুলতান আপনার ঘরে শান্তি বয়ে আনুক।"
          }
        }
      }
    },
    "greet.m.ramadan.3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruçlarınız ve dualarınız kabul olsun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your fasts and prayers be accepted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mögen Ihr Fasten und Ihre Gebete angenommen werden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Orucunuz və dualarınız qəbul olsun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقبّل الله صيامكم ودعاءكم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga puasa dan doa Anda diterima."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے روزے اور دعائیں قبول ہوں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روزه‌ها و دعاهایتان قبول باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que vos jeûnes et vos prières soient acceptés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть ваш пост и молитвы будут приняты."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食と祈りが受け入れられますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금식과 기도가 받아들여지길 바랍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "愿您的斋戒和祈祷被接受。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawa'y tanggapin ang inyong pag-aayuno at mga dalangin."
