    "float.noteIos": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat, resim içinde resim penceresinde başka uygulamaların üstünde durur; pencereyi sürükleyip küçültebilir ya da kenara itebilirsiniz. Ses çalmaz, internet gerekmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock stays above other apps in a picture-in-picture window; drag, resize or tuck it to the side. It plays no sound and needs no internet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr bleibt in einem Bild-in-Bild-Fenster über anderen Apps; ziehen, verkleinern oder an den Rand schieben. Kein Ton, kein Internet nötig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat şəkil içində şəkil pəncərəsində digər tətbiqlərin üstündə qalır; pəncərəni sürüşdürə, kiçildə və ya kənara itələyə bilərsiniz. Səs çalmır, internet lazım deyil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الساعة فوق التطبيقات الأخرى في نافذة صورة داخل صورة؛ يمكنك سحبها أو تصغيرها أو دفعها إلى الحافة. لا تُصدر صوتًا ولا تحتاج إلى الإنترنت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tetap di atas aplikasi lain dalam jendela gambar-dalam-gambar; seret, ubah ukuran, atau sisihkan ke samping. Tidak memutar suara dan tidak perlu internet."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی تصویر میں تصویر کی کھڑکی میں دوسری ایپس کے اوپر رہتی ہے؛ اسے گھسیٹیں، سائز بدلیں یا کنارے کر دیں۔ یہ کوئی آواز نہیں بجاتی اور انٹرنیٹ نہیں چاہیے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت در پنجرهٔ تصویر در تصویر بالای برنامه‌های دیگر می‌ماند؛ آن را بکشید، اندازه‌اش را تغییر دهید یا کنار بگذارید. صدایی پخش نمی‌کند و اینترنت نمی‌خواهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’horloge reste au-dessus des autres apps dans une fenêtre d’image dans l’image ; faites-la glisser, redimensionnez-la ou rangez-la sur le côté. Elle ne joue aucun son et n’a pas besoin d’Internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы остаются поверх других приложений в окне «картинка в картинке»; перетаскивайте, меняйте размер или убирайте к краю. Они не воспроизводят звук и не требуют интернета."
          }
        }
      }
    },
    "float.noteAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat, başka uygulamaların üstünde küçük bir pencerede durur; sürükleyerek taşıyın, bildirimden kapatın. İlk açışta \"Diğer uygulamaların üzerinde göster\" izni istenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock stays above other apps in a small window; drag it to move it and close it from the notification. The first time, the \"Display over other apps\" permission is requested."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr bleibt in einem kleinen Fenster über anderen Apps; zum Verschieben ziehen, über die Benachrichtigung schließen. Beim ersten Mal wird die Berechtigung „Über anderen Apps einblenden“ angefragt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat digər tətbiqlərin üstündə kiçik pəncərədə qalır; sürüşdürərək daşıyın, bildirişdən bağlayın. İlk dəfə \"Digər tətbiqlərin üzərində göstər\" icazəsi istənilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الساعة فوق التطبيقات الأخرى في نافذة صغيرة؛ اسحبها لتحريكها وأغلقها من الإشعار. في المرة الأولى يُطلب إذن «العرض فوق التطبيقات الأخرى»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tetap di atas aplikasi lain dalam jendela kecil; seret untuk memindahkannya dan tutup dari notifikasi. Pertama kali, izin \"Tampilkan di atas aplikasi lain\" diminta."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی ایک چھوٹی کھڑکی میں دوسری ایپس کے اوپر رہتی ہے؛ ہلانے کے لیے گھسیٹیں اور اطلاع سے بند کریں۔ پہلی بار «دوسری ایپس کے اوپر دکھائیں» کی اجازت مانگی جاتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت در پنجره‌ای کوچک بالای برنامه‌های دیگر می‌ماند؛ برای جابه‌جایی بکشیدش و از اعلان ببندیدش. بار نخست اجازهٔ «نمایش روی برنامه‌های دیگر» خواسته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’horloge reste au-dessus des autres apps dans une petite fenêtre ; faites-la glisser pour la déplacer et fermez-la depuis la notification. La première fois, l’autorisation « Afficher par-dessus les autres applis » est demandée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы остаются поверх других приложений в маленьком окне; перетащите, чтобы переместить, и закройте из уведомления. В первый раз запрашивается разрешение «Поверх других приложений»."
          }
        }
      }
    },
