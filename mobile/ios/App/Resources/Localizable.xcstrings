    "greet.m.ramadan.2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "On bir ayın sultanı evinize huzur getirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May the sultan of months bring peace to your home."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möge der Sultan der Monate Frieden in Ihr Zuhause bringen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "On bir ayın sultanı evinizə dinclik gətirsin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جعل الله سيّد الشهور سكينةً لبيتكم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga penghulu segala bulan membawa damai ke rumah Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مہینوں کا سردار آپ کے گھر سکون لائے۔"
