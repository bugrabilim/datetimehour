    "greet.shareText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Bu kartı Saat Tarih uygulamasıyla hazırladım: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · I made this card with the Saat Tarih app: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Diese Karte habe ich mit der App Saat Tarih gestaltet: %2$@"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Bu kartı Saat Tarix tətbiqi ilə hazırladım: %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · صممت هذه البطاقة بتطبيق الوقت والتاريخ: %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Kartu ini saya buat dengan aplikasi Saat Tarih: %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · یہ کارڈ میں نے وقت اور تاریخ ایپ سے بنایا: %2$@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · این کارت را با برنامهٔ ساعت و تاریخ ساختم: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · J'ai créé cette carte avec l'app Saat Tarih : %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Открытка сделана в приложении Saat Tarih: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · このカードは「時刻と日付」アプリで作りました: %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · 이 카드는 '시간과 날짜' 앱으로 만들었어요: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · 这张贺卡由“时间与日期”应用制作：%2$@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Ginawa ko ang card na ito gamit ang Saat Tarih app: %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · การ์ดนี้ทำด้วยแอปเวลาและวันที่: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Hice esta tarjeta con la app Saat Tarih: %2$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Fiz este cartão com o app Saat Tarih: %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · यह कार्ड मैंने समय और तारीख ऐप से बनाया: %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · এই কার্ডটি আমি সময় ও তারিখ অ্যাপ দিয়ে বানিয়েছি: %2$@"
          }
        }
      }
    },
