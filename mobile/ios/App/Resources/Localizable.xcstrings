    "google.ready": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim izni açık: Google etkinlikleriniz takvimde görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is on: your Google events appear in the calendar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderzugriff ist aktiv: Ihre Google-Termine erscheinen im Kalender."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təqvim icazəsi açıqdır: Google tədbirləriniz təqvimdə görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى التقويم مفعّل: تظهر أحداث Google في التقويم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kalender aktif: acara Google Anda muncul di kalender."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر تک رسائی آن ہے: آپ کی گوگل تقریبات کیلنڈر میں دکھتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به تقویم روشن است: رویدادهای گوگل شما در تقویم دیده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier est activé : vos événements Google apparaissent dans le calendrier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю включён: события Google показываются в календаре."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスがオンです。Googleの予定がカレンダーに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력 접근이 켜져 있습니다. Google 일정이 달력에 나타납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历访问已开启：您的Google日程会显示在日历中。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-on ang access sa kalendaryo: lumalabas sa kalendaryo ang iyong mga Google event."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงปฏิทินเปิดอยู่: กิจกรรม Google ของคุณแสดงในปฏิทิน"
          }
        }
      }
    },
    "google.denied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim izni kapalı. Ayarlar'da bu uygulamanın Takvimler iznini “Tam Erişim” yapın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is off. In Settings, set this app's Calendars permission to “Full Access”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderzugriff ist aus. Stellen Sie in den Einstellungen die Kalender-Berechtigung dieser App auf „Vollzugriff“."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təqvim icazəsi bağlıdır. Parametrlərdə bu tətbiqin Təqvimlər icazəsini “Tam giriş” edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى التقويم متوقف. في الإعدادات اجعل إذن التقويمات لهذا التطبيق «وصول كامل»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kalender nonaktif. Di Pengaturan, setel izin Kalender aplikasi ini ke \"Akses Penuh\"."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر تک رسائی بند ہے۔ ترتیبات میں اس ایپ کی کیلنڈرز اجازت «مکمل رسائی» پر کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به تقویم خاموش است. در تنظیمات، اجازهٔ تقویم این برنامه را روی «دسترسی کامل» بگذارید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier est désactivé. Dans Réglages, mettez l’autorisation Calendriers de cette app sur « Accès complet »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю выключен. В Настройках установите для этого приложения доступ к календарям «Полный доступ»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスがオフです。設定でこのアプリのカレンダーの権限を「フルアクセス」にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력 접근이 꺼져 있습니다. 설정에서 이 앱의 캘린더 권한을 \"전체 접근\"으로 바꾸세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历访问已关闭。请在设置中将此应用的日历权限设为“完全访问”。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang access sa kalendaryo. Sa Settings, gawing “Full Access” ang pahintulot sa Calendars ng app na ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงปฏิทินปิดอยู่ ในการตั้งค่า ให้ตั้งสิทธิ์ปฏิทินของแอปนี้เป็น “การเข้าถึงทั้งหมด”"
          }
        }
      }
    },
    "google.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni etkinlik eklerken düzenleyicide Google takviminizi seçerseniz etkinlik Google Takvimi'ne de kaydedilir. Outlook ve diğer hesaplar da aynı yolla eklenebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you add an event, pick your Google calendar in the editor and it is saved to Google Calendar too. Outlook and other accounts can be added the same way."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie beim Hinzufügen eines Termins Ihren Google-Kalender wählen, wird er auch im Google Kalender gespeichert. Outlook und andere Konten lassen sich genauso hinzufügen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni tədbir əlavə edərkən redaktorda Google təqviminizi seçsəniz, tədbir Google Təqviminə də yazılır. Outlook və digər hesablar da eyni yolla əlavə edilə bilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إضافة حدث، اختر تقويم Google في المحرر فيُحفظ في تقويم Google أيضًا. يمكن إضافة Outlook والحسابات الأخرى بالطريقة نفسها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat menambah acara, pilih kalender Google Anda di editor dan acara juga tersimpan di Google Kalender. Outlook dan akun lain dapat ditambahkan dengan cara yang sama."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تقریب شامل کرتے وقت ایڈیٹر میں اپنا گوگل کیلنڈر منتخب کریں، تو وہ گوگل کیلنڈر میں بھی محفوظ ہو جائے گی۔ Outlook اور دوسرے اکاؤنٹس بھی اسی طرح شامل ہوتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام افزودن رویداد، تقویم گوگل خود را در ویرایشگر برگزینید تا در تقویم گوگل هم ذخیره شود. Outlook و حساب‌های دیگر هم به همین شکل افزوده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous ajoutez un événement, choisissez votre calendrier Google dans l’éditeur : il est aussi enregistré dans Google Agenda. Outlook et d’autres comptes s’ajoutent de la même façon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При добавлении события выберите в редакторе свой календарь Google — оно сохранится и в Google Календаре. Outlook и другие аккаунты добавляются так же."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を追加するときにエディタでGoogleカレンダーを選ぶと、Googleカレンダーにも保存されます。Outlookなど他のアカウントも同じ方法で追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정을 추가할 때 편집기에서 Google 캘린더를 고르면 Google 캘린더에도 저장됩니다. Outlook 등 다른 계정도 같은 방법으로 추가할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加日程时，在编辑器中选择您的Google日历，日程也会保存到Google日历。Outlook等其他账户也可以用同样方法添加。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag nagdagdag ka ng event, piliin ang iyong Google calendar sa editor at mase-save din ito sa Google Calendar. Maaaring idagdag sa parehong paraan ang Outlook at iba pang account."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเพิ่มกิจกรรม ให้เลือก Google ปฏิทินในตัวแก้ไข แล้วจะบันทึกลง Google ปฏิทินด้วย บัญชี Outlook และอื่น ๆ เพิ่มได้ด้วยวิธีเดียวกัน"
          }
        }
      }
    },
    "google.android.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android telefonlarda Google hesabı genellikle zaten eklidir ve Google Takvimi'ndeki etkinlikler telefonun takvimine gelir. Uygulama Google'a doğrudan bağlanmaz ve şifrenizi görmez; etkinlikleri izninizle telefonun takviminden okur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Android phones your Google account is usually already added, and Google Calendar events sync to the phone's calendar. The app never connects to Google directly or sees your password; it reads events from the phone's calendar with your permission."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Android-Telefonen ist Ihr Google-Konto meist schon eingerichtet, und Termine aus Google Kalender werden mit dem Telefonkalender synchronisiert. Die App verbindet sich nie direkt mit Google und sieht Ihr Passwort nicht; sie liest Termine mit Ihrer Erlaubnis aus dem Telefonkalender."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Android telefonlarda Google hesabı adətən artıq əlavə olunub və Google Təqvimindəki tədbirlər telefonun təqviminə gəlir. Tətbiq Google-a birbaşa qoşulmur və şifrənizi görmür; tədbirləri icazənizlə telefonun təqvimindən oxuyur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على هواتف أندرويد يكون حساب Google مضافًا عادةً، وتُزامَن أحداث تقويم Google مع تقويم الهاتف. لا يتصل التطبيق بـGoogle مباشرةً ولا يرى كلمة مرورك؛ بل يقرأ الأحداث من تقويم الهاتف بإذنك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di ponsel Android, akun Google biasanya sudah ditambahkan, dan acara Google Kalender tersinkron ke kalender ponsel. Aplikasi tidak pernah terhubung langsung ke Google atau melihat kata sandi Anda; aplikasi membaca acara dari kalender ponsel dengan izin Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اینڈرائیڈ فونز پر آپ کا گوگل اکاؤنٹ عموماً پہلے سے شامل ہوتا ہے، اور گوگل کیلنڈر کی تقریبات فون کے کیلنڈر سے ہم آہنگ ہوتی ہیں۔ ایپ کبھی براہِ راست گوگل سے نہیں جڑتی اور آپ کا پاس ورڈ نہیں دیکھتی؛ یہ آپ کی اجازت سے فون کے کیلنڈر سے تقریبات پڑھتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در گوشی‌های اندروید معمولاً حساب گوگل از پیش افزوده شده و رویدادهای تقویم گوگل با تقویم گوشی همگام می‌شوند. برنامه هرگز مستقیم به گوگل وصل نمی‌شود و رمز شما را نمی‌بیند؛ رویدادها را با اجازهٔ شما از تقویم گوشی می‌خواند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur Android, votre compte Google est généralement déjà ajouté et les événements Google Agenda sont synchronisés avec le calendrier du téléphone. L’app ne se connecte jamais directement à Google et ne voit pas votre mot de passe ; elle lit les événements du calendrier du téléphone avec votre autorisation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Android аккаунт Google обычно уже добавлен, и события Google Календаря синхронизируются с календарём телефона. Приложение никогда не подключается к Google напрямую и не видит ваш пароль; оно читает события из календаря телефона с вашего разрешения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AndroidスマホではふつうGoogleアカウントがすでに追加されており、Googleカレンダーの予定はスマホのカレンダーに同期されています。アプリがGoogleに直接接続したりパスワードを見たりすることはなく、許可を得てスマホのカレンダーから予定を読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 휴대폰에는 보통 Google 계정이 이미 추가되어 있고 Google 캘린더 일정이 휴대폰 달력과 동기화됩니다. 앱은 Google에 직접 연결하거나 비밀번호를 보지 않으며, 허락을 받아 휴대폰 달력에서 일정을 읽습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安卓手机通常已添加Google账户，Google日历的日程会同步到手机日历。应用从不直接连接Google或查看您的密码；经您允许后从手机日历读取日程。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa mga Android na telepono, karaniwang nakadagdag na ang iyong Google account, at naka-sync sa kalendaryo ng telepono ang mga event sa Google Calendar. Hindi kailanman direktang kumokonekta sa Google ang app o nakikita ang iyong password; binabasa nito ang mga event mula sa kalendaryo ng telepono nang may pahintulot mo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในโทรศัพท์ Android มักมีบัญชี Google อยู่แล้ว และกิจกรรมใน Google ปฏิทินซิงค์กับปฏิทินของโทรศัพท์ แอปไม่เชื่อมต่อกับ Google โดยตรงหรือเห็นรหัสผ่านของคุณ แต่อ่านกิจกรรมจากปฏิทินของโทรศัพท์เมื่อคุณอนุญาต"
          }
        }
      }
    },
    "google.android.step1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun Ayarlar uygulamasını açın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the phone's Settings app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die Einstellungen-App des Telefons."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun Parametrlər tətbiqini açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح تطبيق الإعدادات في الهاتف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka aplikasi Setelan di ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون کی ترتیبات ایپ کھولیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامهٔ تنظیمات گوشی را باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app Paramètres du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение «Настройки» на телефоне."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホの設定アプリを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰의 설정 앱을 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开手机的“设置”应用。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Settings app ng telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแอปการตั้งค่าของโทรศัพท์"
          }
        }
      }
    },
    "google.android.step2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplar (ya da Şifreler ve hesaplar) bölümüne girin; Google hesabınız yoksa Hesap ekle › Google ile giriş yapın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Accounts (or Passwords & accounts); if your Google account is not there, tap Add account › Google and sign in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie zu Konten (oder Passwörter & Konten); fehlt Ihr Google-Konto, tippen Sie auf Konto hinzufügen › Google und melden Sie sich an."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesablar (və ya Şifrələr və hesablar) bölməsinə keçin; Google hesabınız yoxdursa, Hesab əlavə et › Google ilə daxil olun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادخل إلى الحسابات (أو كلمات المرور والحسابات)؛ وإن لم يكن حساب Google موجودًا فاضغط إضافة حساب › Google وسجّل الدخول."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Akun (atau Sandi & akun); jika akun Google Anda tidak ada, ketuk Tambahkan akun › Google lalu masuk."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹس (یا پاس ورڈز اور اکاؤنٹس) میں جائیں؛ اگر آپ کا گوگل اکاؤنٹ وہاں نہیں تو اکاؤنٹ شامل کریں › Google پر ٹیپ کر کے سائن ان کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به حساب‌ها (یا گذرواژه‌ها و حساب‌ها) بروید؛ اگر حساب گوگل شما نیست، افزودن حساب › Google را بزنید و وارد شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans Comptes (ou Mots de passe et comptes) ; si votre compte Google n’y est pas, touchez Ajouter un compte › Google et connectez-vous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите в «Аккаунты» (или «Пароли и аккаунты»); если аккаунта Google там нет, нажмите «Добавить аккаунт» › Google и войдите."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント（またはパスワードとアカウント）へ進みます。Googleアカウントがなければ、アカウントを追加 › Google をタップしてサインインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정(또는 비밀번호 및 계정)으로 갑니다. Google 계정이 없으면 계정 추가 › Google을 눌러 로그인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往“账号”（或“密码和账号”）；如果没有Google账号，轻点 添加账号 › Google 并登录。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumunta sa Accounts (o Passwords & accounts); kung wala roon ang iyong Google account, i-tap ang Add account › Google at mag-sign in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปที่ บัญชี (หรือ รหัสผ่านและบัญชี) หากไม่มีบัญชี Google ให้แตะ เพิ่มบัญชี › Google แล้วลงชื่อเข้า"
          }
        }
      }
    },
    "google.android.step3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hesabınıza dokunun › Hesap senkronizasyonu'nda Takvim'in açık olduğundan emin olun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap your Google account › Account sync and make sure Calendar is on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf Ihr Google-Konto › Kontosynchronisierung und prüfen Sie, dass Kalender aktiviert ist."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hesabınıza toxunun › Hesab sinxronizasiyasında Təqvimin açıq olduğuna əmin olun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على حساب Google › مزامنة الحساب وتأكد من تفعيل التقويم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk akun Google Anda › Sinkronisasi akun dan pastikan Kalender aktif."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے گوگل اکاؤنٹ › اکاؤنٹ ہم آہنگی پر ٹیپ کریں اور یقینی بنائیں کہ کیلنڈر آن ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی حساب گوگل خود › همگام‌سازی حساب بزنید و مطمئن شوید تقویم روشن است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez votre compte Google › Synchronisation du compte et vérifiez qu’Agenda est activé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на аккаунт Google › «Синхронизация аккаунта» и убедитесь, что «Календарь» включён."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleアカウント › アカウントの同期 をタップし、カレンダーがオンになっていることを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 계정 › 계정 동기화를 누르고 캘린더가 켜져 있는지 확인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点您的Google账号 › 账号同步，确认“日历”已开启。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang iyong Google account › Account sync at tiyaking naka-on ang Calendar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะบัญชี Google › ซิงค์บัญชี และตรวจดูว่าปฏิทินเปิดอยู่"
          }
        }
      }
    },
    "google.android.step4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya dönüp “Telefonumdaki takvimleri göster” düğmesine dokunun ve izin verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back here, tap “Show my phone's calendars” and allow access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehren Sie hierher zurück, tippen Sie auf „Kalender meines Telefons anzeigen“ und erlauben Sie den Zugriff."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bura qayıdıb “Telefonumdakı təqvimləri göstər” düyməsinə toxunun və icazə verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارجع إلى هنا واضغط «عرض تقاويم هاتفي» واسمح بالوصول."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke sini, ketuk \"Tampilkan kalender ponsel saya\" dan izinkan akses."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں واپس آئیں، «میرے فون کے کیلنڈر دکھائیں» پر ٹیپ کریں اور رسائی کی اجازت دیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به اینجا برگردید، «نمایش تقویم‌های گوشی» را بزنید و دسترسی را مجاز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez ici, touchez « Afficher les calendriers du téléphone » et autorisez l’accès."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь сюда, нажмите «Показать календари телефона» и разрешите доступ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに戻り、「スマホのカレンダーを表示」をタップしてアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기로 돌아와 \"휴대폰의 달력 보기\"를 누르고 접근을 허용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到这里，轻点“显示手机上的日历”并允许访问。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumalik dito, i-tap ang “Ipakita ang mga kalendaryo ng aking telepono” at payagan ang access."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับมาที่นี่ แตะ “แสดงปฏิทินในโทรศัพท์” และอนุญาตการเข้าถึง"
          }
        }
      }
    },
    "google.android.denied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim izni kapalı. Ayarlar › Uygulamalar › Saat Tarih › İzinler'den Takvim'e izin verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is off. Allow Calendar in Settings › Apps › Time & Date › Permissions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalenderzugriff ist aus. Erlauben Sie Kalender unter Einstellungen › Apps › Uhr & Datum › Berechtigungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təqvim icazəsi bağlıdır. Parametrlər › Tətbiqlər › Saat Tarix › İcazələr bölməsində Təqvimə icazə verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن التقويم متوقف. اسمح بالتقويم من الإعدادات › التطبيقات › الوقت والتاريخ › الأذونات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kalender nonaktif. Izinkan Kalender di Setelan › Aplikasi › Jam & Tanggal › Izin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر تک رسائی بند ہے۔ ترتیبات › ایپس › وقت اور تاریخ › اجازتیں میں کیلنڈر کی اجازت دیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به تقویم خاموش است. تقویم را در تنظیمات › برنامه‌ها › ساعت و تاریخ › اجازه‌ها مجاز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier est désactivé. Autorisez Agenda dans Paramètres › Applications › Heure & Date › Autorisations."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю выключен. Разрешите «Календарь» в Настройках › Приложения › Время и дата › Разрешения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスがオフです。設定 › アプリ › 時刻と日付 › 権限 でカレンダーを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력 접근이 꺼져 있습니다. 설정 › 앱 › 시간과 날짜 › 권한에서 캘린더를 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历访问已关闭。请在 设置 › 应用 › 时间与日期 › 权限 中允许日历。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang access sa kalendaryo. Payagan ang Calendar sa Settings › Apps › Oras at Petsa › Permissions."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงปฏิทินปิดอยู่ อนุญาตปฏิทินได้ที่ การตั้งค่า › แอป › เวลาและวันที่ › สิทธิ์"
          }
        }
      }
    },
    "kids.progress": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevsim ne kadar ilerledi?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far along is the season?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit ist die Jahreszeit?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fəsil nə qədər irəliləyib?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم مضى من الفصل؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah sejauh mana musimnya?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موسم کتنا گزر چکا؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از فصل چقدر گذشته؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où en est la saison ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько прошло от сезона?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "季節はどこまで進んだ？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계절이 얼마나 지났을까?"
          }
        },
        "zh-Hans": {
