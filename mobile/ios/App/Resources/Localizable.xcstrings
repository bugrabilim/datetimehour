    "photoApp.how.dir": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yön, kuzeyden saat yönünde derece olarak verilir: 90° doğu, 180° güney, 270° batı. Güneş'in doğduğu ve battığı yer mevsime göre kayar; kuzey yarımkürede yazın kuzeye, kışın güneye yaklaşır. Kadrajı ve yerinizi önceden bu yöne göre seçebilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direction is given in degrees clockwise from north: 90° east, 180° south, 270° west. Where the sun rises and sets shifts with the seasons; in the northern hemisphere it moves north in summer and south in winter. You can plan your framing and spot in advance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Richtung wird in Grad im Uhrzeigersinn ab Norden angegeben: 90° Osten, 180° Süden, 270° Westen. Der Ort von Sonnenauf- und -untergang verschiebt sich mit den Jahreszeiten; auf der Nordhalbkugel wandert er im Sommer nach Norden und im Winter nach Süden. So können Sie Bildausschnitt und Standort im Voraus planen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstiqamət şimaldan saat əqrəbi istiqamətində dərəcə ilə verilir: 90° şərq, 180° cənub, 270° qərb. Günəşin doğduğu və batdığı yer fəsillərə görə dəyişir; şimal yarımkürəsində yayda şimala, qışda cənuba yaxınlaşır. Kadrı və yerinizi əvvəlcədən bu istiqamətə görə seçə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعطى الاتجاه بالدرجات باتجاه عقارب الساعة بدءًا من الشمال: 90° شرق، و180° جنوب، و270° غرب. يتغير موضع شروق الشمس وغروبها مع الفصول؛ ففي نصف الكرة الشمالي يميل شمالًا في الصيف وجنوبًا في الشتاء. يمكنك اختيار الإطار والمكان مسبقًا وفق هذا الاتجاه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arah dinyatakan dalam derajat searah jarum jam dari utara: 90° timur, 180° selatan, 270° barat. Titik terbit dan terbenam matahari bergeser menurut musim; di belahan bumi utara bergeser ke utara saat musim panas dan ke selatan saat musim dingin. Anda dapat merencanakan bingkai dan lokasi lebih awal."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سمت شمال سے گھڑی کی سوئیوں کی سمت میں ڈگری میں دی جاتی ہے: 90° مشرق، 180° جنوب، 270° مغرب۔ سورج کے طلوع اور غروب ہونے کی جگہ موسم کے ساتھ بدلتی ہے؛ شمالی نصف کرے میں گرمیوں میں شمال اور سردیوں میں جنوب کی طرف جاتی ہے۔ آپ فریم اور جگہ پہلے سے اسی سمت کے مطابق چن سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جهت به درجه و در جهت عقربه‌های ساعت از شمال داده می‌شود: 90° شرق، 180° جنوب، 270° غرب. جای طلوع و غروب خورشید با فصل‌ها جابه‌جا می‌شود؛ در نیمکرهٔ شمالی تابستان به سمت شمال و زمستان به سمت جنوب می‌رود. می‌توانید قاب و مکان را از پیش بر اساس این جهت انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La direction est donnée en degrés dans le sens horaire depuis le nord : 90° est, 180° sud, 270° ouest. Le point de lever et de coucher du soleil se déplace avec les saisons ; dans l'hémisphère nord, il remonte vers le nord en été et descend vers le sud en hiver. Vous pouvez prévoir votre cadrage et votre emplacement à l'avance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направление указано в градусах по часовой стрелке от севера: 90° — восток, 180° — юг, 270° — запад. Точки восхода и заката смещаются по сезонам: в Северном полушарии летом к северу, зимой к югу. Можно заранее выбрать кадр и место съёмки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方角は北から時計回りの角度で示します。90°が東、180°が南、270°が西です。日の出・日の入りの位置は季節によって変わり、北半球では夏は北寄り、冬は南寄りになります。構図や撮影場所を前もって決めるのに役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방향은 북쪽에서 시계 방향으로 잰 각도입니다. 90°는 동, 180°는 남, 270°는 서입니다. 해가 뜨고 지는 위치는 계절에 따라 달라져 북반구에서는 여름에 북쪽, 겨울에 남쪽으로 치우칩니다. 구도와 촬영 장소를 미리 정할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方向以从正北顺时针计算的角度表示：90°为东，180°为南，270°为西。日出日落的位置随季节变化，在北半球夏季偏北、冬季偏南。可据此提前选好构图和机位。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibinibigay ang direksiyon sa digri mula sa hilaga, pakanan: 90° silangan, 180° timog, 270° kanluran. Nagbabago ang lugar ng pagsikat at paglubog ng araw ayon sa panahon; sa hilagang hemispero, pahilaga ito sa tag-init at patimog sa taglamig. Maaari mong planuhin nang maaga ang kuha at puwesto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทิศบอกเป็นองศาตามเข็มนาฬิกาจากทิศเหนือ: 90° ตะวันออก 180° ใต้ 270° ตะวันตก ตำแหน่งที่ดวงอาทิตย์ขึ้นและตกเปลี่ยนไปตามฤดูกาล ในซีกโลกเหนือหน้าร้อนจะค่อนไปทางเหนือ หน้าหนาวค่อนไปทางใต้ จึงวางมุมกล้องและจุดถ่ายภาพไว้ล่วงหน้าได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección se da en grados en el sentido de las agujas del reloj desde el norte: 90° este, 180° sur, 270° oeste. El punto donde sale y se pone el sol cambia con las estaciones; en el hemisferio norte se desplaza al norte en verano y al sur en invierno. Puede planificar el encuadre y el lugar con antelación."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A direção é dada em graus no sentido horário a partir do norte: 90° leste, 180° sul, 270° oeste. O ponto onde o sol nasce e se põe muda com as estações; no hemisfério norte, vai para o norte no verão e para o sul no inverno. Você pode planejar o enquadramento e o local com antecedência."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिशा उत्तर से घड़ी की सुई की दिशा में डिग्री में दी जाती है: 90° पूर्व, 180° दक्षिण, 270° पश्चिम। सूरज के उगने और डूबने की जगह मौसम के साथ बदलती है; उत्तरी गोलार्ध में गर्मियों में उत्तर की ओर और सर्दियों में दक्षिण की ओर खिसकती है। आप फ़्रेम और जगह पहले से तय कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিক উত্তর থেকে ঘড়ির কাঁটার দিকে ডিগ্রিতে দেওয়া হয়: 90° পূর্ব, 180° দক্ষিণ, 270° পশ্চিম। সূর্য কোথায় ওঠে ও অস্ত যায় তা ঋতুর সঙ্গে সরে; উত্তর গোলার্ধে গ্রীষ্মে উত্তরে আর শীতে দক্ষিণে সরে। আপনি ফ্রেম ও জায়গা আগে থেকে পরিকল্পনা করতে পারেন।"
          }
        }
      }
    },
    "photoApp.how.privacy": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatler ve yönler telefonunuzda hesaplanır. Bulut tahmini için yalnız yaklaşık konum (iki ondalık, yaklaşık 1 km) Open-Meteo'ya gönderilir; bize hiçbir şey gelmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times and directions are calculated on your phone. For the cloud forecast only an approximate location (two decimals, about 1 km) is sent to Open-Meteo; nothing is sent to us."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiten und Richtungen werden auf Ihrem Telefon berechnet. Für die Wolkenprognose wird nur ein ungefährer Standort (zwei Nachkommastellen, etwa 1 km) an Open-Meteo gesendet; an uns wird nichts übertragen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatlar və istiqamətlər telefonunuzda hesablanır. Bulud proqnozu üçün yalnız təxmini yer (iki onluq, təxminən 1 km) Open-Meteo-ya göndərilir; bizə heç nə gəlmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب الأوقات والاتجاهات على هاتفك. ولتوقعات السحب يُرسل موقع تقريبي فقط (منزلتان عشريتان، نحو 1 كم) إلى Open-Meteo، ولا يصلنا شيء."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu dan arah dihitung di ponsel Anda. Untuk prakiraan awan, hanya lokasi perkiraan (dua desimal, sekitar 1 km) yang dikirim ke Open-Meteo; tidak ada yang sampai kepada kami."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات اور سمتیں آپ کے فون پر نکالی جاتی ہیں۔ بادلوں کی پیش گوئی کے لیے صرف تخمینی مقام (دو اعشاریہ، تقریباً 1 کلومیٹر) Open-Meteo کو بھیجا جاتا ہے؛ ہمارے پاس کچھ نہیں آتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان‌ها و جهت‌ها روی گوشی شما محاسبه می‌شوند. برای پیش‌بینی ابر فقط موقعیت تقریبی (دو رقم اعشار، حدود 1 کیلومتر) به Open-Meteo فرستاده می‌شود؛ چیزی به ما نمی‌رسد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures et les directions sont calculées sur votre téléphone. Pour la prévision des nuages, seule une position approximative (deux décimales, environ 1 km) est envoyée à Open-Meteo ; rien ne nous parvient."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время и направления вычисляются на вашем телефоне. Для прогноза облачности в Open-Meteo отправляется только примерное местоположение (два знака после запятой, около 1 км); к нам ничего не попадает."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻と方角はスマートフォンで計算します。雲の予報のため、おおよその位置（小数点以下2桁、約1 km）だけをOpen-Meteoに送ります。私たちには何も届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간과 방향은 휴대폰에서 계산합니다. 구름 예보를 위해 대략적인 위치(소수점 두 자리, 약 1 km)만 Open-Meteo에 보내며, 저희에게는 아무것도 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间和方向在您的手机上计算。为获取云量预报，只把大致位置（两位小数，约1公里）发送给 Open-Meteo；我们不会收到任何信息。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinakalkula sa iyong telepono ang mga oras at direksiyon. Para sa hula sa ulap, tinatayang lokasyon lang (dalawang decimal, mga 1 km) ang ipinapadala sa Open-Meteo; walang nakararating sa amin."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาและทิศคำนวณบนโทรศัพท์ของคุณ สำหรับพยากรณ์เมฆ จะส่งเพียงตำแหน่งโดยประมาณ (ทศนิยมสองตำแหน่ง ราว 1 กม.) ไปยัง Open-Meteo และไม่มีข้อมูลใดส่งมาถึงเรา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas y las direcciones se calculan en su teléfono. Para la previsión de nubes solo se envía a Open-Meteo una ubicación aproximada (dos decimales, unos 1 km); a nosotros no nos llega nada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os horários e as direções são calculados no seu telefone. Para a previsão de nuvens, só uma localização aproximada (duas casas decimais, cerca de 1 km) é enviada ao Open-Meteo; nada chega até nós."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय और दिशाएँ आपके फ़ोन पर गिनी जाती हैं। बादलों के पूर्वानुमान के लिए केवल अनुमानित स्थान (दो दशमलव, लगभग 1 किमी) Open-Meteo को भेजा जाता है; हमारे पास कुछ नहीं आता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময় ও দিক আপনার ফোনেই হিসাব করা হয়। মেঘের পূর্বাভাসের জন্য শুধু একটি আনুমানিক অবস্থান (দুই দশমিক, প্রায় 1 কিমি) Open-Meteo-তে পাঠানো হয়; আমাদের কাছে কিছু আসে না।"
          }
        }
      }
    },
    "photoApp.notify.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altın ve mavi saatten önce hatırlatır. Fotoğraf ışığını bir kez açtıktan sonra çalışır (Tümü › Fotoğraf ışığı)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminds you before golden and blue hour. Works once you have opened Photo light (All › Photo light)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert vor der goldenen und blauen Stunde. Funktioniert, sobald Sie Fotolicht einmal geöffnet haben (Alle › Fotolicht)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qızıl və mavi saatdan əvvəl xatırladır. Foto işığını bir dəfə açdıqdan sonra işləyir (Hamısı › Foto işığı)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكّرك قبل الساعة الذهبية والزرقاء. يعمل بعد أن تفتح «ضوء التصوير» مرة واحدة (الكل › ضوء التصوير)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengingatkan sebelum jam emas dan jam biru. Aktif setelah Anda membuka Cahaya foto sekali (Semua › Cahaya foto)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سنہری اور نیلے وقت سے پہلے یاد دلاتا ہے۔ فوٹو کی روشنی ایک بار کھولنے کے بعد کام کرتا ہے (سب › فوٹو کی روشنی)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از ساعت طلایی و آبی یادآوری می‌کند. پس از یک بار باز کردن «نور عکاسی» کار می‌کند (همه › نور عکاسی)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous prévient avant l'heure dorée et l'heure bleue. Actif dès que vous avez ouvert Lumière photo une fois (Tout › Lumière photo)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминает перед золотым и синим часом. Работает после того, как вы один раз откроете «Свет для фото» (Все › Свет для фото)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴールデンアワーとブルーアワーの前にお知らせします。「撮影の光」を一度開くと有効になります（すべて › 撮影の光）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "골든아워와 블루아워 전에 알려 줍니다. '사진 빛'을 한 번 열면 작동합니다(전체 › 사진 빛)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在黄金时刻和蓝调时刻之前提醒。打开一次“摄影光线”后生效（全部 › 摄影光线）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagpapaalala bago ang golden hour at blue hour. Gagana kapag nabuksan mo na ang Liwanag sa litrato (Lahat › Liwanag sa litrato)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งเตือนก่อนช่วงแสงทองและช่วงแสงสีฟ้า ใช้งานได้หลังจากเปิดแสงถ่ายภาพหนึ่งครั้ง (ทั้งหมด › แสงถ่ายภาพ)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le avisa antes de la hora dorada y la hora azul. Funciona después de abrir Luz para fotos una vez (Todo › Luz para fotos)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa antes da hora dourada e da hora azul. Funciona depois que você abrir Luz para fotos uma vez (Tudo › Luz para fotos)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनहरे और नीले घंटे से पहले याद दिलाता है। फ़ोटो की रोशनी एक बार खोलने के बाद काम करता है (सब › फ़ोटो की रोशनी)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সোনালি ও নীল সময়ের আগে মনে করিয়ে দেয়। ছবির আলো একবার খোলার পর কাজ করে (সব › ছবির আলো)।"
          }
        }
      }
    },
    "photoApp.n.amBlue": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah mavi saati %1$@ dakika sonra başlıyor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning blue hour starts in %1$@ min"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blaue Stunde am Morgen beginnt in %1$@ Min."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səhər mavi saatı %1$@ dəqiqəyə başlayır"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ الساعة الزرقاء صباحًا بعد %1$@ دقيقة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam biru pagi dimulai %1$@ menit lagi"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صبح کا نیلا وقت %1$@ منٹ میں شروع ہوگا"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت آبی صبح %1$@ دقیقه دیگر شروع می‌شود"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'heure bleue du matin commence dans %1$@ min"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Утренний синий час начнётся через %1$@ мин"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝のブルーアワーまであと%1$@分"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침 블루아워가 %1$@분 후 시작됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早晨蓝调时刻将在%1$@分钟后开始"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsisimula ang blue hour sa umaga sa loob ng %1$@ minuto"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงแสงสีฟ้ายามเช้าจะเริ่มในอีก %1$@ นาที"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora azul de la mañana empieza en %1$@ min"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A hora azul da manhã começa em %1$@ min"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुबह का नीला घंटा %1$@ मिनट में शुरू होगा"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সকালের নীল সময় %1$@ মিনিট পরে শুরু"
          }
        }
      }
    },
    "photoApp.n.amGold": {
      "extractionState": "manual",
      "localizations": {
