    "home.customizeNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatin altında görünecek alanları seçin; sağdaki tutamaçla sürükleyerek sıralayın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what appears under the clock; drag the handle on the right to reorder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, was unter der Uhr erscheint; ziehen Sie den Griff rechts, um die Reihenfolge zu ändern."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatın altında görünəcək sahələri seçin; sağdakı tutacaqla sürükləyərək sıralayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما يظهر أسفل الساعة، واسحب المقبض على اليمين لتغيير الترتيب."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apa yang tampil di bawah jam; seret pegangan di kanan untuk mengubah urutan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کریں کہ گھڑی کے نیچے کیا دکھے؛ ترتیب بدلنے کے لیے دائیں طرف کا ہینڈل گھسیٹیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب کنید زیر ساعت چه نمایش داده شود؛ برای تغییر ترتیب، دستگیرهٔ سمت راست را بکشید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ce qui s’affiche sous l’horloge ; faites glisser la poignée à droite pour réordonner."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, что показывать под часами; перетащите маркер справа, чтобы изменить порядок."
          }
        }
      }
    },
