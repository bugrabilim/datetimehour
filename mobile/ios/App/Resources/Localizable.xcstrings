        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe a changé ; les autres sessions ont été fermées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль изменён; другие сеансы завершены."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを変更しました。ほかのセッションは終了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호가 바뀌었고 다른 세션은 종료되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
