    "zakat.intro": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarları kendi para biriminizde girin. Nisab için gram altın fiyatını yazın; uygulama fiyatı internetten almaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter amounts in your own currency. Type the price of one gram of gold for the nisab; the app does not fetch prices online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Beträge in Ihrer Währung ein. Tragen Sie für den Nisab den Preis eines Gramms Gold ein; die App lädt keine Preise aus dem Internet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məbləğləri öz valyutanızda yazın. Nisab üçün qram qızılın qiymətini yazın; tətbiq qiyməti internetdən almır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل المبالغ بعملتك. اكتب سعر غرام الذهب لحساب النصاب؛ لا يجلب التطبيق الأسعار من الإنترنت."
          }
        }
      }
    },
