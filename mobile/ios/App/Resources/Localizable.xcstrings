    "account.resetDone": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreniz değişti; açık oturumlar kapatıldı. Yeni şifrenizle giriş yapabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password has changed and open sessions were signed out. You can sign in with your new password."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Passwort wurde geändert, offene Sitzungen wurden beendet. Sie können sich mit dem neuen Passwort anmelden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifrəniz dəyişdi; açıq sessiyalar bağlandı. Yeni şifrənizlə daxil ola bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت كلمة مرورك وأُغلقت الجلسات المفتوحة. يمكنك تسجيل الدخول بكلمة المرور الجديدة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi Anda telah diubah dan sesi yang terbuka ditutup. Anda dapat masuk dengan kata sandi baru."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا پاس ورڈ بدل گیا اور کھلے سیشن بند کر دیے گئے۔ آپ نئے پاس ورڈ سے سائن ان کر سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گذرواژهٔ شما عوض شد و نشست‌های باز بسته شدند. می‌توانید با گذرواژهٔ تازه وارد شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe a changé et les sessions ouvertes ont été fermées. Vous pouvez vous connecter avec le nouveau mot de passe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль изменён, открытые сеансы завершены. Можно войти с новым паролем."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを変更し、開いていたセッションを終了しました。新しいパスワードでログインできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호가 바뀌었고 열려 있던 세션이 종료되었습니다. 새 비밀번호로 로그인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码已更改，已打开的会话已退出。您可以用新密码登录。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Napalitan na ang inyong password at isinara ang mga bukas na session. Puwede na kayong mag-sign in gamit ang bagong password."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนรหัสผ่านแล้วและปิดเซสชันที่เปิดอยู่ คุณลงชื่อเข้าใช้ด้วยรหัสผ่านใหม่ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su contraseña cambió y se cerraron las sesiones abiertas. Puede iniciar sesión con la nueva contraseña."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua senha mudou e as sessões abertas foram encerradas. Você pode entrar com a nova senha."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पासवर्ड बदल गया और खुले सत्र बंद कर दिए गए। आप नए पासवर्ड से साइन इन कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পাসওয়ার্ড বদলেছে এবং খোলা সেশনগুলো বন্ধ করা হয়েছে। নতুন পাসওয়ার্ড দিয়ে সাইন ইন করতে পারেন।"
          }
        }
      }
    },
    "account.resetBad": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı geçersiz ya da süresi dolmuş. Giriş ekranındaki \"Şifremi unuttum\" ile yeni bağlantı isteyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link is invalid or has expired. Request a new one with \"Forgot password\" on the sign-in screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link ist ungültig oder abgelaufen. Fordern Sie auf der Anmeldeseite mit „Passwort vergessen“ einen neuen an."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Keçid etibarsızdır və ya vaxtı keçib. Giriş ekranında \"Şifrəmi unutdum\" ilə yeni keçid istəyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرابط غير صالح أو انتهت مدته. اطلب رابطًا جديدًا من «نسيت كلمة المرور» في شاشة الدخول."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan tidak valid atau sudah kedaluwarsa. Minta tautan baru melalui \"Lupa kata sandi\" di layar masuk."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لنک غلط ہے یا اس کی مدت ختم ہو گئی ہے۔ سائن ان اسکرین پر \"پاس ورڈ بھول گئے\" سے نیا لنک منگوائیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیوند نامعتبر است یا منقضی شده. از «گذرواژه را فراموش کرده‌ام» در صفحهٔ ورود پیوند تازه بخواهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien est invalide ou a expiré. Demandez-en un nouveau avec « Mot de passe oublié » sur l'écran de connexion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка недействительна или устарела. Запросите новую через «Забыли пароль» на экране входа."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクが無効か期限切れです。ログイン画面の「パスワードを忘れた」から新しいリンクを請求してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크가 유효하지 않거나 만료되었습니다. 로그인 화면의 '비밀번호 찾기'로 새 링크를 요청하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接无效或已过期。请在登录页面通过“忘记密码”申请新链接。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi wasto o expired na ang link. Humingi ng bago gamit ang \"Nakalimutan ang password\" sa sign-in screen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์ไม่ถูกต้องหรือหมดอายุ ขอลิงก์ใหม่ได้จาก \"ลืมรหัสผ่าน\" ที่หน้าลงชื่อเข้าใช้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace no es válido o ha caducado. Pida uno nuevo con «Olvidé mi contraseña» en la pantalla de inicio de sesión."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O link é inválido ou expirou. Peça um novo em \"Esqueci a senha\" na tela de entrada."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक अमान्य है या उसकी अवधि खत्म हो गई है। साइन इन स्क्रीन पर \"पासवर्ड भूल गए\" से नया लिंक माँगें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লিংকটি অবৈধ বা মেয়াদ শেষ। সাইন ইন স্ক্রিনে \"পাসওয়ার্ড ভুলে গেছি\" দিয়ে নতুন লিংক চান।"
          }
        }
      }
    },
    "account.verifiedOk": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta adresiniz doğrulandı. Artık giriş yapabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email address is verified. You can sign in now."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre E-Mail-Adresse ist bestätigt. Sie können sich jetzt anmelden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poçt ünvanınız təsdiqləndi. İndi daxil ola bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التحقق من بريدك الإلكتروني. يمكنك تسجيل الدخول الآن."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat email Anda telah diverifikasi. Sekarang Anda dapat masuk."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے ای میل پتے کی تصدیق ہو گئی۔ اب آپ سائن ان کر سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشانی ایمیل شما تأیید شد. اکنون می‌توانید وارد شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre adresse e-mail est vérifiée. Vous pouvez maintenant vous connecter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес электронной почты подтверждён. Теперь можно войти."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスを確認しました。ログインできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 주소가 인증되었습니다. 이제 로그인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的邮箱地址已验证。现在可以登录了。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-verify na ang inyong email address. Puwede na kayong mag-sign in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันอีเมลแล้ว ลงชื่อเข้าใช้ได้เลย"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su dirección de correo está verificada. Ya puede iniciar sesión."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu endereço de e-mail foi verificado. Agora você pode entrar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके ईमेल पते की पुष्टि हो गई। अब आप साइन इन कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ইমেইল ঠিকানা যাচাই হয়েছে। এখন সাইন ইন করতে পারেন।"
          }
        }
      }
    },
    "account.verifiedBumba": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu e-posta adresiyle başka bir Bumba ürününde üyeliğiniz var, bu yüzden burada ayrı hesap açılmadı. Kayıt ekranında e-postanızı yazıp \"Evet\"i seçerek Bumba üyeliğinizle giriş yapabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have a membership in another Bumba product with this email address, so no separate account was created here. On the sign-up screen, enter your email and choose \"Yes\" to sign in with your Bumba membership."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dieser E-Mail-Adresse sind Sie bereits in einem anderen Bumba-Produkt Mitglied, daher wurde hier kein eigenes Konto angelegt. Geben Sie auf der Registrierungsseite Ihre E-Mail ein und wählen Sie „Ja“, um sich mit Ihrer Bumba-Mitgliedschaft anzumelden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu e-poçt ünvanı ilə başqa bir Bumba məhsulunda üzvlüyünüz var, ona görə burada ayrıca hesab açılmadı. Qeydiyyat ekranında e-poçtunuzu yazıb \"Bəli\"ni seçərək Bumba üzvlüyünüzlə daxil ola bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك عضوية في منتج آخر من Bumba بهذا البريد، لذلك لم يُفتح هنا حساب منفصل. في شاشة الاشتراك اكتب بريدك واختر «نعم» لتسجيل الدخول بعضويتك في Bumba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah menjadi anggota di produk Bumba lain dengan alamat email ini, sehingga akun terpisah tidak dibuat di sini. Di layar pendaftaran, tulis email Anda dan pilih \"Ya\" untuk masuk dengan keanggotaan Bumba Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ای میل پتے سے آپ کسی اور Bumba پروڈکٹ کے رکن ہیں، اس لیے یہاں الگ اکاؤنٹ نہیں کھولا گیا۔ رکنیت کی اسکرین پر اپنی ای میل لکھ کر \"ہاں\" منتخب کریں اور اپنی Bumba رکنیت سے سائن ان کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با این نشانی ایمیل در محصول دیگری از Bumba عضو هستید، برای همین اینجا حساب جداگانه باز نشد. در صفحهٔ عضویت ایمیل خود را بنویسید و «بله» را برگزینید تا با عضویت Bumba وارد شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes déjà membre d'un autre produit Bumba avec cette adresse, aucun compte séparé n'a donc été créé ici. Sur l'écran d'inscription, saisissez votre e-mail et choisissez « Oui » pour vous connecter avec votre adhésion Bumba."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этим адресом у вас уже есть членство в другом продукте Bumba, поэтому отдельный аккаунт здесь не создан. На экране регистрации введите адрес и выберите «Да», чтобы войти с членством Bumba."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスでは別の Bumba 製品に会員登録があるため、ここでは別のアカウントは作成されませんでした。登録画面でメールアドレスを入力し「はい」を選ぶと、Bumba の会員情報でログインできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이메일 주소로 다른 Bumba 제품의 회원이므로 여기서 별도 계정이 만들어지지 않았습니다. 가입 화면에서 이메일을 입력하고 '예'를 선택하면 Bumba 회원 정보로 로그인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已用此邮箱地址在另一个 Bumba 产品中注册，因此这里没有另建账户。在注册页面输入邮箱并选择“是”，即可用 Bumba 会员身份登录。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May membership na kayo sa ibang produkto ng Bumba gamit ang email address na ito, kaya walang hiwalay na account na binuksan dito. Sa sign-up screen, isulat ang inyong email at piliin ang \"Oo\" para mag-sign in gamit ang inyong Bumba membership."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีเมลนี้เป็นสมาชิกในผลิตภัณฑ์อื่นของ Bumba อยู่แล้ว จึงไม่ได้สร้างบัญชีแยกที่นี่ ที่หน้าสมัครสมาชิก ให้กรอกอีเมลแล้วเลือก \"ใช่\" เพื่อลงชื่อเข้าใช้ด้วยสมาชิกภาพ Bumba"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya es miembro de otro producto de Bumba con esta dirección, por eso no se creó una cuenta aparte aquí. En la pantalla de registro escriba su correo y elija «Sí» para iniciar sesión con su membresía de Bumba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já é membro de outro produto Bumba com este endereço, por isso nenhuma conta separada foi aberta aqui. Na tela de cadastro, digite seu e-mail e escolha \"Sim\" para entrar com sua associação Bumba."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ईमेल पते से आप किसी दूसरे Bumba उत्पाद के सदस्य हैं, इसलिए यहाँ अलग खाता नहीं खोला गया। सदस्यता स्क्रीन पर अपना ईमेल लिखें और \"हाँ\" चुनें, फिर अपनी Bumba सदस्यता से साइन इन करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ইমেইল ঠিকানা দিয়ে আপনি অন্য একটি Bumba পণ্যের সদস্য, তাই এখানে আলাদা অ্যাকাউন্ট খোলা হয়নি। সদস্য হওয়ার স্ক্রিনে ইমেইল লিখে \"হ্যাঁ\" বেছে নিন এবং আপনার Bumba সদস্যপদ দিয়ে সাইন ইন করুন।"
          }
        }
      }
    },
    "account.verifiedStep": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişikliği onayladınız. Yeni adresinize doğrulama bağlantısı gönderdik."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You confirmed the change. We sent a verification link to your new address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben die Änderung bestätigt. Wir haben einen Bestätigungslink an Ihre neue Adresse gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəyişikliyi təsdiqlədiniz. Yeni ünvanınıza təsdiq keçidi göndərdik."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكدت التغيير. أرسلنا رابط تحقق إلى عنوانك الجديد."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah mengonfirmasi perubahan. Kami mengirim tautan verifikasi ke alamat baru Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے تبدیلی کی تصدیق کر دی۔ ہم نے آپ کے نئے پتے پر تصدیقی لنک بھیجا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییر را تأیید کردید. پیوند تأیید را به نشانی تازه‌تان فرستادیم."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez confirmé le changement. Nous avons envoyé un lien de vérification à votre nouvelle adresse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы подтвердили изменение. Мы отправили ссылку для подтверждения на новый адрес."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を承認しました。新しいアドレスに確認リンクを送りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경을 승인했습니다. 새 주소로 인증 링크를 보냈습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已确认更改。我们已向新地址发送验证链接。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinumpirma ninyo ang pagbabago. Nagpadala kami ng link sa beripikasyon sa bago ninyong address."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยืนยันการเปลี่ยนแปลงแล้ว เราส่งลิงก์ยืนยันไปยังที่อยู่ใหม่ของคุณ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmó el cambio. Enviamos un enlace de verificación a su nueva dirección."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você confirmou a alteração. Enviamos um link de verificação para o novo endereço."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने बदलाव की पुष्टि कर दी। हमने आपके नए पते पर पुष्टि लिंक भेजा है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি পরিবর্তন নিশ্চিত করেছেন। আপনার নতুন ঠিকানায় যাচাই লিংক পাঠিয়েছি।"
          }
        }
      }
    },
