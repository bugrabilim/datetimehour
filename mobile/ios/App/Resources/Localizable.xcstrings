    "tools.pomodoro.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro tekniği, 25 dakikalık odaklı çalışma ile 5 dakikalık kısa molaları art arda uygular; 4 turun ardından uzun mola verilir. Süreler değiştirilebilir, geçişlerde sesli uyarı çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pomodoro technique alternates 25 minutes of focused work with 5-minute short breaks, followed by a long break after 4 rounds. The times can be changed and a sound plays at each switch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Pomodoro-Technik wechseln sich 25 Minuten konzentrierte Arbeit und 5-minütige kurze Pausen ab; nach 4 Runden folgt eine lange Pause. Die Zeiten lassen sich ändern, und bei jedem Wechsel ertönt ein Ton."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro texnikası 25 dəqiqəlik diqqətli işi 5 dəqiqəlik qısa fasilələrlə növbələşdirir, 4 dövrdən sonra isə uzun fasilə verilir. Müddətləri dəyişmək olar və hər keçiddə səs çalınır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقوم تقنية بومودورو على التناوب بين 25 دقيقة من العمل المركّز واستراحات قصيرة مدتها 5 دقائق، تليها استراحة طويلة بعد 4 جولات. ويمكن تغيير المدد، ويُشغَّل صوت عند كل انتقال."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teknik Pomodoro menyelingi 25 menit kerja fokus dengan istirahat pendek 5 menit, lalu istirahat panjang setelah 4 putaran. Durasinya dapat diubah dan suara berbunyi di setiap pergantian."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پومودورو تکنیک 25 منٹ کے توجہ والے کام کو 5 منٹ کے مختصر وقفوں سے بدلتی ہے اور 4 راؤنڈ کے بعد لمبا وقفہ آتا ہے۔ اوقات بدلے جا سکتے ہیں اور ہر تبدیلی پر آواز بجتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روش پومودورو 25 دقیقه کار متمرکز را با استراحت‌های کوتاه 5 دقیقه‌ای جایگزین می‌کند و پس از 4 دور یک استراحت طولانی دارد. مدت‌ها قابل تغییرند و در هر جابه‌جایی صدایی پخش می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La technique Pomodoro alterne 25 minutes de travail concentré et des pauses courtes de 5 minutes, puis une longue pause après 4 tours. Les durées sont modifiables et un son retentit à chaque changement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Техника «Помидор» чередует 25 минут сосредоточенной работы с короткими перерывами по 5 минут, а после 4 раундов следует длинный перерыв. Время можно изменить, при каждой смене звучит сигнал."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポモドーロ・テクニックは、25分の集中作業と5分の短い休憩を交互に行い、4ラウンドごとに長い休憩をとる方法です。時間は変更でき、切り替えのたびに音が鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뽀모도로 기법은 25분 집중과 5분 짧은 휴식을 번갈아 하고, 4라운드 뒤에 긴 휴식을 취하는 방법입니다. 시간은 바꿀 수 있으며 전환할 때마다 소리가 납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄工作法让 25 分钟专注工作与 5 分钟短休息交替进行，4 轮之后进行一次长休息。时长可以更改，每次切换都会响起提示音。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinagsasalit-salit ng Pomodoro technique ang 25 minutong nakatutok na trabaho at 5-minutong maikling pahinga, at may mahabang pahinga pagkatapos ng 4 na round. Mapapalitan ang mga tagal at may tunog sa bawat pagpapalit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทคนิคโพโมโดโรสลับการทำงานอย่างจดจ่อ 25 นาทีกับการพักสั้น 5 นาที และพักยาวหลังครบ 4 รอบ เปลี่ยนระยะเวลาได้ และมีเสียงทุกครั้งที่เปลี่ยนช่วง"
          }
        }
      }
    },
