        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิงหาคม: สิงห์ (ราศีสิงห์) + อาคม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agosto debe su nombre al emperador romano Augusto."
