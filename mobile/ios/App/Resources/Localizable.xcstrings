    "nature.crescentLead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ için %2$@ yeni ayından sonraki akşamlar. Hesap Yallop (1997) ölçütüyle yapılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evenings after the new moon of %2$@ for %1$@, calculated with Yallop's (1997) criterion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abende nach dem Neumond vom %2$@ für %1$@, berechnet nach dem Kriterium von Yallop (1997)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ üçün %2$@ yeni ayından sonrakı axşamlar, Yallop (1997) meyarı ilə hesablanır."
