    "greet.bless.2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlık, huzur ve bereket hiç eksik olmasın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May health, peace and plenty never be lacking."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mögen Gesundheit, Frieden und Segen nie fehlen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlıq, dinclik və bərəkət əskik olmasın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حُرمتم الصحة والسكينة والبركة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga kesehatan, kedamaian, dan berkah selalu menyertai."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صحت، سکون اور برکت کبھی کم نہ ہو۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تندرستی، آرامش و برکت هیچ‌گاه کم نشود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que la santé, la paix et l'abondance ne vous manquent jamais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть здоровье, покой и достаток всегда будут с вами."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "健康と安らぎと恵みが絶えませんように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강과 평안과 풍요가 늘 함께하길 바랍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "愿健康、安宁与福祉常伴。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawa'y hindi kayo kulangin sa kalusugan, kapayapaan at biyaya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้สุขภาพ ความสงบ และความจำเริญอยู่กับคุณเสมอ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que nunca le falten salud, paz y abundancia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que nunca lhe faltem saúde, paz e fartura."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेहत, सुकून और बरकत कभी कम न हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুস্থতা, শান্তি ও প্রাচুর্যের কখনো অভাব না হোক।"
          }
        }
      }
    },
    "greet.bless.3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönlünüz ferah, yüzünüz güler olsun."
