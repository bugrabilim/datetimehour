          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan cuaca, kalender, jadwal salat, dan lainnya"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موسمی حال، کیلنڈر، اوقاتِ نماز اور مزید آن کریں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آب‌وهوا، تقویم، اوقات شرعی و موارد دیگر را روشن کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la météo, le calendrier, les heures de prière et plus encore"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите погоду, календарь, время намаза и другое"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気、カレンダー、礼拝時刻などをオンにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨, 달력, 기도 시간 등을 켜세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开天气、日历、礼拜时间等"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-on ang panahon, kalendaryo, oras ng dasal at iba pa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดสภาพอากาศ ปฏิทิน เวลาละหมาด และอื่น ๆ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active el tiempo, el calendario, los horarios de oración y más"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o clima, o calendário, os horários de oração e mais"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौसम, कैलेंडर, नमाज़ के समय और बहुत कुछ चालू करें"
          }
        },
        "bn": {
          "stringUnit": {
