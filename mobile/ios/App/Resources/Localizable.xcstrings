    "models.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı yer için üç hava modelinin günlük en yüksek ve en düşük sıcaklık ile yağış tahmini. Modeller ayrıştığında tahmin daha belirsizdir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily high, low and precipitation from three weather models for the same place. When they disagree, the forecast is less certain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tageshöchst- und -tiefstwerte sowie Niederschlag dreier Wettermodelle für denselben Ort. Weichen sie voneinander ab, ist die Vorhersage unsicherer."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyni yer üçün üç hava modelinin gündəlik ən yüksək, ən aşağı temperatur və yağıntı proqnozu. Modellər fərqlənəndə proqnoz daha qeyri-müəyyəndir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العظمى والصغرى والهطول اليومي من ثلاثة نماذج جوية للمكان نفسه. عندما تختلف، تكون التوقعات أقل يقينًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhu tertinggi, terendah, dan curah hujan harian dari tiga model cuaca untuk tempat yang sama. Jika berbeda, prakiraan kurang pasti."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ہی جگہ کے لیے تین موسمی ماڈلز کا روزانہ زیادہ، کم درجہ حرارت اور بارش۔ اختلاف ہو تو پیش گوئی کم یقینی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بیشینه، کمینه و بارش روزانه از سه مدل هواشناسی برای همان مکان. وقتی با هم اختلاف دارند، پیش‌بینی نامطمئن‌تر است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximales, minimales et précipitations quotidiennes de trois modèles pour le même lieu. Quand ils divergent, la prévision est moins sûre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневной максимум, минимум и осадки по трём моделям для одного места. Если они расходятся, прогноз менее надёжен."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ地点に対する3つの気象モデルの日最高・最低気温と降水量です。モデルが食い違うほど予報は不確かです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 장소에 대한 세 기상 모델의 일 최고·최저 기온과 강수량입니다. 모델이 다르면 예보가 덜 확실합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一地点三个天气模型的每日最高、最低气温和降水量。模型分歧越大，预报越不确定。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinakamataas, pinakamababa at ulan bawat araw mula sa tatlong modelo para sa iisang lugar. Kapag nagkakaiba, mas hindi tiyak ang taya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุณหภูมิสูงสุด ต่ำสุด และปริมาณฝนรายวันจากแบบจำลองสภาพอากาศสามแบบสำหรับที่เดียวกัน หากต่างกันมาก พยากรณ์จะไม่แน่นอน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Máxima, mínima y precipitación diarias de tres modelos meteorológicos para el mismo lugar. Cuando no coinciden, la previsión es menos segura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Máxima, mínima e precipitação diárias de três modelos meteorológicos para o mesmo local. Quando os modelos divergem, a previsão é mais incerta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही जगह के लिए तीन मौसम मॉडलों का रोज़ का अधिकतम व न्यूनतम तापमान और वर्षा का पूर्वानुमान। जब ये असहमत हों, तो पूर्वानुमान कम पक्का होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একই জায়গার জন্য তিনটি আবহাওয়া মডেলের দৈনিক সর্বোচ্চ, সর্বনিম্ন ও বৃষ্টিপাত। মডেলগুলো একমত না হলে পূর্বাভাস কম নিশ্চিত।"
          }
        }
      }
    },
