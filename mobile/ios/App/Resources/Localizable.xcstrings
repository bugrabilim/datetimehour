    "weather.error": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava durumu alınamadı. Bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not get the weather. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wetter konnte nicht abgerufen werden. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava məlumatı alına bilmədi. Bağlantınızı yoxlayıb yenidən cəhd edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الحصول على حالة الطقس. تحقّق من اتصالك وحاول مرة أخرى."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuaca tidak dapat diambil. Periksa koneksi Anda lalu coba lagi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موسمی حال حاصل نہیں ہو سکا۔ اپنا کنکشن چیک کر کے دوبارہ کوشش کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دریافت آب‌وهوا ممکن نشد. اتصال خود را بررسی کنید و دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’obtenir la météo. Vérifiez votre connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить погоду. Проверьте подключение и попробуйте снова."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気を取得できませんでした。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨를 가져오지 못했습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取天气。请检查网络连接后重试。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makuha ang lagay ng panahon. Tingnan ang iyong koneksyon at subukan muli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดึงข้อมูลสภาพอากาศไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener el tiempo. Revise su conexión y vuelva a intentarlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter a previsão do tempo. Verifique sua conexão e tente de novo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौसम की जानकारी नहीं मिल सकी। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
