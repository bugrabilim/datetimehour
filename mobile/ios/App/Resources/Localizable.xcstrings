    "sunpath.legend": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarı: bugün · turuncu: 21 Haziran · mavi: 21 Aralık. Ortası başınızın üstü, kenar ufuk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yellow: today · orange: 21 June · blue: 21 December. The centre is overhead, the edge is the horizon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelb: heute · Orange: 21. Juni · Blau: 21. Dezember. Mitte = Zenit, Rand = Horizont."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarı: bu gün · narıncı: 21 iyun · mavi: 21 dekabr. Mərkəz başınızın üstü, kənar üfüqdür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأصفر: اليوم · البرتقالي: 21 يونيو · الأزرق: 21 ديسمبر. المركز فوق رأسك والحافة هي الأفق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuning: hari ini · oranye: 21 Juni · biru: 21 Desember. Tengah = tepat di atas kepala, tepi = cakrawala."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پیلا: آج · نارنجی: 21 جون · نیلا: 21 دسمبر۔ مرکز سر کے اوپر، کنارہ افق ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زرد: امروز · نارنجی: 21 ژوئن · آبی: 21 دسامبر. مرکز بالای سر و لبه افق است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaune : aujourd'hui · orange : 21 juin · bleu : 21 décembre. Le centre est le zénith, le bord l'horizon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жёлтый — сегодня, оранжевый — 21 июня, синий — 21 декабря. Центр — зенит, край — горизонт."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黄：今日・橙：6月21日・青：12月21日。中心が天頂、外周が地平線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노랑: 오늘 · 주황: 6월 21일 · 파랑: 12월 21일. 가운데는 머리 위, 가장자리는 지평선."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黄色：今天 · 橙色：6月21日 · 蓝色：12月21日。中心为天顶，边缘为地平线。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilaw: ngayon · kahel: Hunyo 21 · asul: Disyembre 21. Ang gitna ay tuktok, ang gilid ay abot-tanaw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหลือง: วันนี้ · ส้ม: 21 มิ.ย. · น้ำเงิน: 21 ธ.ค. กลางคือเหนือศีรษะ ขอบคือขอบฟ้า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amarillo: hoy · naranja: 21 de junio · azul: 21 de diciembre. El centro está sobre su cabeza y el borde es el horizonte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Amarelo: hoje · laranja: 21 de junho · azul: 21 de dezembro. O centro fica acima da sua cabeça e a borda é o horizonte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीला: आज · नारंगी: 21 जून · नीला: 21 दिसंबर। केंद्र सिर के ठीक ऊपर, किनारा क्षितिज है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হলুদ: আজ · কমলা: 21 জুন · নীল: 21 ডিসেম্বর। কেন্দ্র মাথার ওপর, কিনারা দিগন্ত।"
          }
        }
      }
    },
