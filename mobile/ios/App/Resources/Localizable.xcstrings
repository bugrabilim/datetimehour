        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Октябрь — от латинского octo, «восемь»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "神無月（かんなづき）：「無」は「の」で「神の月」。神々が出雲に集まるという俗説もあります。"
          }
        },
        "ko": {
          "stringUnit": {
