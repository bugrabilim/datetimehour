    "intent.timer.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilen dakika için adlı bir zamanlayıcı başlatır; bitince alarm çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a named timer for the given minutes; an alarm rings when it ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet einen benannten Timer für die angegebenen Minuten; am Ende klingelt ein Alarm."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilən dəqiqə üçün adlı taymer başladır; bitəndə zəng çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ مؤقتًا مسمى للدقائق المحددة؛ ويرن المنبه عند انتهائه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulai pengatur waktu bernama selama menit yang ditentukan; alarm berbunyi saat selesai."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیے گئے منٹوں کے لیے نام والا ٹائمر شروع کرتا ہے؛ ختم ہونے پر الارم بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تایمری با نام برای دقیقه‌های داده‌شده شروع می‌کند؛ در پایان هشدار زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance un minuteur nommé pour le nombre de minutes indiqué ; une alarme sonne à la fin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает именованный таймер на указанное число минут; по окончании звонит сигнал."
          }
        }
      }
    },
