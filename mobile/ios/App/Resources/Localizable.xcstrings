    "perms.music.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız alarm sesi olarak şarkı seçerken. Seçtiğiniz parçanın kısa bir kesiti telefonda saklanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when you pick a song as an alarm sound. A short clip of it is kept on your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn Sie einen Song als Weckton wählen. Ein kurzer Ausschnitt bleibt auf Ihrem Telefon."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız zəngli saat səsi kimi mahnı seçəndə. Seçdiyiniz parçanın qısa hissəsi telefonda saxlanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط عند اختيار أغنية نغمةً للمنبّه. يُحفَظ مقطع قصير منها على هاتفك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya saat memilih lagu sebagai suara alarm. Potongan singkatnya disimpan di ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف الارم کی آواز کے لیے گانا چنتے وقت۔ اس کا مختصر حصہ فون میں محفوظ رہتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط هنگام انتخاب آهنگ برای زنگ هشدار. تکه‌ای کوتاه از آن روی گوشی نگه داشته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement quand vous choisissez un morceau comme sonnerie. Un court extrait reste sur votre téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только когда вы выбираете песню для будильника. Короткий фрагмент хранится на телефоне."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラーム音に曲を選ぶときだけ使います。選んだ曲の短い一部が端末に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 소리로 노래를 고를 때만 써요. 고른 곡의 짧은 일부가 휴대폰에 저장돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在选择歌曲作为闹钟铃声时使用。所选曲目的一小段会保存在手机上。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag pumili ka lang ng kanta bilang tunog ng alarm. Maikling bahagi nito ang itatabi sa telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เฉพาะตอนเลือกเพลงเป็นเสียงปลุก ส่วนสั้น ๆ ของเพลงจะถูกเก็บไว้ในโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuando elige una canción como sonido de alarma. Se guarda un fragmento corto en su teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só quando você escolhe uma música como som do alarme. Um trecho curto da música escolhida fica guardado no celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ अलार्म की आवाज़ के लिए गाना चुनते समय। उसका छोटा हिस्सा फ़ोन में रखा जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু অ্যালার্মের শব্দ হিসেবে কোনো গান বাছলে। এর একটি ছোট অংশ আপনার ফোনে রাখা হয়।"
          }
        }
      }
    },
