        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть ваша любовь всегда остаётся такой же свежей."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつまでも変わらない愛を。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 분의 사랑이 늘 지금처럼 새롭기를."
