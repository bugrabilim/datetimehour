    "dua.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur'an'dan olan duaların Arapçası Tanzil metninden alınmıştır; diğerleri yaygın metinlerle karşılaştırılmıştır. Anlamlar açıklama amaçlıdır; doğru okunuş için bir hocaya danışın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Arabic of Quranic prayers is taken from the Tanzil text; the others were checked against common sources. Meanings are explanatory; for correct recitation ask a teacher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der arabische Text der Koran-Bittgebete stammt aus dem Tanzil-Text; die übrigen wurden mit verbreiteten Quellen verglichen. Die Bedeutungen dienen der Erklärung; für die richtige Rezitation fragen Sie einen Lehrer."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qurandan olan duaların ərəbcəsi Tanzil mətnindən götürülüb; digərləri geniş yayılmış mənbələrlə müqayisə edilib. Mənalar izah məqsədlidir; düzgün oxunuş üçün müəllimə müraciət edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص العربي للأدعية القرآنية مأخوذ من نص تنزيل، وقوبلت الأدعية الأخرى بمصادر شائعة. للقراءة الصحيحة استشر معلمًا."
          }
        }
      }
    },
