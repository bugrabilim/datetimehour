        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد منبّه له نافذة منبّه ذكي. اختر نافذة \"المنبّه الذكي\" في محرر المنبّه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada alarm dengan jendela alarm pintar. Pilih jendela \"Alarm pintar\" di penyunting alarm."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی الارم کا سمارٹ الارم وقفہ منتخب نہیں۔ الارم ایڈیٹر میں «سمارٹ الارم» کا وقفہ چنیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ هشداری بازهٔ هشدار هوشمند ندارد. در ویرایشگر هشدار، بازهٔ «هشدار هوشمند» را انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune alarme n’a de plage de réveil intelligent. Choisissez une plage « Réveil intelligent » dans l’éditeur d’alarme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни у одного будильника не задано окно умного будильника. Выберите окно «Умный будильник» в редакторе будильника."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートアラームの時間帯を設定したアラームがありません。アラームの編集で「スマートアラーム」の時間帯を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스마트 알람 시간대가 설정된 알람이 없습니다. 알람 편집에서 \"스마트 알람\" 시간대를 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有设置智能闹钟时间窗口的闹钟。请在编辑闹钟时选择“智能闹钟”时间窗口。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang alarmang may window ng matalinong alarma. Pumili ng window na \"Matalinong alarma\" sa editor ng alarma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีนาฬิกาปลุกที่ตั้งช่วงนาฬิกาปลุกอัจฉริยะ เลือกช่วง \"นาฬิกาปลุกอัจฉริยะ\" ในตัวแก้ไขนาฬิกาปลุก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna alarma tiene margen de alarma inteligente. Elija un margen de \"Alarma inteligente\" en el editor de alarmas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum alarme tem intervalo de alarme inteligente. Escolha um intervalo de \"Alarme inteligente\" no editor de alarmes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी अलार्म में स्मार्ट अलार्म की अवधि नहीं है। अलार्म एडिटर में \"स्मार्ट अलार्म\" की अवधि चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অ্যালার্মে স্মার্ট অ্যালার্মের সময়সীমা নেই। অ্যালার্ম সম্পাদকে একটি \"স্মার্ট অ্যালার্ম\" সময়সীমা বাছুন।"
          }
        }
      }
    },
    "smart.how": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu yastığınızın yanına, yatağın üstüne koyun ve şarja takın. Hareket algılayıcısı yalnız pencerede okunur; ses kaydı yok, veri telefonda bellekte kalır ve kaydedilmez. Hareket algılanmazsa alarm normal saatinde çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the phone on the bed next to your pillow and plug it in. The motion sensor is read only during the window; nothing is recorded, the data stays in the phone's memory and is not saved. If no movement is detected, the alarm rings at its normal time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie das Telefon neben das Kopfkissen aufs Bett und schließen Sie es ans Ladegerät an. Der Bewegungssensor wird nur im Zeitfenster gelesen; es wird nichts aufgezeichnet, die Daten bleiben nur im Arbeitsspeicher des Telefons und werden nicht gesichert. Ohne Bewegung klingelt der Wecker zur normalen Zeit."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu yastığınızın yanına, yatağın üstünə qoyun və şarja taxın. Hərəkət sensoru yalnız pəncərədə oxunur; səs yazılmır, məlumat telefonun yaddaşında qalır və saxlanılmır. Hərəkət aşkarlanmasa, zəng adi vaxtında çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع الهاتف على السرير بجانب وسادتك ووصّله بالشاحن. لا يُقرأ مستشعر الحركة إلا خلال النافذة؛ لا يُسجَّل شيء، وتبقى البيانات في ذاكرة الهاتف ولا تُحفظ. وإن لم تُرصد حركة يرنّ المنبّه في موعده المعتاد."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taruh ponsel di kasur di samping bantal dan sambungkan ke pengisi daya. Sensor gerak hanya dibaca selama jendela waktu; tidak ada yang direkam, data tetap di memori ponsel dan tidak disimpan. Jika tidak ada gerakan, alarm berbunyi pada waktu biasa."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون کو تکیے کے پاس بستر پر رکھیں اور چارجر سے لگائیں۔ حرکت کا سینسر صرف وقفے میں پڑھا جاتا ہے؛ کچھ ریکارڈ نہیں ہوتا، ڈیٹا فون کی میموری میں رہتا ہے اور محفوظ نہیں ہوتا۔ حرکت نہ ملے تو الارم معمول کے وقت بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی را کنار بالشتان روی تخت بگذارید و به شارژر وصل کنید. حسگر حرکت فقط در بازه خوانده می‌شود؛ چیزی ضبط نمی‌شود، داده در حافظهٔ گوشی می‌ماند و ذخیره نمی‌شود. اگر حرکتی دیده نشود، هشدار سر وقت همیشگی زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez le téléphone sur le lit près de votre oreiller et branchez-le. Le capteur de mouvement n’est lu que pendant la plage ; rien n’est enregistré, les données restent dans la mémoire du téléphone et ne sont pas conservées. Sans mouvement, l’alarme sonne à l’heure prévue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Положите телефон на кровать рядом с подушкой и поставьте на зарядку. Данные датчика движения считываются только в окне будильника; ничего не записывается, данные остаются в памяти телефона и не сохраняются. Если движения нет, будильник сработает в обычное время."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを枕のそばのベッドの上に置き、充電器につないでください。動きのセンサーは時間帯の間だけ読み取ります。録音はせず、データはスマホのメモリにだけあって保存されません。動きがなければアラームは通常の時刻に鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 베개 옆 침대 위에 두고 충전기에 연결하세요. 동작 센서는 시간대 동안에만 읽습니다. 아무것도 기록하지 않으며 데이터는 휴대폰 메모리에만 있고 저장되지 않습니다. 움직임이 없으면 알람은 원래 시간에 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把手机放在床上枕头旁并接上充电器。只在时间窗口内读取运动传感器；不做任何记录，数据只在手机内存中，不会保存。若未检测到动作，闹钟会按原定时间响起。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang telepono sa kama sa tabi ng unan at i-charge ito. Binabasa lang ang motion sensor sa loob ng window; walang nire-record, nananatili ang data sa memory ng telepono at hindi sine-save. Kung walang galaw, tutunog ang alarma sa karaniwang oras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางโทรศัพท์บนเตียงข้างหมอนและเสียบชาร์จ เซนเซอร์การเคลื่อนไหวจะอ่านเฉพาะในช่วงเวลานั้น ไม่มีการบันทึก ข้อมูลอยู่ในหน่วยความจำของโทรศัพท์และไม่ถูกเก็บ หากไม่พบการเคลื่อนไหว นาฬิกาปลุกจะดังตามเวลาปกติ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponga el teléfono en la cama junto a la almohada y enchúfelo. El sensor de movimiento solo se lee durante el margen; no se graba audio, los datos se quedan en la memoria del teléfono y no se guardan. Si no se detecta movimiento, la alarma suena a su hora normal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o celular na cama ao lado do travesseiro e ligue na tomada. O sensor de movimento só é lido durante o intervalo; não há gravação de áudio, os dados ficam na memória do celular e não são guardados. Se não houver movimento, o alarme toca no horário normal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन तकिये के पास बिस्तर पर रखें और चार्ज में लगाएँ। मोशन सेंसर केवल अवधि के दौरान पढ़ा जाता है; आवाज़ रिकॉर्ड नहीं होती, डेटा फ़ोन की मेमोरी में रहता है और सहेजा नहीं जाता। हलचल न दिखे तो अलार्म अपने सामान्य समय पर बजता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোনটি বালিশের পাশে বিছানায় রেখে চার্জে লাগান। গতি সেন্সর শুধু সময়সীমার মধ্যে পড়া হয়; কিছু রেকর্ড হয় না, তথ্য ফোনের মেমরিতে থাকে এবং সংরক্ষণ হয় না। কোনো নড়াচড়া ধরা না পড়লে অ্যালার্ম স্বাভাবিক সময়ে বাজে।"
          }
        }
      }
    },
    "smart.howIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da oturum, uygulama açıkken (ekran kararır) ya da uyku sesi çalarken sürer; uygulamadan çıkarsanız alarm normal saatinde çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone the session runs while the app is open (the screen dims) or while a sleep sound plays; if you leave the app, the alarm rings at its normal time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem iPhone läuft die Sitzung, solange die App geöffnet ist (der Bildschirm wird abgedunkelt) oder ein Schlafgeräusch läuft; verlassen Sie die App, klingelt der Wecker zur normalen Zeit."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-da sessiya tətbiq açıq olanda (ekran qaralır) və ya yuxu səsi çalanda davam edir; tətbiqdən çıxsanız, zəng adi vaxtında çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على iPhone تستمر الجلسة ما دام التطبيق مفتوحًا (تخفت الشاشة) أو أثناء تشغيل صوت النوم؛ وإن خرجت من التطبيق يرنّ المنبّه في موعده المعتاد."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di iPhone, sesi berjalan selama aplikasi terbuka (layar meredup) atau selama suara tidur diputar; jika Anda keluar dari aplikasi, alarm berbunyi pada waktu biasa."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئی فون پر سیشن ایپ کھلی رہنے تک (اسکرین مدھم ہو جاتی ہے) یا نیند کی آواز چلنے تک جاری رہتا ہے؛ ایپ سے نکلیں تو الارم معمول کے وقت بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در آیفون جلسه تا وقتی برنامه باز است (صفحه کم‌نور می‌شود) یا صدای خواب پخش می‌شود ادامه دارد؛ اگر از برنامه بیرون بروید، هشدار سر وقت همیشگی زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPhone, la session dure tant que l’application est ouverte (l’écran s’assombrit) ou qu’un son de sommeil joue ; si vous quittez l’application, l’alarme sonne à l’heure prévue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iPhone сеанс идёт, пока приложение открыто (экран затемняется) или играет звук для сна; если выйти из приложения, будильник сработает в обычное время."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone では、アプリを開いている間（画面は暗くなります）か睡眠用サウンドの再生中にセッションが続きます。アプリを閉じるとアラームは通常の時刻に鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서는 앱이 열려 있는 동안(화면이 어두워짐) 또는 수면 소리가 재생되는 동안 세션이 이어집니다. 앱을 나가면 알람은 원래 시간에 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在iPhone上，应用保持打开（屏幕会变暗）或正在播放助眠声音时会话才会持续；离开应用后，闹钟会按原定时间响起。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa iPhone, tumatakbo ang session habang bukas ang app (dumidilim ang screen) o habang tumutugtog ang tunog pampatulog; kung aalis ka sa app, tutunog ang alarma sa karaniwang oras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน iPhone เซสชันจะทำงานขณะเปิดแอปอยู่ (หน้าจอจะหรี่ลง) หรือขณะเล่นเสียงช่วยนอน หากออกจากแอป นาฬิกาปลุกจะดังตามเวลาปกติ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el iPhone la sesión funciona mientras la app está abierta (la pantalla se atenúa) o mientras suena un sonido para dormir; si sale de la app, la alarma suena a su hora normal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone a sessão funciona enquanto o app está aberto (a tela escurece) ou enquanto toca um som para dormir; se você sair do app, o alarme toca no horário normal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone पर सत्र ऐप खुले रहने (स्क्रीन धुँधली होती है) या नींद की आवाज़ बजते रहने तक चलता है; ऐप छोड़ने पर अलार्म अपने सामान्य समय पर बजता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-এ সেশনটি অ্যাপ খোলা থাকা পর্যন্ত (পর্দা ম্লান হয়) বা ঘুমের শব্দ বাজা পর্যন্ত চলে; অ্যাপ ছেড়ে গেলে অ্যালার্ম স্বাভাবিক সময়ে বাজে।"
          }
        }
      }
    },
    "screenshot.warn": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüsü alındı. İçinde kişisel kayıtlarınız olabilir; paylaşırken dikkat edin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot taken. It may contain your personal records; be careful when sharing it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmfoto aufgenommen. Es kann Ihre persönlichen Einträge enthalten; seien Sie beim Teilen vorsichtig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran şəkli çəkildi. Orada şəxsi qeydləriniz ola bilər; paylaşarkən diqqətli olun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التقاط لقطة شاشة. قد تحتوي على سجلاتك الشخصية؛ انتبه عند مشاركتها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan layar diambil. Mungkin berisi catatan pribadi Anda; berhati-hatilah saat membagikannya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین شاٹ لیا گیا۔ اس میں آپ کے ذاتی ریکارڈ ہو سکتے ہیں؛ شیئر کرتے وقت احتیاط کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از صفحه عکس گرفته شد. ممکن است سوابق شخصی شما در آن باشد؛ هنگام هم‌رسانی مراقب باشید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture d’écran effectuée. Elle peut contenir vos données personnelles ; soyez prudent en la partageant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделан снимок экрана. На нём могут быть ваши личные записи; будьте осторожны, когда делитесь им."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットを撮りました。個人的な記録が含まれている可能性があります。共有するときはご注意ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷을 찍었습니다. 개인 기록이 포함되어 있을 수 있으니 공유할 때 주의하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已截屏。其中可能包含您的个人记录，分享时请注意。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May kinuhang screenshot. Maaaring may laman itong personal mong talaan; mag-ingat sa pagbabahagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกภาพหน้าจอแล้ว ภาพนี้อาจมีบันทึกส่วนตัวของคุณ โปรดระวังเมื่อแชร์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hizo una captura de pantalla. Puede contener sus registros personales; tenga cuidado al compartirla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma captura de tela foi feita. Ela pode conter seus registros pessoais; tenha cuidado ao compartilhar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनशॉट लिया गया। इसमें आपके निजी रिकॉर्ड हो सकते हैं; साझा करते समय सावधान रहें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
