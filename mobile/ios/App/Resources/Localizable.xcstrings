    "study.privacy": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlar yalnız bu telefonda durur, hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records stay on this phone only and are never sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einträge bleiben nur auf diesem Telefon und werden nirgendwohin gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeydlər yalnız bu telefonda qalır, heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى السجلات على هذا الهاتف فقط ولا تُرسل إلى أي مكان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan hanya tersimpan di ponsel ini dan tidak dikirim ke mana pun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈ صرف اسی فون پر رہتے ہیں اور کہیں نہیں بھیجے جاتے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سوابق فقط روی همین گوشی می‌ماند و به جایی فرستاده نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les relevés restent uniquement sur ce téléphone et ne sont envoyés nulle part."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи хранятся только на этом телефоне и никуда не отправляются."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はこの端末にのみ保存され、どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 이 휴대폰에만 남고 어디에도 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录只保存在这部手机上，不会发送到任何地方。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa teleponong ito lang naiimbak ang mga tala at hindi ipinapadala kahit saan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกอยู่ในโทรศัพท์เครื่องนี้เท่านั้นและไม่ถูกส่งไปที่ใด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros se quedan solo en este teléfono y nunca se envían a ninguna parte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros ficam só neste celular e nunca são enviados a lugar nenhum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड केवल इसी फ़ोन पर रहते हैं और कहीं नहीं भेजे जाते।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ড শুধু এই ফোনে থাকে এবং কখনো কোথাও পাঠানো হয় না।"
          }
        }
      }
    },
    "study.privacyIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlar yalnız bu cihazda ve iCloud eşitlemesi açıksa kendi iCloud hesabınızda durur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records stay only on this device and, if iCloud sync is on, in your own iCloud account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einträge bleiben auf diesem Gerät und, wenn die iCloud-Synchronisierung aktiv ist, in Ihrem eigenen iCloud-Konto."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeydlər yalnız bu cihazda və iCloud sinxronizasiyası açıqdırsa, öz iCloud hesabınızda qalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى السجلات على هذا الجهاز، وفي حسابك على iCloud إذا كانت مزامنة iCloud مفعّلة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan tersimpan di perangkat ini dan, jika sinkronisasi iCloud aktif, di akun iCloud Anda sendiri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈ اسی آلے پر اور اگر iCloud ہم آہنگی آن ہو تو آپ کے اپنے iCloud اکاؤنٹ میں رہتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سوابق روی همین دستگاه و اگر همگام‌سازی iCloud روشن باشد، در حساب iCloud خودتان می‌ماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les relevés restent sur cet appareil et, si la synchronisation iCloud est activée, dans votre propre compte iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи хранятся на этом устройстве и, если включена синхронизация iCloud, в вашей учётной записи iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はこのデバイスと、iCloud同期がオンの場合はご自身のiCloudアカウントにのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 이 기기와, iCloud 동기화가 켜져 있으면 본인 iCloud 계정에만 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录保存在此设备上；如开启 iCloud 同步，也会保存在你自己的 iCloud 账户中。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa device na ito naiimbak ang mga tala at, kung naka-on ang iCloud sync, sa sarili mong iCloud account."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกอยู่ในอุปกรณ์นี้ และหากเปิดการซิงค์ iCloud จะอยู่ในบัญชี iCloud ของคุณเอง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros se quedan en este dispositivo y, si la sincronización con iCloud está activada, en su propia cuenta de iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros ficam neste aparelho e, se a sincronização com o iCloud estiver ativada, na sua própria conta do iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड केवल इसी डिवाइस पर और, iCloud सिंक चालू हो तो, आपके अपने iCloud खाते में रहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ড শুধু এই ডিভাইসে এবং iCloud সিঙ্ক চালু থাকলে আপনার নিজের iCloud অ্যাকাউন্টে থাকে।"
          }
        }
      }
    },
    "study.pomoNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro turları pomodoro istatistiğinde seçili dersin adıyla görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro rounds appear in the pomodoro statistics under the selected subject's name."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro-Runden erscheinen in der Pomodoro-Statistik unter dem Namen des gewählten Fachs."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro dövrələri pomodoro statistikasında seçilmiş fənnin adı ilə görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر جولات بومودورو في إحصاءات بومودورو باسم المادة المختارة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putaran pomodoro muncul di statistik pomodoro dengan nama mata pelajaran yang dipilih."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پومودورو کے دور پومودورو کے اعداد و شمار میں منتخب مضمون کے نام سے دکھائی دیتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دورهای پومودورو در آمار پومودورو با نام درس انتخاب‌شده نمایش داده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cycles pomodoro apparaissent dans les statistiques pomodoro sous le nom de la matière choisie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Циклы помодоро попадают в статистику помодоро под названием выбранного предмета."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポモドーロの回数は、選んだ科目名でポモドーロの統計に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뽀모도로 회차는 선택한 과목 이름으로 뽀모도로 통계에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄钟轮次会以所选科目的名称显示在番茄钟统计中。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas ang mga round ng pomodoro sa estadistika ng pomodoro sa pangalan ng napiling asignatura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอบโพโมโดโรจะแสดงในสถิติโพโมโดโรตามชื่อวิชาที่เลือก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rondas de pomodoro aparecen en las estadísticas del pomodoro con el nombre de la asignatura elegida."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As rodadas de pomodoro aparecem nas estatísticas do pomodoro com o nome da matéria escolhida."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोमोडोरो राउंड चुने विषय के नाम से पोमोडोरो आँकड़ों में दिखते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পোমোডোরোর রাউন্ড বাছা বিষয়ের নামে পোমোডোরো পরিসংখ্যানে দেখা যায়।"
          }
        }
      }
    },
