    "pollen.none": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an polen yok ya da bu konum için polen tahmini yok (yalnız Avrupa)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pollen now, or no pollen forecast for this place (Europe only)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit kein Pollenflug oder keine Pollenvorhersage für diesen Ort (nur Europa)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırda tozcuq yoxdur və ya bu yer üçün tozcuq proqnozu yoxdur (yalnız Avropa)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حبوب لقاح الآن أو لا توجد توقعات لهذا المكان (أوروبا فقط)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ini tidak ada serbuk sari atau tidak ada prakiraan untuk tempat ini (hanya Eropa)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس وقت پولن نہیں یا اس جگہ کے لیے پیش گوئی نہیں (صرف یورپ)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اکنون گرده‌ای نیست یا برای این مکان پیش‌بینی گرده وجود ندارد (فقط اروپا)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de pollen pour l'instant ou pas de prévision pour ce lieu (Europe uniquement)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас пыльцы нет или для этого места нет прогноза (только Европа)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在花粉はないか、この地点の花粉予報はありません（欧州のみ）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 꽃가루가 없거나 이 장소의 예보가 없습니다(유럽만)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无花粉，或此地无花粉预报（仅限欧洲）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang polen ngayon o walang taya para sa lugar na ito (Europa lamang)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้ไม่มีละอองเกสรหรือไม่มีการพยากรณ์สำหรับที่นี่ (เฉพาะยุโรป)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no hay polen, o no hay previsión de polen para este lugar (solo Europa)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora não há pólen, ou não há previsão de pólen para este local (só Europa)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी पराग नहीं है, या इस जगह के लिए पराग का पूर्वानुमान नहीं है (केवल यूरोप)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন কোনো পরাগ নেই, বা এই জায়গার পরাগ পূর্বাভাস নেই (শুধু ইউরোপ)।"
          }
        }
      }
    },
