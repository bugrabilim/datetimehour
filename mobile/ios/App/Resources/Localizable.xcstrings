    "alarm.speakNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm çalarken saat telefonun konuşma motoruyla söylenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While ringing, the time is spoken with the phone's speech engine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Klingeln wird die Uhrzeit mit der Sprachausgabe des Telefons angesagt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəngli saat çalarkən vaxt telefonun nitq mühərriki ilə deyilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء الرنين يُنطق الوقت بمحرك الكلام في الهاتف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat berbunyi, waktu diucapkan dengan mesin suara ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بجتے وقت فون کے اسپیچ انجن سے وقت بولا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام زنگ، ساعت با موتور گفتار گوشی گفته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant la sonnerie, l’heure est annoncée avec la synthèse vocale du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время звонка время называется синтезатором речи телефона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鳴っている間、スマホの読み上げエンジンで時刻を伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "울리는 동안 휴대폰 음성 엔진이 시간을 말합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响铃时用手机的语音引擎报出时间。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang tumutunog, sinasabi ang oras gamit ang speech engine ng telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะปลุก จะบอกเวลาด้วยระบบอ่านออกเสียงของโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras suena, la hora se dice con el motor de voz del teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto toca, a hora é falada pelo mecanismo de fala do celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बजते समय फ़ोन के वाणी इंजन से समय बोला जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাজার সময় ফোনের কথন ইঞ্জিন দিয়ে সময় বলা হয়।"
          }
        }
      }
    },
    "alarm.speakNoteIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm sesi, saati söyleyen kısa bir kayıtla değişir (kayıt telefonda üretilir)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm sound becomes a short recording that speaks the time (made on the phone)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Weckton wird zu einer kurzen Aufnahme, die die Uhrzeit ansagt (auf dem Telefon erzeugt)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəngli saatın səsi vaxtı deyən qısa bir səs yazısı ilə əvəz olunur (telefonda yaradılır)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصبح صوت المنبه تسجيلًا قصيرًا ينطق الوقت (يُنشأ على الهاتف)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara alarm menjadi rekaman singkat yang mengucapkan waktu (dibuat di ponsel)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم کی آواز ایک مختصر ریکارڈنگ بن جاتی ہے جو وقت بتاتی ہے (فون پر بنتی ہے)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدای هشدار ضبطی کوتاه می‌شود که ساعت را می‌گوید (روی گوشی ساخته می‌شود)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son de l’alarme devient un court enregistrement qui annonce l’heure (créé sur le téléphone)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук будильника становится короткой записью, называющей время (создаётся на телефоне)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラーム音が時刻を読み上げる短い録音になります（スマホ上で作成）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 소리가 시간을 말하는 짧은 녹음으로 바뀝니다(휴대폰에서 만듦)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟声音变为一段报时的短录音（在手机上生成）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagiging maikling rekording na nagsasabi ng oras ang tunog ng alarma (ginawa sa telepono)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงปลุกจะเปลี่ยนเป็นคลิปเสียงสั้น ๆ ที่บอกเวลา (สร้างบนโทรศัพท์)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido de la alarma pasa a ser una breve grabación que dice la hora (creada en el teléfono)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O som do alarme vira uma gravação curta que fala a hora (feita no celular)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म की आवाज़ समय बोलने वाली छोटी रिकॉर्डिंग बन जाती है (फ़ोन पर बनी)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্মের শব্দ একটি ছোট রেকর্ডিং হয়ে যায় যা সময় বলে (ফোনেই তৈরি)।"
          }
        }
      }
    },
