    "calendar.showDeviceNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook… telefonunuza ekli bütün takvimler. Etkinlikler yalnız telefonda okunur, hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook… every calendar on your phone. Events are read only on your phone and never sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook … alle Kalender auf Ihrem Telefon. Termine werden nur auf dem Telefon gelesen und nirgendwohin gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, Google, Outlook… telefonunuzdakı bütün təqvimlər. Tədbirlər yalnız telefonda oxunur, heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud وGoogle وOutlook… كل التقويمات على هاتفك. تُقرأ الأحداث على هاتفك فقط ولا تُرسل إلى أي جهة."
          }
        }
      }
    },
