    "widget.words.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün, tarih ve saat yazıyla, büyük harflerle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day, date and time spelled out in large type."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag, Datum und Uhrzeit ausgeschrieben in großer Schrift."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün, tarix və saat yazı ilə, iri hərflərlə."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليوم والتاريخ والوقت مكتوبة بالكلمات بخط كبير."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari, tanggal, dan jam dalam kata-kata, dengan huruf besar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دن، تاریخ اور وقت بڑے حروف میں الفاظ کے ساتھ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روز، تاریخ و ساعت به حروف و با خط درشت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jour, date et heure écrits en toutes lettres, en grand."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День, дата и время словами крупным шрифтом."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曜日・日付・時刻を大きな文字で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요일, 날짜, 시간을 큰 글자로 씁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用大字写出星期、日期和时间。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Araw, petsa at oras na nakasulat sa malalaking titik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วัน วันที่ และเวลาเป็นตัวหนังสือขนาดใหญ่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Día, fecha y hora escritos en letra grande."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dia, data e hora por extenso, em letras grandes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन, तारीख और समय शब्दों में, बड़े अक्षरों में।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিন, তারিখ ও সময় বড় অক্ষরে কথায় লেখা।"
          }
        }
      }
    },
