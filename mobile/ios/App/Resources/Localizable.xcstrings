    "alarm.wakeCheck.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapattıktan 5 dakika sonra \"Uyanık mısınız?\" bildirimi gelir; 2 dakika içinde dokunmazsanız alarm yeniden çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes after you turn it off, an \"Are you awake?\" notification arrives; if you don't tap it within 2 minutes, the alarm rings again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Minuten nach dem Ausschalten kommt eine Mitteilung \"Sind Sie wach?\"; tippen Sie nicht innerhalb von 2 Minuten darauf, klingelt der Wecker erneut."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Söndürdükdən 5 dəqiqə sonra \"Oyaqsınız?\" bildirişi gəlir; 2 dəqiqə ərzində toxunmasanız zəng yenidən çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد 5 دقائق من الإيقاف يصل إشعار \"هل أنت مستيقظ؟\"؛ وإن لم تلمسه خلال دقيقتين يرنّ المنبّه مجددًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lima menit setelah Anda mematikan alarm, notifikasi \"Sudah bangun?\" datang; jika tidak diketuk dalam 2 menit, alarm berbunyi lagi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بند کرنے کے پانچ منٹ بعد «کیا آپ جاگ رہے ہیں؟» اطلاع آتی ہے؛ اگر 2 منٹ میں اس پر ٹیپ نہ کریں تو الارم پھر بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنج دقیقه پس از خاموش کردن، اعلان «بیدارید؟» می‌رسد؛ اگر تا 2 دقیقه روی آن نزنید، هشدار دوباره زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq minutes après l’arrêt, une notification « Êtes-vous réveillé ? » arrive ; si vous ne la touchez pas dans les 2 minutes, l’alarme sonne de nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через пять минут после выключения придёт уведомление «Вы проснулись?»; если не нажать его в течение 2 минут, будильник зазвонит снова."
          }
        }
      }
    },
