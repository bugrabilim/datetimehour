    "theme.dynamicNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 12 ve sonrasında uygulama ve widget'lar duvar kâğıdınızın renklerini alır (Material You)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Android 12 and later, the app and widgets take the colours of your wallpaper (Material You)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab Android 12 übernehmen App und Widgets die Farben Ihres Hintergrundbilds (Material You)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 12 və sonrasında tətbiq və vidcetlər divar kağızınızın rənglərini alır (Material You)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في Android 12 وما بعده يأخذ التطبيق والأدوات المصغّرة ألوان خلفيتك (Material You)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Android 12 ke atas, aplikasi dan widget mengikuti warna wallpaper Anda (Material You)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 12 اور بعد میں ایپ اور وجیٹس آپ کے وال پیپر کے رنگ لیتے ہیں (Material You)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در Android 12 و بعد، برنامه و ابزارک‌ها رنگ‌های والپیپر شما را می‌گیرند (Material You)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir d'Android 12, l'app et les widgets prennent les couleurs de votre fond d'écran (Material You)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Android 12 и новее приложение и виджеты берут цвета ваших обоев (Material You)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 12以降では、アプリとウィジェットが壁紙の色になります（Material You）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 12 이상에서는 앱과 위젯이 배경화면 색상을 따릅니다(Material You)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Android 12 及以上版本，应用和小组件会采用壁纸的颜色（Material You）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Android 12 pataas, sinusunod ng app at widgets ang kulay ng iyong wallpaper (Material You)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Android 12 ขึ้นไป แอปและวิดเจ็ตจะใช้สีตามวอลเปเปอร์ของคุณ (Material You)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Android 12 y posteriores, la app y los widgets toman los colores de su fondo de pantalla (Material You)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No Android 12 e posterior, o app e os widgets usam as cores do seu papel de parede (Material You)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 12 और बाद में ऐप और विजेट आपके वॉलपेपर के रंग लेते हैं (Material You)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 12 ও পরের সংস্করণে অ্যাপ ও উইজেট আপনার ওয়ালপেপারের রং নেয় (Material You)।"
          }
        }
      }
    },
