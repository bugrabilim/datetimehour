    "look.bg.weatherNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava durumu arka planı seçili konumdaki havayı (açık, bulutlu, yağmur, kar, sis, fırtına) gökyüzünün üstüne çizer; hava yaklaşık 15 dakikada bir yenilenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The weather background draws the current weather at the selected location (clear, cloudy, rain, snow, fog, storm) over the sky; it refreshes about every 15 minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wetter-Hintergrund zeigt das aktuelle Wetter am gewählten Ort (klar, bewölkt, Regen, Schnee, Nebel, Gewitter) über dem Himmel; er wird etwa alle 15 Minuten aktualisiert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava arxa fonu seçilmiş yerdəki havanı (açıq, buludlu, yağış, qar, duman, tufan) səmanın üzərində çəkir; təxminən 15 dəqiqədən bir yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترسم خلفية الطقس حالة الطقس الحالية في الموقع المحدد (صافٍ، غائم، مطر، ثلج، ضباب، عاصفة) فوق السماء، وتُحدَّث كل 15 دقيقة تقريبًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latar cuaca menggambar cuaca saat ini di tempat pilihan (cerah, berawan, hujan, salju, kabut, badai) di atas langit; diperbarui sekitar setiap 15 menit."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موسمی پس منظر منتخب جگہ کا موجودہ موسم (صاف، ابر آلود، بارش، برف، دھند، طوفان) آسمان پر بناتا ہے؛ تقریباً ہر 15 منٹ میں تازہ ہوتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس‌زمینهٔ آب‌وهوا وضع کنونی مکان انتخابی (صاف، ابری، باران، برف، مه، توفان) را روی آسمان می‌کشد؛ حدوداً هر 15 دقیقه تازه می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arrière-plan météo dessine le temps actuel au lieu choisi (dégagé, nuageux, pluie, neige, brouillard, orage) sur le ciel ; il s’actualise environ toutes les 15 minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Погодный фон рисует поверх неба текущую погоду в выбранном месте (ясно, облачно, дождь, снег, туман, гроза); обновляется примерно каждые 15 минут."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気の背景は、選んだ場所の今の天気（晴れ、くもり、雨、雪、霧、嵐）を空の上に描き、約15分ごとに更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨 배경은 선택한 곳의 현재 날씨(맑음, 흐림, 비, 눈, 안개, 폭풍)를 하늘 위에 그리며 약 15분마다 갱신합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "天气背景会在天空上绘出所选地点的当前天气（晴、多云、雨、雪、雾、雷暴），大约每15分钟更新一次。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iginuguhit ng background na panahon ang kasalukuyang panahon sa napiling lokasyon (maaliwalas, maulap, ulan, niyebe, hamog, bagyo) sa langit; nagre-refresh ito halos bawat 15 minuto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นหลังสภาพอากาศวาดสภาพอากาศปัจจุบัน ณ ตำแหน่งที่เลือก (แจ่มใส มีเมฆ ฝน หิมะ หมอก พายุ) บนท้องฟ้า และรีเฟรชราวทุก 15 นาที"
          }
        }
      }
    },
