    "onboard.tour.tools.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro, ders çalışma sayacı, zamanlayıcı, kronometre, aralık antrenmanı, metronom, satranç saati, toplantı planlayıcı ve daha fazlası."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro, study timer, timer, stopwatch, interval training, metronome, chess clock, meeting planner and more."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro, Lerntimer, Timer, Stoppuhr, Intervalltraining, Metronom, Schachuhr, Meeting-Planer und mehr."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro, dərs sayğacı, taymer, saniyəölçən, interval məşqi, metronom, şahmat saatı, görüş planlayıcısı və daha çoxu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بومودورو ومؤقت المذاكرة والمؤقت وساعة الإيقاف والتمارين المتقطعة والمترونوم وساعة الشطرنج ومخطط الاجتماعات وغيرها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro, pengatur waktu belajar, timer, stopwatch, latihan interval, metronom, jam catur, perencana rapat, dan lainnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پومودورو، پڑھائی کا ٹائمر، ٹائمر، اسٹاپ واچ، وقفہ وار ورزش، میٹرونوم، شطرنج گھڑی، میٹنگ پلانر اور بہت کچھ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پومودورو، زمان‌سنج درس، تایمر، کرونومتر، تمرین تناوبی، مترونوم، ساعت شطرنج، برنامه‌ریز جلسه و بیشتر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro, minuteur d'étude, minuteur, chronomètre, entraînement fractionné, métronome, pendule d'échecs, planificateur de réunions et plus encore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помодоро, таймер учёбы, таймер, секундомер, интервальные тренировки, метроном, шахматные часы, планировщик встреч и многое другое."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポモドーロ、勉強タイマー、タイマー、ストップウォッチ、インターバルトレーニング、メトロノーム、チェスクロック、会議プランナーなど。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뽀모도로, 공부 타이머, 타이머, 스톱워치, 인터벌 트레이닝, 메트로놈, 체스 시계, 회의 플래너 등."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "番茄钟、学习计时器、计时器、秒表、间歇训练、节拍器、国际象棋钟、会议规划等。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro, study timer, timer, stopwatch, interval training, metronome, chess clock, meeting planner at marami pa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพโมโดโร ตัวจับเวลาอ่านหนังสือ ตัวจับเวลา นาฬิกาจับเวลา การฝึกแบบอินเทอร์วัล เมโทรนอม นาฬิกาหมากรุก ตัววางแผนประชุม และอื่น ๆ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro, temporizador de estudio, temporizador, cronómetro, entrenamiento por intervalos, metrónomo, reloj de ajedrez, planificador de reuniones y más."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomodoro, temporizador de estudo, temporizador, cronômetro, treino intervalado, metrônomo, relógio de xadrez, planejador de reuniões e mais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोमोडोरो, पढ़ाई का टाइमर, टाइमर, स्टॉपवॉच, इंटरवल ट्रेनिंग, मेट्रोनोम, शतरंज घड़ी, मीटिंग प्लानर और बहुत कुछ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পোমোডোরো, পড়ার টাইমার, টাইমার, স্টপওয়াচ, ইন্টারভাল ব্যায়াম, মেট্রোনোম, দাবা ঘড়ি, মিটিং পরিকল্পক ও আরও অনেক কিছু।"
          }
        }
      }
    },
