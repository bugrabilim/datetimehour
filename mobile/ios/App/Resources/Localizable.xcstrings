    "datecalc.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki tarih arası kaç gün, kaç iş günü? Tarihe gün, ay, yıl ekleyin ya da çıkarın; yaşınızı hesaplayın. Türkiye resmi tatilleri dikkate alınır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many days and working days between two dates? Add or subtract days, months or years from a date and calculate age. Turkish public holidays are taken into account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Tage und Arbeitstage liegen zwischen zwei Daten? Tage, Monate oder Jahre addieren und abziehen, Alter berechnen – mit türkischen Feiertagen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İki tarix arasında neçə gün və iş günü var? Tarixə gün, ay və ya il əlavə edin, çıxın, yaşı hesablayın. Türkiyənin rəsmi bayramları nəzərə alınır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم يومًا وكم يوم عمل بين تاريخين؟ أضف أيامًا أو شهورًا أو سنوات إلى تاريخ أو اطرحها منه، واحسب العمر، مع مراعاة العطل الرسمية في تركيا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa hari dan hari kerja antara dua tanggal? Tambah atau kurangi hari, bulan, atau tahun dari suatu tanggal dan hitung usia. Hari libur resmi Turki diperhitungkan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دو تاریخوں کے درمیان کتنے دن اور کام کے دن ہیں؟ کسی تاریخ میں دن، مہینے یا سال جمع یا تفریق کریں اور عمر نکالیں۔ ترکی کی سرکاری تعطیلات کا خیال رکھا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میان دو تاریخ چند روز و چند روز کاری است؟ روز، ماه یا سال را به تاریخی بیفزایید یا از آن کم کنید و سن را حساب کنید. تعطیلات رسمی ترکیه در نظر گرفته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours et jours ouvrés entre deux dates, ajout ou retrait de jours, mois ou années, et calcul d’âge. Les jours fériés turcs sont pris en compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько дней и рабочих дней между двумя датами? Прибавьте или вычтите дни, месяцы или годы и рассчитайте возраст. Учитываются государственные праздники Турции."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つの日付の間は何日、何営業日？日付に日・月・年を足し引きし、年齢も計算できます。トルコの祝日を考慮します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 날짜 사이는 며칠, 근무일로 며칠일까요? 날짜에 일·월·년을 더하거나 빼고 나이도 계산합니다. 튀르키예 공휴일을 반영합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个日期之间有多少天、多少个工作日？在日期上加减天、月、年，并计算年龄。已考虑土耳其公共假日。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilang araw at araw ng trabaho ang pagitan ng dalawang petsa? Magdagdag o magbawas ng araw, buwan o taon at kalkulahin ang edad. Kasama ang mga holiday ng Türkiye."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สองวันที่ห่างกันกี่วันและกี่วันทำงาน? บวกหรือลบวัน เดือน ปีจากวันที่ และคำนวณอายุ โดยคิดวันหยุดราชการของตุรกีด้วย"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuántos días y días laborables hay entre dos fechas? Sume o reste días, meses o años a una fecha y calcule la edad. Se tienen en cuenta los festivos de Turquía."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantos dias e dias úteis há entre duas datas? Some ou subtraia dias, meses ou anos de uma data e calcule a idade. Os feriados da Turquia são levados em conta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो तारीखों के बीच कितने दिन और कार्यदिवस हैं? किसी तारीख में दिन, महीने या साल जोड़ें-घटाएँ और उम्र निकालें। तुर्किये की सार्वजनिक छुट्टियों का ध्यान रखा जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুই তারিখের মধ্যে কত দিন ও কর্মদিবস? কোনো তারিখে দিন, মাস বা বছর যোগ-বিয়োগ করুন এবং বয়স হিসাব করুন। তুরস্কের সরকারি ছুটি বিবেচনা করা হয়।"
          }
        }
      }
    },
