    "google.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Takvimi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Calendar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Kalender"
