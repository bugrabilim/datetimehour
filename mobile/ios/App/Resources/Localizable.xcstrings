    "account.confirmClose": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hesabınız ve o üründeki verileriniz silinecek. Önce verilerinizi indirebilirsiniz. Kapatılsın mı?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %1$@ account and your data in that product will be deleted. You can download your data first. Turn it off?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto bei %1$@ und Ihre Daten dort werden gelöscht. Sie können Ihre Daten vorher herunterladen. Ausschalten?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hesabınız və o məhsuldakı məlumatlarınız silinəcək. Əvvəlcə məlumatlarınızı endirə bilərsiniz. Bağlansın?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف حسابك في %1$@ وبياناتك فيه. يمكنك تنزيل بياناتك أولًا. هل نوقفه؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun %1$@ Anda dan data Anda di produk itu akan dihapus. Anda dapat mengunduh data lebih dulu. Nonaktifkan?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ میں آپ کا اکاؤنٹ اور وہاں کا ڈیٹا حذف ہو جائے گا۔ آپ پہلے اپنا ڈیٹا ڈاؤن لوڈ کر سکتے ہیں۔ بند کریں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب شما در %1$@ و داده‌هایتان در آن پاک می‌شود. می‌توانید اول داده‌هایتان را بارگیری کنید. خاموش شود؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte %1$@ et vos données dans ce produit seront supprimés. Vous pouvez d'abord télécharger vos données. Désactiver ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш аккаунт в %1$@ и данные в нём будут удалены. Сначала можно скачать данные. Выключить?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ のアカウントとその製品のデータが削除されます。先にデータをダウンロードできます。オフにしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 계정과 그 제품의 데이터가 삭제됩니다. 먼저 데이터를 내려받을 수 있습니다. 끌까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您在 %1$@ 的账户及该产品中的数据将被删除。您可以先下载数据。要关闭吗？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mabubura ang inyong account sa %1$@ at ang inyong data roon. Puwede muna ninyong i-download ang inyong data. Isara?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี %1$@ และข้อมูลในผลิตภัณฑ์นั้นจะถูกลบ คุณดาวน์โหลดข้อมูลก่อนได้ ปิดไหม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán su cuenta de %1$@ y sus datos en ese producto. Puede descargar sus datos antes. ¿Desactivar?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta no %1$@ e seus dados naquele produto serão apagados. Você pode baixar seus dados antes. Desativar?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ में आपका खाता और वहाँ का डेटा मिटा दिया जाएगा। आप पहले अपना डेटा डाउनलोड कर सकते हैं। बंद करें?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-এ আপনার অ্যাকাউন্ট ও সেখানকার তথ্য মুছে যাবে। আগে আপনার তথ্য ডাউনলোড করতে পারেন। বন্ধ করবেন?"
          }
        }
      }
    },
