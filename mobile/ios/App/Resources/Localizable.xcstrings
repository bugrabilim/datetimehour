    "onboard.tour.look.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "25 analog kadran, 24 uygulama rengi, gün ışığına göre değişen zemin ve yazı boyutu. Ayarlar › Renk ve görünüm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "25 analog dials, 24 app colors, a background that follows daylight, and text size. Settings › Color and appearance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "25 analoge Zifferblätter, 24 App-Farben, ein Hintergrund, der dem Tageslicht folgt, und Textgröße. Einstellungen › Farbe und Aussehen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "25 analoq siferblat, 24 tətbiq rəngi, gün işığına görə dəyişən fon və yazı ölçüsü. Parametrlər › Rəng və görünüş."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "25 ميناءً تناظريًا و24 لونًا للتطبيق وخلفية تتبع ضوء النهار وحجم الخط. الإعدادات › اللون والمظهر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "25 muka jam analog, 24 warna aplikasi, latar yang mengikuti cahaya siang, dan ukuran teks. Pengaturan › Warna dan tampilan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "25 اینالاگ ڈائل، ایپ کے 24 رنگ، دن کی روشنی کے ساتھ بدلتا پس منظر اور تحریر کا سائز۔ ترتیبات › رنگ اور انداز۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "25 صفحهٔ عقربه‌ای، 24 رنگ برنامه، پس‌زمینه‌ای که با نور روز تغییر می‌کند و اندازهٔ نوشته. تنظیمات › رنگ و ظاهر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "25 cadrans analogiques, 24 couleurs d'appli, un fond qui suit la lumière du jour et la taille du texte. Réglages › Couleur et apparence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "25 аналоговых циферблатов, 24 цвета приложения, фон, меняющийся с дневным светом, и размер текста. Настройки › Цвет и вид."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "25種類のアナログ文字盤、24色のアプリカラー、日の光に合わせて変わる背景、文字サイズ。設定 › 色と外観。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "25가지 아날로그 다이얼, 24가지 앱 색상, 햇빛에 따라 바뀌는 배경, 글자 크기. 설정 › 색상 및 모양."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "25 款指针表盘、24 种应用颜色、随日光变化的背景和文字大小。设置 › 颜色与外观。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "25 analog na dial, 24 kulay ng app, background na sumusunod sa liwanag ng araw, at laki ng teksto. Settings › Kulay at itsura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าปัดเข็ม 25 แบบ สีแอป 24 สี พื้นหลังที่เปลี่ยนตามแสงกลางวัน และขนาดตัวอักษร การตั้งค่า › สีและรูปลักษณ์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "25 esferas analógicas, 24 colores de app, un fondo que sigue la luz del día y tamaño de texto. Ajustes › Color y aspecto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "25 mostradores analógicos, 24 cores do app, um fundo que acompanha a luz do dia e tamanho do texto. Ajustes › Cor e aparência."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "25 एनालॉग डायल, ऐप के 24 रंग, दिन की रोशनी के साथ बदलती पृष्ठभूमि और अक्षरों का आकार। सेटिंग्स › रंग और रूप।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "25টি অ্যানালগ ডায়াল, 24টি অ্যাপের রং, দিনের আলো অনুসরণকারী পটভূমি ও লেখার আকার। সেটিংস › রং ও চেহারা।"
          }
        }
      }
    },
