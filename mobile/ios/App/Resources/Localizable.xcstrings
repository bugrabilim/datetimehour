          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez-le avec l'appareil photo d'un téléphone pour ouvrir time.bumba.tr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте камерой телефона, чтобы открыть time.bumba.tr."
          }
        },
        "ja": {
          "stringUnit": {
