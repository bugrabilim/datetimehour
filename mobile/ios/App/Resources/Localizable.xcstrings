    "chess.appHint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için siyahın saatine dokunun; beyazın süresi işlemeye başlar. Hamlenizi yapınca kendi saatinize dokunun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Black's clock to start; White's time begins to run. After your move, tap your own clock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie zum Start auf die Uhr von Schwarz; die Zeit von Weiß beginnt zu laufen. Tippen Sie nach Ihrem Zug auf Ihre eigene Uhr."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamaq üçün qaranın saatına toxunun; ağın vaxtı işləməyə başlayır. Gedişinizi etdikdən sonra öz saatınıza toxunun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس ساعة الأسود للبدء؛ يبدأ وقت الأبيض بالجريان. بعد نقلتك المس ساعتك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk jam Hitam untuk memulai; waktu Putih mulai berjalan. Setelah melangkah, ketuk jam Anda sendiri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع کرنے کے لیے سیاہ کی گھڑی کو چھوئیں؛ سفید کا وقت چلنے لگتا ہے۔ اپنی چال کے بعد اپنی گھڑی کو چھوئیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای شروع ساعت سیاه را لمس کنید؛ زمان سفید شروع به کم شدن می‌کند. پس از حرکت، ساعت خودتان را لمس کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l'horloge des Noirs pour commencer ; le temps des Blancs se met à courir. Après votre coup, touchez votre propre horloge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы начать, коснитесь часов чёрных; начинает идти время белых. Сделав ход, коснитесь своих часов."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黒の時計をタップすると開始し、白の時間が進み始めます。指したら自分の時計をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하려면 흑의 시계를 누르세요. 백의 시간이 흐르기 시작합니다. 수를 둔 뒤 자기 시계를 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击黑方的时钟开始，白方开始计时。走完一步后点击自己的时钟。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang orasan ng Itim para magsimula; tatakbo ang oras ng Puti. Pagkatapos ng tira mo, i-tap ang sarili mong orasan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะนาฬิกาฝั่งดำเพื่อเริ่ม เวลาของฝั่งขาวจะเริ่มเดิน เมื่อเดินหมากแล้วให้แตะนาฬิกาของตัวเอง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el reloj de las negras para empezar; el tiempo de las blancas empieza a correr. Después de su jugada, toque su propio reloj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no relógio das pretas para começar; o tempo das brancas começa a correr. Depois do seu lance, toque no seu próprio relógio."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए काले की घड़ी छुएँ; सफ़ेद का समय चलने लगता है। अपनी चाल के बाद अपनी घड़ी छुएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু করতে কালোর ঘড়িতে চাপুন; সাদার সময় চলতে শুরু করে। চাল দেওয়ার পর নিজের ঘড়িতে চাপুন।"
          }
        }
      }
    },
    "talking.appNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma telefonun kendi ses motoruyla yapılır; metin hiçbir yere gönderilmez. Otomatik söyleme bu ekran açıkken çalışır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech uses your phone's own voice engine; no text is sent anywhere. Automatic announcements work while this screen is open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesprochen wird mit der Sprachausgabe Ihres Telefons; kein Text wird gesendet. Automatische Ansagen laufen, solange dieser Bildschirm geöffnet ist."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Danışıq telefonun öz səs mühərriki ilə edilir; mətn heç yerə göndərilmir. Avtomatik söyləmə bu ekran açıq olanda işləyir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم النطق بمحرك الصوت في هاتفك؛ لا يُرسل أي نص إلى أي مكان. يعمل النطق التلقائي ما دامت هذه الشاشة مفتوحة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucapan memakai mesin suara ponsel Anda sendiri; tidak ada teks yang dikirim ke mana pun. Pengumuman otomatis berjalan selama layar ini terbuka."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بولنا فون کے اپنے آواز انجن سے ہوتا ہے؛ کوئی متن کہیں نہیں بھیجا جاتا۔ خودکار اعلان اس وقت تک چلتا ہے جب تک یہ اسکرین کھلی ہو۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گفتار با موتور صوتی خود گوشی انجام می‌شود؛ هیچ متنی جایی فرستاده نمی‌شود. اعلام خودکار تا وقتی این صفحه باز است کار می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix utilise le moteur vocal de votre téléphone ; aucun texte n'est envoyé. Les annonces automatiques fonctionnent tant que cet écran est ouvert."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Озвучивание выполняет голосовой движок телефона; текст никуда не отправляется. Автоматические объявления работают, пока этот экран открыт."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げはスマートフォン内蔵の音声エンジンで行い、文字はどこにも送信しません。自動読み上げはこの画面を開いている間だけ動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성은 휴대폰 자체 음성 엔진으로 읽으며 어떤 글도 외부로 보내지 않습니다. 자동 알림은 이 화면이 열려 있는 동안 작동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朗读使用手机自带的语音引擎，文字不会发送到任何地方。自动报时仅在此页面打开时运行。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagamit ang pagsasalita ng sariling voice engine ng telepono; walang tekstong ipinapadala kahit saan. Gumagana ang awtomatikong pag-anunsyo habang bukas ang screen na ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพูดใช้เอนจินเสียงของโทรศัพท์เอง ไม่มีข้อความถูกส่งไปที่ใด การประกาศอัตโนมัติทำงานขณะที่หน้าจอนี้เปิดอยู่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz usa el motor de voz de su teléfono; no se envía ningún texto. Los avisos automáticos funcionan mientras esta pantalla esté abierta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A fala usa o mecanismo de voz do próprio celular; nenhum texto é enviado. A fala automática funciona enquanto esta tela estiver aberta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोलना फ़ोन के अपने आवाज़ इंजन से होता है; कोई भी पाठ कहीं नहीं भेजा जाता। स्वचालित घोषणा तभी तक चलती है जब तक यह स्क्रीन खुली है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কথা বলার জন্য আপনার ফোনের নিজস্ব কণ্ঠ ইঞ্জিন ব্যবহৃত হয়; কোনো লেখা কোথাও পাঠানো হয় না। স্বয়ংক্রিয় ঘোষণা এই পর্দা খোলা থাকলে কাজ করে।"
          }
        }
      }
    },
    "classroom.appNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adlar ve sayaçlar yalnız bu telefonda saklanır, hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and counters are stored only on this phone and are never sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen und Zähler werden nur auf diesem Telefon gespeichert und nirgendwohin gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Adlar və sayğaclar yalnız bu telefonda saxlanılır, heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الأسماء والعدادات على هذا الهاتف فقط ولا تُرسل إلى أي مكان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama dan penghitung hanya disimpan di ponsel ini dan tidak dikirim ke mana pun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نام اور کاؤنٹر صرف اسی فون میں محفوظ رہتے ہیں، کہیں نہیں بھیجے جاتے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام‌ها و شمارنده‌ها فقط در همین گوشی ذخیره می‌شوند و جایی فرستاده نمی‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms et les compteurs sont enregistrés uniquement sur ce téléphone et ne sont envoyés nulle part."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена и счётчики хранятся только на этом телефоне и никуда не отправляются."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前とカウンターはこのスマートフォンにだけ保存され、どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름과 카운터는 이 휴대폰에만 저장되며 어디에도 보내지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字和计数器只保存在本机，不会发送到任何地方。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga pangalan at counter ay nakaimbak lang sa teleponong ito at hindi ipinapadala kahit saan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อและตัวนับเก็บไว้ในโทรศัพท์เครื่องนี้เท่านั้น ไม่ถูกส่งไปที่ใด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres y contadores se guardan solo en este teléfono y no se envían a ningún sitio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes e contadores ficam salvos só neste celular e não são enviados para lugar nenhum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम और काउंटर केवल इसी फ़ोन में सहेजे जाते हैं, कहीं नहीं भेजे जाते।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নাম ও কাউন্টার শুধু এই ফোনে সংরক্ষিত থাকে এবং কখনো কোথাও পাঠানো হয় না।"
          }
        }
      }
    },
    "examTimer.appNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç bu telefonda saklanır; uygulamayı yeniden açınca sayaç kaldığı yerden sürer. Sayaç işlerken ekran kararmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The start time is kept on this phone; when you reopen the app the timer continues where it left off. The screen stays on while the timer runs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Startzeitpunkt bleibt auf diesem Telefon gespeichert; beim erneuten Öffnen läuft der Timer weiter. Während er läuft, bleibt der Bildschirm an."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlanğıc bu telefonda saxlanılır; tətbiqi yenidən açanda sayğac qaldığı yerdən davam edir. Sayğac işləyəndə ekran sönmür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ وقت البدء على هذا الهاتف؛ وعند فتح التطبيق مجددًا يتابع المؤقت من حيث توقف. تبقى الشاشة مضاءة أثناء عمل المؤقت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu mulai disimpan di ponsel ini; saat aplikasi dibuka lagi, penghitung berlanjut dari posisi terakhir. Layar tetap menyala selama penghitung berjalan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع کا وقت اسی فون میں محفوظ رہتا ہے؛ ایپ دوبارہ کھولنے پر ٹائمر وہیں سے جاری رہتا ہے۔ ٹائمر چلتے وقت اسکرین بند نہیں ہوتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان شروع در همین گوشی ذخیره می‌شود؛ با باز کردن دوباره برنامه، زمان‌سنج از همان‌جا ادامه می‌دهد. تا زمان‌سنج کار می‌کند صفحه خاموش نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'heure de départ est conservée sur ce téléphone ; en rouvrant l'app, le minuteur reprend là où il en était. L'écran reste allumé pendant qu'il tourne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время начала хранится на этом телефоне; при повторном открытии приложения таймер продолжает с того же места. Пока таймер идёт, экран не гаснет."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時刻はこのスマートフォンに保存され、アプリを開き直すと続きから再開します。タイマー作動中は画面が消えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 시각은 이 휴대폰에 저장되며 앱을 다시 열면 이어서 진행됩니다. 타이머가 도는 동안 화면이 꺼지지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始时间保存在本机；重新打开应用时计时从中断处继续。计时进行时屏幕保持常亮。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakaimbak sa teleponong ito ang oras ng simula; pagbukas muli ng app, magpapatuloy ang timer kung saan ito huminto. Nananatiling bukas ang screen habang tumatakbo ang timer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาเริ่มเก็บไว้ในโทรศัพท์เครื่องนี้ เมื่อเปิดแอปอีกครั้งตัวจับเวลาจะเดินต่อจากเดิม หน้าจอจะไม่ดับขณะจับเวลา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de inicio se guarda en este teléfono; al volver a abrir la app, el temporizador sigue donde quedó. La pantalla no se apaga mientras corre."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário de início fica salvo neste celular; ao reabrir o app, o temporizador continua de onde parou. A tela não apaga enquanto ele corre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू होने का समय इसी फ़ोन में सहेजा रहता है; ऐप दोबारा खोलने पर टाइमर वहीं से चलता है। टाइमर चलते समय स्क्रीन बंद नहीं होती।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরুর সময় এই ফোনে রাখা হয়; অ্যাপ আবার খুললে টাইমার যেখানে থেমেছিল সেখান থেকে চলে। টাইমার চলাকালে পর্দা চালু থাকে।"
          }
        }
      }
    },
    "tools.localOnly": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdiğiniz bilgiler yalnız bu telefonda hesaplanır; kaydedilmez ve hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you enter is calculated only on this phone; it is not saved or sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Eingaben werden nur auf diesem Telefon berechnet; sie werden weder gespeichert noch gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Daxil etdiyiniz məlumat yalnız bu telefonda hesablanır; saxlanılmır və heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب البيانات التي تدخلها على هذا الهاتف فقط؛ لا تُحفظ ولا تُرسل إلى أي مكان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data yang Anda masukkan hanya dihitung di ponsel ini; tidak disimpan dan tidak dikirim ke mana pun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی درج کردہ معلومات صرف اسی فون پر حساب ہوتی ہیں؛ نہ محفوظ ہوتی ہیں نہ کہیں بھیجی جاتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعاتی که وارد می‌کنید فقط در همین گوشی محاسبه می‌شود؛ ذخیره نمی‌شود و جایی فرستاده نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos saisies sont calculées uniquement sur ce téléphone ; elles ne sont ni enregistrées ni envoyées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введённые данные считаются только на этом телефоне; они не сохраняются и никуда не отправляются."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した内容はこのスマートフォンの中だけで計算され、保存も送信もされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 내용은 이 휴대폰에서만 계산되며 저장되거나 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您输入的信息只在本机计算，不会保存，也不会发送到任何地方。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang inilagay mo ay kinukuwenta lang sa teleponong ito; hindi ito sine-save o ipinapadala kahit saan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลที่กรอกคำนวณในโทรศัพท์เครื่องนี้เท่านั้น ไม่ถูกบันทึกและไม่ถูกส่งไปที่ใด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que introduce se calcula solo en este teléfono; no se guarda ni se envía a ningún sitio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você digita é calculado só neste celular; não é salvo nem enviado para lugar nenhum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो दर्ज करते हैं, उसकी गणना केवल इसी फ़ोन पर होती है; वह न सहेजा जाता है, न कहीं भेजा जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যা লেখেন তা শুধু এই ফোনেই হিসাব করা হয়; সংরক্ষণ বা কোথাও পাঠানো হয় না।"
          }
        }
      }
    },
