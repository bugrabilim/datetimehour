    "greet.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart telefonda çizilir; yalnız siz paylaşınca gönderilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card is drawn on the phone and sent only when you share it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karte wird auf dem Telefon gezeichnet und nur beim Teilen gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart telefonda çəkilir; yalnız siz paylaşanda göndərilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسم البطاقة على الهاتف ولا تُرسل إلا عند مشاركتك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu digambar di ponsel dan hanya dikirim saat Anda membagikannya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارڈ فون پر بنتا ہے اور صرف آپ کے شیئر کرنے پر بھیجا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارت روی گوشی کشیده می‌شود و فقط وقتی هم‌رسانی کنید فرستاده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte est dessinée sur le téléphone et n’est envoyée que si vous la partagez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытка рисуется на телефоне и отправляется, только когда вы ею поделитесь."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードは端末で描かれ、共有したときだけ送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드는 휴대전화에서 그려지며 공유할 때만 보내집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贺卡在手机上绘制，仅在你分享时发送。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iginuguhit ang card sa telepono at ipinapadala lang kapag ibinahagi mo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดวาดในโทรศัพท์ และส่งเมื่อคุณแชร์เท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta se dibuja en el teléfono y solo se envía cuando la comparte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão é desenhado no celular e só é enviado quando você compartilha."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड फ़ोन पर बनता है और केवल साझा करने पर भेजा जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ডটি ফোনেই আঁকা হয় এবং শুধু আপনি শেয়ার করলেই পাঠানো হয়।"
          }
        }
      }
    },
