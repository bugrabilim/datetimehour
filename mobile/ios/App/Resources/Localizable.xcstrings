    "bridge.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta sonu ve resmî tatil günleri izin gerektirmez; hafta içine düşen yarım gün arifeler 0,5 gün izin sayılır. Arifeler kamu kurumlarında öğleden sonra tatildir; özel sektörde iş yerinin uygulamasına bakın. İdari izin ve iş yeri köprüleri eklenmemiştir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekends and public holidays need no leave; a half-day eve on a weekday counts as half a day of leave. Eves are afternoon-off in the public sector; check your employer in the private sector. Administrative leave and company bridge days are not included."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wochenenden und Feiertage brauchen keinen Urlaub; ein halber Vorabend an einem Werktag zählt als halber Urlaubstag. Vorabende sind im öffentlichen Dienst nachmittags frei; in der Privatwirtschaft gilt die Regel des Arbeitgebers. Verwaltungsurlaub und betriebliche Brückentage sind nicht enthalten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həftə sonu və rəsmi bayram günləri məzuniyyət tələb etmir; iş gününə düşən yarım günlük ərəfə 0,5 gün məzuniyyət sayılır. Ərəfələr Türkiyədə dövlət qurumlarında günortadan sonra istirahətdir; özəl sektorda işəgötürənin qaydasına baxın. İnzibati məzuniyyət və işəgötürənin verdiyi körpü günləri daxil edilməyib."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتاج عطلات نهاية الأسبوع والعطلات الرسمية إلى إجازة؛ ونصف يوم العشية في يوم عمل يُحسب نصف يوم إجازة. العشية عطلة بعد الظهر في القطاع العام في تركيا؛ وفي القطاع الخاص راجع جهة العمل. ولا تُحتسب الإجازات الإدارية ولا أيام العطلة الإضافية التي تمنحها الشركات لوصل العطل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akhir pekan dan hari libur resmi tidak memerlukan cuti; setengah hari menjelang bayram pada hari kerja dihitung setengah hari cuti. Di sektor publik, hari menjelang bayram libur mulai siang; di sektor swasta, tanyakan kepada pemberi kerja Anda. Cuti administratif dan libur kejepit yang diberikan perusahaan tidak dimasukkan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہفتہ وار چھٹیوں اور سرکاری تعطیلات کے لیے چھٹی نہیں لینی پڑتی؛ کام کے دن آنے والی آدھی چھٹی آدھے دن کی چھٹی شمار ہوتی ہے۔ سرکاری شعبے میں ایسے دن دوپہر کے بعد چھٹی ہوتی ہے؛ نجی شعبے میں اپنے آجر سے پوچھیں۔ انتظامی چھٹیاں اور کمپنیوں کی طرف سے دی جانے والی درمیانی چھٹیاں شامل نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر هفته‌ها و تعطیلات رسمی مرخصی نمی‌خواهند؛ نیمه‌تعطیل پیش از عید در روز کاری نیم روز مرخصی حساب می‌شود. در بخش دولتی این روزها از ظهر تعطیل‌اند؛ در بخش خصوصی از کارفرمای خود بپرسید. مرخصی‌های اداری و تعطیلی‌های بین‌التعطیلین شرکت‌ها در نظر گرفته نشده‌اند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les week-ends et jours fériés ne demandent pas de congé ; une demi-journée de veille en semaine compte pour une demi-journée de congé. Les veilles sont des après-midi libres dans le secteur public ; dans le privé, renseignez-vous auprès de votre employeur. Les congés administratifs et les ponts d’entreprise ne sont pas inclus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выходные и праздники отпуск не нужен; сокращённый канун в будний день считается как полдня отпуска. В госсекторе кануны — свободная вторая половина дня; в частном секторе уточните у работодателя. Административные выходные для госслужащих и корпоративные «мосты» не учтены."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週末と祝日は休暇が不要です。平日にあたる前日の半休は休暇0.5日と数えます。前日は公的機関では午後休みです。民間企業ではお勤め先にご確認ください。行政上の休暇や会社独自の連休は含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주말과 공휴일에는 휴가가 필요 없으며, 평일에 걸친 반일 휴무 전날은 휴가 반나절로 셉니다. 전날은 공공 부문에서 오후 휴무이며 민간 부문은 회사에 확인하세요. 행정 휴무와 회사 자체 연휴는 넣지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周末和公共假日无需请假；落在工作日的节前半天假按半天请假计。公共部门在节日前夕下午放假；私营部门请向雇主确认。不含行政假和公司自定的调休。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kailangan ng leave sa weekend at pista opisyal; kalahating araw ng leave ang bisperas na kalahating araw kapag tumapat sa karaniwang araw. Hapon lang ang walang pasok sa bisperas sa pampublikong sektor; tanungin ang iyong employer sa pribadong sektor. Hindi kasama ang administrative leave at bridge day ng kumpanya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันหยุดสุดสัปดาห์และวันหยุดราชการไม่ต้องลา วันก่อนหยุดครึ่งวันที่ตรงกับวันธรรมดานับเป็นลาครึ่งวัน ภาครัฐหยุดช่วงบ่ายของวันก่อนหยุด ภาคเอกชนให้สอบถามนายจ้าง ไม่รวมวันหยุดพิเศษทางราชการและวันหยุดเชื่อมของบริษัท"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fines de semana y los festivos no requieren permiso; una víspera de media jornada en día laborable cuenta como medio día de permiso. En el sector público las vísperas son libres por la tarde; en el sector privado, consulte con su empleador. No se incluyen permisos administrativos ni puentes de empresa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fins de semana e feriados não exigem licença; uma véspera de meio expediente em dia útil conta como meio dia de licença. No setor público as vésperas são de tarde livre; no setor privado, confirme com o seu empregador. Licenças administrativas e emendas da empresa não estão incluídas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताहांत और सार्वजनिक छुट्टियों पर छुट्टी लेने की ज़रूरत नहीं; कार्यदिवस पर पड़ने वाली आधे दिन की पूर्व संध्या आधे दिन की छुट्टी गिनी जाती है। सरकारी क्षेत्र में पूर्व संध्या पर दोपहर बाद छुट्टी होती है; निजी क्षेत्र में अपने नियोक्ता से पूछें। प्रशासनिक छुट्टी और कंपनी के ब्रिज दिन शामिल नहीं हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাপ্তাহিক ছুটি ও সরকারি ছুটিতে ছুটি নিতে হয় না; কর্মদিবসে পড়া অর্ধদিবস আগের দিন আধা দিনের ছুটি ধরা হয়। সরকারি খাতে আগের দিনের বিকেল ছুটি; বেসরকারি খাতে আপনার প্রতিষ্ঠানের নিয়ম দেখুন। প্রশাসনিক ছুটি ও প্রতিষ্ঠানের সেতু ছুটি অন্তর্ভুক্ত নয়।"
          }
        }
      }
    },
    "bridge.projected": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yılın dini bayram tarihleri Diyanet'in uzun vadeli takvimine dayanır (projeksiyon)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This year's religious holiday dates are based on Diyanet's long-range calendar (projection)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die religiösen Feiertage dieses Jahres beruhen auf dem Langzeitkalender von Diyanet (Hochrechnung)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ilin dini bayram tarixləri Diyanətin uzunmüddətli təqviminə əsaslanır (proqnoz)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعتمد مواعيد الأعياد الدينية لهذه السنة على التقويم بعيد المدى لرئاسة الشؤون الدينية (تقدير)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal hari raya keagamaan tahun ini didasarkan pada kalender jangka panjang Diyanet (proyeksi)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سال کی مذہبی تعطیلات کی تاریخیں دیانت کے طویل مدتی کیلنڈر پر مبنی ہیں (تخمینہ)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ عیدهای مذهبی این سال بر پایهٔ تقویم بلندمدت دیانت است (پیش‌بینی)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates des fêtes religieuses de cette année reposent sur le calendrier à long terme de la Diyanet (projection)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даты религиозных праздников этого года основаны на долгосрочном календаре Diyanet (прогноз)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この年の宗教的な祝日の日付はディヤーネットの長期カレンダーに基づきます（予測）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 해의 종교 공휴일 날짜는 디야넷 장기 달력을 바탕으로 합니다(예상)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一年的宗教节日日期依据迪亚内特的长期日历（预测）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Batay sa pangmatagalang kalendaryo ng Diyanet ang mga petsa ng panrelihiyong holiday ngayong taon (projection)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันหยุดทางศาสนาของปีนี้อิงตามปฏิทินระยะยาวของดียาเนต (คาดการณ์)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas de los festivos religiosos de este año se basan en el calendario a largo plazo de Diyanet (proyección)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas dos feriados religiosos deste ano se baseiam no calendário de longo prazo da Diyanet (projeção)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस साल की धार्मिक छुट्टियों की तारीखें दियानत के दीर्घकालिक कैलेंडर पर आधारित हैं (अनुमान)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বছরের ধর্মীয় ছুটির তারিখ দিয়ানেতের দীর্ঘমেয়াদি ক্যালেন্ডারের ভিত্তিতে (অনুমান)।"
          }
        }
      }
