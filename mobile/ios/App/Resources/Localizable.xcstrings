      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verilmedi. Telefonun ayarlarından açabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission not granted. You can allow it in the phone's settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Berechtigung. Sie können sie in den Einstellungen des Telefons erteilen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcazə verilmədi. Telefonun ayarlarından aça bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُمنح الإذن. يمكنك السماح به من إعدادات الهاتف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin tidak diberikan. Anda dapat mengizinkannya di pengaturan ponsel."
