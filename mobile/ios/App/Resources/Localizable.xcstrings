    "onboard.welcome.whyTitle": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neden ücretsiz?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why free?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum kostenlos?"
          }
        },
