    "cals.coptic.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kıpti tarihi ve Kıpti Ortodoks Kilisesi'nin bayramları: Nayruz, Noel, Epifani ve Paskalya."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Coptic date and the feasts of the Coptic Orthodox Church: Nayrouz, Christmas, Epiphany and Easter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das koptische Datum und die Feste der Koptisch-Orthodoxen Kirche: Nairuz, Weihnachten, Epiphanias und Ostern."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qibti tarixi və Qibti Ortodoks Kilsəsinin bayramları: Nayruz, Milad, Epifaniya və Pasxa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ القبطي وأعياد الكنيسة القبطية الأرثوذكسية: النيروز والميلاد والغطاس والقيامة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal Koptik dan hari raya Gereja Ortodoks Koptik: Nayrouz, Natal, Epifani, dan Paskah."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قبطی تاریخ اور قبطی آرتھوڈوکس کلیسا کے تہوار: نیروز، کرسمس، عیدِ ظہور اور ایسٹر۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ قبطی و اعیاد کلیسای ارتدکس قبطی: نیروز، کریسمس، عید ظهور و عید پاک."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date copte et les fêtes de l’Église copte orthodoxe : Nayrouz, Noël, Épiphanie et Pâques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коптская дата и праздники Коптской православной церкви: Найруз, Рождество, Богоявление и Пасха."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コプト暦の日付と、ナイルーズ、降誕祭、神現祭、復活祭などのコプト正教会の祝祭日。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콥트력 날짜와 나이루즈, 성탄절, 주님 공현, 부활절 등 콥트 정교회 축일."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "科普特历日期，以及奈鲁兹节、圣诞节、主显节和复活节等科普特正教会节日。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang petsang Kopto at mga pista ng Simbahang Ortodoksong Kopto: Nayrouz, Pasko, Epipanya, at Pasko ng Pagkabuhay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ตามปฏิทินคอปติกและเทศกาลของคริสตจักรคอปติกออร์โธดอกซ์ เช่น ไนรูซ คริสต์มาส วันพระคริสต์แสดงองค์ และอีสเตอร์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha copta y las fiestas de la Iglesia ortodoxa copta: Nayrouz, Navidad, Epifanía y Pascua."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A data copta e as festas da Igreja Ortodoxa Copta: Nayrouz, Natal, Epifania e Páscoa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉप्टिक तारीख़ और कॉप्टिक ऑर्थोडॉक्स चर्च के त्योहार: नयरूज़, क्रिसमस, एपिफ़नी और ईस्टर।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কপ্টিক তারিখ ও কপ্টিক অর্থোডক্স গির্জার উৎসব: নায়রুজ, বড়দিন, এপিফ্যানি ও ইস্টার।"
          }
        }
      }
    },
    "cals.coptic.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kıpti yılı Şehitler çağına (MS 284) göre sayılır; aylar Etiyopya takvimiyle aynı günlerde başlar ve yıl 11 Eylül'de (Gregoryen artık yıldan önceki yılda 12 Eylül'de) başlar. Noel 29 Kiyehk'te, artık yıldan sonraki yılda 28 Kiyehk'te tutulur, yani her yıl 7 Ocak'tadır; Paskalya Ortodoks hesabıyladır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coptic years count from the Era of the Martyrs (AD 284); the months begin on the same days as in the Ethiopian calendar, and the year starts on 11 September (12 September in the year before a Gregorian leap year). Christmas is kept on 29 Koiak, or 28 Koiak in the year after a leap year, so it always falls on 7 January; Easter follows the Orthodox reckoning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die koptischen Jahre zählen ab der Ära der Märtyrer (284 n. Chr.); die Monate beginnen an denselben Tagen wie im äthiopischen Kalender, das Jahr am 11. September (im Jahr vor einem gregorianischen Schaltjahr am 12. September). Weihnachten wird am 29. Koiak gefeiert, im Jahr nach einem Schaltjahr am 28. Koiak, also stets am 7. Januar; Ostern folgt der orthodoxen Berechnung."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qibti illəri Şəhidlər dövründən (eramızın 284-cü ili) hesablanır; aylar Efiopiya təqvimi ilə eyni günlərdə başlayır, il isə 11 sentyabrda (Qriqorian uzun ilindən əvvəlki ildə 12 sentyabrda) başlayır. Milad 29 Kiyahkda, uzun ildən sonrakı ildə isə 28 Kiyahkda qeyd olunur, yəni hər il 7 yanvardadır; Pasxa Pravoslav hesabına görədir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب السنوات القبطية من تقويم الشهداء (284م)، وتبدأ الشهور في الأيام نفسها التي تبدأ فيها شهور التقويم الإثيوبي، وتبدأ السنة في 11 سبتمبر (12 سبتمبر في السنة التي تسبق السنة الكبيسة الغريغورية). يُحتفل بعيد الميلاد في 29 كيهك، وفي 28 كيهك في السنة التي تلي السنة الكبيسة، فيقع دائمًا في 7 يناير؛ ويُحسب عيد القيامة بالحساب الأرثوذكسي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahun Koptik dihitung sejak Era Para Martir (284 M); bulan-bulannya dimulai pada hari yang sama dengan kalender Etiopia, dan tahun dimulai pada 11 September (12 September pada tahun sebelum tahun kabisat Gregorius). Natal dirayakan pada 29 Kiahk, atau 28 Kiahk pada tahun setelah tahun kabisat, sehingga selalu jatuh pada 7 Januari; Paskah mengikuti perhitungan Ortodoks."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قبطی سال شہدا کے دور (284ء) سے شمار ہوتے ہیں؛ مہینے انہی دنوں شروع ہوتے ہیں جن دنوں ایتھوپیائی کیلنڈر کے مہینے شروع ہوتے ہیں، اور سال 11 ستمبر کو (گریگوری لیپ سال سے پہلے والے سال میں 12 ستمبر کو) شروع ہوتا ہے۔ کرسمس 29 کیہک کو، اور لیپ سال کے بعد والے سال میں 28 کیہک کو منائی جاتی ہے، اس لیے ہمیشہ 7 جنوری کو آتی ہے؛ ایسٹر آرتھوڈوکس حساب سے ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سال‌های قبطی از دوران شهیدان (284 میلادی) شمرده می‌شوند؛ ماه‌ها در همان روزهای ماه‌های گاه‌شماری اتیوپیایی آغاز می‌شوند و سال در 11 سپتامبر (در سال پیش از سال کبیسهٔ میلادی در 12 سپتامبر) آغاز می‌شود. کریسمس در 29 کیهک و در سال پس از سال کبیسه در 28 کیهک برگزار می‌شود و از این رو همیشه در 7 ژانویه است؛ عید پاک به حساب ارتدکس است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les années coptes sont comptées depuis l’ère des Martyrs (284 apr. J.-C.) ; les mois commencent les mêmes jours que dans le calendrier éthiopien et l’année débute le 11 septembre (le 12 septembre l’année qui précède une année bissextile grégorienne). Noël est célébré le 29 Khoiak, ou le 28 Khoiak l’année qui suit une année bissextile, et tombe donc toujours le 7 janvier ; Pâques suit le comput orthodoxe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коптские годы отсчитываются от эры мучеников (284 год н. э.); месяцы начинаются в те же дни, что и в эфиопском календаре, а год — 11 сентября (12 сентября в год перед григорианским високосным). Рождество празднуется 29 кийяка, а в год после високосного — 28 кийяка, поэтому всегда приходится на 7 января; Пасха — по православной пасхалии."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コプト暦の年は殉教者紀元（284年）から数え、月はエチオピア暦と同じ日に始まり、年は9月11日（グレゴリオ暦の閏年の前年は9月12日）に始まります。降誕祭はコイアック月29日（閏年の翌年は28日）で、常に1月7日にあたり、復活祭は正教会の計算によります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콥트력의 해는 순교자 기원(서기 284년)부터 세며, 달은 에티오피아력과 같은 날에 시작하고 해는 9월 11일(그레고리력 윤년 전해에는 9월 12일)에 시작합니다. 성탄절은 키아크월 29일(윤년 다음 해에는 28일)로 항상 1월 7일이며, 부활절은 정교회 계산법을 따릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "科普特历纪年始于殉道者纪元（公元284年）；各月与埃塞俄比亚历在同一天开始，每年从9月11日开始（格里历闰年的前一年为9月12日）。圣诞节在基亚克月29日，闰年后一年为28日，因此总在1月7日；复活节按东正教算法计算。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binibilang ang mga taong Kopto mula sa Panahon ng mga Martir (284 AD); nagsisimula ang mga buwan sa parehong mga araw ng kalendaryo ng Etiyopiya, at nagsisimula ang taon sa 11 Setyembre (12 Setyembre sa taon bago ang leap year ng Gregoryano). Ipinagdiriwang ang Pasko sa 29 Koiak, o 28 Koiak sa taon pagkatapos ng leap year, kaya laging 7 Enero ito; sinusunod ng Pasko ng Pagkabuhay ang kalkulasyong Ortodokso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปีคอปติกนับจากศักราชมรณสักขี (ค.ศ. 284) เดือนต่าง ๆ เริ่มวันเดียวกับปฏิทินเอธิโอเปีย และปีเริ่มวันที่ 11 กันยายน (12 กันยายนในปีก่อนปีอธิกสุรทินของปฏิทินเกรกอรี) คริสต์มาสตรงกับวันที่ 29 เดือนคียัก หรือวันที่ 28 ในปีถัดจากปีอธิกสุรทิน จึงตรงกับวันที่ 7 มกราคมเสมอ ส่วนอีสเตอร์คำนวณตามแบบออร์โธดอกซ์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los años coptos se cuentan desde la Era de los Mártires (284 d. C.); los meses empiezan los mismos días que en el calendario etíope y el año comienza el 11 de septiembre (el 12 de septiembre en el año anterior a un año bisiesto gregoriano). La Navidad se celebra el 29 de Koiak, o el 28 de Koiak en el año siguiente a un bisiesto, por lo que siempre cae el 7 de enero; la Pascua sigue el cómputo ortodoxo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os anos coptas são contados a partir da Era dos Mártires (284 d.C.); os meses começam nos mesmos dias que no calendário etíope e o ano começa em 11 de setembro (12 de setembro no ano anterior a um ano bissexto gregoriano). O Natal é celebrado em 29 de Koiak, ou 28 de Koiak no ano seguinte a um bissexto, e por isso cai sempre em 7 de janeiro; a Páscoa segue o cálculo ortodoxo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉप्टिक वर्ष शहीदों के युग (284 ई.) से गिने जाते हैं; महीने उन्हीं दिनों शुरू होते हैं जिन दिनों इथियोपियाई कैलेंडर के महीने शुरू होते हैं, और वर्ष 11 सितंबर को (ग्रेगोरियन लीप वर्ष से पहले वाले वर्ष में 12 सितंबर को) शुरू होता है। क्रिसमस 29 कियाक को, और लीप वर्ष के बाद वाले वर्ष में 28 कियाक को मनाया जाता है, इसलिए हमेशा 7 जनवरी को पड़ता है; ईस्टर ऑर्थोडॉक्स गणना से है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কপ্টিক বছর শহীদদের যুগ (284 খ্রিস্টাব্দ) থেকে গোনা হয়; মাসগুলো ইথিওপীয় ক্যালেন্ডারের একই দিনে শুরু হয় এবং বছর 11 সেপ্টেম্বর শুরু হয় (গ্রেগরীয় অধিবর্ষের আগের বছরে 12 সেপ্টেম্বর)। বড়দিন 29 কোইয়াক, বা অধিবর্ষের পরের বছরে 28 কোইয়াক পালিত হয়, তাই সবসময় 7 জানুয়ারি পড়ে; ইস্টার অর্থোডক্স গণনা অনুসরণ করে।"
          }
        }
      }
    },
