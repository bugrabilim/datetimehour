    "features.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat her zaman açık. Açtığınız özellikler Tümü'nde görünür; en çok üçünü alt çubuğa alabilirsiniz. Ayarlar da Tümü'ndedir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is always on. Features you turn on appear in All; you can put up to three of them in the tab bar. Settings are in All too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr ist immer an. Eingeschaltete Funktionen erscheinen unter „Alle“; bis zu drei davon können Sie in die Tableiste legen. Auch die Einstellungen finden Sie unter „Alle“."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat həmişə açıqdır. Açdığınız bölmələr Hamısı səhifəsində görünür; ən çoxu üçünü alt panelə əlavə edə bilərsiniz. Parametrlər də Hamısı səhifəsindədir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة مفعّلة دائمًا. تظهر الميزات التي تفعّلها في «الكل»، ويمكنك وضع ثلاث منها على الأكثر في الشريط السفلي. والإعدادات أيضًا في «الكل»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam selalu aktif. Fitur yang Anda aktifkan muncul di Semua; Anda bisa menaruh hingga tiga di antaranya di bilah bawah. Pengaturan juga ada di Semua."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی ہمیشہ آن رہتی ہے۔ آپ کی آن کی ہوئی خصوصیات «سب» میں نظر آتی ہیں؛ ان میں سے زیادہ سے زیادہ تین نیچے کی پٹی میں رکھ سکتے ہیں۔ ترتیبات بھی «سب» میں ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت همیشه روشن است. ویژگی‌هایی که روشن می‌کنید در «همه» دیده می‌شوند؛ حداکثر سه تا از آن‌ها را می‌توانید در نوار پایین بگذارید. تنظیمات هم در «همه» است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’horloge est toujours active. Les fonctions activées apparaissent dans Tout ; vous pouvez en placer jusqu’à trois dans la barre d’onglets. Les réglages sont aussi dans Tout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы включены всегда. Включённые функции появляются в разделе «Все»; до трёх из них можно вынести на нижнюю панель. Настройки тоже в разделе «Все»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計は常にオンです。オンにした機能は「すべて」に表示され、そのうち3つまでをタブバーに置けます。設定も「すべて」にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계는 항상 켜져 있습니다. 켠 기능은 전체에 나타나며, 그중 최대 3개를 탭 막대에 둘 수 있습니다. 설정도 전체에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时钟始终开启。您开启的功能会显示在“全部”中，最多可以把其中三个放到底部标签栏。设置也在“全部”中。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Laging bukas ang orasan. Lumalabas sa Lahat ang mga feature na binuksan mo; hanggang tatlo sa mga ito ang puwedeng ilagay sa tab bar. Nasa Lahat din ang Settings."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาเปิดอยู่เสมอ ฟีเจอร์ที่เปิดจะแสดงในทั้งหมด และวางได้สูงสุดสามรายการบนแถบแท็บ การตั้งค่าก็อยู่ในทั้งหมด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj está siempre activado. Las funciones que active aparecen en Todo; puede poner hasta tres en la barra de pestañas. Los ajustes también están en Todo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio fica sempre ativado. Os recursos que você ativar aparecem em Tudo; você pode colocar até três deles na barra de abas. Os Ajustes também ficam em Tudo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी हमेशा चालू रहती है। आप जो सुविधाएँ चालू करते हैं वे सब में दिखती हैं; इनमें से अधिकतम तीन को टैब बार में रख सकते हैं। सेटिंग्स भी सब में हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ি সবসময় চালু। আপনি যে বৈশিষ্ট্য চালু করেন তা \"সব\"-এ দেখা যায়; এর মধ্যে তিনটি পর্যন্ত ট্যাব বারে রাখতে পারেন। সেটিংসও \"সব\"-এ আছে।"
          }
        }
      }
    },
    "features.clock.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman açık: 21 saat modeli, tam ekran, saat ekranı alanları"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always on: 21 clock styles, full screen, clock screen items"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer an: 21 Uhrstile, Vollbild, Felder auf dem Uhrbildschirm"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həmişə açıq: 21 saat modeli, tam ekran, saat ekranı sahələri"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفعّلة دائمًا: 21 نمطًا للساعة وملء الشاشة وعناصر شاشة الساعة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu aktif: 21 gaya jam, layar penuh, item layar jam"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہمیشہ آن: گھڑی کے 21 انداز، پوری اسکرین، گھڑی کی اسکرین کی چیزیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همیشه روشن: 21 سبک ساعت، تمام‌صفحه، موارد صفحهٔ ساعت"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours active : 21 styles d’horloge, plein écran, éléments de l’écran de l’horloge"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда включено: 21 стилей часов, полный экран, элементы экрана часов"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常にオン：21種類の時計、全画面、時計画面の項目"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 켜짐: 시계 스타일 21가지, 전체 화면, 시계 화면 항목"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终开启：21种时钟样式、全屏、时钟界面项目"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Laging naka-on: 21 istilo ng orasan, full screen, mga item sa screen ng orasan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเสมอ: นาฬิกา 21 แบบ เต็มจอ รายการบนหน้าจอนาฬิกา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre activado: 21 estilos de reloj, pantalla completa, elementos de la pantalla del reloj"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre ativado: 21 estilos de relógio, tela cheia, itens da tela do relógio"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमेशा चालू: 21 घड़ी शैलियाँ, फ़ुल स्क्रीन, घड़ी स्क्रीन की चीज़ें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবসময় চালু: 21টি ঘড়ির ধরন, পূর্ণ পর্দা, ঘড়ির পর্দার অংশ"
          }
        }
      }
    },
    "features.weather.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlık hava, saatlik ve günlük tahmin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
