    "alarm.riseNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm sesi ilk 30 saniyede kısıktan tam sese çıkar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm sound rises from quiet to full volume over the first 30 seconds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Weckton steigt in den ersten 30 Sekunden von leise auf volle Lautstärke an."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəng səsi ilk 30 saniyədə zəifdən tam səsə qalxır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرتفع صوت المنبه من الهادئ إلى أعلى مستوى خلال أول 30 ثانية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara alarm naik dari pelan ke volume penuh selama 30 detik pertama."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم کی آواز پہلے 30 سیکنڈ میں دھیمی سے پوری بلند ہو جاتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدای هشدار در 30 ثانیهٔ نخست از آهسته به بلندی کامل می‌رسد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son de l’alarme passe de doux à fort pendant les 30 premières secondes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук будильника нарастает от тихого до полного за первые 30 секунд."
          }
        }
      }
    },
    "alarm.riseNoteIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumuşak bir melodi 20 saniyede kısıktan tam sese çıkar; açıkken iPhone'un alarm sesi yerine çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A soft melody rises from quiet to full volume over 20 seconds; when on, it plays instead of the iPhone alarm sound."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sanfte Melodie steigt in 20 Sekunden von leise auf volle Lautstärke an; wenn aktiv, ersetzt sie den iPhone-Weckton."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumşaq bir melodiya 20 saniyədə zəifdən tam səsə qalxır; açıq olanda iPhone-un zəng səsinin yerinə çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحن هادئ يرتفع من الخافت إلى أعلى مستوى خلال 20 ثانية؛ وعند تفعيله يُشغَّل بدل صوت منبه iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melodi lembut naik dari pelan ke volume penuh dalam 20 detik; bila aktif, melodi ini menggantikan suara alarm iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک نرم دھن 20 سیکنڈ میں دھیمی سے پوری بلند ہوتی ہے؛ آن ہو تو آئی فون کی الارم آواز کی جگہ بجتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهنگی ملایم در 20 ثانیه از آهسته به بلندی کامل می‌رسد؛ وقتی روشن است به جای صدای هشدار آیفون پخش می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une douce mélodie monte de doux à fort en 20 secondes ; lorsqu’elle est activée, elle remplace le son d’alarme de l’iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкая мелодия нарастает от тихой до полной громкости за 20 секунд; если включено, она звучит вместо звука будильника iPhone."
          }
        }
      }
    },
    "alarm.skipHolidays": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resmî tatillerde çalmasın"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not on public holidays"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht an Feiertagen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rəsmi bayramlarda çalmasın"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرن في العطلات الرسمية"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak pada hari libur resmi"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرکاری تعطیلات پر نہیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نه در تعطیلات رسمی"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas les jours fériés"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не в праздники"
          }
        }
      }
    },
    "alarm.skipHolidaysNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiye'deki resmî tatillerde (bayramlar dahil) çalmaz; yarım gün arifelerde çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays silent on Turkish public holidays (including the Eids); still rings on half-day eves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt an türkischen gesetzlichen Feiertagen (auch an den Bayram-Festen) still; an halben Vorabend-Tagen klingelt er."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiyədəki rəsmi bayramlarda (bayramlar daxil) çalmır; yarımgünlük bayram ərəfələrində çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرن في العطلات الرسمية في تركيا (ومنها العيدان)؛ ويرن في أيام الوقفة ذات نصف الدوام."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak berbunyi pada hari libur resmi Turki (termasuk hari raya); tetap berbunyi pada setengah hari menjelang hari raya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترکی کی سرکاری تعطیلات (عیدوں سمیت) پر خاموش رہتا ہے؛ عید سے پہلے کی آدھی چھٹی پر بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تعطیلات رسمی ترکیه (از جمله عیدها) زنگ نمی‌زند؛ در نیمه‌تعطیل‌های پیش از عید زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste silencieuse les jours fériés turcs (y compris les Aïds) ; sonne quand même les demi-journées de veille."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Молчит в государственные праздники Турции (включая байрамы); в сокращённые кануны звонит."
          }
        }
      }
    },
