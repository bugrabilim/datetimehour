    "notify.all.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat başı dışında her özelliğin bildirimi varsayılan olarak açıktır; istemediklerinizi buradan kapatabilir, saat başını açabilirsiniz. Bildirimler telefonda hazırlanır; yalnız hava özeti için hava servisine sorulur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications for every feature except on-the-hour are on by default; turn off the ones you don't want, or turn on the hourly one, here. Notifications are prepared on your phone; only the weather summary asks the weather service."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Außer der stündlichen Benachrichtigung sind alle Benachrichtigungen standardmäßig aktiv; schalten Sie hier ab, was Sie nicht möchten, oder aktivieren Sie die stündliche. Sie werden auf dem Telefon erstellt; nur für die Wetterübersicht wird der Wetterdienst abgefragt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat başından başqa hər funksiyanın bildirişi standart olaraq açıqdır; istəmədiklərinizi burada bağlaya, saat başını aça bilərsiniz. Bildirişlər telefonda hazırlanır; yalnız hava xülasəsi üçün hava xidmətinə müraciət olunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعارات كل ميزة مفعّلة افتراضيًا ما عدا إشعار بداية كل ساعة؛ يمكنك هنا إيقاف ما لا تريده أو تفعيل إشعار كل ساعة. تُجهَّز الإشعارات على هاتفك، ولا يُستعلم إلا عن ملخص الطقس من خدمة الطقس."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi untuk semua fitur, kecuali notifikasi setiap jam, aktif secara bawaan; di sini Anda dapat mematikan yang tidak diinginkan atau menyalakan notifikasi setiap jam. Notifikasi disiapkan di ponsel Anda; hanya ringkasan cuaca yang menghubungi layanan cuaca."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر گھنٹے کی اطلاع کے سوا تمام خصوصیات کی اطلاعات بطورِ طے شدہ آن ہیں؛ جو اطلاعات آپ نہیں چاہتے انہیں یہاں بند کریں، یا ہر گھنٹے کی اطلاع آن کریں۔ اطلاعات آپ کے فون پر تیار ہوتی ہیں؛ صرف موسم کے خلاصے کے لیے موسمی سروس سے رابطہ کیا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلان همهٔ ویژگی‌ها به جز اعلان سر هر ساعت به‌طور پیش‌فرض روشن است؛ اینجا می‌توانید اعلان‌هایی را که نمی‌خواهید خاموش کنید یا اعلان ساعتی را روشن کنید. اعلان‌ها روی گوشی شما آماده می‌شوند؛ فقط برای خلاصهٔ آب‌وهوا از سرویس آب‌وهوا داده گرفته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de toutes les fonctions, sauf « Chaque heure », sont activées par défaut ; désactivez ici celles que vous ne voulez pas, ou activez « Chaque heure ». Les notifications sont préparées sur votre téléphone ; seul le résumé météo interroge le service météo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления всех функций, кроме ежечасного, включены по умолчанию; здесь можно выключить ненужные или включить ежечасное. Уведомления готовятся на телефоне; только сводка погоды обращается к погодному сервису."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正時の通知以外、すべての機能の通知が最初からオンです。不要なものはここでオフに、正時の通知はここでオンにできます。通知はスマホ上で準備され、天気のまとめだけが天気サービスに問い合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정각 알림을 빼고 모든 기능의 알림이 기본으로 켜져 있습니다. 원하지 않는 것은 여기서 끄고, 정각 알림은 여기서 켤 수 있습니다. 알림은 휴대폰에서 준비되며 날씨 요약만 날씨 서비스에서 받아 옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除整点报时外，所有功能的通知默认开启；您可以在这里关闭不需要的，或打开整点通知。通知在手机上生成，只有天气摘要会查询天气服务。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-on bilang default ang abiso ng bawat feature maliban sa abiso tuwing eksaktong oras; i-off dito ang mga ayaw mo, o i-on ang abiso tuwing eksaktong oras. Inihahanda sa iyong telepono ang mga abiso; ang buod ng panahon lang ang kumukuha ng datos mula sa weather service."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนของทุกฟีเจอร์เปิดไว้เป็นค่าเริ่มต้น ยกเว้นการแจ้งเตือนทุกต้นชั่วโมง คุณปิดรายการที่ไม่ต้องการหรือเปิดการแจ้งเตือนทุกต้นชั่วโมงได้ที่นี่ การแจ้งเตือนจัดเตรียมบนโทรศัพท์ มีเพียงสรุปสภาพอากาศที่ต้องดึงข้อมูลจากบริการสภาพอากาศ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de todas las funciones salvo las horas en punto están activadas por defecto; aquí puede desactivar las que no quiera o activar la de cada hora. Las notificaciones se preparan en su teléfono; solo el resumen del tiempo consulta el servicio meteorológico."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações de todos os recursos, exceto as horas cheias, vêm ativadas; aqui você desativa as que não quiser ou ativa a de cada hora. As notificações são preparadas no seu celular; só o resumo do tempo consulta o serviço meteorológico."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर घंटे वाली को छोड़कर हर सुविधा की सूचनाएँ डिफ़ॉल्ट रूप से चालू हैं; यहाँ आप अनचाही बंद कर सकते हैं या हर घंटे वाली चालू कर सकते हैं। सूचनाएँ आपके फ़ोन पर बनती हैं; केवल मौसम सारांश मौसम सेवा से पूछता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘণ্টায় ঘণ্টায় ছাড়া প্রতিটি বৈশিষ্ট্যের নোটিফিকেশন শুরুতে চালু থাকে; যেগুলো চান না সেগুলো বন্ধ করুন, বা ঘণ্টায় ঘণ্টায়টি চালু করুন এখান থেকে। নোটিফিকেশন আপনার ফোনেই তৈরি হয়; শুধু আবহাওয়ার সারাংশ আবহাওয়া সেবার কাছে জানতে চায়।"
          }
        }
      }
    },
    "notify.all.limit": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone önceden en çok 64 bildirim kurabilir; liste arka planda ve uygulamayı her açışınızda yenilenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone can schedule at most 64 notifications in advance; the list is refreshed in the background and each time you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone kann höchstens 64 Benachrichtigungen im Voraus planen; die Liste wird im Hintergrund und bei jedem Öffnen der App erneuert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone əvvəlcədən ən çox 64 bildiriş qura bilər; siyahı arxa planda və tətbiqi hər açanda yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لجهاز iPhone جدولة 64 إشعارًا كحد أقصى مسبقًا، وتُحدَّث القائمة في الخلفية وعند كل فتح للتطبيق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone dapat menjadwalkan paling banyak 64 notifikasi di muka; daftarnya diperbarui di latar belakang dan setiap kali aplikasi dibuka."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئی فون زیادہ سے زیادہ 64 اطلاعات پہلے سے طے کر سکتا ہے؛ فہرست پس منظر میں اور ہر بار ایپ کھولنے پر تازہ ہوتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آیفون حداکثر 64 اعلان را از پیش زمان‌بندی می‌کند؛ فهرست در پس‌زمینه و با هر بار باز کردن برنامه تازه می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone peut programmer au plus 64 notifications à l’avance ; la liste est actualisée en arrière-plan et à chaque ouverture de l’app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone может заранее запланировать не более 64 уведомлений; список обновляется в фоне и при каждом открытии приложения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneは前もって最大64件の通知しか予約できません。一覧はバックグラウンドで、またアプリを開くたびに更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone은 미리 최대 64개의 알림만 예약할 수 있습니다. 목록은 백그라운드에서, 그리고 앱을 열 때마다 갱신됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone最多只能提前安排64条通知；列表会在后台以及每次打开应用时更新。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanggang 64 na abiso lang ang maitatakda nang maaga ng iPhone; nire-refresh ang listahan sa background at tuwing bubuksan mo ang app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ตั้งการแจ้งเตือนล่วงหน้าได้สูงสุด 64 รายการ รายการจะรีเฟรชในเบื้องหลังและทุกครั้งที่เปิดแอป"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone puede programar como máximo 64 notificaciones por adelantado; la lista se renueva en segundo plano y cada vez que abre la app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone pode agendar no máximo 64 notificações com antecedência; a lista é renovada em segundo plano e cada vez que você abre o app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone पहले से अधिकतम 64 सूचनाएँ तय कर सकता है; सूची बैकग्राउंड में और हर बार ऐप खोलने पर नई होती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone আগে থেকে সর্বোচ্চ 64টি নোটিফিকেশন নির্ধারণ করতে পারে; তালিকাটি পটভূমিতে এবং প্রতিবার অ্যাপ খুললে নতুন হয়।"
          }
        }
      }
    },
