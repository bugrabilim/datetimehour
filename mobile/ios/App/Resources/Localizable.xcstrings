    "list.formErr": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydınız alınamadı. E-posta adresinizi kontrol edip biraz sonra tekrar deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not sign you up. Check your email address and try again a little later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung hat nicht geklappt. Prüfen Sie Ihre E-Mail-Adresse und versuchen Sie es etwas später erneut."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeydiyyatınızı tamamlamaq mümkün olmadı. E-poçt ünvanınızı yoxlayıb bir az sonra yenidən cəhd edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تسجيلك. تحقّق من عنوان بريدك الإلكتروني وحاول مرة أخرى بعد قليل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaftaran gagal. Periksa alamat email Anda lalu coba lagi nanti."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رکنیت نہیں ہو سکی۔ اپنا ای میل پتہ چیک کریں اور کچھ دیر بعد دوبارہ کوشش کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عضویت انجام نشد. نشانی ایمیل خود را بررسی کنید و کمی بعد دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre inscription a échoué. Vérifiez votre adresse e-mail et réessayez un peu plus tard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось оформить подписку. Проверьте адрес электронной почты и попробуйте чуть позже."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録できませんでした。メールアドレスを確認し、少し後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독하지 못했습니다. 이메일 주소를 확인하고 잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法为您订阅。请检查电子邮箱，稍后再试。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ka namin maisali. Tingnan ang iyong email address at subukan muli mamaya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการสมัครไม่ได้ โปรดตรวจสอบอีเมลของคุณแล้วลองอีกครั้งในอีกสักครู่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos suscribirle. Revise su dirección de correo y vuelva a intentarlo un poco más tarde."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos inscrever você. Confira seu endereço de e-mail e tente de novo um pouco mais tarde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपको नहीं जोड़ सके। अपना ईमेल पता जाँचें और थोड़ी देर बाद फिर कोशिश करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাকে যুক্ত করা যায়নি। ইমেইল ঠিকানা দেখে একটু পরে আবার চেষ্টা করুন।"
          }
        }
      }
    },
