    "alarm.sunNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat her gün %1$@ için hesaplanır. Sıradaki: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time is worked out every day for %1$@. Next: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeit wird jeden Tag für %1$@ berechnet. Nächste: %2$@"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat hər gün %1$@ üçün hesablanır. Növbəti: %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحسب الوقت كل يوم لـ %1$@. التالي: %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktunya dihitung setiap hari untuk %1$@. Berikutnya: %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت روزانہ %1$@ کے لیے نکالا جاتا ہے۔ اگلا: %2$@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان هر روز برای %1$@ حساب می‌شود. بعدی: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'heure est calculée chaque jour pour %1$@. Prochaine : %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время рассчитывается каждый день для места «%1$@». Следующий: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻は毎日 %1$@ について計算されます。次回：%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간은 매일 %1$@ 기준으로 계산됩니다. 다음: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间每天按%1$@计算。下次：%2$@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinukuwenta ang oras araw-araw para sa %1$@. Susunod: %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำนวณเวลาทุกวันสำหรับ %1$@ ครั้งถัดไป: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora se calcula cada día para %1$@. Siguiente: %2$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário é calculado todo dia para %1$@. Próximo: %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय हर दिन %1$@ के लिए निकाला जाता है। अगला: %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়টি প্রতিদিন %1$@-এর জন্য হিসাব করা হয়। পরেরটি: %2$@"
          }
        }
      }
    },
    "alarm.sunNone": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerde güneş bugünlerde doğmuyor ya da batmıyor; alarm o günlerde çalmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun does not rise or set here at this time of year; the alarm skips those days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier geht die Sonne an manchen dieser Tage nicht auf oder unter; an diesen Tagen klingelt der Wecker nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada bu günlərdə günəş çıxmır və ya batmır; həmin günlərdə zəngli saat çalmır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشرق الشمس أو لا تغرب هنا في بعض هذه الأيام، فلا يرن المنبه فيها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di sini matahari tidak terbit atau terbenam pada beberapa hari ini; alarm tidak berbunyi pada hari itu."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں ان دنوں سورج طلوع یا غروب نہیں ہوتا؛ ان دنوں الارم نہیں بجے گا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در این روزها اینجا خورشید طلوع یا غروب نمی‌کند؛ هشدار در آن روزها زنگ نمی‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici, le soleil ne se lève ou ne se couche pas certains de ces jours ; l'alarme ne sonne pas ces jours-là."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь в некоторые из этих дней солнце не восходит или не заходит; в эти дни будильник не звонит."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この場所では日の出や日の入りがない日があり、その日はアラームが鳴りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이곳은 해가 뜨거나 지지 않는 날이 있어 그날에는 알람이 울리지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此地这些天有时太阳不升起或不落下，那些天闹钟不会响。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May mga araw dito na hindi sumisikat o lumulubog ang araw; hindi tutunog ang alarma sa mga araw na iyon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บางวันที่นี่พระอาทิตย์ไม่ขึ้นหรือไม่ตก นาฬิกาปลุกจะไม่ดังในวันเหล่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí el sol no sale o no se pone algunos de estos días; la alarma se salta esos días."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui o sol não nasce ou não se põe em alguns desses dias; o alarme pula esses dias."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ इनमें से कुछ दिनों सूरज न उगता है न डूबता है; अलार्म उन दिनों को छोड़ देता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বছরের এই সময়ে এখানে সূর্য ওঠে না বা অস্ত যায় না; অ্যালার্ম ওই দিনগুলো বাদ দেয়।"
          }
        }
      }
    },
