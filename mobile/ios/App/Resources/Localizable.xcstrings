            "value": "کارهای خاموش کردن در iOS 26 و بعد از آن کار می‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches d’arrêt fonctionnent sous iOS 26 et ultérieur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задания для отключения работают в iOS 26 и новее."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止の課題はiOS 26以降で使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄기 미션은 iOS 26 이상에서 작동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭任务需要iOS 26或更高版本。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagana ang gawaing pampatay sa iOS 26 at mas bago."
          }
