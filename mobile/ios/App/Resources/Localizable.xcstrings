    "alarm.wakeCheck.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapattıktan 5 dakika sonra \"Uyanık mısınız?\" bildirimi gelir; 2 dakika içinde dokunmazsanız alarm yeniden çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes after you turn it off, an \"Are you awake?\" notification arrives; if you don't tap it within 2 minutes, the alarm rings again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Minuten nach dem Ausschalten kommt eine Mitteilung „Sind Sie wach?“; tippen Sie nicht innerhalb von 2 Minuten darauf, klingelt der Wecker erneut."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Söndürdükdən 5 dəqiqə sonra \"Oyaqsınız?\" bildirişi gəlir; 2 dəqiqə ərzində toxunmasanız zəng yenidən çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد 5 دقائق من الإيقاف يصل إشعار \"هل أنت مستيقظ؟\"؛ وإن لم تلمسه خلال دقيقتين يرنّ المنبّه مجددًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lima menit setelah Anda mematikan alarm, notifikasi \"Sudah bangun?\" datang; jika tidak diketuk dalam 2 menit, alarm berbunyi lagi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بند کرنے کے پانچ منٹ بعد «کیا آپ جاگ رہے ہیں؟» اطلاع آتی ہے؛ اگر 2 منٹ میں اس پر ٹیپ نہ کریں تو الارم پھر بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنج دقیقه پس از خاموش کردن، اعلان «بیدارید؟» می‌رسد؛ اگر تا 2 دقیقه روی آن نزنید، هشدار دوباره زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq minutes après l’arrêt, une notification « Êtes-vous réveillé ? » arrive ; si vous ne la touchez pas dans les 2 minutes, l’alarme sonne de nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через пять минут после выключения придёт уведомление «Вы проснулись?»; если не нажать его в течение 2 минут, будильник зазвонит снова."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "止めてから5分後に「起きていますか？」の通知が届きます。2分以内にタップしないとアラームがまた鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끈 지 5분 뒤 \"깨어 있나요?\" 알림이 옵니다. 2분 안에 누르지 않으면 알람이 다시 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭闹钟5分钟后会收到“醒了吗？”通知；如果2分钟内没有轻点，闹钟会再次响起。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Limang minuto pagkatapos mo itong patayin, darating ang abisong \"Gising ka na ba?\"; kung hindi mo ito ma-tap sa loob ng 2 minuto, tutunog muli ang alarma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้านาทีหลังปิด จะมีการแจ้งเตือน \"ตื่นหรือยัง?\" หากไม่แตะภายใน 2 นาที นาฬิกาปลุกจะดังอีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco minutos después de apagarla llega una notificación \"¿Está despierto?\"; si no la toca en 2 minutos, la alarma vuelve a sonar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco minutos depois de desligar, chega uma notificação \"Você está acordado?\"; se não tocar nela em 2 minutos, o alarme toca de novo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद करने के पाँच मिनट बाद \"क्या आप जागे हुए हैं?\" सूचना आती है; 2 मिनट में उस पर टैप न करें तो अलार्म फिर बजता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ করার পাঁচ মিনিট পর একটি \"আপনি কি জেগে আছেন?\" নোটিফিকেশন আসে; 2 মিনিটের মধ্যে না চাপলে অ্যালার্ম আবার বাজে।"
          }
        }
      }
    },
