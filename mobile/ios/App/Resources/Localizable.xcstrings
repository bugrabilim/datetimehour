    "account.cbText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş için yalnız zorunlu bir oturum çerezi kullanılır. İzninizle ziyaretler Umami ile sayılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a necessary session cookie is used for signing in. With your permission, visits are counted with Umami."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Anmeldung wird nur ein notwendiges Sitzungs-Cookie verwendet. Mit Ihrer Erlaubnis werden Besuche mit Umami gezählt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş üçün yalnız zəruri sessiya kukisi istifadə olunur. İcazənizlə ziyarətlər Umami ilə sayılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُستخدم لتسجيل الدخول إلا ملف ارتباط ضروري للجلسة. وبإذنك تُحصى الزيارات عبر Umami."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk masuk hanya digunakan cookie sesi yang diperlukan. Dengan izin Anda, kunjungan dihitung dengan Umami."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن ان کے لیے صرف ایک ضروری سیشن کوکی استعمال ہوتی ہے۔ آپ کی اجازت سے دوروں کو Umami سے گنا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ورود فقط یک کوکی ضروری نشست به کار می‌رود. با اجازهٔ شما بازدیدها با Umami شمرده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un cookie de session nécessaire est utilisé pour la connexion. Avec votre accord, les visites sont comptées avec Umami."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для входа используется только необходимый сеансовый cookie. С вашего разрешения посещения считаются с помощью Umami."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインには必要なセッション Cookie だけを使います。許可があれば、訪問を Umami で集計します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인에는 필수 세션 쿠키만 사용합니다. 허락하시면 방문을 Umami로 집계합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录只使用一个必要的会话 Cookie。经您允许，访问会通过 Umami 统计。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang kailangang session cookie lang ang ginagamit para sa sign-in. Kapag pumayag kayo, binibilang ang mga pagbisita gamit ang Umami."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้ใช้เพียงคุกกี้เซสชันที่จำเป็น เมื่อได้รับอนุญาต จะนับการเข้าชมด้วย Umami"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iniciar sesión solo se usa una cookie de sesión necesaria. Con su permiso, las visitas se cuentan con Umami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para entrar, só é usado um cookie de sessão necessário. Com sua permissão, as visitas são contadas com o Umami."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन के लिए सिर्फ़ एक ज़रूरी सत्र कुकी इस्तेमाल होती है। आपकी अनुमति से विज़िट Umami से गिनी जाती हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইন ইনের জন্য শুধু একটি প্রয়োজনীয় সেশন কুকি ব্যবহার হয়। আপনার অনুমতিতে ভিজিট Umami দিয়ে গোনা হয়।"
          }
        }
      }
    },
    "account.cbNecessaryText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üye oturumunuz (yalnız sunucunun okuduğu bir çerez), çerez seçiminiz ve tema bu tarayıcıda tutulur. Bunlarsız giriş yapılamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your member session (a cookie only the server reads), your cookie choice and theme are kept in this browser. You can't sign in without them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Mitgliedssitzung (ein Cookie, das nur der Server liest), Ihre Cookie-Auswahl und das Design werden in diesem Browser gespeichert. Ohne sie ist keine Anmeldung möglich."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzv sessiyanız (yalnız serverin oxuduğu kuki), kuki seçiminiz və mövzu bu brauzerdə saxlanılır. Bunlarsız daxil olmaq mümkün deyil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ جلسة عضويتك (ملف ارتباط لا يقرؤه إلا الخادم) واختيارك لملفات الارتباط والمظهر في هذا المتصفح. لا يمكن تسجيل الدخول بدونها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi anggota Anda (cookie yang hanya dibaca server), pilihan cookie, dan tema disimpan di peramban ini. Tanpa itu Anda tidak dapat masuk."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا رکنیت سیشن (ایک کوکی جسے صرف سرور پڑھتا ہے)، کوکی کا انتخاب اور تھیم اس براؤزر میں رکھے جاتے ہیں۔ ان کے بغیر سائن ان نہیں ہو سکتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشست عضویت شما (کوکی‌ای که فقط سرور می‌خواند)، انتخاب کوکی و پوسته در این مرورگر نگه داشته می‌شوند. بدون آن‌ها نمی‌توان وارد شد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session de membre (un cookie que seul le serveur lit), votre choix de cookies et le thème sont conservés dans ce navigateur. Sans eux, la connexion est impossible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сеанс участника (cookie, который читает только сервер), выбор cookie и тема хранятся в этом браузере. Без них войти нельзя."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会員セッション（サーバーだけが読む Cookie）、Cookie の選択、テーマはこのブラウザに保存されます。これがないとログインできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회원 세션(서버만 읽는 쿠키), 쿠키 선택, 테마가 이 브라우저에 저장됩니다. 이것이 없으면 로그인할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的会员会话（仅服务器读取的 Cookie）、Cookie 选择和主题保存在此浏览器中。没有它们就无法登录。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakatago sa browser na ito ang inyong member session (cookie na server lang ang bumabasa), ang inyong pagpili ng cookie at ang tema. Hindi kayo makakapag-sign in kung wala ang mga ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันสมาชิก (คุกกี้ที่มีเพียงเซิร์ฟเวอร์อ่าน) การเลือกคุกกี้ และธีมจะเก็บไว้ในเบราว์เซอร์นี้ หากไม่มีจะลงชื่อเข้าใช้ไม่ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su sesión de miembro (una cookie que solo lee el servidor), su elección de cookies y el tema se guardan en este navegador. Sin ellos no se puede iniciar sesión."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão de membro (um cookie que só o servidor lê), sua escolha de cookies e o tema ficam neste navegador. Sem eles não é possível entrar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सदस्य सत्र (एक कुकी जिसे सिर्फ़ सर्वर पढ़ता है), कुकी का चुनाव और थीम इस ब्राउज़र में रखे जाते हैं। इनके बिना साइन इन नहीं हो सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সদস্য সেশন (একটি কুকি যা শুধু সার্ভার পড়ে), কুকি বাছাই ও থিম এই ব্রাউজারে রাখা হয়। এগুলো ছাড়া সাইন ইন করা যায় না।"
          }
        }
      }
    },
