        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завтра будет заметно холоднее, чем сегодня: максимум ниже на %1$@°."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日は今日よりかなり寒くなります。最高気温は%1$@°低下。"
