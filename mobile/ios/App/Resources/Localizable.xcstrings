    "tools.alarm.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm saatini ve istediğiniz günleri seçin; saat gelince sesli uyarı çalar ve bildirim gösterilir. Alarmlar bu cihazda saklanır. Tarayıcı kısıtı nedeniyle alarm yalnızca bu sayfa (sekme) açıkken çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an alarm time and the days you want; when the time comes a sound plays and a notification appears. Alarms are stored on this device. Because of browser limits, the alarm only rings while this page (tab) stays open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Weckzeit und die gewünschten Tage; zur eingestellten Zeit ertönt ein Ton und eine Benachrichtigung erscheint. Wecker werden auf diesem Gerät gespeichert. Wegen Einschränkungen des Browsers klingelt der Wecker nur, solange diese Seite (der Tab) geöffnet bleibt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəng vaxtını və istədiyiniz günləri seçin; vaxt çatanda səs çalınır və bildiriş görünür. Zəngli saatlar bu cihazda saxlanılır. Brauzer məhdudiyyətlərinə görə zəngli saat yalnız bu səhifə (tab) açıq qaldıqda çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر وقت المنبّه والأيام التي تريدها؛ وعند حلول الوقت يُشغَّل صوت ويظهر إشعار. وتُحفظ المنبّهات على هذا الجهاز. وبسبب قيود المتصفحات لا يرنّ المنبّه إلا ما دامت هذه الصفحة (التبويب) مفتوحة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih waktu alarm dan hari yang diinginkan; saat waktunya tiba suara berbunyi dan notifikasi muncul. Alarm disimpan di perangkat ini. Karena batasan peramban, alarm hanya berbunyi selama halaman (tab) ini tetap terbuka."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم کا وقت اور مطلوبہ دن منتخب کریں؛ وقت آنے پر آواز بجتی ہے اور اطلاع ظاہر ہوتی ہے۔ الارم اسی آلے پر محفوظ ہوتے ہیں۔ براؤزر کی پابندیوں کی وجہ سے الارم صرف تب بجتا ہے جب یہ صفحہ (ٹیب) کھلا رہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت زنگ و روزهای دلخواه را انتخاب کنید؛ سر وقت صدایی پخش و اعلانی نمایش داده می‌شود. زنگ‌ها روی همین دستگاه ذخیره می‌شوند. به‌خاطر محدودیت مرورگرها، زنگ فقط تا وقتی این صفحه (زبانه) باز است به صدا درمی‌آید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’heure de l’alarme et les jours voulus ; à l’heure dite, un son retentit et une notification s’affiche. Les alarmes sont enregistrées sur cet appareil. En raison des limites des navigateurs, l’alarme ne sonne que si cette page (onglet) reste ouverte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите время и нужные дни; в назначенное время прозвучит сигнал и появится уведомление. Будильники сохраняются на этом устройстве. Из-за ограничений браузеров будильник звонит, только пока эта страница (вкладка) открыта."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームの時刻と曜日を選ぶと、その時刻に音が鳴り通知が表示されます。アラームはこの端末に保存されます。ブラウザの制限により、このページ（タブ）を開いている間だけ鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 시간과 원하는 요일을 고르면 그 시간에 소리가 울리고 알림이 나타납니다. 알람은 이 기기에 저장됩니다. 브라우저 제한 때문에 이 페이지(탭)가 열려 있는 동안에만 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择闹钟时间和需要的日子，到时会播放声音并显示通知。闹钟保存在此设备上。由于浏览器限制，只有在此页面（标签页）保持打开时闹钟才会响。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng oras ng alarma at mga araw na gusto mo; pagdating ng oras, tutunog ito at lalabas ang notification. Naka-save ang mga alarma sa device na ito. Dahil sa limitasyon ng browser, tumutunog lang ang alarma habang bukas ang pahinang ito (tab)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเวลาปลุกและวันที่ต้องการ เมื่อถึงเวลาจะมีเสียงและการแจ้งเตือน นาฬิกาปลุกเก็บไว้ในอุปกรณ์นี้ เนื่องจากข้อจำกัดของเบราว์เซอร์ นาฬิกาปลุกจะดังเฉพาะขณะเปิดหน้านี้ (แท็บ) ไว้"
          }
        }
      }
    },
