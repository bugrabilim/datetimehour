    "kidsmoon.q3a": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş ile Dünya'nın arasında|Dünya'nın, Güneş'e göre öbür yanında|Güneş'in arkasında"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Between the Sun and the Earth|On the far side of the Earth from the Sun|Behind the Sun"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen Sonne und Erde|Auf der sonnenabgewandten Seite der Erde|Hinter der Sonne"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Günəşlə Yerin arasında|Yerin Günəşə görə o biri tərəfində|Günəşin arxasında"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بين الشمس والأرض|في الجهة المقابلة للشمس من الأرض|خلف الشمس"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di antara Matahari dan Bumi|Di sisi Bumi yang berseberangan dengan Matahari|Di belakang Matahari"
