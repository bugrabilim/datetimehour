    "list.consentText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aydınlatma metnini okudum, e-posta almayı kabul ediyorum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read the privacy notice and agree to receive emails."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe den Datenschutzhinweis gelesen und bin mit dem Erhalt von E-Mails einverstanden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatlandırma mətnini oxudum, e-poçt almağa razıyam."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرأت إشعار الخصوصية وأوافق على تلقي رسائل البريد الإلكتروني."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah membaca pemberitahuan privasi dan setuju menerima email."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں نے رازداری نوٹس پڑھ لیا ہے اور ای میلز وصول کرنے پر رضامند ہوں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعیهٔ حریم خصوصی را خوانده‌ام و با دریافت ایمیل موافقم."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai lu la notice d’information et j’accepte de recevoir des e-mails."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я прочитал(а) уведомление о конфиденциальности и согласен(на) получать письма."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーに関するお知らせを読み、メールの受信に同意します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 안내를 읽었으며 이메일 수신에 동의합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已阅读隐私说明，同意接收电子邮件。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabasa ko ang paunawa sa privacy at pumapayag akong makatanggap ng email."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันได้อ่านประกาศความเป็นส่วนตัวแล้วและยินยอมรับอีเมล"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He leído el aviso de privacidad y acepto recibir correos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Li o aviso de privacidade e concordo em receber e-mails."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने गोपनीयता सूचना पढ़ ली है और ईमेल पाने के लिए सहमत हूँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি গোপনীয়তা বিজ্ঞপ্তি পড়েছি এবং ইমেইল পেতে সম্মত।"
          }
        }
      }
    },
    "list.accept": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabul ediyorum"
          }
        },
        "en": {
