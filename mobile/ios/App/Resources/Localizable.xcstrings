            "value": "Alarme à l’heure de la prière"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильник на время намаза"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拝時刻にアラーム"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도 시간 알람"
          }
        },
        "zh-Hans": {
