    "wake.speak.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonda cihaz içi konuşma tanıma yok; yazma görevine geçildi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has no on-device speech recognition; switched to the typing task."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon hat keine Spracherkennung auf dem Gerät; zur Tippaufgabe gewechselt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonda cihaz daxilində nitq tanıma yoxdur; yazma tapşırığına keçildi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم هذا الهاتف التعرف على الكلام على الجهاز؛ تم الانتقال إلى مهمة الكتابة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel ini tidak punya pengenalan suara di perangkat; beralih ke tugas mengetik."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فون میں آلے پر آواز کی شناخت نہیں؛ ٹائپنگ کام پر منتقل کر دیا گیا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این گوشی تشخیص گفتار روی دستگاه ندارد؛ به کار تایپ رفت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone n'a pas de reconnaissance vocale sur l'appareil ; passage à la saisie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом телефоне нет распознавания речи на устройстве; переход к набору текста."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にはオンデバイス音声認識がないため、入力タスクに切り替えました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에는 기기 내 음성 인식이 없어 입력 과제로 바꿨습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机不支持设备端语音识别；已切换为输入任务。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang on-device na speech recognition ang teleponong ito; lumipat sa typing task."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์นี้ไม่มีการจดจำเสียงในเครื่อง จึงเปลี่ยนเป็นงานพิมพ์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no tiene reconocimiento de voz en el dispositivo; se ha cambiado a la tarea de escribir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este celular não tem reconhecimento de voz no aparelho; mudamos para a tarefa de digitar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन में डिवाइस पर आवाज़ पहचान नहीं है; टाइप करने वाला काम चुना गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনে ডিভাইসে কথা চেনার ব্যবস্থা নেই; টাইপ করার কাজে বদলানো হয়েছে।"
          }
        }
      }
    },
    "wake.speak.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses yalnız telefonda tanınır, kaydedilmez ve hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech is recognised only on the phone, not recorded and not sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache wird nur auf dem Telefon erkannt, nicht aufgezeichnet und nirgendwohin gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səs yalnız telefonda tanınır, yazılmır və heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُتعرَّف على الكلام على الهاتف فقط، ولا يُسجَّل ولا يُرسل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara hanya dikenali di ponsel, tidak direkam dan tidak dikirim."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آواز صرف فون پر پہچانی جاتی ہے، ریکارڈ نہیں ہوتی اور کہیں نہیں بھیجی جاتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدا فقط روی گوشی شناخته می‌شود، ضبط و ارسال نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix est reconnue uniquement sur le téléphone, ni enregistrée ni envoyée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Речь распознаётся только на телефоне, не записывается и никуда не отправляется."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は端末内でのみ認識され、録音も送信もされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성은 휴대폰에서만 인식되며 녹음되거나 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音仅在手机上识别，不录音也不发送。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinikilala lang ang boses sa telepono, hindi nire-record at hindi ipinapadala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงถูกจดจำในโทรศัพท์เท่านั้น ไม่ถูกบันทึกและไม่ถูกส่ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz se reconoce solo en el teléfono; no se graba ni se envía a ningún sitio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A fala é reconhecida só no celular; não é gravada nem enviada para lugar nenhum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ सिर्फ़ फ़ोन पर पहचानी जाती है, न रिकॉर्ड होती है न कहीं भेजी जाती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কথা শুধু ফোনেই চেনা হয়, রেকর্ড বা কোথাও পাঠানো হয় না।"
          }
        }
      }
    },
