    "perm.notify.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz vakitlerini, alarmları ve hatırlatmaları zamanında haber verebilmemiz için bildirim izni gerekir. İstemediğiniz bildirimi Ayarlar › Bildirimler'den kapatabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need notification permission to tell you about prayer times, alarms and reminders on time. You can turn off any notification you don't want in Settings › Notifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wir Ihnen Gebetszeiten, Wecker und Erinnerungen rechtzeitig melden können, brauchen wir die Mitteilungsberechtigung. Unerwünschte Mitteilungen schalten Sie unter Einstellungen › Benachrichtigungen aus."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz vaxtlarını, zəngli saatları və xatırlatmaları vaxtında bildirə bilməyimiz üçün bildiriş icazəsi lazımdır. İstəmədiyiniz bildirişi Parametrlər › Bildirişlər bölməsindən söndürə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحتاج إذن الإشعارات لننبهك إلى مواقيت الصلاة والمنبهات والتذكيرات في وقتها. يمكنك إيقاف أي إشعار لا تريده من الإعدادات › الإشعارات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami memerlukan izin notifikasi agar dapat memberi tahu waktu salat, alarm, dan pengingat tepat waktu. Notifikasi yang tidak Anda inginkan dapat dimatikan di Pengaturan › Notifikasi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز کے اوقات، الارم اور یاد دہانیاں وقت پر بتانے کے لیے ہمیں اطلاعات کی اجازت درکار ہے۔ جو اطلاع آپ نہ چاہیں اسے ترتیبات › اطلاعات سے بند کر سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای اینکه اوقات نماز، زنگ‌ها و یادآوری‌ها را به‌موقع خبر دهیم، به اجازه اعلان نیاز داریم. هر اعلانی را که نمی‌خواهید از تنظیمات › اعلان‌ها خاموش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons besoin de l'autorisation des notifications pour vous prévenir à temps des heures de prière, des alarmes et des rappels. Vous pouvez désactiver celles que vous ne voulez pas dans Réglages › Notifications."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на уведомления нужно, чтобы вовремя сообщать о времени намаза, будильниках и напоминаниях. Ненужные уведомления можно отключить в разделе «Настройки › Уведомления»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拝時刻やアラーム、リマインダーを時間どおりにお知らせするには通知の許可が必要です。不要な通知は 設定 › 通知 でオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도 시간, 알람, 알림을 제때 알려 드리려면 알림 권한이 필요합니다. 원하지 않는 알림은 설정 › 알림에서 끌 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们需要通知权限，以便按时提醒您礼拜时间、闹钟和提醒事项。不需要的通知可以在“设置 › 通知”中关闭。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan namin ng pahintulot sa notification para maipaalam sa oras ang mga oras ng pagdarasal, alarm at paalala. Mapapatay mo ang ayaw mong notification sa Mga Setting › Mga Notification."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราต้องการสิทธิ์การแจ้งเตือนเพื่อแจ้งเวลาละหมาด นาฬิกาปลุก และการเตือนความจำได้ตรงเวลา คุณปิดการแจ้งเตือนที่ไม่ต้องการได้ที่ การตั้งค่า › การแจ้งเตือน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitamos permiso de notificaciones para avisarle a tiempo de los horarios de oración, las alarmas y los recordatorios. Puede desactivar las que no quiera en Ajustes › Notificaciones."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisamos da permissão de notificações para avisar você na hora sobre horários de oração, alarmes e lembretes. Você pode desativar as que não quiser em Ajustes › Notificações."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमाज़ के समय, अलार्म और रिमाइंडर समय पर बताने के लिए हमें सूचना की अनुमति चाहिए। अनचाही सूचनाएँ आप सेटिंग्स › सूचनाएँ में बंद कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজের সময়, অ্যালার্ম ও রিমাইন্ডার সময়মতো জানাতে নোটিফিকেশনের অনুমতি দরকার। যে নোটিফিকেশন চান না তা সেটিংস › নোটিফিকেশনে বন্ধ করতে পারেন।"
          }
        }
      }
    },
