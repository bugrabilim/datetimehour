    "geo.none": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz konum hatırlatıcısı yok. + ile bir yer seçin; oraya varınca ya da oradan ayrılınca uyarılırsınız."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No location reminders yet. Choose a place with +; you are alerted when you arrive there or leave it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Ortserinnerungen. Wählen Sie mit + einen Ort; Sie werden beim Ankommen oder Verlassen benachrichtigt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ məkan xatırladıcısı yoxdur. + ilə yer seçin; ora çatanda ya da oradan ayrılanda xəbərdar olunursunuz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تذكيرات بالموقع بعد. اختر مكانًا بـ+؛ وستُنبَّه عند الوصول إليه أو مغادرته."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada pengingat lokasi. Pilih tempat dengan +; Anda diberi tahu saat tiba di sana atau meninggalkannya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی مقام کی یاد دہانی نہیں۔ + سے جگہ چنیں؛ وہاں پہنچنے یا نکلنے پر آپ کو اطلاع ملے گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز یادآور مکانی ندارید. با + مکانی برگزینید؛ هنگام رسیدن به آن یا ترکش آگاه می‌شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun rappel de lieu. Choisissez un lieu avec + ; vous êtes averti à votre arrivée ou à votre départ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминаний по месту пока нет. Выберите место кнопкой +; вы получите сигнал при прибытии или уходе."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所のリマインダーはまだありません。＋で場所を選ぶと、そこに着いたときや離れたときに知らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 위치 미리 알림이 없습니다. +로 장소를 고르면 그곳에 도착하거나 떠날 때 알려 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有位置提醒。用+选择一个地点；到达或离开时会提醒您。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang paalala ayon sa lokasyon. Pumili ng lugar gamit ang +; aabisuhan ka kapag dumating ka o umalis doon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีการเตือนตามสถานที่ เลือกสถานที่ด้วย + แล้วจะแจ้งเมื่อคุณมาถึงหรือออกจากที่นั่น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay recordatorios por ubicación. Elija un lugar con +; le avisaremos al llegar o al salir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há lembretes por local. Escolha um lugar com +; você é avisado ao chegar ou sair dele."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई स्थान रिमाइंडर नहीं। + से कोई जगह चुनें; वहाँ पहुँचने या निकलने पर आपको सूचना मिलेगी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো অবস্থানভিত্তিক রিমাইন্ডার নেই। + দিয়ে একটি জায়গা বাছুন; সেখানে পৌঁছালে বা ছেড়ে গেলে আপনাকে জানানো হবে।"
          }
        }
      }
    },
