    "tools.countdown.shareNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz tarihe ait bağlantıyı paylaşabilirsiniz; bağlantı açılınca sayım kendiliğinden başlar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can share the link for the date you picked; the countdown starts by itself when the link is opened."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können den Link zum gewählten Datum teilen; beim Öffnen des Links startet der Countdown automatisch."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçdiyiniz tarixin keçidini paylaşa bilərsiniz; keçid açılanda geriyə sayım avtomatik başlayır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك مشاركة رابط التاريخ الذي اخترته؛ ويبدأ العدّ التنازلي تلقائيًا عند فتح الرابط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat membagikan tautan tanggal yang dipilih; hitung mundur dimulai sendiri saat tautan dibuka."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ منتخب تاریخ کا لنک شیئر کر سکتے ہیں؛ لنک کھلنے پر الٹی گنتی خود شروع ہو جاتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌توانید پیوند تاریخ انتخابی را به اشتراک بگذارید؛ با باز شدن پیوند شمارش خودش آغاز می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez partager le lien de la date choisie ; le compte à rebours démarre tout seul à l’ouverture du lien."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылкой на выбранную дату можно поделиться; при открытии ссылки отсчёт начнётся сам."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ日付のリンクを共有できます。リンクを開くとカウントダウンが自動で始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 날짜의 링크를 공유할 수 있습니다. 링크를 열면 카운트다운이 자동으로 시작됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以分享所选日期的链接；打开链接时倒计时会自动开始。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maibabahagi mo ang link para sa petsang pinili mo; kusang magsisimula ang countdown kapag binuksan ang link."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแชร์ลิงก์ของวันที่ที่เลือกได้ เมื่อเปิดลิงก์ การนับถอยหลังจะเริ่มเอง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede compartir el enlace de la fecha elegida; la cuenta atrás empieza sola al abrir el enlace."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode compartilhar o link da data escolhida; a contagem começa sozinha quando o link é aberto."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप चुनी तारीख का लिंक साझा कर सकते हैं; लिंक खुलते ही काउंटडाउन अपने-आप शुरू हो जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেছে নেওয়া তারিখের লিংক শেয়ার করতে পারেন; লিংক খুললে কাউন্টডাউন নিজে থেকেই শুরু হয়।"
          }
        }
      }
    },
