    "kids.facts.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biliyor muydunuz?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you know?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wusstest du schon?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilirdinizmi?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تعلم؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahukah kamu?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ جانتے ہیں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌دانستی؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le savais-tu ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "А ты знал?"
          }
        }
      }
    },
    "kids.fact1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "21 Haziran yılın en uzun günü, 21 Aralık en uzun gecesidir (kuzey yarımkürede)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "June 21 is the longest day of the year and December 21 the longest night (in the northern half)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der 21. Juni ist der längste Tag des Jahres, der 21. Dezember die längste Nacht (auf der Nordhalbkugel)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "21 iyun ilin ən uzun günü, 21 dekabr isə ən uzun gecəsidir (şimal yarımkürəsində)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "21 يونيو أطول يوم في السنة و21 ديسمبر أطول ليلة (في النصف الشمالي)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "21 Juni adalah siang terpanjang dalam setahun dan 21 Desember malam terpanjang (di belahan utara)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "21 جون سال کا سب سے لمبا دن اور 21 دسمبر سب سے لمبی رات ہے (شمالی حصے میں)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "21 ژوئن بلندترین روز سال و 21 دسامبر بلندترین شب است (در نیمهٔ شمالی)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 21 juin est le jour le plus long de l’année et le 21 décembre la nuit la plus longue (dans la moitié nord)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "21 июня — самый длинный день в году, а 21 декабря — самая длинная ночь (в северной половине)."
          }
        }
      }
    },
    "kids.fact2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mart ve Eylül'deki ekinoks günlerinde gece ile gündüz hemen hemen eşittir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the equinoxes in March and September, day and night are almost equal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An den Tagundnachtgleichen im März und September sind Tag und Nacht fast gleich lang."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mart və sentyabrdakı gecə-gündüz bərabərliyində gecə ilə gündüz demək olar ki, bərabərdir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في يومي الاعتدال في مارس وسبتمبر يتساوى الليل والنهار تقريبًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada ekuinoks bulan Maret dan September, siang dan malam hampir sama panjang."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مارچ اور ستمبر کے اعتدالین پر دن اور رات تقریباً برابر ہوتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در اعتدال‌های مارس و سپتامبر، روز و شب تقریباً برابرند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aux équinoxes de mars et de septembre, le jour et la nuit ont presque la même durée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В дни равноденствия в марте и сентябре день и ночь почти равны."
          }
        }
      }
    },
    "kids.fact3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuzey Kutbu'nda yazın aylarca Güneş batmaz, kışın da aylarca hiç doğmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the North Pole the Sun doesn't set for months in summer, and doesn't rise for months in winter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Nordpol geht die Sonne im Sommer monatelang nicht unter und im Winter monatelang nicht auf."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimal qütbündə yayda aylarla Günəş batmır, qışda isə aylarla heç doğmur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في القطب الشمالي لا تغرب الشمس لأشهر في الصيف، ولا تشرق لأشهر في الشتاء."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Kutub Utara, Matahari tidak terbenam selama berbulan-bulan saat musim panas, dan tidak terbit berbulan-bulan saat musim dingin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قطبِ شمالی پر گرمیوں میں سورج مہینوں غروب نہیں ہوتا اور سردیوں میں مہینوں طلوع نہیں ہوتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در قطب شمال، خورشید ماه‌ها در تابستان غروب نمی‌کند و ماه‌ها در زمستان طلوع نمی‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au pôle Nord, le Soleil ne se couche pas pendant des mois en été et ne se lève pas pendant des mois en hiver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Северном полюсе летом Солнце месяцами не заходит, а зимой месяцами не восходит."
          }
        }
      }
    },
    "kids.fact4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekvatora yakın ülkelerde yaz ile kış arasında fark azdır; orada yağmurlu ve kurak mevsimler vardır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Near the equator summer and winter feel almost the same; instead there are rainy and dry seasons."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Nähe des Äquators sind Sommer und Winter fast gleich; dort gibt es Regen- und Trockenzeiten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekvatora yaxın ölkələrdə yay ilə qış arasında fərq azdır; orada yağışlı və quraq fəsillər olur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرب خط الاستواء يكاد الصيف والشتاء يتشابهان؛ وبدلًا منهما هناك موسم مطير وموسم جاف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di dekat khatulistiwa, seperti di Indonesia, musim panas dan dingin terasa hampir sama; yang ada justru musim hujan dan musim kemarau."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خطِ استوا کے قریب گرمی اور سردی تقریباً ایک جیسی ہوتی ہیں؛ اس کے بجائے برسات اور خشک موسم ہوتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نزدیک استوا تابستان و زمستان تقریباً یکسان‌اند؛ به جایش فصل بارانی و فصل خشک هست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Près de l’équateur, l’été et l’hiver se ressemblent beaucoup ; il y a plutôt une saison des pluies et une saison sèche."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возле экватора лето и зима почти не отличаются; там вместо них сезон дождей и сухой сезон."
          }
        }
      }
    },
    "kids.fact5": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuzey yarımkürede yaz, kıştan birkaç gün uzundur: Dünya Güneş'ten uzaktayken biraz daha yavaş gider."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the northern half, summer is a few days longer than winter: Earth moves a little slower when it's farther from the Sun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Nordhalbkugel ist der Sommer ein paar Tage länger als der Winter: Weiter weg von der Sonne bewegt sich die Erde etwas langsamer."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimal yarımkürəsində yay qışdan bir neçə gün uzundur: Yer Günəşdən uzaqda olanda bir az yavaş gedir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في النصف الشمالي يكون الصيف أطول من الشتاء ببضعة أيام: فالأرض تتحرك أبطأ قليلًا حين تكون أبعد عن الشمس."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di belahan utara, musim panas beberapa hari lebih panjang dari musim dingin: Bumi bergerak sedikit lebih lambat saat lebih jauh dari Matahari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شمالی حصے میں گرمیاں سردیوں سے چند دن لمبی ہوتی ہیں: سورج سے دور ہونے پر زمین ذرا آہستہ چلتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در نیمهٔ شمالی تابستان چند روز بلندتر از زمستان است: زمین وقتی از خورشید دورتر است کمی آهسته‌تر حرکت می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la moitié nord, l’été dure quelques jours de plus que l’hiver : la Terre avance un peu plus lentement quand elle est plus loin du Soleil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В северной половине лето на несколько дней длиннее зимы: вдали от Солнца Земля движется чуть медленнее."
          }
        }
      }
    },
    "kids.more": {
