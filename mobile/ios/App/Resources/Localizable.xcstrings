        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang slider para piliin kung aling 30 segundo ng kanta ang tutugtog. Kung naka-on ang unti-unting lakas, mahina ang simula ng bahagi."
