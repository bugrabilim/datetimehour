            "value": "ڈائری کے تمام اندراجات حذف کر دیں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همهٔ یادداشت‌ها حذف شوند؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer toutes les entrées du journal ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить все записи дневника?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日記のすべての記録を削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일기 기록을 모두 삭제할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除所有日记记录？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Burahin ang lahat ng tala sa talaarawan?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบันทึกทั้งหมดไหม?"
          }
        }
      }
    },
    "journal.privacy": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük yalnız cihazlarınızda saklanır: bu telefonda ve iCloud ile eşitleme açıksa Apple hesabınızdaki cihazlarda. Hiçbir sunucuya gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journal stays on your devices: this phone and, if iCloud sync is on, the devices on your Apple Account. It is never sent to a server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tagebuch bleibt auf Ihren Geräten: auf diesem Telefon und, wenn die iCloud-Synchronisierung an ist, auf den Geräten Ihres Apple Accounts. Es wird nie an einen Server gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gündəlik yalnız cihazlarınızda saxlanılır: bu telefonda və iCloud ilə eyniləşdirmə açıqdırsa, Apple hesabınızdakı cihazlarda. Heç bir serverə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى اليوميات على أجهزتك فقط: هذا الهاتف، والأجهزة المرتبطة بحساب Apple إذا كانت مزامنة iCloud مفعّلة. لا تُرسل إلى أي خادم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurnal tetap di perangkat Anda: ponsel ini dan, jika sinkronisasi iCloud aktif, perangkat di Akun Apple Anda. Jurnal tidak pernah dikirim ke server."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈائری آپ کے آلات پر رہتی ہے: یہ فون اور، اگر iCloud ہم آہنگی آن ہو تو، آپ کے Apple اکاؤنٹ کے آلات۔ یہ کبھی سرور کو نہیں بھیجی جاتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادداشت‌ها روی دستگاه‌های شما می‌مانند: همین گوشی و، اگر همگام‌سازی iCloud روشن باشد، دستگاه‌های حساب Apple شما. هرگز به سرور فرستاده نمی‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal reste sur vos appareils : ce téléphone et, si la synchronisation iCloud est activée, les appareils de votre compte Apple. Il n’est jamais envoyé à un serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневник остаётся на ваших устройствах: на этом телефоне и, если включена синхронизация iCloud, на устройствах вашего Аккаунта Apple. Он никогда не отправляется на сервер."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日記はあなたのデバイスにとどまります：このスマホと、iCloud同期がオンならApple Accountのデバイス。サーバーには送られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일기는 내 기기에 머뭅니다: 이 휴대폰과, iCloud 동기화가 켜져 있으면 내 Apple 계정의 기기들. 서버로 보내지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日记留在您的设备上：这部手机，以及在开启iCloud同步时您Apple账户中的设备。绝不会发送到服务器。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nananatili ang talaarawan sa iyong mga device: ang teleponong ito at, kung naka-on ang iCloud sync, ang mga device sa iyong Apple Account. Hindi ito kailanman ipinapadala sa server."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกอยู่ในอุปกรณ์ของคุณ: โทรศัพท์นี้ และหากเปิดซิงค์ iCloud คืออุปกรณ์ในบัญชี Apple ของคุณ ไม่ส่งไปยังเซิร์ฟเวอร์"
          }
        }
      }
    },
    "journal.privacyAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük yalnız bu telefonda (ve telefonun Google yedeğinde) saklanır; hiçbir sunucumuza gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journal stays on this phone (and in the phone's Google backup); it is never sent to our servers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tagebuch bleibt auf diesem Telefon (und in seiner Google-Sicherung); es wird nie an unsere Server gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gündəlik yalnız bu telefonda (və telefonun Google ehtiyat nüsxəsində) saxlanılır; heç vaxt serverlərimizə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى اليوميات على هذا الهاتف فقط (وفي النسخة الاحتياطية من Google للهاتف)؛ ولا تُرسل أبدًا إلى خوادمنا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurnal tetap di ponsel ini (dan di cadangan Google ponsel); tidak pernah dikirim ke server kami."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈائری اسی فون پر (اور فون کے گوگل بیک اپ میں) رہتی ہے؛ یہ کبھی ہمارے سرورز کو نہیں بھیجی جاتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادداشت‌ها روی همین گوشی (و در پشتیبان گوگل گوشی) می‌مانند؛ هرگز به سرورهای ما فرستاده نمی‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal reste sur ce téléphone (et dans la sauvegarde Google du téléphone) ; il n’est jamais envoyé à nos serveurs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневник остаётся на этом телефоне (и в резервной копии Google); он никогда не отправляется на наши серверы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日記はこのスマホ（とスマホのGoogleバックアップ）にとどまり、私たちのサーバーには送られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일기는 이 휴대폰(과 휴대폰의 Google 백업)에 머물며 저희 서버로 보내지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日记留在这部手机上（以及手机的Google备份中）；绝不会发送到我们的服务器。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nananatili ang talaarawan sa teleponong ito (at sa Google backup ng telepono); hindi ito kailanman ipinapadala sa aming mga server."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกอยู่ในโทรศัพท์นี้ (และในข้อมูลสำรอง Google ของโทรศัพท์) ไม่ส่งไปยังเซิร์ฟเวอร์ของเรา"
          }
        }
      }
    },
    "meet.pickHint": {
      "extractionState": "manual",
      "localizations": {
