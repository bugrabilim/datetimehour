        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: часы, календарь, время намаза и инструменты; бесплатно и без рекламы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：時計、カレンダー、礼拝時刻、ツール。無料で広告なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 시계, 캘린더, 기도 시간, 도구. 무료이며 광고 없음."
