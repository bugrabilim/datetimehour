        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть свет этой ночи озарит ваш дом."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この夜の光がご家庭を照らしますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 밤의 빛이 가정을 밝혀 주길 바랍니다."
