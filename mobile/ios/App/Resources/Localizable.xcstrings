    "account.err.unverified": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta adresiniz henüz doğrulanmadı. Yeni doğrulama bağlantısı gönderdik; e-postanızı kontrol edin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email address isn't verified yet. We sent a new verification link; please check your email."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre E-Mail-Adresse ist noch nicht bestätigt. Wir haben einen neuen Bestätigungslink geschickt; sehen Sie in Ihr Postfach."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poçt ünvanınız hələ təsdiqlənməyib. Yeni təsdiq keçidi göndərdik; e-poçtunuzu yoxlayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُؤكَّد عنوان بريدك الإلكتروني بعد. أرسلنا رابط تأكيد جديدًا؛ تفقّد بريدك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat email Anda belum diverifikasi. Kami sudah mengirim tautan verifikasi baru; periksa email Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ای میل پتا ابھی تصدیق شدہ نہیں۔ ہم نے نیا تصدیقی لنک بھیجا ہے؛ اپنی ای میل دیکھیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشانی ایمیل شما هنوز تأیید نشده است. پیوند تأیید تازه‌ای فرستادیم؛ ایمیل خود را ببینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre adresse e-mail n’est pas encore vérifiée. Nous avons envoyé un nouveau lien de vérification ; consultez vos e-mails."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес эл. почты ещё не подтверждён. Мы отправили новую ссылку; проверьте почту."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスがまだ確認されていません。新しい確認用リンクを送信しました。メールをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 주소가 아직 확인되지 않았습니다. 새 확인 링크를 보냈으니 이메일을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的电子邮箱尚未验证。我们已发送新的验证链接，请查收邮件。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa na-verify ang inyong email address. Nagpadala kami ng bagong verification link; tingnan ang inyong email."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีเมลของคุณยังไม่ได้ยืนยัน เราส่งลิงก์ยืนยันใหม่แล้ว โปรดตรวจสอบอีเมล"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su correo electrónico aún no está verificado. Enviamos un nuevo enlace de verificación; revise su correo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu e-mail ainda não foi verificado. Enviamos um novo link de verificação; confira seu e-mail."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके ईमेल पते की अभी पुष्टि नहीं हुई है। हमने नया पुष्टि लिंक भेजा है; अपना ईमेल देखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ইমেইল ঠিকানা এখনো যাচাই হয়নি। আমরা নতুন যাচাইয়ের লিংক পাঠিয়েছি; ইমেইল দেখুন।"
          }
        }
      }
    },
