    "look.bg.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gökyüzü seçili konumda Güneş'in yüksekliğine göre gündüz, gün doğumu/batımı ya da gece olur. Telefonda \"hareketi azalt\" açıksa hareketli arka planlar durağan görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sky follows the Sun's height at the selected location: day, sunrise/sunset or night. If \"reduce motion\" is on, animated backgrounds are shown still."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Himmel folgt dem Sonnenstand am gewählten Ort: Tag, Sonnenauf-/-untergang oder Nacht. Ist „Bewegung reduzieren“ an, bleiben bewegte Hintergründe still."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səma seçilmiş yerdə Günəşin hündürlüyünə görə gündüz, gün doğuşu/batışı və ya gecə olur. Telefonda \"hərəkəti azalt\" açıqdırsa hərəkətli arxa fonlar sabit görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع السماء ارتفاع الشمس في الموقع المحدد: نهار أو شروق/غروب أو ليل. إذا كان «تقليل الحركة» مفعّلًا تظهر الخلفيات المتحركة ثابتة."
          }
        }
      }
    },
    "features.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özellikler"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Features"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktionen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xüsusiyyətlər"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميزات"
          }
        }
      }
    },
    "features.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat her zaman açık. Açtığın özellikler alt çubukta görünür; hepsi kapalıysa alt çubuk gizlenir, ayarlar saat ekranındaki dişliden açılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is always on. Features you turn on appear in the bottom bar; with all of them off the bar is hidden and settings open from the gear on the clock screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr ist immer an. Eingeschaltete Funktionen erscheinen in der unteren Leiste; sind alle aus, wird die Leiste ausgeblendet und die Einstellungen öffnen sich über das Zahnrad auf dem Uhrbildschirm."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat həmişə açıqdır. Açdığın xüsusiyyətlər alt zolaqda görünür; hamısı bağlı olduqda alt zolaq gizlənir, ayarlar saat ekranındakı dişli ilə açılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة مفعّلة دائمًا. تظهر الميزات التي تفعّلها في الشريط السفلي؛ وإذا عُطّلت كلها يختفي الشريط وتُفتح الإعدادات من رمز الترس في شاشة الساعة."
          }
        }
      }
    },
    "features.clock.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman açık: 20 saat modeli, tam ekran, saat ekranı alanları"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
