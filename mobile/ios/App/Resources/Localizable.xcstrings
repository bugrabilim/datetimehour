          }
        }
      }
    },
    "calendar.monthOrigin.items.5": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haziran: Süryanice Ḥzīrān ay adından."
          }
