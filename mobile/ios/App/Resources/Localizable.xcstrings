    "wake.photo.wrong": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı yere benzemiyor, aynı açıdan yeniden deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like the same spot; try again from the same angle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht nach derselben Stelle aus; versuchen Sie es aus demselben Winkel erneut."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyni yerə bənzəmir, eyni bucaqdan yenidən cəhd edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يبدو المكان نفسه، حاول مجددًا من الزاوية نفسها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepertinya bukan tempat yang sama; coba lagi dari sudut yang sama."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ وہی جگہ نہیں لگتی؛ اسی زاویے سے دوبارہ کوشش کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به نظر همان جا نیست؛ از همان زاویه دوباره بکوشید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas au même endroit ; réessayez sous le même angle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, это не то место; попробуйте снова с того же ракурса."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ場所に見えません。同じ角度からもう一度どうぞ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 곳으로 보이지 않습니다. 같은 각도에서 다시 찍어 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看起来不是同一个地方；请从相同角度再试一次。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukhang hindi iyan ang parehong lugar; subukan ulit mula sa parehong anggulo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูไม่เหมือนจุดเดิม ลองใหม่จากมุมเดียวกัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No parece el mismo sitio; inténtelo de nuevo desde el mismo ángulo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não parece o mesmo lugar; tente de novo do mesmo ângulo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वही जगह नहीं लगती; उसी कोण से फिर कोशिश करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি একই জায়গা মনে হচ্ছে না; একই কোণ থেকে আবার চেষ্টা করুন।"
          }
        }
      }
