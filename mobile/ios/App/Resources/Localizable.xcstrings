    "zikir.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dokunuşta hafif titreşir, hedefte ve tesbihatın her 33'ünde güçlü titreşir. Sayılar yalnız bu cihazda."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A light buzz on every tap, a strong one at the target and at every 33 in the tasbih. Counts stay on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leichte Vibration bei jedem Tippen, eine stärke am Ziel und bei jeder 33 im Tasbih. Die Zahlen bleiben auf diesem Gerät."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər toxunuşda yüngül titrəyir, hədəfdə və təsbihatın hər 33-də güclü titrəyir. Saylar yalnız bu cihazda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اهتزاز خفيف عند كل لمسة وقوي عند الهدف وعند كل ٣٣ في التسبيح. تبقى الأعداد على هذا الجهاز."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Getaran ringan di setiap ketukan, getaran kuat saat target tercapai dan setiap 33 dalam tasbih. Hitungan tetap di perangkat ini."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر ٹیپ پر ہلکی وائبریشن، ہدف پر اور تسبیحات میں ہر 33 پر تیز۔ گنتی اسی آلے پر رہتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با هر ضربه لرزشی سبک، و در رسیدن به هدف و هر 33 در تسبیحات لرزشی قوی. شمارش‌ها روی همین دستگاه می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une légère vibration à chaque appui, une forte à l’objectif et tous les 33 dans le tasbih. Les comptes restent sur cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкая вибрация при каждом нажатии, сильная — при достижении цели и на каждом 33-м в тасбихе. Счёт хранится на этом устройстве."
          }
        }
      }
    },
