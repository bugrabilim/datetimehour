        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 이 휴대폰에만 저장되며 카운트다운 카드 뒤에 보입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
