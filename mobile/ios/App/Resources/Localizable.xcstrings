          }
        }
      }
    },
    "alarm.fallbackNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone'da alarm bildirim olarak gelir ve telefon sessizdeyken çalmaz. iOS 26 ve sonrasında gerçek alarm olarak çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this iPhone the alarm arrives as a notification and does not ring when the phone is silenced. On iOS 26 and later it rings as a real alarm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone kommt der Wecker als Mitteilung und klingelt nicht im Stummmodus. Ab iOS 26 klingelt er als echter Wecker."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone-da alarm bildiriş kimi gəlir və telefon səssizdə olanda çalmır. iOS 26 və sonrasında əsl alarm kimi çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على هذا الآيفون يصل المنبه كإشعار ولا يرن عندما يكون الهاتف صامتًا. في iOS 26 وما بعده يرن كمنبه حقيقي."
          }
        }
      }
    },
    "alarm.realNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm, telefon sessizdeyken ve uygulama kapalıyken de çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm rings even when the phone is silenced and the app is closed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wecker klingelt auch im Stummmodus und bei geschlossener App."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm telefon səssizdə və tətbiq bağlı olanda da çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرن المنبه حتى عندما يكون الهاتف صامتًا والتطبيق مغلقًا."
          }
        }
      }
    },
