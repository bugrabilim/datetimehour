    "cals.hindu.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlıca Hindu bayramları ve günlük pançanga: kameri ay, tithi, nakşatra ve Vikram Samvat yılı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Major Hindu festivals and the daily panchang: lunar month, tithi, nakshatra and Vikram Samvat year."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wichtige hinduistische Feste und das tägliche Panchang: Mondmonat, Tithi, Nakshatra und Jahr der Vikram-Samvat-Ära."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas Hindu bayramları və gündəlik pançanqa: qəməri ay, tithi, nakşatra və Vikram Samvat ili."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبرز الأعياد الهندوسية والبانتشانغ اليومي: الشهر القمري والتيثي والنكشترا وسنة فيكرام سامفات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari raya utama Hindu dan panchang harian: bulan lunar, tithi, nakshatra, dan tahun Vikram Samvat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اہم ہندو تہوار اور روزانہ پنچانگ: قمری مہینہ، تتھی، نکشتر اور بکرمی سمت کا سال۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جشن‌های اصلی هندو و پنچانگ روزانه: ماه قمری، تیتی، نکشترا و سال ویکرم سموت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Principales fêtes hindoues et panchang du jour : mois lunaire, tithi, nakshatra et année Vikram Samvat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Главные индуистские праздники и ежедневная панчанга: лунный месяц, титхи, накшатра и год эры Викрам самват."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主なヒンドゥー教の祭日と毎日のパンチャーンガ（太陰月、ティティ、ナクシャトラ、ヴィクラム暦の年）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주요 힌두교 축제와 매일의 판창가: 태음월, 티티, 낙샤트라, 비크람 삼바트 연도."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主要印度教节日与每日历书（panchang）：太阴月、提提（太阴日）、星宿与超日王纪元年份。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga pangunahing pista ng Hindu at ang araw-araw na panchang: buwang lunar, tithi, nakshatra at taon ng Vikram Samvat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทศกาลสำคัญของศาสนาฮินดูและปัญจางคะรายวัน: เดือนจันทรคติ ดิถี ฤกษ์ (นักษัตร) และปีวิกรมสัมวัต"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Principales festividades hindúes y el panchang diario: mes lunar, tithi, nakshatra y año Vikram Samvat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Principais festivais hindus e o panchang diário: mês lunar, tithi, nakshatra e ano Vikram Samvat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमुख हिंदू त्योहार और दैनिक पंचांग: चंद्र मास, तिथि, नक्षत्र और विक्रम संवत।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রধান হিন্দু উৎসব ও দৈনিক পঞ্জিকা: চান্দ্র মাস, তিথি, নক্ষত্র ও বিক্রম সংবৎ বছর।"
          }
        }
      }
    },
    "cals.hindu.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni Delhi'nin gün doğumuna (Hindistan saati) göre, drikpanchang.com'un kurallarıyla hesaplanır; başka yerlerde ve resmî tatil listelerinde tarih bir gün farklı olabilir. Aylar amanta'dır (yeni aydan yeni aya); Kuzey Hindistan'daki purnimanta düzeninde ayın karanlık yarısı bir sonraki ayın adını alır. Nakşatralar Lahiri ayanamsasıyla hesaplanır; Janmaştami Vaişnava tarihidir (Smarta geleneğinde bir gün önce olabilir)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated for New Delhi (sunrise, Indian Standard Time) with the rules used by drikpanchang.com; other places and official holiday lists can differ by a day. Months are amanta (new moon to new moon); in North India's purnimanta system the dark fortnight takes the next month's name. Nakshatras use the Lahiri ayanamsa; Janmashtami is the Vaishnava date (Smarta observance can be a day earlier)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet für Neu-Delhi (Sonnenaufgang, indische Zeit) nach den Regeln von drikpanchang.com; an anderen Orten und in amtlichen Feiertagslisten kann das Datum um einen Tag abweichen. Die Monate sind amanta (von Neumond zu Neumond); im nordindischen Purnimanta-System trägt die dunkle Monatshälfte den Namen des folgenden Monats. Nakshatras mit dem Lahiri-Ayanamsa; Janmashtami ist das vaishnavitische Datum (Smarta feiern mitunter einen Tag früher)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni Dehlinin gün çıxmasına (Hindistan vaxtı) görə, drikpanchang.com-un qaydaları ilə hesablanır; başqa yerlərdə və rəsmi bayram siyahılarında tarix bir gün fərqli ola bilər. Aylar amanta sistemindədir (yeni aydan yeni aya); Şimali Hindistanın purnimanta sistemində ayın qaranlıq yarısı növbəti ayın adını alır. Nakşatralar Lahiri ayanamsası ilə hesablanır; Janmaştami Vaişnava tarixidir (Smarta ənənəsində bir gün əvvəl ola bilər)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محسوب لنيودلهي (شروق الشمس، توقيت الهند) وفق قواعد drikpanchang.com؛ وقد يختلف التاريخ يومًا في أماكن أخرى وفي قوائم العطل الرسمية. الأشهر على نظام أمانتا (من محاق إلى محاق)؛ وفي نظام بورنيمانتا في شمال الهند يُسمّى النصف المظلم من الشهر باسم الشهر التالي. النكشترا بحسب أيانامشا لاهيري؛ وتاريخ جانماشتامي هو التاريخ الفيشنوي (وقد يحتفل السمارتا قبله بيوم)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihitung untuk New Delhi (matahari terbit, waktu India) dengan aturan drikpanchang.com; di tempat lain dan dalam daftar hari libur resmi tanggalnya bisa berbeda satu hari. Bulan memakai sistem amanta (dari bulan baru ke bulan baru); dalam sistem purnimanta di India utara, paruh gelap memakai nama bulan berikutnya. Nakshatra dengan ayanamsa Lahiri; Janmashtami memakai tanggal Waisnawa (tradisi Smarta bisa sehari lebih awal). Hari raya Hindu Bali (Galungan, Nyepi) tidak termasuk."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئی دہلی کے طلوعِ آفتاب (بھارتی معیاری وقت) کے مطابق، drikpanchang.com کے اصولوں سے حساب؛ دوسری جگہوں پر اور سرکاری تعطیلات کی فہرستوں میں تاریخ ایک دن مختلف ہو سکتی ہے۔ مہینے امانت ہیں (نئے چاند سے نئے چاند تک)؛ شمالی ہند کے پورنیمانت نظام میں اندھیرا پکھواڑا اگلے مہینے کے نام سے جانا جاتا ہے۔ نکشتر لاہری اینامش سے؛ جنم اشٹمی ویشنو تاریخ ہے (سمارت روایت میں ایک دن پہلے ہو سکتی ہے)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بر پایهٔ طلوع آفتاب در دهلی نو (وقت هند) و با قواعد drikpanchang.com محاسبه شده است؛ در جاهای دیگر و در فهرست‌های رسمی تعطیلات، تاریخ ممکن است یک روز فرق کند. ماه‌ها آمانتا هستند (از ماه نو تا ماه نو)؛ در نظام پورنیمانتای شمال هند، نیمهٔ تاریک ماه به نام ماه بعد خوانده می‌شود. نکشتراها با آیانامشای لاهیری؛ جنماشتمی تاریخ ویشنوی است (در سنت اسمارتا ممکن است یک روز زودتر باشد)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé pour New Delhi (lever du soleil, heure de l’Inde) selon les règles de drikpanchang.com ; ailleurs et dans les listes officielles de jours fériés, la date peut différer d’un jour. Les mois sont amanta (d’une nouvelle lune à l’autre) ; dans le système purnimanta du nord de l’Inde, la quinzaine sombre prend le nom du mois suivant. Nakshatras selon l’ayanamsa de Lahiri ; Janmashtami suit la date vishnouite (les smarta peuvent la fêter un jour plus tôt)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рассчитано для Нью-Дели (восход солнца, индийское время) по правилам drikpanchang.com; в других местах и в официальных списках праздников дата может отличаться на день. Месяцы аманта (от новолуния до новолуния); в северноиндийской системе пурниманта тёмная половина месяца носит имя следующего месяца. Накшатры по аянамше Лахири; Джанмаштами указана по вайшнавской традиции (смарты могут отмечать на день раньше)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ニューデリーの日の出（インド標準時）を基準に、drikpanchang.comと同じ規則で計算しています。ほかの地域やインド政府の祝日一覧では1日ずれることがあります。月はアマーンタ（新月から新月まで）で、北インドのプールニマーンタでは黒分が次の月の名で呼ばれます。ナクシャトラはラヒリのアヤナームシャ、宿名は宿曜経の二十七宿によります。ジャンマーシュタミーはヴィシュヌ派の日付です（スマールタ派は1日早いことがあります）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뉴델리의 해돋이(인도 표준시)를 기준으로 drikpanchang.com과 같은 규칙으로 계산합니다. 다른 지역이나 인도 정부 공휴일 목록에서는 하루 차이가 날 수 있습니다. 달은 아만타(초승달에서 초승달까지)이며, 북인도의 푸르니만타에서는 흑월이 다음 달의 이름으로 불립니다. 낙샤트라는 라히리 아야남샤를 따르며, 잔마슈타미는 비슈누파 날짜입니다(스마르타파는 하루 이를 수 있습니다)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按新德里日出（印度标准时间）并依drikpanchang.com的规则计算；其他地区及印度官方假日表的日期可能相差一天。月份采用新月到新月的“无月终”制（amanta），北印度的“满月终”制（purnimanta）中黑月归入下一个月。星宿按拉希里岁差（Lahiri ayanamsa），宿名据二十七宿；黑天诞辰节为毗湿奴派日期（斯玛尔塔派可能早一天）。月名采用《大唐西域记》译名。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinuwenta para sa New Delhi (pagsikat ng araw, oras sa India) ayon sa mga patakaran ng drikpanchang.com; sa ibang lugar at sa mga opisyal na listahan ng pista opisyal, maaaring iba nang isang araw ang petsa. Amanta ang mga buwan (mula bagong buwan hanggang bagong buwan); sa purnimanta ng hilagang India, ang madilim na kalahati ay ipinapangalan sa susunod na buwan. Lahiri ayanamsa ang gamit sa nakshatra; petsang Vaishnava ang Janmashtami (maaaring isang araw na mas maaga sa Smarta)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำนวณตามเวลาดวงอาทิตย์ขึ้นที่นิวเดลี (เวลาอินเดีย) ด้วยกฎเดียวกับ drikpanchang.com ในที่อื่นและในรายการวันหยุดราชการ วันที่อาจต่างกันหนึ่งวัน เดือนนับแบบอมานตะ (จากเดือนดับถึงเดือนดับ) ส่วนระบบปูรณิมานตะของอินเดียเหนือเรียกข้างแรมตามชื่อเดือนถัดไป ฤกษ์ใช้อยนางศะแบบลาหิรี และวันชันมาษฏมีเป็นวันตามสายไวษณพ (สายสมารตะอาจเร็วกว่าหนึ่งวัน)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado para Nueva Delhi (salida del sol, hora de la India) con las reglas de drikpanchang.com; en otros lugares y en las listas oficiales de feriados la fecha puede variar un día. Los meses son amanta (de luna nueva a luna nueva); en el sistema purnimanta del norte de la India la quincena oscura lleva el nombre del mes siguiente. Nakshatras con el ayanamsa de Lahiri; Janmashtami sigue la fecha vaishnava (los smarta pueden celebrarlo un día antes)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado para Nova Délhi (nascer do sol, horário da Índia) com as regras do drikpanchang.com; em outros lugares e nas listas oficiais de feriados a data pode variar um dia. Os meses são amanta (de lua nova a lua nova); no sistema purnimanta do norte da Índia a quinzena escura leva o nome do mês seguinte. Nakshatras com o ayanamsa de Lahiri; Janmashtami segue a data vaishnava (os smarta podem celebrá-lo um dia antes)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई दिल्ली के सूर्योदय (भारतीय मानक समय) के अनुसार, drikpanchang.com के नियमों से गणना; अन्य स्थानों पर और सरकारी अवकाश सूचियों में तिथि एक दिन अलग हो सकती है। मास अमांत हैं (अमावस्या से अमावस्या तक); उत्तर भारत की पूर्णिमांत पद्धति में कृष्ण पक्ष अगले मास के नाम से जाना जाता है। नक्षत्र लाहिड़ी अयनांश से; जन्माष्टमी वैष्णव तिथि है (स्मार्त जन्माष्टमी एक दिन पहले हो सकती है)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নয়াদিল্লির জন্য (সূর্যোদয়, ভারতীয় প্রমাণ সময়) drikpanchang.com-এর নিয়মে হিসাব করা; অন্য জায়গা ও সরকারি ছুটির তালিকা এক দিন আলাদা হতে পারে। মাসগুলো অমান্ত (অমাবস্যা থেকে অমাবস্যা); উত্তর ভারতের পূর্ণিমান্ত পদ্ধতিতে কৃষ্ণপক্ষ পরের মাসের নাম নেয়। নক্ষত্রে লাহিড়ী অয়নাংশ ব্যবহৃত; জন্মাষ্টমী বৈষ্ণব তারিখ (স্মার্ত পালন এক দিন আগে হতে পারে)।"
          }
        }
      }
    },
