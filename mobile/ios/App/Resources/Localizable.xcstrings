            "value": "「常に許可」を選んでください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"항상 허용\"을 고르세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择“始终允许”"
