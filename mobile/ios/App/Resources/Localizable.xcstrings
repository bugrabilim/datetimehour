    "zakat.due": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlığınız nisaba ulaşıyor; zekât düşer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your wealth reaches the nisab; zakat is due."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Vermögen erreicht den Nisab; Zakat ist fällig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlığınız nisaba çatır; zəkat düşür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مالك يبلغ النصاب؛ تجب الزكاة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harta Anda mencapai nisab; zakat wajib."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مال نصاب تک پہنچتا ہے؛ زکوٰۃ واجب ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دارایی شما به نصاب می‌رسد؛ زکات واجب است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos biens atteignent le nisab ; la zakat est due."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше имущество достигает нисаба; закят обязателен."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資産がニサーブに達しています。ザカートの義務があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자산이 니삽에 이릅니다. 자카트를 내야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的财产达到满贯标准，应缴天课。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Abot ng iyong yaman ang nisab; may zakat kang dapat ibigay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทรัพย์สินของคุณถึงนิศอบแล้ว ต้องจ่ายซะกาต"
          }
        }
      }
    },
    "zakat.notDue": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlığınız nisabın altında; zekât düşmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your wealth is below the nisab; no zakat is due."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Vermögen liegt unter dem Nisab; keine Zakat fällig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlığınız nisabdan aşağıdır; zəkat düşmür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مالك دون النصاب؛ لا تجب الزكاة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harta Anda di bawah nisab; tidak wajib zakat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مال نصاب سے کم ہے؛ زکوٰۃ واجب نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دارایی شما کمتر از نصاب است؛ زکات واجب نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos biens sont sous le nisab ; aucune zakat n’est due."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше имущество ниже нисаба; закят не обязателен."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資産がニサーブに達していません。ザカートの義務はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자산이 니삽에 못 미칩니다. 자카트 의무가 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的财产未达满贯标准，无须缴纳天课。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulang sa nisab ang iyong yaman; walang zakat na dapat ibigay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทรัพย์สินของคุณยังไม่ถึงนิศอบ ไม่ต้องจ่ายซะกาต"
          }
        }
      }
    },
