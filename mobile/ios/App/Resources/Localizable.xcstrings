        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusat distrik: GeoNames (CC BY 4.0). Diyanet adalah acuan resmi untuk jadwal salat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اضلاع کے مراکز: GeoNames (CC BY 4.0)۔ اوقاتِ نماز کے لیے دیانت سرکاری حوالہ ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مرکز شهرستان‌ها: GeoNames (CC BY 4.0). مرجع رسمی اوقات شرعی دیانت است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Centres des districts : GeoNames (CC BY 4.0). La Diyanet fait foi pour les heures de prière."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Центры районов: GeoNames (CC BY 4.0). Официальное время намаза — по Diyanet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地区の中心：GeoNames（CC BY 4.0）。礼拝時刻の公式基準はディヤーネットです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구·군 중심지: GeoNames(CC BY 4.0). 기도 시간의 공식 기준은 디야넷입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区县中心：GeoNames（CC BY 4.0）。礼拜时间以迪亚内特为官方依据。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentro ng distrito: GeoNames (CC BY 4.0). Ang Diyanet ang opisyal na batayan ng oras ng dasal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ศูนย์กลางอำเภอ: GeoNames (CC BY 4.0) ดียาเนตเป็นแหล่งอ้างอิงทางการของเวลาละหมาด"
