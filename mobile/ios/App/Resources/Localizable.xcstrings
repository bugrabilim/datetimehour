    "smart.none": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akıllı alarm süresi seçilmiş bir alarm yok. Alarm düzenleyicisinde \"Akıllı alarm\" süresini seçin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No alarm has a smart alarm window. Choose a \"Smart alarm\" window in the alarm editor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Wecker hat ein Zeitfenster für den intelligenten Wecker. Legen Sie im Weckereditor unter „Intelligenter Wecker“ ein Zeitfenster fest."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağıllı zəng müddəti seçilmiş zəng yoxdur. Zəng redaktorunda \"Ağıllı zəng\" müddətini seçin."
