    "onboard.welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepsi tek uygulamada.\nHepsi ücretsiz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All in one app.\nAll free."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in einer App.\nAlles kostenlos."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hamısı bir tətbiqdə.\nHamısı pulsuz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء في تطبيق واحد.\nوكله مجاني."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua dalam satu aplikasi.\nSemua gratis."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب کچھ ایک ایپ میں۔\nسب کچھ مفت۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه در یک برنامه.\nهمه رایگان."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout dans une seule appli.\nTout gratuit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё в одном приложении.\nВсё бесплатно."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてをひとつのアプリに。\nすべて無料で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 것을 한 앱에.\n모두 무료로."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个应用，应有尽有。\n全部免费。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahat sa iisang app.\nLahat libre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ครบในแอปเดียว\nฟรีทั้งหมด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en una sola app.\nTodo gratis."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo em um só app.\nTudo grátis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ एक ऐप में।\nसब कुछ मुफ़्त।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব এক অ্যাপে।\nসব বিনামূল্যে।"
          }
        }
      }
    },
    "onboard.welcome.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzlerce ücretli ve ücretsiz uygulamayı, siteyi sizin için inceledik ve her şeyi tek bir üründe topladık."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We reviewed hundreds of paid and free apps and websites for you and brought everything together in one product."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben Hunderte kostenpflichtige und kostenlose Apps und Websites für Sie geprüft und alles in einem Produkt vereint."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzlərlə pullu və pulsuz tətbiqi, saytı sizin üçün araşdırdıq və hər şeyi bir məhsulda topladıq."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجعنا لك مئات التطبيقات والمواقع المدفوعة والمجانية، وجمعنا كل شيء في منتج واحد."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami meninjau ratusan aplikasi dan situs berbayar maupun gratis untuk Anda, lalu menyatukan semuanya dalam satu produk."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم نے آپ کے لیے سیکڑوں پیڈ اور مفت ایپس اور ویب سائٹس کا جائزہ لیا اور سب کچھ ایک ہی پروڈکٹ میں جمع کر دیا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدها برنامه و وب‌سایت پولی و رایگان را برایتان بررسی کردیم و همه چیز را در یک محصول گرد آوردیم."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons examiné pour vous des centaines d'applis et de sites, payants et gratuits, et tout réuni dans un seul produit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы изучили для вас сотни платных и бесплатных приложений и сайтов и собрали всё в одном продукте."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有料・無料の数百ものアプリとサイトを調べ、すべてをひとつの製品にまとめました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유료·무료 앱과 사이트 수백 개를 살펴보고, 모든 것을 하나의 제품에 모았어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们为您研究了数百款付费和免费的应用与网站，把一切汇集到一个产品中。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinuri namin para sa iyo ang daan-daang bayad at libreng app at website, at pinagsama ang lahat sa iisang produkto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราศึกษาแอปและเว็บไซต์ทั้งแบบเสียเงินและฟรีหลายร้อยรายการเพื่อคุณ แล้วรวมทุกอย่างไว้ในผลิตภัณฑ์เดียว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisamos para usted cientos de apps y sitios web, de pago y gratuitos, y reunimos todo en un solo producto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisamos para você centenas de apps e sites, pagos e gratuitos, e reunimos tudo em um só produto."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने आपके लिए सैकड़ों पेड और मुफ़्त ऐप्स और वेबसाइटें जाँचीं और सब कुछ एक ही प्रोडक्ट में जोड़ दिया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা আপনার জন্য শত শত পেইড ও ফ্রি অ্যাপ এবং ওয়েবসাইট দেখেছি এবং সবকিছু একটি পণ্যে একত্র করেছি।"
          }
        }
      }
    },
