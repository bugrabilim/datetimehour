    "retire.noteScope": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yalnız 4/a (hizmet akdiyle çalışan, eski SSK) sigortalıları içindir. 4/b (Bağ-Kur) ve 4/c (memur) için şartlar farklıdır. Askerlik ve doğum borçlanması, yurt dışı borçlanması, yıpranma payı, engellilik, ağır engelli çocuğu olan anneler ve maden işleri gibi özel durumlar hesaba katılmaz; borçlanma günlerini prim gününe eklerseniz yaklaşık sonuç alırsınız."
          }
        },
