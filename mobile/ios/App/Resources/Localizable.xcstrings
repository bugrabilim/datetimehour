            "value": "آپ کا مال نصاب تک پہنچتا ہے؛ زکوٰۃ واجب ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دارایی شما به نصاب می‌رسد؛ زکات واجب است."
