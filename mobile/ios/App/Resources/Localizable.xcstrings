    "onboard.summary.none": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız saat ve araçlar açık. İstediğiniz an Ayarlar › Özellikler'den bölüm eklersiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the clock and tools are on. Add sections any time in Settings › Features."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Uhr und Werkzeuge sind eingeschaltet. Bereiche fügen Sie jederzeit unter Einstellungen › Funktionen hinzu."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız saat və alətlər açıqdır. İstədiyiniz an Parametrlər › Xüsusiyyətlər bölməsindən əlavə edərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة والأدوات فقط مفعّلة. أضف أقسامًا متى شئت من الإعدادات › الميزات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya jam dan alat yang aktif. Tambahkan bagian kapan saja di Pengaturan › Fitur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف گھڑی اور ٹولز چالو ہیں۔ جب چاہیں ترتیبات › خصوصیات سے حصے شامل کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط ساعت و ابزارها روشن‌اند. هر وقت خواستید از تنظیمات › ویژگی‌ها بخش اضافه کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls l'horloge et les outils sont activés. Ajoutez des sections quand vous voulez dans Réglages › Fonctions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включены только часы и инструменты. Добавить разделы можно в любой момент: Настройки › Функции."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計とツールだけがオンです。いつでも 設定 › 機能 から追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계와 도구만 켜져 있어요. 언제든 설정 › 기능에서 항목을 추가할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只开启了时钟和工具。随时可在 设置 › 功能 中添加。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Orasan at mga tool lang ang bukas. Magdagdag anumang oras sa Settings › Mga feature."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไว้เฉพาะนาฬิกาและเครื่องมือ เพิ่มส่วนอื่นได้ทุกเมื่อที่ การตั้งค่า › ฟีเจอร์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo están activos el reloj y las herramientas. Añada secciones cuando quiera en Ajustes › Funciones."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o relógio e as ferramentas estão ativos. Adicione seções quando quiser em Ajustes › Recursos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ घड़ी और टूल चालू हैं। जब चाहें सेटिंग्स › सुविधाएँ से हिस्से जोड़ें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু ঘড়ি ও টুলস চালু। যেকোনো সময় সেটিংস › বৈশিষ্ট্যে অংশ যোগ করুন।"
          }
        }
      }
    },
    "onboard.trust.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verileriniz sizde kalır"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays with you"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Daten bleiben bei Ihnen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatlarınız sizdə qalır"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بياناتك تبقى معك"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Anda tetap di tangan Anda"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ڈیٹا آپ ہی کے پاس رہتا ہے"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌هایتان پیش خودتان می‌ماند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données restent chez vous"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши данные остаются у вас"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはあなたの手元に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 내 폰에만"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据只留在您身边"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa iyo lang ang data mo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลของคุณอยู่กับคุณ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus datos se quedan con usted"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados ficam com você"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा आपके पास ही रहता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার তথ্য আপনার কাছেই থাকে"
          }
        }
      }
    },
    "onboard.trust.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yok, reklam yok, takip yok. Konumunuz, kişisel bilgileriniz, takviminiz ve sağlık verileriniz bize gelmez; hiçbir sunucumuzda saklanmaz. İzinler yalnız telefonunuzun içinde iş görür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no ads, no tracking. Your location, personal details, calendar and health data never reach us and are not stored on any server of ours. Permissions only work inside your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto, keine Werbung, kein Tracking. Ihr Standort, Ihre persönlichen Angaben, Ihr Kalender und Ihre Gesundheitsdaten erreichen uns nie und liegen auf keinem unserer Server. Berechtigungen wirken nur in Ihrem Telefon."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesab yoxdur, reklam yoxdur, izləmə yoxdur. Məkanınız, şəxsi məlumatlarınız, təqviminiz və sağlamlıq məlumatlarınız bizə gəlmir, heç bir serverimizdə saxlanmır. İcazələr yalnız telefonunuzun içində işləyir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حساب، لا إعلانات، لا تتبّع. موقعك وبياناتك الشخصية وتقويمك وبياناتك الصحية لا تصل إلينا ولا تُخزَّن على أي خادم لنا. الأذونات تعمل داخل هاتفك فقط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa akun, tanpa iklan, tanpa pelacakan. Lokasi, data pribadi, kalender, dan data kesehatan Anda tidak pernah sampai ke kami dan tidak disimpan di server kami. Izin hanya bekerja di dalam ponsel Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نہ اکاؤنٹ، نہ اشتہار، نہ ٹریکنگ۔ آپ کا مقام، ذاتی معلومات، کیلنڈر اور صحت کا ڈیٹا ہم تک نہیں آتا اور ہمارے کسی سرور پر محفوظ نہیں ہوتا۔ اجازتیں صرف آپ کے فون کے اندر کام کرتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون حساب، بدون تبلیغ، بدون ردیابی. موقعیت، اطلاعات شخصی، تقویم و داده‌های سلامت شما به ما نمی‌رسد و روی هیچ سروری از ما ذخیره نمی‌شود. مجوزها فقط درون گوشی شما کار می‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas de pub, pas de pistage. Votre position, vos données personnelles, votre calendrier et vos données de santé ne nous parviennent jamais et ne sont stockés sur aucun de nos serveurs. Les autorisations ne servent qu'à l'intérieur de votre téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни аккаунта, ни рекламы, ни слежки. Ваше местоположение, личные данные, календарь и данные о здоровье не попадают к нам и не хранятся на наших серверах. Разрешения работают только внутри вашего телефона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントも広告もトラッキングもありません。位置情報、個人情報、カレンダー、健康データが私たちに届くことはなく、どのサーバーにも保存されません。許可はあなたのスマートフォンの中だけで使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정도, 광고도, 추적도 없어요. 위치, 개인 정보, 일정, 건강 데이터는 저희에게 오지 않고 어떤 서버에도 저장되지 않아요. 권한은 휴대폰 안에서만 쓰여요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户，没有广告，没有跟踪。您的位置、个人信息、日历和健康数据都不会传给我们，也不会存在我们的任何服务器上。权限只在您的手机内部使用。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang account, walang ad, walang tracking. Hindi kailanman nakararating sa amin ang lokasyon, personal na impormasyon, kalendaryo at health data mo, at hindi ito iniimbak sa anumang server namin. Sa loob lang ng telepono mo gumagana ang mga pahintulot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีบัญชี ไม่มีโฆษณา ไม่มีการติดตาม ตำแหน่ง ข้อมูลส่วนตัว ปฏิทิน และข้อมูลสุขภาพของคุณไม่ถูกส่งมาถึงเรา และไม่ถูกเก็บบนเซิร์ฟเวอร์ใดของเรา สิทธิ์ต่าง ๆ ทำงานเฉพาะในโทรศัพท์ของคุณ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin anuncios, sin rastreo. Su ubicación, sus datos personales, su calendario y sus datos de salud nunca nos llegan ni se guardan en ningún servidor nuestro. Los permisos solo funcionan dentro de su teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem anúncios, sem rastreamento. Sua localização, seus dados pessoais, sua agenda e seus dados de saúde nunca chegam até nós nem ficam em nenhum servidor nosso. As permissões só funcionam dentro do seu celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न खाता, न विज्ञापन, न ट्रैकिंग। आपका स्थान, निजी जानकारी, कैलेंडर और सेहत का डेटा हम तक नहीं आता और हमारे किसी सर्वर पर नहीं रखा जाता। अनुमतियाँ सिर्फ़ आपके फ़ोन के अंदर काम करती हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অ্যাকাউন্ট নেই, বিজ্ঞাপন নেই, ট্র্যাকিং নেই। আপনার অবস্থান, ব্যক্তিগত তথ্য, ক্যালেন্ডার ও স্বাস্থ্য তথ্য কখনো আমাদের কাছে আসে না এবং আমাদের কোনো সার্ভারে সংরক্ষিত হয় না। অনুমতিগুলো শুধু আপনার ফোনের ভেতরে কাজ করে।"
          }
        }
      }
    },
    "onboard.trust.services": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava durumu ve yakındaki camiler için yalnız yaklaşık konum (yaklaşık 1 km) ilgili servise gider; kim olduğunuz gitmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For weather and nearby mosques, only an approximate location (about 1 km) goes to the relevant service, never who you are."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Wetter und Moscheen in der Nähe geht nur ein ungefährer Standort (etwa 1 km) an den jeweiligen Dienst, nie Ihre Identität."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava proqnozu və yaxınlıqdakı məscidlər üçün yalnız təxmini məkan (təxminən 1 km) həmin xidmətə gedir; kim olduğunuz getmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للطقس والمساجد القريبة يُرسَل موقع تقريبي فقط (نحو 1 كم) إلى الخدمة المعنية، ولا تُرسَل هويتك أبدًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk cuaca dan masjid terdekat, hanya perkiraan lokasi (sekitar 1 km) yang dikirim ke layanan terkait; identitas Anda tidak pernah dikirim."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موسم اور قریبی مساجد کے لیے صرف تخمینی مقام (تقریباً 1 کلومیٹر) متعلقہ سروس کو جاتا ہے؛ آپ کون ہیں، یہ کبھی نہیں جاتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای آب‌وهوا و مسجدهای نزدیک فقط موقعیت تقریبی (حدود 1 کیلومتر) به سرویس مربوط فرستاده می‌شود، هرگز هویت شما."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour la météo et les mosquées proches, seule une position approximative (environ 1 km) part vers le service concerné, jamais votre identité."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для погоды и ближайших мечетей в сервис уходит только примерное местоположение (около 1 км), но не то, кто вы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気と近くのモスクの検索には、おおよその位置（約1km）だけがそのサービスに送られます。あなたが誰かは送られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨와 가까운 모스크 검색에는 대략적인 위치(약 1km)만 해당 서비스로 가고, 누구인지는 절대 보내지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "天气和附近清真寺只会把大致位置（约 1 公里）发给相应服务，绝不会发送您的身份。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa panahon at kalapit na moske, tinatayang lokasyon lang (mga 1 km) ang napupunta sa serbisyo, hindi kung sino ka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับสภาพอากาศและมัสยิดใกล้เคียง จะส่งเพียงตำแหน่งโดยประมาณ (ราว 1 กม.) ไปยังบริการนั้น ไม่เคยส่งว่าคุณเป็นใคร"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para el tiempo y las mezquitas cercanas solo se envía una ubicación aproximada (cerca de 1 km) a ese servicio, nunca quién es usted."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o clima e mesquitas próximas, só uma localização aproximada (cerca de 1 km) vai para o serviço, nunca quem você é."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौसम और पास की मस्जिदों के लिए सिर्फ़ अनुमानित स्थान (लगभग 1 किमी) उस सेवा को जाता है, आप कौन हैं यह कभी नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবহাওয়া ও কাছের মসজিদের জন্য শুধু একটি আনুমানিক অবস্থান (প্রায় 1 কিমি) সংশ্লিষ্ট পরিষেবায় যায়, আপনি কে তা কখনো নয়।"
          }
        }
      }
    },
    "onboard.trust.servicesN": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava durumu gibi konuma bağlı servislere yalnız yaklaşık konum (yaklaşık 1 km) gider; kim olduğunuz gitmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For location-based services such as weather, only an approximate location (about 1 km) is sent, never who you are."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An standortbezogene Dienste wie das Wetter geht nur ein ungefährer Standort (etwa 1 km), nie Ihre Identität."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava proqnozu kimi məkana bağlı xidmətlərə yalnız təxmini məkan (təxminən 1 km) gedir; kim olduğunuz getmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُرسَل إلى الخدمات المرتبطة بالموقع، مثل الطقس، إلا موقع تقريبي (نحو 1 كم)، ولا تُرسَل هويتك أبدًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke layanan berbasis lokasi seperti cuaca, hanya perkiraan lokasi (sekitar 1 km) yang dikirim; identitas Anda tidak pernah dikirim."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موسم جیسی مقام پر مبنی سروسز کو صرف تخمینی مقام (تقریباً 1 کلومیٹر) جاتا ہے؛ آپ کون ہیں، یہ کبھی نہیں جاتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به سرویس‌های وابسته به مکان، مثل آب‌وهوا، فقط موقعیت تقریبی (حدود 1 کیلومتر) فرستاده می‌شود، هرگز هویت شما."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une position approximative (environ 1 km) part vers les services liés au lieu, comme la météo, jamais votre identité."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сервисы, зависящие от места, например погоду, уходит только примерное местоположение (около 1 км), но не то, кто вы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気など位置に関わるサービスには、おおよその位置（約1km）だけが送られます。あなたが誰かは送られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨처럼 위치가 필요한 서비스에는 대략적인 위치(약 1km)만 가고, 누구인지는 절대 보내지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "天气等基于位置的服务只会收到大致位置（约 1 公里），绝不会发送您的身份。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa mga serbisyong nakabatay sa lokasyon gaya ng panahon, tinatayang lokasyon lang (mga 1 km) ang napupunta, hindi kung sino ka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการที่ใช้ตำแหน่ง เช่น สภาพอากาศ จะได้รับเพียงตำแหน่งโดยประมาณ (ราว 1 กม.) ไม่เคยส่งว่าคุณเป็นใคร"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A los servicios que dependen del lugar, como el tiempo, solo se envía una ubicación aproximada (cerca de 1 km), nunca quién es usted."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para serviços que dependem do local, como o clima, só vai uma localização aproximada (cerca de 1 km), nunca quem você é."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौसम जैसी स्थान पर आधारित सेवाओं को सिर्फ़ अनुमानित स्थान (लगभग 1 किमी) जाता है, आप कौन हैं यह कभी नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবহাওয়ার মতো অবস্থানভিত্তিক পরিষেবার জন্য শুধু একটি আনুমানিক অবস্থান (প্রায় 1 কিমি) পাঠানো হয়, আপনি কে তা কখনো নয়।"
          }
        }
      }
    },
    "onboard.trust.later": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdiğiniz izinleri istediğiniz an Ayarlar › İzinler'den görür, kapatırsınız."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can see and turn off any permission at any time in Settings › Permissions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erteilte Berechtigungen sehen und widerrufen Sie jederzeit unter Einstellungen › Berechtigungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdiyiniz icazələri istədiyiniz an Parametrlər › İcazələr bölməsində görüb bağlayarsınız."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك رؤية أي إذن وإيقافه في أي وقت من الإعدادات › الأذونات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda bisa melihat dan mematikan izin kapan saja di Pengaturan › Izin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دی گئی اجازتیں جب چاہیں ترتیبات › اجازتیں میں دیکھیں اور بند کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مجوزهایی را که داده‌اید هر وقت خواستید در تنظیمات › مجوزها می‌بینید و خاموش می‌کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez voir et retirer chaque autorisation à tout moment dans Réglages › Autorisations."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выданные разрешения можно посмотреть и отключить в любой момент: Настройки › Разрешения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可はいつでも 設定 › 許可 で確認し、オフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용한 권한은 언제든 설정 › 권한에서 확인하고 끌 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可在 设置 › 权限 中查看并关闭任何权限。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Makikita at mapapatay mo ang anumang pahintulot anumang oras sa Settings › Mga pahintulot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูและปิดสิทธิ์ใดก็ได้ทุกเมื่อที่ การตั้งค่า › สิทธิ์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede ver y desactivar cualquier permiso cuando quiera en Ajustes › Permisos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ver e desligar qualquer permissão a qualquer momento em Ajustes › Permissões."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दी गई अनुमतियाँ जब चाहें सेटिंग्स › अनुमतियाँ में देखें और बंद करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো অনুমতি যেকোনো সময় সেটিংস › অনুমতিতে দেখতে ও বন্ধ করতে পারেন।"
          }
        }
      }
    },
