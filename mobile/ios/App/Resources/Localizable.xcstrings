    "retire.noteLaw": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayanak: 5510 sayılı Kanun madde 28, geçici madde 9 ve geçici madde 95 (EYT, 7438 sayılı Kanun); 506 sayılı Kanun geçici madde 81. Metinler mevzuat.gov.tr'den okundu (30 Ekim 2026). Kesin tarih için e-Devlet'teki SGK emeklilik hizmetlerine ya da SGK'ya başvurun."
