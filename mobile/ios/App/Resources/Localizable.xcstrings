        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your Eid be blessed with the reward of your fasts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möge Ihr Fest mit dem Lohn Ihres Fastens gesegnet sein."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Orucunuzun savabı ilə bayramınız mübarək olsun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيد مبارك بأجر صيامكم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga Lebaran Anda diberkahi pahala puasa."
