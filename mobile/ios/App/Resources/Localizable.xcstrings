    "zodiac.noTime": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğum saati yazılmadığı için öğlen 12.00 kabul edildi; Ay yaklaşık 2,5 günde bir burç değiştirir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No birth time was entered, so 12:00 noon was assumed; the Moon changes sign about every 2.5 days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Geburtszeit wurde 12:00 Uhr mittags angenommen; der Mond wechselt etwa alle 2,5 Tage das Zeichen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğum saatı yazılmadığı üçün günorta 12:00 qəbul edildi; Ay təxminən 2,5 gündən bir bürc dəyişir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُدخل وقت الميلاد فاعتُبرت الساعة 12:00 ظهرًا، والقمر ينتقل إلى برج جديد كل يومين ونصف تقريبًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam lahir tidak diisi, jadi dianggap pukul 12.00 siang; Bulan berganti zodiak sekitar setiap 2,5 hari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتِ پیدائش درج نہیں کیا گیا، اس لیے دوپہر 12:00 مانا گیا؛ چاند تقریباً ہر 2.5 دن میں برج بدلتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت تولد وارد نشد، پس ظهر (12:00) در نظر گرفته شد؛ ماه تقریباً هر 2.5 روز برجش را عوض می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune heure de naissance saisie : midi a été retenu ; la Lune change de signe environ tous les 2,5 jours."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время рождения не указано, поэтому взят полдень; Луна меняет знак примерно каждые 2,5 дня."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出生時刻が入力されていないため正午12:00として計算しました。月は約2.5日ごとに星座が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태어난 시간을 입력하지 않아 정오 12:00으로 계산했습니다. 달은 약 2.5일마다 별자리가 바뀝니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未输入出生时间，因此按中午12:00计算；月亮大约每2.5天换一个星座。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang inilagay na oras ng kapanganakan, kaya ipinalagay na 12:00 ng tanghali; nagpapalit ng sign ang Buwan halos bawat 2.5 araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้ใส่เวลาเกิด จึงคำนวณที่เวลาเที่ยงวัน 12:00 ดวงจันทร์ย้ายราศีราวทุก 2.5 วัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se indicó la hora de nacimiento, así que se tomó el mediodía (12:00); la Luna cambia de signo aproximadamente cada 2,5 días."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma hora de nascimento foi digitada, então foi considerado o meio-dia (12:00); a Lua muda de signo a cada 2,5 dias, aproximadamente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जन्म का समय नहीं लिखा गया, इसलिए दोपहर 12:00 माना गया; चंद्रमा लगभग हर 2.5 दिन में राशि बदलता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জন্মের সময় লেখা হয়নি, তাই দুপুর 12:00 ধরা হয়েছে; চাঁদ প্রায় প্রতি 2.5 দিনে রাশি বদলায়।"
          }
        }
      }
    },
    "zodiac.cusp": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş bu gün burç değiştiriyor; doğum saati sonucu değiştirebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sun changes sign on this day; the birth time can change the result."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne wechselt an diesem Tag das Zeichen; die Geburtszeit kann das Ergebnis ändern."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Günəş bu tarixdə bürcünü dəyişir; doğum saatı nəticəni dəyişə bilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتقل الشمس إلى برج آخر في هذا اليوم، وقد يغيّر وقت الميلاد النتيجة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matahari berganti zodiak pada hari ini; jam lahir dapat mengubah hasilnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس دن سورج برج بدلتا ہے؛ وقتِ پیدائش نتیجہ بدل سکتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خورشید در این روز برج عوض می‌کند؛ ساعت تولد ممکن است نتیجه را تغییر دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil change de signe ce jour-là ; l’heure de naissance peut modifier le résultat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот день Солнце переходит в другой знак; время рождения может изменить результат."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日は太陽が星座を移る日です。出生時刻によって結果が変わることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이날 태양의 별자리가 바뀝니다. 태어난 시간에 따라 결과가 달라질 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一天太阳更换星座；出生时间可能改变结果。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagpapalit ng sign ang Araw sa araw na ito; maaaring baguhin ng oras ng kapanganakan ang resulta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในวันนั้นดวงอาทิตย์ย้ายราศี เวลาเกิดอาจทำให้ผลเปลี่ยน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Sol cambia de signo este día; la hora de nacimiento puede cambiar el resultado."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sol muda de signo neste dia; a hora de nascimento pode mudar o resultado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दिन सूरज राशि बदलता है; जन्म का समय परिणाम बदल सकता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই দিনে সূর্য রাশি বদলায়; জন্মের সময় ফলাফল বদলে দিতে পারে।"
          }
        }
      }
    },
