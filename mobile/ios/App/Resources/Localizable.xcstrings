    "timeCalc.sumHint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1:30 (bir buçuk saat), 45 (dakika), 2:15:30 (saat:dakika:saniye) gibi yazın; çıkarmak için başına − koyun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write e.g. 1:30 (an hour and a half), 45 (minutes), 2:15:30 (hours:minutes:seconds); put − in front to subtract."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie z. B. 1:30 (anderthalb Stunden), 45 (Minuten), 2:15:30 (Std.:Min.:Sek.); mit − davor wird abgezogen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "1:30 (bir yarım saat), 45 (dəqiqə), 2:15:30 (saat:dəqiqə:saniyə) kimi yazın; çıxmaq üçün qabağına − qoyun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب مثلًا 1:30 (ساعة ونصف) أو 45 (دقائق) أو 2:15:30 (ساعات:دقائق:ثوانٍ)؛ ضع − قبلها للطرح."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis misalnya 1:30 (satu setengah jam), 45 (menit), 2:15:30 (jam:menit:detik); beri tanda − di depan untuk mengurangi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مثلاً لکھیں 1:30 (ڈیڑھ گھنٹہ)، 45 (منٹ)، 2:15:30 (گھنٹے:منٹ:سیکنڈ)؛ تفریق کے لیے شروع میں − لگائیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مثلاً بنویسید 1:30 (یک ساعت و نیم)، 45 (دقیقه)، 2:15:30 (ساعت:دقیقه:ثانیه)؛ برای کم کردن − بگذارید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez par ex. 1:30 (une heure et demie), 45 (minutes), 2:15:30 (heures:minutes:secondes) ; mettez − devant pour soustraire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишите, например, 1:30 (полтора часа), 45 (минуты), 2:15:30 (часы:минуты:секунды); поставьте − впереди, чтобы вычесть."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：1:30（1時間半）、45（分）、2:15:30（時:分:秒）。引くときは前に − を付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 1:30(1시간 반), 45(분), 2:15:30(시:분:초). 빼려면 앞에 −를 붙이세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如 1:30（一个半小时）、45（分钟）、2:15:30（时:分:秒）；在前面加 − 表示减去。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isulat hal. 1:30 (isa't kalahating oras), 45 (minuto), 2:15:30 (oras:minuto:segundo); lagyan ng − sa unahan para ibawas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียน เช่น 1:30 (ชั่วโมงครึ่ง), 45 (นาที), 2:15:30 (ชั่วโมง:นาที:วินาที) ใส่ − ข้างหน้าเพื่อลบ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba, por ejemplo, 1:30 (hora y media), 45 (minutos), 2:15:30 (horas:minutos:segundos); ponga − delante para restar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva, por exemplo, 1:30 (uma hora e meia), 45 (minutos), 2:15:30 (horas:minutos:segundos); coloque − na frente para subtrair."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे 1:30 (डेढ़ घंटा), 45 (मिनट), 2:15:30 (घंटे:मिनट:सेकंड) लिखें; घटाने के लिए आगे − लगाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেমন লিখুন 1:30 (দেড় ঘণ্টা), 45 (মিনিট), 2:15:30 (ঘণ্টা:মিনিট:সেকেন্ড); বিয়োগ করতে সামনে − দিন।"
          }
        }
      }
    },
