    "alarm.riseNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm sesi ilk 30 saniyede kısıktan tam sese çıkar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm sound rises from quiet to full volume over the first 30 seconds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Weckton steigt in den ersten 30 Sekunden von leise auf volle Lautstärke an."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəng səsi ilk 30 saniyədə zəifdən tam səsə qalxır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرتفع صوت المنبه تدريجيًا من الخافت إلى أعلى مستوى خلال أول 30 ثانية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara alarm naik dari pelan ke volume penuh selama 30 detik pertama."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم کی آواز پہلے 30 سیکنڈ میں دھیمی سے بڑھ کر پورے والیوم تک پہنچتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدای هشدار در 30 ثانیهٔ نخست از آهسته به بلندی کامل می‌رسد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son de l’alarme passe de doux à fort pendant les 30 premières secondes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук будильника нарастает от тихого до полного за первые 30 секунд."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラーム音が最初の30秒で小さな音から最大音量まで上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 소리가 처음 30초 동안 작게 시작해 최대 음량까지 커집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟声音在前30秒内从轻声升到最大音量。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalakas ang tunog ng alarma mula mahina hanggang buong lakas sa unang 30 segundo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงปลุกจะดังขึ้นจากเบาไปจนสุดในช่วง 30 วินาทีแรก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido de la alarma pasa de un volumen bajo al máximo durante los primeros 30 segundos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O som do alarme sobe do volume baixo ao máximo nos primeiros 30 segundos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म की आवाज़ पहले 30 सेकंड में धीमी से पूरी आवाज़ तक बढ़ती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথম 30 সেকেন্ডে অ্যালার্মের শব্দ মৃদু থেকে পূর্ণ ভলিউমে ওঠে।"
          }
        }
      }
    },
    "alarm.riseNoteIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumuşak bir melodi 20 saniyede kısıktan tam sese çıkar; açıkken iPhone'un alarm sesi yerine çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A soft melody rises from quiet to full volume over 20 seconds; when on, it plays instead of the iPhone alarm sound."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sanfte Melodie steigt in 20 Sekunden von leise auf volle Lautstärke an; wenn aktiv, ersetzt sie den iPhone-Weckton."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumşaq bir melodiya 20 saniyədə zəifdən tam səsə qalxır; açıq olanda iPhone-un zəng səsinin yerinə çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحن هادئ يرتفع من الخافت إلى أعلى مستوى خلال 20 ثانية؛ وعند تفعيله يُشغَّل بدل صوت منبه iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melodi lembut naik dari pelan ke volume penuh dalam 20 detik; bila aktif, melodi ini menggantikan suara alarm iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک نرم دھن 20 سیکنڈ میں دھیمی سے بڑھ کر پورے والیوم تک پہنچتی ہے؛ آن ہو تو آئی فون کی الارم آواز کی جگہ بجتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهنگی ملایم در 20 ثانیه از آهسته به بلندی کامل می‌رسد؛ وقتی روشن است به جای صدای هشدار آیفون پخش می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une douce mélodie monte progressivement jusqu’au volume maximal en 20 secondes ; lorsque l’option est activée, elle remplace le son d’alarme de l’iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкая мелодия нарастает от тихой до полной громкости за 20 секунд; если включено, она звучит вместо звука будильника iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やわらかなメロディーが20秒かけて小さな音から最大音量まで上がります。オンにするとiPhoneのアラーム音の代わりに鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 멜로디가 20초에 걸쳐 작게 시작해 최대 음량까지 커집니다. 켜면 iPhone 알람 소리 대신 재생됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一段柔和的旋律在20秒内从轻声升到最大音量；开启后将代替iPhone闹钟声音播放。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalakas ang malambot na himig mula mahina hanggang buong lakas sa loob ng 20 segundo; kapag naka-on, ito ang tumutugtog sa halip na tunog ng alarma ng iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำนองนุ่มนวลจะดังขึ้นจากเบาไปจนสุดภายใน 20 วินาที เมื่อเปิดไว้จะเล่นแทนเสียงปลุกของ iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una melodía suave pasa de un volumen bajo al máximo en 20 segundos; con esta opción activada, suena en lugar del sonido de alarma del iPhone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma melodia suave sobe do volume baixo ao máximo em 20 segundos; quando ativada, toca no lugar do som de alarme do iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक कोमल धुन 20 सेकंड में धीमी से पूरी आवाज़ तक बढ़ती है; चालू होने पर यह iPhone की अलार्म आवाज़ की जगह बजती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি নরম সুর 20 সেকেন্ডে মৃদু থেকে পূর্ণ ভলিউমে ওঠে; চালু থাকলে iPhone-এর অ্যালার্মের শব্দের বদলে এটি বাজে।"
          }
        }
      }
    },
    "alarm.skipHolidays": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resmî tatillerde çalmasın"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not on public holidays"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht an Feiertagen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rəsmi bayramlarda çalmasın"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرن في العطلات الرسمية"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak pada hari libur resmi"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرکاری تعطیلات پر نہیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌جز تعطیلات رسمی"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas les jours fériés"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не в праздники"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "祝日は鳴らさない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공휴일에는 울리지 않기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公共假日不响"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sa mga pampublikong holiday"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ปลุกในวันหยุดราชการ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No sonar en festivos"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não tocar nos feriados"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सार्वजनिक छुट्टियों पर नहीं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সরকারি ছুটিতে নয়"
          }
        }
      }
    },
    "alarm.skipHolidaysNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiye'deki resmî tatillerde (bayramlar dahil) çalmaz; yarım gün arifelerde çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays silent on Turkish public holidays (including the Eids); still rings on half-day eves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wecker bleibt an gesetzlichen Feiertagen der Türkei (einschließlich der Bayram-Feste) still; an halbtägigen Vorabenden klingelt er weiterhin."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiyədəki rəsmi qeyri-iş günlərində (dini bayramlar daxil) çalmır; yarımgünlük bayram ərəfələrində çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرن في العطلات الرسمية في تركيا (ومنها العيدان)؛ ويرن في أيام الوقفة ذات نصف الدوام."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak berbunyi pada hari libur resmi Turki (termasuk hari raya); tetap berbunyi pada hari menjelang hari raya yang libur setengah hari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترکی کی سرکاری تعطیلات (عیدوں سمیت) پر خاموش رہتا ہے؛ عید سے پہلے کے آدھے دن کی چھٹی پر پھر بھی بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تعطیلات رسمی ترکیه (از جمله عیدها) زنگ نمی‌زند؛ در نیمه‌تعطیل‌های پیش از عید زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste silencieuse les jours fériés turcs (y compris les Aïds) ; sonne quand même les veilles de fête (demi-journées)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Молчит в государственные праздники Турции (включая байрамы); в сокращённые предпраздничные дни звонит."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トルコの祝日（イードを含む）は鳴りません。半日休みとなる祝日前日は鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "튀르키예 공휴일(이드 포함)에는 울리지 않고, 반일만 쉬는 전날에는 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "土耳其公共假日（包括开斋节和宰牲节）不响；半天的节日前夕仍会响。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahimik sa mga pampublikong holiday sa Türkiye (kasama ang mga Eid); tumutunog pa rin sa mga bisperas na kalahating araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ดังในวันหยุดราชการของตุรกี (รวมวันอีด) แต่ยังดังในวันก่อนวันหยุดที่หยุดครึ่งวัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No suena en los festivos oficiales de Turquía (incluidos los Eid); sí suena en las vísperas de media jornada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica em silêncio nos feriados oficiais da Turquia (inclusive os Eids); ainda toca nas vésperas de meio expediente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुर्किये की सार्वजनिक छुट्टियों (ईद सहित) पर नहीं बजता; आधे दिन की पूर्व संध्याओं पर बजता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুরস্কের সরকারি ছুটিতে (ঈদসহ) বাজে না; অর্ধদিবস আগের দিনে বাজে।"
          }
        }
      }
    },
