    "cals.indian.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindistan'ın resmî Saka takvimine göre tarih, Saka yılbaşı ile Bengal ve Tamil yılbaşları."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date in India's official Saka calendar, the Saka New Year and the Bengali and Tamil New Years."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum im amtlichen Saka-Kalender Indiens, das Saka-Neujahr sowie das bengalische und das tamilische Neujahr."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindistanın rəsmi Saka təqviminə görə tarix, Saka ilbaşı, Benqal və Tamil ilbaşıları."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ بحسب تقويم ساكا الرسمي في الهند، ورأس السنة الساكية، ورأسا السنة البنغالية والتاميلية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal menurut kalender Saka resmi India, Tahun Baru Saka, serta Tahun Baru Bengali dan Tamil."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بھارت کے سرکاری شک کیلنڈر کے مطابق تاریخ، شک نیا سال، اور بنگالی و تمل نیا سال۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ بر پایهٔ تقویم رسمی ساکای هند، آغاز سال ساکا و سال نو بنگالی و تامیلی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date dans le calendrier saka officiel de l’Inde, le Nouvel An saka et les Nouvel An bengali et tamoul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата по официальному календарю Шака в Индии, Новый год Шака, бенгальский и тамильский Новый год."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インドの公式なサカ暦による日付、サカ暦の新年、ベンガルとタミルの新年。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인도의 공식 사카력 날짜, 사카력 새해, 벵골과 타밀의 새해."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "印度官方萨卡历的日期、萨卡历新年以及孟加拉新年和泰米尔新年。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang petsa sa opisyal na kalendaryong Saka ng India, ang Bagong Taon ng Saka, at ang Bagong Taon ng mga Bengali at Tamil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ตามปฏิทินศกอย่างเป็นทางการของอินเดีย วันขึ้นปีใหม่ศก และวันขึ้นปีใหม่เบงกอลและทมิฬ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha en el calendario saka oficial de la India, el Año Nuevo saka y los años nuevos bengalí y tamil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A data no calendário saka oficial da Índia, o Ano-Novo saka e os anos-novos bengali e tâmil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भारत के आधिकारिक शक संवत के अनुसार तारीख, शक नव वर्ष तथा बंगाली और तमिल नव वर्ष।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভারতের সরকারি শক ক্যালেন্ডারের তারিখ, শক নববর্ষ এবং বাংলা ও তামিল নববর্ষ।"
          }
        }
      }
    },
    "cals.indian.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saka takvimi Hindistan'ın resmî sivil takvimidir: 1 Çaitra 22 Mart'a düşer (artık yılda 21 Mart), yıl Gregoryen yılın 78 yıl gerisindedir. Bengal yılbaşı (Pohela Boişakh) Hindistan'daki kurala göredir; Bangladeş her yıl 14 Nisan'da kutlar. Tamil yılbaşı (Puthandu) Güneş'in yıldızıl Koç burcuna girişine göredir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Saka calendar is India's official civil calendar: 1 Chaitra falls on 22 March (21 March in leap years) and the year runs 78 years behind the Gregorian year. Bengali New Year (Pohela Boishakh) follows the rule used in India; Bangladesh celebrates it on 14 April every year. Tamil New Year (Puthandu) follows the Sun's entry into sidereal Aries."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saka-Kalender ist der amtliche zivile Kalender Indiens: Der 1. Chaitra fällt auf den 22. März (in Schaltjahren auf den 21. März), die Jahreszahl liegt 78 Jahre hinter der gregorianischen. Das bengalische Neujahr (Pohela Boishakh) folgt der in Indien üblichen Regel; Bangladesch feiert es jedes Jahr am 14. April. Das tamilische Neujahr (Puthandu) richtet sich nach dem Eintritt der Sonne in den siderischen Widder."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saka təqvimi Hindistanın rəsmi mülki təqvimidir: 1 Çaitra 22 marta düşür (uzun ildə 21 marta), il Qriqori ilindən 78 il geridədir. Benqal ilbaşı (Pohela Boyşax) Hindistandakı qaydaya görədir; Banqladeş onu hər il 14 apreldə qeyd edir. Tamil ilbaşı (Puthandu) Günəşin siderik Qoç bürcünə girməsinə görədir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقويم ساكا هو التقويم المدني الرسمي للهند: يوافق 1 تشايترا يوم 22 مارس (21 مارس في السنة الكبيسة)، وتتأخر سنته 78 عامًا عن السنة الميلادية. يتبع رأس السنة البنغالية (بوهيلا بويشاخ) القاعدة المعمول بها في الهند، أما بنغلاديش فتحتفل به في 14 أبريل كل عام. ويتبع رأس السنة التاميلية (بوثاندو) دخول الشمس برج الحمل النجمي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender Saka adalah kalender sipil resmi India (berbeda dari kalender Saka Bali): 1 Chaitra jatuh pada 22 Maret (21 Maret pada tahun kabisat), dan tahunnya 78 tahun di belakang tahun Masehi. Tahun Baru Bengali (Pohela Boishakh) mengikuti aturan yang dipakai di India; Bangladesh merayakannya setiap 14 April. Tahun Baru Tamil (Puthandu) mengikuti masuknya Matahari ke rasi Aries sideris."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شک کیلنڈر بھارت کا سرکاری شہری کیلنڈر ہے: یکم چیت 22 مارچ کو ہوتی ہے (لیپ کے سال میں 21 مارچ)، اور اس کا سال عیسوی سال سے 78 سال پیچھے ہے۔ بنگالی نیا سال (پوہیلا بوئیشاکھ) بھارت میں رائج قاعدے کے مطابق ہے؛ بنگلہ دیش اسے ہر سال 14 اپریل کو مناتا ہے۔ تمل نیا سال (پتھانڈو) سورج کے نجومی برجِ حمل میں داخلے کے مطابق ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تقویم ساکا تقویم رسمی مدنی هند است: 1 چیترا برابر با 22 مارس است (در سال کبیسه 21 مارس) و سال آن 78 سال از سال میلادی عقب‌تر است. سال نو بنگالی (پوهلا بویشاخ) طبق قاعدهٔ رایج در هند است؛ بنگلادش هر سال آن را در 14 آوریل جشن می‌گیرد. سال نو تامیلی (پوتاندو) بر پایهٔ ورود خورشید به برج حمل نجومی است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier saka est le calendrier civil officiel de l’Inde : le 1er Chaitra tombe le 22 mars (le 21 mars les années bissextiles) et l’année a 78 ans de retard sur l’année grégorienne. Le Nouvel An bengali (Pohela Boishakh) suit la règle en usage en Inde ; le Bangladesh le fête chaque année le 14 avril. Le Nouvel An tamoul (Puthandu) suit l’entrée du Soleil dans le Bélier sidéral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Календарь Шака — официальный гражданский календарь Индии: 1 чайтры приходится на 22 марта (в високосный год — на 21 марта), а год отстаёт от григорианского на 78 лет. Бенгальский Новый год (Похела Бойшакх) — по правилу, принятому в Индии; Бангладеш отмечает его каждый год 14 апреля. Тамильский Новый год (Путханду) — по вступлению Солнца в сидерический Овен."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サカ暦はインドの公式な市民暦です。チャイトラ月1日は3月22日（閏年は3月21日）で、年はグレゴリオ暦より78年遅れています。ベンガル新年（ポヘラ・ボイシャク）はインドで用いられる規則により、バングラデシュでは毎年4月14日です。タミル新年（プッタンドゥ）は太陽が恒星黄道の白羊宮に入る日によります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사카력은 인도의 공식 민간 달력입니다. 차이트라월 1일은 3월 22일(윤년에는 3월 21일)이며, 연도는 그레고리력보다 78년 늦습니다. 벵골 새해(포헬라 보이샤크)는 인도에서 쓰는 규칙을 따르며, 방글라데시는 매년 4월 14일에 지냅니다. 타밀 새해(푸탄두)는 태양이 항성 황도의 양자리에 들어가는 날을 따릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "萨卡历是印度官方的民用历法：制呾罗月1日为3月22日（闰年为3月21日），纪年比公历晚78年。孟加拉新年（博伊沙克节）按印度通行的规则计算，孟加拉国则每年于4月14日庆祝。泰米尔新年（普坦杜节）以太阳进入恒星白羊宫为准。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang kalendaryong Saka ang opisyal na sibil na kalendaryo ng India: pumapatak ang 1 Chaitra sa Marso 22 (Marso 21 sa leap year), at 78 taon itong nahuhuli sa taong Gregoryano. Sumusunod ang Bagong Taon ng Bengali (Pohela Boishakh) sa tuntuning gamit sa India; sa Bangladesh, ipinagdiriwang ito tuwing Abril 14. Sumusunod ang Bagong Taon ng Tamil (Puthandu) sa pagpasok ng Araw sa sidereal na Aries."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินศกเป็นปฏิทินทางราชการของอินเดีย วันที่ 1 เดือนไจตระตรงกับ 22 มีนาคม (21 มีนาคมในปีอธิกสุรทิน) และปีศกช้ากว่าปีคริสต์ศักราช 78 ปี ปีใหม่เบงกอล (โปเหลา ไบศาข) ใช้หลักที่ถือกันในอินเดีย ส่วนบังกลาเทศฉลองทุกวันที่ 14 เมษายน ปีใหม่ทมิฬ (ปุตตาณฑุ) ถือตามวันที่ดวงอาทิตย์เข้าสู่ราศีเมษแบบนิรายนะ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario saka es el calendario civil oficial de la India: el 1 de Chaitra cae el 22 de marzo (el 21 de marzo en años bisiestos) y su año va 78 años por detrás del gregoriano. El Año Nuevo bengalí (Pohela Boishakh) sigue la regla usada en la India; Bangladés lo celebra cada año el 14 de abril. El Año Nuevo tamil (Puthandu) sigue la entrada del Sol en Aries sideral."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário saka é o calendário civil oficial da Índia: o 1º de Chaitra cai em 22 de março (21 de março em anos bissextos), e o ano fica 78 anos atrás do gregoriano. O Ano-Novo bengali (Pohela Boishakh) segue a regra usada na Índia; Bangladesh o celebra todo ano em 14 de abril. O Ano-Novo tâmil (Puthandu) segue a entrada do Sol em Áries sideral."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शक संवत भारत का आधिकारिक नागरिक कैलेंडर है: 1 चैत्र 22 मार्च को पड़ता है (लीप वर्ष में 21 मार्च), और इसका वर्ष ग्रेगोरियन वर्ष से 78 वर्ष पीछे है। बंगाली नव वर्ष (पोहेला बोइशाख) भारत में प्रचलित नियम से है; बांग्लादेश इसे हर वर्ष 14 अप्रैल को मनाता है। तमिल नव वर्ष (पुथांडु) सूर्य के निरयण मेष राशि में प्रवेश के अनुसार है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শক ক্যালেন্ডার ভারতের সরকারি নাগরিক ক্যালেন্ডার: 1 চৈত্র 22 মার্চ (অধিবর্ষে 21 মার্চ) পড়ে এবং বছর গ্রেগরীয় বছরের চেয়ে 78 বছর পিছিয়ে চলে। পহেলা বৈশাখ (বাংলা নববর্ষ) ভারতে প্রচলিত নিয়ম অনুসরণ করে; বাংলাদেশ প্রতি বছর 14 এপ্রিল উদযাপন করে। পুথান্ডু (তামিল নববর্ষ) সূর্যের নিরয়ন মেষ রাশিতে প্রবেশ অনুসরণ করে।"
          }
        }
      }
    },
