    "support.feedbackNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta uygulamanız açılır. İletiye yalnız uygulama sürümü ve sistem sürümü eklenir; göndermeden önce görürsünüz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email app opens. Only the app version and system version are added to the message, and you see them before sending."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre E-Mail-App öffnet sich. Der Nachricht werden nur App- und Systemversion hinzugefügt; Sie sehen sie vor dem Senden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poçt tətbiqiniz açılır. Məktuba yalnız tətbiq və sistem versiyası əlavə olunur; göndərməzdən əvvəl görürsünüz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفتح تطبيق البريد لديك. لا يُضاف إلى الرسالة إلا إصدار التطبيق وإصدار النظام، وتراهما قبل الإرسال."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi email Anda akan terbuka. Hanya versi aplikasi dan versi sistem yang ditambahkan ke pesan, dan Anda melihatnya sebelum mengirim."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ای میل ایپ کھلے گی۔ پیغام میں صرف ایپ اور سسٹم کا ورژن شامل ہوتا ہے، اور آپ بھیجنے سے پہلے اسے دیکھتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه ایمیل شما باز می‌شود. فقط نسخه برنامه و نسخه سیستم به پیام افزوده می‌شود و پیش از ارسال آن را می‌بینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre application de messagerie s'ouvre. Seules les versions de l'application et du système sont ajoutées au message ; vous les voyez avant l'envoi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откроется почтовое приложение. В письмо добавляются только версия приложения и версия системы; вы увидите их перед отправкой."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアプリが開きます。メッセージに追加されるのはアプリとシステムのバージョンだけで、送信前に確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 앱이 열립니다. 메시지에는 앱 버전과 시스템 버전만 추가되며, 보내기 전에 확인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将打开您的邮件应用。邮件中只附加应用版本和系统版本，发送前您可以看到。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magbubukas ang email app mo. Bersyon lang ng app at ng system ang idinadagdag sa mensahe, at makikita mo ito bago ipadala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปอีเมลจะเปิดขึ้น ข้อความจะมีเพียงเวอร์ชันแอปและเวอร์ชันระบบ ซึ่งคุณเห็นได้ก่อนส่ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre su app de correo. Al mensaje solo se añaden la versión de la app y la del sistema, y las verá antes de enviarlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu app de e-mail abre. Só a versão do app e a do sistema são adicionadas à mensagem, e você as vê antes de enviar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका ईमेल ऐप खुलता है। संदेश में केवल ऐप और सिस्टम का संस्करण जोड़ा जाता है, और भेजने से पहले आप उसे देखते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ইমেইল অ্যাপ খুলবে। বার্তায় শুধু অ্যাপের সংস্করণ ও সিস্টেমের সংস্করণ যোগ হয়, এবং পাঠানোর আগে আপনি সেগুলো দেখতে পান।"
          }
        }
      }
    },
