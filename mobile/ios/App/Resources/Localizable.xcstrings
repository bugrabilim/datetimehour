    "tools.countdown.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri Sayım Sayacı ve Zamanlayıcı: Süre ve Tarihe Göre | Saat Tarih"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown Timer: By Duration or Date | Saat Tarih"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown-Timer: nach Dauer oder bis zu einem Datum | Saat Tarih"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Geriyə sayım taymeri: müddətə və ya tarixə görə | Saat Tarih"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّ تنازلي: بالمدة أو حتى تاريخ محدد | Saat Tarih"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung Mundur: Menurut Durasi atau Tanggal | Saat Tarih"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الٹی گنتی ٹائمر: دورانیے یا تاریخ کے مطابق | Saat Tarih"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شمارش معکوس: بر اساس مدت یا تاریخ | Saat Tarih"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte à rebours : par durée ou jusqu’à une date | Saat Tarih"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймер обратного отсчёта: по длительности или до даты | Saat Tarih"
          }
        }
      }
    },
    "tools.countdown.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz geri sayım: dakika zamanlayıcısı ya da belirlediğiniz tarihe kalan süre. Yeni yıla ve bayrama geri sayım, sesli uyarı ve tam ekran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free countdown: a minute timer or the time left until a date you choose. Countdown to New Year and bayram, sound alert and full screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenloser Countdown: Minuten-Timer oder die Zeit bis zu einem Wunschdatum. Countdown bis Neujahr und zum Bayram, mit Tonsignal und Vollbild."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsuz geriyə sayım: dəqiqə taymeri və ya seçdiyiniz tarixə qalan vaxt. Yeni ilə və bayrama geriyə sayım, səsli xəbərdarlıq və tam ekran."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّ تنازلي مجاني: مؤقت بالدقائق أو الوقت المتبقي حتى تاريخ تختاره. عدّ تنازلي لرأس السنة والعيد، مع تنبيه صوتي وملء الشاشة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung mundur gratis: pengatur waktu menit atau sisa waktu menuju tanggal pilihan Anda. Hitung mundur Tahun Baru dan bayram, peringatan suara, dan layar penuh."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفت الٹی گنتی: منٹوں کا ٹائمر یا آپ کی منتخب تاریخ تک باقی وقت۔ نئے سال اور عید کی الٹی گنتی، آواز والا انتباہ اور پوری اسکرین۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شمارش معکوس رایگان: زمان‌سنج دقیقه‌ای یا زمان مانده تا تاریخی که انتخاب می‌کنید. شمارش معکوس سال نو و عید، هشدار صوتی و تمام‌صفحه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte à rebours gratuit : un minuteur ou le temps restant jusqu’à la date de votre choix. Compte à rebours du Nouvel An et des bayrams, alerte sonore et plein écran."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный обратный отсчёт: таймер на минуты или время до выбранной даты. Отсчёт до Нового года и байрама, звуковой сигнал и полноэкранный режим."
          }
        }
      }
    },
    "tools.countdown.h1": {
      "extractionState": "manual",
      "localizations": {
