    "nature.tableLead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronomik mevsimler, yani ekinoks ve gündönümü anları. Saatler Türkiye saatiyle (UTC+3) verilmiştir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronomical seasons, that is the moments of the equinoxes and solstices. Times are in Turkey time (UTC+3)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronomische Jahreszeiten, also die Zeitpunkte der Tagundnachtgleichen und Sonnenwenden. Die Zeiten sind in türkischer Zeit (UTC+3) angegeben."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronomik fəsillər, yəni bərabərgünlük və gündönümü anları. Vaxtlar Türkiyə vaxtı ilədir (UTC+3)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفصول الفلكية، أي لحظات الاعتدالين والانقلابين. الأوقات بتوقيت تركيا (UTC+3)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Musim astronomis, yaitu saat terjadinya ekuinoks dan titik balik matahari. Waktu dinyatakan dalam waktu Turki (UTC+3)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فلکیاتی موسم، یعنی اعتدال اور انقلاب کے لمحات۔ اوقات ترکی کے وقت (UTC+3) میں ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فصل‌های نجومی، یعنی لحظه‌های اعتدال‌ها و انقلاب‌ها. زمان‌ها به وقت ترکیه (UTC+3) است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisons astronomiques, c’est-à-dire les instants des équinoxes et des solstices. Heures exprimées à l’heure de Turquie (UTC+3)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Астрономические времена года, то есть моменты равноденствий и солнцестояний. Время указано по Турции (UTC+3)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天文学上の季節、つまり春分・秋分と夏至・冬至の瞬間です。時刻はトルコ時間（UTC+3）です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천문학적 계절, 곧 춘분·추분과 하지·동지의 순간입니다. 시각은 튀르키예 시간(UTC+3)입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "天文季节，即春分秋分和夏至冬至的时刻。时间为土耳其时间（UTC+3）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga astronomikal na panahon, ibig sabihin ang mga sandali ng equinox at solstice. Nasa oras ng Türkiye (UTC+3) ang mga oras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฤดูกาลทางดาราศาสตร์ คือช่วงเวลาของวิษุวัตและอายัน เวลาเป็นเวลาตุรกี (UTC+3)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estaciones astronómicas, es decir, los momentos de los equinoccios y solsticios. Las horas se indican en hora de Turquía (UTC+3)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estações astronômicas, ou seja, os momentos dos equinócios e solstícios. Os horários estão na hora da Turquia (UTC+3)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खगोलीय ऋतुएँ, यानी विषुव और संक्रांति के क्षण। समय तुर्किये समय (UTC+3) में हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জ্যোতির্বিজ্ঞানের ঋতু, অর্থাৎ বিষুব ও অয়নান্তের মুহূর্ত। সময়গুলো তুরস্কের সময়ে (UTC+3)।"
          }
        }
      }
    },
