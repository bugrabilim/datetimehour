            "state": "translated",
            "value": "برنامهٔ تنظیمات گوشی را باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app Paramètres du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
