    "widget.config.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakitlerin gösterileceği il. Otomatik seçimde konumunuza en yakın il kullanılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The province whose times are shown. Automatic uses the province nearest to you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Provinz, deren Zeiten angezeigt werden. Automatisch verwendet die nächstgelegene Provinz."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtları göstəriləcək vilayət. Avtomatik seçimdə sizə ən yaxın vilayət istifadə olunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الولاية التي تُعرض أوقاتها. يستخدم الخيار التلقائي أقرب ولاية إليك."
          }
        }
      }
    },
