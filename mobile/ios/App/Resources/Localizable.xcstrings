    "wake.object.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf telefonda tanınır, saklanmaz ve hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is recognised on the phone, not stored and not sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto wird auf dem Telefon erkannt, nicht gespeichert und nirgendwohin gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şəkil telefonda tanınır, saxlanmır və heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُتعرَّف على الصورة على الهاتف، ولا تُحفظ ولا تُرسل إلى أي مكان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dikenali di ponsel, tidak disimpan dan tidak dikirim ke mana pun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر فون پر پہچانی جاتی ہے، محفوظ نہیں ہوتی اور کہیں نہیں بھیجی جاتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکس روی گوشی شناخته می‌شود، ذخیره نمی‌شود و به جایی فرستاده نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo est reconnue sur le téléphone, ni enregistrée ni envoyée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото распознаётся на телефоне, не сохраняется и никуда не отправляется."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は端末内で認識され、保存も送信もされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 휴대폰에서 인식되며 저장되거나 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片在手机上识别，不会保存或发送。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinikilala ang larawan sa telepono, hindi sine-save at hindi ipinapadala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพถูกจดจำบนโทรศัพท์ ไม่ถูกบันทึกและไม่ถูกส่งไปที่ใด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto se reconoce en el teléfono; no se guarda ni se envía a ningún sitio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto é analisada no celular; não é salva nem enviada para lugar nenhum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो फ़ोन पर ही पहचानी जाती है, न सहेजी जाती है न कहीं भेजी जाती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিটি ফোনেই চেনা হয়, সংরক্ষণ বা কোথাও পাঠানো হয় না।"
          }
        }
      }
