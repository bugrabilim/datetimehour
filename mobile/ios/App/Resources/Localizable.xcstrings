    "notify.cat.prayer.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz vakitlerde ya da birkaç dakika önce."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the times you choose, or a few minutes before."
          }
