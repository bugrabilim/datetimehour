    "alarm.fromCalendarNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlik telefondaki takvimlerden seçilir; başlangıcından seçilen süre önce bir kezlik alarm kurulur (tüm gün etkinlikte o gün 09.00). Takvim izni Takvim sekmesinden verilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event is picked from the phone's calendars; a one-time alarm is set the chosen time before it starts (09:00 that day for all-day events). Calendar access is granted in the Calendar tab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Termin wird aus den Kalendern des Telefons gewählt; ein einmaliger Wecker klingelt die gewählte Zeit vor Beginn (bei ganztägigen Terminen an dem Tag um 09:00). Kalenderzugriff wird im Tab Kalender erteilt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tədbir telefondakı təqvimlərdən seçilir; başlanğıcından seçilən müddət əvvəl birdəfəlik zəng qurulur (günboyu tədbirlərdə həmin gün 09:00-da). Təqvim icazəsi Təqvim bölməsindən verilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُختار الحدث من تقويمات الهاتف؛ ويُضبط منبّه لمرة واحدة قبل بدايته بالمدة المختارة (الساعة 09:00 في ذلك اليوم للأحداث طوال اليوم). يُمنح إذن التقويم من تبويب التقويم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara dipilih dari kalender ponsel; alarm satu kali dipasang sesuai waktu yang dipilih sebelum acara dimulai (pukul 09.00 hari itu untuk acara sepanjang hari). Akses kalender diberikan di tab Kalender."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تقریب فون کے کیلنڈرز سے چنی جاتی ہے؛ آغاز سے منتخب وقت پہلے ایک بار کا الارم لگتا ہے (پورے دن کی تقریبات کے لیے اسی دن صبح 9:00)۔ کیلنڈر تک رسائی کیلنڈر ٹیب میں دی جاتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رویداد از تقویم‌های گوشی انتخاب می‌شود؛ هشداری یک‌باره به اندازهٔ زمان انتخابی پیش از آغاز آن تنظیم می‌شود (برای رویدادهای تمام‌روز ساعت 9:00 همان روز). دسترسی به تقویم در زبانهٔ تقویم داده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’événement est choisi dans les calendriers du téléphone ; une alarme unique est réglée pour sonner avec l’avance choisie avant son début (à 9 h ce jour-là pour les événements d’une journée entière). L’accès au calendrier s’accorde dans l’onglet Calendrier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Событие выбирается из календарей телефона; одноразовый будильник ставится за выбранное время до начала (для событий на весь день — в 9:00 того дня). Доступ к календарю даётся на вкладке «Календарь»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定はスマホのカレンダーから選びます。開始時刻の指定した時間前に1回だけのアラームを設定します（終日の予定はその日の09:00）。カレンダーへのアクセスはカレンダータブで許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정은 휴대폰 달력에서 고릅니다. 시작 전 정한 시간만큼 앞서 한 번 울리는 알람을 맞춥니다(종일 일정은 그날 09:00). 달력 접근은 달력 탭에서 허용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从手机日历中选择日程；在开始前的设定时间设一次性闹钟（全天日程为当天09:00）。日历访问在日历标签页中授权。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinipili ang event mula sa mga kalendaryo ng telepono; isang beses na alarma ang itinatakda sa piniling oras bago ito magsimula (09:00 ng araw na iyon para sa buong-araw na event). Ibinibigay ang access sa kalendaryo sa tab na Kalendaryo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกกิจกรรมจากปฏิทินในโทรศัพท์ แอปจะตั้งนาฬิกาปลุกครั้งเดียวก่อนกิจกรรมเริ่มตามเวลาที่เลือก (สำหรับกิจกรรมทั้งวันจะปลุกเวลา 09:00 ของวันนั้น) อนุญาตการเข้าถึงปฏิทินได้ในแท็บปฏิทิน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El evento se elige de los calendarios del teléfono; se pone una alarma única el tiempo elegido antes de que empiece (a las 09:00 de ese día en eventos de todo el día). El acceso al calendario se concede en la pestaña Calendario."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O evento é escolhido nos calendários do celular; um alarme único é criado com a antecedência escolhida em relação ao início (às 09:00 daquele dia para eventos de dia inteiro). O acesso ao calendário é concedido na aba Calendário."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इवेंट फ़ोन के कैलेंडरों से चुना जाता है; उसके शुरू होने से चुने समय पहले एक बार का अलार्म लगता है (पूरे दिन के इवेंट के लिए उस दिन 09:00)। कैलेंडर की पहुँच कैलेंडर टैब में दी जाती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইভেন্টটি ফোনের ক্যালেন্ডার থেকে বাছা হয়; শুরুর বেছে নেওয়া সময় আগে একবারের অ্যালার্ম দেওয়া হয় (সারাদিনের ইভেন্টে সেদিন 09:00)। ক্যালেন্ডারের অনুমতি ক্যালেন্ডার ট্যাবে দেওয়া হয়।"
          }
        }
      }
    },
