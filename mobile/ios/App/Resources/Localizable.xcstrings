    "nature.ym.blue": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mavi Ay: %1$@ (aynı takvim ayındaki ikinci dolunay)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blue Moon: %1$@ (the second full moon in a calendar month)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blauer Mond: %1$@ (zweiter Vollmond in einem Kalendermonat)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mavi Ay: %1$@ (eyni təqvim ayında ikinci bədir)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القمر الأزرق: %1$@ (البدر الثاني في الشهر الميلادي نفسه)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulan Biru: %1$@ (purnama kedua dalam satu bulan kalender)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیلا چاند: %1$@ (ایک ہی کیلنڈر مہینے کا دوسرا پورا چاند)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ماه آبی: %1$@ (دومین ماه کامل در یک ماه تقویمی)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lune bleue : %1$@ (deuxième pleine lune d'un même mois)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голубая Луна: %1$@ (второе полнолуние в календарном месяце)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブルームーン：%1$@（同じ暦月の2回目の満月）。"
