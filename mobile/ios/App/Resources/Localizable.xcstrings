    "intent.full.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekran saati aç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Full-Screen Clock"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollbilduhr öffnen"
          }
        },
        "az": {
          "stringUnit": {
