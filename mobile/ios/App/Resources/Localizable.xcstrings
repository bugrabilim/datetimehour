    "fontScale.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadaki yazıları büyütür ya da küçültür. %%100 telefonun kendi ayarıdır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makes the app's text larger or smaller. 100%% is your phone's own setting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrößert oder verkleinert die Texte der App. 100 %% ist die Einstellung Ihres Telefons."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqdəki yazıları böyüdür və ya kiçildir. 100%% telefonun öz ayarıdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكبّر نصوص التطبيق أو يصغّرها. 100%% هو إعداد هاتفك نفسه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memperbesar atau memperkecil teks aplikasi. 100%% adalah pengaturan ponsel Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ کے متن کو بڑا یا چھوٹا کرتا ہے۔ 100%% آپ کے فون کی اپنی ترتیب ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متن‌های برنامه را بزرگ یا کوچک می‌کند. 100%% تنظیم خود گوشی شماست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrandit ou réduit les textes de l'application. 100 %% correspond au réglage de votre téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличивает или уменьшает текст в приложении. 100 %% — собственная настройка телефона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの文字を大きく、または小さくします。100%%は端末の設定どおりです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 글자를 크게 또는 작게 합니다. 100%%는 휴대폰 자체 설정입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大或缩小应用中的文字。100%% 为手机本身的设置。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinalalaki o pinaliliit ang teksto ng app. Ang 100%% ay ang sariling setting ng telepono mo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขยายหรือย่อตัวอักษรในแอป 100%% คือการตั้งค่าของโทรศัพท์เอง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agranda o reduce el texto de la app. El 100%% es el ajuste de su teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa o texto do app maior ou menor. 100%% é a configuração do seu celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप के अक्षर बड़े या छोटे करता है। 100%% आपके फ़ोन की अपनी सेटिंग है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপের লেখা বড় বা ছোট করে। 100%% হলো আপনার ফোনের নিজস্ব সেটিং।"
          }
        }
      }
    },
