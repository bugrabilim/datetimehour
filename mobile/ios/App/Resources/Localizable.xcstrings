        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月々の王がご家庭に安らぎをもたらしますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달 중의 으뜸인 이 달이 가정에 평안을 주길 바랍니다."
