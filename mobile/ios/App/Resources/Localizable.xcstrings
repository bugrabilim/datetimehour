    "quran.goalNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunan ayet, kaldığım yer işaretini ilerlettikçe sayılır (ayete dokunun)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verses are counted as you move your bookmark forward (tap a verse)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verse zählen, wenn Sie das Lesezeichen vorwärts setzen (Vers antippen)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxunan ayə qaldığım yer işarəsini irəlilətdikcə sayılır (ayəyə toxunun)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب الآيات كلما قدّمت موضع القراءة (المس الآية)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayat dihitung saat penanda dimajukan (ketuk ayat)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نشان آگے بڑھانے پر آیات گنی جاتی ہیں (آیت کو چھوئیں)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با جلو بردن نشانه، آیه‌ها شمرده می‌شوند (آیه را لمس کنید)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les versets sont comptés quand vous avancez le signet (touchez un verset)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аяты засчитываются, когда вы двигаете закладку вперёд (коснитесь аята)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しおりを先へ進めると節数が数えられます（節をタップ）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책갈피를 앞으로 옮기면 절 수가 셉니다(절을 누르세요)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向前移动书签时计数（点按经文）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binibilang ang talata habang inuusad ang bookmark (i-tap ang talata)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับอายะฮ์เมื่อเลื่อนที่คั่นไปข้างหน้า (แตะอายะฮ์)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las aleyas se cuentan al avanzar el marcador (toque una aleya)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os versículos são contados conforme você avança o marcador (toque num versículo)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बुकमार्क आगे बढ़ाने पर आयतें गिनी जाती हैं (किसी आयत पर टैप करें)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বুকমার্ক এগিয়ে নিলে (কোনো আয়াতে চাপলে) আয়াত গোনা হয়।"
          }
        }
      }
    },
