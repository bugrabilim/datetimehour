    "focus.schedOn": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an çizelge içinde: engel açık"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Within the schedule now: blocking is on"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade im Zeitplan: Sperre aktiv"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İndi cədvəl daxilində: bloklama açıqdır"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضمن الجدول الآن: الحجب مفعّل"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang dalam jadwal: blokir aktif"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی شیڈول کے اندر: روک فعال ہے"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اکنون در بازه برنامه: مسدودسازی روشن است"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le créneau : blocage actif"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас по расписанию: блокировка включена"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在スケジュール中：ブロック中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 일정 시간: 차단 중"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前在计划时段内：屏蔽已开启"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa iskedyul ngayon: naka-on ang harang"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่ในช่วงเวลาตามกำหนด: กำลังบล็อก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dentro del horario: bloqueo activado"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dentro do horário agora: bloqueio ativado"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी समय-सारणी के भीतर: ब्लॉकिंग चालू"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন সূচির মধ্যে: ব্লক চালু"
          }
        }
      }
    },
    "focus.schedNoteIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da çizelge uygulama açıldığında ve arka plan yenilemesinde uygulanır; tam dakikasında başlamayabilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone the schedule is applied when the app opens and during background refresh, so it may not start on the exact minute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem iPhone greift der Zeitplan beim Öffnen der App und bei der Hintergrundaktualisierung, also nicht immer minutengenau."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-da cədvəl tətbiq açılanda və arxa fonda yenilənəndə tətbiq olunur; tam dəqiqəsində başlamaya bilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على iPhone يُطبَّق الجدول عند فتح التطبيق وأثناء التحديث في الخلفية، لذلك قد لا يبدأ في الدقيقة نفسها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di iPhone jadwal diterapkan saat aplikasi dibuka dan saat penyegaran latar belakang, jadi mungkin tidak dimulai tepat pada menitnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئی فون پر شیڈول ایپ کھلنے اور پس منظر میں تازہ کاری پر لاگو ہوتا ہے، اس لیے بالکل اسی منٹ پر شروع نہ ہو۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در آیفون برنامه هنگام باز شدن برنامه و به‌روزرسانی پس‌زمینه اعمال می‌شود و ممکن است دقیقاً سر دقیقه شروع نشود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPhone, le planning s’applique à l’ouverture de l’app et lors de l’actualisation en arrière-plan : pas toujours à la minute près."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iPhone расписание применяется при открытии приложения и при фоновом обновлении, поэтому может начаться не точно в минуту."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneではアプリを開いた時とバックグラウンド更新時に適用されるため、ちょうどの分に始まらないことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서는 앱을 열 때와 백그라운드 새로 고침 때 적용되어 정확한 분에 시작되지 않을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上，计划在打开应用和后台刷新时生效，因此可能不会准时到分。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa iPhone, inilalapat ang iskedyul kapag binuksan ang app at sa background refresh, kaya maaaring hindi eksakto sa minuto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน iPhone ตารางเวลาจะใช้เมื่อเปิดแอปและเมื่อรีเฟรชเบื้องหลัง จึงอาจไม่เริ่มตรงนาที"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el iPhone el horario se aplica al abrir la app y durante la actualización en segundo plano, así que puede no empezar en el minuto exacto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone o horário é aplicado ao abrir o app e na atualização em segundo plano, por isso pode não começar no minuto exato."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone पर समय-सारणी ऐप खुलने पर और बैकग्राउंड रिफ़्रेश में लागू होती है, इसलिए हो सकता है कि यह ठीक उसी मिनट शुरू न हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-এ সূচিটি অ্যাপ খোলার সময় ও পটভূমি হালনাগাদের সময় প্রয়োগ হয়, তাই ঠিক মিনিটে শুরু নাও হতে পারে।"
          }
        }
      }
    },
