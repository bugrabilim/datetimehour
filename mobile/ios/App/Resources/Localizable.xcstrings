    "notify.cat.daily.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sabah 08.00'de takvim yaprağındaki söz, sessiz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every morning at 08:00, the saying from the calendar page, silently."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Morgen um 08:00 der Spruch des Kalenderblatts, lautlos."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər səhər 08:00-da təqvim vərəqindəki söz, səssiz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل صباح في 08:00 حكمة ورقة التقويم، بلا صوت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pagi pukul 08.00, pepatah dari lembar kalender, tanpa suara."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر صبح 08:00 بجے کیلنڈر ورق کا قول، خاموشی سے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر صبح ساعت 08:00 سخن برگ تقویم، بی‌صدا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque matin à 08:00, la maxime de la feuille du calendrier, sans son."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое утро в 08:00 — изречение с листка календаря, без звука."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎朝08:00に日めくりのことわざを音なしで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 아침 08:00에 일력의 격언을 소리 없이."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天早上 08:00，无声推送日历页上的格言。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuwing umaga, 08:00, ang kasabihan sa pahina ng kalendaryo, tahimik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกเช้าเวลา 08:00 คำคมจากปฏิทินแบบไม่มีเสียง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mañana a las 08:00, el refrán de la hoja del calendario, en silencio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda manhã às 08:00, o ditado da folha do calendário, em silêncio."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सुबह 08:00 बजे, कैलेंडर पन्ने की कहावत, बिना आवाज़।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিদিন সকাল 08:00-এ ক্যালেন্ডারের পাতার বাণী, নীরবে।"
          }
        }
      }
    },
