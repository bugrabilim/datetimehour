    "prayer.ezaniNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezani (alaturka) saatte akşam vakti 12.00 kabul edilir; saat oradan sayılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Ezani (alaturka) time, maghrib (sunset) is 12:00 and hours are counted from there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Ezani-Zeit (alla turca) gilt das Abendgebet (Sonnenuntergang) als 12:00; von dort wird gezählt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əzani (alaturka) saatda axşam vaxtı 12:00 sayılır; saat oradan hesablanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في التوقيت الغروبي يُعدّ وقت المغرب الساعة 12:00 وتُحسب الساعات منه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada waktu ezani (alaturka), waktu magrib dianggap pukul 12.00 dan jam dihitung dari sana."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اذانی (الاترکا) وقت میں مغرب کو 12:00 مانا جاتا ہے اور وہیں سے گھنٹے گنے جاتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در ساعت اذانی (غروبی) وقت مغرب ساعت 12:00 به شمار می‌آید و ساعت‌ها از آن شمرده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l'heure ezani (alla turca), la prière du soir (coucher du soleil) vaut 12 h 00 ; on compte à partir de là."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В эзани (алатурка) время вечерней молитвы (закат) считается 12:00, отсчёт идёт от него."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エザーニ（アラトゥルカ）時刻では日没の礼拝時刻を12:00とし、そこから数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에자니(알라투르카) 시각에서는 일몰 예배 시각을 12:00으로 보고 거기서부터 셉니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在埃扎尼（日落）计时中，昏礼（日落）时刻记为 12:00，并由此计时。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa oras na ezani (alaturka), 12:00 ang oras ng dasal sa paglubog ng araw at doon nagsisimula ang bilang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในเวลาเอซานี (อาลาตูร์กา) เวลาละหมาดตอนพระอาทิตย์ตกถือเป็น 12:00 แล้วนับต่อจากนั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la hora ezani (a la turca), la oración del atardecer (puesta del sol) es a las 12:00 y las horas se cuentan desde ahí."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na hora ezani (à turca), a oração do entardecer (pôr do sol) corresponde às 12:00 e as horas são contadas a partir dela."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अज़ानी (अलातुर्का) समय में शाम की नमाज़ (सूर्यास्त) 12:00 होती है और घंटे वहीं से गिने जाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এজানি (আলাতুর্কা) সময়ে মাগরিব (সূর্যাস্ত) 12:00 এবং সেখান থেকে ঘণ্টা গোনা হয়।"
          }
        }
      }
    },
