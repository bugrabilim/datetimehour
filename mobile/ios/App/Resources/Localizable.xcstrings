          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçdiyiniz vaxtlarda və ya bir neçə dəqiqə əvvəl."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الأوقات التي تختارها أو قبلها ببضع دقائق."
