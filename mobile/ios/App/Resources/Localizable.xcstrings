    "notify.cat.habits.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku planı açıkken: yatmadan 8 saat önce kafein, 1 saat önce ekran, 30 dakika önce akşam rutini hatırlatması."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a sleep plan: reminders for caffeine 8 hours, screens 1 hour and your evening routine 30 minutes before bed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Schlafplan: Erinnerung an Koffein 8 Stunden, Bildschirme 1 Stunde und Abendroutine 30 Minuten vor dem Schlafen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuxu planı açıq olanda: yatmazdan 8 saat əvvəl kofein, 1 saat əvvəl ekran, 30 dəqiqə əvvəl axşam rutini xatırlatması."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع خطة النوم: تذكير بالكافيين قبل النوم بـ 8 ساعات، والشاشات قبل ساعة، وروتين المساء قبل 30 دقيقة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan rencana tidur: pengingat kafein 8 jam, layar 1 jam, dan rutinitas malam 30 menit sebelum tidur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیند کا منصوبہ ہو تو: سونے سے 8 گھنٹے پہلے کیفین، 1 گھنٹہ پہلے اسکرین، 30 منٹ پہلے شام کے معمول کی یاددہانی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با برنامه خواب: یادآوری کافئین 8 ساعت، صفحه‌نمایش 1 ساعت و روال شبانه 30 دقیقه پیش از خواب."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un planning : rappels caféine 8 h, écrans 1 h et routine du soir 30 min avant le coucher."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При плане сна: напоминания о кофеине за 8 часов, экранах за час и вечернем ритуале за 30 минут до сна."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠プランがある時：就寝8時間前にカフェイン、1時間前に画面、30分前に夜のルーティンをお知らせ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 계획이 있을 때: 취침 8시간 전 카페인, 1시간 전 화면, 30분 전 저녁 루틴 알림."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启睡眠计划时：睡前 8 小时提醒咖啡因、1 小时提醒屏幕、30 分钟提醒晚间习惯。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag may plano sa tulog: paalala sa caffeine 8 oras, screen 1 oras, at routine sa gabi 30 minuto bago matulog."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีแผนการนอน: เตือนเรื่องคาเฟอีนก่อนนอน 8 ชั่วโมง หน้าจอ 1 ชั่วโมง และกิจวัตรยามค่ำ 30 นาที"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un plan de sueño: avisos de cafeína 8 horas, pantallas 1 hora y rutina de la noche 30 minutos antes de acostarse."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um plano de sono: lembretes de cafeína 8 horas, telas 1 hora e rotina da noite 30 minutos antes de dormir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नींद की योजना के साथ: सोने से 8 घंटे पहले कैफ़ीन, 1 घंटे पहले स्क्रीन और 30 मिनट पहले शाम की दिनचर्या के रिमाइंडर।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমের সূচি থাকলে: শোয়ার 8 ঘণ্টা আগে ক্যাফেইন, 1 ঘণ্টা আগে পর্দা এবং 30 মিনিট আগে সন্ধ্যার রুটিনের রিমাইন্ডার।"
          }
        }
      }
    },
