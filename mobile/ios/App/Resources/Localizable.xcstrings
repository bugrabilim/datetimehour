    "account.prefsApp": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamada dil ve tema uygulamanın ayarlarıdır; hesabınıza gelen e-postalar seçtiğiniz dilde gider."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the app, language and theme are the app's settings; emails to your account are sent in the language you choose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der App sind Sprache und Design Einstellungen der App; E-Mails an Ihr Konto gehen in der gewählten Sprache."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqdə dil və mövzu tətbiqin ayarlarıdır; hesabınıza gələn e-poçtlar seçdiyiniz dildə gedir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في التطبيق، اللغة والمظهر من إعدادات التطبيق؛ وتُرسل رسائل حسابك باللغة التي تختارها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di aplikasi, bahasa dan tema adalah pengaturan aplikasi; email untuk akun Anda dikirim dalam bahasa yang Anda pilih."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ میں زبان اور تھیم ایپ کی ترتیبات ہیں؛ آپ کے اکاؤنٹ کی ای میلز آپ کی منتخب زبان میں جاتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در برنامه، زبان و پوسته جزو تنظیمات برنامه‌اند؛ ایمیل‌های حساب شما به زبانی که برمی‌گزینید فرستاده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l'application, la langue et le thème sont des réglages de l'application ; les e-mails de votre compte sont envoyés dans la langue choisie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В приложении язык и тема задаются в его настройках; письма для аккаунта приходят на выбранном языке."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリでは言語とテーマはアプリの設定です。アカウント宛てのメールは選んだ言語で届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서는 언어와 테마가 앱 설정입니다. 계정 이메일은 선택한 언어로 발송됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用中，语言和主题属于应用设置；发往您账户的邮件使用您选择的语言。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa app, setting ng app ang wika at tema; ipinapadala ang mga email ng inyong account sa wikang pinili ninyo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในแอป ภาษาและธีมเป็นการตั้งค่าของแอป อีเมลของบัญชีจะส่งเป็นภาษาที่คุณเลือก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la aplicación, el idioma y el tema son ajustes de la aplicación; los correos de su cuenta se envían en el idioma que elija."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No app, idioma e tema são configurações do app; os e-mails da sua conta vão no idioma que você escolher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में भाषा और थीम ऐप की सेटिंग हैं; आपके खाते के ईमेल आपकी चुनी भाषा में जाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপে ভাষা ও থিম অ্যাপের সেটিং; আপনার অ্যাকাউন্টের ইমেইল আপনার বেছে নেওয়া ভাষায় যায়।"
          }
        }
      }
    },
