    "features.barNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat her zaman ilk, Tümü her zaman son sekmedir; aradaki en çok 3 yeri siz seçersiniz. Alt çubukta olmayan özellikler Tümü'nde durur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clock is always first and All always last; you choose up to 3 in between. Features not in the bar stay in All."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Uhr“ steht immer an erster, „Alle“ an letzter Stelle; dazwischen wählen Sie bis zu 3. Funktionen außerhalb der Leiste finden Sie unter „Alle“."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat həmişə birinci, Hamısı həmişə sonuncudur; aradakı ən çox 3 yeri siz seçirsiniz. Alt paneldə olmayan xüsusiyyətlər Hamısı bölməsindədir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة أولًا دائمًا و«الكل» أخيرًا دائمًا؛ وتختار أنت حتى 3 بينهما. الميزات غير الموجودة في الشريط تبقى في «الكل»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam selalu pertama dan Semua selalu terakhir; Anda memilih hingga 3 di antaranya. Fitur yang tidak ada di bilah tetap ada di Semua."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی ہمیشہ پہلی اور «سب» ہمیشہ آخری ہوتی ہے؛ درمیان کی زیادہ سے زیادہ 3 جگہیں آپ چنتے ہیں۔ جو خصوصیات پٹی میں نہیں وہ «سب» میں رہتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت همیشه اول و «همه» همیشه آخر است؛ حداکثر 3 مورد میان آن‌ها را شما انتخاب می‌کنید. ویژگی‌هایی که در نوار نیستند در «همه» می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'horloge est toujours en premier et Tout toujours en dernier ; vous choisissez jusqu'à 3 onglets entre les deux. Les fonctions hors de la barre restent dans Tout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы всегда первые, «Все» — всегда последние; между ними вы выбираете до 3 вкладок. Функции вне панели остаются во «Все»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計は常に最初、「すべて」は常に最後です。その間の最大3つを選べます。タブバーにない機能は「すべて」にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계는 항상 처음, 전체는 항상 마지막입니다. 그 사이 최대 3개를 직접 고릅니다. 탭 바에 없는 기능은 전체에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时钟始终在第一位，“全部”始终在最后；中间最多 3 个由您选择。不在底部栏的功能都在“全部”中。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Laging una ang Orasan at laging huli ang Lahat; kayo ang pipili ng hanggang 3 sa pagitan. Ang mga feature na wala sa bar ay nasa Lahat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาอยู่แรกเสมอและ «ทั้งหมด» อยู่ท้ายเสมอ คุณเลือกได้สูงสุด 3 แท็บระหว่างนั้น ฟีเจอร์ที่ไม่อยู่ในแถบจะอยู่ใน «ทั้งหมด»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reloj siempre es la primera pestaña y Todo, la última; usted elige hasta 3 en medio. Las funciones que no están en la barra quedan en Todo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relógio fica sempre em primeiro e Tudo sempre por último; você escolhe até 3 no meio. Os recursos fora da barra ficam em Tudo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी हमेशा पहले और सब हमेशा आख़िर में; बीच में आप 3 तक चुनते हैं। पट्टी में न होने वाली सुविधाएँ सब में रहती हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ি সবসময় প্রথমে এবং সব সবসময় শেষে; মাঝখানে আপনি সর্বোচ্চ 3টি বাছেন। বারে না থাকা বৈশিষ্ট্য সব-এ থাকে।"
          }
        }
      }
    },
