    "photoApp.polarDay": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş bu tarihte batmıyor (gece yarısı güneşi)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun does not set on this date (midnight sun)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne geht an diesem Tag nicht unter (Mitternachtssonne)."
          }
        },
