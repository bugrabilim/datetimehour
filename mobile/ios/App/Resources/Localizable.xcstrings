    "calendar.projected": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yılın dini günleri Diyanet'in uzun vadeli takvimine dayanır; kesinleşince güncellenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Religious days for this year are based on Diyanet's long-range calendar and will be updated once confirmed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die religiösen Tage dieses Jahres beruhen auf dem Langzeitkalender der Diyanet und werden nach Bestätigung aktualisiert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ilin dini günləri Diyanətin uzunmüddətli təqviminə əsaslanır; dəqiqləşəndə yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستند المناسبات الدينية لهذا العام إلى التقويم طويل المدى لرئاسة الشؤون الدينية، وستُحدَّث عند تأكيدها."
          }
        }
      }
    },
