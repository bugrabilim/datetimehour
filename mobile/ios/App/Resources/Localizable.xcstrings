    "onboard.welcome.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çünkü bu araçların herkese açık olması gerektiğine inanıyoruz. Reklam yok, üyelik gerekmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because we believe these tools should be open to everyone. No ads, no sign-up needed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil wir glauben, dass diese Werkzeuge allen offenstehen sollten. Keine Werbung, keine Anmeldung nötig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çünki bu alətlərin hamıya açıq olmalı olduğuna inanırıq. Reklam yoxdur, qeydiyyat tələb olunmur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأننا نؤمن بأن هذه الأدوات يجب أن تكون متاحة للجميع. بلا إعلانات، ولا حاجة إلى التسجيل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena kami percaya alat-alat ini harus terbuka bagi semua orang. Tanpa iklan, tanpa perlu mendaftar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیونکہ ہمارا ماننا ہے کہ یہ ٹولز سب کے لیے کھلے ہونے چاہئیں۔ کوئی اشتہار نہیں، رجسٹریشن کی ضرورت نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چون باور داریم این ابزارها باید در دسترس همه باشند. بدون تبلیغ، بدون نیاز به ثبت‌نام."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parce que nous pensons que ces outils doivent être ouverts à tous. Sans publicité, sans inscription."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потому что мы верим, что эти инструменты должны быть доступны каждому. Без рекламы и регистрации."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こうした道具は誰にでも開かれているべきだと考えているからです。広告なし、登録も不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이런 도구는 모두에게 열려 있어야 한다고 믿기 때문이에요. 광고도 없고, 가입도 필요 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为我们相信这些工具应该向所有人开放。没有广告，无需注册。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dahil naniniwala kami na dapat bukas sa lahat ang mga kasangkapang ito. Walang ads, hindi kailangang mag-sign up."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพราะเราเชื่อว่าเครื่องมือเหล่านี้ควรเปิดให้ทุกคนใช้ได้ ไม่มีโฆษณา ไม่ต้องสมัครสมาชิก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque creemos que estas herramientas deben estar abiertas a todos. Sin anuncios y sin registro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque acreditamos que essas ferramentas devem ser abertas a todos. Sem anúncios e sem cadastro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्योंकि हम मानते हैं कि ये टूल सबके लिए खुले होने चाहिए। कोई विज्ञापन नहीं, साइन-अप की ज़रूरत नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কারণ আমরা বিশ্বাস করি এই টুলগুলো সবার জন্য খোলা থাকা উচিত। কোনো বিজ্ঞাপন নেই, সাইন আপ লাগে না।"
          }
        }
      }
    },
    "onboard.features.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neleri kullanacaksınız?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What will you use?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was möchten Sie nutzen?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nələrdən istifadə edəcəksiniz?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا ستستخدم؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang akan Anda gunakan?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کیا استعمال کریں گے؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از چه چیزهایی استفاده می‌کنید؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'allez-vous utiliser ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем вы будете пользоваться?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を使いますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 사용하시겠어요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您会用到哪些功能？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano ang gagamitin mo?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะใช้อะไรบ้าง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué va a usar?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você vai usar?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप क्या इस्तेमाल करेंगे?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কী ব্যবহার করবেন?"
          }
        }
      }
    },
    "onboard.features.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtikleriniz alt çubukta görünür. Saat her zaman açıktır; sonra Ayarlar › Özellikler'den değiştirebilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you choose appears in the bottom bar. The clock is always on; you can change this later in Settings › Features."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Auswahl erscheint in der unteren Leiste. Die Uhr ist immer an; später ändern Sie das unter Einstellungen › Funktionen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçdikləriniz alt paneldə görünür. Saat həmişə açıqdır; sonra Parametrlər › Xüsusiyyətlər bölməsindən dəyişə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر ما تختاره في الشريط السفلي. الساعة مفعّلة دائمًا، ويمكنك التغيير لاحقًا من الإعدادات › الميزات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan Anda muncul di bilah bawah. Jam selalu aktif; nanti bisa diubah di Pengaturan › Fitur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا انتخاب نیچے کی بار میں نظر آتا ہے۔ گھڑی ہمیشہ چلتی ہے؛ بعد میں ترتیبات › خصوصیات سے بدل سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب‌های شما در نوار پایین دیده می‌شوند. ساعت همیشه روشن است؛ بعدًا می‌توانید از تنظیمات › ویژگی‌ها تغییرشان دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos choix apparaissent dans la barre du bas. L'horloge est toujours active ; vous pourrez changer cela dans Réglages › Fonctions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранное появится в нижней панели. Часы включены всегда; позже это можно изменить в разделе «Настройки › Функции»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだものは下のバーに表示されます。時計は常にオンです。あとで 設定 › 機能 から変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목은 아래쪽 막대에 표시됩니다. 시계는 항상 켜져 있으며, 나중에 설정 › 기능에서 바꿀 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您选择的功能会显示在底部栏。时钟始终开启；之后可在“设置 › 功能”中更改。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas sa bar sa ibaba ang mga pipiliin mo. Laging bukas ang orasan; mababago mo ito sa Mga Setting › Mga Feature."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่เลือกจะแสดงในแถบด้านล่าง นาฬิกาเปิดอยู่เสมอ เปลี่ยนภายหลังได้ที่ การตั้งค่า › ฟีเจอร์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que elija aparece en la barra inferior. El reloj siempre está activado; puede cambiarlo más tarde en Ajustes › Funciones."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você escolher aparece na barra inferior. O relógio fica sempre ativado; você pode mudar isso depois em Ajustes › Recursos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो चुनेंगे वह नीचे की पट्टी में दिखेगा। घड़ी हमेशा चालू रहती है; बाद में सेटिंग्स › सुविधाएँ में बदल सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বাছাই নিচের বারে দেখা যাবে। ঘড়ি সবসময় চালু থাকে; পরে সেটিংস › বৈশিষ্ট্যে এটি বদলাতে পারেন।"
          }
        }
      }
    },
