        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que su corazón esté ligero y su rostro sonriente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que o seu coração seja leve e o seu rosto sorridente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका दिल ख़ुश और चेहरा मुस्कुराता रहे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার হৃদয় হালকা ও মুখ হাসিখুশি থাকুক।"
          }
        }
      }
    },
    "greet.bless.4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayırlı kapılar size açılsın."
