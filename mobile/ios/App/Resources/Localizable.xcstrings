      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayete dokununca kaldığınız yer olarak işaretlenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a verse to bookmark it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf einen Vers, um ihn als Lesezeichen zu setzen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayəyə toxunanda qaldığınız yer kimi işarələnir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس آية لحفظ موضع القراءة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk sebuah ayat untuk menandainya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نشان لگانے کے لیے کسی آیت پر ٹیپ کریں۔"
