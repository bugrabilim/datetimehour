        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাদের ভালোবাসা সবসময় এমন সতেজ থাকুক।"
          }
        }
      }
    },
    "greet.m.graduation.1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emeğinizin karşılığını aldınız; tebrikler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your hard work has paid off; congratulations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Mühe hat sich gelohnt – herzlichen Glückwunsch."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməyinizin bəhrəsini gördünüz; təbriklər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثمر تعبك؛ مبارك."
