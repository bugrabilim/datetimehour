    "sky.graphCaption": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatay eksen saat, dikey eksen ufuktan yükseklik; koyu bölge tam karanlık."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal axis: time; vertical axis: height above the horizon; the dark band is full darkness."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Waagerecht die Uhrzeit, senkrecht die Höhe über dem Horizont; der dunkle Bereich ist volle Dunkelheit."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Üfüqi ox saat, şaquli ox üfüqdən hündürlük; tünd zolaq tam qaranlıqdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحور الأفقي هو الوقت، والعمودي هو الارتفاع فوق الأفق؛ المنطقة الداكنة هي الظلام التام."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumbu mendatar waktu, sumbu tegak ketinggian di atas cakrawala; pita gelap adalah gelap total."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "افقی محور وقت، عمودی محور افق سے بلندی؛ گہرا حصہ مکمل اندھیرا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "محور افقی زمان و محور عمودی ارتفاع از افق است؛ نوار تیره تاریکی کامل است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Axe horizontal : l'heure ; axe vertical : la hauteur au-dessus de l'horizon ; la bande sombre est la nuit noire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По горизонтали — время, по вертикали — высота над горизонтом; тёмная полоса — полная темнота."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横軸は時刻、縦軸は地平線からの高度。濃い帯は完全に暗い時間帯です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가로축은 시각, 세로축은 지평선 위 고도입니다. 어두운 띠는 완전한 어둠입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横轴为时间，纵轴为地平线以上高度；深色带为完全黑暗时段。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pahalang na aksis ang oras, patayo ang taas mula sa abot-tanaw; ang madilim na guhit ay ganap na dilim."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แกนนอนคือเวลา แกนตั้งคือความสูงเหนือขอบฟ้า แถบสีเข้มคือช่วงมืดสนิท"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eje horizontal: hora; eje vertical: altura sobre el horizonte; la franja oscura es la oscuridad total."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eixo horizontal: hora; eixo vertical: altura acima do horizonte; a faixa escura é a escuridão total."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्षैतिज अक्ष: समय; ऊर्ध्वाधर अक्ष: क्षितिज से ऊँचाई; गहरी पट्टी पूरा अँधेरा है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আনুভূমিক অক্ষ: সময়; উল্লম্ব অক্ষ: দিগন্তের ওপরে উচ্চতা; গাঢ় পট্টি পূর্ণ অন্ধকার।"
          }
        }
      }
    },
