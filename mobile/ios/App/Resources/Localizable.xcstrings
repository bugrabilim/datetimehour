    "alarm.denied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm izni kapalı. Ayarlar'dan bu uygulama için alarmlara izin verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms are not allowed. Allow alarms for this app in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker sind nicht erlaubt. Erlauben Sie sie für diese App in den Einstellungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmlara icazə yoxdur. Parametrlərdə bu tətbiq üçün icazə verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنبهات غير مسموح بها. اسمح بها لهذا التطبيق من الإعدادات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm tidak diizinkan. Izinkan alarm untuk aplikasi ini di Pengaturan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم کی اجازت نہیں۔ ترتیبات میں اس ایپ کے لیے الارم کی اجازت دیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هشدارها مجاز نیستند. در تنظیمات، هشدارهای این برنامه را مجاز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes ne sont pas autorisées. Autorisez-les pour cette application dans Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильники не разрешены. Разрешите их для этого приложения в Настройках."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームが許可されていません。設定でこのアプリのアラームを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람이 허용되지 않았습니다. 설정에서 이 앱의 알람을 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟未获允许。请在设置中允许此应用使用闹钟。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pinapayagan ang alarma. Payagan ang alarma para sa app na ito sa Settings."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้อนุญาตการปลุก โปรดอนุญาตการปลุกของแอปนี้ในการตั้งค่า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alarmas no están permitidas. Permita las alarmas de esta app en Ajustes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alarmes não estão permitidos. Permita os alarmes deste app em Ajustes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म की अनुमति नहीं है। सेटिंग्स में इस ऐप के अलार्म की अनुमति दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্মের অনুমতি নেই। সেটিংসে এই অ্যাপের অ্যালার্মের অনুমতি দিন।"
          }
        }
      }
    },
    "alarm.fallbackNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone'da alarm bildirim olarak gelir ve telefon sessizdeyken çalmaz. iOS 26 ve sonrasında gerçek alarm olarak çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this iPhone the alarm arrives as a notification and does not ring when the phone is silenced. On iOS 26 and later it rings as a real alarm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone kommt der Wecker als Mitteilung und klingelt nicht im Stummmodus. Ab iOS 26 klingelt er als echter Wecker."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone-da alarm bildiriş kimi gəlir və telefon səssizdə olanda çalmır. iOS 26 və sonrasında əsl alarm kimi çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على جهاز iPhone هذا يصل المنبه كإشعار ولا يرن عندما يكون الهاتف صامتًا. في iOS 26 وما بعده يرن كمنبه حقيقي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di iPhone ini alarm datang sebagai notifikasi dan tidak berbunyi saat ponsel senyap. Di iOS 26 dan yang lebih baru, alarm berbunyi sebagai alarm sungguhan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آئی فون پر الارم اطلاع کی صورت میں آتا ہے اور فون خاموش ہو تو نہیں بجتا۔ iOS 26 اور بعد میں یہ اصل الارم کی طرح بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در این آیفون هشدار به شکل اعلان می‌رسد و وقتی گوشی بی‌صداست زنگ نمی‌زند. در iOS 26 و بعد از آن مانند هشدار واقعی زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur cet iPhone, l’alarme arrive sous forme de notification et ne sonne pas en mode silencieux. Sous iOS 26 ou version ultérieure, elle sonne comme une vraie alarme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом iPhone будильник приходит уведомлением и не звучит в беззвучном режиме. В iOS 26 и новее он звонит как настоящий будильник."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneではアラームは通知として届き、マナーモードでは鳴りません。iOS 26以降では本物のアラームとして鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서는 알람이 알림으로 오며 무음 모드에서는 울리지 않습니다. iOS 26 이상에서는 실제 알람으로 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台iPhone上，闹钟以通知形式出现，手机静音时不会响。iOS 26及更高版本中会作为真正的闹钟响起。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa iPhone na ito, dumarating ang alarma bilang abiso at hindi tumutunog kapag naka-silent ang telepono. Sa iOS 26 at mas bago, tumutunog ito bilang tunay na alarma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน iPhone เครื่องนี้ นาฬิกาปลุกมาเป็นการแจ้งเตือนและไม่ดังเมื่อปิดเสียงโทรศัพท์ บน iOS 26 ขึ้นไปจะดังเป็นนาฬิกาปลุกจริง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este iPhone la alarma llega como notificación y no suena con el teléfono en silencio. En iOS 26 y posteriores suena como una alarma de verdad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste iPhone o alarme chega como notificação e não toca com o celular no silencioso. No iOS 26 e posterior ele toca como um alarme de verdade."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone पर अलार्म सूचना के रूप में आता है और फ़ोन साइलेंट होने पर नहीं बजता। iOS 26 और बाद के संस्करणों में यह असली अलार्म की तरह बजता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই iPhone-এ অ্যালার্ম নোটিফিকেশন হিসেবে আসে এবং ফোন নীরব থাকলে বাজে না। iOS 26 ও তার পরের সংস্করণে এটি আসল অ্যালার্মের মতো বাজে।"
          }
        }
      }
    },
    "alarm.realNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm, telefon sessizdeyken ve uygulama kapalıyken de çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm rings even when the phone is silenced and the app is closed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wecker klingelt auch im Stummmodus und bei geschlossener App."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm telefon səssizdə və tətbiq bağlı olanda da çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرن المنبه حتى عندما يكون الهاتف صامتًا والتطبيق مغلقًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm berbunyi meski ponsel senyap dan aplikasi ditutup."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم فون خاموش ہو اور ایپ بند ہو تب بھی بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هشدار حتی وقتی گوشی بی‌صدا و برنامه بسته است زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alarme sonne même en mode silencieux et lorsque l’app est fermée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильник звонит даже в беззвучном режиме и при закрытом приложении."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームはマナーモードでもアプリを閉じていても鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람은 무음 모드이거나 앱이 닫혀 있어도 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使手机静音、应用关闭，闹钟也会响。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumutunog ang alarma kahit naka-silent ang telepono at sarado ang app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาปลุกดังแม้ปิดเสียงโทรศัพท์และปิดแอป"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La alarma suena aunque el teléfono esté en silencio y la app cerrada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O alarme toca mesmo com o celular no silencioso e o app fechado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन साइलेंट होने और ऐप बंद होने पर भी अलार्म बजता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোন নীরব থাকলে ও অ্যাপ বন্ধ থাকলেও অ্যালার্ম বাজে।"
          }
        }
      }
    },
