    "breath.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nefesinizi zorlamayın; başınız dönerse normal nefese dönün. Bu bir tıbbi tavsiye değildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t force your breath; if you feel dizzy, go back to normal breathing. This is not medical advice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atem nicht erzwingen; bei Schwindel normal weiteratmen. Dies ist kein medizinischer Rat."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nəfəsinizi zorlamayın; başınız gicəllənərsə normal nəfəsə qayıdın. Bu tibbi məsləhət deyil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُجهد تنفسك؛ إن شعرت بدوار فعُد إلى التنفس العادي. هذه ليست نصيحة طبية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan memaksa napas; jika pusing, kembali bernapas normal. Ini bukan saran medis."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سانس پر زور نہ دیں؛ چکر آئے تو عام سانس پر واپس آئیں۔ یہ طبی مشورہ نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به تنفس فشار نیاورید؛ اگر سرگیجه گرفتید به تنفس عادی برگردید. این توصیه پزشکی نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne forcez pas ; en cas de vertige, revenez à une respiration normale. Ceci n’est pas un avis médical."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не напрягайтесь; при головокружении вернитесь к обычному дыханию. Это не медицинский совет."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無理に息をしないでください。めまいがしたら普段の呼吸に戻りましょう。医療上の助言ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "억지로 숨 쉬지 마세요. 어지러우면 평소 호흡으로 돌아가세요. 의학적 조언이 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要勉强呼吸；如感到头晕，请恢复正常呼吸。本内容不构成医疗建议。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Huwag pilitin ang paghinga; kung nahihilo, bumalik sa normal na paghinga. Hindi ito payong medikal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่าฝืนหายใจ หากเวียนศีรษะให้กลับมาหายใจตามปกติ นี่ไม่ใช่คำแนะนำทางการแพทย์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No fuerce la respiración; si se marea, vuelva a respirar con normalidad. No es un consejo médico."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não force a respiração; se ficar tonto, volte a respirar normalmente. Não é orientação médica."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साँस पर ज़ोर न डालें; चक्कर आए तो सामान्य साँस पर लौटें। यह चिकित्सा सलाह नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শ্বাসে জোর দেবেন না; মাথা ঘুরলে স্বাভাবিক শ্বাসে ফিরে যান। এটি চিকিৎসা পরামর্শ নয়।"
          }
        }
      }
    },
    "flip.toggle": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu ters çevirince başla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start when the phone is face down"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten, wenn das Telefon umgedreht liegt"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon üzüüstə çevriləndə başla"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ عند قلب الهاتف على وجهه"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai saat ponsel ditelungkupkan"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون الٹا رکھنے پر شروع کریں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با برگرداندن گوشی روی صفحه شروع کن"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer quand le téléphone est retourné"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать, когда телефон экраном вниз"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を伏せたら開始"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화를 뒤집으면 시작"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机扣放时开始"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsimula kapag nakataob ang telepono"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มเมื่อคว่ำโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar al poner el teléfono boca abajo"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar com o celular virado para baixo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन उल्टा रखने पर शुरू करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোন উপুড় করলে শুরু করুন"
          }
        }
      }
    },
    "flip.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma süresinde telefonu ekranı aşağı bakacak şekilde koyun; kaldırırsanız sayaç durur. Uygulama açık kalmalı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During a work session, lay the phone face down; if you pick it up, the timer pauses. Keep the app open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Arbeit das Telefon mit dem Display nach unten legen; beim Hochnehmen pausiert der Timer. App geöffnet lassen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İş vaxtı telefonu ekranı aşağı qoyun; qaldırsanız sayğac dayanır. Tətbiq açıq qalmalıdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء العمل ضع الهاتف على وجهه؛ إن رفعته يتوقف المؤقت. أبقِ التطبيق مفتوحًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat bekerja, telungkupkan ponsel; jika diangkat, timer berhenti. Biarkan aplikasi tetap terbuka."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام کے دوران فون اسکرین نیچے رکھیں؛ اٹھائیں تو ٹائمر رک جائے گا۔ ایپ کھلی رکھیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام کار گوشی را رو به پایین بگذارید؛ اگر برداریدش زمان‌سنج متوقف می‌شود. برنامه باید باز بماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le travail, posez le téléphone écran vers le bas ; si vous le soulevez, le minuteur s’arrête. Gardez l’app ouverte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время работы положите телефон экраном вниз; если поднять его, таймер встанет на паузу. Приложение должно быть открыто."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業中は画面を下にして置いてください。持ち上げるとタイマーが止まります。アプリは開いたままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중에는 화면이 아래로 향하게 두세요. 들어 올리면 타이머가 멈춥니다. 앱은 열어 두어야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作时将手机屏幕朝下放置；拿起后计时暂停。需保持应用打开。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang nagtatrabaho, itaob ang telepono; kapag dinampot, hihinto ang timer. Panatilihing bukas ang app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างทำงานให้คว่ำโทรศัพท์ หากหยิบขึ้นมาตัวจับเวลาจะหยุด ต้องเปิดแอปค้างไว้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante el trabajo, ponga el teléfono boca abajo; si lo levanta, el temporizador se pausa. Mantenga la app abierta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante o trabalho, deixe o celular virado para baixo; se você pegá-lo, o temporizador pausa. Mantenha o app aberto."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काम के दौरान फ़ोन उल्टा रखें; उठाने पर टाइमर रुक जाता है। ऐप खुला रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাজের সেশনে ফোনটি উপুড় করে রাখুন; তুলে নিলে টাইমার থেমে যায়। অ্যাপ খোলা রাখুন।"
          }
        }
      }
    },
    "flip.paused": {
