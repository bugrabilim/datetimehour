    "tools.alarm.wakeNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kapanırsa tarayıcı sekmeyi uyutabilir; bu seçenek alarm kuruluyken ekranın kapanmasını engeller."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the screen turns off the browser may put the tab to sleep; this option stops the screen from turning off while an alarm is set."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich der Bildschirm ausschaltet, kann der Browser den Tab in den Ruhezustand versetzen; diese Option verhindert, dass sich der Bildschirm ausschaltet, solange ein Wecker gestellt ist."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran sönərsə, brauzer tabı yuxu rejiminə keçirə bilər; bu seçim zəngli saat qurulu olduğu müddətdə ekranın sönməsinin qarşısını alır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا انطفأت الشاشة فقد يُعلّق المتصفح التبويب؛ ويمنع هذا الخيار انطفاء الشاشة ما دام هناك منبّه مضبوط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika layar mati, peramban dapat menidurkan tab; opsi ini mencegah layar mati selama alarm terpasang."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین بند ہونے پر براؤزر ٹیب کو سلا سکتا ہے؛ یہ اختیار الارم لگے رہنے تک اسکرین بند نہیں ہونے دیتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر صفحه خاموش شود، مرورگر ممکن است زبانه را به خواب ببرد؛ این گزینه تا وقتی زنگی تنظیم است نمی‌گذارد صفحه خاموش شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’écran s’éteint, le navigateur peut mettre l’onglet en veille ; cette option empêche l’écran de s’éteindre tant qu’une alarme est réglée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если экран погаснет, браузер может усыпить вкладку; эта настройка не даёт экрану гаснуть, пока установлен будильник."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面が消えるとブラウザがタブを休止させることがあります。このオプションは、アラームが設定されている間、画面が消えないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 꺼지면 브라우저가 탭을 잠재울 수 있습니다. 이 옵션은 알람이 설정된 동안 화면이 꺼지지 않게 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕熄灭时浏览器可能会让标签页休眠；此选项在设有闹钟时阻止屏幕熄灭。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag namatay ang screen, puwedeng patulugin ng browser ang tab; pinipigilan ng opsyong ito na mamatay ang screen habang may nakatakdang alarma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากหน้าจอดับ เบราว์เซอร์อาจพักแท็บ ตัวเลือกนี้ป้องกันไม่ให้หน้าจอดับขณะตั้งปลุกไว้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la pantalla se apaga, el navegador puede dormir la pestaña; esta opción impide que la pantalla se apague mientras haya una alarma puesta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a tela apagar, o navegador pode suspender a aba; esta opção impede que a tela apague enquanto houver um alarme ativo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन बंद होने पर ब्राउज़र टैब को सुला सकता है; यह विकल्प अलार्म लगे रहने तक स्क्रीन बंद नहीं होने देता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পর্দা বন্ধ হলে ব্রাউজার ট্যাবকে ঘুম পাড়াতে পারে; এই বিকল্পটি অ্যালার্ম দেওয়া থাকা অবস্থায় পর্দা বন্ধ হতে দেয় না।"
          }
        }
      }
    },
    "tools.alarm.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önemli uyanışlar için telefonun kendi alarmını da kurun; tarayıcı alarmı sayfa kapanırsa çalmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For important wake-ups also set your phone's own alarm; a browser alarm will not ring if the page is closed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie für wichtige Weckzeiten zusätzlich den Wecker Ihres Telefons; ein Browser-Wecker klingelt nicht, wenn die Seite geschlossen ist."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacib oyanışlar üçün telefonunuzun öz zəngli saatını da qurun; səhifə bağlı olarsa, brauzerdəki zəngli saat çalmayacaq."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للاستيقاظ في المواعيد المهمة اضبط أيضًا منبّه هاتفك؛ فمنبّه المتصفح لا يرنّ إذا كانت الصفحة مغلقة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda harus bangun untuk hal penting, pasang juga alarm bawaan ponsel Anda; alarm peramban tidak berbunyi jika halaman ditutup."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اہم وقت پر جاگنے کے لیے فون کا اپنا الارم بھی لگائیں؛ صفحہ بند ہو تو براؤزر کا الارم نہیں بجتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای بیدار شدن‌های مهم زنگ خود گوشی را هم تنظیم کنید؛ زنگ مرورگر اگر صفحه بسته باشد به صدا درنمی‌آید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un réveil important, réglez aussi l’alarme de votre téléphone ; une alarme de navigateur ne sonne pas si la page est fermée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для важного подъёма поставьте также будильник на телефоне; будильник в браузере не зазвонит, если страница закрыта."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大事な起床には端末自体のアラームも設定してください。ブラウザのアラームはページを閉じると鳴りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꼭 일어나야 할 때는 휴대전화 자체 알람도 함께 설정하세요. 브라우저 알람은 페이지를 닫으면 울리지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果起床很重要，请同时设置手机自带的闹钟；页面关闭时浏览器闹钟不会响。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa mahalagang paggising, itakda rin ang sariling alarma ng iyong telepono; hindi tutunog ang alarma ng browser kapag sarado ang pahina."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับการตื่นที่สำคัญ ให้ตั้งนาฬิกาปลุกของโทรศัพท์ด้วย นาฬิกาปลุกในเบราว์เซอร์จะไม่ดังเมื่อปิดหน้า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para despertares importantes, ponga también la alarma de su teléfono; una alarma del navegador no suena si la página está cerrada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para despertares importantes, ative também o alarme do seu celular; um alarme do navegador não toca se a página estiver fechada."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब जागना ज़रूरी हो, तो अपने फ़ोन का अलार्म भी लगाएँ; पेज बंद होने पर ब्राउज़र अलार्म नहीं बजेगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গুরুত্বপূর্ণ সময়ে জাগতে আপনার ফোনের নিজস্ব অ্যালার্মও দিন; পাতা বন্ধ থাকলে ব্রাউজারের অ্যালার্ম বাজবে না।"
          }
        }
      }
    },
