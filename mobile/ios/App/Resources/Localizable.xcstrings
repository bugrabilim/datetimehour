            "value": "Volvimos a enviar el correo de verificación."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviamos o e-mail de verificação novamente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने पुष्टि ईमेल फिर से भेज दिया है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা যাচাইয়ের ইমেইল আবার পাঠিয়েছি।"
          }
        }
      }
    },
    "account.forgotLead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınızın e-posta adresini yazın; şifre sıfırlama bağlantısı gönderelim."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your account's email address and we'll send a password reset link."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie die E-Mail-Adresse Ihres Kontos ein; wir schicken Ihnen einen Link zum Zurücksetzen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınızın e-poçt ünvanını yazın; şifrə sıfırlama keçidi göndərək."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب عنوان البريد الإلكتروني لحسابك وسنرسل إليك رابطًا لإعادة تعيين كلمة المرور."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis alamat email akun Anda; kami akan mengirim tautan untuk mengatur ulang kata sandi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے اکاؤنٹ کا ای میل پتا لکھیں؛ ہم پاس ورڈ ری سیٹ کرنے کا لنک بھیجیں گے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشانی ایمیل حساب خود را بنویسید تا پیوند بازنشانی رمز عبور را برایتان بفرستیم."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l’adresse e-mail de votre compte ; nous vous enverrons un lien de réinitialisation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите адрес эл. почты вашего аккаунта, и мы пришлём ссылку для сброса пароля."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのメールアドレスを入力してください。パスワード再設定用のリンクをお送りします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정의 이메일 주소를 입력하면 비밀번호 재설정 링크를 보내 드립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入账户的电子邮箱地址，我们会发送重置密码的链接。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang email address ng inyong account; magpapadala kami ng link para i-reset ang password."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่อีเมลของบัญชี แล้วเราจะส่งลิงก์สำหรับตั้งรหัสผ่านใหม่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba el correo electrónico de su cuenta y le enviaremos un enlace para restablecer la contraseña."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o e-mail da sua conta e enviaremos um link para redefinir a senha."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने खाते का ईमेल पता लिखें; हम पासवर्ड रीसेट करने का लिंक भेजेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাকাউন্টের ইমেইল ঠিকানা লিখুন; আমরা পাসওয়ার্ড রিসেটের লিংক পাঠাব।"
          }
        }
      }
    },
