    "pomo.noiseNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses yalnız çalışma süresi işlerken çalar, ekran kilitliyken de sürer; telefonda üretilir, dosya indirilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays only while a work session is running, also with the screen locked; generated on your phone, nothing is downloaded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft nur während einer Arbeitsphase, auch bei gesperrtem Bildschirm; wird auf dem Telefon erzeugt, nichts wird heruntergeladen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səs yalnız iş müddəti gedərkən çalınır, ekran kilidli olanda da davam edir; telefonda yaradılır, fayl endirilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل الصوت فقط أثناء فترة العمل، حتى عندما تكون الشاشة مقفلة؛ يُولَّد على هاتفك ولا يُنزَّل أي ملف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya diputar saat sesi kerja berjalan, juga saat layar terkunci; dibuat di ponsel Anda, tidak ada yang diunduh."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف کام کے دور کے دوران بجتا ہے، لاک اسکرین پر بھی؛ آپ کے فون پر بنتا ہے، کچھ ڈاؤن لوڈ نہیں ہوتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط هنگام نوبت کار پخش می‌شود، با صفحهٔ قفل هم؛ روی گوشی شما ساخته می‌شود و چیزی دانلود نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne joue que pendant une séance de travail, même écran verrouillé ; généré sur votre téléphone, rien n’est téléchargé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звучит только во время рабочего отрезка, в том числе на заблокированном экране; создаётся на телефоне, ничего не загружается."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業時間中だけ再生され、画面がロック中でも鳴ります。スマホ上で生成するので何もダウンロードしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 시간 동안에만 재생되며 화면이 잠겨 있어도 나옵니다. 휴대폰에서 만들어지므로 내려받는 것이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在工作时段运行时播放，锁屏时也会播放；在手机上生成，不下载任何内容。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumutugtog lang habang tumatakbo ang work session, kahit naka-lock ang screen; ginagawa sa iyong telepono, walang dina-download."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นเฉพาะขณะช่วงทำงานกำลังดำเนินอยู่ แม้หน้าจอล็อก สร้างบนโทรศัพท์ ไม่มีการดาวน์โหลด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo suena mientras hay una sesión de trabajo en marcha, también con la pantalla bloqueada; se genera en el teléfono y no se descarga nada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só toca enquanto uma sessão de trabalho está em andamento, também com a tela bloqueada; é gerado no celular e nada é baixado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल काम का सत्र चलते समय बजती है, स्क्रीन लॉक होने पर भी; यह फ़ोन पर बनती है, कुछ डाउनलोड नहीं होता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু কাজের সেশন চলার সময় বাজে, পর্দা লক থাকলেও; আপনার ফোনেই তৈরি হয়, কিছু নামানো হয় না।"
          }
        }
      }
    },
