          "stringUnit": {
            "state": "translated",
            "value": "Telefonu yatay tutun: çizim yönlere göre döner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the phone flat: the drawing turns with the directions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie das Telefon flach: Die Zeichnung richtet sich nach den Himmelsrichtungen aus."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu üfüqi tutun: təsvir istiqamətlərə görə fırlanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أمسك الهاتف أفقيًا: يدور الرسم مع الاتجاهات."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang ponsel mendatar: gambar berputar mengikuti arah."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون کو سیدھا رکھیں: نقشہ سمتوں کے ساتھ گھومتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی را افقی نگه دارید: طرح با جهت‌ها می‌چرخد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez le téléphone à plat : le dessin tourne avec les directions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите телефон горизонтально: рисунок поворачивается по сторонам света."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを水平に持つと、図が方位に合わせて回ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 평평하게 들면 그림이 방향에 맞게 돕니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手机放平：图会随方向转动。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hawakan nang pahiga ang telepono: iikot ang larawan ayon sa direksyon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถือโทรศัพท์ในแนวราบ ภาพจะหมุนตามทิศ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostenga el teléfono plano, boca arriba: el dibujo gira con las direcciones."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o celular na horizontal: o desenho gira com as direções."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन को सीधा लिटाएँ: चित्र दिशाओं के साथ घूमता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোনটি সমতলে ধরুন: ছবিটি দিকের সঙ্গে ঘোরে।"
          }
        }
      }
    },
    "kidsmoon.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay neden şekil değiştirir?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why does the Moon change shape?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum ändert der Mond seine Form?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay niyə forma dəyişir?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا يتغير شكل القمر؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengapa Bulan berubah bentuk?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چاند کی شکل کیوں بدلتی ہے؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چرا ماه شکلش را عوض می‌کند؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi la Lune change-t-elle de forme ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему Луна меняет форму?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月はなぜ形が変わるの？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달은 왜 모양이 바뀔까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月亮为什么会变形状？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakit nagbabago ang hugis ng Buwan?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำไมดวงจันทร์เปลี่ยนรูปร่าง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué cambia de forma la Luna?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que a Lua muda de forma?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चंद्रमा का आकार क्यों बदलता है?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চাঁদের আকার কেন বদলায়?"
          }
        }
      }
    },
    "kidsmoon.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay kendisi ışık saçmaz; Güneş'in ışığını yansıtır. Ay, Dünya'nın çevresinde yaklaşık 29,5 günde bir tur atar. Döndükçe Güneş'in aydınlattığı yarısının ne kadarını gördüğümüz değişir. Kaydırıcıyla Ay'ı yörüngede gezdirip deneyin!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Moon does not shine by itself; it reflects sunlight. It goes around the Earth about every 29.5 days. As it moves, we see more or less of its sunlit half. Move the slider to send the Moon around its orbit!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond leuchtet nicht selbst, er spiegelt das Sonnenlicht. Er umkreist die Erde in etwa 29,5 Tagen. Dabei sehen wir mal mehr, mal weniger von seiner beleuchteten Hälfte. Bewegen Sie den Mond mit dem Schieberegler auf seiner Bahn und probieren Sie es aus!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay özü işıq saçmır; Günəşin işığını əks etdirir. Ay Yerin ətrafında təxminən 29,5 günə bir dövrə vurur. Fırlandıqca Günəşin işıqlandırdığı yarısının nə qədərini gördüyümüz dəyişir. Sürgü ilə Ayı orbitdə gəzdirib sınayın!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القمر لا يضيء بنفسه، بل يعكس ضوء الشمس. يدور حول الأرض كل 29.5 يومًا تقريبًا. وكلما تحرك نرى جزءًا أكبر أو أصغر من نصفه المضاء. حرّك المنزلق لتدير القمر حول مداره!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulan tidak bersinar sendiri; ia memantulkan cahaya Matahari. Bulan mengitari Bumi sekitar 29,5 hari sekali. Saat bergerak, seberapa banyak sisi terangnya yang kita lihat ikut berubah. Geser penggeser untuk menggerakkan Bulan di orbitnya!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چاند خود روشنی نہیں دیتا؛ سورج کی روشنی منعکس کرتا ہے۔ یہ تقریباً 29.5 دن میں زمین کا ایک چکر لگاتا ہے۔ گھومتے ہوئے ہمیں اس کا روشن حصہ کم یا زیادہ دکھائی دیتا ہے۔ سلائیڈر سے چاند کو مدار میں گھمائیں!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ماه خودش نور ندارد؛ نور خورشید را بازمی‌تاباند. ماه تقریباً هر 29.5 روز یک بار دور زمین می‌چرخد. با چرخیدنش، بخش کمتر یا بیشتری از نیمهٔ روشنش را می‌بینیم. با لغزنده ماه را در مدار بچرخانید!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lune ne brille pas toute seule : elle renvoie la lumière du Soleil. Elle fait le tour de la Terre en 29,5 jours environ. En tournant, on voit plus ou moins sa moitié éclairée. Faites glisser le curseur pour la faire tourner !"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Луна сама не светит: она отражает свет Солнца. Она обходит Землю примерно за 29,5 дня. По пути мы видим то больше, то меньше её освещённой половины. Подвигайте ползунок и проверьте!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月は自分では光らず、太陽の光をはね返しています。月は約29.5日で地球のまわりを1周します。動くにつれて、明るい半分の見え方が変わります。スライダーで月を動かしてみよう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달은 스스로 빛나지 않고 햇빛을 반사합니다. 달은 약 29.5일에 한 번 지구를 돕니다. 도는 동안 밝은 쪽이 보이는 정도가 달라집니다. 슬라이더로 달을 움직여 보세요!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月亮自己不发光，它反射太阳的光。月亮大约29.5天绕地球一圈。它转动时，我们看到被照亮的那一半多少不同。拖动滑块让月亮转起来吧！"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kusang nagliliwanag ang Buwan; sinasalamin nito ang liwanag ng Araw. Umiikot ito sa Daigdig tuwing mga 29.5 araw. Habang umiikot, nag-iiba kung gaano kalaki ang nakikita nating maliwanag na bahagi. Igalaw ang slider para paikutin ang Buwan!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดวงจันทร์ไม่ได้ส่องแสงเอง แต่สะท้อนแสงดวงอาทิตย์ ดวงจันทร์โคจรรอบโลกราว 29.5 วันต่อรอบ ขณะเคลื่อนที่เราจะเห็นด้านสว่างมากหรือน้อยต่างกัน ลองเลื่อนแถบเพื่อพาดวงจันทร์โคจรดูสิ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Luna no brilla por sí misma; refleja la luz del Sol. Da una vuelta a la Tierra aproximadamente cada 29,5 días. Al moverse, vemos más o menos de su mitad iluminada. ¡Mueva el control para hacer girar la Luna en su órbita!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Lua não brilha sozinha; ela reflete a luz do Sol. Ela dá uma volta ao redor da Terra a cada 29,5 dias, aproximadamente. Conforme se move, vemos uma parte maior ou menor da sua metade iluminada. Mova o controle para fazer a Lua girar na órbita!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चंद्रमा ख़ुद नहीं चमकता; वह सूरज की रोशनी को परावर्तित करता है। वह लगभग हर 29.5 दिन में पृथ्वी का चक्कर लगाता है। चलते हुए हमें उसका रोशन आधा भाग कम या ज़्यादा दिखता है। स्लाइडर हिलाकर चंद्रमा को उसकी कक्षा में घुमाकर देखें!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চাঁদ নিজে আলো দেয় না; এটি সূর্যের আলো প্রতিফলিত করে। এটি প্রায় প্রতি 29.5 দিনে পৃথিবীর চারপাশে ঘোরে। ঘোরার সময় আমরা এর আলোকিত অর্ধেকের কম বা বেশি দেখি। স্লাইডার সরিয়ে চাঁদকে কক্ষপথে ঘোরান!"
          }
        }
      }
    },
