          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto, Profil (mit Foto), Einwilligungsnachweis, Sitzungen, Einträge und Abzeichen als JSON-Datei."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız, profiliniz (foto daxil), razılıq qeydiniz, sessiyalarınız, qeydləriniz və nişanlarınız JSON faylı kimi."
          }
        },
        "ar": {
