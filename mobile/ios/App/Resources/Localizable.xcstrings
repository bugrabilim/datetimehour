          "stringUnit": {
            "state": "translated",
            "value": "Que a luz desta noite ilumine o seu lar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रात का नूर आपके घर को रोशन करे।"
