    "kids.facts.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biliyor muydunuz?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you know?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wussten Sie schon?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilirdinizmi?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تعلم؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahukah Anda?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ جانتے ہیں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌دانستی؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le saviez-vous ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "А знаете ли вы?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知ってた？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알고 있었나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你知道吗？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Alam mo ba?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รู้หรือไม่?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sabía que…?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você sabia?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप जानते हैं?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি জানেন?"
          }
        }
      }
    },
    "kids.fact1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "21 Haziran yılın en uzun günü, 21 Aralık en uzun gecesidir (kuzey yarımkürede)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "June 21 is the longest day of the year and December 21 the longest night (in the northern half)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der 21. Juni ist der längste Tag des Jahres, der 21. Dezember die längste Nacht (auf der Nordhalbkugel)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "21 iyun ilin ən uzun günü, 21 dekabr isə ən uzun gecəsidir (şimal yarımkürəsində)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "21 يونيو أطول يوم في السنة و21 ديسمبر أطول ليلة (في النصف الشمالي)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal 21 Juni adalah siang terpanjang dalam setahun dan 21 Desember malam terpanjang (di belahan utara)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "21 جون سال کا سب سے لمبا دن اور 21 دسمبر سب سے لمبی رات ہے (شمالی حصے میں)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "21 ژوئن بلندترین روز سال و 21 دسامبر بلندترین شب است (در نیمهٔ شمالی)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 21 juin est le jour le plus long de l’année et le 21 décembre la nuit la plus longue (dans la moitié nord)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "21 июня — самый длинный день в году, а 21 декабря — самая длинная ночь (в северной половине)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "6月21日ごろは1年でいちばん昼が長く、12月21日ごろはいちばん夜が長い日です（北半球）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "6월 21일은 1년 중 낮이 가장 길고, 12월 21일은 밤이 가장 긴 날이에요(북반구)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "6月21日是一年中白天最长的一天，12月21日是夜晚最长的一天（北半球）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Hunyo 21 ang pinakamahabang araw ng taon at ang Disyembre 21 ang pinakamahabang gabi (sa hilagang bahagi)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "21 มิถุนายนเป็นวันที่กลางวันยาวที่สุดของปี และ 21 ธันวาคมเป็นวันที่กลางคืนยาวที่สุด (ซีกโลกเหนือ)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 21 de junio es el día más largo del año y el 21 de diciembre la noche más larga (en el hemisferio norte)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "21 de junho é o dia mais longo do ano e 21 de dezembro a noite mais longa (na metade norte)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "21 जून साल का सबसे लंबा दिन और 21 दिसंबर सबसे लंबी रात है (उत्तरी गोलार्ध में)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "21 জুন বছরের দীর্ঘতম দিন এবং 21 ডিসেম্বর দীর্ঘতম রাত (উত্তর অর্ধেকে)।"
          }
        }
      }
    },
    "kids.fact2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mart ve Eylül'deki ekinoks günlerinde gece ile gündüz hemen hemen eşittir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the equinoxes in March and September, day and night are almost equal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An den Tagundnachtgleichen im März und September sind Tag und Nacht fast gleich lang."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mart və sentyabrdakı gecə-gündüz bərabərliyi günlərində gecə ilə gündüz təxminən eyni uzunluqda olur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في يومي الاعتدال في مارس وسبتمبر يتساوى الليل والنهار تقريبًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada ekuinoks bulan Maret dan September, siang dan malam hampir sama panjang."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مارچ اور ستمبر کے اعتدالین پر دن اور رات تقریباً برابر ہوتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در اعتدال‌های مارس و سپتامبر، روز و شب تقریباً برابرند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aux équinoxes de mars et de septembre, le jour et la nuit ont presque la même durée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В дни равноденствия в марте и сентябре день и ночь почти равны."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3月と9月の春分・秋分には、昼と夜の長さがほぼ同じになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3월과 9월의 춘분과 추분에는 낮과 밤의 길이가 거의 같아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在3月和9月的春分、秋分，白天和黑夜几乎一样长。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa mga equinox sa Marso at Setyembre, halos magkasinghaba ang araw at gabi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในวันวิษุวัตเดือนมีนาคมและกันยายน กลางวันและกลางคืนยาวเกือบเท่ากัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los equinoccios de marzo y septiembre, el día y la noche duran casi lo mismo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos equinócios de março e setembro, o dia e a noite têm quase a mesma duração."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मार्च और सितंबर के विषुव पर दिन और रात लगभग बराबर होते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মার্চ ও সেপ্টেম্বরের বিষুবে দিন ও রাত প্রায় সমান।"
          }
        }
      }
    },
    "kids.fact3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuzey Kutbu'nda yazın aylarca Güneş batmaz, kışın da aylarca hiç doğmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the North Pole the Sun doesn't set for months in summer, and doesn't rise for months in winter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Nordpol geht die Sonne im Sommer monatelang nicht unter und im Winter monatelang nicht auf."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimal qütbündə yayda aylarla Günəş batmır, qışda isə aylarla heç doğmur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في القطب الشمالي لا تغرب الشمس لأشهر في الصيف، ولا تشرق لأشهر في الشتاء."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Kutub Utara, Matahari tidak terbenam selama berbulan-bulan saat musim panas, dan tidak terbit berbulan-bulan saat musim dingin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قطبِ شمالی پر گرمیوں میں سورج مہینوں غروب نہیں ہوتا اور سردیوں میں مہینوں طلوع نہیں ہوتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در قطب شمال، خورشید در تابستان ماه‌ها غروب نمی‌کند و در زمستان ماه‌ها طلوع نمی‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au pôle Nord, le Soleil ne se couche pas pendant des mois en été et ne se lève pas pendant des mois en hiver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Северном полюсе летом Солнце месяцами не заходит, а зимой месяцами не восходит."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "北極では夏に何か月も太陽が沈まず、冬には何か月も昇りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "북극에서는 여름에 몇 달 동안 해가 지지 않고, 겨울에는 몇 달 동안 해가 뜨지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在北极，夏天太阳几个月都不落下，冬天几个月都不升起。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa North Pole, hindi lumulubog ang Araw nang ilang buwan sa tag-araw, at hindi sumisikat nang ilang buwan sa taglamig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่ขั้วโลกเหนือ ฤดูร้อนดวงอาทิตย์ไม่ตกเป็นเดือน ๆ และฤดูหนาวไม่ขึ้นเป็นเดือน ๆ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el Polo Norte el Sol no se pone durante meses en verano, y no sale durante meses en invierno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No Polo Norte o Sol não se põe por meses no verão, e não nasce por meses no inverno."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्तरी ध्रुव पर गर्मियों में महीनों तक सूरज नहीं डूबता और सर्दियों में महीनों तक नहीं उगता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তর মেরুতে গ্রীষ্মে সূর্য মাসের পর মাস অস্ত যায় না, আর শীতে মাসের পর মাস ওঠে না।"
          }
        }
      }
    },
    "kids.fact4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekvatora yakın ülkelerde yaz ile kış arasında fark azdır; orada yağmurlu ve kurak mevsimler vardır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Near the equator summer and winter feel almost the same; instead there are rainy and dry seasons."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Nähe des Äquators fühlen sich Sommer und Winter fast gleich an; stattdessen gibt es dort Regen- und Trockenzeiten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekvatora yaxın ölkələrdə yay ilə qış arasında fərq azdır; orada yağışlı və quraq fəsillər olur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرب خط الاستواء يكاد الصيف والشتاء يتشابهان؛ وبدلًا منهما هناك موسم مطير وموسم جاف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di dekat khatulistiwa, seperti di Indonesia, musim panas dan dingin terasa hampir sama; yang ada justru musim hujan dan musim kemarau."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خطِ استوا کے قریب گرمی اور سردی تقریباً ایک جیسی ہوتی ہیں؛ اس کے بجائے برسات اور خشک موسم ہوتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نزدیک استوا تابستان و زمستان تقریباً یکسان‌اند؛ به جایش فصل بارانی و فصل خشک هست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Près de l’équateur, l’été et l’hiver se ressemblent beaucoup ; il y a plutôt une saison des pluies et une saison sèche."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возле экватора лето и зима почти не отличаются; там вместо них сезон дождей и сухой сезон."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤道の近くでは夏と冬の違いがほとんどなく、代わりに雨季と乾季があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적도 가까이에서는 여름과 겨울이 거의 비슷하고, 대신 우기와 건기가 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在赤道附近，夏天和冬天感觉差不多；那里有的是雨季和旱季。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Malapit sa ekwador, halos pareho ang pakiramdam ng tag-araw at taglamig; sa halip, may tag-ulan at tagtuyot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใกล้เส้นศูนย์สูตร ฤดูร้อนกับฤดูหนาวแทบไม่ต่างกัน แต่มีฤดูฝนและฤดูแล้งแทน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca del ecuador el verano y el invierno se parecen mucho; en su lugar hay estación de lluvias y estación seca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perto do equador o verão e o inverno são quase iguais; no lugar deles há estação chuvosa e estação seca."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भूमध्य रेखा के पास गर्मी और सर्दी लगभग एक जैसी लगती हैं; उनकी जगह बरसात और सूखे के मौसम होते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিষুবরেখার কাছে গ্রীষ্ম ও শীত প্রায় একই রকম; তার বদলে সেখানে বর্ষা ও শুষ্ক ঋতু থাকে।"
          }
        }
      }
    },
    "kids.fact5": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuzey yarımkürede yaz, kıştan birkaç gün uzundur: Dünya Güneş'ten uzaktayken biraz daha yavaş gider."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the northern half, summer is a few days longer than winter: Earth moves a little slower when it's farther from the Sun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Nordhalbkugel ist der Sommer ein paar Tage länger als der Winter: Weiter weg von der Sonne bewegt sich die Erde etwas langsamer."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimal yarımkürəsində yay qışdan bir neçə gün uzundur: Yer Günəşdən uzaqda olanda bir az yavaş gedir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في النصف الشمالي يكون الصيف أطول من الشتاء ببضعة أيام: فالأرض تتحرك أبطأ قليلًا حين تكون أبعد عن الشمس."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di belahan utara, musim panas beberapa hari lebih panjang dari musim dingin: Bumi bergerak sedikit lebih lambat saat lebih jauh dari Matahari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شمالی حصے میں گرمیاں سردیوں سے چند دن لمبی ہوتی ہیں: سورج سے دور ہونے پر زمین ذرا آہستہ چلتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در نیمهٔ شمالی تابستان چند روز بلندتر از زمستان است: زمین وقتی از خورشید دورتر است کمی آهسته‌تر حرکت می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la moitié nord, l’été dure quelques jours de plus que l’hiver : la Terre avance un peu plus lentement quand elle est plus loin du Soleil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В северной половине лето на несколько дней длиннее зимы: вдали от Солнца Земля движется чуть медленнее."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "北半球では夏が冬より数日長いのです。地球は太陽から遠いとき、少しゆっくり動くからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "북반구에서는 여름이 겨울보다 며칠 길어요. 지구는 태양에서 멀 때 조금 더 천천히 움직이거든요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在北半球，夏天比冬天长几天：地球离太阳远时走得稍慢一些。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa hilagang bahagi, ilang araw na mas mahaba ang tag-araw kaysa taglamig: medyo bumabagal ang Daigdig kapag mas malayo ito sa Araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในซีกโลกเหนือ ฤดูร้อนยาวกว่าฤดูหนาวไม่กี่วัน เพราะโลกเคลื่อนที่ช้าลงเล็กน้อยเมื่ออยู่ไกลดวงอาทิตย์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el hemisferio norte, el verano dura unos días más que el invierno: la Tierra va un poco más despacio cuando está más lejos del Sol."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na metade norte, o verão dura alguns dias a mais que o inverno: a Terra anda um pouco mais devagar quando está mais longe do Sol."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्तरी गोलार्ध में गर्मी सर्दी से कुछ दिन लंबी होती है: सूरज से दूर होने पर पृथ्वी थोड़ी धीमी चलती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তর অর্ধেকে গ্রীষ্ম শীতের চেয়ে কয়েক দিন লম্বা: সূর্য থেকে দূরে থাকলে পৃথিবী একটু ধীরে চলে।"
          }
        }
      }
    },
