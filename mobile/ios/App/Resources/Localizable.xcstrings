    "tools.pomodoro.noiseNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses yalnız çalışma süresi işlerken çalar; tarayıcıda üretilir, dosya indirilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound plays only while a work session is running; it is generated in the browser, nothing is downloaded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geräusch läuft nur während einer Arbeitsphase; es wird im Browser erzeugt, nichts wird heruntergeladen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səs yalnız iş müddəti gedərkən çalır; brauzerdə yaradılır, heç nə yüklənmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل الصوت فقط أثناء فترة العمل؛ ويُولَّد في المتصفح دون تنزيل أي ملف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara hanya diputar selama sesi kerja berjalan; suara dibuat di peramban, tidak ada yang diunduh."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آواز صرف کام کے سیشن کے دوران چلتی ہے؛ یہ براؤزر میں بنتی ہے، کچھ ڈاؤن لوڈ نہیں ہوتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدا فقط هنگام جلسهٔ کار پخش می‌شود؛ در مرورگر ساخته می‌شود و چیزی بارگیری نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son ne joue que pendant une séance de travail ; il est produit dans le navigateur, rien n’est téléchargé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук играет только во время рабочего интервала; он создаётся в браузере, ничего не загружается."
          }
        }
      }
    },
