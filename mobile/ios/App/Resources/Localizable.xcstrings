    "photoApp.forecastNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renkleri orta ve yüksek bulutlar yakalar; ufuktaki alçak bulut ve yağış Güneş'i kapatır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mid and high clouds catch the colours; low cloud and rain on the horizon block the sun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittelhohe und hohe Wolken fangen die Farben ein; tiefe Wolken und Regen am Horizont verdecken die Sonne."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rəngləri orta və yüksək buludlar tutur; üfüqdəki alçaq bulud və yağış Günəşi örtür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السحب المتوسطة والعالية تلتقط الألوان، والسحب المنخفضة والمطر عند الأفق تحجب الشمس."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Awan menengah dan tinggi menangkap warna; awan rendah dan hujan di cakrawala menutupi matahari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درمیانے اور اونچے بادل رنگ پکڑتے ہیں؛ افق پر نچلے بادل اور بارش سورج کو چھپا دیتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابرهای میانی و بلند رنگ‌ها را می‌گیرند؛ ابر پایین و بارش در افق خورشید را می‌پوشانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nuages moyens et hauts captent les couleurs ; les nuages bas et la pluie à l'horizon masquent le soleil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средние и высокие облака ловят цвета; низкие облака и дождь у горизонта закрывают солнце."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中層・上層の雲は色をとらえ、地平線の低い雲や雨は太陽を隠します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중층·상층 구름은 색을 담고, 지평선의 낮은 구름과 비는 해를 가립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中高云能映出色彩；地平线上的低云和降雨会遮住太阳。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang katamtaman at matataas na ulap ang sumasalo ng kulay; ang mababang ulap at ulan sa abot-tanaw ay tumatakip sa araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมฆระดับกลางและระดับสูงช่วยรับสีสัน ส่วนเมฆต่ำและฝนที่ขอบฟ้าจะบังดวงอาทิตย์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nubes medias y altas recogen los colores; las nubes bajas y la lluvia en el horizonte tapan el sol."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuvens médias e altas captam as cores; nuvens baixas e chuva no horizonte encobrem o sol."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मध्यम और ऊँचे बादल रंग पकड़ते हैं; क्षितिज पर नीचे के बादल और बारिश सूरज को ढक देते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাঝারি ও উঁচু মেঘ রং ধরে; দিগন্তে নিচু মেঘ ও বৃষ্টি সূর্যকে আড়াল করে।"
          }
        }
      }
    },
