    "zikir.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dokunuşta hafif titreşir, hedefte ve tesbihatın her 33'ünde güçlü titreşir. Sayılar yalnız bu cihazda."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A light buzz on every tap, a strong one at the target and at every 33 in the tasbih. Counts stay on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leichte Vibration bei jedem Tippen, eine stärkere beim Erreichen des Ziels und bei jeder 33 im Tasbih. Die Zählerstände bleiben auf diesem Gerät."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər toxunuşda yüngül titrəyir, hədəfdə və təsbihatın hər 33-də güclü titrəyir. Saylar yalnız bu cihazda saxlanılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اهتزاز خفيف عند كل لمسة وقوي عند الهدف وعند كل 33 في التسبيح. تبقى الأعداد على هذا الجهاز."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Getaran ringan di setiap ketukan, getaran kuat saat target tercapai dan setiap 33 dalam tasbih. Hitungan tetap di perangkat ini."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر ٹیپ پر ہلکی وائبریشن، ہدف پر اور تسبیحات میں ہر 33 پر تیز۔ گنتی اسی آلے پر رہتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با هر ضربه لرزشی سبک، و در رسیدن به هدف و هر 33 در تسبیحات لرزشی قوی. شمارش‌ها روی همین دستگاه می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une légère vibration à chaque appui, une forte à l’objectif et tous les 33 dans le tasbih. Les compteurs restent sur cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкая вибрация при каждом нажатии, сильная — при достижении цели и на каждом 33-м в тасбихе. Счёт хранится на этом устройстве."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップのたびに軽く振動し、目標とタスビーフの33ごとに強く振動します。回数はこの端末に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누를 때마다 가볍게, 목표와 타스비흐의 33마다 강하게 진동합니다. 횟수는 이 기기에 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次轻点轻微振动，达到目标及赞念每满33次时强振动。计数保存在此设备上。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahinang vibration sa bawat tap, malakas sa target at sa bawat 33 ng tasbih. Nananatili sa device na ito ang bilang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สั่นเบา ๆ ทุกครั้งที่แตะ สั่นแรงเมื่อถึงเป้าหมายและทุก 33 ครั้งของตัสบีห์ จำนวนอยู่ในอุปกรณ์นี้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vibración suave en cada toque y una fuerte al llegar al objetivo y cada 33 en el tasbih. Los recuentos se quedan en este dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vibração leve a cada toque e uma forte na meta e a cada 33 no tasbih. As contagens ficam só neste aparelho."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर टैप पर हल्का कंपन, लक्ष्य पर और तस्बीह में हर 33 पर तेज़ कंपन। गिनती इसी डिवाइस पर रहती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি চাপে হালকা কম্পন, লক্ষ্যে ও তাসবিহের প্রতি 33-এ জোরালো কম্পন। গণনা এই ডিভাইসেই থাকে।"
          }
        }
      }
    },
