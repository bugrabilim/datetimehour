    "geo.noLocation": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum bulunamadı; konum izni ve kesin konum açık mı?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location not found; are location permission and precise location on?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standort nicht gefunden; sind Standortzugriff und genauer Standort aktiv?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məkan tapılmadı; məkan icazəsi və dəqiq məkan açıqdır?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد الموقع؛ هل إذن الموقع والموقع الدقيق مفعّلان؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi tidak ditemukan; apakah izin lokasi dan lokasi tepat aktif?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام نہیں ملا؛ کیا مقام کی اجازت اور درست مقام آن ہیں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موقعیت پیدا نشد؛ آیا اجازهٔ موقعیت و موقعیت دقیق روشن‌اند؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Position introuvable ; l’accès à la position et la position exacte sont-ils activés ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение не найдено; включены ли доступ к геопозиции и точная геопозиция?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地が見つかりません。位置情報の許可と正確な位置情報はオンですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 찾지 못했습니다. 위치 권한과 정확한 위치가 켜져 있나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到位置；定位权限和精确位置是否已开启？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makita ang lokasyon; naka-on ba ang pahintulot sa lokasyon at ang precise location?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบตำแหน่ง เปิดสิทธิ์ตำแหน่งและตำแหน่งที่แม่นยำแล้วหรือยัง?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró la ubicación; ¿están activados el permiso de ubicación y la ubicación exacta?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Local não encontrado; a permissão de localização e a localização exata estão ativadas?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान नहीं मिला; क्या स्थान की अनुमति और सटीक स्थान चालू हैं?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান পাওয়া যায়নি; অবস্থানের অনুমতি ও সঠিক অবস্থান কি চালু আছে?"
          }
        }
      }
    },
    "geo.mapHint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeri değiştirmek için haritaya dokunun. Harita Apple'dan gelir; hatırlatıcının yeri telefonda kalır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the map to move the place. The map comes from Apple; the reminder's place stays on your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf die Karte, um den Ort zu verschieben. Die Karte stammt von Apple; der Ort der Erinnerung bleibt auf dem Telefon."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeri dəyişmək üçün xəritəyə toxunun. Xəritə Apple-dan gəlir; xatırladıcının yeri telefonda qalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على الخريطة لتغيير المكان. الخريطة من Apple؛ ويبقى مكان التذكير على هاتفك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk peta untuk memindahkan tempat. Peta berasal dari Apple; tempat pengingat tetap di ponsel Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جگہ بدلنے کے لیے نقشے پر ٹیپ کریں۔ نقشہ ایپل کا ہے؛ یاد دہانی کی جگہ آپ کے فون پر رہتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای جابه‌جایی مکان روی نقشه بزنید. نقشه از اپل است؛ مکان یادآور روی گوشی شما می‌ماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la carte pour déplacer le lieu. La carte vient d’Apple ; le lieu du rappel reste sur votre téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на карту, чтобы переместить место. Карта — от Apple; место напоминания остаётся на телефоне."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図をタップして場所を動かします。地図はAppleのもので、リマインダーの場所はスマホに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도를 눌러 장소를 옮기세요. 지도는 Apple에서 오며, 미리 알림의 장소는 휴대폰에 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点地图移动地点。地图来自Apple；提醒的地点留在手机上。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang mapa para ilipat ang lugar. Galing sa Apple ang mapa; nananatili sa telepono ang lugar ng paalala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะแผนที่เพื่อย้ายสถานที่ แผนที่มาจาก Apple สถานที่ของการเตือนอยู่บนโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el mapa para mover el lugar. El mapa procede de Apple; el lugar del recordatorio se queda en su teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no mapa para mover o lugar. O mapa vem da Apple; o lugar do lembrete fica no seu celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जगह खिसकाने के लिए नक्शे पर टैप करें। नक्शा Apple से आता है; रिमाइंडर की जगह आपके फ़ोन पर रहती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জায়গা সরাতে মানচিত্রে চাপুন। মানচিত্র Apple থেকে আসে; রিমাইন্ডারের জায়গা আপনার ফোনেই থাকে।"
          }
        }
      }
    },
    "geo.placeHintAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yer, yeni hatırlatıcıda uygulamada seçili konumdur; bulunduğunuz yeri kullanmak için yukarıdaki düğmeye dokunun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new reminder starts at the place selected in the app; tap the button above to use where you are."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Erinnerung verwendet zunächst den in der App gewählten Ort; tippen Sie oben auf die Schaltfläche, um Ihren aktuellen Standort zu verwenden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni xatırladıcıda yer tətbiqdə seçilmiş məkandır; olduğunuz yeri istifadə etmək üçün yuxarıdakı düyməyə toxunun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ التذكير الجديد بالمكان المحدد في التطبيق؛ انقر الزر أعلاه لاستخدام مكانك الحالي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat baru dimulai di tempat yang dipilih di aplikasi; ketuk tombol di atas untuk memakai lokasi Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئی یاد دہانی ایپ میں منتخب جگہ سے شروع ہوتی ہے؛ اپنا مقام استعمال کرنے کے لیے اوپر کا بٹن دبائیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادآور تازه از مکان انتخابی در برنامه آغاز می‌شود؛ برای استفاده از جایی که هستید دکمهٔ بالا را بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau rappel commence au lieu choisi dans l’app ; touchez le bouton ci-dessus pour utiliser votre position."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для нового напоминания сначала подставляется место, выбранное в приложении; нажмите кнопку выше, чтобы использовать ваше текущее местоположение."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいリマインダーはアプリで選んだ場所から始まります。今いる場所にするには上のボタンをタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 미리 알림은 앱에서 선택한 장소에서 시작합니다. 지금 있는 곳을 쓰려면 위 버튼을 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新提醒默认使用应用中所选的地点；轻点上方按钮可使用您当前所在的位置。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagsisimula ang bagong paalala sa lugar na napili sa app; i-tap ang button sa itaas para gamitin kung nasaan ka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเตือนใหม่เริ่มที่สถานที่ที่เลือกในแอป แตะปุ่มด้านบนเพื่อใช้ที่ที่คุณอยู่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio nuevo empieza en el lugar elegido en la app; toque el botón de arriba para usar su ubicación actual."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete novo começa no local escolhido no app; toque no botão acima para usar sua localização atual."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया रिमाइंडर ऐप में चुनी जगह से शुरू होता है; जहाँ आप हैं वह इस्तेमाल करने के लिए ऊपर का बटन दबाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন রিমাইন্ডার অ্যাপে বেছে নেওয়া জায়গা থেকে শুরু হয়; আপনি যেখানে আছেন সেটি ব্যবহার করতে ওপরের বোতামে চাপুন।"
          }
        }
      }
    },
    "geo.allow": {
      "extractionState": "manual",
      "localizations": {
