    "tools.stopwatch.hint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayollar: Boşluk başlat/durdur, L tur, R sıfırla."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts: Space start/stop, L lap, R reset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkürzel: Leertaste Start/Stopp, L Runde, R Zurücksetzen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qısayollar: Boşluq – başlat/dayandır, L – dövrə, R – sıfırla."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاختصارات: المسافة للتشغيل والإيقاف، وL للفة، وR لإعادة الضبط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan: Spasi mulai/berhenti, L putaran, R atur ulang."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس: اسپیس شروع/روکیں، L چکر، R ری سیٹ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میان‌برها: Space شروع/توقف، L دور، R بازنشانی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcis : Espace démarrer/arrêter, L tour, R réinitialiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши: пробел — старт/стоп, L — круг, R — сброс."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット：スペースで開始/停止、L でラップ、R でリセット。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키: 스페이스 시작/정지, L 랩, R 초기화."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键：空格开始/停止，L 计圈，R 重置。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts: Space simulan/itigil, L lap, R reset."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ลัด: Space เริ่ม/หยุด L รอบ R รีเซ็ต"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atajos: espacio iniciar/detener, L vuelta, R reiniciar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atalhos: espaço iniciar/parar, L volta, R zerar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट: स्पेस शुरू/रोकें, L लैप, R रीसेट।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট: Space শুরু/থামা, L ল্যাপ, R রিসেট।"
          }
        }
      }
    },
