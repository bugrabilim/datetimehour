    "cals.javanese.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cava takvimine (Anno Javanico, AJ) göre tarih, beş günlük pasaran haftası ve Cava yılbaşı 1 Suro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date in the Javanese calendar (Anno Javanico, AJ), the five-day pasaran week and the Javanese New Year, 1 Suro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum im javanischen Kalender (Anno Javanico, AJ), die fünftägige Pasaran-Woche und das javanische Neujahr 1 Suro."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yava təqviminə (Anno Javanico, AJ) görə tarix, beş günlük pasaran həftəsi və Yava yeni ili 1 Suro."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ في التقويم الجاوي (السنة الجاوية)، وأسبوع الباساران ذو الأيام الخمسة، ورأس السنة الجاوية 1 سورا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal menurut kalender Jawa (Anno Javanico, AJ), pekan pasaran lima hari, dan Tahun Baru Jawa 1 Suro."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاوی کیلنڈر (انو جاوانیکو) کے مطابق تاریخ، پانچ دن کا پاسارن ہفتہ اور جاوی نیا سال 1 سورا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ در گاه‌شماری جاوه‌ای (سال جاوه‌ای)، هفتهٔ پنج‌روزهٔ پاساران و سال نو جاوه‌ای، 1 سورا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date du calendrier javanais (Anno Javanico, AJ), la semaine pasaran de cinq jours et le Nouvel An javanais, 1 Suro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата по яванскому календарю (Anno Javanico, AJ), пятидневная неделя пасаран и яванский Новый год 1 Суро."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャワ暦（ジャワ紀元、AJ）の日付、5日周期のパサラン、ジャワ正月（スロ月1日）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자와력(자와 기원, AJ)의 날짜, 닷새 주기의 파사란, 자와 새해(수라월 1일)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "爪哇历（爪哇纪元，AJ）的日期、五日一周的帕萨兰和爪哇新年（苏拉月1日）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang petsa sa kalendaryong Javanese (Anno Javanico, AJ), ang limang-araw na linggong pasaran at ang Bagong Taon ng Java, 1 Suro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ตามปฏิทินชวา (ศักราชชวา, AJ) สัปดาห์ปาซารันห้าวัน และวันขึ้นปีใหม่ชวา 1 ซูรา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha del calendario javanés (Anno Javanico, AJ), la semana pasaran de cinco días y el Año Nuevo javanés, 1 Suro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A data no calendário javanês (Anno Javanico, AJ), a semana pasaran de cinco dias e o Ano-Novo javanês, 1 Suro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जावाई पंचांग (जावाई संवत, AJ) के अनुसार तिथि, पाँच दिन का पासारन सप्ताह और जावाई नववर्ष 1 सुरा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জাভানিজ পঞ্জিকা (জাভানিজ অব্দ, AJ) অনুযায়ী তারিখ, পাঁচ দিনের পাসারান সপ্তাহ এবং জাভানিজ নববর্ষ 1 সুরা।"
          }
        }
      }
    },
    "cals.javanese.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sultan Agung'un 1633'te kurduğu aritmetik ay takvimidir; 8 yıllık windu ve 120 yıllık kurup döngüleriyle işler. 1 Suro, Endonezya hükümetinin 1 Muharrem'inden bir gün ayrılabilir; Yogyakarta ve Surakarta sarayları zaman zaman kendi tarihlerini ilan eder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An arithmetic lunar calendar founded by Sultan Agung in 1633, running on 8-year windu and 120-year kurup cycles. 1 Suro can differ by a day from the Indonesian government's 1 Muharram; the Yogyakarta and Surakarta palaces sometimes announce their own dates."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein arithmetischer Mondkalender, 1633 von Sultan Agung eingeführt, mit achtjährigen Windu- und 120-jährigen Kurup-Zyklen. 1 Suro kann um einen Tag vom 1. Muharram der indonesischen Regierung abweichen; die Paläste von Yogyakarta und Surakarta geben mitunter eigene Daten bekannt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sultan Aqunqun 1633-cü ildə qurduğu hesablı ay təqvimidir; 8 illik vindu və 120 illik kurup dövrləri ilə işləyir. 1 Suro İndoneziya hökumətinin 1 Məhərrəmindən bir gün fərqlənə bilər; Yoqyakarta və Surakarta sarayları bəzən öz tarixlərini elan edir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقويم قمري حسابي أنشأه السلطان أغونغ سنة 1633، ويسير بدورات الويندو (8 سنوات) والكوروب (120 سنة). قد يختلف 1 سورا بيوم عن 1 محرم لدى الحكومة الإندونيسية، وقد يعلن قصرا يوغياكارتا وسوراكارتا مواعيدهما الخاصة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender bulan aritmetis yang ditetapkan Sultan Agung pada 1633, berjalan dengan siklus windu 8 tahun dan kurup 120 tahun. 1 Suro bisa berselisih sehari dengan 1 Muharam pemerintah; Keraton Yogyakarta dan Surakarta kadang mengumumkan tanggalnya sendiri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سلطان آگونگ کا 1633 میں قائم کیا ہوا حسابی قمری کیلنڈر، جو 8 سالہ وندو اور 120 سالہ کوروپ کے چکروں پر چلتا ہے۔ 1 سورا انڈونیشیا کی حکومت کی 1 محرم سے ایک دن مختلف ہو سکتا ہے؛ یوگیاکارتا اور سوراکارتا کے محل کبھی کبھی اپنی تاریخیں اعلان کرتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گاه‌شماری قمری حسابی که سلطان آگونگ در 1633 بنیان گذاشت و با دوره‌های ویندو (8 ساله) و کوروپ (120 ساله) پیش می‌رود. 1 سورا ممکن است یک روز با 1 محرم دولت اندونزی فرق کند؛ کاخ‌های یوگیاکارتا و سوراکارتا گاهی تاریخ خود را اعلام می‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendrier lunaire arithmétique fondé par le sultan Agung en 1633, rythmé par des cycles windu de 8 ans et kurup de 120 ans. Le 1 Suro peut différer d’un jour du 1er mouharram du gouvernement indonésien ; les palais de Yogyakarta et de Surakarta annoncent parfois leurs propres dates."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Арифметический лунный календарь, введённый султаном Агунгом в 1633 году, с циклами винду (8 лет) и куруп (120 лет). 1 Суро может на день расходиться с 1 мухаррама индонезийского правительства; дворцы Джокьякарты и Суракарты иногда объявляют свои даты."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1633年にスルタン・アグンが定めた算術的な太陰暦で、8年周期のウィンドゥと120年周期のクルプで運用されます。スロ月1日はインドネシア政府のムハッラム月1日と1日ずれることがあり、ジョグジャカルタとスラカルタの王宮が独自の日付を発表することもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1633년 술탄 아궁이 정한 산술 태음력으로, 8년 주기의 윈두와 120년 주기의 쿠룹으로 운영됩니다. 수라월 1일은 인도네시아 정부의 무하람월 1일과 하루 다를 수 있으며, 족자카르타와 수라카르타 왕궁이 따로 날짜를 발표하기도 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1633年苏丹阿贡创立的算术太阴历，按8年一周期的温都和120年一周期的库鲁普运行。苏拉月1日可能与印度尼西亚政府的穆哈兰月1日相差一天；日惹和梭罗王宫有时会公布各自的日期。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang aritmetikong kalendaryong lunar na itinatag ni Sultan Agung noong 1633, na tumatakbo sa 8-taong windu at 120-taong kurup. Maaaring maiba nang isang araw ang 1 Suro sa 1 Muharram ng pamahalaan ng Indonesia; paminsan-minsan naglalabas ng sariling petsa ang mga palasyo ng Yogyakarta at Surakarta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินจันทรคติแบบคำนวณที่สุลต่านอากุงตั้งขึ้นในปี 1633 ใช้รอบวินดู 8 ปีและกูรุป 120 ปี วันที่ 1 ซูราอาจต่างจากวันที่ 1 มุฮัรรอมของรัฐบาลอินโดนีเซียหนึ่งวัน วังยอกยาการ์ตาและสุราการ์ตาบางครั้งประกาศวันของตนเอง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario lunar aritmético fundado por el sultán Agung en 1633, con ciclos windu de 8 años y kurup de 120 años. El 1 Suro puede diferir un día del 1 de muharram del gobierno indonesio; los palacios de Yogyakarta y Surakarta a veces anuncian sus propias fechas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendário lunar aritmético criado pelo sultão Agung em 1633, com ciclos windu de 8 anos e kurup de 120 anos. O 1 Suro pode diferir um dia do 1º de muharram do governo indonésio; os palácios de Yogyakarta e Surakarta às vezes anunciam as próprias datas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुल्तान अगुंग द्वारा 1633 में स्थापित गणितीय चांद्र पंचांग, जो 8 वर्ष के विंदु और 120 वर्ष के कुरुप चक्रों पर चलता है। 1 सुरा इंडोनेशिया सरकार की 1 मुहर्रम से एक दिन अलग हो सकता है; योग्यकार्ता और सुराकार्ता के महल कभी-कभी अपनी तिथियाँ घोषित करते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুলতান আগুং 1633 সালে প্রতিষ্ঠিত গাণিতিক চান্দ্র পঞ্জিকা, যা 8 বছরের উইন্দু ও 120 বছরের কুরুপ চক্রে চলে। 1 সুরা ইন্দোনেশিয়া সরকারের 1 মহররম থেকে এক দিন আলাদা হতে পারে; যোগ্যকার্তা ও সুরাকার্তার প্রাসাদ মাঝে মাঝে নিজস্ব তারিখ ঘোষণা করে।"
          }
        }
      }
    },
