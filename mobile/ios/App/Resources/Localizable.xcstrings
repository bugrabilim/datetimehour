        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario etíope"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendário etíope"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इथियोपियाई कैलेंडर"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইথিওপীয় ক্যালেন্ডার"
          }
        }
      }
    },
    "cals.ethiopian.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiyopya tarihi ve Enkutataş, Meskel, Genna, Timkat, Fasika gibi Etiyopya bayramları."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Ethiopian date and Ethiopian holidays such as Enkutatash, Meskel, Genna, Timkat and Fasika."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das äthiopische Datum und äthiopische Feste wie Enkutatash, Meskel, Genna, Timkat und Fasika."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Efiopiya tarixi və Enkutataş, Meskel, Genna, Timkat, Fasika kimi Efiopiya bayramları."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ الإثيوبي والأعياد الإثيوبية مثل إنكوتاتاش ومسقل وجنا وتمكات وفاسيكا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal Etiopia dan hari raya Etiopia seperti Enkutatash, Meskel, Genna, Timkat, dan Fasika."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایتھوپیائی تاریخ اور ایتھوپیائی تہوار جیسے انکوتاتاش، مسکل، گینا، تمکات اور فاسیکا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ اتیوپیایی و اعیاد اتیوپی مانند اینکوتاتاش، مسکل، گنا، تیمکت و فاسیکا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date éthiopienne et les fêtes éthiopiennes comme Enkutatash, Meskel, Genna, Timkat et Fasika."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эфиопская дата и эфиопские праздники: Энкутаташ, Мескель, Генна, Тимкат и Фасика."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エチオピア暦の日付と、エンクタタシュ、メスケル、ゲンナ、ティムカット、ファシカなどのエチオピアの祝祭日。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에티오피아력 날짜와 엔쿠타타시, 메스켈, 겐나, 팀카트, 파시카 등 에티오피아 축일."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "埃塞俄比亚历日期，以及恩库塔塔什节、梅斯克尔节、根纳节、蒂姆卡特节和法西卡等埃塞俄比亚节日。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang petsa sa kalendaryo ng Etiyopiya at mga pista gaya ng Enkutatash, Meskel, Genna, Timkat, at Fasika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ตามปฏิทินเอธิโอเปียและเทศกาลของเอธิโอเปีย เช่น เอนคูทาทาช เมสเกล เกนนา ทิมกัต และฟาซิกา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha etíope y las fiestas etíopes como Enkutatash, Meskel, Genna, Timkat y Fasika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A data etíope e as festas etíopes como Enkutatash, Meskel, Genna, Timkat e Fasika."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इथियोपियाई तारीख़ और एनकुताताश, मेस्केल, गेन्ना, टिमकत व फ़ासिका जैसे इथियोपियाई त्योहार।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইথিওপীয় তারিখ এবং এনকুতাতাশ, মেসকেল, গেন্না, তিমকাত ও ফাসিকার মতো ইথিওপীয় ছুটি।"
          }
        }
      }
    },
    "cals.ethiopian.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiyopya yılı 30 günlük 12 ay ile 5 ya da 6 günlük Pagume'den oluşur; 11 Eylül'de (Gregoryen artık yıldan önceki yılda 12 Eylül'de) başlar ve Gregoryen yılın 7–8 yıl gerisindedir. Bayramlar Etiyopya Ortodoks Tewahedo Kilisesi'ne göredir: Genna her yıl 7 Ocak'ta, Fasika Ortodoks Paskalyasıyla aynı gündedir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Ethiopian year has twelve 30-day months and Pagume of 5 or 6 days; it begins on 11 September (12 September in the year before a Gregorian leap year) and runs 7–8 years behind the Gregorian year. Feasts follow the Ethiopian Orthodox Tewahedo Church: Genna falls on 7 January every year and Fasika on Orthodox Easter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das äthiopische Jahr hat zwölf Monate zu 30 Tagen und den Pagume mit 5 oder 6 Tagen; es beginnt am 11. September (im Jahr vor einem gregorianischen Schaltjahr am 12. September) und liegt 7–8 Jahre hinter dem gregorianischen Jahr. Die Feste folgen der Äthiopisch-Orthodoxen Tewahedo-Kirche: Genna ist jedes Jahr am 7. Januar, Fasika am orthodoxen Ostersonntag."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Efiopiya ili 30 günlük 12 aydan və 5 ya da 6 günlük Paqumedən ibarətdir; 11 sentyabrda (Qriqorian uzun ilindən əvvəlki ildə 12 sentyabrda) başlayır və Qriqorian ildən 7–8 il geridədir. Bayramlar Efiopiya Ortodoks Tevahedo Kilsəsinə görədir: Genna hər il 7 yanvarda, Fasika Pravoslav Pasxası ilə eyni gündədir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتكون السنة الإثيوبية من 12 شهرًا كل منها 30 يومًا وشهر باجمي من 5 أو 6 أيام، وتبدأ في 11 سبتمبر (12 سبتمبر في السنة التي تسبق السنة الكبيسة الغريغورية) وتتأخر 7 أو 8 سنوات عن السنة الغريغورية. تتبع الأعياد الكنيسة الأرثوذكسية الإثيوبية التوحيدية: يقع جنا في 7 يناير كل عام، وفاسيكا في يوم عيد الفصح الأرثوذكسي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahun Etiopia terdiri atas 12 bulan masing-masing 30 hari dan bulan Pagume 5 atau 6 hari; tahun dimulai pada 11 September (12 September pada tahun sebelum tahun kabisat Gregorius) dan tertinggal 7–8 tahun dari tahun Gregorius. Hari raya mengikuti Gereja Ortodoks Tewahedo Etiopia: Genna jatuh setiap 7 Januari dan Fasika pada hari Paskah Ortodoks."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایتھوپیائی سال 30 دن کے 12 مہینوں اور 5 یا 6 دن کے مہینے پاگومے پر مشتمل ہے؛ یہ 11 ستمبر کو (گریگوری لیپ سال سے پہلے والے سال میں 12 ستمبر کو) شروع ہوتا ہے اور گریگوری سال سے 7–8 سال پیچھے ہے۔ تہوار ایتھوپیائی آرتھوڈوکس تواحیدو کلیسا کے مطابق ہیں: گینا ہر سال 7 جنوری کو اور فاسیکا آرتھوڈوکس ایسٹر کے دن ہوتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سال اتیوپیایی از 12 ماه 30 روزه و ماه پاگومه با 5 یا 6 روز تشکیل می‌شود؛ در 11 سپتامبر (در سال پیش از سال کبیسهٔ میلادی در 12 سپتامبر) آغاز می‌شود و 7 تا 8 سال از سال میلادی عقب‌تر است. اعیاد طبق کلیسای ارتدکس تواحدوی اتیوپی است: گنا هر سال در 7 ژانویه و فاسیکا در روز عید پاک ارتدکس است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’année éthiopienne compte douze mois de 30 jours et le mois de Pagume, de 5 ou 6 jours ; elle commence le 11 septembre (le 12 septembre l’année qui précède une année bissextile grégorienne) et a 7 à 8 ans de retard sur l’année grégorienne. Les fêtes suivent l’Église orthodoxe éthiopienne Tewahedo : Genna tombe chaque année le 7 janvier et Fasika le jour de Pâques orthodoxe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эфиопский год состоит из 12 месяцев по 30 дней и месяца пагумен из 5 или 6 дней; он начинается 11 сентября (12 сентября в год перед григорианским високосным) и отстаёт от григорианского на 7–8 лет. Праздники отмечаются по Эфиопской православной церкви Тевахедо: Генна каждый год 7 января, Фасика в день православной Пасхи."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エチオピア暦の1年は30日の月が12か月とパグメ月（5日または6日）からなり、9月11日（グレゴリオ暦の閏年の前年は9月12日）に始まり、グレゴリオ暦より7〜8年遅れています。祝祭日はエチオピア正教会に従い、ゲンナは毎年1月7日、ファシカは正教会の復活大祭と同じ日です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에티오피아력의 1년은 30일짜리 12개월과 5일 또는 6일인 파구메월로 이루어지며, 9월 11일(그레고리력 윤년 전해에는 9월 12일)에 시작하고 그레고리력보다 7~8년 늦습니다. 축일은 에티오피아 정교회 테와헤도를 따르며, 겐나는 매년 1월 7일, 파시카는 정교회 부활절과 같은 날입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "埃塞俄比亚历一年有12个30天的月和一个5天或6天的帕古梅月，每年从9月11日开始（格里历闰年的前一年为9月12日），比格里历晚7至8年。节日依照埃塞俄比亚正教会台瓦西多：根纳节每年在1月7日，法西卡与东正教复活节同日。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang taon ng Etiyopiya ay may 12 buwan na tig-30 araw at ang buwang Pagume na 5 o 6 na araw; nagsisimula ito sa 11 Setyembre (12 Setyembre sa taon bago ang leap year ng Gregoryano) at 7–8 taon itong nahuhuli sa taong Gregoryano. Sinusunod ng mga pista ang Simbahang Ortodoksong Tewahedo ng Etiyopiya: tuwing 7 Enero ang Genna at kasabay ng Pasko ng Pagkabuhay ng Ortodokso ang Fasika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปีเอธิโอเปียมี 12 เดือน เดือนละ 30 วัน และเดือนปากูเมซึ่งมี 5 หรือ 6 วัน เริ่มต้นวันที่ 11 กันยายน (12 กันยายนในปีก่อนปีอธิกสุรทินของปฏิทินเกรกอรี) และช้ากว่าปีเกรกอรี 7–8 ปี เทศกาลเป็นไปตามคริสตจักรออร์โธดอกซ์เตวาเฮโดเอธิโอเปีย โดยเกนนาตรงกับวันที่ 7 มกราคมทุกปี และฟาซิกาตรงกับวันอีสเตอร์ของออร์โธดอกซ์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El año etíope tiene doce meses de 30 días y el mes de Pagume, de 5 o 6 días; comienza el 11 de septiembre (el 12 de septiembre en el año anterior a un año bisiesto gregoriano) y va 7 u 8 años por detrás del año gregoriano. Las fiestas siguen a la Iglesia ortodoxa etíope Tewahedo: Genna cae cada año el 7 de enero y Fasika el día de la Pascua ortodoxa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ano etíope tem doze meses de 30 dias e o mês de Pagume, de 5 ou 6 dias; começa em 11 de setembro (12 de setembro no ano anterior a um ano bissexto gregoriano) e fica 7 a 8 anos atrás do ano gregoriano. As festas seguem a Igreja Ortodoxa Etíope Tewahedo: Genna cai todo ano em 7 de janeiro e Fasika no dia da Páscoa ortodoxa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इथियोपियाई वर्ष में 30-30 दिन के 12 महीने और 5 या 6 दिन का पागुमे महीना होता है; यह 11 सितंबर को (ग्रेगोरियन लीप वर्ष से पहले वाले वर्ष में 12 सितंबर को) शुरू होता है और ग्रेगोरियन वर्ष से 7–8 वर्ष पीछे रहता है। त्योहार इथियोपियाई ऑर्थोडॉक्स तेवाहेदो चर्च के अनुसार हैं: गेन्ना हर वर्ष 7 जनवरी को और फ़ासिका ऑर्थोडॉक्स ईस्टर के दिन होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইথিওপীয় বছরে 30 দিনের বারোটি মাস এবং 5 বা 6 দিনের পাগুমে থাকে; বছর 11 সেপ্টেম্বর শুরু হয় (গ্রেগরীয় অধিবর্ষের আগের বছরে 12 সেপ্টেম্বর) এবং গ্রেগরীয় বছরের চেয়ে 7–8 বছর পিছিয়ে চলে। উৎসবগুলো ইথিওপীয় অর্থোডক্স তেওয়াহেদো গির্জা অনুসরণ করে: গেন্না প্রতি বছর 7 জানুয়ারি এবং ফাসিকা অর্থোডক্স ইস্টারে।"
          }
        }
      }
    },
