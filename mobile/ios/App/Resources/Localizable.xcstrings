    "account.deletePassword": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay için şifrenizi yazın (son 24 saatte giriş yaptıysanız gerekmez)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your password to confirm (not needed if you signed in within the last 24 hours)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie zur Bestätigung Ihr Passwort ein (nicht nötig, wenn Sie sich in den letzten 24 Stunden angemeldet haben)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təsdiq üçün şifrənizi yazın (son 24 saatda daxil olmusunuzsa lazım deyil)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب كلمة مرورك للتأكيد (لا حاجة إن سجّلت الدخول خلال آخر 24 ساعة)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis kata sandi Anda untuk konfirmasi (tidak perlu jika Anda masuk dalam 24 jam terakhir)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدیق کے لیے اپنا پاس ورڈ لکھیں (اگر آپ نے پچھلے 24 گھنٹوں میں سائن ان کیا ہے تو ضرورت نہیں)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تأیید گذرواژه‌تان را بنویسید (اگر در 24 ساعت گذشته وارد شده‌اید لازم نیست)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre mot de passe pour confirmer (inutile si vous vous êtes connecté dans les dernières 24 heures)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для подтверждения введите пароль (не нужно, если вы входили за последние 24 часа)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認のためパスワードを入力してください（過去24時間以内にログインした場合は不要）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인을 위해 비밀번호를 입력하세요(최근 24시간 안에 로그인했다면 필요 없음)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入密码确认（若您在过去 24 小时内登录过则无需输入）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isulat ang inyong password para kumpirmahin (hindi kailangan kung nag-sign in kayo sa nakaraang 24 oras)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอกรหัสผ่านเพื่อยืนยัน (ไม่ต้องกรอกหากลงชื่อเข้าใช้ภายใน 24 ชั่วโมงที่ผ่านมา)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba su contraseña para confirmar (no hace falta si inició sesión en las últimas 24 horas)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite sua senha para confirmar (não precisa se você entrou nas últimas 24 horas)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि के लिए अपना पासवर्ड लिखें (अगर आपने पिछले 24 घंटों में साइन इन किया है तो ज़रूरी नहीं)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশ্চিত করতে আপনার পাসওয়ার্ড লিখুন (গত 24 ঘণ্টায় সাইন ইন করে থাকলে দরকার নেই)।"
          }
        }
      }
    },
    "account.deleteConfirm": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız silinsin mi? Bu geri alınamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your account? This can't be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto löschen? Das lässt sich nicht rückgängig machen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız silinsin? Bunu geri qaytarmaq olmur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف حسابك؟ لا يمكن التراجع عن ذلك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus akun Anda? Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا اکاؤنٹ حذف کر دیں؟ یہ واپس نہیں ہو سکتا۔"
