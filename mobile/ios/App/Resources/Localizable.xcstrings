    "nature.eclApprox": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatler yaklaşıktır (birkaç dakika); bu yerden görülmeyen anlar soluk yazılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times are approximate (a few minutes); moments not visible from this place are dimmed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiten sind Näherungswerte (einige Minuten); von hier nicht sichtbare Zeitpunkte werden blass dargestellt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtlar təxminidir (bir neçə dəqiqə); bu yerdən görünməyən anlar solğun yazılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأوقات تقريبية (بضع دقائق)؛ اللحظات التي لا تُرى من هذا المكان باهتة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu bersifat perkiraan (beberapa menit); saat yang tidak terlihat dari tempat ini dibuat pudar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات تخمینی ہیں (چند منٹ)؛ اس جگہ سے نظر نہ آنے والے لمحات ہلکے دکھائے گئے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان‌ها تقریبی است (چند دقیقه)؛ لحظه‌هایی که از این مکان دیده نمی‌شوند کم‌رنگ هستند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heures approximatives (quelques minutes) ; les instants non visibles depuis ce lieu sont estompés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время приблизительное (несколько минут); моменты, не видимые отсюда, приглушены."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻はおおよそ（数分）です。この場所から見えない時刻は薄く表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시각은 대략적입니다(몇 분). 이곳에서 보이지 않는 시각은 흐리게 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间为近似值（数分钟）；此地看不到的时刻以浅色显示。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinatayang oras (ilang minuto); malabo ang mga sandaling hindi makikita mula rito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาเป็นค่าโดยประมาณ (ไม่กี่นาที) ช่วงที่มองไม่เห็นจากที่นี่แสดงเป็นสีจาง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas son aproximadas (unos minutos); los momentos no visibles desde este lugar aparecen atenuados."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os horários são aproximados (alguns minutos); os momentos não visíveis deste local aparecem esmaecidos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय अनुमानित हैं (कुछ मिनट); इस स्थान से न दिखने वाले क्षण धुँधले दिखाए गए हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়গুলো আনুমানিক (কয়েক মিনিট); এই জায়গা থেকে দেখা যায় না এমন মুহূর্তগুলো ম্লান।"
          }
        }
      }
    },
