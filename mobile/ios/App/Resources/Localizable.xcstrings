    "intent.full.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Tarih'i tam ekran saatle açar; isterseniz gece modunda."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Time & Date with the full-screen clock, optionally in night mode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Uhr & Datum mit der Vollbilduhr, auf Wunsch im Nachtmodus."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Tarix-i tam ekran saatla açır; istəsəniz gecə rejimində."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الوقت والتاريخ على الساعة بملء الشاشة، بالوضع الليلي إن شئت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Jam & Tanggal dengan jam layar penuh, bisa dalam mode malam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت اور تاریخ کو پوری اسکرین گھڑی کے ساتھ کھولتا ہے، چاہیں تو رات کے موڈ میں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت و تاریخ را با ساعت تمام‌صفحه باز می‌کند، در صورت تمایل در حالت شب."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Heure & Date avec l’horloge plein écran, éventuellement en mode nuit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает «Время и дата» с полноэкранными часами, при желании в ночном режиме."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻と日付を全画面時計で開きます。ナイトモードも選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간과 날짜를 전체 화면 시계로 엽니다. 야간 모드도 선택할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以全屏时钟打开时间与日期，可选夜间模式。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binubuksan ang Oras at Petsa sa full-screen na orasan, puwedeng may night mode."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด เวลาและวันที่ ด้วยนาฬิกาเต็มจอ เลือกโหมดกลางคืนได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Hora y Fecha con el reloj a pantalla completa, opcionalmente en modo nocturno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Hora e Data com o relógio em tela cheia, opcionalmente no modo noturno."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय और तारीख को फ़ुल स्क्रीन घड़ी के साथ खोलता है, चाहें तो रात्रि मोड में।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময় ও তারিখ পূর্ণ পর্দার ঘড়িসহ খোলে, চাইলে রাত মোডে।"
          }
        }
      }
    },
