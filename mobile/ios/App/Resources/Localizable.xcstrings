    "account.recordsNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamada giriş yaptığınızda kayıtlarınız (ayarlar, listeler, pomodoro ve ibadet kayıtları gibi) hesabınıza da yazılır; iPhone'da ayrıca iCloud'da durur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you sign in to the app, your records (such as settings, lists, pomodoro and worship records) are also written to your account; on iPhone they also stay in iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie in der App angemeldet sind, werden Ihre Einträge (etwa Einstellungen, Listen, Pomodoro- und Gebetseinträge) auch in Ihr Konto geschrieben; auf dem iPhone bleiben sie außerdem in iCloud."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqdə daxil olduqda qeydləriniz (ayarlar, siyahılar, pomodoro və ibadət qeydləri kimi) hesabınıza da yazılır; iPhone-da həm də iCloud-da qalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تسجيل الدخول في التطبيق تُكتب سجلاتك (مثل الإعدادات والقوائم وسجلات بومودورو والعبادة) في حسابك أيضًا؛ وعلى iPhone تبقى كذلك في iCloud."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Anda masuk di aplikasi, catatan Anda (seperti pengaturan, daftar, catatan pomodoro dan ibadah) juga ditulis ke akun Anda; di iPhone catatan itu juga tetap ada di iCloud."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ میں سائن ان ہونے پر آپ کے ریکارڈ (جیسے ترتیبات، فہرستیں، پومودورو اور عبادت کے ریکارڈ) آپ کے اکاؤنٹ میں بھی لکھے جاتے ہیں؛ iPhone پر یہ iCloud میں بھی رہتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی در برنامه وارد شده‌اید، ثبت‌های شما (مانند تنظیمات، فهرست‌ها، ثبت‌های پومودورو و عبادت) در حسابتان هم نوشته می‌شود؛ در iPhone در iCloud هم می‌ماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous êtes connecté dans l'application, vos données (réglages, listes, séances pomodoro, suivi des prières…) sont aussi écrites dans votre compte ; sur iPhone, elles restent aussi dans iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы вошли в приложении, ваши записи (настройки, списки, записи помодоро и молитв) пишутся и в аккаунт; на iPhone они также остаются в iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリでログインしていると、記録（設定、リスト、ポモドーロや礼拝の記録など）はアカウントにも書き込まれます。iPhone では iCloud にも残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 로그인하면 기록(설정, 목록, 뽀모도로·예배 기록 등)이 계정에도 저장됩니다. iPhone에서는 iCloud에도 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用中登录后，您的记录（如设置、列表、番茄钟和礼拜记录）也会写入账户；在 iPhone 上还会保留在 iCloud 中。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag naka-sign in kayo sa app, isinusulat din sa inyong account ang inyong mga record (gaya ng setting, listahan, pomodoro at record ng pagsamba); sa iPhone, nananatili rin ang mga ito sa iCloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อลงชื่อเข้าใช้ในแอป บันทึกของคุณ (เช่น การตั้งค่า รายการ โพโมโดโร และบันทึกการละหมาด) จะถูกเขียนลงบัญชีด้วย บน iPhone ยังอยู่ใน iCloud ด้วย"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando inicia sesión en la app, sus registros (ajustes, listas, pomodoro y registros de oración, por ejemplo) también se guardan en su cuenta; en el iPhone también siguen en iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você entra no app, seus registros (como configurações, listas, pomodoro e registros de oração) também são gravados na sua conta; no iPhone, também ficam no iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में साइन इन होने पर आपके रिकॉर्ड (जैसे सेटिंग, सूचियाँ, पोमोडोरो और इबादत के रिकॉर्ड) आपके खाते में भी लिखे जाते हैं; iPhone पर ये iCloud में भी रहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপে সাইন ইন থাকলে আপনার রেকর্ড (যেমন সেটিং, তালিকা, পোমোডোরো ও ইবাদতের রেকর্ড) আপনার অ্যাকাউন্টেও লেখা হয়; iPhone-এ এগুলো iCloud-এও থাকে।"
          }
        }
      }
    },
