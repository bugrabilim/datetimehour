          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈسٹرب نہ کریں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مزاحم نشوید"
          }
        },
        "fr": {
          "stringUnit": {
