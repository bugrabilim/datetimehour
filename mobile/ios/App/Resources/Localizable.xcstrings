    "moon.scrubHint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırarak başka günün Ay'ına bakın; takvimde bir güne dokunmak da o günü seçer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide to see the Moon on another day; tapping a day in the calendar also selects it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schieben, um den Mond an einem anderen Tag zu sehen; Tippen auf einen Kalendertag wählt ihn ebenfalls."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqa günün Ayına baxmaq üçün sürüşdürün; təqvimdə günə toxunmaq da onu seçir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لرؤية القمر في يوم آخر؛ النقر على يوم في التقويم يختاره أيضًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser untuk melihat Bulan di hari lain; mengetuk hari di kalender juga memilihnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی اور دن کا چاند دیکھنے کے لیے سلائیڈ کریں؛ کیلنڈر میں دن پر ٹیپ کرنا بھی اسے منتخب کرتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای دیدن ماه در روز دیگر بلغزانید؛ لمس یک روز در تقویم هم آن را انتخاب می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour voir la Lune un autre jour ; toucher un jour du calendrier le sélectionne aussi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сдвиньте, чтобы увидеть Луну в другой день; нажатие на день в календаре тоже выбирает его."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライドで別の日の月を表示。カレンダーの日付をタップしても選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밀어서 다른 날의 달을 보세요. 달력에서 날짜를 눌러도 선택됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动查看其他日子的月亮；点按日历中的日期也可选择。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-slide para makita ang Buwan sa ibang araw; ang pag-tap sa araw sa kalendaryo ay pumipili rin nito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนเพื่อดูดวงจันทร์ในวันอื่น แตะวันในปฏิทินก็เลือกได้เช่นกัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslice para ver la Luna otro día; tocar un día del calendario también lo selecciona."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para ver a Lua em outro dia; tocar num dia do calendário também o seleciona."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दूसरे दिन का चंद्रमा देखने के लिए स्लाइड करें; कैलेंडर में किसी दिन पर टैप करने से भी वह चुना जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য দিনের চাঁদ দেখতে স্লাইড করুন; ক্যালেন্ডারে কোনো দিনে চাপলেও সেটি বাছা হয়।"
          }
        }
      }
    },
