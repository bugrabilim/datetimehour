    "cals.un.name": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "BM uluslararası günleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UN international days"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Internationale Tage der Vereinten Nationen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "BMT-nin beynəlxalq günləri"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأيام الدولية للأمم المتحدة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari internasional PBB"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اقوام متحدہ کے عالمی دن"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روزهای جهانی سازمان ملل"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journées internationales de l’ONU"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Международные дни ООН"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国連の国際デー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유엔 국제기념일"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联合国国际日"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga pandaigdigang araw ng UN"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันสากลของสหประชาชาติ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días internacionales de la ONU"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias internacionais da ONU"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संयुक्त राष्ट्र के अंतरराष्ट्रीय दिवस"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জাতিসংঘের আন্তর্জাতিক দিবস"
          }
        }
      }
    },
    "cals.un.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleşmiş Milletler'in ilan ettiği, dünyada en çok bilinen uluslararası günler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The best-known international days proclaimed by the United Nations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bekanntesten von den Vereinten Nationen ausgerufenen internationalen Tage."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Birləşmiş Millətlər Təşkilatının elan etdiyi, dünyada ən çox tanınan beynəlxalq günlər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أشهر الأيام الدولية التي أعلنتها الأمم المتحدة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari-hari internasional paling dikenal yang dicanangkan Perserikatan Bangsa-Bangsa."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اقوام متحدہ کے اعلان کردہ سب سے زیادہ معروف عالمی دن۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شناخته‌شده‌ترین روزهای جهانی که سازمان ملل متحد اعلام کرده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journées internationales les plus connues proclamées par les Nations Unies."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самые известные международные дни, провозглашенные Организацией Объединенных Наций."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国際連合が定めた、よく知られた国際デー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국제연합이 정한 가장 잘 알려진 국제기념일입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联合国宣布的最广为人知的国际日。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga pinakakilalang pandaigdigang araw na ipinahayag ng Nagkakaisang Bansa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันสากลที่เป็นที่รู้จักมากที่สุดซึ่งสหประชาชาติประกาศ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días internacionales más conocidos proclamados por las Naciones Unidas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias internacionais mais conhecidos proclamados pelas Nações Unidas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संयुक्त राष्ट्र द्वारा घोषित सबसे प्रसिद्ध अंतरराष्ट्रीय दिवस।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জাতিসংঘ ঘোষিত সবচেয়ে পরিচিত আন্তর্জাতিক দিবসগুলো।"
          }
        }
      }
    },
    "cals.un.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günler BM'nin uluslararası günler listesinden (un.org) seçilmiştir. Dünya Habitat Günü ekimin ilk pazartesi, Dünya Felsefe Günü kasımın üçüncü perşembesi kutlanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days are selected from the UN list of international days (un.org). World Habitat Day falls on the first Monday of October and World Philosophy Day on the third Thursday of November."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tage stammen aus der UN-Liste der internationalen Tage (un.org). Der Welt-Habitat-Tag fällt auf den ersten Montag im Oktober, der Welttag der Philosophie auf den dritten Donnerstag im November."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlər BMT-nin beynəlxalq günlər siyahısından (un.org) seçilib. Ümumdünya Habitat Günü oktyabrın ilk bazar ertəsi, Ümumdünya Fəlsəfə Günü noyabrın üçüncü cümə axşamı qeyd olunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيرت هذه الأيام من قائمة الأمم المتحدة للأيام الدولية (un.org). ويوافق اليوم العالمي للموئل أول يوم اثنين من تشرين الأول/أكتوبر، واليوم العالمي للفلسفة ثالث يوم خميس من تشرين الثاني/نوفمبر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari-hari ini dipilih dari daftar hari internasional PBB (un.org). Hari Habitat Dunia jatuh pada Senin pertama Oktober dan Hari Filsafat Sedunia pada Kamis ketiga November."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ دن اقوام متحدہ کی عالمی دنوں کی فہرست (un.org) سے منتخب کیے گئے ہیں۔ رہائش کا عالمی دن اکتوبر کے پہلے پیر اور فلسفے کا عالمی دن نومبر کی تیسری جمعرات کو منایا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این روزها از فهرست روزهای جهانی سازمان ملل (un.org) برگزیده شده‌اند. روز جهانی اسکان بشر نخستین دوشنبهٔ اکتبر و روز جهانی فلسفه سومین پنجشنبهٔ نوامبر است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journées sont choisies dans la liste des journées internationales de l’ONU (un.org). La Journée mondiale de l’habitat tombe le premier lundi d’octobre et la Journée mondiale de la philosophie le troisième jeudi de novembre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни выбраны из списка международных дней ООН (un.org). Всемирный день Хабитат отмечается в первый понедельник октября, Всемирный день философии — в третий четверг ноября."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国連の国際デー一覧（un.org）から選んでいます。世界ハビタット・デーは10月の第1月曜日、世界哲学デーは11月の第3木曜日です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유엔 국제기념일 목록(un.org)에서 골랐습니다. 세계 해비타트의 날은 10월 첫째 월요일, 세계 철학의 날은 11월 셋째 목요일입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国际日选自联合国国际日列表（un.org）。世界人居日为10月的第一个星期一，世界哲学日为11月的第三个星期四。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinili ang mga araw mula sa listahan ng UN ng mga pandaigdigang araw (un.org). Ang Pandaigdigang Araw ng Habitat ay sa unang Lunes ng Oktubre at ang Pandaigdigang Araw ng Pilosopiya ay sa ikatlong Huwebes ng Nobyembre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดเลือกจากรายชื่อวันสากลของสหประชาชาติ (un.org) วันที่อยู่อาศัยโลกตรงกับวันจันทร์แรกของเดือนตุลาคม และวันปรัชญาโลกตรงกับวันพฤหัสบดีที่สามของเดือนพฤศจิกายน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días se eligieron de la lista de días internacionales de la ONU (un.org). El Día Mundial del Hábitat es el primer lunes de octubre y el Día Mundial de la Filosofía, el tercer jueves de noviembre."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias foram escolhidos na lista de dias internacionais da ONU (un.org). O Dia Mundial do Habitat é na primeira segunda-feira de outubro e o Dia Mundial da Filosofia, na terceira quinta-feira de novembro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये दिवस संयुक्त राष्ट्र की अंतरराष्ट्रीय दिवसों की सूची (un.org) से चुने गए हैं। विश्व पर्यावास दिवस अक्टूबर के पहले सोमवार और विश्व दर्शन दिवस नवंबर के तीसरे गुरुवार को होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিনগুলো জাতিসংঘের আন্তর্জাতিক দিবসের তালিকা (un.org) থেকে বাছাই করা। বিশ্ব বসতি দিবস অক্টোবরের প্রথম সোমবার এবং বিশ্ব দর্শন দিবস নভেম্বরের তৃতীয় বৃহস্পতিবার পড়ে।"
          }
        }
      }
    },
