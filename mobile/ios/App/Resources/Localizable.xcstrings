    "perms.mic.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız \"sesli oku\" alarm görevinde, telefonun içinde dinlemek için. Ses kaydedilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for the \"read aloud\" alarm task, listening inside your phone. Nothing is recorded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für die Weckaufgabe „Laut vorlesen“, um direkt auf dem Telefon zuzuhören. Nichts wird aufgezeichnet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız \"səsli oxu\" tapşırığında, telefonun içində dinləmək üçün. Səs yazılmır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمهمة «اقرأ بصوت عالٍ» في المنبّه فقط، للاستماع داخل هاتفك. لا يُسجَّل أي صوت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk tugas alarm \"baca keras\", mendengarkan di dalam ponsel. Tidak ada yang direkam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف الارم کے «بلند آواز سے پڑھیں» کام کے لیے، فون کے اندر سننے کو۔ آواز ریکارڈ نہیں ہوتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط برای کار هشدار «بلند بخوانید»، شنیدن درون گوشی. صدایی ضبط نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour la tâche d'alarme « lire à voix haute », l'écoute se fait dans le téléphone. Rien n'est enregistré."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для задания будильника «прочитать вслух», распознавание внутри телефона. Ничего не записывается."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームの「声に出して読む」タスク専用で、端末の中で聞き取ります。音声は記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람의 '소리 내어 읽기' 과제에만, 휴대폰 안에서 듣는 데 써요. 녹음하지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于闹钟“大声朗读”任务，在手机内部识别，不会录音。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lang sa gawaing \"basahin nang malakas\" ng alarm, nakikinig sa loob ng telepono. Walang nirerekord."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เฉพาะภารกิจปลุก \"อ่านออกเสียง\" โดยฟังภายในโทรศัพท์ ไม่มีการบันทึกเสียง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para la tarea de alarma «leer en voz alta»; la escucha se hace en el propio teléfono. No se graba nada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para a tarefa de alarme \"ler em voz alta\", para ouvir você no próprio celular. O áudio não é gravado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ अलार्म के \"ज़ोर से पढ़ें\" काम के लिए, फ़ोन के अंदर सुनने को। आवाज़ रिकॉर्ड नहीं होती।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু \"জোরে পড়ুন\" অ্যালার্মের কাজের জন্য, ফোনের ভেতরেই শোনা হয়। কিছু রেকর্ড হয় না।"
          }
        }
      }
    },
