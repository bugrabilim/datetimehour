            "value": "تقويم Google"
          }
        }
      }
    },
    "google.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Takvimi'ndeki etkinlikleri burada görmek için Google hesabınızı iPhone'a bir kez eklemeniz yeterli. Uygulama Google'a doğrudan bağlanmaz ve şifrenizi görmez; takvimler iPhone üzerinden gelir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see your Google Calendar events here, add your Google account to your iPhone once. The app never connects to Google directly and never sees your password; calendars come through your iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Ihre Google-Kalender-Termine hier zu sehen, fügen Sie Ihr Google-Konto einmal zum iPhone hinzu. Die App verbindet sich nicht direkt mit Google und sieht Ihr Passwort nicht; die Kalender kommen über das iPhone."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Təqvimindəki tədbirləri burada görmək üçün Google hesabınızı iPhone-a bir dəfə əlavə etməyiniz kifayətdir. Tətbiq Google-a birbaşa qoşulmur və şifrənizi görmür; təqvimlər iPhone vasitəsilə gəlir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لرؤية أحداث تقويم Google هنا، يكفي أن تضيف حساب Google إلى iPhone مرة واحدة. لا يتصل التطبيق بـ Google مباشرة ولا يرى كلمة المرور؛ تصل التقويمات عبر iPhone."
          }
        }
      }
    },
    "google.stepsTitle": {
      "extractionState": "manual",
