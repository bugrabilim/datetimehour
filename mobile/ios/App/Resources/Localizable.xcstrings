    "notify.sound.adhanNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaktinde ezanın ilk cümlesi (\"Allahu Ekber, Allahu Ekber\") çalar; vakitten önceki bildirimlerde ve Güneş'te sesli duyuru çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At prayer time the first phrase of the adhan (\"Allāhu akbar, Allāhu akbar\") plays; notifications before the time and for sunrise use the spoken announcement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Gebetszeit erklingt der erste Satz des Adhan („Allāhu akbar, Allāhu akbar“); Benachrichtigungen vor der Zeit und zum Sonnenaufgang nutzen die gesprochene Ansage."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtında azanın ilk cümləsi (\"Allahu Əkbər, Allahu Əkbər\") səslənir; vaxtdan əvvəlki bildirişlərdə və Günəş vaxtında səsli elan səslənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند دخول الوقت تُسمع أول جملة من الأذان («الله أكبر، الله أكبر»)؛ وتستخدم الإشعارات قبل الوقت وعند الشروق الإعلانَ الصوتي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepat waktu salat, kalimat pertama azan (\"Allāhu akbar, Allāhu akbar\") diputar; notifikasi sebelum waktu dan untuk matahari terbit memakai pengumuman suara."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز کے وقت اذان کا پہلا جملہ («اللہ اکبر، اللہ اکبر») سنائی دیتا ہے؛ وقت سے پہلے کی اور طلوعِ آفتاب کی اطلاعات میں زبانی اعلان استعمال ہوتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سر وقت نماز جملهٔ نخست اذان («اللّه اکبر، اللّه اکبر») پخش می‌شود؛ اعلان‌های پیش از وقت و طلوع آفتاب با اعلام گفتاری‌اند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’heure de la prière, la première phrase de l’adhan (« Allāhu akbar, Allāhu akbar ») est jouée ; les notifications avant l’heure et pour le lever du soleil utilisent l’annonce vocale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В момент намаза звучит первая фраза азана («Аллаху акбар, Аллаху акбар»); для уведомлений заранее и о восходе используется голосовое объявление."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拝時刻にはアザーンの最初の一節（「アッラーフ・アクバル、アッラーフ・アクバル」）が流れます。時刻前の通知と日の出には音声のお知らせを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도 시간에는 아잔의 첫 구절(\"알라후 아크바르, 알라후 아크바르\")이 나옵니다. 기도 시간 전 알림과 일출에는 음성 안내를 씁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拜时间到时播放宣礼的第一句（“安拉乎艾克拜尔，安拉乎艾克拜尔”）；提前通知和日出使用语音播报。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa oras ng dasal, tumutugtog ang unang parirala ng adhan (\"Allāhu akbar, Allāhu akbar\"); pasalitang anunsiyo ang gamit sa mga abiso bago ang oras at sa pagsikat ng araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อถึงเวลาละหมาด จะเล่นท่อนแรกของอะซาน (\"อัลลอฮุอักบัร อัลลอฮุอักบัร\") ส่วนการแจ้งเตือนก่อนถึงเวลาและการแจ้งเตือนเวลาดวงอาทิตย์ขึ้นจะใช้การประกาศด้วยเสียงพูด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la hora de la oración suena la primera frase del adhan (\"Allāhu akbar, Allāhu akbar\"); las notificaciones previas y la de la salida del sol usan el aviso hablado."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No horário da oração toca a primeira frase do adhan (\"Allāhu akbar, Allāhu akbar\"); as notificações antecipadas e a do nascer do sol usam o aviso falado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमाज़ के समय अज़ान का पहला वाक्य (\"अल्लाहु अकबर, अल्लाहु अकबर\") बजता है; समय से पहले की और सूर्योदय की सूचनाओं में बोली गई घोषणा होती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজের সময়ে আজানের প্রথম বাক্য (\"আল্লাহু আকবার, আল্লাহু আকবার\") বাজে; সময়ের আগের ও সূর্যোদয়ের নোটিফিকেশনে কণ্ঠ ঘোষণা ব্যবহৃত হয়।"
          }
        }
      }
    },
