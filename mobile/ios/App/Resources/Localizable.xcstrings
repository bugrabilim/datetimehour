    "cals.buddhist.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tayland ay takvimine göre Budist bayramları ve uposatha günleri: Magha Puja, Vesak, Asalha Puja ve Vassa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buddhist holy days and uposatha days by the Thai lunar calendar: Magha Puja, Vesak, Asalha Puja and Vassa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buddhistische Feiertage und Uposatha-Tage nach dem thailändischen Mondkalender: Magha Puja, Vesakh, Asalha Puja und Vassa."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailand ay təqviminə görə Buddist bayramları və uposatha günləri: Maqha Puca, Vesak, Asalha Puca və Vassa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأعياد البوذية وأيام الأوبوساثا وفق التقويم القمري التايلندي: ماغا بوجا وفيساك وأسالها بوجا وفاسا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari raya Buddha dan hari uposatha menurut kalender lunar Thailand: Magha Puja, Waisak, Asadha, dan Vassa."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تھائی قمری کیلنڈر کے مطابق بدھ مت کے تہوار اور اپوستھ کے دن: ماگھا پوجا، ویساک، آسالھا پوجا اور وسّا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جشن‌های بودایی و روزهای اوپوساتا بر پایهٔ تقویم قمری تایلند: ماگا پوجا، ویساک، آسالها پوجا و واسا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fêtes bouddhiques et jours d’uposatha selon le calendrier lunaire thaï : Magha Puja, Vesak, Asalha Puja et Vassa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буддийские праздники и дни упосатхи по тайскому лунному календарю: Магха-пуджа, Весак, Асалха-пуджа и Васса."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイ太陰暦による仏教の祝祭日と布薩日：マーカ・ブーチャ、ウェーサーカ祭、アーサーラハ・ブーチャ、安居。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태국 음력에 따른 불교 명절과 포살일: 마가 푸자, 베삭, 아살하 푸자, 안거."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按泰国阴历的佛教节日和布萨日：万佛节、卫塞节、三宝节和守夏安居。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga pista at araw ng uposatha ng Budismo ayon sa lunar na kalendaryo ng Thailand: Magha Puja, Vesak, Asalha Puja at Vassa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันสำคัญทางพระพุทธศาสนาและวันพระตามปฏิทินจันทรคติไทย: มาฆบูชา วิสาขบูชา อาสาฬหบูชา เข้าพรรษา และออกพรรษา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiestas budistas y días de uposatha según el calendario lunar tailandés: Magha Puja, Vesak, Asalha Puja y Vassa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Festas budistas e dias de uposatha segundo o calendário lunar tailandês: Magha Puja, Vesak, Asalha Puja e Vassa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थाई चंद्र पंचांग के अनुसार बौद्ध पर्व और उपोसथ के दिन: माघ पूजा, वेसाक, आषाढ़ पूजा और वर्षावास।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "থাই চান্দ্র ক্যালেন্ডার অনুযায়ী বৌদ্ধ পবিত্র দিন ও উপোসথ দিন: মাঘী পূর্ণিমা, বৈশাখী পূর্ণিমা (বুদ্ধ পূর্ণিমা), আষাঢ়ী পূর্ণিমা ও বর্ষাবাস।"
          }
        }
      }
    },
    "cals.buddhist.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarihler Tayland ay takviminin geleneksel hesabındandır (Tayland resmî tarihleri her yıl ilan eder, 2027'den sonraki yıllar hesaptır); uposatha günleri astronomik Ay evresinden bir gün farklı olabilir. Sri Lanka, Myanmar ve diğer ülkelerde bayram bir ay, Budist yılı bir yıl farklı olabilir; BM, Vesak'ı Mayıs dolunayında anar. Temmuz 2030 ile Temmuz 2032 arasındaki tarihler, artık günün hangi yıla konacağına göre bir gün erken olabilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates follow the traditional reckoning of the Thai lunar calendar (Thailand announces the official dates each year, so years after 2027 are calculated); uposatha days may differ by a day from the astronomical moon phase. In Sri Lanka, Myanmar and elsewhere a festival may fall a month apart and the Buddhist year may differ by one; the UN marks Vesak at the full moon of May. Between July 2030 and July 2032 the dates may be one day earlier, depending on the year the extra day is added."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten folgen der traditionellen Berechnung des thailändischen Mondkalenders (Thailand gibt die amtlichen Daten jedes Jahr bekannt, Jahre nach 2027 sind berechnet); Uposatha-Tage können um einen Tag von der astronomischen Mondphase abweichen. In Sri Lanka, Myanmar und anderen Ländern kann ein Fest einen Monat und das buddhistische Jahr um eins abweichen; die Vereinten Nationen begehen Vesakh am Vollmond im Mai. Zwischen Juli 2030 und Juli 2032 können die Daten einen Tag früher liegen, je nachdem, in welchem Jahr der zusätzliche Tag eingefügt wird."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarixlər Tailand ay təqviminin ənənəvi hesabındandır (Tailand rəsmi tarixləri hər il elan edir, 2027-ci ildən sonrakı illər hesablamadır); uposatha günləri astronomik Ay fazasından bir gün fərqlənə bilər. Şri-Lanka, Myanma və digər ölkələrdə bayram bir ay, Buddist ili isə bir il fərqli ola bilər; BMT Vesakı may ayının bədrində qeyd edir. 2030-cu ilin iyulu ilə 2032-ci ilin iyulu arasındakı tarixlər əlavə günün hansı ilə qoyulmasından asılı olaraq bir gün tez ola bilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التواريخ مأخوذة من الحساب التقليدي للتقويم القمري التايلندي (تعلن تايلاند التواريخ الرسمية كل عام، والسنوات بعد 2027 محسوبة)، وقد تختلف أيام الأوبوساثا يومًا عن طور القمر الفلكي. وقد يختلف العيد شهرًا والسنة البوذية سنةً في سريلانكا وميانمار وغيرهما، وتحيي الأمم المتحدة يوم فيساك في بدر شهر مايو. قد تكون التواريخ بين يوليو 2030 ويوليو 2032 أبكر بيوم واحد، بحسب السنة التي يُضاف فيها اليوم الزائد."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal mengikuti perhitungan tradisional kalender lunar Thailand (Thailand mengumumkan tanggal resmi setiap tahun, tahun-tahun setelah 2027 merupakan hasil hitungan); hari uposatha bisa berbeda sehari dari fase bulan astronomis. Di Sri Lanka, Myanmar, dan negara lain hari raya bisa berbeda sebulan dan tahun Buddhis berbeda satu tahun; PBB memperingati Waisak pada purnama bulan Mei. Tanggal antara Juli 2030 dan Juli 2032 bisa satu hari lebih awal, tergantung pada tahun penambahan hari tambahan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخیں تھائی قمری کیلنڈر کے روایتی حساب سے ہیں (تھائی لینڈ ہر سال سرکاری تاریخوں کا اعلان کرتا ہے، 2027 کے بعد کے سال حساب پر مبنی ہیں)؛ اپوستھ کے دن فلکیاتی چاند کے مرحلے سے ایک دن مختلف ہو سکتے ہیں۔ سری لنکا، میانمار اور دوسرے ممالک میں تہوار ایک مہینہ اور بدھ سال ایک سال مختلف ہو سکتا ہے؛ اقوام متحدہ ویساک مئی کے پورے چاند پر مناتی ہے۔ جولائی 2030 سے جولائی 2032 تک کی تاریخیں ایک دن پہلے ہو سکتی ہیں، اس پر منحصر ہے کہ اضافی دن کس سال میں رکھا جائے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ‌ها از محاسبهٔ سنتی تقویم قمری تایلند است (تایلند تاریخ‌های رسمی را هر سال اعلام می‌کند و سال‌های پس از 2027 محاسبه‌شده‌اند)؛ روزهای اوپوساتا ممکن است یک روز با اهلّهٔ نجومی ماه فرق داشته باشند. در سری‌لانکا، میانمار و کشورهای دیگر جشن ممکن است یک ماه و سال بودایی یک سال متفاوت باشد؛ سازمان ملل ویساک را در ماه کامل ماه مه گرامی می‌دارد. تاریخ‌های میان ژوئیهٔ 2030 و ژوئیهٔ 2032 بسته به سالی که روز افزوده در آن گذاشته شود ممکن است یک روز زودتر باشند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates suivent le calcul traditionnel du calendrier lunaire thaï (la Thaïlande annonce les dates officielles chaque année ; les années après 2027 sont calculées) ; les jours d’uposatha peuvent différer d’un jour de la phase astronomique de la Lune. Au Sri Lanka, en Birmanie et ailleurs, une fête peut tomber à un mois d’écart et l’année bouddhique différer d’un an ; l’ONU célèbre le Vesak à la pleine lune de mai. Entre juillet 2030 et juillet 2032, les dates peuvent avancer d'un jour selon l'année où le jour supplémentaire est ajouté."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даты рассчитаны по традиционным правилам тайского лунного календаря (Таиланд ежегодно объявляет официальные даты, годы после 2027 рассчитаны); дни упосатхи могут на день расходиться с астрономической фазой Луны. В Шри-Ланке, Мьянме и других странах праздник может отличаться на месяц, а буддийский год — на единицу; ООН отмечает Весак в полнолуние мая. С июля 2030 по июль 2032 года даты могут быть на день раньше — в зависимости от того, в какой год добавят дополнительный день."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付はタイ太陰暦の伝統的な計算によるもので（タイは公式の日付を毎年発表し、2027年より後は計算値）、布薩日は天文学上の月相と1日ずれることがあります。スリランカやミャンマーなどでは祭日が1か月、仏暦が1年異なることがあり、国連はウェーサーカ祭を5月の満月に記念します。2030年7月から2032年7月までの日付は、追加の1日をどの年に入れるかによって1日早くなる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜는 태국 음력의 전통 계산을 따르며(태국은 매년 공식 날짜를 발표하고 2027년 이후는 계산값), 포살일은 천문학적 달의 위상과 하루 차이 날 수 있습니다. 스리랑카, 미얀마 등에서는 명절이 한 달, 불기가 1년 다를 수 있으며 유엔은 5월 보름에 베삭을 기념합니다. 2030년 7월부터 2032년 7월까지의 날짜는 추가되는 하루를 어느 해에 넣느냐에 따라 하루 빠를 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期按泰国阴历的传统算法得出（泰国每年公布正式日期，2027年以后为推算），布萨日可能与天文月相相差一天。斯里兰卡、缅甸等地的节日可能相差一个月，佛历年份可能相差一年；联合国在5月满月纪念卫塞节。2030年7月至2032年7月的日期可能因增加一天的年份不同而提前一天。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga petsa ay mula sa tradisyonal na pagkalkula ng lunar na kalendaryo ng Thailand (taon-taong inihahayag ng Thailand ang opisyal na petsa, kaya kalkulado ang mga taon pagkaraan ng 2027); maaaring magkaiba nang isang araw ang mga araw ng uposatha sa astronomikong yugto ng buwan. Sa Sri Lanka, Myanmar at iba pang bansa, maaaring magkaiba nang isang buwan ang pista at nang isang taon ang taong Budista; ginugunita ng UN ang Vesak sa kabilugan ng buwan ng Mayo. Ang mga petsa mula Hulyo 2030 hanggang Hulyo 2032 ay maaaring mas maaga nang isang araw, depende kung anong taon idaragdag ang dagdag na araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่คำนวณตามหลักปฏิทินจันทรคติไทยแบบดั้งเดิม (ทางราชการประกาศวันที่เป็นทางการทุกปี ปีหลัง พ.ศ. 2570 เป็นการคำนวณ) วันพระอาจคลาดจากดิถีจันทร์จริงทางดาราศาสตร์หนึ่งวัน ศรีลังกา เมียนมา และประเทศอื่นอาจกำหนดวันสำคัญต่างไปหนึ่งเดือนและนับพุทธศักราชต่างไปหนึ่งปี ส่วนสหประชาชาติจัดวันวิสาขบูชาในวันเพ็ญเดือนพฤษภาคม วันที่ระหว่างเดือนกรกฎาคม พ.ศ. 2573 ถึงเดือนกรกฎาคม พ.ศ. 2575 อาจเร็วขึ้นหนึ่งวัน ขึ้นอยู่กับว่าจะเพิ่มอธิกวารในปีใด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas siguen el cálculo tradicional del calendario lunar tailandés (Tailandia anuncia las fechas oficiales cada año; los años posteriores a 2027 son calculados); los días de uposatha pueden diferir un día de la fase astronómica de la Luna. En Sri Lanka, Myanmar y otros países una fiesta puede diferir un mes y el año budista uno; la ONU conmemora el Vesak en la luna llena de mayo. Entre julio de 2030 y julio de 2032 las fechas pueden adelantarse un día, según el año en que se añada el día adicional."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas seguem o cálculo tradicional do calendário lunar tailandês (a Tailândia anuncia as datas oficiais a cada ano; os anos após 2027 são calculados); os dias de uposatha podem diferir um dia da fase astronômica da Lua. No Sri Lanka, em Mianmar e em outros países, uma festa pode diferir um mês e o ano budista, um ano; a ONU celebra o Vesak na lua cheia de maio. Entre julho de 2030 e julho de 2032, as datas podem cair um dia antes, conforme o ano em que o dia extra for acrescentado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिथियाँ थाई चंद्र पंचांग की पारंपरिक गणना से हैं (थाईलैंड हर साल आधिकारिक तिथियाँ घोषित करता है, 2027 के बाद के वर्ष गणना हैं); उपोसथ के दिन खगोलीय चंद्र कला से एक दिन अलग हो सकते हैं। श्रीलंका, म्यांमार और अन्य देशों में पर्व एक महीना और बौद्ध वर्ष एक साल अलग हो सकता है; संयुक्त राष्ट्र वेसाक मई की पूर्णिमा को मनाता है। जुलाई 2030 से जुलाई 2032 के बीच की तारीखें एक दिन पहले हो सकती हैं, यह इस पर निर्भर है कि अतिरिक्त दिन किस वर्ष जोड़ा जाए।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তারিখগুলো থাই চান্দ্র ক্যালেন্ডারের প্রচলিত গণনা অনুসরণ করে (থাইল্যান্ড প্রতি বছর সরকারি তারিখ ঘোষণা করে, তাই 2027-এর পরের বছরগুলো হিসাব করা); উপোসথ দিন জ্যোতির্বিজ্ঞানের চাঁদের দশা থেকে এক দিন আলাদা হতে পারে। শ্রীলঙ্কা, মিয়ানমার ও অন্যত্র কোনো উৎসব এক মাস আলাদা পড়তে পারে এবং বৌদ্ধ বছর এক বছর আলাদা হতে পারে; জাতিসংঘ মে মাসের পূর্ণিমায় বৈশাখ দিবস পালন করে। জুলাই 2030 থেকে জুলাই 2032-এর মধ্যে, অতিরিক্ত দিন কোন বছরে যোগ হয় তার ওপর নির্ভর করে, তারিখগুলো এক দিন আগে হতে পারে।"
          }
        }
      }
    },
