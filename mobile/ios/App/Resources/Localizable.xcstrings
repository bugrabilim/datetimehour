    "account.badgesNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozetleriniz hesabınızda saklanır; hesabınızı silince silinir, yedeklerden en geç 30 gün içinde düşer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your badges are stored in your account; they are deleted when you delete your account and drop out of backups within 30 days at the latest."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Abzeichen werden in Ihrem Konto gespeichert; sie werden mit dem Konto gelöscht und fallen spätestens nach 30 Tagen aus den Sicherungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nişanlarınız hesabınızda saxlanılır; hesabı silincə silinir, ehtiyat nüsxələrdən ən gec 30 gün ərzində çıxır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ شاراتك في حسابك؛ تُحذف بحذف الحساب وتخرج من النسخ الاحتياطية خلال 30 يومًا على الأكثر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lencana Anda disimpan di akun Anda; lencana dihapus saat akun dihapus dan hilang dari cadangan paling lambat dalam 30 hari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے بیج آپ کے اکاؤنٹ میں محفوظ ہوتے ہیں؛ اکاؤنٹ حذف کرنے پر حذف ہو جاتے ہیں اور زیادہ سے زیادہ 30 دن میں بیک اپ سے نکل جاتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشان‌های شما در حسابتان نگه داشته می‌شود؛ با پاک کردن حساب پاک می‌شود و حداکثر ظرف 30 روز از پشتیبان‌ها هم حذف می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos badges sont conservés dans votre compte ; ils sont supprimés avec le compte et disparaissent des sauvegardes en 30 jours au plus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значки хранятся в вашем аккаунте; они удаляются вместе с аккаунтом и исчезают из резервных копий не позднее чем через 30 дней."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッジはアカウントに保存されます。アカウントを削除すると削除され、遅くとも30日以内にバックアップからも消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배지는 계정에 저장됩니다. 계정을 삭제하면 함께 삭제되고 늦어도 30일 안에 백업에서도 사라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "徽章保存在您的账户中；删除账户时会一并删除，并最迟在 30 天内从备份中移除。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakatago sa inyong account ang mga badge; nabubura ang mga ito kasabay ng account at naaalis sa mga backup sa loob ng 30 araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหรียญตราเก็บไว้ในบัญชีของคุณ จะถูกลบพร้อมบัญชีและหายจากข้อมูลสำรองภายใน 30 วัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus insignias se guardan en su cuenta; se borran con la cuenta y desaparecen de las copias de seguridad en 30 días como máximo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus selos ficam guardados na sua conta; são apagados junto com a conta e saem dos backups em até 30 dias."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बैज आपके खाते में रखे जाते हैं; खाता मिटाने पर मिट जाते हैं और ज़्यादा से ज़्यादा 30 दिन में बैकअप से भी हट जाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ব্যাজ আপনার অ্যাকাউন্টে রাখা হয়; অ্যাকাউন্ট মুছলে মুছে যায় এবং সর্বোচ্চ 30 দিনের মধ্যে ব্যাকআপ থেকেও সরে যায়।"
          }
        }
      }
    },
    "account.badgesNone": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz rozet yok. Rozetler telefon uygulamasında kazanılır."
          }
        },
        "en": {
          "stringUnit": {
