    "list.popupTitle": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta listesi aydınlatma metni"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email list privacy notice"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutzhinweis zur E-Mail-Liste"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poçt siyahısı üzrə məlumatlandırma mətni"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار الخصوصية للقائمة البريدية"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan privasi daftar email"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ای میل فہرست کا رازداری نوٹس"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعیهٔ حریم خصوصی فهرست ایمیل"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Information sur la liste de diffusion"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомление о рассылке"
          }
        }
      }
    },
    "list.popupText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta adresiniz, yalnızca bu listeye abone edilmeniz için Bumba Teknoloji Limited Şirketi tarafından işlenir. İstediğiniz zaman tek tıkla ayrılabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email address is processed by Bumba Teknoloji Limited Şirketi only to subscribe you to this list. You can unsubscribe at any time with one click."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre E-Mail-Adresse wird von Bumba Teknoloji Limited Şirketi ausschließlich verarbeitet, um Sie in diese Liste einzutragen. Sie können sich jederzeit mit einem Klick abmelden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poçt ünvanınız yalnız bu siyahıya abunə olmağınız üçün Bumba Teknoloji Limited Şirketi tərəfindən emal olunur. İstədiyiniz vaxt bir kliklə ayrıla bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعالج شركة Bumba Teknoloji Limited Şirketi عنوان بريدك الإلكتروني فقط لاشتراكك في هذه القائمة. يمكنك إلغاء الاشتراك في أي وقت بنقرة واحدة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat email Anda diproses oleh Bumba Teknoloji Limited Şirketi hanya untuk mendaftarkan Anda ke daftar ini. Anda dapat berhenti berlangganan kapan saja dengan satu klik."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ای میل پتہ Bumba Teknoloji Limited Şirketi صرف آپ کو اس فہرست میں شامل کرنے کے لیے استعمال کرتی ہے۔ آپ کسی بھی وقت ایک کلک سے رکنیت ختم کر سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشانی ایمیل شما را Bumba Teknoloji Limited Şirketi فقط برای عضویت شما در این فهرست پردازش می‌کند. هر زمان بخواهید با یک کلیک می‌توانید لغو اشتراک کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre adresse e-mail est traitée par Bumba Teknoloji Limited Şirketi uniquement pour vous inscrire à cette liste. Vous pouvez vous désinscrire à tout moment en un clic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш адрес электронной почты обрабатывает Bumba Teknoloji Limited Şirketi только для подписки на эту рассылку. Отписаться можно в любой момент одним нажатием."
          }
        }
      }
    },
    "list.readNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aydınlatma metnini oku"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the privacy notice"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutzhinweis lesen"
