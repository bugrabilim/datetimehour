          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud کے ساتھ ہم آہنگی"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همگام‌سازی با iCloud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser avec iCloud"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация с iCloud"
          }
        }
      }
    },
    "sync.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarınız, dünya saatleri, geri sayımlar, kayıtlı yerler, pomodoro ve uyku kayıtları ile ibadet kayıtları aynı Apple hesabındaki iPhone, iPad ve Mac'inizde eşitlenir. Veri iCloud hesabınızda durur, bize gelmez. Konum, alarmlar, süren sayaçlar, bildirim ayarları, rozetler ve fotoğraflar her cihazda ayrıdır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings, world clocks, countdowns, saved places, pomodoro and sleep records and worship records are synced across the iPhone, iPad and Mac signed in to the same Apple Account. The data stays in your iCloud account and never reaches us. Location, alarms, running timers, notification settings, badges and photos stay separate on each device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Einstellungen, Weltuhren, Countdowns, gespeicherten Orte, Pomodoro- und Schlafdaten sowie Gottesdienst-Einträge werden zwischen iPhone, iPad und Mac mit demselben Apple-Account synchronisiert. Die Daten bleiben in Ihrem iCloud-Account und erreichen uns nie. Standort, Wecker, laufende Timer, Mitteilungseinstellungen, Abzeichen und Fotos bleiben auf jedem Gerät getrennt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarınız, dünya saatları, geri sayımlar, saxlanmış yerlər, pomodoro və yuxu qeydləri, eləcə də ibadət qeydləri eyni Apple hesabındakı iPhone, iPad və Mac-da sinxronlaşdırılır. Məlumat iCloud hesabınızda qalır, bizə gəlmir. Məkan, zəngli saatlar, işləyən sayğaclar, bildiriş ayarları, nişanlar və fotolar hər cihazda ayrıdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُزامَن إعداداتك وساعات العالم والعدّ التنازلي والأماكن المحفوظة وسجلات بومودورو والنوم وسجلات العبادة بين أجهزة iPhone وiPad وMac المسجّلة بحساب Apple نفسه. تبقى البيانات في حساب iCloud الخاص بك ولا تصل إلينا. الموقع والمنبهات والمؤقتات الجارية وإعدادات الإشعارات والشارات والصور تبقى منفصلة على كل جهاز."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan, jam dunia, hitung mundur, tempat tersimpan, catatan pomodoro dan tidur, serta catatan ibadah Anda disinkronkan antara iPhone, iPad, dan Mac yang masuk dengan Akun Apple yang sama. Data tetap di akun iCloud Anda dan tidak pernah sampai ke kami. Lokasi, alarm, pengatur waktu yang berjalan, pengaturan notifikasi, lencana, dan foto tetap terpisah di tiap perangkat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ترتیبات، عالمی گھڑیاں، الٹی گنتیاں، محفوظ مقامات، پومودورو اور نیند کے ریکارڈ اور عبادت کے ریکارڈ ایک ہی Apple اکاؤنٹ والے آئی فون، آئی پیڈ اور میک میں ہم آہنگ ہوتے ہیں۔ ڈیٹا آپ کے iCloud اکاؤنٹ میں رہتا ہے اور کبھی ہم تک نہیں پہنچتا۔ مقام، الارم، چلتے ٹائمر، اطلاعات کی ترتیبات، بیجز اور تصاویر ہر آلے پر الگ رہتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات، ساعت‌های جهانی، شمارش‌های معکوس، مکان‌های ذخیره‌شده، سوابق پومودورو و خواب و سوابق عبادت شما میان آیفون، آیپد و مکِ واردشده با یک حساب Apple همگام می‌شوند. داده‌ها در حساب iCloud شما می‌مانند و هرگز به ما نمی‌رسند. موقعیت، هشدارها، تایمرهای در حال کار، تنظیمات اعلان، نشان‌ها و عکس‌ها برای هر دستگاه جدا می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réglages, horloges mondiales, comptes à rebours, lieux enregistrés, données pomodoro et sommeil et données de culte sont synchronisés entre l’iPhone, l’iPad et le Mac connectés au même compte Apple. Les données restent dans votre compte iCloud et ne nous parviennent jamais. La position, les alarmes, les minuteurs en cours, les réglages de notification, les badges et les photos restent propres à chaque appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки, мировые часы, обратные отсчёты, сохранённые места, записи помидора и сна, а также записи ибадата синхронизируются между iPhone, iPad и Mac с одним Аккаунтом Apple. Данные остаются в вашем iCloud и не попадают к нам. Местоположение, будильники, запущенные таймеры, настройки уведомлений, значки и фото на каждом устройстве свои."
          }
        }
      }
    },
    "sync.androidTitle": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek ve yeni telefon"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup and new phone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherung und neues Telefon"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehtiyat nüsxə və yeni telefon"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ الاحتياطي والهاتف الجديد"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan dan ponsel baru"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بیک اپ اور نیا فون"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پشتیبان و گوشی تازه"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde et nouveau téléphone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия и новый телефон"
          }
        }
      }
    },
    "sync.androidNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarınız ve kayıtlarınız (dünya saatleri, geri sayımlar, alarmlar, pomodoro, uyku ve ibadet kayıtları, fotoğraflar) telefonun Google yedeği açıksa Google hesabınızdaki yedeğe girer ve yeni telefona geçerken ya da uygulamayı yeniden kurunca geri yüklenir. Bu yedeği Google yönetir; bize bir şey gelmez. Telefon Ayarları › Google › Yedekleme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your phone's Google backup is on, your settings and records (world clocks, countdowns, alarms, pomodoro, sleep and worship records, photos) go into the backup in your Google Account and are restored when you move to a new phone or reinstall the app. Google manages this backup; nothing reaches us. Phone Settings › Google › Backup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist die Google-Sicherung des Telefons aktiv, landen Ihre Einstellungen und Einträge (Weltuhren, Countdowns, Wecker, Pomodoro-, Schlaf- und Gottesdienst-Einträge, Fotos) in der Sicherung Ihres Google-Kontos und werden beim Wechsel auf ein neues Telefon oder bei Neuinstallation wiederhergestellt. Diese Sicherung verwaltet Google; uns erreicht nichts. Telefoneinstellungen › Google › Sicherung."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun Google ehtiyat nüsxəsi açıqdırsa, ayarlarınız və qeydləriniz (dünya saatları, geri sayımlar, zəngli saatlar, pomodoro, yuxu və ibadət qeydləri, fotolar) Google hesabınızdakı ehtiyat nüsxəyə düşür və yeni telefona keçəndə ya tətbiqi yenidən quranda bərpa olunur. Bu ehtiyat nüsxəni Google idarə edir; bizə heç nə gəlmir. Telefon Ayarları › Google › Ehtiyat nüsxə."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان النسخ الاحتياطي من Google مفعّلًا في هاتفك، تدخل إعداداتك وسجلاتك (ساعات العالم والعدّ التنازلي والمنبهات وسجلات بومودورو والنوم والعبادة والصور) في النسخة الاحتياطية بحساب Google وتُستعاد عند الانتقال إلى هاتف جديد أو إعادة تثبيت التطبيق. تدير Google هذه النسخة ولا يصل إلينا شيء. إعدادات الهاتف › Google › النسخ الاحتياطي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika cadangan Google di ponsel aktif, pengaturan dan catatan Anda (jam dunia, hitung mundur, alarm, pomodoro, tidur dan ibadah, foto) masuk ke cadangan di Akun Google Anda dan dipulihkan saat Anda pindah ke ponsel baru atau memasang ulang aplikasi. Google yang mengelola cadangan ini; tidak ada yang sampai ke kami. Setelan ponsel › Google › Cadangan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر فون کا گوگل بیک اپ آن ہو تو آپ کی ترتیبات اور ریکارڈ (عالمی گھڑیاں، الٹی گنتیاں، الارم، پومودورو، نیند اور عبادت کے ریکارڈ، تصاویر) آپ کے گوگل اکاؤنٹ کے بیک اپ میں جاتے ہیں اور نئے فون یا ایپ دوبارہ انسٹال کرنے پر بحال ہوتے ہیں۔ یہ بیک اپ گوگل سنبھالتا ہے؛ ہم تک کچھ نہیں پہنچتا۔ فون کی ترتیبات › Google › بیک اپ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر پشتیبان‌گیری گوگل گوشی روشن باشد، تنظیمات و سوابق شما (ساعت‌های جهانی، شمارش‌های معکوس، هشدارها، پومودورو، خواب و عبادت، عکس‌ها) در پشتیبان حساب گوگل شما قرار می‌گیرند و هنگام رفتن به گوشی تازه یا نصب دوبارهٔ برنامه بازگردانده می‌شوند. این پشتیبان را گوگل مدیریت می‌کند؛ چیزی به ما نمی‌رسد. تنظیمات گوشی › Google › پشتیبان‌گیری."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la sauvegarde Google du téléphone est activée, vos réglages et données (horloges mondiales, comptes à rebours, alarmes, pomodoro, sommeil, culte, photos) sont inclus dans la sauvegarde de votre compte Google et restaurés quand vous changez de téléphone ou réinstallez l’app. Google gère cette sauvegarde ; rien ne nous parvient. Paramètres du téléphone › Google › Sauvegarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если на телефоне включено резервное копирование Google, настройки и записи (мировые часы, обратные отсчёты, будильники, помидор, сон, ибадат, фото) попадают в копию в вашем аккаунте Google и восстанавливаются на новом телефоне или после переустановки. Этой копией управляет Google; к нам ничего не попадает. Настройки телефона › Google › Резервное копирование."
          }
        }
      }
    },
