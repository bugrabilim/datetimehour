        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: the Sun is below the horizon during the eclipse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Die Sonne steht während der Finsternis unter dem Horizont."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: tutulma zamanı Günəş üfüqün altındadır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: الشمس تحت الأفق أثناء الكسوف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Matahari di bawah cakrawala saat gerhana."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: گرہن کے دوران سورج افق سے نیچے ہے۔"
