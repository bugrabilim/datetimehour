    "widget.styleNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget'a uzun basıp Düzenle'den görünüm, yazı tipi ve çerçeve seçilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press the widget and choose Edit to pick a style, font and frame."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget lange drücken und „Bearbeiten“ wählen, um Stil, Schrift und Rahmen festzulegen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidcetə uzun basıb Redaktə et ilə görünüş, şrift və çərçivə seçilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على الأداة واختر تعديل لاختيار النمط والخط والإطار."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama widget lalu pilih Edit untuk memilih gaya, jenis huruf, dan bingkai."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ویجیٹ کو دیر تک دبائیں اور ترمیم سے انداز، فونٹ اور فریم چنیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویجت را نگه دارید و با ویرایش، سبک، قلم و قاب را انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur le widget puis Modifier pour choisir le style, la police et le cadre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на виджет и удерживайте, затем «Изменить», чтобы выбрать стиль, шрифт и рамку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットを長押しして「編集」から、スタイル・フォント・フレームを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯을 길게 누르고 편집에서 스타일, 글꼴, 테두리를 고릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按小组件并选择“编辑”，即可选择样式、字体和边框。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindutin nang matagal ang widget at piliin ang Edit para pumili ng estilo, font at frame."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดค้างที่วิดเจ็ตแล้วเลือกแก้ไข เพื่อเลือกสไตล์ แบบอักษร และกรอบ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga pulsado el widget y elija Editar para escoger estilo, tipo de letra y marco."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure o widget e escolha Editar para definir estilo, fonte e moldura."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शैली, फ़ॉन्ट और फ़्रेम चुनने के लिए विजेट को दबाकर रखें और संपादित करें चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধরন, ফন্ট ও ফ্রেম বাছতে উইজেটে চেপে ধরে সম্পাদনা বাছুন।"
          }
        }
      }
    },
