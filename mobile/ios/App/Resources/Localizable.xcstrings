    "qibla.mapNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çizgi, bulunduğunuz yerden Kâbe'ye en kısa yoldur (büyük daire). Harita çizimi telefonda yapılır, hiçbir servise gidilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line is the shortest path from your location to the Kaaba (great circle). The map is drawn on the phone; no service is contacted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Linie ist der kürzeste Weg von Ihrem Standort zur Kaaba (Großkreis). Die Karte wird auf dem Telefon gezeichnet, kein Dienst wird kontaktiert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xətt olduğunuz yerdən Kəbəyə ən qısa yoldur (böyük dairə). Xəritə telefonda çəkilir, heç bir xidmətə müraciət edilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخط هو أقصر طريق من موقعك إلى الكعبة (دائرة عظمى). تُرسم الخريطة على الهاتف دون الاتصال بأي خدمة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Garis ini adalah jalur terpendek dari lokasi Anda ke Ka'bah (lingkaran besar). Peta digambar di ponsel, tanpa menghubungi layanan apa pun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ لکیر آپ کے مقام سے کعبہ تک مختصر ترین راستہ ہے (عظیم دائرہ)۔ نقشہ فون پر بنتا ہے، کسی سروس سے رابطہ نہیں ہوتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این خط کوتاه‌ترین مسیر از مکان شما تا کعبه است (دایره عظیمه). نقشه روی گوشی کشیده می‌شود و به هیچ سرویسی وصل نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne est le plus court chemin de votre position à la Kaaba (grand cercle). La carte est dessinée sur le téléphone, aucun service n'est contacté."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Линия — кратчайший путь от вашего места до Каабы (большой круг). Карта рисуется на телефоне, ни к какому сервису обращения нет."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線は現在地からカアバまでの最短経路（大円）です。地図は端末内で描かれ、外部サービスには接続しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선은 현재 위치에서 카바까지의 최단 경로(대원)입니다. 지도는 휴대폰에서 그려지며 어떤 서비스에도 연결하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条线是从您所在地到天房的最短路径（大圆）。地图在手机上绘制，不连接任何服务。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang linya ang pinakamaikling daan mula sa iyong lokasyon papunta sa Kaaba (great circle). Iginuguhit ang mapa sa telepono; walang serbisyong kinokontak."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นนี้คือเส้นทางที่สั้นที่สุดจากตำแหน่งของคุณไปยังกะอ์บะฮ์ (วงกลมใหญ่) แผนที่วาดบนโทรศัพท์ ไม่ติดต่อบริการใด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea es el camino más corto desde su ubicación hasta la Kaaba (círculo máximo). El mapa se dibuja en el teléfono; no se contacta con ningún servicio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha é o caminho mais curto da sua localização até a Caaba (círculo máximo). O mapa é desenhado no celular; nenhum serviço é contatado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेखा आपके स्थान से काबा तक का सबसे छोटा रास्ता (महावृत्त) है। नक्शा फ़ोन पर बनता है; किसी सेवा से संपर्क नहीं होता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেখাটি আপনার অবস্থান থেকে কাবা পর্যন্ত সবচেয়ে ছোট পথ (বৃহৎ বৃত্ত)। মানচিত্রটি ফোনেই আঁকা হয়; কোনো পরিষেবায় যোগাযোগ করা হয় না।"
          }
        }
      }
    },
