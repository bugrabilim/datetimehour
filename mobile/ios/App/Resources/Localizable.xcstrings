    "calendar.monthOrigin.heading": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayların adları nereden geliyor?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where do the month names come from?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Woher kommen die Monatsnamen?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayların adları haradan gəlir?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من أين جاءت أسماء الشهور؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari mana nama-nama bulan berasal?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مہینوں کے نام کہاں سے آئے؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام ماه‌ها از کجا آمده است؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'où viennent les noms des mois ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откуда названия месяцев?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の名前の由来"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달 이름의 유래"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月份名称的由来"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Saan nagmula ang mga pangalan ng buwan?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่มาของชื่อเดือน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿De dónde vienen los nombres de los meses?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De onde vêm os nomes dos meses?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महीनों के नाम कहाँ से आए?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাসের নামগুলো কোথা থেকে এসেছে?"
          }
        }
      }
    },
    "calendar.monthOrigin.source": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak: Nişanyan Sözlük. Ocak, Ekim, Kasım ve Aralık adları 1945'te kanunla benimsendi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source: Online Etymology Dictionary."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle: Duden, Herkunftswörterbuch."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mənbə: latın dili lüğətləri, Online Etymology Dictionary."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المصدر: معاجم اللاتينية، Online Etymology Dictionary."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber: kamus bahasa Latin, Online Etymology Dictionary."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ماخذ: لاطینی لغات، Online Etymology Dictionary۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "منبع: فرهنگ‌های لاتین، Online Etymology Dictionary."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Source : Le Robert, dictionnaire historique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Источник: этимологические словари (Фасмер)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "由来には諸説あります（日本国語大辞典など）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출처: 라틴어 사전, Online Etymology Dictionary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源：拉丁语词典、Online Etymology Dictionary。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinagmulan: mga diksiyonaryong Latin, Online Etymology Dictionary."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเดือนแบบนี้เริ่มใช้ในปี พ.ศ. 2432 (ค.ศ. 1889) ตามคติโหราศาสตร์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuente: Online Etymology Dictionary."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonte: Online Etymology Dictionary."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्रोत: Online Etymology Dictionary।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উৎস: Online Etymology Dictionary।"
          }
        }
      }
    },
    "calendar.monthOrigin.items.0": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocak: \"ocak\" (sıcak tutulan ev ocağı) sözünden; kışın ortası. 1945'e kadar Kânûn-ı sânî denirdi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "January is named after Janus, the Roman god of doors and beginnings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Januar: nach Janus, dem römischen Gott der Türen und des Anfangs."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanvar adını Roma qapılar və başlanğıclar tanrısı Yanusdan alır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يناير: نسبةً إلى يانوس، إله الأبواب والبدايات عند الرومان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Januari dinamai dari Janus, dewa pintu dan permulaan bangsa Romawi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جنوری کا نام رومی دیوتا یانوس سے ہے، جو دروازوں اور آغاز کا دیوتا تھا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ژانویه از نام ژانوس، خدای درها و آغازها در روم باستان است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Janvier vient de Janus, dieu romain des portes et des commencements."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Январь назван в честь Януса, римского бога дверей и начал."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睦月（むつき）：正月に親族が集まり睦み合う月とされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1월(January)의 서양 이름은 로마의 문과 시작의 신 야누스에서 왔습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一月的西方名称 January 源自罗马门与开端之神雅努斯。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Enero ay mula kay Janus, ang Romanong diyos ng mga pinto at simula."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มกราคม: มกร (ราศีมังกร) + อาคม (การมาถึง) คือเดือนที่ดวงอาทิตย์เข้าราศีมังกร"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enero debe su nombre a Jano, el dios romano de las puertas y los comienzos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Janeiro deve seu nome a Jano, o deus romano das portas e dos começos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जनवरी का नाम दरवाज़ों और शुरुआतों के रोमन देवता जेनस के नाम पर है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জানুয়ারির নাম রোমান দরজা ও শুরুর দেবতা জানুসের নামে।"
          }
        }
      }
    },
    "calendar.monthOrigin.items.1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şubat: Süryanice Şəḇāṭ ay adından."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "February comes from Februa, a Roman festival of purification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Februar: nach Februa, einem römischen Reinigungsfest."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fevral Roma təmizlənmə bayramı Februa-dan gəlir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فبراير: من «فبروا»، عيد روماني للتطهير."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Februari berasal dari Februa, perayaan penyucian bangsa Romawi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فروری رومی تہوار فیبروا سے ہے، جو پاکیزگی کا تہوار تھا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فوریه از فبروا، جشن پاک‌سازی رومی‌ها می‌آید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Février vient de Februa, fête romaine de purification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Февраль — от римского праздника очищения Februa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "如月（きさらぎ）：寒さで衣を更に重ねて着る「衣更着」からとされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2월(February)은 로마의 정화 축제 페브루아에서 왔습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二月 February 源自罗马的净化节日 Februa。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Pebrero ay mula sa Februa, isang Romanong pista ng paglilinis."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กุมภาพันธ์: กุมภ์ (ราศีกุมภ์) + พันธ์ (เกี่ยวเนื่อง) ใช้กับเดือนที่มี 28 หรือ 29 วัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Febrero viene de Februa, una fiesta romana de purificación."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fevereiro vem de Februa, uma festa romana de purificação."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़रवरी का नाम शुद्धि के रोमन त्योहार फ़ेब्रुआ से आया है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফেব্রুয়ারি এসেছে ফেব্রুয়া থেকে, যা ছিল রোমানদের একটি শুদ্ধির উৎসব।"
          }
        }
      }
    },
    "calendar.monthOrigin.items.2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mart: Latince Martius, Roma savaş tanrısı Mars'ın ayı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "March is named after Mars, the Roman god of war."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "März: nach Mars, dem römischen Kriegsgott."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mart Roma müharibə tanrısı Marsın adını daşıyır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مارس: نسبةً إلى مارس، إله الحرب عند الرومان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Maret dinamai dari Mars, dewa perang Romawi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مارچ کا نام رومی جنگی دیوتا مارس سے ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مارس از نام مارس، خدای جنگ رومی است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mars porte le nom de Mars, dieu romain de la guerre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Март назван в честь Марса, римского бога войны."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弥生（やよい）：草木がいよいよ生い茂る「いやおい」から。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3월(March)은 로마의 전쟁 신 마르스의 이름입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三月 March 以罗马战神玛尔斯命名。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Marso ay ipinangalan kay Mars, ang Romanong diyos ng digmaan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีนาคม: มีน (ราศีมีน) + อาคม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marzo debe su nombre a Marte, el dios romano de la guerra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Março deve seu nome a Marte, o deus romano da guerra."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मार्च का नाम युद्ध के रोमन देवता मार्स के नाम पर है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মার্চের নাম রোমান যুদ্ধদেবতা মার্সের নামে।"
          }
        }
      }
    },
    "calendar.monthOrigin.items.3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisan: Süryanice ve Aramice Nīsān, eski Babil takviminin ilk ayı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "April probably comes from Latin aperire, “to open”, as buds open in spring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "April: vermutlich von lateinisch aperire, „öffnen“ – die Knospen öffnen sich."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprel ehtimal ki, latınca aperire, “açmaq” sözündəndir: yazda tumurcuqlar açılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبريل: يُرجَّح أنه من اللاتينية aperire «يفتح»، إذ تتفتح البراعم في الربيع."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "April mungkin berasal dari bahasa Latin aperire, “membuka”, saat kuncup bunga mekar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپریل غالباً لاطینی aperire یعنی “کھولنا” سے ہے، کیونکہ بہار میں کلیاں کھلتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آوریل احتمالاً از واژهٔ لاتین aperire به معنای «گشودن» است، چون غنچه‌ها در بهار باز می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avril viendrait du latin aperire, « ouvrir » : les bourgeons s'ouvrent au printemps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Апрель, вероятно, от латинского aperire — «открывать»: весной раскрываются почки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "卯月（うづき）：卯の花が咲く月とされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4월(April)은 '열다'를 뜻하는 라틴어 aperire에서 온 것으로 보입니다. 봄에 꽃봉오리가 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "四月 April 可能源自拉丁语 aperire（“打开”），春天花蕾绽放。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Abril ay malamang mula sa Latin na aperire, “magbukas”, dahil bumubuka ang mga usbong sa tagsibol."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมษายน: เมษ (ราศีเมษ) + อายน (การมาถึง) ใช้กับเดือนที่มี 30 วัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abril probablemente viene del latín aperire, “abrir”, porque en primavera se abren los brotes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abril provavelmente vem do latim aperire, “abrir”, porque na primavera os brotos se abrem."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अप्रैल शायद लैटिन aperire, “खोलना”, से आया है, क्योंकि वसंत में कलियाँ खिलती हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এপ্রিল সম্ভবত লাতিন aperire, অর্থাৎ “খোলা” থেকে এসেছে, কারণ বসন্তে কুঁড়ি খোলে।"
          }
        }
      }
    },
    "calendar.monthOrigin.items.4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayıs: Latince Maius, büyüme tanrıçası Maia'nın ayı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May is named after Maia, a Roman goddess of growth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai: nach Maia, einer römischen Göttin des Wachstums."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "May Roma böyümə ilahəsi Mayanın adını daşıyır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مايو: نسبةً إلى مايا، إلهة النماء عند الرومان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mei dinamai dari Maia, dewi pertumbuhan Romawi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مئی کا نام رومی دیوی مایا سے ہے، جو نشوونما کی دیوی تھی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مه از نام مایا، الههٔ رویش در روم است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai vient de Maia, déesse romaine de la croissance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Май назван в честь Майи, римской богини роста."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "皐月（さつき）：早苗を植える「早苗月」から。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5월(May)은 로마의 성장의 여신 마이아의 이름입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五月 May 以罗马生长女神玛亚命名。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Mayo ay ipinangalan kay Maia, Romanong diyosa ng paglago."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พฤษภาคม: พฤษภ (ราศีพฤษภ) + อาคม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayo debe su nombre a Maia, una diosa romana del crecimiento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maio deve seu nome a Maia, uma deusa romana do crescimento."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मई का नाम वृद्धि की रोमन देवी माइया के नाम पर है।"
          }
        },
        "bn": {
          "stringUnit": {
