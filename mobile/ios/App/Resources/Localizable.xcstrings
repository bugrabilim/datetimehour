    "kids.south.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünyanın öbür yarısında tersi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flipped on the other half of the world"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der anderen Erdhälfte umgekehrt"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünyanın o biri yarısında tərsinə"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في النصف الآخر من العالم العكس"
          }
        }
      }
    },
    "kids.south.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biz kıştayken Avustralya, Güney Afrika ve Arjantin'de yaz yaşanır. Oradaki çocuklar yılbaşını çoğu zaman plajda kutlar!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While we have winter, it's summer in Australia, South Africa and Argentina. Kids there often celebrate New Year on the beach!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn bei uns Winter ist, ist in Australien, Südafrika und Argentinien Sommer. Kinder dort feiern Neujahr oft am Strand!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Biz qışda olanda Avstraliya, Cənubi Afrika və Argentinada yaydır. Oradakı uşaqlar Yeni ili çox vaxt çimərlikdə qeyd edir!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يكون عندنا شتاء، يكون الصيف في أستراليا وجنوب أفريقيا والأرجنتين. وكثيرًا ما يحتفل الأطفال هناك برأس السنة على الشاطئ!"
          }
        }
      }
    },
    "kids.south.north": {
      "extractionState": "manual",
      "localizations": {
