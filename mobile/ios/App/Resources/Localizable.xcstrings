    "greet.m.kandil.1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandiliniz mübarek olsun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blessed holy night to you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesegnete Kandil-Nacht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mübarək gecəniz xeyirli olsun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليلة مباركة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat malam yang penuh berkah."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ مبارک رات آپ کو مبارک ہو۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این شب مبارک بر شما مبارک باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonne nuit bénie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Благословенной ночи."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "祝福された夜をお迎えください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축복받은 밤 되세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吉庆之夜安好。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinagpalang gabi sa inyo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้เป็นค่ำคืนที่จำเริญ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendita noche santa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abençoada noite santa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मुबारक रात आपको मुबारक हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাকে পবিত্র রাতের শুভেচ্ছা।"
          }
        }
      }
    },
    "greet.m.kandil.2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mübarek gecede dualarınız kabul olsun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your prayers be accepted on this blessed night."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mögen Ihre Gebete in dieser gesegneten Nacht angenommen werden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mübarək gecədə dualarınız qəbul olsun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقبّل الله دعاءكم في هذه الليلة المباركة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga doa Anda dikabulkan pada malam yang berkah ini."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس مبارک رات میں آپ کی دعائیں قبول ہوں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در این شب مبارک دعاهایتان مستجاب شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que vos prières soient exaucées en cette nuit bénie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть в эту благословенную ночь ваши молитвы будут приняты."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この祝福の夜に祈りが受け入れられますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 축복된 밤에 기도가 받아들여지길 바랍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "愿您的祈祷在这吉庆之夜被接受。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawa'y tanggapin ang inyong dalangin sa pinagpalang gabing ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้คำขอพรของคุณได้รับการตอบรับในค่ำคืนอันจำเริญนี้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que sus oraciones sean aceptadas en esta noche bendita."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que as suas orações sejam aceitas nesta noite abençoada."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मुबारक रात में आपकी दुआएँ क़बूल हों।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বরকতময় রাতে আপনার দোয়া কবুল হোক।"
          }
        }
      }
    },
    "greet.m.kandil.3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandilin nuru evinizi aydınlatsın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May the light of this holy night brighten your home."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möge das Licht dieser Nacht Ihr Zuhause erhellen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gecənin nuru evinizi işıqlandırsın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنار نور هذه الليلة بيتكم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga cahaya malam ini menerangi rumah Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس رات کا نور آپ کے گھر کو روشن کرے۔"
