    "qibla.turn": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu düz tutun ve okun gösterdiği yöne dönün"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the phone flat and turn toward the arrow"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie das Telefon waagerecht und drehen Sie sich in Pfeilrichtung"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu düz tutun və oxun göstərdiyi tərəfə dönün"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أمسك الهاتف بشكل مستوٍ واستدر نحو السهم"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang ponsel mendatar dan putar badan ke arah panah"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون کو افقی رکھیں اور تیر کی طرف مڑیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی را صاف نگه دارید و به سمت پیکان بچرخید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez le téléphone à plat et tournez-vous vers la flèche"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите телефон горизонтально и повернитесь к стрелке"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを水平に持ち、矢印の方へ向きを変えてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 평평하게 들고 화살표 쪽으로 도세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手机平放，朝箭头方向转动"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hawakan nang pahiga ang telepono at umikot papunta sa arrow"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถือโทรศัพท์ให้ราบแล้วหมุนไปทางลูกศร"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga el teléfono plano y gire hacia la flecha"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o celular na horizontal e gire em direção à seta"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन को सीधा लिटाकर तीर की ओर घूमें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোন সমতলে ধরে তীরের দিকে ঘুরুন"
          }
        }
      }
    },
    "qibla.noCompass": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda pusula yok. Yukarıdaki açıyı kuzeyden saat yönünde ölçün."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no compass. Measure the angle above clockwise from north."
