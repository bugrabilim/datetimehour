    "tools.voiceNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun kendi konuşma sesiyle; internet gerekmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your phone's own speech voice; no internet needed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Sprachausgabe des Telefons; kein Internet nötig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun öz danışıq səsi ilə; internet lazım deyil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بصوت النطق في هاتفك؛ لا حاجة إلى الإنترنت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan suara bawaan ponsel Anda; tidak perlu internet."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون کی اپنی آواز میں؛ انٹرنیٹ کی ضرورت نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با صدای گفتار خود گوشی؛ اینترنت لازم نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec la voix de synthèse du téléphone ; aucune connexion nécessaire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосом синтезатора речи телефона; интернет не нужен."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホ本体の読み上げ音声を使います。インターネットは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰 자체의 음성으로. 인터넷이 필요 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用手机自带的朗读声音，无需联网。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa sariling boses ng iyong telepono; hindi kailangan ng internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เสียงพูดของโทรศัพท์เอง ไม่ต้องใช้อินเทอร์เน็ต"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la voz del propio teléfono; no hace falta internet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a voz do próprio celular; não precisa de internet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके फ़ोन की अपनी आवाज़ में; इंटरनेट की ज़रूरत नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফোনের নিজস্ব কথন কণ্ঠে; ইন্টারনেট লাগে না।"
          }
        }
      }
    },
