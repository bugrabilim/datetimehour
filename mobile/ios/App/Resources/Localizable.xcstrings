    "alarm.pauseNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarihler arasında tekrarlayan alarmlar çalmaz; bir kezlik alarmlar etkilenmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeating alarms won’t ring between these dates; one-time alarms are not affected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholende Wecker klingeln in diesem Zeitraum nicht; einmalige Wecker bleiben unberührt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarixlər arasında təkrarlanan zənglər çalmır; birdəfəlik zənglərə təsir etmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن ترنّ المنبّهات المتكررة بين هذين التاريخين؛ ولا تتأثر المنبّهات لمرة واحدة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm berulang tidak berbunyi di antara tanggal ini; alarm satu kali tidak terpengaruh."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان تاریخوں کے درمیان دہرائے جانے والے الارم نہیں بجیں گے؛ ایک بار والے الارم متاثر نہیں ہوں گے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بین این تاریخ‌ها زنگ‌های تکراری به صدا درنمی‌آیند؛ زنگ‌های یک‌باره تغییری نمی‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes répétées ne sonneront pas entre ces dates ; les alarmes uniques ne changent pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяющиеся будильники не звонят в эти даты; разовые не затрагиваются."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間は繰り返しアラームが鳴りません。1回のみのアラームは影響を受けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간에는 반복 알람이 울리지 않으며 한 번만 울리는 알람은 그대로입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这些日期之间重复闹钟不会响；单次闹钟不受影响。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tutunog ang paulit-ulit na alarm sa pagitan ng mga petsang ito; hindi apektado ang isang beses na alarm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างวันที่นี้ปลุกที่ซ้ำจะไม่ดัง ปลุกครั้งเดียวไม่ได้รับผล"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alarmas que se repiten no sonarán entre estas fechas; las alarmas únicas no se ven afectadas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alarmes repetidos não tocam entre essas datas; os alarmes únicos não são afetados."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन तारीखों के बीच दोहराए जाने वाले अलार्म नहीं बजेंगे; एक बार वाले अलार्म पर असर नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই তারিখগুলোর মধ্যে পুনরাবৃত্ত অ্যালার্ম বাজবে না; একবারের অ্যালার্মে প্রভাব নেই।"
          }
        }
      }
    },
