    "datecalc.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarih Hesaplama: İki Tarih Arası Gün, İş Günü, Yaş | Saat Tarih"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date Calculator: Days, Working Days, Age | Saat Tarih"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datumsrechner: Tage, Arbeitstage, Alter | Saat Tarih"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarix kalkulyatoru: günlər, iş günləri, yaş | Saat Tarih"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاسبة التاريخ: الأيام وأيام العمل والعمر | Saat Tarih"
          }
        }
      }
    },
    "datecalc.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki tarih arası kaç gün, kaç iş günü? Tarihe gün, ay, yıl ekleyin ya da çıkarın; yaşınızı hesaplayın. Türkiye resmi tatilleri dikkate alınır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many days and working days between two dates? Add or subtract days, months or years from a date and calculate age. Turkish public holidays are taken into account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Tage und Arbeitstage liegen zwischen zwei Daten? Tage, Monate oder Jahre addieren und abziehen, Alter berechnen – mit türkischen Feiertagen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İki tarix arasında neçə gün və iş günü var? Tarixə gün, ay və ya il əlavə edin, çıxın, yaşı hesablayın. Türkiyənin rəsmi bayramları nəzərə alınır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم يومًا ويوم عمل بين تاريخين؟ أضف أيامًا أو شهورًا أو سنوات إلى تاريخ أو اطرحها منه، واحسب العمر، مع مراعاة العطل الرسمية في تركيا."
          }
        }
      }
    },
    "datecalc.h1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarih hesaplama"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date calculator"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datumsrechner"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarix kalkulyatoru"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاسبة التاريخ"
          }
        }
      }
    },
    "datecalc.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki tarih arasındaki gün, hafta ve iş gününü hesaplayın; bir tarihe gün, ay, yıl ya da iş günü ekleyin; yaşınızı ve sonraki doğum gününüzü bulun. İş günü hesabı hafta sonlarını ve Türkiye resmi tatillerini dışarıda bırakır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculate the days, weeks and working days between two dates; add days, months, years or working days to a date; and find your age and next birthday. Working-day counts leave out weekends and Turkish public holidays."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnen Sie Tage, Wochen und Arbeitstage zwischen zwei Daten, addieren Sie Tage, Monate, Jahre oder Arbeitstage zu einem Datum und ermitteln Sie Ihr Alter und Ihren nächsten Geburtstag. Bei Arbeitstagen werden Wochenenden und gesetzliche Feiertage der Türkei nicht mitgezählt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İki tarix arasındakı günləri, həftələri və iş günlərini hesablayın; tarixə gün, ay, il və ya iş günü əlavə edin; yaşınızı və növbəti ad gününüzü tapın. İş günləri hesablanarkən həftəsonları və Türkiyənin rəsmi bayram günləri çıxılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احسب الأيام والأسابيع وأيام العمل بين تاريخين؛ وأضف أيامًا أو شهورًا أو سنوات أو أيام عمل إلى تاريخ؛ واعرف عمرك وموعد عيد ميلادك القادم. ولا يشمل حساب أيام العمل عطلات نهاية الأسبوع والعطل الرسمية في تركيا."
          }
        }
      }
    },
    "datecalc.diffHeading": {
