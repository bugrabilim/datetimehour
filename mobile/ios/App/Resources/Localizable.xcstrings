    "alarm.music.trimNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırıcıyla şarkının hangi 30 saniyesinin çalacağını seçin. Kademeli ses açıksa bölüm kısık başlar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the slider to choose which 30 seconds of the song play. If gradual volume is on, the part starts quietly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie mit dem Regler, welche 30 Sekunden des Titels erklingen. Ist ansteigende Lautstärke an, beginnt der Ausschnitt leise."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüşdürücü ilə mahnının hansı 30 saniyəsinin səslənəcəyini seçin. Tədricən səs açıqdırsa, hissə zəif başlayır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بشريط التمرير أي 30 ثانية من الأغنية ستُسمع. إذا كان الصوت المتدرّج مفعّلًا يبدأ الجزء هادئًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan penggeser, pilih 30 detik lagu yang diputar. Jika volume bertahap aktif, potongan dimulai pelan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سلائیڈر سے چنیں کہ گانے کے کون سے 30 سیکنڈ بجیں۔ اگر بتدریج آواز آن ہو تو حصہ دھیمے سے شروع ہوتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با لغزنده برگزینید کدام 30 ثانیهٔ آهنگ پخش شود. اگر بلندی تدریجی روشن باشد، بخش آرام آغاز می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le curseur, choisissez les 30 secondes du morceau à jouer. Si le volume progressif est activé, l’extrait commence doucement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ползунком выберите, какие 30 секунд песни будут звучать. Если включена нарастающая громкость, отрывок начинается тихо."
          }
        }
      }
    },
