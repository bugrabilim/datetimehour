    "fs.duoNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon yan çevrilince tam ekran saatin sağında seçtiğiniz alan durur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the phone is turned sideways, the area you choose sits to the right of the full-screen clock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Querformat steht der gewählte Bereich rechts neben der Vollbilduhr."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon yan çevriləndə seçdiyiniz sahə tam ekran saatın sağında durur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تدوير الهاتف أفقيًا يظهر القسم الذي تختاره يمين الساعة بملء الشاشة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ponsel dimiringkan, area pilihan Anda tampil di kanan jam layar penuh."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون ترچھا کرنے پر آپ کا منتخب حصہ فل اسکرین گھڑی کے دائیں جانب آتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی گوشی افقی شود، بخشی که انتخاب کرده‌اید سمت راست ساعت تمام‌صفحه قرار می‌گیرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode paysage, la zone choisie s'affiche à droite de l'horloge plein écran."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В горизонтальном положении выбранный блок появляется справа от полноэкранных часов."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横向きにすると、選んだ項目が全画面時計の右側に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가로로 돌리면 선택한 항목이 전체 화면 시계 오른쪽에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机横放时，所选内容显示在全屏时钟右侧。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag pahiga ang telepono, nasa kanan ng full-screen na orasan ang napiling bahagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อวางโทรศัพท์แนวนอน ส่วนที่เลือกจะอยู่ทางขวาของนาฬิกาเต็มจอ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al girar el teléfono de lado, la zona que elija queda a la derecha del reloj a pantalla completa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao virar o celular de lado, a área escolhida fica à direita do relógio em tela cheia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन आड़ा करने पर आपका चुना हिस्सा फ़ुल स्क्रीन घड़ी के दाईं ओर आता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোন পাশে ঘোরালে আপনার বাছা অংশটি পূর্ণ পর্দার ঘড়ির ডানে থাকে।"
          }
        }
      }
    },
