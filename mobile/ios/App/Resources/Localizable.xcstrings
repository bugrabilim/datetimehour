    "kidsmoon.q4a": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aydınlık yüzü bize dönük değil|Ay kaybolur|Bulutlar örter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its lit side faces away from us|The Moon disappears|Clouds cover it"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die beleuchtete Seite zeigt von uns weg|Der Mond verschwindet|Wolken verdecken ihn"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İşıqlı üzü bizə tərəf deyil|Ay yox olur|Buludlar örtür"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجهه المضاء ليس متجهًا نحونا|يختفي القمر|تغطيه الغيوم"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisi terangnya membelakangi kita|Bulan menghilang|Tertutup awan"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کا روشن رخ ہماری طرف نہیں ہوتا|چاند غائب ہو جاتا ہے|بادل ڈھک لیتے ہیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نیمهٔ روشنش رو به ما نیست|ماه ناپدید می‌شود|ابرها آن را می‌پوشانند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa face éclairée n'est pas tournée vers nous|La Lune disparaît|Les nuages la cachent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освещённая сторона повёрнута от нас|Луна исчезает|Её закрывают облака"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るい面が地球を向いていない|月が消える|雲にかくれる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝은 면이 우리를 향하지 않아서|달이 사라져서|구름이 가려서"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被照亮的一面背对我们|月亮消失了|被云遮住"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakatalikod sa atin ang maliwanag na bahagi|Nawawala ang Buwan|Natatakpan ng ulap"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ด้านสว่างหันออกจากเรา|ดวงจันทร์หายไป|เมฆบัง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su lado iluminado no mira hacia nosotros|La Luna desaparece|La tapan las nubes"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O lado iluminado fica de costas para nós|A Lua desaparece|As nuvens a cobrem"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसका रोशन भाग हमारी ओर नहीं होता|चंद्रमा ग़ायब हो जाता है|बादल उसे ढक लेते हैं"
          }
        },
        "bn": {
          "stringUnit": {
