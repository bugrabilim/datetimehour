    "calendar.projected": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yılın dini günleri Diyanet'in uzun vadeli takvimine dayanır; kesinleşince güncellenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Religious days for this year are based on Diyanet's long-range calendar and will be updated once confirmed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die religiösen Tage dieses Jahres beruhen auf dem Langzeitkalender der Diyanet und werden nach Bestätigung aktualisiert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ilin dini günləri Diyanətin uzunmüddətli təqviminə əsaslanır; dəqiqləşəndə yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستند المناسبات الدينية لهذا العام إلى التقويم طويل المدى لرئاسة الشؤون الدينية، وستُحدَّث عند تأكيدها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari keagamaan tahun ini berasal dari kalender jangka panjang Diyanet dan akan diperbarui setelah dipastikan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سال کے مذہبی دن دیانت کے طویل مدتی کیلنڈر سے لیے گئے ہیں اور تصدیق کے بعد تازہ کیے جائیں گے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روزهای مذهبی امسال از تقویم بلندمدت دیانت گرفته شده‌اند و پس از تأیید به‌روز می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours religieux de cette année proviennent du calendrier à long terme de la Diyanet et seront mis à jour une fois confirmés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Религиозные дни этого года взяты из долгосрочного календаря Diyanet и будут обновлены после подтверждения."
          }
        }
      }
    },
