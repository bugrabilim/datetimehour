      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydınız alınamadı. E-posta adresinizi kontrol edip biraz sonra tekrar deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not sign you up. Check your email address and try again a little later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung hat nicht geklappt. Prüfen Sie Ihre E-Mail-Adresse und versuchen Sie es etwas später erneut."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeydiyyat alınmadı. E-poçt ünvanınızı yoxlayıb bir az sonra yenidən cəhd edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تسجيلك. تحقّق من عنوان بريدك الإلكتروني وحاول مرة أخرى بعد قليل."
          }
        }
      }
    },
