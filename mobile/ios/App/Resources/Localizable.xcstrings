    "perms.notUsed.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiç istemediğimiz izinler"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions we never ask for"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen, die wir nie anfragen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Heç istəmədiyimiz icazələr"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أذونات لا نطلبها أبدًا"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin yang tidak pernah kami minta"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازتیں جو ہم کبھی نہیں مانگتے"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مجوزهایی که هرگز نمی‌خواهیم"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que nous ne demandons jamais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что мы никогда не запрашиваем"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一切求めない許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절대 요청하지 않는 권한"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们从不请求的权限"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga pahintulot na hindi namin hinihingi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์ที่เราไม่เคยขอ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permisos que nunca pedimos"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissões que nunca pedimos"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमतियाँ जो हम कभी नहीं माँगते"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে অনুমতিগুলো আমরা কখনো চাই না"
          }
        }
      }
    },
    "perms.notUsed.ios": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişileriniz, fotoğraf arşiviniz, reklam kimliğiniz (takip), Bluetooth ve arka planda konum. Fotoğraf seçerken yalnız seçtiğiniz fotoğraf uygulamaya gelir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contacts, photo library, advertising ID (tracking), Bluetooth and background location. When you pick a photo, only that photo reaches the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Kontakte, Ihre Fotomediathek, die Werbe-ID (Tracking), Bluetooth und Standort im Hintergrund. Wählen Sie ein Foto, erhält die App nur dieses eine."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontaktlarınız, foto arxiviniz, reklam identifikatorunuz (izləmə), Bluetooth və arxa planda məkan. Foto seçəndə tətbiqə yalnız seçdiyiniz foto gəlir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهات اتصالك، ومكتبة صورك، ومعرّف الإعلانات (التتبّع)، والبلوتوث، والموقع في الخلفية. عند اختيار صورة لا تصل إلى التطبيق إلا تلك الصورة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontak, galeri foto, ID iklan (pelacakan), Bluetooth, dan lokasi di latar belakang. Saat memilih foto, hanya foto itu yang sampai ke aplikasi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے رابطے، تصویروں کی لائبریری، اشتہاری شناخت (ٹریکنگ)، بلوٹوتھ اور پس منظر میں مقام۔ تصویر چنتے وقت صرف وہی تصویر ایپ تک آتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مخاطبان، کتابخانه‌ی عکس، شناسه‌ی تبلیغاتی (ردیابی)، بلوتوث و موقعیت در پس‌زمینه. وقتی عکسی انتخاب می‌کنید فقط همان عکس به برنامه می‌رسد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos contacts, votre photothèque, l'identifiant publicitaire (pistage), le Bluetooth et la position en arrière-plan. Quand vous choisissez une photo, seule celle-ci parvient à l'appli."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакты, фотоархив, рекламный идентификатор (слежка), Bluetooth и местоположение в фоне. Если вы выбираете фото, приложение получает только его."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先、写真ライブラリ、広告ID（トラッキング）、Bluetooth、バックグラウンドでの位置情報。写真を選ぶときは、選んだ写真だけがアプリに渡ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연락처, 사진 보관함, 광고 ID(추적), 블루투스, 백그라운드 위치. 사진을 고를 때도 고른 사진만 앱에 전달돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通讯录、照片图库、广告标识符（跟踪）、蓝牙和后台定位。选择照片时，只有您选中的那张会交给应用。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga contact, photo library, advertising ID (tracking), Bluetooth at lokasyon sa background. Kapag pumili ka ng larawan, iyon lang ang napupunta sa app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายชื่อติดต่อ คลังรูปภาพ รหัสโฆษณา (การติดตาม) บลูทูธ และตำแหน่งเบื้องหลัง เมื่อคุณเลือกรูป แอปจะได้รับเฉพาะรูปที่เลือก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus contactos, su fototeca, el identificador publicitario (rastreo), el Bluetooth y la ubicación en segundo plano. Al elegir una foto, solo esa llega a la app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus contatos, sua fototeca, o identificador de anúncios (rastreamento), o Bluetooth e a localização em segundo plano. Ao escolher uma foto, só ela chega ao app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके संपर्क, फ़ोटो लाइब्रेरी, विज्ञापन आईडी (ट्रैकिंग), ब्लूटूथ और बैकग्राउंड में स्थान। फ़ोटो चुनते समय सिर्फ़ चुनी हुई फ़ोटो ऐप तक आती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিচিতি, ছবির লাইব্রেরি, বিজ্ঞাপন আইডি (ট্র্যাকিং), ব্লুটুথ ও পটভূমিতে অবস্থান। আপনি ছবি বাছলে শুধু সেই ছবিটিই অ্যাপে আসে।"
          }
        }
      }
    },
    "perms.notUsed.android": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişileriniz, fotoğraf arşiviniz, reklam kimliğiniz, kamera ve Bluetooth. Fotoğraf seçerken ve kod okuturken telefonun kendi seçicisi kullanılır; yalnız seçtiğiniz uygulamaya gelir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contacts, photo library, advertising ID, camera and Bluetooth. Photos and codes go through your phone's own picker and scanner; only what you choose reaches the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Kontakte, Ihre Fotogalerie, die Werbe-ID, die Kamera und Bluetooth. Fotos und Codes laufen über die Auswahl und den Scanner Ihres Telefons; die App erhält nur, was Sie auswählen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontaktlarınız, foto arxiviniz, reklam identifikatorunuz, kamera və Bluetooth. Foto seçəndə və kod oxudanda telefonun öz seçicisi işlədilir; tətbiqə yalnız seçdiyiniz gəlir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهات اتصالك، ومكتبة صورك، ومعرّف الإعلانات، والكاميرا، والبلوتوث. تمرّ الصور والرموز عبر أداة الاختيار والماسح في هاتفك، ولا يصل إلى التطبيق إلا ما تختاره."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontak, galeri foto, ID iklan, kamera, dan Bluetooth. Foto dan kode lewat pemilih dan pemindai bawaan ponsel; hanya yang Anda pilih yang sampai ke aplikasi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے رابطے، تصویروں کی لائبریری، اشتہاری شناخت، کیمرا اور بلوٹوتھ۔ تصویر اور کوڈ فون کے اپنے چناؤ اور اسکینر سے گزرتے ہیں؛ ایپ تک صرف وہی آتا ہے جو آپ چنیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مخاطبان، کتابخانه‌ی عکس، شناسه‌ی تبلیغاتی، دوربین و بلوتوث. عکس‌ها و کدها از انتخابگر و اسکنر خود گوشی می‌گذرند و فقط آنچه انتخاب کنید به برنامه می‌رسد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos contacts, votre galerie, l'identifiant publicitaire, l'appareil photo et le Bluetooth. Photos et codes passent par le sélecteur et le scanner de votre téléphone ; seul ce que vous choisissez parvient à l'appli."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакты, фотоархив, рекламный идентификатор, камера и Bluetooth. Фото и коды проходят через встроенные средства выбора и сканер телефона; приложение получает только выбранное."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先、写真ライブラリ、広告ID、カメラ、Bluetooth。写真やコードはスマートフォン標準の選択画面とスキャナーを通るので、アプリには選んだものだけが渡ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연락처, 사진 보관함, 광고 ID, 카메라, 블루투스. 사진과 코드는 휴대폰 기본 선택기와 스캐너를 거쳐, 고른 것만 앱에 전달돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通讯录、照片图库、广告标识符、相机和蓝牙。照片和二维码都通过手机自带的选择器和扫描器，只有您选中的内容会交给应用。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga contact, photo library, advertising ID, camera at Bluetooth. Dumadaan ang mga larawan at code sa sariling picker at scanner ng telepono; ang pinili mo lang ang napupunta sa app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายชื่อติดต่อ คลังรูปภาพ รหัสโฆษณา กล้อง และบลูทูธ รูปภาพและโค้ดจะผ่านตัวเลือกและตัวสแกนของโทรศัพท์เอง แอปได้รับเฉพาะสิ่งที่คุณเลือก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus contactos, su galería, el identificador publicitario, la cámara y el Bluetooth. Fotos y códigos pasan por el selector y el escáner del propio teléfono; solo lo que elige llega a la app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus contatos, sua galeria, o identificador de anúncios, a câmera e o Bluetooth. Fotos e códigos passam pelo seletor e pelo leitor do próprio celular; só o que você escolhe chega ao app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके संपर्क, फ़ोटो लाइब्रेरी, विज्ञापन आईडी, कैमरा और ब्लूटूथ। फ़ोटो और कोड फ़ोन के अपने चयनकर्ता और स्कैनर से गुज़रते हैं; ऐप तक सिर्फ़ वही आता है जो आप चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিচিতি, ছবির লাইব্রেরি, বিজ্ঞাপন আইডি, ক্যামেরা ও ব্লুটুথ। ছবি ও কোড আপনার ফোনের নিজস্ব বাছাইকারী ও স্ক্যানার দিয়ে যায়; শুধু আপনার বাছা জিনিসই অ্যাপে আসে।"
          }
        }
      }
    },
