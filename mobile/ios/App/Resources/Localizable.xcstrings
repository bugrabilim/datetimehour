        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su esfuerzo dio frutos; felicidades."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu esforço valeu a pena; parabéns."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी मेहनत रंग लाई; बधाई हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিশ্রম সফল হয়েছে; অভিনন্দন।"
          }
        }
      }
    },
    "greet.m.graduation.2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu başarı yeni kapılar açsın."
