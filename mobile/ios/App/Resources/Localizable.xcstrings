    "live.weather.toggleAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim alanında ve kilit ekranında göster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in the notification shade and on the lock screen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Statusleiste und auf dem Sperrbildschirm zeigen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildiriş sahəsində və kilid ekranında göstər"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض في شريط الحالة وعلى شاشة القفل"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan di bilah status dan layar kunci"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسٹیٹس بار اور لاک اسکرین پر دکھائیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایش در نوار وضعیت و صفحهٔ قفل"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher dans la barre d'état et sur l'écran de verrouillage"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать в строке состояния и на экране блокировки"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバーとロック画面に表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태 표시줄과 잠금 화면에 표시"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在状态栏和锁定屏幕显示"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipakita sa status bar at lock screen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงในแถบสถานะและหน้าจอล็อก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar en la barra de estado y en la pantalla de bloqueo"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar na barra de status e na tela de bloqueio"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टेटस बार और लॉक स्क्रीन पर दिखाएँ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটিফিকেশন প্যানেলে ও লক স্ক্রিনে দেখান"
          }
        }
      }
    },
    "live.weather.noteAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıcaklık durum çubuğunda ve kilit ekranında görünür; bildirimdeki Kapat ile, Hızlı Ayarlar'dan ya da buradan kapatılır. Saatte bir yenilenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The temperature appears in the status bar and on the lock screen; turn it off with Close in the notification, from Quick Settings or here. It refreshes hourly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Temperatur erscheint in der Statusleiste und auf dem Sperrbildschirm; ausschalten mit „Schließen“ in der Benachrichtigung, in den Schnelleinstellungen oder hier. Stündlich aktualisiert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperatur status sətrində və kilid ekranında görünür; bildirişdəki Bağla ilə, Sürətli Ayarlardan ya da buradan bağlanır. Saatda bir yenilənir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر درجة الحرارة في شريط الحالة وعلى شاشة القفل؛ أوقفها بزر الإغلاق في الإشعار أو من الإعدادات السريعة أو من هنا. تتجدد كل ساعة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhu tampil di bilah status dan layar kunci; matikan dengan Tutup di notifikasi, dari Setelan Cepat, atau di sini. Diperbarui tiap jam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درجۂ حرارت اسٹیٹس بار اور لاک اسکرین پر دکھتا ہے؛ اطلاع میں بند کریں سے، فوری ترتیبات سے یا یہاں سے بند کریں۔ ہر گھنٹے تازہ ہوتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دما در نوار وضعیت و صفحهٔ قفل دیده می‌شود؛ با «بستن» در اعلان، از تنظیمات سریع یا همین‌جا خاموشش کنید. هر ساعت به‌روز می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La température s'affiche dans la barre d'état et sur l'écran de verrouillage ; désactivez-la avec Fermer dans la notification, depuis les Réglages rapides ou ici. Actualisée toutes les heures."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Температура видна в строке состояния и на экране блокировки; выключается кнопкой «Закрыть» в уведомлении, в быстрых настройках или здесь. Обновляется раз в час."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気温がステータスバーとロック画面に表示されます。通知の「閉じる」、クイック設定、またはここでオフにできます。1時間ごとに更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기온이 상태 표시줄과 잠금 화면에 표시됩니다. 알림의 닫기, 빠른 설정 또는 여기에서 끌 수 있습니다. 1시간마다 새로 고칩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "气温显示在状态栏和锁定屏幕上；可用通知中的“关闭”、快捷设置或在此处关闭。每小时更新一次。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalabas ang temperatura sa status bar at lock screen; patayin gamit ang Isara sa notification, sa Quick Settings, o dito. Nire-refresh bawat oras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุณหภูมิแสดงในแถบสถานะและหน้าจอล็อก ปิดได้ด้วยปุ่มปิดในการแจ้งเตือน จากการตั้งค่าด่วน หรือที่นี่ อัปเดตทุกชั่วโมง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La temperatura aparece en la barra de estado y en la pantalla de bloqueo; desactívela con Cerrar en la notificación, desde Ajustes rápidos o aquí. Se actualiza cada hora."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A temperatura aparece na barra de status e na tela de bloqueio; desative com Fechar na notificação, nas Configurações rápidas ou aqui. Atualiza a cada hora."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तापमान स्टेटस बार और लॉक स्क्रीन पर दिखता है; सूचना के \"बंद करें\" बटन से, क्विक सेटिंग्स से या यहाँ से बंद करें। हर घंटे ताज़ा होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাপমাত্রা স্ট্যাটাস বারে ও লক স্ক্রিনে দেখা যায়; নোটিফিকেশনের বন্ধ করুন দিয়ে, কুইক সেটিংস থেকে বা এখান থেকে বন্ধ করুন। প্রতি ঘণ্টায় হালনাগাদ হয়।"
          }
        }
      }
    },
