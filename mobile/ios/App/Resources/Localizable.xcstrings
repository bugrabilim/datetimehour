    "quran.creditKemenag": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Endonezce meal için Endonezya Din İşleri Bakanlığı'nın (Kemenag) Kur'an sitesine bağlantı verilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For an Indonesian translation the app links to the Quran site of Indonesia's Ministry of Religious Affairs (Kemenag)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine indonesische Übersetzung verweist die App auf die Koran-Website des indonesischen Religionsministeriums (Kemenag)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İndoneziyaca məal üçün İndoneziya Din İşləri Nazirliyinin (Kemenag) Quran saytına keçid verilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للترجمة الإندونيسية يحيل التطبيق إلى موقع القرآن الكريم التابع لوزارة الشؤون الدينية الإندونيسية (كيميناغ)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk terjemahan bahasa Indonesia, aplikasi menautkan ke situs Qur'an Kementerian Agama RI (Kemenag)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انڈونیشی ترجمے کے لیے ایپ انڈونیشیا کی وزارتِ مذہبی امور (کیمیناگ) کی قرآن ویب سائٹ کا لنک دیتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ترجمهٔ اندونزیایی، برنامه به وب‌سایت قرآن وزارت امور دینی اندونزی (کمناگ) پیوند می‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour une traduction indonésienne, l’app renvoie au site du Coran du ministère indonésien des Affaires religieuses (Kemenag)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для индонезийского перевода приложение ведёт на сайт Корана Министерства по делам религий Индонезии (Kemenag)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インドネシア語訳については、アプリはインドネシア宗教省（ケメナグ）のクルアーンサイトにリンクしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인도네시아어 번역은 앱에서 인도네시아 종교부(케메낙)의 꾸란 사이트로 연결합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "印尼文译本方面，应用链接到印尼宗教部（Kemenag）的古兰经网站。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa salin sa Indonesian, naka-link ang app sa Quran site ng Ministry of Religious Affairs ng Indonesia (Kemenag)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับคำแปลภาษาอินโดนีเซีย แอปลิงก์ไปยังเว็บไซต์อัลกุรอานของกระทรวงการศาสนาอินโดนีเซีย (Kemenag)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para una traducción al indonesio, la app enlaza al sitio del Corán del Ministerio de Asuntos Religiosos de Indonesia (Kemenag)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para uma tradução indonésia, o app leva ao site do Alcorão do Ministério de Assuntos Religiosos da Indonésia (Kemenag)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंडोनेशियाई अनुवाद के लिए ऐप इंडोनेशिया के धार्मिक मामलों के मंत्रालय (केमेनाग) की क़ुरआन साइट का लिंक देता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইন্দোনেশীয় অনুবাদের জন্য অ্যাপটি ইন্দোনেশিয়ার ধর্ম মন্ত্রণালয়ের (কেমেনাগ) কুরআন সাইটের লিংক দেয়।"
          }
        }
      }
    },
