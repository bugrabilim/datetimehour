    "qibla.noteNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlar yalnız bu telefonda saklanır, kimseyle paylaşılmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes are kept only on this phone and are not shared with anyone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen bleiben nur auf diesem Telefon und werden mit niemandem geteilt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeydlər yalnız bu telefonda saxlanılır, heç kimlə paylaşılmır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الملاحظات على هذا الهاتف فقط ولا تُشارك مع أحد."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan hanya disimpan di ponsel ini dan tidak dibagikan kepada siapa pun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نوٹس صرف اسی فون میں محفوظ رہتے ہیں اور کسی کے ساتھ شیئر نہیں ہوتے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادداشت‌ها فقط روی همین گوشی می‌مانند و با کسی به اشتراک گذاشته نمی‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes restent uniquement sur ce téléphone et ne sont partagées avec personne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметки хранятся только на этом телефоне и никому не передаются."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモはこの端末にだけ保存され、誰とも共有されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모는 이 휴대폰에만 저장되며 누구와도 공유되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备注只保存在这部手机上，不会与任何人共享。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa teleponong ito lang nakatago ang mga tala at hindi ibinabahagi kaninuman."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกจะเก็บไว้ในโทรศัพท์เครื่องนี้เท่านั้น และไม่แชร์กับใคร"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas se guardan solo en este teléfono y no se comparten con nadie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas ficam apenas neste celular e não são compartilhadas com ninguém."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट केवल इसी फ़ोन में रहते हैं और किसी के साथ साझा नहीं होते।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটগুলো শুধু এই ফোনে থাকে এবং কারও সঙ্গে শেয়ার হয় না।"
          }
        }
      }
    },
