        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto yalnız bu telefonda saxlanılır, geri sayım kartının arxasında göstərilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
