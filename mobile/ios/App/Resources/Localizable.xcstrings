        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga Ramadan ini menenangkan hati Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ رمضان آپ کے دل کو سکون دے۔"
