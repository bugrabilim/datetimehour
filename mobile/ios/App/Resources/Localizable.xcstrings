    "wakegame.empty": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz uyanış yok. Bir alarmı kapattığınızda burada görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No wake-ups yet. They appear here once you dismiss an alarm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Aufwachen. Es erscheint hier, sobald Sie einen Wecker ausschalten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ oyanış yoxdur. Zəngi söndürəndə burada görünəcək."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد استيقاظ بعد. يظهر هنا عند إيقاف منبّه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada catatan bangun. Akan muncul di sini setelah Anda mematikan alarm."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی جاگنا درج نہیں۔ الارم بند کرنے پر یہاں دکھائی دے گا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز بیداری‌ای ثبت نشده. پس از خاموش کردن زنگ اینجا دیده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun réveil pour l'instant. Il apparaîtra ici quand vous arrêterez une alarme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробуждений пока нет. Они появятся здесь, когда вы отключите будильник."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ起床記録はありません。アラームを止めるとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 기상 기록이 없습니다. 알람을 끄면 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有起床记录。关闭闹钟后会显示在这里。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang paggising. Lalabas ito rito kapag pinatay mo ang isang alarm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีการตื่น จะแสดงที่นี่เมื่อคุณปิดนาฬิกาปลุก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay despertares. Aparecen aquí cuando apague una alarma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há despertares. Eles aparecem aqui quando você desligar um alarme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई जागना दर्ज नहीं। अलार्म बंद करने पर यहाँ दिखेगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো জাগা নেই। একটি অ্যালার্ম বন্ধ করলে এখানে দেখা যাবে।"
          }
        }
      }
    },
