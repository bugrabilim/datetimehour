    "dua.voiceNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli okuma telefonun kendi konuşma sesiyle yapılır, insan sesi kaydı değildir. Arapça ses yüklü değilse telefonun ayarlarından indirilebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading aloud uses your phone's own speech voice; it is not a human recording. If no Arabic voice is installed, you can download one in your phone's settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgelesen wird mit der Sprachausgabe Ihres Telefons, nicht mit einer menschlichen Aufnahme. Fehlt eine arabische Stimme, können Sie sie in den Einstellungen des Telefons laden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səsli oxuma telefonun öz danışıq səsi ilə edilir, insan səsi yazısı deyil. Ərəb səsi yoxdursa, telefonun ayarlarından endirə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم القراءة بصوت النطق الخاص بهاتفك، وليست تسجيلًا لصوت بشري. إن لم يكن الصوت العربي مثبتًا فيمكن تنزيله من إعدادات الهاتف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembacaan memakai suara bawaan ponsel Anda, bukan rekaman suara manusia. Jika suara bahasa Arab belum terpasang, Anda dapat mengunduhnya di pengaturan ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آواز میں پڑھائی آپ کے فون کی اپنی آواز سے ہوتی ہے، یہ انسانی آواز کی ریکارڈنگ نہیں۔ اگر عربی آواز موجود نہ ہو تو فون کی سیٹنگز سے ڈاؤن لوڈ کی جا سکتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خواندن با صدای گفتار خود گوشی انجام می‌شود و ضبط صدای انسان نیست. اگر صدای عربی نصب نیست، می‌توانید آن را از تنظیمات گوشی دریافت کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture utilise la voix de synthèse de votre téléphone, ce n'est pas un enregistrement humain. Si aucune voix arabe n'est installée, vous pouvez en télécharger une dans les réglages du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтение выполняется синтезатором речи телефона, это не запись человеческого голоса. Если арабский голос не установлен, его можно загрузить в настройках телефона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げは端末の音声合成で行い、人の声の録音ではありません。アラビア語の音声がない場合は、端末の設定からダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낭독은 휴대폰의 음성 합성으로 하며 사람 목소리 녹음이 아닙니다. 아랍어 음성이 없으면 휴대폰 설정에서 내려받을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朗读使用手机自带的语音合成，并非真人录音。如未安装阿拉伯语语音，可在手机设置中下载。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit sa pagbasa ang sariling boses ng telepono, hindi ito recording ng tao. Kung walang Arabic na boses, maaari itong i-download sa settings ng telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอ่านออกเสียงใช้เสียงสังเคราะห์ของโทรศัพท์ ไม่ใช่เสียงคนที่บันทึกไว้ หากยังไม่มีเสียงภาษาอาหรับ ดาวน์โหลดได้จากการตั้งค่าโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lectura usa la voz sintética de su teléfono; no es una grabación humana. Si no hay una voz árabe instalada, puede descargarla en los ajustes del teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A leitura usa a voz sintética do seu celular; não é uma gravação humana. Se não houver voz em árabe instalada, você pode baixá-la nos ajustes do celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़कर सुनाना आपके फ़ोन की अपनी आवाज़ से होता है, यह किसी इंसान की रिकॉर्डिंग नहीं है। अगर अरबी आवाज़ नहीं है तो फ़ोन की सेटिंग्स से डाउनलोड कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জোরে পড়ার জন্য আপনার ফোনের নিজস্ব কথন কণ্ঠ ব্যবহৃত হয়; এটি মানুষের রেকর্ডিং নয়। কোনো আরবি কণ্ঠ ইনস্টল না থাকলে ফোনের সেটিংসে একটি নামাতে পারেন।"
          }
        }
      }
    },
    "greet.m.cuma.1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumanız mübarek olsun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blessed Friday to you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesegneten Freitag."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cümə gününüz mübarək olsun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جمعة مباركة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat hari Jumat yang penuh berkah."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جمعہ مبارک۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جمعه‌تان مبارک."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joyeux vendredi béni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Благословенной пятницы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "祝福の金曜日をお迎えください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축복받은 금요일 되세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主麻吉庆。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinagpalang Biyernes sa inyo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้เป็นวันศุกร์ที่เปี่ยมด้วยความจำเริญ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendito viernes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abençoada sexta-feira."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जुमा मुबारक।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাকে জুমার শুভেচ্ছা।"
          }
        }
      }
    },
    "greet.m.cuma.2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mübarek Cuma gününüz hayırla dolsun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May this blessed Friday be full of goodness."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möge dieser gesegnete Freitag Ihnen viel Gutes bringen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mübarək cümə gününüz xeyirlə dolsun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جعل الله هذه الجمعة المباركة مليئة بالخير."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga Jumat yang diberkahi ini penuh kebaikan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ مبارک جمعہ خیر و برکت سے بھرا ہو۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این جمعهٔ مبارک سرشار از خیر باشد."
          }
        },
        "fr": {
          "stringUnit": {
