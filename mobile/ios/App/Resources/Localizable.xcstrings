    "account.err.network": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuya ulaşılamadı. İnternet bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach the server. Check your internet connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht erreichbar. Prüfen Sie Ihre Internetverbindung und versuchen Sie es erneut."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverə çatmaq olmadı. İnternet bağlantınızı yoxlayıb yenidən cəhd edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم. تحقّق من اتصالك بالإنترنت وحاول مرة أخرى."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server tidak dapat dihubungi. Periksa koneksi internet Anda dan coba lagi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور تک رسائی نہیں ہو سکی۔ انٹرنیٹ کنکشن دیکھیں اور دوبارہ کوشش کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به سرور ممکن نشد. اتصال اینترنت را بررسی کنید و دوباره تلاش کنید."
          }
