    "photoApp.noForecast": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut tahmini bugün ve sonraki 6 gün için var."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud forecast covers today and the next 6 days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wolkenprognose gilt für heute und die nächsten 6 Tage."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulud proqnozu bu gün və növbəti 6 gün üçündür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقعات السحب متاحة لليوم و6 أيام تالية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prakiraan awan tersedia untuk hari ini dan 6 hari berikutnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بادلوں کی پیش گوئی آج اور اگلے 6 دنوں کے لیے ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌بینی ابر برای امروز و 6 روز آینده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prévision des nuages couvre aujourd'hui et les 6 jours suivants."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогноз облачности — на сегодня и следующие 6 дней."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雲の予報は今日から6日先までです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구름 예보는 오늘과 이후 6일까지입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云量预报涵盖今天及之后6天。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang hula sa ulap ay para sa ngayon at sa susunod na 6 na araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พยากรณ์เมฆมีสำหรับวันนี้และอีก 6 วันถัดไป"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La previsión de nubes abarca hoy y los 6 días siguientes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A previsão de nuvens cobre hoje e os próximos 6 dias."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बादलों का पूर्वानुमान आज और अगले 6 दिनों के लिए है।"
