    "countdowns.calendarDenied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon takvimine izin verilmemiş; Takvim sekmesindeki \"Telefonumdaki takvimleri göster\" ile açabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is off; turn it on with \"Show my phone's calendars\" in the Calendar tab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderzugriff ist aus; aktivieren Sie ihn im Kalender-Tab mit „Kalender meines Telefons anzeigen“."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon təqviminə icazə verilməyib; Təqvim bölməsindəki \"Telefonumdakı təqvimləri göstər\" ilə aça bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى التقويم متوقف؛ فعّله من «إظهار تقويمات هاتفي» في تبويب التقويم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kalender nonaktif; aktifkan dengan \"Tampilkan kalender ponsel saya\" di tab Kalender."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر تک رسائی بند ہے؛ کیلنڈر ٹیب میں «میرے فون کے کیلنڈر دکھائیں» سے آن کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به تقویم خاموش است؛ با «نمایش تقویم‌های گوشی» در زبانهٔ تقویم روشنش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier est désactivé ; activez-le avec « Afficher les calendriers du téléphone » dans l’onglet Calendrier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю выключен; включите его кнопкой «Показать календари телефона» на вкладке «Календарь»."
          }
        }
      }
    },
