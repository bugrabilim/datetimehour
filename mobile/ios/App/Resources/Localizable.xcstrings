    "widget.focus.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü pomodoro odak süresi ve tek dokunuşla 25 dakikalık çalışma."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's pomodoro focus time and a one-tap 25-minute session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heutige Pomodoro-Fokuszeit und eine 25-Minuten-Einheit mit einem Tippen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü pomodoro fokus müddəti və bir toxunuşla 25 dəqiqəlik iş."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت التركيز اليوم بطريقة بومودورو وجلسة 25 دقيقة بلمسة واحدة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu fokus pomodoro hari ini dan sesi 25 menit sekali ketuk."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کا پومودورو توجہ کا وقت اور ایک ٹچ سے 25 منٹ کا سیشن۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان تمرکز پومودورو امروز و جلسهٔ 25 دقیقه‌ای با یک لمس."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps de concentration Pomodoro du jour et séance de 25 minutes d'une touche."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время фокуса по помодоро за сегодня и сессия 25 минут одним касанием."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のポモドーロ集中時間と、ワンタップで始まる25分セッション。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 뽀모도로 집중 시간과 한 번에 시작하는 25분 세션."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的番茄钟专注时长，一键开始 25 分钟专注。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Oras ng pokus sa pomodoro ngayon at 25-minutong sesyon sa isang tap."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาโฟกัสพอโมโดโรวันนี้ และเริ่ม 25 นาทีด้วยการแตะครั้งเดียว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de concentración pomodoro de hoy y una sesión de 25 minutos con un toque."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de foco do pomodoro de hoje e uma sessão de 25 minutos com um toque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का पोमोडोरो फ़ोकस समय और एक टैप में 25 मिनट का सत्र।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের পোমোডোরো মনোযোগের সময় ও এক চাপে 25 মিনিটের সেশন।"
          }
        }
      }
    },
