    },
    "tools.alarm.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Online Alarm Saati: Tekrarlı ve Ertelemeli | Saat Tarih"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online Alarm Clock: Repeating and Snooze | Saat Tarih"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Online-Wecker mit Wiederholung und Schlummerfunktion | Saat Tarih"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onlayn zəngli saat: təkrar və təxirə salma | Saat Tarih"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
