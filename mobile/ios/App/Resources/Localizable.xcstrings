    "sky.superMoon": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dolunayı en yakın noktaya yakın: \"süper ay\" (Ay biraz daha büyük ve parlak görünür)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full moon of %1$@ is close to perigee: a \"supermoon\" (the Moon looks slightly larger and brighter)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vollmond am %1$@ liegt nahe am Perigäum: ein „Supermond“ (der Mond wirkt etwas größer und heller)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarixli bədirlənmə perigeyə yaxındır: \"super ay\" (Ay bir az daha böyük və parlaq görünür)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدر %1$@ قريب من الحضيض: «قمر عملاق» (يبدو القمر أكبر وألمع قليلًا)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulan purnama pada %1$@ terjadi dekat perige: \"supermoon\" (Bulan tampak sedikit lebih besar dan lebih terang)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کا پورا چاند حضیض کے قریب ہے: «سپر مون» (چاند ذرا بڑا اور روشن دکھائی دیتا ہے)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ماه کامل %1$@ نزدیک حضیض است: «ابرماه» (ماه کمی بزرگ‌تر و درخشان‌تر به نظر می‌رسد)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pleine lune du %1$@ est proche du périgée : une « super lune » (la Lune paraît un peu plus grande et plus brillante)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полнолуние %1$@ близко к перигею: «суперлуние» (Луна кажется чуть больше и ярче)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の満月は近地点に近く、「スーパームーン」です（月が少し大きく明るく見えます）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 보름달은 근지점에 가까운 \"슈퍼문\"입니다(달이 조금 더 크고 밝아 보입니다)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@的满月接近近地点，是一次“超级月亮”（月亮看起来稍大、稍亮）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Malapit sa perigee ang kabilugan ng buwan sa %1$@: isang \"supermoon\" (mukhang bahagyang mas malaki at mas maliwanag ang Buwan)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จันทร์เต็มดวงวันที่ %1$@ อยู่ใกล้จุดใกล้โลก: เป็น \"ซูเปอร์มูน\" (ดวงจันทร์ดูใหญ่และสว่างขึ้นเล็กน้อย)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luna llena del %1$@ está cerca del perigeo: una \"superluna\" (la Luna se ve algo más grande y brillante)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lua cheia de %1$@ está perto do perigeu: uma \"superlua\" (a Lua parece um pouco maior e mais brilhante)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ की पूर्णिमा उपभू के पास है: \"सुपरमून\" (चंद्रमा थोड़ा बड़ा और चमकीला दिखता है)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ তারিখের পূর্ণিমা অনুসুরের কাছাকাছি: একটি \"সুপারমুন\" (চাঁদ একটু বড় ও উজ্জ্বল দেখায়)।"
          }
        }
      }
    },
