    "widget.events.permission": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon takviminizi görmek için uygulamada Takvim › Telefonumdaki takvimleri göster'e dokunun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see your phone's calendars, tap Calendar › Show calendars on my phone in the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Kalender Ihres Telefons zu sehen, tippen Sie in der App auf Kalender › Kalender auf meinem Telefon anzeigen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon təqvimini görmək üçün tətbiqdə Təqvim › Telefonumdakı təqvimləri göstər-ə toxunun."
