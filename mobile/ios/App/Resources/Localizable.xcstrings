    "widget.hijri.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün hicri tarihi (Diyanet takvimi) ve miladi tarih."
          }
