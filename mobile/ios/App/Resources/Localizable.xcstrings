        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ویجیٹ کی ترتیبات میں عنوان اور تاریخ منتخب کریں؛ طے شدہ نیا سال۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تنظیمات ابزارک عنوان و تاریخ را برگزینید؛ پیش‌فرض سال نو است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
