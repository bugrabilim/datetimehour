            "value": "Hava durumu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wetter"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava"
          }
        },
