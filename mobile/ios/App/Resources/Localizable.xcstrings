    "alarm.photo.saved": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı. Alarmı kapatmak için aynı yerin fotoğrafını çekeceksiniz (ör. lavabo, kahve makinesi). Fotoğraf saklanmaz, yalnız küçük bir özeti tutulur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. To turn the alarm off you will photograph the same spot (e.g. the sink or coffee machine). The photo is not kept, only a small summary of it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Zum Ausschalten fotografieren Sie dieselbe Stelle (z. B. Waschbecken, Kaffeemaschine). Das Foto wird nicht gespeichert, nur eine kleine Zusammenfassung davon."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saxlanıldı. Siqnalı söndürmək üçün eyni yerin fotosunu çəkəcəksiniz (məs. əlüzyuyan, qəhvə maşını). Foto saxlanmır, yalnız kiçik xülasəsi qalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ. لإيقاف المنبه ستلتقط صورة للمكان نفسه (مثل المغسلة أو آلة القهوة). لا تُحفظ الصورة بل ملخّص صغير منها فقط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tersimpan. Untuk mematikan alarm, Anda akan memotret tempat yang sama (mis. wastafel atau mesin kopi). Foto tidak disimpan, hanya sidik digital kecilnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ ہو گیا۔ الارم بند کرنے کے لیے آپ اسی جگہ (مثلاً سنک یا کافی مشین) کی تصویر لیں گے۔ تصویر خود محفوظ نہیں ہوتی، صرف ایک چھوٹا سا نشان۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ذخیره شد. برای خاموش کردن هشدار از همان جا (مثلاً روشویی یا قهوه‌ساز) عکس می‌گیرید. خود عکس نگه داشته نمی‌شود، فقط اثری کوچک از آن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré. Pour arrêter l’alarme, vous photographierez le même endroit (par ex. le lavabo ou la machine à café). La photo n’est pas conservée, seulement un petit résumé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено. Чтобы выключить будильник, нужно будет сфотографировать то же место (например, раковину или кофемашину). Само фото не хранится, только краткая сводка."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました。アラームを止めるには同じ場所（例：洗面台やコーヒーメーカー）を撮影します。写真は保存されず、小さな特徴データだけが残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장했습니다. 알람을 끄려면 같은 곳(예: 세면대나 커피 머신)을 찍습니다. 사진은 저장되지 않고 작은 요약 정보만 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存。关闭闹钟时需要拍下同一个地方（如洗手池或咖啡机）。照片不会保存，只保留一个很小的特征值。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-save. Para patayin ang alarma, kukunan mo ng larawan ang parehong lugar (hal. lababo o coffee machine). Hindi itinatago ang larawan, maliit na buod lang nito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกแล้ว หากต้องการปิดนาฬิกาปลุก คุณจะต้องถ่ายรูปจุดเดิม (เช่น อ่างล้างหน้าหรือเครื่องชงกาแฟ) ระบบไม่เก็บรูปไว้ เก็บเพียงข้อมูลลักษณะเฉพาะขนาดเล็กของภาพ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada. Para apagar la alarma fotografiará el mismo sitio (p. ej., el lavabo o la cafetera). La foto no se conserva, solo un pequeño resumen de ella."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva. Para desligar o alarme você vai fotografar o mesmo lugar (ex.: a pia ou a cafeteira). A foto não é guardada, só um pequeno resumo dela."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेज ली गई। अलार्म बंद करने के लिए आप उसी जगह (जैसे सिंक या कॉफ़ी मशीन) की फ़ोटो लेंगे। फ़ोटो नहीं रखी जाती, बस उसका छोटा सा सारांश।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত হয়েছে। অ্যালার্ম বন্ধ করতে একই জায়গার ছবি তুলতে হবে (যেমন বেসিন বা কফি মেশিন)। ছবিটি রাখা হয় না, শুধু তার একটি ছোট সারাংশ।"
          }
        }
      }
    },
