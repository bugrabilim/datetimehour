            "value": "%1$@冲日：整夜可见，为全年最亮"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nasa oposisyon: kita buong gabi, pinakamaliwanag ngayong taon"
