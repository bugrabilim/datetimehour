    "onboard.tour.prayer.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kıble pusulası, yakındaki camiler, Kur'an-ı Kerim, dualar, Esmaü'l-Hüsna, zikirmatik, namaz ve oruç takibi. 14 hesap yöntemi ve 973 ilçe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Qibla compass, nearby mosques, the Quran, duas, the 99 Names, a dhikr counter, prayer and fasting tracker. 14 calculation methods and 973 districts of Türkiye."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Qibla-Kompass, Moscheen in der Nähe, der Koran, Bittgebete, die 99 Namen, Dhikr-Zähler, Gebets- und Fastenprotokoll. 14 Berechnungsmethoden und 973 Bezirke der Türkei."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qiblə kompası, yaxınlıqdakı məscidlər, Qurani-Kərim, dualar, Əsmaül-Hüsna, zikrmatik, namaz və oruc izləmə. 14 hesablama üsulu və Türkiyənin 973 rayonu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بوصلة القبلة والمساجد القريبة والقرآن الكريم والأدعية والأسماء الحسنى والمسبحة ومتابعة الصلاة والصيام. 14 طريقة حساب و973 منطقة في تركيا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompas kiblat, masjid terdekat, Al-Qur'an, doa, Asmaul Husna, penghitung tasbih, pencatat salat dan puasa. 14 metode perhitungan dan 973 distrik di Turki."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قبلہ نما، قریبی مساجد، قرآنِ کریم، دعائیں، اسمائے حسنیٰ، تسبیح شمار، نماز اور روزے کا حساب۔ 14 حسابی طریقے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قطب‌نمای قبله، مساجد نزدیک، قرآن کریم، دعاها، اسماءالحسنی، تسبیح‌شمار، پیگیری نماز و روزه. 14 روش محاسبه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boussole de la qibla, mosquées à proximité, le Coran, invocations, les 99 noms, compteur de tasbih, suivi des prières et du jeûne. 14 méthodes de calcul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компас киблы, ближайшие мечети, Коран, дуа, 99 имён, счётчик тасбиха, учёт намазов и постов. 14 методов расчёта."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キブラコンパス、近くのモスク、コーラン、ドゥアー、99の御名、タスビーフカウンター、礼拝と断食の記録。14の計算方法。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키블라 나침반, 가까운 모스크, 꾸란, 두아, 99가지 이름, 타스비흐 카운터, 기도·금식 기록. 14가지 계산 방식."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朝向指南针、附近的清真寺、《古兰经》、祈祷词、99 个尊名、赞念计数器、礼拜与斋戒记录。14 种计算方法。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Qibla compass, kalapit na mosque, ang Quran, mga dua, ang 99 na Pangalan, tasbih counter, tala ng dasal at pag-aayuno. 14 paraan ng pagkalkula."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข็มทิศกิบลัต มัสยิดใกล้เคียง อัลกุรอาน ดุอาอ์ พระนาม 99 ประการ ที่นับตัสบีห์ บันทึกการละหมาดและการถือศีลอด วิธีคำนวณ 14 แบบ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brújula de la alquibla, mezquitas cercanas, el Corán, súplicas, los 99 nombres, contador de dhikr, registro de oraciones y ayunos. 14 métodos de cálculo y 973 distritos de Turquía."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bússola da qibla, mesquitas próximas, o Alcorão, súplicas, os 99 nomes de Alá, contador de dhikr, registro de orações e jejuns. 14 métodos de cálculo e 973 distritos da Turquia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क़िबला कंपास, पास की मस्जिदें, क़ुरआन, दुआएँ, अल्लाह के 99 नाम, तस्बीह काउंटर, नमाज़ और रोज़े का हिसाब। 14 गणना पद्धतियाँ और तुर्किये के 973 ज़िले।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিবলা কম্পাস, কাছের মসজিদ, কুরআন, দোয়া, আল্লাহর 99টি নাম, জিকির কাউন্টার, নামাজ ও রোজার হিসাব। 14টি হিসাব পদ্ধতি এবং তুরস্কের 973টি জেলা।"
          }
        }
      }
    },
