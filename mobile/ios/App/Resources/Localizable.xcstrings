    "weather.alert.colder": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarın bugünden belirgin şekilde soğuk: en yüksek sıcaklık %1$@° düşüyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
