    "notify.cat.fasting.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruçtan önceki akşam 20.00'de. Bayram ve teşrik günleri ile Ramazan atlanır; hicri günler uygulamadaki hicri takvime göredir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At 20:00 the evening before. Eid days, the days of tashriq and Ramadan are skipped; Hijri dates follow the app's Hijri calendar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Vorabend um 20:00. Festtage, die Taschriq-Tage und der Ramadan werden übersprungen; die Hidschri-Daten folgen dem Hidschri-Kalender der App."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Orucdan əvvəlki axşam saat 20:00-da. Bayram və təşriq günləri və Ramazan buraxılır; hicri tarixlər tətbiqdəki hicri təqvimə görədir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الساعة 20:00 مساء اليوم السابق. تُستثنى أيام العيد وأيام التشريق ورمضان؛ والتواريخ الهجرية حسب التقويم الهجري في التطبيق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pukul 20.00 malam sebelumnya. Hari raya, hari tasyrik, dan Ramadan dilewati; tanggal Hijriah mengikuti kalender Hijriah di aplikasi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روزے سے پہلی شام 20:00 بجے۔ عید کے دن، ایامِ تشریق اور رمضان چھوڑ دیے جاتے ہیں؛ ہجری تاریخیں ایپ کے ہجری کیلنڈر کے مطابق ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت 20:00 شب قبل. روزهای عید، ایام تشریق و رمضان کنار گذاشته می‌شوند؛ تاریخ‌های قمری طبق تقویم هجری برنامه است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À 20 h la veille. Les jours de fête, les jours de tachriq et le ramadan sont exclus ; les dates hégiriennes suivent le calendrier hégirien de l’app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В 20:00 накануне. Дни праздников, дни ташрик и Рамадан пропускаются; даты по хиджре — по календарю хиджры в приложении."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前日の夜20:00。祭日、タシュリークの日、ラマダーンは除きます。ヒジュラ暦の日付はアプリのヒジュラ暦によります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전날 저녁 20:00. 명절, 타슈리크 날, 라마단은 건너뜁니다. 히즈라력 날짜는 앱의 히즈라력을 따릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前一天晚上20:00。节日、晒肉日和斋月不提醒；伊斯兰历日期以应用中的伊斯兰历为准。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Alas-20:00 ng gabi bago nito. Nilalaktawan ang mga araw ng Eid, ang mga araw ng tashriq at ang Ramadan; ang mga petsang Hijri ay ayon sa kalendaryong Hijri ng app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลา 20:00 ของคืนก่อนหน้า ข้ามวันอีด วันตัชรีก และเดือนรอมฎอน วันที่ฮิจเราะห์ตามปฏิทินฮิจเราะห์ในแอป"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A las 20:00 de la víspera. Se omiten los días de Eid, los días de tashriq y el ramadán; las fechas hégiras siguen el calendario hégira de la app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Às 20:00 da véspera. Os dias de Eid, os dias de tashriq e o Ramadã são pulados; as datas hijri seguem o calendário hijri do app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली शाम 20:00 बजे। ईद के दिन, तशरीक़ के दिन और रमज़ान छोड़ दिए जाते हैं; हिजरी तारीख़ें ऐप के हिजरी कैलेंडर के अनुसार हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগের সন্ধ্যা 20:00-এ। ঈদের দিন, তাশরিকের দিন ও রমজান বাদ যায়; হিজরি তারিখ অ্যাপের হিজরি ক্যালেন্ডার অনুযায়ী।"
          }
        }
      }
    },
    "fast.monthu": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazartesi ve perşembe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mondays and Thursdays"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Montags und donnerstags"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazar ertəsi və cümə axşamı"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاثنين والخميس"
          }
        },
