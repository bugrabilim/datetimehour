    "cal.countryNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili ülkenin ulusal resmî tatilleri (Nager.Date, MIT); dini günler Diyanet takvimine göre. Veri 2024–2032."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "National public holidays of the selected country (Nager.Date, MIT); religious days follow the Diyanet calendar. Data 2024–2032."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesetzliche Feiertage des gewählten Landes (Nager.Date, MIT); religiöse Tage nach dem Diyanet-Kalender. Daten 2024–2032."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş ölkənin milli rəsmi bayramları (Nager.Date, MIT); dini günlər Diyanət təqviminə görə. Məlumat 2024–2032."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العطلات الرسمية الوطنية للدولة المختارة (Nager.Date، MIT)؛ والأيام الدينية وفق تقويم رئاسة الشؤون الدينية. البيانات 2024–2032."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari libur nasional negara terpilih (Nager.Date, MIT); hari keagamaan mengikuti kalender Diyanet. Data 2024–2032."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب ملک کی قومی سرکاری تعطیلات (Nager.Date، MIT)؛ مذہبی دن دیانت کیلنڈر کے مطابق۔ ڈیٹا 2024–2032۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعطیلات رسمی ملی کشور انتخاب‌شده (Nager.Date، MIT)؛ روزهای مذهبی طبق تقویم دیانت. داده‌ها 2024–2032."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours fériés nationaux du pays choisi (Nager.Date, MIT) ; jours religieux selon le calendrier de la Diyanet. Données 2024–2032."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Государственные праздники выбранной страны (Nager.Date, MIT); религиозные дни по календарю Диянета. Данные 2024–2032."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ国の祝日（Nager.Date、MIT）。宗教上の日はディヤーネットの暦に基づきます。データは2024〜2032年。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 국가의 공휴일(Nager.Date, MIT)이며 종교 기념일은 디야넷 달력 기준입니다. 데이터 2024–2032."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选国家的全国法定假日（Nager.Date，MIT）；宗教节日依据迪亚内特历法。数据 2024–2032。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga pambansang pista opisyal ng napiling bansa (Nager.Date, MIT); ang mga araw na panrelihiyon ay ayon sa kalendaryo ng Diyanet. Datos 2024–2032."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันหยุดราชการของประเทศที่เลือก (Nager.Date, MIT) วันทางศาสนาตามปฏิทินดียาเนต ข้อมูล 2024–2032"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Festivos nacionales del país elegido (Nager.Date, MIT); los días religiosos siguen el calendario de Diyanet. Datos 2024–2032."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feriados nacionais do país escolhido (Nager.Date, MIT); as datas religiosas seguem o calendário da Diyanet. Dados 2024–2032."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने देश की राष्ट्रीय सार्वजनिक छुट्टियाँ (Nager.Date, MIT); धार्मिक दिन दियानत कैलेंडर से। डेटा 2024–2032।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেছে নেওয়া দেশের জাতীয় সরকারি ছুটি (Nager.Date, MIT); ধর্মীয় দিনগুলো দিয়ানেত ক্যালেন্ডার অনুযায়ী। তথ্য 2024–2032।"
          }
        }
      }
    },
