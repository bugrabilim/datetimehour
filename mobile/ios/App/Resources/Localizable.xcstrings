    "tone.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayla gelen, telifsiz sesler. Dinlemek için ▶ simgesine, seçmek için satıra dokunun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Royalty-free sounds that come with the app. Tap ▶ to listen, or tap a row to choose it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lizenzfreie Klänge, die mit der App kommen. Tippen Sie auf ▶ zum Anhören und auf die Zeile zum Auswählen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqlə gələn, müəllif haqqı olmayan səslər. Dinləmək üçün ▶ işarəsinə, seçmək üçün sətrə toxunun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصوات خالية من حقوق النشر تأتي مع التطبيق. المس ▶ للاستماع والمس السطر للاختيار."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara bebas royalti bawaan aplikasi. Ketuk ▶ untuk mendengarkan dan ketuk baris untuk memilih."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ کے ساتھ آنے والی بلا حقوقِ اشاعت آوازیں۔ سننے کے لیے ▶ اور منتخب کرنے کے لیے قطار پر ٹیپ کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صداهای بدون حق نشر که همراه برنامه است. برای شنیدن ▶ و برای انتخاب روی ردیف بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des sons libres de droits fournis avec l'app. Touchez ▶ pour écouter et la ligne pour choisir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звуки без авторских ограничений, входящие в приложение. Нажмите ▶, чтобы прослушать, и строку, чтобы выбрать."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに付属する著作権フリーの音です。▶で試聴、行をタップで選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 포함된 저작권 없는 소리입니다. ▶를 눌러 듣고, 줄을 눌러 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用自带的免版权声音。点 ▶ 试听，点该行即可选择。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga tunog na kasama ng app at walang royalty. I-tap ang ▶ para makinig at ang hanay para pumili."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงปลอดลิขสิทธิ์ที่มากับแอป แตะ ▶ เพื่อฟัง แตะแถวเพื่อเลือก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonidos libres de derechos incluidos en la app. Toque ▶ para escuchar y la fila para elegir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sons livres de royalties que vêm com o app. Toque em ▶ para ouvir e na linha para escolher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप के साथ आने वाली रॉयल्टी-मुक्त आवाज़ें। सुनने के लिए ▶ और चुनने के लिए पंक्ति पर टैप करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপের সঙ্গে আসা রয়্যালটি-মুক্ত শব্দ। শুনতে ▶ চাপুন, বা বাছতে একটি সারিতে চাপুন।"
          }
        }
      }
    },
