    "notify.sound.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli duyuru kısa bir zilden sonra vakti söyler, örneğin \"Öğle vakti geldi.\" Telefon sessizdeyken bildirim yalnız titreşir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The spoken announcement says the prayer after a short chime, for example \"It is time for Dhuhr.\" When the phone is silenced, notifications only vibrate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ansage nennt nach einem kurzen Gong das Gebet, zum Beispiel „Es ist Zeit für Dhuhr.“ Ist das Telefon stumm geschaltet, vibrieren Benachrichtigungen nur."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səsli elan qısa zəngdən sonra vaxtı deyir, məsələn \"Zöhr vaxtı gəldi.\" Telefon səssiz rejimdə olanda bildiriş yalnız titrəyir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكر الإعلان الصوتي الصلاة بعد رنين قصير، مثل «حان وقت الظهر». عندما يكون الهاتف صامتًا يكتفي الإشعار بالاهتزاز."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengumuman suara menyebut salatnya setelah lonceng singkat, misalnya \"Waktunya Zuhur.\" Saat ponsel dalam mode senyap, notifikasi hanya bergetar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زبانی اعلان مختصر گھنٹی کے بعد نماز کا نام بتاتا ہے، مثلاً «ظہر کا وقت ہو گیا۔» فون خاموش ہو تو اطلاعات صرف وائبریٹ کرتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلام گفتاری پس از زنگی کوتاه نام نماز را می‌گوید، مثلاً «وقت نماز ظهر است.» وقتی گوشی بی‌صداست، اعلان‌ها فقط می‌لرزند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’annonce vocale dit la prière après un court carillon, par exemple « C’est l’heure de Dhuhr. » Quand le téléphone est en silencieux, les notifications vibrent seulement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовое объявление называет намаз после короткого сигнала, например «Наступило время Зухр». В беззвучном режиме уведомления только вибрируют."
          }
        }
      }
    },
    "notify.spoken.now": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vakti geldi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is time for %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist Zeit für %1$@."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vaxtı gəldi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حان وقت %1$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktunya %1$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کا وقت ہو گیا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت %1$@ است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est l’heure de %1$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступило время %1$@."
          }
        }
      }
    },
    "notify.spoken.before": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vaktine %2$@ dakika kaldı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ minutes until %1$@."
          }
        },
        "de": {
