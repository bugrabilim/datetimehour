          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun jour particulier ce mois-ci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце особых дней нет."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月は特別な日はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달에는 특별한 날이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月没有特别的日子。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang espesyal na araw ngayong buwan."
          }
        },
        "th": {
