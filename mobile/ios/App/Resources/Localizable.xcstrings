    "account.bumbaNo": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu e-posta adresiyle burada üye olunamaz; başka bir e-posta adresiyle kayıt olabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't sign up here with this email address; you can sign up with a different email address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dieser E-Mail-Adresse ist hier keine Registrierung möglich; Sie können sich mit einer anderen E-Mail-Adresse registrieren."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu e-poçt ünvanı ilə burada üzv olmaq mümkün deyil; başqa e-poçt ünvanı ilə qeydiyyatdan keçə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الاشتراك هنا بهذا البريد الإلكتروني؛ يمكنك الاشتراك ببريد إلكتروني آخر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak dapat mendaftar di sini dengan alamat email ini; Anda dapat mendaftar dengan alamat email lain."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ای میل پتے سے یہاں رکن نہیں بنا جا سکتا؛ آپ کسی اور ای میل پتے سے رکن بن سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با این نشانی ایمیل نمی‌توان اینجا عضو شد؛ می‌توانید با نشانی ایمیل دیگری عضو شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de s'inscrire ici avec cette adresse e-mail ; vous pouvez vous inscrire avec une autre adresse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этим адресом здесь зарегистрироваться нельзя; можно зарегистрироваться с другим адресом электронной почты."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスではここで登録できません。別のメールアドレスで登録できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이메일 주소로는 여기서 가입할 수 없습니다. 다른 이메일 주소로 가입할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法用此邮箱地址在这里注册；您可以用其他邮箱地址注册。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi puwedeng mag-sign up dito gamit ang email address na ito; puwede kayong mag-sign up gamit ang ibang email address."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถสมัครที่นี่ด้วยอีเมลนี้ได้ คุณสมัครด้วยอีเมลอื่นได้"
