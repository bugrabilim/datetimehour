    "widget.daily.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün ayeti, esması, hadisi ya da sözü; her gün değişir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verse, Name of Allah, hadith or saying of the day; changes daily."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers, Name Allahs, Hadith oder Spruch des Tages; täglich neu."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün ayəsi, əsması, hədisi və ya sözü; hər gün dəyişir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آية اليوم أو اسم من الأسماء الحسنى أو الحديث أو الحكمة؛ تتغير يوميًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayat, Asmaul Husna, hadis, atau pepatah hari ini; berganti setiap hari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کی آیت، اسمائے حسنیٰ، حدیث یا قول؛ روز بدلتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آیه، اسم الهی، حدیث یا سخن روز؛ هر روز عوض می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verset, Nom d'Allah, hadith ou maxime du jour ; change chaque jour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аят, имя Аллаха, хадис или изречение дня; меняется ежедневно."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の聖句・美名・ハディース・ことわざ。毎日変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 구절, 아름다운 이름, 하디스, 격언이 매일 바뀝니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每日经文、真主美名、圣训或格言，每天更换。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Talata, Pangalan ng Allah, hadith o kasabihan ng araw; nagbabago araw-araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อายะฮ์ พระนาม หะดีษ หรือคำคมประจำวัน เปลี่ยนทุกวัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aleya, nombre de Alá, hadiz o refrán del día; cambia cada día."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Versículo, nome de Alá, hadith ou ditado do dia; muda todo dia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की आयत, अल्लाह का नाम, हदीस या कहावत; रोज़ बदलती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের আয়াত, আল্লাহর নাম, হাদিস বা বাণী; প্রতিদিন বদলায়।"
          }
        }
      }
    },
