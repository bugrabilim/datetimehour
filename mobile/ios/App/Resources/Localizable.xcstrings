        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授予使用情况访问权限（以了解前台应用）›"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magbigay ng usage access (para makita ang app sa harap) ›"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้สิทธิ์เข้าถึงการใช้งาน (เพื่อรู้ว่าแอปใดอยู่ด้านหน้า) ›"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceder acceso de uso (para ver la app en primer plano) ›"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceder acesso de uso (para ver o app em primeiro plano) ›"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोग की पहुँच दें (सामने वाला ऐप देखने के लिए) ›"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যবহারের তথ্যে অ্যাক্সেস দিন (সামনের অ্যাপ দেখতে) ›"
          }
        }
      }
    },
    "focus.needOverlay": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Diğer uygulamaların üzerinde göster\" iznini ver ›"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow \"Display over other apps\" ›"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Über anderen Apps einblenden“ erlauben ›"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Digər tətbiqlərin üzərində göstər\" icazəsini ver ›"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بـ\"العرض فوق التطبيقات الأخرى\" ›"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan \"Tampilkan di atas aplikasi lain\" ›"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "«دوسری ایپس کے اوپر دکھائیں» کی اجازت دیں ›"
