    "tools.countdown.presentNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre yeşil; son 2 dakikada (kısa sürelerde son beşte birde) sarı; bitince kırmızı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green; amber in the last 2 minutes (the last fifth for short timers); red when time is up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grün; in den letzten 2 Minuten (bei kurzen Zeiten im letzten Fünftel) gelb; rot, wenn die Zeit um ist."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaşıl; son 2 dəqiqədə (qısa müddətlərdə son beşdə birdə) sarı; bitəndə qırmızı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخضر؛ أصفر في آخر دقيقتين (أو في الخُمس الأخير للمدد القصيرة)؛ أحمر عند انتهاء الوقت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hijau; kuning pada 2 menit terakhir (seperlima terakhir untuk waktu singkat); merah saat waktu habis."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سبز؛ آخری 2 منٹ میں (مختصر وقت میں آخری پانچویں حصے میں) پیلا؛ وقت ختم ہونے پر سرخ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سبز؛ در 2 دقیقه آخر (در زمان‌های کوتاه در یک‌پنجم آخر) زرد؛ با پایان زمان قرمز."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vert ; orange pendant les 2 dernières minutes (le dernier cinquième pour les durées courtes) ; rouge à la fin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зелёный; жёлтый в последние 2 минуты (для коротких таймеров — в последнюю пятую часть); красный, когда время вышло."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑。残り2分（短い時間では最後の5分の1）で黄色、時間切れで赤。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초록색, 마지막 2분(짧은 시간은 마지막 5분의 1)에는 노란색, 시간이 끝나면 빨간색."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绿色；最后 2 分钟（短时长为最后五分之一）变黄；时间到变红。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Berde; dilaw sa huling 2 minuto (sa huling ikalima para sa maiikling timer); pula kapag tapos na ang oras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีเขียว เหลืองใน 2 นาทีสุดท้าย (ช่วงหนึ่งในห้าสุดท้ายสำหรับเวลาสั้น) แดงเมื่อหมดเวลา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde; ámbar en los últimos 2 minutos (el último quinto en temporizadores cortos); rojo cuando se acaba el tiempo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde; âmbar nos últimos 2 minutos (o último quinto em temporizadores curtos); vermelho quando o tempo acaba."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हरा; आख़िरी 2 मिनट में पीला (छोटे टाइमर में आख़िरी पाँचवें हिस्से में); समय पूरा होने पर लाल।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবুজ; শেষ 2 মিনিটে হলুদাভ (ছোট টাইমারে শেষ পঞ্চমাংশে); সময় শেষ হলে লাল।"
          }
        }
      }
    },
