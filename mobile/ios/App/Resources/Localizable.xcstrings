    "tools.pomodoro.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz pomodoro zamanlayıcı: 25 dakika çalışma, 5 dakika kısa mola, 4 turda bir uzun mola. Süreler ayarlanabilir, sesli uyarı ve tam ekran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free pomodoro timer: 25 minutes of work, a 5-minute short break and a long break every 4 rounds. Adjustable times, sound alerts and full screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenloser Pomodoro-Timer: 25 Minuten Arbeit, 5 Minuten kurze Pause und alle 4 Runden eine lange Pause. Anpassbare Zeiten, Tonsignal und Vollbild."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsuz pomodoro taymeri: 25 dəqiqə iş, 5 dəqiqəlik qısa fasilə və hər 4 dövrdən sonra uzun fasilə. Tənzimlənən müddətlər, səsli xəbərdarlıq, tam ekran."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مؤقت بومودورو مجاني: 25 دقيقة عمل، واستراحة قصيرة 5 دقائق، واستراحة طويلة كل 4 جولات. مدد قابلة للتعديل وتنبيهات صوتية وملء الشاشة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengatur waktu pomodoro gratis: kerja 25 menit, istirahat pendek 5 menit, dan istirahat panjang setiap 4 putaran. Durasi dapat diatur, peringatan suara, dan layar penuh."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفت پومودورو ٹائمر: 25 منٹ کام، 5 منٹ کا مختصر وقفہ اور ہر 4 راؤنڈ کے بعد لمبا وقفہ۔ قابلِ تبدیل اوقات، آواز والے انتباہ اور پوری اسکرین۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان‌سنج پومودوروی رایگان: 25 دقیقه کار، 5 دقیقه استراحت کوتاه و استراحت طولانی پس از هر 4 دور. مدت‌های قابل تنظیم، هشدار صوتی و تمام‌صفحه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuteur pomodoro gratuit : 25 min de travail, 5 min de pause et une pause longue tous les 4 tours. Durées réglables, alertes sonores et plein écran."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный таймер помидора: 25 минут работы, короткий перерыв 5 минут и длинный перерыв каждые 4 раунда. Настраиваемое время, звуковые сигналы и полный экран."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のポモドーロタイマー：25分の作業、5分の短い休憩、4ラウンドごとの長い休憩。時間の調整、音の通知、全画面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 뽀모도로 타이머: 25분 집중, 5분 짧은 휴식, 4라운드마다 긴 휴식. 시간 조절, 소리 알림, 전체 화면."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费番茄钟：25 分钟工作、5 分钟短休息，每 4 轮一次长休息。可调时长、声音提醒和全屏。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Libreng pomodoro timer: 25 minutong trabaho, 5-minutong maikling pahinga at mahabang pahinga bawat 4 na round. Naaayos na tagal, tunog na paalala at full screen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวจับเวลาโพโมโดโรฟรี: ทำงาน 25 นาที พักสั้น 5 นาที และพักยาวทุก 4 รอบ ปรับเวลาได้ มีเสียงเตือนและโหมดเต็มหน้าจอ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporizador pomodoro gratis: 25 minutos de trabajo, una pausa corta de 5 minutos y una pausa larga cada 4 rondas. Tiempos ajustables, avisos sonoros y pantalla completa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporizador pomodoro grátis: 25 minutos de trabalho, uma pausa curta de 5 minutos e uma pausa longa a cada 4 rodadas. Tempos ajustáveis, alertas sonoros e tela cheia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त पोमोडोरो टाइमर: 25 मिनट काम, 5 मिनट का छोटा ब्रेक और हर 4 राउंड पर लंबा ब्रेक। बदले जा सकने वाले समय, ध्वनि संकेत और फ़ुल स्क्रीन।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিনামূল্যের পোমোডোরো টাইমার: 25 মিনিট কাজ, 5 মিনিটের ছোট বিরতি এবং প্রতি 4 রাউন্ডে একটি দীর্ঘ বিরতি। সময় বদলানো যায়, শব্দের সতর্কতা ও পূর্ণ পর্দা।"
          }
        }
      }
    },
