    "alarm.preBody": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erken uyandıysanız bu çalmayı atlayabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up early? You can skip this one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon wach? Sie können diesen Wecker überspringen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tez oyandınızsa bu çalmanı keçə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيقظت مبكرًا؟ يمكنك تخطي هذا المنبه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah bangun? Anda bisa melewatinya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جلدی جاگ گئے؟ آپ اسے چھوڑ سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زود بیدار شدید؟ می‌توانید این یکی را رد کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà debout ? Vous pouvez la sauter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже встали? Этот можно пропустить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早く起きましたか？このアラームはスキップできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일찍 일어나셨나요? 이 알람은 건너뛸 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经起床了？可以跳过这次闹钟。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaga kang nagising? Maaari mong laktawan ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตื่นเร็วหรือ? ข้ามการปลุกครั้งนี้ได้"
          }
        }
      }
    },
    "alarm.preSkip": {
      "extractionState": "manual",
      "localizations": {
