    "notify.cat.calendar.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resmî tatiller, arifeler, dini ve özel günler, okul tarihleri; o gün sabah 09.00'da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public holidays, eves, religious and special days, school dates; at 9:00 that morning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feiertage, Vorabende, religiöse und besondere Tage, Schultermine; am selben Morgen um 9:00 Uhr."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rəsmi bayramlar, bayram ərəfələri, dini və xüsusi günlər, məktəb tarixləri; həmin gün səhər 09:00-da."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العطل الرسمية وأيام الوقفة والأيام الدينية والخاصة ومواعيد المدارس، في الساعة 9:00 صباح ذلك اليوم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari libur resmi, hari menjelang hari raya, hari keagamaan dan istimewa, tanggal sekolah; pukul 09.00 pagi itu."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرکاری تعطیلات، عید سے پہلے کے دن، مذہبی اور خاص دن، اسکول کی تاریخیں؛ اسی دن صبح 9:00 بجے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعطیلات رسمی، روزهای پیش از تعطیلات، روزهای مذهبی و ویژه، تاریخ‌های مدرسه؛ ساعت 9:00 صبح همان روز."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours fériés, veilles, jours religieux et particuliers, dates scolaires ; à 9 h ce matin-là."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Праздники, кануны, религиозные и особые дни, школьные даты; в 9:00 утром того дня."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "祝日、祝日の前日、宗教上の日と記念日、学校の日程。当日の朝9:00に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공휴일과 그 전날, 종교일과 기념일, 학사 일정. 그날 아침 9:00에."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公共假日、节日前夕、宗教和特别日子、学校日期；当天早上9:00。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga pampublikong holiday, bisperas, relihiyoso at espesyal na araw, petsa ng paaralan; 9:00 ng umagang iyon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันหยุดราชการ วันก่อนวันหยุด วันสำคัญทางศาสนาและวันพิเศษ กำหนดการของโรงเรียน แจ้งเวลา 9:00 ของเช้าวันนั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Festivos, vísperas, días religiosos y especiales, fechas escolares; a las 9:00 de ese día."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feriados, vésperas, datas religiosas e especiais, datas escolares; às 9:00 daquele dia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सार्वजनिक छुट्टियाँ, पूर्व संध्याएँ, धार्मिक और विशेष दिन, स्कूल की तारीखें; उस दिन सुबह 9:00 बजे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সরকারি ছুটি, আগের দিন, ধর্মীয় ও বিশেষ দিন, স্কুলের তারিখ; সেদিন সকাল 9:00-এ।"
          }
        }
      }
    },
