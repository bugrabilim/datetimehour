        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر صرف اسی فون پر رہتی ہے اور الٹی گنتی کے کارڈ کے پیچھے دکھائی دیتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکس فقط روی همین گوشی می‌ماند و پشت کارت شمارش معکوس نمایش داده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo reste uniquement sur ce téléphone et s’affiche derrière la carte du compte à rebours."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото хранится только на этом телефоне и показывается за карточкой отсчёта."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はこのスマホにだけ保存され、カウントダウンのカードの後ろに表示されます。"
