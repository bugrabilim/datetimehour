    "nature.eclipseHere": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Ay o sırada ufkun üstünde, tutulma buradan izlenebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: the Moon is above the horizon then, so the eclipse can be seen from here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Der Mond steht dann über dem Horizont, die Finsternis ist von hier aus sichtbar."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Ay o zaman üfüqün üstündədir, tutulma buradan görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: القمر فوق الأفق حينها، ويمكن رؤية الخسوف من هنا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Bulan saat itu di atas ufuk, jadi gerhana dapat dilihat dari sini."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: اس وقت چاند افق سے اوپر ہوگا، اس لیے گرہن یہاں سے دیکھا جا سکتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: ماه در آن زمان بالای افق است، پس گرفت از اینجا دیده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : la Lune est alors au-dessus de l’horizon, l’éclipse est donc visible d’ici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: в это время Луна над горизонтом, поэтому затмение видно отсюда."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：その時刻に月は地平線の上にあるため、ここから食が見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 그때 달이 지평선 위에 있어 여기서 식을 볼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：届时月亮在地平线以上，可以从这里看到月食。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: nasa itaas ng horizon ang Buwan sa oras na iyon, kaya makikita mula rito ang eklipse."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: ขณะนั้นดวงจันทร์อยู่เหนือขอบฟ้า จึงมองเห็นอุปราคาได้จากที่นี่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: la Luna está entonces sobre el horizonte, así que el eclipse se puede ver desde aquí."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: a Lua estará acima do horizonte nesse momento, então o eclipse pode ser visto daqui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: उस समय चंद्रमा क्षितिज से ऊपर है, इसलिए ग्रहण यहाँ से दिख सकता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: তখন চাঁদ দিগন্তের ওপরে থাকে, তাই এখান থেকে গ্রহণ দেখা যায়।"
          }
        }
      }
    },
    "nature.eclipseNotHere": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Ay o sırada ufkun altında."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: the Moon is below the horizon then."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Der Mond steht dann unter dem Horizont."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Ay o zaman üfüqün altındadır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: القمر تحت الأفق حينها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Bulan saat itu di bawah ufuk."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: اس وقت چاند افق سے نیچے ہوگا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: ماه در آن زمان زیر افق است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : la Lune est alors sous l’horizon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: в это время Луна под горизонтом."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：その時刻に月は地平線の下にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 그때 달이 지평선 아래에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：届时月亮在地平线以下。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: nasa ilalim ng horizon ang Buwan sa oras na iyon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: ขณะนั้นดวงจันทร์อยู่ใต้ขอบฟ้า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: la Luna está entonces bajo el horizonte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: a Lua estará abaixo do horizonte nesse momento."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: उस समय चंद्रमा क्षितिज से नीचे है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: তখন চাঁদ দিগন্তের নিচে থাকে।"
          }
        }
      }
    },
    "nature.eclipseSafety": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş tutulmasına çıplak gözle ya da sıradan güneş gözlüğüyle bakmayın; ISO 12312-2 onaylı tutulma gözlüğü kullanın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never look at a solar eclipse with the naked eye or ordinary sunglasses; use eclipse glasses certified to ISO 12312-2."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schauen Sie nie mit bloßem Auge oder normaler Sonnenbrille in eine Sonnenfinsternis; verwenden Sie eine Finsternisbrille nach ISO 12312-2."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Günəş tutulmasına heç vaxt çılpaq gözlə və ya adi günəş eynəyi ilə baxmayın; ISO 12312-2 sertifikatlı tutulma eynəyindən istifadə edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تنظر إلى كسوف الشمس بالعين المجردة أو بنظارة شمسية عادية؛ استخدم نظارة كسوف معتمدة وفق ISO 12312-2."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan pernah melihat gerhana Matahari dengan mata telanjang atau kacamata hitam biasa; gunakan kacamata gerhana bersertifikat ISO 12312-2."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سورج گرہن کو کبھی ننگی آنکھ یا عام دھوپ کے چشمے سے نہ دیکھیں؛ ISO 12312-2 سے تصدیق شدہ گرہن کے چشمے استعمال کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هرگز با چشم غیرمسلح یا عینک آفتابی معمولی به خورشیدگرفتگی نگاه نکنید؛ از عینک گرفت با گواهی ISO 12312-2 استفاده کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne regardez jamais une éclipse de Soleil à l’œil nu ou avec des lunettes de soleil ordinaires ; utilisez des lunettes d’éclipse certifiées ISO 12312-2."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не смотрите на солнечное затмение невооружённым глазом или через обычные солнцезащитные очки; используйте очки для затмений, сертифицированные по ISO 12312-2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日食を肉眼や普通のサングラスで絶対に見ないでください。ISO 12312-2 に適合した日食グラスを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일식을 맨눈이나 일반 선글라스로 절대 보지 마세요. ISO 12312-2 인증 일식 안경을 쓰세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿用肉眼或普通太阳镜观看日食；请使用符合 ISO 12312-2 认证的日食眼镜。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Huwag tumingin sa eklipse ng araw nang walang proteksyon o gamit ang karaniwang sunglasses; gumamit ng eclipse glasses na sertipikado sa ISO 12312-2."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่ามองสุริยุปราคาด้วยตาเปล่าหรือแว่นกันแดดธรรมดาเด็ดขาด ใช้แว่นดูสุริยุปราคาที่ได้มาตรฐาน ISO 12312-2"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca mire un eclipse de Sol a simple vista ni con gafas de sol normales; use gafas para eclipses certificadas según la norma ISO 12312-2."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca olhe um eclipse solar a olho nu ou com óculos de sol comuns; use óculos para eclipse certificados pela ISO 12312-2."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूर्य ग्रहण को कभी नंगी आँखों या साधारण धूप के चश्मे से न देखें; ISO 12312-2 प्रमाणित ग्रहण चश्मा इस्तेमाल करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কখনো খালি চোখে বা সাধারণ সানগ্লাসে সূর্যগ্রহণ দেখবেন না; ISO 12312-2 সনদপ্রাপ্ত গ্রহণ-চশমা ব্যবহার করুন।"
          }
        }
      }
    },
