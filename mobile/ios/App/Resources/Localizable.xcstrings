    "prayer.method.appNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiye'de resmî vakitler Diyanet'indir. Seçim vakitleri, bildirimleri, alarmları ve aylık çizelgeyi değiştirir; ana ekran widget'ları ve saat Diyanet yöntemiyle kalır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Türkiye the official times are Diyanet's. Your choice changes the times, notifications, alarms and monthly table; home screen widgets and the watch keep the Diyanet method."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Türkei gelten die Zeiten der Diyanet. Die Auswahl ändert Zeiten, Benachrichtigungen, Alarme und Monatstabelle; Widgets und die Uhr bleiben bei der Diyanet-Methode."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiyədə rəsmi vaxtlar Diyanətindir. Seçim vaxtları, bildirişləri, siqnalları və aylıq cədvəli dəyişir; vidcetlər və saat Diyanət üsulu ilə qalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المواقيت الرسمية في تركيا هي مواقيت ديانت. يغيّر اختيارك المواقيت والإشعارات والمنبهات والجدول الشهري؛ وتبقى الأدوات والساعة على طريقة ديانت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Turki waktu resmi adalah milik Diyanet. Pilihan Anda mengubah waktu, notifikasi, alarm, dan tabel bulanan; widget layar utama dan jam tangan tetap memakai metode Diyanet."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترکی میں سرکاری اوقات دیانت کے ہیں۔ آپ کا انتخاب اوقات، اطلاعات، الارم اور ماہانہ جدول بدلتا ہے؛ ہوم اسکرین ویجیٹس اور گھڑی دیانت کا طریقہ برقرار رکھتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در ترکیه اوقات رسمی از آنِ دیانت است. انتخاب شما اوقات، اعلان‌ها، هشدارها و جدول ماهانه را تغییر می‌دهد؛ ابزارک‌های صفحهٔ اصلی و ساعت مچی روش دیانت را نگه می‌دارند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En Turquie, les heures officielles sont celles de la Diyanet. Votre choix modifie les heures, notifications, alarmes et le tableau mensuel ; les widgets de l’écran d’accueil et la montre gardent la méthode de la Diyanet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Турции официальное время — по Diyanet. Ваш выбор меняет время, уведомления, будильники и месячную таблицу; виджеты и часы на руке остаются на методе Diyanet."
          }
        }
      }
    },
