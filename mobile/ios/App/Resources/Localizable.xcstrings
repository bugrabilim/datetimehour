            "value": "اگلے 60 دنوں میں کیلنڈر میں کوئی تقریب نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در 60 روز آینده رویدادی در تقویم نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun événement dans les 60 prochains jours."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ближайшие 60 дней событий нет."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後60日間にカレンダーの予定はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 60일 동안 달력 일정이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来60天内没有日历日程。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang event sa kalendaryo sa susunod na 60 araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีกิจกรรมในปฏิทินใน 60 วันข้างหน้า"
          }
        }
      }
    },
    "countdowns.calendarDenied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon takvimine izin verilmemiş; Takvim sekmesindeki \"Telefonumdaki takvimleri göster\" ile açabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
