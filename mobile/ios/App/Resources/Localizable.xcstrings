    "nature.crescentCats.A": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıplak gözle kolayca görülür"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easily visible to the naked eye"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit bloßem Auge leicht sichtbar"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çılpaq gözlə asanlıqla görünür"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرى بالعين المجردة بسهولة"
          }
        }
      }
    },
    "nature.crescentCats.B": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyi havada çıplak gözle görülür"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible to the naked eye in perfect conditions"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei besten Bedingungen mit bloßem Auge sichtbar"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaxşı havada çılpaq gözlə görünür"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرى بالعين المجردة في ظروف مثالية"
          }
        }
      }
    },
    "nature.crescentCats.C": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce dürbünle bulunursa gözle görülebilir"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May need binoculars to find, then naked eye"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst mit Fernglas finden, dann mit bloßem Auge"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəl durbinlə tapılsa gözlə görünə bilər"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يحتاج منظارًا لتحديده ثم يُرى بالعين"
          }
        }
      }
    },
    "nature.crescentCats.D": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız dürbün ya da teleskopla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Binoculars or telescope only"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur mit Fernglas oder Teleskop"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız durbin və ya teleskopla"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالمنظار أو التلسكوب فقط"
          }
        }
      }
    },
    "nature.crescentCats.E": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleskopla bile görülmez"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not visible even with a telescope"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst mit Teleskop nicht sichtbar"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleskopla belə görünmür"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُرى حتى بالتلسكوب"
          }
        }
      }
    },
    "nature.crescentCats.F": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görülmez"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not visible"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht sichtbar"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünmür"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُرى"
          }
        }
      }
    },
    "nature.crescentNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir tahmindir: bulut, ufuk ve göz keskinliği sonucu değiştirir. Türkiye'de hicri ay başları Diyanet takvimine göredir ve önceden hesapla belirlenir; gözleme dayanan ülkelerde bir gün fark olabilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a prediction: clouds, the horizon and eyesight change the result. In Türkiye Hijri months follow the Diyanet calendar, which is fixed in advance by calculation; countries that rely on sighting may differ by a day."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Vorhersage: Wolken, Horizont und Sehschärfe beeinflussen das Ergebnis. In der Türkei richten sich die Monatsanfänge nach dem Diyanet-Kalender, der vorab berechnet wird; Länder mit Sichtung können um einen Tag abweichen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, proqnozdur: bulud, üfüq və görmə qabiliyyəti nəticəni dəyişir. Türkiyədə hicri ay başlanğıcları əvvəlcədən hesablanan Diyanət təqviminə görədir; müşahidəyə əsaslanan ölkələrdə bir gün fərq ola bilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا توقع؛ الغيوم والأفق وحدة البصر تغيّر النتيجة. في تركيا تتبع بدايات الأشهر الهجرية تقويم ديانت المحسوب مسبقًا، وقد تختلف بيوم في البلدان التي تعتمد الرؤية."
          }
        }
      }
    },
