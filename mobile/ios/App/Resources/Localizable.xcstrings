    "meet.exchangesNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olağan seans saatleri (yerel saatle, hafta içi; Tadawul pazar–perşembe); resmî tatiller hesaba katılmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular session hours (local time, weekdays; Tadawul Sunday–Thursday); public holidays are not taken into account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguläre Handelszeiten (Ortszeit, werktags; Tadawul Sonntag–Donnerstag); Feiertage werden nicht berücksichtigt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Adi seans saatları (yerli vaxtla, iş günləri; Tadawul bazar–cümə axşamı); bayramlar nəzərə alınmır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعات الجلسة العادية (بالتوقيت المحلي، أيام العمل؛ تداول من الأحد إلى الخميس)؛ لا تُحتسب العطل الرسمية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam sesi reguler (waktu setempat, hari kerja; Tadawul Minggu–Kamis); hari libur tidak diperhitungkan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "معمول کے اجلاس کے اوقات (مقامی وقت، کام کے دن؛ تداول اتوار تا جمعرات)؛ سرکاری تعطیلات شامل نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعات جلسه عادی (به وقت محلی، روزهای کاری؛ تداول یکشنبه تا پنجشنبه)؛ تعطیلات رسمی در نظر گرفته نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Horaires de séance ordinaires (heure locale, jours ouvrés ; Tadawul du dimanche au jeudi) ; jours fériés non pris en compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычные часы торгов (местное время, будни; Tadawul — воскресенье–четверг); праздники не учитываются."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の取引時間（現地時間、平日。タダウルは日〜木曜）。祝日は考慮しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정규 거래 시간(현지 시각, 평일, 타다울은 일~목요일)이며 공휴일은 반영하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常规交易时段（当地时间，工作日；沙特交易所为周日至周四）；不考虑法定节假日。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular na oras ng sesyon (lokal na oras, araw ng trabaho; Tadawul Linggo–Huwebes); hindi isinasaalang-alang ang mga pista opisyal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาซื้อขายปกติ (เวลาท้องถิ่น วันทำการ ตลาดทาดาวุลวันอาทิตย์–พฤหัสบดี) ไม่นับวันหยุดราชการ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horario de sesión habitual (hora local, días laborables; Tadawul de domingo a jueves); no se tienen en cuenta los festivos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Horário regular de pregão (hora local, dias úteis; Tadawul de domingo a quinta); os feriados não são considerados."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियमित कारोबारी घंटे (स्थानीय समय, कार्यदिवस; तदावुल रविवार–गुरुवार); सार्वजनिक छुट्टियाँ नहीं गिनी गईं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিয়মিত সেশনের সময় (স্থানীয় সময়, কর্মদিবস; তাদাউল রবিবার–বৃহস্পতিবার); সরকারি ছুটি বিবেচনা করা হয় না।"
          }
        }
      }
    },
