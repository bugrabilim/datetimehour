        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agosto deve seu nome ao imperador romano Augusto."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगस्त का नाम रोमन सम्राट ऑगस्टस के नाम पर है।"
          }
