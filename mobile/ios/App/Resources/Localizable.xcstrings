    "zakat.fitreNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutar Türkiye için ve en düşük ölçüdür; imkânı olan hurma, üzüm gibi daha yüksek ölçüyle verebilir. Fitre bayram namazından önce verilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The amount is for Turkey and is the minimum; those who can may give more (by the measure of dates or raisins). Fitra is given before the Eid prayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betrag gilt für die Türkei und ist das Minimum; wer kann, gibt mehr (nach dem Maß von Datteln oder Rosinen). Die Fitra wird vor dem Festgebet gegeben."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məbləğ Türkiyə üçündür və ən aşağı ölçüdür; imkanı olan xurma, kişmiş kimi daha yüksək ölçü ilə verə bilər. Fitrə bayram namazından əvvəl verilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المبلغ خاص بتركيا وهو الحد الأدنى؛ ومن استطاع أن يعطي أكثر (بمقدار التمر أو الزبيب) فله ذلك. تُخرج زكاة الفطر قبل صلاة العيد."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah ini untuk Turki dan merupakan batas minimal; yang mampu dapat memberi lebih (dengan takaran kurma atau kismis). Zakat fitrah ditunaikan sebelum salat Id."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ رقم ترکی کے لیے ہے اور کم از کم ہے؛ جو استطاعت رکھتے ہیں زیادہ دیں (کھجور یا کشمش کے پیمانے سے)۔ فطرانہ عید کی نماز سے پہلے دیا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این مبلغ برای ترکیه و حداقل است؛ کسانی که توانایی دارند می‌توانند بیشتر بدهند (بر پایهٔ بهای خرما یا کشمش). فطریه پیش از نماز عید پرداخت می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant vaut pour la Turquie et constitue un minimum ; ceux qui en ont les moyens peuvent donner davantage (selon la mesure de dattes ou de raisins secs). La fitra se donne avant la prière de l’Aïd."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма указана для Турции и является минимальной; кто может, даёт больше (исходя из стоимости фиников или изюма). Фитр отдают до праздничного намаза."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額はトルコ向けの最低額です。余裕のある人はそれ以上（ナツメヤシや干しぶどうの量を目安に）支払うことができます。フィトラはイードの礼拝の前に支払います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 금액은 튀르키예 기준 최소액입니다. 여유가 있는 사람은 더 낼 수 있습니다(대추야자나 건포도 기준). 피트라는 이드 예배 전에 냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该金额适用于土耳其，为最低标准；有能力者可多给（按椰枣或葡萄干的量计）。开斋捐应在会礼之前交付。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa Türkiye ang halagang ito at ito ang pinakamababa; maaaring magbigay nang higit ang may kaya (ayon sa sukat ng datiles o pasas). Ibinibigay ang fitra bago ang dasal ng Eid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนนี้สำหรับตุรกีและเป็นขั้นต่ำ ผู้ที่มีความสามารถจ่ายมากกว่าได้ (ตามปริมาณอินทผลัมหรือลูกเกด) ซะกาตฟิฏเราะฮ์ต้องจ่ายก่อนละหมาดอีด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El importe es para Turquía y es el mínimo; quien tenga medios puede dar más (según el valor de los dátiles o las pasas). La fitra se da antes de la oración del Eid."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor é para a Turquia e é o mínimo; quem tiver condições pode dar mais (pela medida de tâmaras ou passas). A fitra é dada antes da oração do Eid."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रकम तुर्किये के लिए है और न्यूनतम है; जो सक्षम हों वे ज़्यादा दे सकते हैं (खजूर या किशमिश के हिसाब से)। फ़ित्रा ईद की नमाज़ से पहले दिया जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিমাণটি তুরস্কের জন্য এবং এটি সর্বনিম্ন; যারা পারেন বেশি দিতে পারেন (খেজুর বা কিশমিশের মাপে)। ফিতরা ঈদের নামাজের আগে দেওয়া হয়।"
          }
        }
      }
    },
