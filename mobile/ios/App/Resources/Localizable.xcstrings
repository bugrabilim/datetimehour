    "hijriConv.rumiNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rumi tarih Jülyen takvimiyle (miladiden 13 gün geri) ve 1 Mart yılbaşıyla yazılır; Türkiye Takvimi geleneği."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Rumi date uses the Julian calendar (13 days behind the Gregorian) with the year starting on 1 March, as in traditional Turkish almanacs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Rumi-Datum folgt dem julianischen Kalender (13 Tage hinter dem gregorianischen), Jahresbeginn 1. März, wie in traditionellen türkischen Almanachen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rumi tarix Yulian təqvimi ilə (miladi təqvimdən 13 gün geri) və 1 mart il başı ilə yazılır; ənənəvi Türkiyə təqvimlərindəki kimi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُكتب التاريخ الرومي بالتقويم اليولياني (متأخرًا 13 يومًا عن الميلادي) وتبدأ السنة في 1 مارس، كما في التقاويم التركية التقليدية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal Rumi memakai kalender Julian (tertinggal 13 hari dari Masehi) dengan tahun baru 1 Maret, seperti almanak Turki tradisional."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رومی تاریخ جولین کیلنڈر (13 دن پیچھے) اور یکم مارچ سے شروع ہونے والے سال کے ساتھ لکھی جاتی ہے، جیسے روایتی ترک تقویم میں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ رومی با تقویم ژولیانی (13 روز عقب‌تر) و آغاز سال از 1 مارس نوشته می‌شود، مانند تقویم‌های سنتی ترکی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date rumi suit le calendrier julien (13 jours de retard) avec une année commençant le 1er mars, comme dans les almanachs turcs traditionnels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Румийская дата записывается по юлианскому календарю (на 13 дней позже) с началом года 1 марта, как в традиционных турецких календарях."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーミー暦はユリウス暦（13日遅れ）で、3月1日に年が始まります（トルコの伝統的な暦と同じ）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루미력은 율리우스력(13일 늦음)을 따르며 3월 1일에 해가 시작됩니다(튀르키예 전통 달력과 같음)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鲁米历采用儒略历（晚 13 天），以 3 月 1 日为岁首，与土耳其传统历书相同。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang petsang Rumi ay sumusunod sa kalendaryong Julian (13 araw na huli) at nagsisimula ang taon sa 1 Marso, gaya ng mga tradisyonal na almanakeng Turko."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินรูมีใช้ปฏิทินจูเลียน (ช้ากว่า 13 วัน) และขึ้นปีใหม่วันที่ 1 มีนาคม ตามปฏิทินดั้งเดิมของตุรกี"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha rumí usa el calendario juliano (13 días por detrás) con el año empezando el 1 de marzo, como en los almanaques turcos tradicionales."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A data rumi usa o calendário juliano (13 dias atrasado em relação ao gregoriano) com o ano começando em 1º de março, como nos almanaques turcos tradicionais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूमी तारीख जूलियन कैलेंडर (13 दिन पीछे) इस्तेमाल करती है और साल 1 मार्च से शुरू होता है, जैसे पारंपरिक तुर्की पंचांगों में।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুমি তারিখ জুলীয় ক্যালেন্ডার (খ্রিস্টীয়র চেয়ে 13 দিন পিছিয়ে) ব্যবহার করে এবং বছর 1 মার্চ শুরু হয়, প্রচলিত তুর্কি পঞ্জিকার মতো।"
          }
        }
      }
    },
