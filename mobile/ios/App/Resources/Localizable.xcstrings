        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дать доступ к истории использования (чтобы видеть активное приложение) ›"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用状況へのアクセスを許可（前面のアプリを知るため）›"
