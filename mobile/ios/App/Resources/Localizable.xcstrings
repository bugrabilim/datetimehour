      }
    },
    "wakegame.privacy": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puanlar ve rapor yalnız bu telefonda tutulur, hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points and the report stay on this phone only and are never sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkte und Bericht bleiben nur auf diesem Telefon und werden nirgendwohin gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xallar və hesabat yalnız bu telefonda saxlanır, heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى النقاط والتقرير على هذا الهاتف فقط ولا تُرسل إلى أي مكان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Poin dan laporan hanya tersimpan di ponsel ini dan tidak dikirim ke mana pun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوائنٹس اور رپورٹ صرف اسی فون پر رہتے ہیں اور کہیں نہیں بھیجے جاتے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امتیازها و گزارش فقط روی همین گوشی می‌ماند و به جایی فرستاده نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points et le rapport restent uniquement sur ce téléphone et ne sont envoyés nulle part."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очки и отчёт хранятся только на этом телефоне и никуда не отправляются."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポイントとレポートはこの端末にのみ保存され、どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인트와 리포트는 이 휴대폰에만 남고 어디에도 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积分和报告只保存在这部手机上，不会发送到任何地方。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa teleponong ito lang naiimbak ang puntos at ulat at hindi ipinapadala kahit saan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คะแนนและรายงานอยู่ในโทรศัพท์เครื่องนี้เท่านั้นและไม่ถูกส่งไปที่ใด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puntos y el informe se quedan solo en este teléfono y nunca se envían a ninguna parte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos e o relatório ficam só neste celular e nunca são enviados a lugar nenhum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंक और रिपोर्ट केवल इसी फ़ोन पर रहते हैं और कहीं नहीं भेजे जाते।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পয়েন্ট ও প্রতিবেদন শুধু এই ফোনে থাকে এবং কখনো কোথাও পাঠানো হয় না।"
          }
        }
      }
    },
    "wakegame.privacyIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puanlar ve rapor yalnız bu cihazda ve iCloud eşitlemesi açıksa kendi iCloud hesabınızda tutulur. iPhone'da kalkış, alarmı kapattıktan sonra uygulamayı açtığınızda ya da kapatma görevini bitirdiğinizde kaydedilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points and the report stay only on this device and, if iCloud sync is on, in your own iCloud account. On iPhone a wake-up is recorded when you open the app after dismissing the alarm or when you finish the dismiss task."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkte und Bericht bleiben auf diesem Gerät und, wenn die iCloud-Synchronisierung aktiv ist, in Ihrem eigenen iCloud-Konto. Auf dem iPhone wird das Aufwachen erfasst, wenn Sie nach dem Ausschalten die App öffnen oder die Weckaufgabe abschließen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xallar və hesabat yalnız bu cihazda və iCloud sinxronizasiyası açıqdırsa, öz iCloud hesabınızda saxlanır. iPhone-da oyanış, zəngi söndürdükdən sonra tətbiqi açanda və ya söndürmə tapşırığını bitirəndə qeyd olunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى النقاط والتقرير على هذا الجهاز، وفي حسابك على iCloud إذا كانت مزامنة iCloud مفعّلة. على iPhone يُسجَّل الاستيقاظ عند فتح التطبيق بعد إيقاف المنبّه أو عند إنهاء مهمة الإيقاف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Poin dan laporan tersimpan di perangkat ini dan, jika sinkronisasi iCloud aktif, di akun iCloud Anda sendiri. Di iPhone, waktu bangun dicatat saat Anda membuka aplikasi setelah mematikan alarm atau menyelesaikan tugas mematikan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوائنٹس اور رپورٹ اسی آلے پر اور اگر iCloud ہم آہنگی آن ہو تو آپ کے اپنے iCloud اکاؤنٹ میں رہتے ہیں۔ آئی فون پر جاگنا اس وقت درج ہوتا ہے جب آپ الارم بند کرنے کے بعد ایپ کھولیں یا بند کرنے کا کام مکمل کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امتیازها و گزارش روی همین دستگاه و اگر همگام‌سازی iCloud روشن باشد، در حساب iCloud خودتان می‌ماند. در آیفون بیداری وقتی ثبت می‌شود که پس از خاموش کردن زنگ برنامه را باز کنید یا کار خاموش‌کردن را تمام کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points et le rapport restent sur cet appareil et, si la synchronisation iCloud est activée, dans votre propre compte iCloud. Sur iPhone, le réveil est enregistré quand vous ouvrez l'app après avoir arrêté l'alarme ou terminé la tâche d'arrêt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очки и отчёт хранятся на этом устройстве и, если включена синхронизация iCloud, в вашей учётной записи iCloud. На iPhone пробуждение записывается, когда вы открываете приложение после отключения будильника или выполняете задание для отключения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポイントとレポートはこのデバイスと、iCloud同期がオンの場合はご自身のiCloudアカウントにのみ保存されます。iPhoneでは、アラームを止めた後にアプリを開くか停止タスクを終えたときに起床が記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인트와 리포트는 이 기기와, iCloud 동기화가 켜져 있으면 본인 iCloud 계정에만 남습니다. iPhone에서는 알람을 끈 뒤 앱을 열거나 끄기 과제를 마치면 기상이 기록됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积分和报告保存在此设备上；如开启 iCloud 同步，也会保存在你自己的 iCloud 账户中。在 iPhone 上，关闭闹钟后打开应用或完成关闭任务时会记录起床。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa device na ito naiimbak ang puntos at ulat at, kung naka-on ang iCloud sync, sa sarili mong iCloud account. Sa iPhone, naitatala ang paggising kapag binuksan mo ang app matapos patayin ang alarm o tinapos ang gawain sa pagpatay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คะแนนและรายงานอยู่ในอุปกรณ์นี้ และหากเปิดการซิงค์ iCloud จะอยู่ในบัญชี iCloud ของคุณเอง บน iPhone การตื่นจะถูกบันทึกเมื่อคุณเปิดแอปหลังปิดนาฬิกาปลุกหรือทำภารกิจปิดปลุกเสร็จ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puntos y el informe se quedan en este dispositivo y, si la sincronización con iCloud está activada, en su propia cuenta de iCloud. En el iPhone un despertar se registra al abrir la app tras apagar la alarma o al terminar la tarea para apagarla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos e o relatório ficam neste aparelho e, se a sincronização com o iCloud estiver ativada, na sua própria conta do iCloud. No iPhone um despertar é registrado quando você abre o app depois de desligar o alarme ou conclui a tarefa para desligar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंक और रिपोर्ट केवल इसी डिवाइस पर और, iCloud सिंक चालू हो तो, आपके अपने iCloud खाते में रहते हैं। iPhone पर अलार्म बंद करके ऐप खोलने या बंद करने का कार्य पूरा करने पर जागना दर्ज होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পয়েন্ট ও প্রতিবেদন শুধু এই ডিভাইসে এবং iCloud সিঙ্ক চালু থাকলে আপনার নিজের iCloud অ্যাকাউন্টে থাকে। iPhone-এ অ্যালার্ম বন্ধ করার পর অ্যাপ খুললে বা বন্ধ করার কাজ শেষ করলে জাগা রেকর্ড হয়।"
          }
        }
      }
    },
