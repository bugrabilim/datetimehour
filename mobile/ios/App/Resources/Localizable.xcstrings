    "tools.alarm.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıda çalışan ücretsiz alarm: saat, etiket, hafta günlerine göre tekrar, 5 dakika erteleme ve bildirim. Alarm sayfa açıkken çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free alarm that runs in your browser: time, label, repeat on chosen weekdays, 5-minute snooze and notifications. The alarm rings while the page is open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenloser Wecker im Browser: Uhrzeit, Bezeichnung, Wiederholung an gewählten Wochentagen, 5 Minuten Schlummern und Benachrichtigungen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Brauzerdə işləyən pulsuz zəngli saat: vaxt, ad, seçilmiş günlərdə təkrar, 5 dəqiqəlik təxirə salma və bildirişlər. Səhifə açıq olduqca çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منبّه مجاني يعمل في متصفحك: الوقت، والتسمية، والتكرار في أيام تختارها، وغفوة 5 دقائق، وإشعارات. يرنّ المنبّه ما دامت الصفحة مفتوحة."
          }
        }
      }
    },
    "tools.alarm.h1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Online alarm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online alarm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Online-Wecker"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onlayn zəngli saat"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منبّه على الإنترنت"
          }
        }
      }
    },
    "tools.alarm.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm saatini ve istediğiniz günleri seçin; saat gelince sesli uyarı çalar ve bildirim gösterilir. Alarmlar bu cihazda saklanır. Tarayıcı kısıtı nedeniyle alarm yalnızca bu sayfa (sekme) açıkken çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an alarm time and the days you want; when the time comes a sound plays and a notification appears. Alarms are stored on this device. Because of browser limits, the alarm only rings while this page (tab) stays open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Weckzeit und die gewünschten Tage; zur eingestellten Zeit ertönt ein Ton und eine Benachrichtigung erscheint. Wecker werden auf diesem Gerät gespeichert. Wegen Einschränkungen des Browsers klingelt der Wecker nur, solange diese Seite (der Tab) geöffnet bleibt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəng vaxtını və istədiyiniz günləri seçin; vaxt çatanda səs çalınır və bildiriş görünür. Zəngli saatlar bu cihazda saxlanılır. Brauzer məhdudiyyətlərinə görə zəngli saat yalnız bu səhifə (tab) açıq qaldıqda çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر وقت المنبّه والأيام التي تريدها؛ وعند حلول الوقت يُشغَّل صوت ويظهر إشعار. وتُحفظ المنبّهات على هذا الجهاز. وبسبب قيود المتصفحات لا يرنّ المنبّه إلا ما دامت هذه الصفحة (التبويب) مفتوحة."
          }
        }
      }
    },
