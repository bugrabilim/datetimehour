    "account.celebrateNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğum gününüzde, üyelik yıl dönümünüzde, yılbaşında ve profildeki ülkenizin bayramlarında kısa bir kutlama. Tanıtım içermez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short greeting on your birthday, your membership anniversary, New Year's Day and the holidays of the country in your profile. No promotion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kurzer Gruß zum Geburtstag, zum Jahrestag Ihrer Mitgliedschaft, zu Neujahr und zu den Feiertagen des Landes in Ihrem Profil. Keine Werbung."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad gününüzdə, üzvlük ildönümünüzdə, Yeni ildə və profildəki ölkənizin bayramlarında qısa təbrik. Reklam yoxdur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تهنئة قصيرة في عيد ميلادك وذكرى عضويتك ورأس السنة وأعياد الدولة المذكورة في ملفك. بلا ترويج."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucapan singkat pada hari ulang tahun, hari jadi keanggotaan, Tahun Baru, dan hari raya negara di profil Anda. Tanpa promosi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی سالگرہ، رکنیت کی سالگرہ، نئے سال اور آپ کے پروفائل والے ملک کے تہواروں پر مختصر مبارکباد۔ کوئی تشہیر نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تبریکی کوتاه در زادروز شما، سالگرد عضویت، آغاز سال میلادی و جشن‌های کشوری که در نمایه‌تان آمده. بدون تبلیغ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un court message pour votre anniversaire, l'anniversaire de votre adhésion, le Nouvel An et les fêtes du pays de votre profil. Sans publicité."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткое поздравление в день рождения, в годовщину членства, в Новый год и в праздники страны из вашего профиля. Без рекламы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誕生日、会員登録の記念日、元日、プロフィールの国の祝日に短いお祝いを送ります。宣伝は含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생일, 가입 기념일, 새해 첫날, 프로필 국가의 공휴일에 짧은 축하를 보냅니다. 광고는 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的生日、注册周年、元旦和个人资料中国家的节日发送简短祝贺。不含推广。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maikling pagbati sa inyong kaarawan, anibersaryo ng inyong membership, Bagong Taon at mga pista ng bansang nasa inyong profile. Walang promosyon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำอวยพรสั้น ๆ ในวันเกิด วันครบรอบสมาชิก วันขึ้นปีใหม่ และวันหยุดของประเทศในโปรไฟล์ ไม่มีโฆษณา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una breve felicitación en su cumpleaños, el aniversario de su membresía, Año Nuevo y las fiestas del país de su perfil. Sin publicidad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma breve felicitação no seu aniversário, no aniversário da sua associação, no Ano-Novo e nos feriados do país do seu perfil. Sem propaganda."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जन्मदिन, सदस्यता की वर्षगाँठ, नए साल और आपकी प्रोफ़ाइल वाले देश के त्योहारों पर छोटी-सी बधाई। कोई प्रचार नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জন্মদিন, সদস্যপদের বার্ষিকী, নববর্ষ এবং প্রোফাইলের দেশের ছুটির দিনে ছোট্ট শুভেচ্ছা। কোনো প্রচার নেই।"
          }
        }
      }
    },
