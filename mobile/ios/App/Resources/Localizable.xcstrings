    "notify.cat.dst.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun saat diliminde saatler ileri ya da geri alınmadan önceki akşam saat 20.00'de."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At 8:00 pm the evening before clocks go forward or back in your phone's time zone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um 20:00 Uhr am Abend, bevor die Uhren in der Zeitzone des Telefons vor- oder zurückgestellt werden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun saat qurşağında saatlar irəli və ya geri çəkilməzdən əvvəlki axşam saat 20:00-da."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الساعة 8:00 مساءً من الليلة السابقة لتقديم الساعة أو تأخيرها في المنطقة الزمنية لهاتفك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pukul 20.00 malam sebelum jam dimajukan atau dimundurkan di zona waktu ponsel Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے فون کے ٹائم زون میں گھڑیاں آگے یا پیچھے ہونے سے ایک دن پہلے شام 8 بجے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت 20:00 شبِ پیش از جلو یا عقب رفتن ساعت در منطقهٔ زمانی گوشی شما."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À 20 h la veille du changement d’heure dans le fuseau de votre téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В 20:00 накануне перевода часов в часовом поясе телефона."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホのタイムゾーンで時計が進む・戻る前日の夜8:00に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰 시간대에서 시계가 앞당겨지거나 되돌려지기 전날 저녁 8:00에."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机所在时区调快或调慢时钟的前一天晚上8:00。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa 8:00 ng gabi bago iusog pasulong o paurong ang orasan sa time zone ng iyong telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลา 20:00 ของคืนก่อนที่นาฬิกาจะเลื่อนในเขตเวลาของโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A las 20:00 de la víspera de que los relojes se adelanten o se atrasen en la zona horaria de su teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Às 20:00 da véspera do dia em que os relógios são adiantados ou atrasados no fuso horário do seu celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके फ़ोन के समय क्षेत्र में घड़ियाँ आगे या पीछे होने से पहले वाली शाम 20:00 बजे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফোনের সময় অঞ্চলে ঘড়ি এগোনো বা পেছানোর আগের সন্ধ্যা রাত 8:00-এ।"
          }
        }
      }
    },
