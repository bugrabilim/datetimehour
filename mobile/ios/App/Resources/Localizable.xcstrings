        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ईमेल पते से यहाँ सदस्य नहीं बना जा सकता; आप किसी दूसरे ईमेल पते से सदस्य बन सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ইমেইল ঠিকানা দিয়ে এখানে সদস্য হওয়া যায় না; অন্য ইমেইল ঠিকানা দিয়ে সদস্য হতে পারেন।"
