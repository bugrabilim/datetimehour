    "intent.date.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün miladi ve hicri tarihini (Diyanet takvimi) söyler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells today's Gregorian and Hijri date (Diyanet calendar)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt das heutige gregorianische und Hidschri-Datum (Diyanet-Kalender)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün miladi və hicri tarixini (Diyanət təqvimi) deyir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك بتاريخ اليوم الميلادي والهجري (تقويم الشؤون الدينية التركية)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyebutkan tanggal Masehi dan Hijriah hari ini (kalender Diyanet)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کی عیسوی اور ہجری تاریخ (دیانت کیلنڈر) بتاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ میلادی و قمری امروز (تقویم دیانت) را می‌گوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne la date grégorienne et hégirienne du jour (calendrier de la Diyanet)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщает сегодняшнюю григорианскую дату и дату по хиджре (календарь Diyanet)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の西暦とヒジュラ暦（ディヤーネット暦）の日付を伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 양력 날짜와 히즈라력 날짜(디야넷 달력)를 알려 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉您今天的公历和伊斯兰历日期（迪亚内特历法）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinasabi ang petsang Gregorian at Hijri ngayon (kalendaryo ng Diyanet)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกวันที่สากลและวันที่ฮิจเราะห์ของวันนี้ (ปฏิทินดียาเนต)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la fecha gregoriana y de la Hégira de hoy (calendario de Diyanet)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa a data gregoriana e da Hégira de hoje (calendário da Diyanet)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की ग्रेगोरियन और हिजरी तारीख (दियानत कैलेंडर) बताता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের খ্রিস্টীয় ও হিজরি তারিখ (দিয়ানেতের ক্যালেন্ডার) জানায়।"
          }
        }
      }
    },
