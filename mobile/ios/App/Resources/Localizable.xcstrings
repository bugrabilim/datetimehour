    "account.syncNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş yaptığınızda kayıtlarınız ve rozetleriniz hesabınıza da yazılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you're signed in, your records and badges are also written to your account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie angemeldet sind, werden Ihre Einträge und Abzeichen auch in Ihr Konto geschrieben."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Daxil olduqda qeydləriniz və nişanlarınız hesabınıza da yazılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تسجيل الدخول تُكتب سجلاتك وشاراتك في حسابك أيضًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Anda masuk, catatan dan lencana Anda juga ditulis ke akun Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن ان ہونے پر آپ کے ریکارڈ اور بیج آپ کے اکاؤنٹ میں بھی لکھے جاتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی وارد شده‌اید، ثبت‌ها و نشان‌های شما در حسابتان هم نوشته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous êtes connecté, vos données et vos badges sont aussi écrits dans votre compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы вошли, ваши записи и значки пишутся и в аккаунт."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン中は、記録とバッジがアカウントにも書き込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 중에는 기록과 배지가 계정에도 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后，您的记录和徽章也会写入账户。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag naka-sign in kayo, isinusulat din sa inyong account ang inyong mga record at badge."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อลงชื่อเข้าใช้ บันทึกและเหรียญตราของคุณจะถูกเขียนลงบัญชีด้วย"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la sesión iniciada, sus registros e insignias también se guardan en su cuenta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a sessão iniciada, seus registros e selos também são gravados na sua conta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन होने पर आपके रिकॉर्ड और बैज आपके खाते में भी लिखे जाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইন ইন থাকলে আপনার রেকর্ড ও ব্যাজ আপনার অ্যাকাউন্টেও লেখা হয়।"
          }
        }
      }
    },
