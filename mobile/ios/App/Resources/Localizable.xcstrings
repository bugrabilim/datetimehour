    "quran.credit": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arapça metin: Tanzil Projesi (CC BY 3.0, değiştirilmeden). İngilizce meal: M. M. Pickthall (1930, kamu malı). Türkçe meal için Diyanet İşleri Başkanlığı'nın Kur'an sitesine bağlantı verilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arabic text: Tanzil Project (CC BY 3.0, unmodified). English translation: M. M. Pickthall (1930, public domain). For a Turkish translation the app links to the Presidency of Religious Affairs (Diyanet) Quran site."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arabischer Text: Tanzil-Projekt (CC BY 3.0, unverändert). Englische Übersetzung: M. M. Pickthall (1930, gemeinfrei). Für eine türkische Übersetzung verweist die App auf die Koran-Website des Diyanet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ərəbcə mətn: Tanzil Layihəsi (CC BY 3.0, dəyişdirilmədən). İngiliscə məal: M. M. Pikthol (1930, ictimai mülkiyyət). Türkcə məal üçün Türkiyə Diyanət İşləri Başqanlığının Quran saytına keçid verilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص العربي: مشروع تنزيل (CC BY 3.0، دون تعديل). الترجمة الإنجليزية: م. م. بكثال (1930، ملك عام). وللترجمة التركية يحيل التطبيق إلى موقع رئاسة الشؤون الدينية التركية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks Arab: Proyek Tanzil (CC BY 3.0, tanpa diubah). Terjemahan Inggris: M. M. Pickthall (1930, domain publik). Untuk terjemahan Turki, aplikasi menautkan ke situs Al-Qur'an Kepresidenan Urusan Agama Turki (Diyanet)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عربی متن: تنزیل پروجیکٹ (CC BY 3.0، بغیر تبدیلی)۔ انگریزی ترجمہ: م۔ م۔ پکتھال (1930، پبلک ڈومین)۔ ترکی ترجمے کے لیے ایپ ترکی کی ریاستِ امورِ دینیہ (دیانت) کی قرآن ویب سائٹ کا لنک دیتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متن عربی: پروژهٔ تنزیل (CC BY 3.0، بدون تغییر). ترجمهٔ انگلیسی: م. م. پیکتال (1930، مالکیت عمومی). برای ترجمهٔ ترکی، برنامه به وب‌سایت قرآن ریاست امور دینی ترکیه (دیانت) پیوند می‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte arabe : projet Tanzil (CC BY 3.0, non modifié). Traduction anglaise : M. M. Pickthall (1930, domaine public). Pour une traduction turque, l’app renvoie au site du Coran de la Présidence des affaires religieuses (Diyanet)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Арабский текст: проект Tanzil (CC BY 3.0, без изменений). Английский перевод: М. М. Пиктолл (1930, общественное достояние). Для турецкого перевода приложение ведёт на сайт Корана Управления по делам религии (Diyanet)."
          }
        }
      }
    },
