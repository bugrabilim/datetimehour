    "widget.config.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakitlerin gösterileceği il. Otomatik seçimde konumunuza en yakın il kullanılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The province whose times are shown. Automatic uses the province nearest to you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Provinz, deren Zeiten angezeigt werden. Automatisch verwendet die nächstgelegene Provinz."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtları göstəriləcək vilayət. Avtomatik seçimdə sizə ən yaxın vilayət istifadə olunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الولاية التي تُعرض أوقاتها. يستخدم الخيار التلقائي أقرب ولاية إليك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Provinsi yang jadwalnya ditampilkan. Otomatis memakai provinsi terdekat dengan Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ صوبہ جس کے اوقات دکھائے جاتے ہیں۔ خودکار آپ کے قریب ترین صوبے کو استعمال کرتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "استانی که اوقاتش نشان داده می‌شود. «خودکار» نزدیک‌ترین استان به شما را به کار می‌برد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La province dont les heures sont affichées. Automatique utilise la province la plus proche de vous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Провинция, для которой показывается время намаза. «Автоматически» — ближайшая к вам провинция."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻を表示する県。自動では最も近い県を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 보여 줄 주. 자동은 가장 가까운 주를 씁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要显示其时间的省份。“自动”会使用离您最近的省份。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang lalawigan kung saan nakabatay ang ipinapakitang oras. Ginagamit ng Awtomatiko ang pinakamalapit na lalawigan sa iyo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จังหวัดที่จะแสดงเวลา แบบอัตโนมัติใช้จังหวัดที่ใกล้คุณที่สุด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La provincia cuyos horarios se muestran. Automática usa la provincia más cercana a su ubicación."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A província cujos horários são mostrados. Automático usa a província mais próxima."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह प्रांत जिसके समय दिखाए जाते हैं। \"अपने-आप\" आपके सबसे पास का प्रांत लेता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে প্রদেশের সময় দেখানো হবে। স্বয়ংক্রিয় বিকল্প আপনার সবচেয়ে কাছের প্রদেশ ব্যবহার করে।"
          }
        }
      }
    },
