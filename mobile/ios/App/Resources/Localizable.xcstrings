        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "освещена на %1$@; в тёмные часы под горизонтом"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輝面%1$@・暗い時間帯は地平線の下"
