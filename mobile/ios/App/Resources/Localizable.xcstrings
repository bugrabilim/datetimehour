    "nature.tableLead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronomik mevsimler, yani ekinoks ve gündönümü anları. Saatler Türkiye saatiyle (UTC+3) verilmiştir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronomical seasons, that is the moments of the equinoxes and solstices. Times are in Turkey time (UTC+3)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronomische Jahreszeiten, also die Zeitpunkte der Tagundnachtgleichen und Sonnenwenden. Die Zeiten gelten in türkischer Zeit (UTC+3)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Astronomik fəsillər, yəni bərabərgünlük və gündönümü anları. Vaxtlar Türkiyə vaxtı ilədir (UTC+3)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفصول الفلكية، أي لحظات الاعتدالين والانقلابين. الأوقات بتوقيت تركيا (UTC+3)."
          }
        }
      }
    },
