          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چهار شهر نخست فهرست ساعت جهانی شما."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quatre premières villes de votre liste d’horloges mondiales."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первые четыре города из вашего списка мирового времени."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界時計リストの最初の4都市。"
          }
        },
        "ko": {
