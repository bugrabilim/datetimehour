    "alarm.chainNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görevler sırayla istenir; rastgele görev her çalmada değişir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks come one after another; a random task changes each time the alarm rings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgaben kommen nacheinander; eine zufällige Aufgabe wechselt bei jedem Wecken."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapşırıqlar ardıcıl istənilir; təsadüfi tapşırıq hər zəngdə dəyişir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطلب المهام واحدة تلو الأخرى؛ والمهمة العشوائية تتغير مع كل رنين."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas diminta satu per satu; tugas acak berganti setiap alarm berbunyi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام ایک کے بعد ایک مانگے جاتے ہیں؛ بے ترتیب کام ہر الارم پر بدلتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارها یکی پس از دیگری خواسته می‌شوند؛ کار تصادفی در هر زنگ عوض می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches sont demandées l'une après l'autre ; une tâche aléatoire change à chaque alarme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задания идут по очереди; случайное меняется при каждом звонке."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクは順番に出され、ランダムなタスクは毎回変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과제는 차례로 나오며, 무작위 과제는 알람마다 바뀝니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务依次出现；随机任务每次响铃都会变化。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isa-isang hinihingi ang mga gawain; nagbabago ang random na gawain bawat alarma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภารกิจจะมาทีละอย่าง ภารกิจสุ่มจะเปลี่ยนทุกครั้งที่ปลุก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas se piden una tras otra; una tarea aleatoria cambia en cada alarma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas são pedidas uma depois da outra; uma tarefa aleatória muda a cada alarme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य एक के बाद एक माँगे जाते हैं; यादृच्छिक कार्य हर अलार्म में बदलता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাজগুলো একটির পর একটি আসে; অ্যালার্ম বাজার প্রতিবার এলোমেলো কাজ বদলায়।"
          }
        }
      }
    },
