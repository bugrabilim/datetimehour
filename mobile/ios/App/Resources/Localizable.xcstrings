            "state": "translated",
            "value": "Alarm at prayer time"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker zur Gebetszeit"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz vaxtında siqnal"
          }
        },
        "ar": {
          "stringUnit": {
