    "nature.eclipseHere": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Ay o sırada ufkun üstünde, tutulma buradan izlenebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: the Moon is above the horizon then, so the eclipse can be seen from here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Der Mond steht dann über dem Horizont, die Finsternis ist von hier aus sichtbar."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Ay o zaman üfüqün üstündədir, tutulma buradan görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: القمر فوق الأفق حينها، ويمكن رؤية الخسوف من هنا."
          }
        }
      }
    },
    "nature.eclipseNotHere": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Ay o sırada ufkun altında."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: the Moon is below the horizon then."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Der Mond steht dann unter dem Horizont."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Ay o zaman üfüqün altındadır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: القمر تحت الأفق حينها."
          }
        }
      }
    },
    "nature.eclipseSafety": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş tutulmasına çıplak gözle ya da sıradan güneş gözlüğüyle bakmayın; ISO 12312-2 onaylı tutulma gözlüğü kullanın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never look at a solar eclipse with the naked eye or ordinary sunglasses; use eclipse glasses certified to ISO 12312-2."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schauen Sie nie mit bloßem Auge oder normaler Sonnenbrille in eine Sonnenfinsternis; verwenden Sie eine Finsternisbrille nach ISO 12312-2."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Günəş tutulmasına çılpaq gözlə və ya adi gün eynəyi ilə baxmayın; ISO 12312-2 təsdiqli tutulma eynəyindən istifadə edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تنظر إلى كسوف الشمس بالعين المجردة أو بنظارة شمسية عادية؛ استخدم نظارة كسوف معتمدة وفق ISO 12312-2."
          }
        }
      }
    },
    "nature.eclipseSource": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak: NASA Tutulma Sitesi (Fred Espenak, NASA/GSFC)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source: NASA Eclipse Web Site (Fred Espenak, NASA/GSFC)."
          }
        },
        "de": {
          "stringUnit": {
