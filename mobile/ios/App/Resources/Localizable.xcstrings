    "float.noteIos": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat, resim içinde resim penceresinde başka uygulamaların üstünde durur; pencereyi sürükleyip küçültebilir ya da kenara itebilirsiniz. Ses çalmaz, internet gerekmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock stays above other apps in a picture-in-picture window; drag, resize or tuck it to the side. It plays no sound and needs no internet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr bleibt in einem Bild-in-Bild-Fenster über anderen Apps; Sie können sie verschieben, in der Größe ändern oder an den Rand schieben. Kein Ton, kein Internet nötig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat şəkil içində şəkil pəncərəsində digər tətbiqlərin üstündə qalır; pəncərəni sürüşdürə, kiçildə və ya kənara itələyə bilərsiniz. Səs çalmır, internet lazım deyil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الساعة فوق التطبيقات الأخرى في نافذة صورة داخل صورة؛ يمكنك سحبها أو تصغيرها أو دفعها إلى الحافة. لا تُصدر صوتًا ولا تحتاج إلى الإنترنت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tetap di atas aplikasi lain dalam jendela gambar-dalam-gambar; seret, ubah ukuran, atau sisihkan ke samping. Tidak memutar suara dan tidak perlu internet."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی تصویر میں تصویر کی کھڑکی میں دوسری ایپس کے اوپر رہتی ہے؛ اسے گھسیٹیں، سائز بدلیں یا کنارے پر چھپا دیں۔ یہ کوئی آواز نہیں بجاتی اور اسے انٹرنیٹ کی ضرورت نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت در پنجرهٔ تصویر در تصویر بالای برنامه‌های دیگر می‌ماند؛ آن را بکشید، اندازه‌اش را تغییر دهید یا کنار بگذارید. صدایی پخش نمی‌کند و اینترنت نمی‌خواهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’horloge reste au-dessus des autres apps dans une fenêtre d’image dans l’image ; faites-la glisser, redimensionnez-la ou rangez-la sur le côté. Elle ne joue aucun son et n’a pas besoin d’Internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы остаются поверх других приложений в окне «картинка в картинке»; перетаскивайте, меняйте размер или убирайте к краю. Они не воспроизводят звук и не требуют интернета."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計はピクチャ・イン・ピクチャのウインドウで他のアプリの上に表示され続けます。ドラッグ、サイズ変更、端へしまうことができます。音は出ず、インターネットも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계가 PIP 창으로 다른 앱 위에 계속 떠 있습니다. 끌어서 옮기고 크기를 바꾸거나 화면 가장자리로 숨길 수 있습니다. 소리가 없고 인터넷도 필요 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时钟以画中画窗口停留在其他应用上方；可拖动、调整大小或收到边上。不播放声音，也无需联网。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nananatili ang orasan sa ibabaw ng ibang app sa isang picture-in-picture na window; hilahin, baguhin ang laki o itabi sa gilid. Walang tunog at hindi kailangan ng internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาอยู่เหนือแอปอื่นในหน้าต่างภาพซ้อนภาพ ลาก ปรับขนาด หรือซ่อนไว้ข้างจอได้ ไม่มีเสียงและไม่ต้องใช้อินเทอร์เน็ต"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj se queda sobre otras apps en una ventana de imagen dentro de imagen; arrástrelo, cambie su tamaño o escóndalo a un lado. No reproduce sonido ni necesita internet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio fica por cima de outros apps numa janela de picture-in-picture; arraste, redimensione ou esconda na borda da tela. Ele não toca som nem precisa de internet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी पिक्चर-इन-पिक्चर विंडो में दूसरे ऐप के ऊपर रहती है; उसे खींचें, आकार बदलें या किनारे छिपाएँ। यह न आवाज़ चलाती है न इंटरनेट माँगती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়িটি পিকচার-ইন-পিকচার জানালায় অন্য অ্যাপের ওপরে থাকে; টেনে সরান, আকার বদলান বা পাশে গুটিয়ে রাখুন। এটি কোনো শব্দ বাজায় না এবং ইন্টারনেট লাগে না।"
          }
        }
      }
    },
    "float.noteAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat, başka uygulamaların üstünde küçük bir pencerede durur; sürükleyerek taşıyın, bildirimden kapatın. İlk açışta \"Diğer uygulamaların üzerinde göster\" izni istenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock stays above other apps in a small window; drag it to move it and close it from the notification. The first time, the \"Display over other apps\" permission is requested."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr bleibt in einem kleinen Fenster über anderen Apps; zum Verschieben ziehen, über die Benachrichtigung schließen. Beim ersten Mal wird die Berechtigung „Über anderen Apps einblenden“ angefordert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat digər tətbiqlərin üstündə kiçik pəncərədə qalır; sürüşdürərək daşıyın, bildirişdən bağlayın. İlk dəfə \"Digər tətbiqlərin üzərində göstər\" icazəsi istənilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الساعة فوق التطبيقات الأخرى في نافذة صغيرة؛ اسحبها لتحريكها وأغلقها من الإشعار. في المرة الأولى يُطلب إذن «العرض فوق التطبيقات الأخرى»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tetap di atas aplikasi lain dalam jendela kecil; seret untuk memindahkannya dan tutup dari notifikasi. Saat pertama kali, izin \"Tampilkan di atas aplikasi lain\" akan diminta."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی ایک چھوٹی کھڑکی میں دوسری ایپس کے اوپر رہتی ہے؛ جگہ بدلنے کے لیے اسے گھسیٹیں اور اطلاع سے بند کریں۔ پہلی بار «دوسری ایپس کے اوپر دکھائیں» کی اجازت مانگی جاتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت در پنجره‌ای کوچک بالای برنامه‌های دیگر می‌ماند؛ برای جابه‌جایی بکشیدش و از اعلان ببندیدش. بار نخست اجازهٔ «نمایش روی برنامه‌های دیگر» خواسته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’horloge reste au-dessus des autres apps dans une petite fenêtre ; faites-la glisser pour la déplacer et fermez-la depuis la notification. La première fois, l’autorisation « Afficher par-dessus les autres applis » est demandée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы остаются поверх других приложений в маленьком окне; перетащите, чтобы переместить, и закройте из уведомления. В первый раз запрашивается разрешение «Поверх других приложений»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計は小さなウインドウで他のアプリの上に表示され続けます。ドラッグで移動し、通知から閉じます。初回は「他のアプリの上に重ねて表示」の許可を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계가 작은 창으로 다른 앱 위에 계속 떠 있습니다. 끌어서 옮기고 알림에서 닫으세요. 처음에는 \"다른 앱 위에 표시\" 권한을 요청합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时钟以小窗口停留在其他应用上方；拖动可移动，从通知中关闭。首次会请求“显示在其他应用上层”权限。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nananatili ang orasan sa ibabaw ng ibang app sa maliit na window; hilahin para ilipat at isara mula sa abiso. Sa unang beses, hihingin ang pahintulot na \"Display over other apps\"."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาอยู่เหนือแอปอื่นในหน้าต่างเล็ก ลากเพื่อย้าย และปิดได้จากการแจ้งเตือน ครั้งแรกจะขอสิทธิ์ \"แสดงทับแอปอื่น\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj se queda sobre otras apps en una ventana pequeña; arrástrelo para moverlo y ciérrelo desde la notificación. La primera vez se pide el permiso \"Mostrar sobre otras apps\"."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio fica por cima de outros apps numa janela pequena; arraste para mover e feche pela notificação. Na primeira vez é pedida a permissão \"Sobrepor a outros apps\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी एक छोटी विंडो में दूसरे ऐप के ऊपर रहती है; खिसकाने के लिए खींचें और सूचना से बंद करें। पहली बार \"दूसरे ऐप के ऊपर दिखाएँ\" अनुमति माँगी जाती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়িটি একটি ছোট জানালায় অন্য অ্যাপের ওপরে থাকে; সরাতে টেনে নিন এবং নোটিফিকেশন থেকে বন্ধ করুন। প্রথমবার \"অন্য অ্যাপের ওপরে দেখানো\" অনুমতি চাওয়া হয়।"
          }
        }
      }
    },
    "float.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz resim içinde resmi desteklemiyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not support picture in picture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät unterstützt Bild-in-Bild nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz şəkil içində şəkli dəstəkləmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجهاز لا يدعم صورة داخل صورة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini tidak mendukung gambar-dalam-gambar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آلہ تصویر میں تصویر کو سپورٹ نہیں کرتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این دستگاه از تصویر در تصویر پشتیبانی نمی‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne prend pas en charge l’image dans l’image."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство не поддерживает «картинку в картинке»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末はピクチャ・イン・ピクチャに対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 PIP를 지원하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不支持画中画。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sinusuportahan ng device na ito ang picture in picture."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้ไม่รองรับภาพซ้อนภาพ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no admite imagen dentro de imagen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aparelho não suporta picture-in-picture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस पिक्चर-इन-पिक्चर नहीं चलाता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইস পিকচার-ইন-পিকচার সমর্থন করে না।"
          }
        }
      }
    },
