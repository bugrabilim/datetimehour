    "notify.adhan.credit.medina": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezan kaydı: ejaz215 (Freesound), Wikimedia Commons, CC BY 3.0; ilk cümle, kısaltıldı ve ses düzeyi eşitlendi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adhan recording: ejaz215 (Freesound), Wikimedia Commons, CC BY 3.0; first phrase, trimmed and loudness-normalised."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adhan-Aufnahme: ejaz215 (Freesound), Wikimedia Commons, CC BY 3.0; erster Satz, gekürzt und in der Lautstärke angeglichen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Azan qeydi: ejaz215 (Freesound), Wikimedia Commons, CC BY 3.0; ilk cümlə, qısaldılıb və səs səviyyəsi bərabərləşdirilib."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الأذان: ejaz215 (Freesound)، ويكيميديا كومنز، CC BY 3.0؛ الجملة الأولى، مقتطعة ومعادلة الصوت."
          }
        },
        "id": {
