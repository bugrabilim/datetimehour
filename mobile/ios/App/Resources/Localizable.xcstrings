    "notify.cat.dst.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun saat diliminde saatler ileri ya da geri alınmadan önceki akşam saat 20.00'de."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At 8:00 pm the evening before clocks go forward or back in your phone's time zone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um 20:00 Uhr am Abend, bevor die Uhren in der Zeitzone des Telefons vor- oder zurückgestellt werden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun saat qurşağında saatlar irəli və ya geri çəkilməzdən əvvəlki axşam saat 20:00-da."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الساعة 8:00 مساءً من الليلة السابقة لتقديم الساعة أو تأخيرها في المنطقة الزمنية لهاتفك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pukul 20.00 malam sebelum jam dimajukan atau dimundurkan di zona waktu ponsel Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے فون کے ٹائم زون میں گھڑیاں آگے یا پیچھے ہونے سے پہلی شام 8 بجے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت 20:00 شبِ پیش از جلو یا عقب رفتن ساعت در منطقهٔ زمانی گوشی شما."
          }
        },
        "fr": {
