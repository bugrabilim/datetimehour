    "sky.tipMoon": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay parlak: sönük yıldızlar ve meteorlar zor görülür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bright Moon: faint stars and meteors are hard to see."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heller Mond: schwache Sterne und Meteore sind schwer zu sehen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay parlaqdır: sönük ulduzlar və meteorlar çətin görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القمر ساطع: يصعب رؤية النجوم الخافتة والشهب."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulan terang: bintang redup dan meteor sulit terlihat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چاند روشن ہے: مدھم ستارے اور شہابیے مشکل سے نظر آتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ماه پرنور است: ستاره‌های کم‌نور و شهاب‌ها سخت دیده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lune brillante : les étoiles faibles et les météores sont difficiles à voir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Яркая Луна: слабые звёзды и метеоры видны плохо."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月が明るく、暗い星や流星は見えにくいでしょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달이 밝아 어두운 별과 유성이 잘 보이지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月光明亮：暗星和流星不易看到。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maliwanag ang Buwan: mahirap makita ang malalabong bituin at meteor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดวงจันทร์สว่าง ดาวจางและดาวตกมองเห็นยาก"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna brillante: las estrellas débiles y los meteoros se ven mal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lua brilhante: estrelas fracas e meteoros ficam difíceis de ver."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चमकीला चंद्रमा: धुँधले तारे और उल्काएँ मुश्किल से दिखेंगी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উজ্জ্বল চাঁদ: ক্ষীণ তারা ও উল্কা দেখা কঠিন।"
          }
        }
      }
    },
    "sky.tipDark": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay karanlıkta gökte değil: sönük yıldızlar için iyi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Moon is down during darkness: good for faint stars."
