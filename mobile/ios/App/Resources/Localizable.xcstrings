    "digital.styleNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LED ve LCD'de sönük bölütler de görünür; dikey görünümde saat, dakika ve saniye alt alta durur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LED and LCD show the unlit segments too; the vertical style stacks hours, minutes and seconds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LED und LCD zeigen auch die unbeleuchteten Segmente; vertikal stehen Stunden, Minuten und Sekunden untereinander."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "LED və LCD-də sönük seqmentlər də görünür; şaquli görünüşdə saat, dəqiqə və saniyə alt-alta durur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض LED وLCD المقاطع المطفأة أيضًا؛ والعمودي يرتب الساعات والدقائق والثواني فوق بعضها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "LED dan LCD juga menampilkan segmen yang padam; vertikal menyusun jam, menit, dan detik ke bawah."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "LED اور LCD میں بجھے ہوئے حصے بھی دکھتے ہیں؛ عمودی انداز میں گھنٹے، منٹ اور سیکنڈ اوپر نیچے آتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در LED و LCD بخش‌های خاموش هم دیده می‌شوند؛ حالت عمودی ساعت، دقیقه و ثانیه را زیر هم می‌چیند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les styles LED et LCD montrent aussi les segments éteints ; le style vertical empile heures, minutes et secondes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В LED и LCD видны и погасшие сегменты; вертикальный стиль ставит часы, минуты и секунды друг под другом."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LEDとLCDでは消えたセグメントも見えます。縦は時・分・秒を縦に並べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LED와 LCD는 꺼진 세그먼트도 보여 주며, 세로는 시·분·초를 위아래로 쌓습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LED 和 LCD 也会显示未点亮的笔段；竖排把时、分、秒上下排列。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Makikita rin sa LED at LCD ang mga patay na segment; pinapatong ng patayo ang oras, minuto at segundo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "LED และ LCD แสดงส่วนที่ดับด้วย แนวตั้งเรียงชั่วโมง นาที และวินาทีลงมา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LED y LCD muestran también los segmentos apagados; el vertical apila horas, minutos y segundos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "LED e LCD mostram também os segmentos apagados; o vertical empilha horas, minutos e segundos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LED और LCD बुझे हिस्से भी दिखाते हैं; खड़ी शैली घंटे, मिनट और सेकंड ऊपर-नीचे रखती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "LED ও LCD নিভে থাকা অংশগুলোও দেখায়; উল্লম্ব ধরনে ঘণ্টা, মিনিট ও সেকেন্ড ওপর-নিচে সাজানো।"
          }
        }
      }
    },
