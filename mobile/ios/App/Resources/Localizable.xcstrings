    "perms.exactAlarm.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verirseniz alarm, vakit ve zamanlayıcı saniyesinde gelir. Vermezseniz birkaç dakika gecikebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you allow it, alarms, prayer times and timers arrive to the second. If not, they may be a few minutes late."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie zustimmen, kommen Wecker, Gebetszeiten und Timer sekundengenau. Sonst können sie einige Minuten zu spät sein."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcazə versəniz, zəngli saat, vaxt və taymer saniyəsində gəlir. Verməsəniz, bir neçə dəqiqə gecikə bilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن سمحت، تصل المنبّهات وأوقات الصلاة والمؤقّتات بدقة الثانية. وإن لم تسمح، قد تتأخر بضع دقائق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diizinkan, alarm, waktu salat, dan pengatur waktu datang tepat ke detiknya. Jika tidak, bisa terlambat beberapa menit."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازت دیں تو الارم، اوقات اور ٹائمر سیکنڈ تک درست آئیں گے۔ نہ دیں تو چند منٹ کی تاخیر ہو سکتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اجازه دهید، هشدار، اوقات و زمان‌سنج با دقت ثانیه می‌رسند. اگر ندهید، ممکن است چند دقیقه دیر شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous l'autorisez, alarmes, heures de prière et minuteurs arrivent à la seconde près. Sinon, ils peuvent avoir quelques minutes de retard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если разрешите, будильники, время намаза и таймеры сработают секунда в секунду. Если нет, возможна задержка на несколько минут."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可すると、アラームや礼拝時刻、タイマーが秒単位で正確に届きます。許可しないと数分遅れることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 알람, 기도 시간, 타이머가 초 단위로 정확히 와요. 허용하지 않으면 몇 분 늦을 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许后，闹钟、礼拜时间和计时器精确到秒；不允许则可能晚几分钟。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung papayagan, eksakto sa segundo ang alarm, oras ng dasal at timer. Kung hindi, maaaring mahuli nang ilang minuto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าอนุญาต การปลุก เวลาละหมาด และตัวจับเวลาจะตรงถึงวินาที ถ้าไม่อนุญาตอาจช้าไปไม่กี่นาที"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo permite, alarmas, horarios de oración y temporizadores llegan al segundo. Si no, pueden retrasarse unos minutos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se permitir, alarmes, horários de oração e temporizadores chegam no segundo exato. Se não, podem atrasar alguns minutos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति दें तो अलार्म, नमाज़ के समय और टाइमर सेकंड तक सटीक आएँगे। न दें तो कुछ मिनट की देर हो सकती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি দিলে অ্যালার্ম, নামাজের সময় ও টাইমার সেকেন্ড ধরে আসে। না দিলে কয়েক মিনিট দেরি হতে পারে।"
          }
        }
      }
    },
