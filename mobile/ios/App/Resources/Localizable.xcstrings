            "value": "عورتیں دونوں پاؤں دائیں طرف نکال کر زمین پر بیٹھتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زنان هر دو پا را به سمت راست بیرون آورده روی زمین می‌نشینند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les femmes s'assoient au sol, les deux pieds sortis vers la droite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Женщины сидят на полу, выведя обе стопы вправо."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "女性は両足を右側に出して床に座ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여성은 두 발을 오른쪽으로 빼고 바닥에 앉습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "女性双脚移向右侧，坐于地上。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Umuupo ang babae sa sahig nang nakalabas ang dalawang paa sa kanan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้หญิงนั่งบนพื้นโดยยื่นเท้าทั้งสองไปทางขวา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mujeres se sientan en el suelo con ambos pies hacia el lado derecho."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mulheres sentam no chão com os dois pés para o lado direito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महिलाएँ ज़मीन पर बैठती हैं और दोनों पैर दाईं ओर निकाल लेती हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নারীরা দুই পা ডান দিকে বের করে মাটিতে বসেন।"
          }
        }
      }
    },
