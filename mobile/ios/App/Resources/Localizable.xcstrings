    "features.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat her zaman açık. Açtığın özellikler alt çubukta görünür; hepsi kapalıysa alt çubuk gizlenir, ayarlar saat ekranındaki dişliden açılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is always on. Features you turn on appear in the bottom bar; with all of them off the bar is hidden and settings open from the gear on the clock screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr ist immer an. Eingeschaltete Funktionen erscheinen in der unteren Leiste; sind alle aus, wird die Leiste ausgeblendet und die Einstellungen öffnen sich über das Zahnrad auf dem Uhrbildschirm."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat həmişə açıqdır. Açdığın xüsusiyyətlər alt zolaqda görünür; hamısı bağlı olduqda alt zolaq gizlənir, ayarlar saat ekranındakı dişli ilə açılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة مفعّلة دائمًا. تظهر الميزات التي تفعّلها في الشريط السفلي؛ وإذا عُطّلت كلها يختفي الشريط وتُفتح الإعدادات من رمز الترس في شاشة الساعة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam selalu aktif. Fitur yang Anda nyalakan muncul di bilah bawah; jika semuanya mati, bilah disembunyikan dan pengaturan dibuka dari ikon roda gigi di layar jam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی ہمیشہ آن رہتی ہے۔ آپ کی آن کی ہوئی خصوصیات نیچے کی بار میں دکھتی ہیں؛ سب بند ہوں تو بار چھپ جاتی ہے اور ترتیبات گھڑی کی اسکرین کے گیئر سے کھلتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت همیشه روشن است. ویژگی‌هایی که روشن می‌کنید در نوار پایین ظاهر می‌شوند؛ اگر همه خاموش باشند نوار پنهان است و تنظیمات از چرخ‌دندهٔ صفحهٔ ساعت باز می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’horloge est toujours active. Les fonctions que vous activez apparaissent dans la barre du bas ; si elles sont toutes désactivées, la barre est masquée et les réglages s’ouvrent avec la roue dentée de l’écran de l’horloge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы включены всегда. Включённые функции появляются в нижней панели; если все выключены, панель скрыта, а настройки открываются шестерёнкой на экране часов."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計は常にオンです。オンにした機能は下のバーに表示されます。すべてオフのときはバーが隠れ、設定は時計画面の歯車から開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계는 항상 켜져 있습니다. 켠 기능은 아래 바에 나타나며, 모두 끄면 바가 숨겨지고 설정은 시계 화면의 톱니바퀴에서 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时钟始终开启。您打开的功能会出现在底部栏；全部关闭时底部栏隐藏，设置从时钟界面的齿轮打开。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Laging naka-on ang orasan. Lumalabas sa bottom bar ang mga feature na i-on mo; kapag naka-off lahat, nakatago ang bar at bubukas ang settings mula sa gear sa screen ng orasan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาเปิดอยู่เสมอ ฟีเจอร์ที่คุณเปิดจะแสดงในแถบด้านล่าง หากปิดทั้งหมด แถบจะซ่อนและเปิดการตั้งค่าได้จากรูปเฟืองบนหน้าจอนาฬิกา"
          }
        }
      }
    },
