    "tools.stopwatch.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Online Kronometre: Tur Kayıtlı ve Tam Ekran | Saat Tarih"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online Stopwatch with Laps and Full Screen | Saat Tarih"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Online-Stoppuhr mit Rundenzeiten und Vollbild | Saat Tarih"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onlayn saniyəölçən: dövrə vaxtları və tam ekran | Saat Tarih"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعة إيقاف أونلاين مع اللفات وملء الشاشة | Saat Tarih"
          }
        }
      }
    },
    "tools.stopwatch.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz online kronometre: tur kaydı, en iyi ve en yavaş tur, tam ekran ve klavye kısayolları. Sayfayı yenileseniz de süre kaybolmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free online stopwatch: lap times, best and slowest lap, full screen and keyboard shortcuts. Your time is kept even if you reload the page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose Online-Stoppuhr: Rundenzeiten, schnellste und langsamste Runde, Vollbild und Tastenkürzel. Ihre Zeit bleibt auch beim Neuladen erhalten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsuz onlayn saniyəölçən: dövrə vaxtları, ən yaxşı və ən yavaş dövrə, tam ekran və klaviatura qısayolları. Səhifəni yeniləsəniz də vaxt itmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعة إيقاف مجانية على الإنترنت: أوقات اللفات، وأسرع لفة وأبطؤها، وملء الشاشة، واختصارات لوحة المفاتيح. ويُحفظ وقتك حتى لو أعدت تحميل الصفحة."
          }
        }
      }
    },
    "tools.stopwatch.h1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Online kronometre"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online stopwatch"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Online-Stoppuhr"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onlayn saniyəölçən"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعة إيقاف على الإنترنت"
          }
        }
      }
    },
    "tools.stopwatch.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kronometre saniyenin yüzde biri hassasiyetle çalışır, tur sürelerini kaydeder ve sayfayı yenileseniz ya da kapatıp açsanız bile sürenizi korur. Boşluk tuşu başlatır ve durdurur, L tur ekler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stopwatch is accurate to a hundredth of a second, records lap times and keeps your time even if you reload or close and reopen the page. Space starts and stops it, L adds a lap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stoppuhr misst auf die Hundertstelsekunde genau, erfasst Rundenzeiten und behält Ihre Zeit, auch wenn Sie die Seite neu laden oder schließen und wieder öffnen. Mit der Leertaste starten und stoppen Sie, mit L erfassen Sie eine Runde."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saniyəölçən saniyənin yüzdə biri dəqiqliyi ilə işləyir, dövrə vaxtlarını qeyd edir və səhifəni yeniləsəniz, yaxud bağlayıb yenidən açsanız belə vaxtınızı saxlayır. Boşluq düyməsi başladır və dayandırır, L dövrə əlavə edir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقيس ساعة الإيقاف الوقت بدقة جزء من مئة من الثانية، وتسجّل أوقات اللفات، وتحفظ وقتك حتى لو أعدت تحميل الصفحة أو أغلقتها ثم فتحتها. مفتاح المسافة يشغّلها ويوقفها، ومفتاح L يضيف لفة."
          }
        }
      }
    },
