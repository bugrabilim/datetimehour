    "timers.multiNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden çok zamanlayıcı aynı anda çalışabilir; her biri süresi dolunca ayrı alarm çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several timers can run at once; each rings its own alarm when it ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Timer können gleichzeitig laufen; jeder klingelt am Ende einzeln."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir neçə taymer eyni anda işləyə bilər; hər biri bitəndə ayrıca zəng çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تشغيل عدة مؤقتات معًا؛ ويرن كل منها عند انتهائه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa pengatur waktu bisa berjalan bersamaan; masing-masing membunyikan alarmnya sendiri saat selesai."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کئی ٹائمر ایک ساتھ چل سکتے ہیں؛ ہر ایک ختم ہونے پر اپنا الارم بجاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چند تایمر می‌توانند هم‌زمان کار کنند؛ هر کدام در پایان هشدار خودش را به صدا درمی‌آورد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs minuteurs peuvent tourner en même temps ; chacun sonne sa propre alarme à la fin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько таймеров могут работать одновременно; каждый по окончании звонит своим сигналом."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のタイマーを同時に動かせます。それぞれ終わると自分のアラームが鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 타이머를 동시에 돌릴 수 있으며, 각각 끝나면 자기 알람이 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以同时运行多个计时器；每个结束时会响起各自的闹钟。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring tumakbo nang sabay ang ilang timer; bawat isa ay may sariling alarma pagkatapos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวจับเวลาหลายตัวทำงานพร้อมกันได้ แต่ละตัวจะปลุกของตัวเองเมื่อหมดเวลา"
          }
        }
      }
    },
