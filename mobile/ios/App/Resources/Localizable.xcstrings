    "account.ayriQ": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu e-postayla başka bir Bumba ürününde ayrı bir hesabınız da var. Hesapları bağlayalım mı?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You also have a separate account in another Bumba product with this email. Shall we link the accounts?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dieser E-Mail haben Sie in einem anderen Bumba-Produkt auch ein separates Konto. Sollen wir die Konten verknüpfen?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu e-poçtla başqa bir Bumba məhsulunda ayrıca hesabınız da var. Hesabları birləşdirək?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك أيضًا حساب منفصل في منتج آخر من Bumba بهذا البريد. هل نربط الحسابين؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda juga memiliki akun terpisah di produk Bumba lain dengan email ini. Hubungkan kedua akun?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ای میل سے کسی اور Bumba پروڈکٹ میں آپ کا ایک الگ اکاؤنٹ بھی ہے۔ کیا دونوں اکاؤنٹس جوڑ دیں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با این ایمیل در محصول دیگری از Bumba حساب جداگانه‌ای هم دارید. حساب‌ها را پیوند دهیم؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez aussi un compte séparé dans un autre produit Bumba avec cet e-mail. Relier les comptes ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этим адресом у вас есть и отдельный аккаунт в другом продукте Bumba. Связать аккаунты?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスでは別の Bumba 製品にも個別のアカウントがあります。アカウントを連携しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이메일로 다른 Bumba 제품에도 별도 계정이 있습니다. 계정을 연결할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您用此邮箱在另一个 Bumba 产品中还有一个独立账户。要关联这两个账户吗？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May hiwalay rin kayong account sa ibang produkto ng Bumba gamit ang email na ito. Pagdugtungin ba natin ang mga account?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีเมลนี้มีบัญชีแยกอีกบัญชีในผลิตภัณฑ์อื่นของ Bumba ด้วย ต้องการเชื่อมบัญชีไหม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con este correo también tiene una cuenta aparte en otro producto de Bumba. ¿Vinculamos las cuentas?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com este e-mail você também tem uma conta separada em outro produto Bumba. Vamos vincular as contas?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ईमेल से किसी दूसरे Bumba उत्पाद में आपका एक अलग खाता भी है। क्या दोनों खाते जोड़ दें?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ইমেইলে অন্য একটি Bumba পণ্যে আপনার আলাদা একটি অ্যাকাউন্টও আছে। অ্যাকাউন্টগুলো যুক্ত করব?"
          }
        }
      }
    },
    "account.ayriNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlamak için o hesabın şifresini yazın. Hesaplar bağlanınca en eski üye numarası kalır ve şifreniz o hesabınki olur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To link them, enter that account's password. Once linked, the oldest member number stays and your password becomes that account's password."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie zum Verknüpfen das Passwort jenes Kontos ein. Danach bleibt die älteste Mitgliedsnummer, und Ihr Passwort ist das jenes Kontos."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Birləşdirmək üçün o hesabın şifrəsini yazın. Birləşdikdən sonra ən köhnə üzv nömrəsi qalır və şifrəniz o hesabınkı olur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للربط اكتب كلمة مرور ذلك الحساب. بعد الربط يبقى أقدم رقم عضوية وتصبح كلمة مرورك هي كلمة مرور ذلك الحساب."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menghubungkan, tulis kata sandi akun tersebut. Setelah terhubung, nomor anggota tertua yang dipakai dan kata sandi Anda menjadi kata sandi akun tersebut."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جوڑنے کے لیے اس اکاؤنٹ کا پاس ورڈ لکھیں۔ جڑنے کے بعد سب سے پرانا رکنیت نمبر رہے گا اور آپ کا پاس ورڈ اسی اکاؤنٹ کا ہو جائے گا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای پیوند، گذرواژهٔ آن حساب را بنویسید. پس از پیوند، قدیمی‌ترین شمارهٔ عضویت می‌ماند و گذرواژهٔ شما گذرواژهٔ آن حساب می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les relier, saisissez le mot de passe de ce compte. Une fois reliés, le plus ancien numéro de membre est conservé et votre mot de passe devient celui de ce compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы связать их, введите пароль того аккаунта. После связывания сохранится самый ранний номер участника, а вашим паролем станет пароль того аккаунта."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連携するには、そのアカウントのパスワードを入力してください。連携後は最も古い会員番号が残り、パスワードはそのアカウントのものになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결하려면 그 계정의 비밀번호를 입력하세요. 연결 후에는 가장 오래된 회원 번호가 남고 비밀번호는 그 계정의 것이 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联时请输入该账户的密码。关联后保留最早的会员编号，您的密码将改为该账户的密码。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pagdugtungin, isulat ang password ng account na iyon. Kapag nadugtong, maiiwan ang pinakalumang numero ng miyembro at ang inyong password ay magiging password ng account na iyon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเชื่อม ให้กรอกรหัสผ่านของบัญชีนั้น เมื่อเชื่อมแล้วจะใช้หมายเลขสมาชิกที่เก่าที่สุด และรหัสผ่านจะเป็นของบัญชีนั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para vincularlas, escriba la contraseña de esa cuenta. Una vez vinculadas, se conserva el número de miembro más antiguo y su contraseña pasa a ser la de esa cuenta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para vincular, digite a senha daquela conta. Depois de vinculadas, fica o número de membro mais antigo e sua senha passa a ser a daquela conta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़ने के लिए उस खाते का पासवर्ड लिखें। जुड़ने के बाद सबसे पुराना सदस्य नंबर रहेगा और आपका पासवर्ड उसी खाते का हो जाएगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যুক্ত করতে সেই অ্যাকাউন্টের পাসওয়ার্ড লিখুন। যুক্ত হওয়ার পর সবচেয়ে পুরোনো সদস্য নম্বরটি থাকবে এবং আপনার পাসওয়ার্ড হবে সেই অ্যাকাউন্টের পাসওয়ার্ড।"
          }
        }
      }
    },
