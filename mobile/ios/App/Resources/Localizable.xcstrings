          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinculado ao seu plano de sono: muda quando o plano muda."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी नींद की योजना से जुड़ा: योजना बदलने पर यह भी बदलता है।"
          }
        },
        "bn": {
