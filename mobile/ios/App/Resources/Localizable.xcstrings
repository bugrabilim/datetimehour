    "kids.south.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünyanın öbür yarısında tersi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flipped on the other half of the world"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der anderen Erdhälfte umgekehrt"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünyanın o biri yarısında tərsinə"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفصول معكوسة في النصف الآخر من العالم"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terbalik di belahan bumi lain"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دنیا کے دوسرے حصے میں الٹا"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در نیمهٔ دیگر جهان برعکس است"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’envers de l’autre côté du monde"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На другой половине Земли — наоборот"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地球の反対側では季節が逆"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지구 반대편에서는 거꾸로"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地球另一边正好相反"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Baligtad sa kabilang bahagi ng mundo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีกซีกโลกหนึ่งกลับกัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al revés en la otra mitad del mundo"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao contrário na outra metade do mundo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दुनिया के दूसरे आधे हिस्से में उलटा"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পৃথিবীর অন্য অর্ধেকে উল্টো"
          }
        }
      }
    },
    "kids.south.text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biz kıştayken Avustralya, Güney Afrika ve Arjantin'de yaz yaşanır. Oradaki çocuklar yılbaşını çoğu zaman plajda kutlar!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While we have winter, it's summer in Australia, South Africa and Argentina. Kids there often celebrate New Year on the beach!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn bei uns Winter ist, ist in Australien, Südafrika und Argentinien Sommer. Kinder dort feiern Neujahr oft am Strand!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Biz qışda olanda Avstraliya, Cənubi Afrika və Argentinada yaydır. Oradakı uşaqlar Yeni ili çox vaxt çimərlikdə qeyd edir!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يكون عندنا شتاء، يكون الصيف في أستراليا وجنوب أفريقيا والأرجنتين. وكثيرًا ما يحتفل الأطفال هناك برأس السنة على الشاطئ!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat belahan utara mengalami musim dingin, Australia, Afrika Selatan, dan Argentina mengalami musim panas. Anak-anak di sana sering merayakan Tahun Baru di pantai!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب ہمارے ہاں سردی ہوتی ہے تو آسٹریلیا، جنوبی افریقہ اور ارجنٹینا میں گرمی ہوتی ہے۔ وہاں بچے اکثر نیا سال ساحل پر مناتے ہیں!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی ما زمستان داریم، در استرالیا، آفریقای جنوبی و آرژانتین تابستان است. بچه‌های آنجا اغلب سال نو را کنار ساحل جشن می‌گیرند!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand c’est l’hiver chez nous, c’est l’été en Australie, en Afrique du Sud et en Argentine. Là-bas, les enfants fêtent souvent le Nouvel An à la plage !"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда у нас зима, в Австралии, Южной Африке и Аргентине лето. Дети там часто встречают Новый год на пляже!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こちらが冬のとき、オーストラリアや南アフリカ、アルゼンチンは夏です。そこの子どもたちは、お正月を海辺で迎えることもよくあります！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우리가 겨울일 때 호주, 남아프리카공화국, 아르헨티나는 여름이에요. 그곳 아이들은 바닷가에서 새해를 맞기도 해요!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们这里是冬天时，澳大利亚、南非和阿根廷正是夏天。那里的孩子常常在海滩上过新年！"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag taglamig sa hilaga, tag-araw naman sa Australia, South Africa at Argentina. Madalas magdiwang ng Bagong Taon sa dalampasigan ang mga bata roon!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะที่ซีกโลกเหนือเป็นฤดูหนาว ออสเตรเลีย แอฟริกาใต้ และอาร์เจนตินาเป็นฤดูร้อน เด็ก ๆ ที่นั่นมักฉลองปีใหม่ที่ชายหาด!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando en el hemisferio norte es invierno, en Argentina, Chile, Australia y Sudáfrica es verano. ¡Allí muchos niños celebran el Año Nuevo en la playa!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando é inverno no hemisfério norte, é verão no Brasil, na Argentina, na Austrália e na África do Sul. Muitas crianças desses países comemoram o Ano-Novo na praia!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब उत्तरी गोलार्ध में सर्दी होती है, तब ऑस्ट्रेलिया, दक्षिण अफ़्रीका और अर्जेंटीना में गर्मी होती है। वहाँ बच्चे अक्सर नया साल समुद्र किनारे मनाते हैं!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমাদের যখন শীত, অস্ট্রেলিয়া, দক্ষিণ আফ্রিকা ও আর্জেন্টিনায় তখন গ্রীষ্ম। সেখানকার শিশুরা প্রায়ই সমুদ্রসৈকতে নববর্ষ উদযাপন করে!"
          }
        }
      }
    },
