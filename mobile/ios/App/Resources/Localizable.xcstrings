    "perms.speech.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız \"sesli oku\" alarm görevinde; tanıma telefonda yapılır, hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for the \"read aloud\" alarm task; recognition runs on your phone and is sent nowhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für die Weckaufgabe „Laut vorlesen“; die Erkennung läuft im Telefon und wird nirgendwohin gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız \"səsli oxu\" tapşırığında; tanıma telefonda aparılır, heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمهمة «اقرأ بصوت عالٍ» فقط؛ يجري التعرّف داخل هاتفك ولا يُرسَل إلى أي مكان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk tugas alarm \"baca keras\"; pengenalan dilakukan di ponsel dan tidak dikirim ke mana pun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف «بلند آواز سے پڑھیں» کام کے لیے؛ شناخت فون پر ہوتی ہے، کہیں نہیں بھیجی جاتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط برای کار «بلند بخوانید»؛ تشخیص روی گوشی انجام می‌شود و به جایی فرستاده نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour la tâche « lire à voix haute » ; la reconnaissance se fait sur le téléphone et n'est envoyée nulle part."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для задания «прочитать вслух»; распознавание идёт на телефоне и никуда не отправляется."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「声に出して読む」タスク専用です。認識は端末内で行い、どこにも送りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'소리 내어 읽기' 과제에만 써요. 인식은 휴대폰에서 이뤄지고 어디로도 보내지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于“大声朗读”任务；识别在手机上完成，不会发送到任何地方。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lang sa gawaing \"basahin nang malakas\"; sa telepono ginagawa ang pagkilala at walang ipinapadala kahit saan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เฉพาะภารกิจ \"อ่านออกเสียง\" การรู้จำทำในโทรศัพท์และไม่ส่งไปที่ใด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para la tarea «leer en voz alta»; el reconocimiento se hace en el teléfono y no se envía a ningún sitio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para a tarefa \"ler em voz alta\"; o reconhecimento é feito no celular e não é enviado a lugar nenhum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ अलार्म के \"ज़ोर से पढ़ें\" काम के लिए; पहचान फ़ोन पर होती है, कहीं भेजी नहीं जाती।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু \"জোরে পড়ুন\" অ্যালার্মের কাজের জন্য; চেনার কাজ আপনার ফোনেই চলে এবং কোথাও পাঠানো হয় না।"
          }
        }
      }
    },
