    "list.popupTitle": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta listesi aydınlatma metni"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email list privacy notice"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutzhinweis zur E-Mail-Liste"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poçt siyahısı üzrə məlumatlandırma mətni"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار الخصوصية للقائمة البريدية"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan privasi daftar email"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ای میل فہرست کا رازداری نوٹس"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعیهٔ حریم خصوصی فهرست ایمیل"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice d’information de la liste de diffusion"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомление о конфиденциальности для рассылки"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールリストのプライバシーに関するお知らせ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 목록 개인정보 안내"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件列表隐私说明"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Paunawa sa privacy ng email list"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประกาศความเป็นส่วนตัวของรายชื่ออีเมล"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de privacidad de la lista de correo"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de privacidade da lista de e-mail"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ईमेल सूची की गोपनीयता सूचना"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইমেইল তালিকার গোপনীয়তা বিজ্ঞপ্তি"
          }
        }
      }
    },
    "list.popupText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta adresiniz, yalnızca bu listeye abone edilmeniz için Bumba Teknoloji Limited Şirketi tarafından işlenir. İstediğiniz zaman tek tıkla ayrılabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email address is processed by Bumba Teknoloji Limited Şirketi only to subscribe you to this list. You can unsubscribe at any time with one click."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre E-Mail-Adresse wird von der Bumba Teknoloji Limited Şirketi ausschließlich verarbeitet, um Sie in diese Liste einzutragen. Sie können sich jederzeit mit einem Klick abmelden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poçt ünvanınız yalnız bu siyahıya abunə olmağınız üçün Bumba Teknoloji Limited Şirketi tərəfindən emal olunur. İstənilən vaxt bir kliklə abunəlikdən çıxa bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعالج شركة Bumba Teknoloji Limited Şirketi عنوان بريدك الإلكتروني فقط لاشتراكك في هذه القائمة. يمكنك إلغاء الاشتراك في أي وقت بنقرة واحدة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat email Anda diproses oleh Bumba Teknoloji Limited Şirketi hanya untuk mendaftarkan Anda ke daftar ini. Anda dapat berhenti berlangganan kapan saja dengan satu klik."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ای میل پتہ Bumba Teknoloji Limited Şirketi صرف آپ کو اس فہرست میں شامل کرنے کے لیے پروسیس کرتی ہے۔ آپ کسی بھی وقت ایک کلک سے رکنیت ختم کر سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشانی ایمیل شما را Bumba Teknoloji Limited Şirketi فقط برای عضویت شما در این فهرست پردازش می‌کند. هر زمان بخواهید با یک کلیک می‌توانید لغو اشتراک کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre adresse e-mail est traitée par Bumba Teknoloji Limited Şirketi uniquement pour vous inscrire à cette liste. Vous pouvez vous désinscrire à tout moment en un clic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш адрес электронной почты обрабатывает Bumba Teknoloji Limited Şirketi только для подписки на эту рассылку. Отписаться можно в любой момент одним нажатием."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスは Bumba Teknoloji Limited Şirketi が、このリストへの登録のためだけに処理します。ワンクリックでいつでも登録を解除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 주소는 Bumba Teknoloji Limited Şirketi가 이 목록 구독을 위해서만 처리합니다. 언제든 클릭 한 번으로 구독을 취소할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的电子邮箱由 Bumba Teknoloji Limited Şirketi 处理，仅用于为您订阅此列表。您可以随时一键退订。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinoproseso ng Bumba Teknoloji Limited Şirketi ang iyong email address para lang maisali ka sa listahang ito. Puwede kang mag-unsubscribe anumang oras sa isang click."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumba Teknoloji Limited Şirketi ประมวลผลที่อยู่อีเมลของคุณเพื่อเพิ่มคุณเข้าในรายชื่ออีเมลนี้เท่านั้น ยกเลิกการรับได้ทุกเมื่อด้วยการคลิกครั้งเดียว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumba Teknoloji Limited Şirketi trata su dirección de correo solo para suscribirle a esta lista. Puede darse de baja en cualquier momento con un clic."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bumba Teknoloji Limited Şirketi trata o seu endereço de e-mail apenas para inscrevê-lo nesta lista. Você pode cancelar a inscrição a qualquer momento com um clique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumba Teknoloji Limited Şirketi आपका ईमेल पता केवल आपको इस सूची में जोड़ने के लिए संसाधित करती है। आप एक क्लिक में कभी भी सदस्यता छोड़ सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ইমেইল ঠিকানা Bumba Teknoloji Limited Şirketi শুধু আপনাকে এই তালিকায় যুক্ত করার জন্য প্রক্রিয়া করে। যেকোনো সময় এক ক্লিকে সদস্যপদ বাতিল করতে পারবেন।"
          }
        }
      }
    },
