          "stringUnit": {
            "state": "translated",
            "value": "আপনার স্বপ্নগুলো একে একে পূরণ হোক।"
          }
        }
      }
    },
    "greet.wish.5": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gününüz aydınlık olsun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May every day be bright for you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möge jeder Ihrer Tage hell sein."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər gününüz işıqlı olsun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عسى أن تكون أيامك كلها مشرقة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga setiap hari Anda cerah."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ہر دن روشن ہو۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر روزتان روشن باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que chacun de vos jours soit lumineux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть каждый ваш день будет светлым."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日が明るい日でありますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일이 밝은 날이길 바랍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "愿您每天都阳光明媚。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawa'y maliwanag ang bawat araw mo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้ทุกวันสดใส"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que cada uno de sus días sea luminoso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que todos os seus dias sejam luminosos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका हर दिन रोशन हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রতিটি দিন উজ্জ্বল হোক।"
          }
        }
      }
    },
