    "quran.credit": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arapça metin: Tanzil Projesi (CC BY 3.0, değiştirilmeden). İngilizce meal: M. M. Pickthall (1930, kamu malı). Türkçe meal için Diyanet İşleri Başkanlığı'nın Kur'an sitesine bağlantı verilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arabic text: Tanzil Project (CC BY 3.0, unmodified). English translation: M. M. Pickthall (1930, public domain). For a Turkish translation the app links to the Presidency of Religious Affairs (Diyanet) Quran site."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arabischer Text: Tanzil-Projekt (CC BY 3.0, unverändert). Englische Übersetzung: M. M. Pickthall (1930, gemeinfrei). Für eine türkische Übersetzung verweist die App auf die Koran-Website des Diyanet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ərəbcə mətn: Tanzil Layihəsi (CC BY 3.0, dəyişdirilmədən). İngiliscə məal: M. M. Pikthol (1930, ictimai mülkiyyət). Türkcə məal üçün Türkiyə Diyanət İşləri Başqanlığının Quran saytına keçid verilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص العربي: مشروع تنزيل (CC BY 3.0، دون تعديل). الترجمة الإنجليزية: م. م. بكثال (1930، ملك عام). وللترجمة التركية يحيل التطبيق إلى موقع القرآن الكريم التابع لرئاسة الشؤون الدينية التركية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks Arab: Proyek Tanzil (CC BY 3.0, tanpa diubah). Terjemahan Inggris: M. M. Pickthall (1930, domain publik). Untuk terjemahan Turki, aplikasi menautkan ke situs Al-Qur'an Kepresidenan Urusan Agama Turki (Diyanet)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عربی متن: تنزیل پروجیکٹ (CC BY 3.0، بغیر تبدیلی)۔ انگریزی ترجمہ: م۔ م۔ پکتھال (1930، پبلک ڈومین)۔ ترکی ترجمے کے لیے ایپ ترکی کی ریاستِ امورِ دینیہ (دیانت) کی قرآن ویب سائٹ کا لنک دیتی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متن عربی: پروژهٔ تنزیل (CC BY 3.0، بدون تغییر). ترجمهٔ انگلیسی: م. م. پیکتال (1930، مالکیت عمومی). برای ترجمهٔ ترکی، برنامه به وب‌سایت قرآن ریاست امور دینی ترکیه (دیانت) پیوند می‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte arabe : projet Tanzil (CC BY 3.0, non modifié). Traduction anglaise : M. M. Pickthall (1930, domaine public). Pour une traduction turque, l’app renvoie au site du Coran de la Présidence des affaires religieuses (Diyanet)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Арабский текст: проект Tanzil (CC BY 3.0, без изменений). Английский перевод: М. М. Пиктолл (1930, общественное достояние). Для турецкого перевода приложение ведёт на сайт Корана Управления по делам религии (Diyanet)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラビア語本文：Tanzilプロジェクト（CC BY 3.0、改変なし）。英語訳：M. M. Pickthall（1930年、パブリックドメイン）。トルコ語訳については、アプリはトルコ宗務庁（ディヤーネット）のクルアーンサイトにリンクしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아랍어 본문: Tanzil 프로젝트(CC BY 3.0, 수정 없음). 영어 번역: M. M. Pickthall(1930, 퍼블릭 도메인). 튀르키예어 번역은 앱이 튀르키예 종교청(디야넷) 꾸란 사이트로 연결합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阿拉伯文原文：Tanzil项目（CC BY 3.0，未经修改）。英文译本：M. M. Pickthall（1930年，公有领域）。土耳其文译本方面，应用链接到土耳其宗教事务局（迪亚内特）的古兰经网站。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstong Arabic: Tanzil Project (CC BY 3.0, hindi binago). Salin sa Ingles: M. M. Pickthall (1930, public domain). Para sa salin sa Turkish, naka-link ang app sa Quran site ng Presidency of Religious Affairs (Diyanet)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวบทภาษาอาหรับ: โครงการ Tanzil (CC BY 3.0 ไม่ได้ดัดแปลง) คำแปลภาษาอังกฤษ: M. M. Pickthall (1930, สาธารณสมบัติ) สำหรับคำแปลภาษาตุรกี แอปลิงก์ไปยังเว็บไซต์อัลกุรอานของสำนักกิจการศาสนาตุรกี (ดียาเนต)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto árabe: Proyecto Tanzil (CC BY 3.0, sin modificar). Traducción inglesa: M. M. Pickthall (1930, dominio público). Para una traducción al turco, la app enlaza al sitio del Corán de la Presidencia de Asuntos Religiosos (Diyanet)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto árabe: Projeto Tanzil (CC BY 3.0, sem modificações). Tradução inglesa: M. M. Pickthall (1930, domínio público). Para uma tradução turca, o app leva ao site do Alcorão da Presidência de Assuntos Religiosos (Diyanet)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अरबी पाठ: Tanzil परियोजना (CC BY 3.0, बिना बदलाव)। अंग्रेज़ी अनुवाद: एम. एम. पिकथॉल (1930, सार्वजनिक डोमेन)। तुर्की अनुवाद के लिए ऐप धार्मिक मामलों के निदेशालय (दियानत) की क़ुरआन साइट का लिंक देता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরবি পাঠ: তানজিল প্রকল্প (CC BY 3.0, অপরিবর্তিত)। ইংরেজি অনুবাদ: এম. এম. পিকথল (1930, পাবলিক ডোমেইন)। তুর্কি অনুবাদের জন্য অ্যাপটি ধর্ম বিষয়ক অধিদপ্তরের (দিয়ানেত) কুরআন সাইটের লিংক দেয়।"
          }
        }
      }
    },
