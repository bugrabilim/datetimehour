    "perms.fullScreen.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verirseniz alarm çalınca kilitli ekran açılır. Vermezseniz yalnız bildirim görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you allow it, the locked screen lights up when an alarm rings. If not, only a notification shows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie zustimmen, schaltet sich der Sperrbildschirm beim Klingeln ein. Sonst erscheint nur eine Benachrichtigung."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcazə versəniz, zəngli saat çalanda kilidli ekran açılır. Verməsəniz, yalnız bildiriş görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن سمحت، تُضاء الشاشة المقفلة عند رنين المنبّه. وإن لم تسمح، يظهر إشعار فقط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diizinkan, layar terkunci menyala saat alarm berbunyi. Jika tidak, hanya notifikasi yang muncul."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازت دیں تو الارم بجنے پر لاک اسکرین روشن ہو جائے گی۔ نہ دیں تو صرف اطلاع دکھے گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اجازه دهید، هنگام زنگ هشدار صفحه‌ی قفل روشن می‌شود. اگر ندهید، فقط یک اعلان نمایش داده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous l'autorisez, l'écran verrouillé s'allume quand l'alarme sonne. Sinon, seule une notification apparaît."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если разрешите, при звонке будильника загорится экран блокировки. Если нет, будет только уведомление."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可すると、アラームが鳴ったときにロック画面が点灯します。許可しないと通知だけが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 알람이 울릴 때 잠긴 화면이 켜져요. 허용하지 않으면 알림만 보여요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许后，闹钟响起时锁屏会亮起；不允许则只显示通知。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung papayagan, iilaw ang naka-lock na screen kapag tumunog ang alarm. Kung hindi, abiso lang ang lalabas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าอนุญาต หน้าจอล็อกจะสว่างเมื่อนาฬิกาปลุกดัง ถ้าไม่อนุญาตจะแสดงเพียงการแจ้งเตือน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo permite, la pantalla bloqueada se enciende cuando suena la alarma. Si no, solo se ve un aviso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se permitir, a tela bloqueada acende quando o alarme toca. Se não, aparece só uma notificação."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति दें तो अलार्म बजने पर लॉक स्क्रीन चालू हो जाएगी। न दें तो सिर्फ़ सूचना दिखेगी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি দিলে অ্যালার্ম বাজার সময় লক করা পর্দা জ্বলে ওঠে। না দিলে শুধু একটি নোটিফিকেশন দেখা যায়।"
          }
        }
      }
    },
