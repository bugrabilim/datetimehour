    "cals.chinese.name": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çin ay takvimi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chinese lunar calendar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chinesischer Mondkalender"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çin ay təqvimi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقويم القمري الصيني"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender Imlek"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چینی قمری کیلنڈر"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گاه‌شماری قمری چینی"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendrier lunaire chinois"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Китайский лунный календарь"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中国の旧暦"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중국 음력"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "农历"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendaryong lunar ng Tsina"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินจันทรคติจีน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario lunar chino"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendário lunar chinês"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चीनी चंद्र कैलेंडर"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চীনা চান্দ্র ক্যালেন্ডার"
          }
        }
      }
    },
    "cals.chinese.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çin'in geleneksel ay-güneş takvimi: Çin Yeni Yılı ve diğer bayramlar, 24 güneş dönemi ve Çin burcu yılı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "China’s traditional lunisolar calendar: Chinese New Year and other festivals, the 24 solar terms and the Chinese zodiac year."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der traditionelle Lunisolarkalender Chinas: Chinesisches Neujahr und weitere Feste, die 24 Sonnenperioden und das chinesische Tierkreisjahr."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çinin ənənəvi ay-günəş təqvimi: Çin Yeni ili və digər bayramlar, 24 günəş dövrü və Çin bürcü ili."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقويم القمري الشمسي التقليدي في الصين: رأس السنة الصينية والأعياد الأخرى، والفصول الشمسية الأربعة والعشرون، وسنة الأبراج الصينية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender lunisolar tradisional Tiongkok: Tahun Baru Imlek dan perayaan lainnya, 24 periode matahari, dan tahun shio."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چین کا روایتی قمری شمسی کیلنڈر: چینی نیا سال اور دوسرے تہوار، 24 شمسی ادوار اور چینی برج کا سال۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گاه‌شماری قمری‌خورشیدی سنتی چین: سال نو چینی و جشن‌های دیگر، 24 دوره خورشیدی و سال حیوانی چینی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier luni-solaire traditionnel de la Chine : Nouvel An chinois et autres fêtes, les 24 termes solaires et l’année du zodiaque chinois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Традиционный лунно-солнечный календарь Китая: китайский Новый год и другие праздники, 24 сезона цзеци и год по китайскому зодиаку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中国の伝統的な太陰太陽暦。春節などの祝祭日、二十四節気、干支の年を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중국의 전통 태음태양력: 춘절 등 명절, 24절기, 띠."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中国的传统阴阳历：春节等传统节日、二十四节气和生肖年。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang tradisyonal na lunisolar na kalendaryo ng Tsina: Bagong Taon ng mga Tsino at iba pang pista, ang 24 na solar term at ang taon sa zodiac ng Tsina."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินสุริยจันทรคติดั้งเดิมของจีน: ตรุษจีนและเทศกาลอื่น ๆ 24 ช่วงฤดูกาลตามสุริยคติ และปีนักษัตรจีน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario lunisolar tradicional de China: Año Nuevo chino y otras fiestas, los 24 términos solares y el año del zodiaco chino."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário lunissolar tradicional da China: Ano-Novo Chinês e outras festas, os 24 termos solares e o ano do zodíaco chinês."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चीन का पारंपरिक चंद्र-सौर कैलेंडर: चीनी नव वर्ष और दूसरे पर्व, 24 सौर अवधियाँ और चीनी राशि-चक्र का वर्ष।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চীনের প্রচলিত চান্দ্র-সৌর ক্যালেন্ডার: চীনা নববর্ষ ও অন্যান্য উৎসব, 24টি সৌর পর্ব এবং চীনা রাশিচক্রের বছর।"
          }
        }
      }
    },
    "cals.chinese.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay başları ve güneş dönemleri Çin saatiyle (UTC+8) astronomik hesaptan. Kore ve Vietnam ay takvimleri, bazı aylar bir gün farklı başladığı için ayrı takvimlerdir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Month starts and solar terms are calculated astronomically for China time (UTC+8). The Korean and Vietnamese lunar calendars are separate calendars because some months begin one day earlier or later there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monatsanfänge und Sonnenperioden werden astronomisch für die chinesische Zeit (UTC+8) berechnet. Der koreanische und der vietnamesische Mondkalender sind eigene Kalender, weil dort manche Monate einen Tag früher oder später beginnen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay başlanğıcları və günəş dövrləri Çin vaxtı ilə (UTC+8) astronomik hesablanır. Koreya və Vyetnam ay təqvimləri ayrıca təqvimlərdir, çünki orada bəzi aylar bir gün tez və ya gec başlayır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب بدايات الأشهر والفصول الشمسية فلكيًا بتوقيت الصين (UTC+8). التقويمان القمريان الكوري والفيتنامي تقويمان منفصلان، لأن بعض الأشهر تبدأ هناك قبل يوم أو بعده."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Awal bulan dan periode matahari dihitung secara astronomis menurut waktu Tiongkok (UTC+8). Kalender lunar Korea dan Vietnam adalah kalender tersendiri karena di sana beberapa bulan dimulai sehari lebih awal atau lebih lambat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مہینوں کا آغاز اور شمسی ادوار چین کے وقت (UTC+8) کے مطابق فلکیاتی حساب سے ہیں۔ کوریائی اور ویتنامی قمری کیلنڈر الگ کیلنڈر ہیں، کیونکہ وہاں کچھ مہینے ایک دن پہلے یا بعد شروع ہوتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آغاز ماه‌ها و دوره‌های خورشیدی به وقت چین (UTC+8) و با محاسبه نجومی است. گاه‌شماری‌های قمری کره و ویتنام جداگانه‌اند، زیرا آنجا برخی ماه‌ها یک روز زودتر یا دیرتر آغاز می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les débuts de mois et les termes solaires sont calculés astronomiquement pour l’heure de Chine (UTC+8). Les calendriers lunaires coréen et vietnamien sont des calendriers distincts, car certains mois y commencent un jour plus tôt ou plus tard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начала месяцев и сезоны рассчитаны астрономически по времени Китая (UTC+8). Корейский и вьетнамский лунные календари — отдельные календари, так как там некоторые месяцы начинаются на день раньше или позже."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の始まりと二十四節気は中国時間（UTC+8）で天文計算しています。韓国とベトナムの旧暦は月の始まりが1日前後する月があるため、別の暦として選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월의 시작과 24절기는 중국 시간(UTC+8)으로 천문 계산했습니다. 한국 음력과 베트남 음력은 일부 달이 하루 일찍 또는 늦게 시작하므로 별도의 달력으로 선택할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月首和二十四节气按北京时间（UTC+8）天文计算。韩国和越南的阴历有些月份的月首早一天或晚一天，因此作为单独的历法提供。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang simula ng mga buwan at ang mga solar term ay kinakalkula ayon sa astronomiya sa oras ng Tsina (UTC+8). Hiwalay na kalendaryo ang kalendaryong lunar ng Korea at ng Vietnam dahil may mga buwang nagsisimula roon nang isang araw na mas maaga o mas huli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันเริ่มเดือนและฤดูกาลสุริยะคำนวณทางดาราศาสตร์ตามเวลาจีน (UTC+8) ปฏิทินจันทรคติเกาหลีและเวียดนามแยกเป็นปฏิทินต่างหาก เพราะบางเดือนเริ่มเร็วหรือช้ากว่าหนึ่งวัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de los meses y los términos solares se calculan astronómicamente para la hora de China (UTC+8). Los calendarios lunares coreano y vietnamita son calendarios aparte, porque allí algunos meses empiezan un día antes o después."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O início dos meses e os termos solares são calculados astronomicamente pelo horário da China (UTC+8). Os calendários lunares coreano e vietnamita são calendários separados, porque lá alguns meses começam um dia antes ou depois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महीनों की शुरुआत और सौर अवधियाँ चीन के समय (UTC+8) के अनुसार खगोलीय गणना से हैं। कोरियाई और वियतनामी चंद्र कैलेंडर अलग कैलेंडर हैं, क्योंकि वहाँ कुछ महीने एक दिन पहले या बाद शुरू होते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাস শুরু ও সৌর পর্বগুলো চীনের সময়ের (UTC+8) জন্য জ্যোতির্বিজ্ঞানের হিসাবে বের করা। কোরীয় ও ভিয়েতনামি চান্দ্র ক্যালেন্ডার আলাদা ক্যালেন্ডার, কারণ সেখানে কিছু মাস এক দিন আগে বা পরে শুরু হয়।"
          }
        }
      }
    },
