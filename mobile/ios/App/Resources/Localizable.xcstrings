        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: خورشید هنگام گرفت زیر افق است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : le Soleil est sous l'horizon pendant l'éclipse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: во время затмения Солнце под горизонтом."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：日食の間、太陽は地平線の下です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 일식 동안 태양이 지평선 아래에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：日食期间太阳在地平线下。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: nasa ilalim ng abot-tanaw ang Araw habang may eklipse."
