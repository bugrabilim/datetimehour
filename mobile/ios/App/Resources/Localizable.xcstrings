    "tools.alarm.ytBlocked": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube müziği için dış hizmetlere izin verin; izin yoksa alarm kendi sesiyle çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow external services for YouTube music; without permission the alarm rings with its own sound."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie externe Dienste für YouTube-Musik; ohne Zustimmung klingelt der Wecker mit seinem eigenen Ton."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube musiqisi üçün xarici xidmətlərə icazə verin; icazə yoxdursa, zəng öz səsi ilə çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالخدمات الخارجية لموسيقى YouTube؛ ومن دون إذن يرنّ المنبّه بصوته الخاص."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan layanan eksternal untuk musik YouTube; tanpa izin, alarm berbunyi dengan suaranya sendiri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube موسیقی کے لیے بیرونی خدمات کی اجازت دیں؛ اجازت نہ ہو تو الارم اپنی آواز سے بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای موسیقی YouTube به خدمات بیرونی اجازه دهید؛ بدون اجازه زنگ با صدای خودش به صدا درمی‌آید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les services externes pour la musique YouTube ; sans autorisation, l’alarme utilise sa propre sonnerie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите внешние сервисы для музыки YouTube; без разрешения будильник звонит своим звуком."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube の音楽を使うには外部サービスを許可してください。許可しない場合は、標準のアラーム音が鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 음악을 쓰려면 외부 서비스를 허용하세요. 허용하지 않으면 알람은 자체 소리로 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许外部服务以使用 YouTube 音乐；未获允许时，闹钟将使用自带铃声。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang mga panlabas na serbisyo para sa musika sa YouTube; kung walang pahintulot, tutunog ang alarma sa sarili nitong tunog."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดอนุญาตบริการภายนอกสำหรับเพลงจาก YouTube หากไม่อนุญาต นาฬิกาปลุกจะดังด้วยเสียงของตัวเอง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita los servicios externos para la música de YouTube; sin permiso, la alarma suena con su propio sonido."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita os serviços externos para a música do YouTube; sem permissão, o alarme toca com o próprio som."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube संगीत के लिए बाहरी सेवाओं की अनुमति दें; अनुमति के बिना अलार्म अपनी आवाज़ से बजता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube গানের জন্য বাইরের সেবার অনুমতি দিন; অনুমতি না থাকলে অ্যালার্ম নিজস্ব শব্দে বাজে।"
          }
        }
      }
    },
    "tools.alarm.spotifyNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify tarayıcıda kendiliğinden çalmaz; Spotify'ı alarm müziği olarak Android uygulamasında kullanabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify doesn't start by itself in the browser; you can use Spotify as alarm music in the Android app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify startet im Browser nicht von selbst; in der Android-App können Sie Spotify als Weckermusik verwenden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify brauzerdə özü başlamır; Spotify-ı zəng musiqisi kimi Android tətbiqində istifadə edə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يبدأ Spotify تلقائيًا في المتصفح؛ يمكنك استخدام Spotify موسيقى للمنبّه في تطبيق Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify tidak diputar dengan sendirinya di peramban; Anda dapat memakai Spotify sebagai musik alarm di aplikasi Android."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify براؤزر میں خود نہیں چلتا؛ آپ Android ایپ میں Spotify کو الارم کی موسیقی کے طور پر استعمال کر سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify در مرورگر خودبه‌خود پخش نمی‌شود؛ می‌توانید در برنامهٔ Android از Spotify به‌عنوان موسیقی زنگ استفاده کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify ne démarre pas tout seul dans le navigateur ; vous pouvez utiliser Spotify comme musique de réveil dans l’application Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify не запускается в браузере сам; Spotify можно использовать как музыку будильника в приложении для Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify はブラウザでは自動で再生されません。Android アプリでは Spotify をアラームの音楽に使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify는 브라우저에서 자동으로 재생되지 않습니다. Android 앱에서는 Spotify를 알람 음악으로 쓸 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 在浏览器中不会自动播放；您可以在 Android 应用中把 Spotify 用作闹钟音乐。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kusang tumutugtog ang Spotify sa browser; magagamit mo ang Spotify bilang musika ng alarma sa Android app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify ไม่เล่นเองในเบราว์เซอร์ คุณใช้ Spotify เป็นเพลงปลุกได้ในแอป Android"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify no se inicia solo en el navegador; puede usar Spotify como música de alarma en la app para Android."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Spotify não começa sozinho no navegador; você pode usar o Spotify como música de alarme no app para Android."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउज़र में Spotify अपने-आप शुरू नहीं होता; Android ऐप में आप Spotify को अलार्म संगीत के रूप में इस्तेमाल कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্রাউজারে Spotify নিজে থেকে চালু হয় না; Android অ্যাপে Spotify অ্যালার্মের গান হিসেবে ব্যবহার করতে পারেন।"
          }
        }
      }
    },
