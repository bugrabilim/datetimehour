    "alarm.preBody": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erken uyandıysanız bu çalmayı atlayabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up early? You can skip this one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon wach? Sie können diesen Wecker überspringen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tez oyandınızsa bu çalmanı keçə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيقظت مبكرًا؟ يمكنك تخطي هذا المنبه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah bangun? Anda bisa melewatinya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جلدی جاگ گئے؟ آپ اسے چھوڑ سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زود بیدار شدید؟ می‌توانید این یکی را رد کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà debout ? Vous pouvez la sauter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже встали? Этот можно пропустить."
          }
        }
      }
    },
    "alarm.preSkip": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alarmı atla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip this alarm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Wecker überspringen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu zəngli saatı keç"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخطَّ هذا المنبه"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lewati alarm ini"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ الارم چھوڑیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رد کردن این هشدار"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauter cette alarme"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропустить этот будильник"
          }
        }
      }
    },
    "alarm.preNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessiz bildirim; dokunup alarmı atlayabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A silent notification; you can skip the alarm from it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine stille Mitteilung; Sie können den Wecker darüber überspringen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səssiz bildiriş; oradan zəngli saatı keçə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار صامت يمكنك منه تخطي المنبه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi senyap; Anda bisa melewati alarm darinya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خاموش اطلاع؛ اس سے آپ الارم چھوڑ سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلانی بی‌صدا؛ از آن می‌توانید هشدار را رد کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification silencieuse ; vous pouvez sauter l’alarme depuis celle-ci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Беззвучное уведомление; из него можно пропустить будильник."
          }
        }
      }
    },
    "alarm.speak": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saati sesli söylesin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak the time"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhrzeit ansagen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtı səsli desin"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نطق الوقت"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucapkan waktu"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت بولیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گفتن ساعت"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annoncer l’heure"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Называть время"
          }
        }
      }
    },
    "alarm.speakNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm çalarken saat telefonun konuşma motoruyla söylenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While ringing, the time is spoken with the phone's speech engine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Klingeln wird die Uhrzeit mit der Sprachausgabe des Telefons angesagt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəngli saat çalarkən vaxt telefonun nitq mühərriki ilə deyilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء الرنين يُنطق الوقت بمحرك الكلام في الهاتف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat berbunyi, waktu diucapkan dengan mesin suara ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بجتے وقت فون کے آواز انجن سے وقت بولا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام زنگ، ساعت با موتور گفتار گوشی گفته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant la sonnerie, l’heure est annoncée avec la synthèse vocale du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время звонка время называется синтезатором речи телефона."
          }
        }
      }
    },
    "alarm.speakNoteIOS": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm sesi, saati söyleyen kısa bir kayıtla değişir (kayıt telefonda üretilir)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm sound becomes a short recording that speaks the time (made on the phone)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Weckton wird zu einer kurzen Aufnahme, die die Uhrzeit ansagt (auf dem Telefon erzeugt)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəngli saatın səsi vaxtı deyən qısa bir yazı ilə əvəz olunur (telefonda yaradılır)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصبح صوت المنبه تسجيلًا قصيرًا ينطق الوقت (يُنشأ على الهاتف)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara alarm menjadi rekaman singkat yang mengucapkan waktu (dibuat di ponsel)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم کی آواز ایک مختصر ریکارڈنگ بن جاتی ہے جو وقت بتاتی ہے (فون پر بنتی ہے)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدای هشدار ضبطی کوتاه می‌شود که ساعت را می‌گوید (روی گوشی ساخته می‌شود)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son de l’alarme devient un court enregistrement qui annonce l’heure (créé sur le téléphone)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук будильника становится короткой записью, называющей время (создаётся на телефоне)."
          }
        }
      }
    },
