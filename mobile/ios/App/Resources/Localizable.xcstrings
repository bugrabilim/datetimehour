        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拝時刻の画面に「済」チェック"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기도 시간 화면에 '했음' 표시"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在礼拜时间页面显示“已礼拜”勾选"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tsek na \"nakapagdasal na\" sa screen ng oras ng dasal"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องหมาย \"ละหมาดแล้ว\" ในหน้าจอเวลาละหมาด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca de \"Rezada\" en la pantalla de horarios"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca de \"Rezada\" na tela de horários"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमाज़ समय स्क्रीन पर \"पढ़ ली\" निशान"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজের সময়ের পর্দায় \"আদায় করেছি\" চিহ্ন"
          }
        }
      }
    },
    "track.inlineNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakit girince satırdaki daireye dokunarak işaretleyin. Kayıt yalnız telefonda kalır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the circle on a row once its time has begun. Stored only on the phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf den Kreis, sobald die Zeit begonnen hat. Nur auf dem Telefon gespeichert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxt girəndə sətirdəki dairəyə toxunaraq işarələyin. Qeyd yalnız telefonda qalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس الدائرة في السطر بعد دخول الوقت. يُحفظ على الهاتف فقط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk lingkaran pada baris setelah waktunya masuk. Hanya disimpan di ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت شروع ہونے پر قطار کے دائرے کو چھوئیں۔ صرف فون پر محفوظ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از رسیدن وقت، دایره ردیف را لمس کنید. فقط روی گوشی ذخیره می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le cercle de la ligne une fois l’heure arrivée. Stocké sur le téléphone uniquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь кружка в строке, когда время наступит. Хранится только на телефоне."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻になったら行の丸をタップします。端末内にのみ保存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 되면 줄의 동그라미를 누르세요. 휴대전화에만 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到时后点按该行的圆圈。仅保存在手机上。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang bilog sa hanay kapag dumating na ang oras. Nasa telepono lang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะวงกลมในแถวเมื่อถึงเวลาแล้ว เก็บไว้ในโทรศัพท์เท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el círculo de una fila cuando haya empezado su hora. Solo se guarda en el teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no círculo de uma linha quando o horário dela tiver começado. O registro fica só no celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी पंक्ति का समय शुरू होने के बाद उसके घेरे पर टैप करें। केवल फ़ोन पर सहेजा जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময় শুরু হলে সারির বৃত্তে চাপুন। শুধু ফোনে সংরক্ষিত।"
          }
        }
      }
    },
