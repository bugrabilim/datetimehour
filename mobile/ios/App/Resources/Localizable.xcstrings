          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yakınında (konum izni yok)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Near %1$@ (no location permission)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Nähe von %1$@ (keine Standortberechtigung)"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yaxınlığında (məkan icazəsi yoxdur)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالقرب من %1$@ (لا يوجد إذن بالموقع)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekat %1$@ (tanpa izin lokasi)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کے قریب (مقام کی اجازت کے بغیر)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نزدیک %1$@ (بدون اجازهٔ موقعیت)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Près de %1$@ (sans autorisation de position)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядом с: %1$@ (без доступа к геопозиции)"
          }
        }
      }
    },
    "qibla.mosquesNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama Apple Haritalar ile yapılır: arama sözcüğü ve yaklaşık bölge Apple'a gider. Bir camiye dokununca Haritalar'da açılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The search uses Apple Maps: the search word and approximate area go to Apple. Tap a mosque to open it in Maps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche nutzt Apple Karten: Suchbegriff und ungefähres Gebiet gehen an Apple. Tippen Sie auf eine Moschee, um sie in Karten zu öffnen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Axtarış Apple Xəritələr ilə edilir: axtarış sözü və təxmini ərazi Apple-a gedir. Məscidə toxunanda Xəritələrdə açılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم البحث عبر خرائط Apple: تُرسل كلمة البحث والمنطقة التقريبية إلى Apple. اضغط على مسجد لفتحه في الخرائط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencarian memakai Apple Maps: kata pencarian dan area perkiraan dikirim ke Apple. Ketuk masjid untuk membukanya di Maps."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاش ایپل میپس سے ہوتی ہے: تلاش کا لفظ اور تقریبی علاقہ ایپل کو جاتا ہے۔ نقشے میں کھولنے کے لیے مسجد پر ٹیپ کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جست‌وجو با نقشه‌های اپل انجام می‌شود: واژهٔ جست‌وجو و محدودهٔ تقریبی به اپل می‌رود. برای باز کردن در نقشه‌ها روی مسجد بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche utilise Plans d’Apple : le mot recherché et la zone approximative sont envoyés à Apple. Touchez une mosquée pour l’ouvrir dans Plans."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск идёт через Карты Apple: слово поиска и приблизительная область передаются Apple. Нажмите на мечеть, чтобы открыть её в Картах."
          }
        }
      }
    },
    "qibla.mosquesNoteAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Camiler OpenStreetMap verisinden Overpass servisiyle aranır: yalnız yaklaşık bölge (iki ondalığa yuvarlanmış koordinat) bu servise gider. Bir camiye dokununca harita uygulamasında açılır. Veri © OpenStreetMap katkıcıları (ODbL)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosques are searched in OpenStreetMap data via the Overpass service: only the approximate area (coordinates rounded to two decimals) is sent. Tap a mosque to open it in your maps app. Data © OpenStreetMap contributors (ODbL)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Moscheen werden in OpenStreetMap-Daten über den Overpass-Dienst gesucht: Nur das ungefähre Gebiet (auf zwei Dezimalstellen gerundete Koordinaten) wird gesendet. Tippen Sie auf eine Moschee, um sie in Ihrer Karten-App zu öffnen. Daten © OpenStreetMap-Mitwirkende (ODbL)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məscidlər OpenStreetMap məlumatında Overpass xidməti ilə axtarılır: yalnız təxmini ərazi (iki onluğa yuvarlaqlaşdırılmış koordinat) göndərilir. Məscidə toxunanda xəritə tətbiqində açılır. Məlumat © OpenStreetMap iştirakçıları (ODbL)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم البحث عن المساجد في بيانات OpenStreetMap عبر خدمة Overpass: تُرسل المنطقة التقريبية فقط (إحداثيات مقرّبة إلى منزلتين عشريتين). اضغط على مسجد لفتحه في تطبيق الخرائط. البيانات © مساهمو OpenStreetMap ‏(ODbL)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masjid dicari di data OpenStreetMap melalui layanan Overpass: hanya area perkiraan (koordinat dibulatkan ke dua desimal) yang dikirim. Ketuk masjid untuk membukanya di aplikasi peta. Data © kontributor OpenStreetMap (ODbL)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مساجد OpenStreetMap ڈیٹا میں Overpass سروس کے ذریعے تلاش کی جاتی ہیں: صرف تقریبی علاقہ (دو اعشاریہ تک گول نقاط) بھیجا جاتا ہے۔ نقشے کی ایپ میں کھولنے کے لیے مسجد پر ٹیپ کریں۔ ڈیٹا © OpenStreetMap معاونین (ODbL)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسجدها در دادهٔ OpenStreetMap از طریق سرویس Overpass جست‌وجو می‌شوند: فقط محدودهٔ تقریبی (مختصات گردشده تا دو رقم اعشار) فرستاده می‌شود. برای باز کردن در برنامهٔ نقشه روی مسجد بزنید. داده‌ها © مشارکت‌کنندگان OpenStreetMap (ODbL)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mosquées sont recherchées dans les données OpenStreetMap via le service Overpass : seule la zone approximative (coordonnées arrondies à deux décimales) est envoyée. Touchez une mosquée pour l’ouvrir dans votre app de cartes. Données © contributeurs OpenStreetMap (ODbL)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мечети ищутся в данных OpenStreetMap через сервис Overpass: отправляется только приблизительная область (координаты, округлённые до двух знаков). Нажмите на мечеть, чтобы открыть её в приложении карт. Данные © участники OpenStreetMap (ODbL)."
          }
        }
      }
    },
