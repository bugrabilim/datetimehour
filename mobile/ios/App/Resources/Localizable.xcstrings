    "greet.m.hijri.6": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni yıl, güzel niyetlerin gerçekleştiği bir yıl olsun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May the new year be one where good intentions come true."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möge das neue Jahr gute Vorsätze wahr werden lassen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni il gözəl niyyətlərin gerçəkləşdiyi bir il olsun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عامًا تتحقق فيه النيات الطيبة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga tahun baru mewujudkan niat-niat baik."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیا سال اچھی نیتوں کے پورا ہونے کا سال ہو۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سال نو سال برآورده شدن نیت‌های نیک باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que cette année voie se réaliser vos bonnes intentions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть новый год станет годом добрых намерений."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "善き志が実る一年になりますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 뜻이 이루어지는 한 해 되길 바랍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "愿新年里美好的心愿得以实现。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawa'y matupad ang mabubuting hangarin sa bagong taon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้ปีใหม่เป็นปีที่ความตั้งใจดีเป็นจริง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que el nuevo año haga realidad las buenas intenciones."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que no novo ano as boas intenções se realizem."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया साल अच्छी नीयतों के पूरा होने का साल हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন বছর হোক ভালো নিয়ত পূরণের বছর।"
          }
        }
      }
    },
    "greet.bless.1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
