    "look.fsNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekranda ekranın kenarında yukarı ya da aşağı kaydırarak ekranı karartabilir, iki parmakla saati büyütüp küçültebilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In full screen, swipe up or down along the edge of the screen to dim it, and pinch to resize the clock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Vollbild am Bildschirmrand nach oben oder unten wischen, um abzudunkeln; mit zwei Fingern die Uhr vergrößern oder verkleinern."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekranda ekranın kənarında yuxarı və ya aşağı sürüşdürərək ekranı qaralda, iki barmaqla saatı böyüdüb kiçildə bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في ملء الشاشة اسحب لأعلى أو لأسفل على حافة الشاشة لتعتيمها، وقرّب إصبعين أو باعدهما لتغيير حجم الساعة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di layar penuh, usap ke atas atau ke bawah di tepi layar untuk meredupkannya, dan cubit untuk mengubah ukuran jam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوری اسکرین میں اسکرین کو مدھم کرنے کے لیے کنارے پر اوپر یا نیچے سوائپ کریں، اور گھڑی کا سائز بدلنے کے لیے چٹکی کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تمام‌صفحه، برای کم‌نور کردن صفحه در لبهٔ آن بالا یا پایین بکشید و برای تغییر اندازهٔ ساعت دو انگشت را جمع یا باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En plein écran, glissez vers le haut ou le bas le long du bord pour atténuer l’écran, et pincez pour redimensionner l’horloge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В полноэкранном режиме проведите вверх или вниз у края экрана, чтобы приглушить его, и сведите пальцы, чтобы изменить размер часов."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全画面では、画面の端を上下にスワイプして暗くし、ピンチで時計の大きさを変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면에서 화면 가장자리를 위아래로 쓸어 어둡게 하고, 두 손가락으로 오므리거나 벌려 시계 크기를 바꾸세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在全屏中，沿屏幕边缘上下滑动可调暗，双指捏合可调整时钟大小。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa full screen, mag-swipe pataas o pababa sa gilid ng screen para padilimin ito, at mag-pinch para baguhin ang laki ng orasan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในโหมดเต็มจอ ปัดขึ้นหรือลงที่ขอบหน้าจอเพื่อหรี่ และใช้สองนิ้วถ่างหรือบีบเพื่อปรับขนาดนาฬิกา"
          }
        }
      }
    },
