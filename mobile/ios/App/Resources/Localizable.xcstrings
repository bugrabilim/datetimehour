    "wallpaper.privacy": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüsü ve kesilen parçalar yalnız bu telefonda kalır, hiçbir yere gönderilmez ve iCloud ile eşitlenmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screenshot and the cut pieces stay on this iPhone only, are never sent anywhere and are not synced with iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bildschirmfoto und die ausgeschnittenen Teile bleiben nur auf diesem iPhone, werden nirgendwohin gesendet und nicht mit iCloud synchronisiert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran şəkli və kəsilmiş hissələr yalnız bu telefonda qalır, heç yerə göndərilmir və iCloud ilə sinxronlaşdırılmır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى لقطة الشاشة والأجزاء المقصوصة على هذا الـ iPhone فقط، ولا تُرسَل إلى أي مكان ولا تُزامَن مع iCloud."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan layar dan potongannya hanya disimpan di iPhone ini, tidak dikirim ke mana pun, dan tidak disinkronkan dengan iCloud."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین شاٹ اور کٹے ہوئے حصے صرف اسی فون پر رہتے ہیں، کہیں نہیں بھیجے جاتے اور iCloud سے ہم آہنگ نہیں ہوتے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکس صفحه و تکه‌های بریده‌شده فقط روی همین گوشی می‌مانند، به جایی فرستاده نمی‌شوند و با iCloud همگام نمی‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture et les morceaux découpés restent uniquement sur cet iPhone, ne sont envoyés nulle part et ne sont pas synchronisés avec iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимок экрана и вырезанные части хранятся только на этом iPhone, никуда не отправляются и не синхронизируются с iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットと切り出した部分はこのiPhoneにのみ保存され、どこにも送信されず、iCloudとも同期されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷과 잘라낸 조각은 이 iPhone에만 남으며, 어디로도 전송되지 않고 iCloud와 동기화되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图和裁出的部分只保存在这台 iPhone 上，不会发送到任何地方，也不会与 iCloud 同步。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang screenshot at ang mga hiniwang bahagi ay nananatili lang sa iPhone na ito, hindi ipinapadala kahit saan, at hindi sini-sync sa iCloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพหน้าจอและส่วนที่ตัดไว้จะอยู่ใน iPhone เครื่องนี้เท่านั้น ไม่ถูกส่งไปที่ใด และไม่ซิงค์กับ iCloud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura y los fragmentos recortados se quedan solo en este iPhone, no se envían a ningún sitio y no se sincronizan con iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A captura e os recortes ficam só neste iPhone, não são enviados a lugar nenhum e não são sincronizados com o iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनशॉट और काटे गए हिस्से केवल इसी iPhone पर रहते हैं, कहीं नहीं भेजे जाते और iCloud से सिंक नहीं होते।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিনশট ও কাটা অংশগুলো শুধু এই iPhone-এ থাকে, কখনো কোথাও পাঠানো হয় না এবং iCloud-এর সঙ্গে সিঙ্ক হয় না।"
          }
        }
      }
    },
