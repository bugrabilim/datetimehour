    "support.qrNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun kamerasıyla okutunca time.bumba.tr açılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan it with a phone camera to open time.bumba.tr."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Handykamera scannen, um time.bumba.tr zu öffnen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun kamerası ilə oxudanda time.bumba.tr açılır."
