    "account.signedUp": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulama e-postası gönderdik. E-postadaki bağlantıyı açtıktan sonra giriş yapabilirsiniz. Bağlantı 24 saat geçerlidir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We sent a verification email. After opening the link in it, you can sign in. The link is valid for 24 hours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben eine Bestätigungs-E-Mail gesendet. Nachdem Sie den Link darin geöffnet haben, können Sie sich anmelden. Der Link ist 24 Stunden gültig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təsdiq e-poçtu göndərdik. E-poçtdakı keçidi açdıqdan sonra daxil ola bilərsiniz. Keçid 24 saat etibarlıdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلنا رسالة تحقق. بعد فتح الرابط فيها يمكنك تسجيل الدخول. الرابط صالح 24 ساعة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami telah mengirim email verifikasi. Setelah membuka tautan di dalamnya, Anda dapat masuk. Tautan berlaku selama 24 jam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم نے تصدیقی ای میل بھیجی ہے۔ اس میں موجود لنک کھولنے کے بعد آپ سائن ان کر سکتے ہیں۔ لنک 24 گھنٹے کار آمد ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایمیل تأیید فرستادیم. پس از باز کردن پیوند آن می‌توانید وارد شوید. پیوند 24 ساعت معتبر است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons envoyé un e-mail de vérification. Après avoir ouvert le lien qu'il contient, vous pourrez vous connecter. Le lien est valable 24 heures."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы отправили письмо для подтверждения. Откройте ссылку в нём, и затем можно будет войти. Ссылка действует 24 часа."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認メールを送りました。メール内のリンクを開くとログインできます。リンクの有効期限は24時間です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 이메일을 보냈습니다. 메일의 링크를 연 뒤 로그인할 수 있습니다. 링크는 24시간 동안 유효합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们已发送验证邮件。打开邮件中的链接后即可登录。链接 24 小时内有效。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagpadala kami ng email para sa beripikasyon. Pagkabukas ninyo ng link doon, puwede na kayong mag-sign in. 24 oras ang bisa ng link."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราส่งอีเมลยืนยันแล้ว เมื่อเปิดลิงก์ในอีเมลแล้วจึงลงชื่อเข้าใช้ได้ ลิงก์ใช้ได้ 24 ชั่วโมง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le enviamos un correo de verificación. Después de abrir el enlace, podrá iniciar sesión. El enlace es válido durante 24 horas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviamos um e-mail de verificação. Depois de abrir o link, você poderá entrar. O link vale por 24 horas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने पुष्टि ईमेल भेजा है। उसका लिंक खोलने के बाद आप साइन इन कर सकते हैं। लिंक 24 घंटे मान्य है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা যাচাই ইমেইল পাঠিয়েছি। এর লিংক খোলার পর আপনি সাইন ইন করতে পারবেন। লিংকটি 24 ঘণ্টা বৈধ।"
          }
        }
      }
    },
