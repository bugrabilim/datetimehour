    "prayer.imNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakitler hesaplanmıştır; resmî vakit için Diyanet İşleri Başkanlığı esas alınır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times are calculated; for official times follow the Presidency of Religious Affairs (Diyanet)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeiten sind berechnet; maßgeblich sind die Angaben des Präsidiums für religiöse Angelegenheiten (Diyanet)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtlar hesablanmışdır; rəsmi vaxt üçün Diyanət İşləri Başqanlığının məlumatı əsasdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأوقات محسوبة؛ والمعتمد هو ما تنشره رئاسة الشؤون الدينية (ديانت)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu merupakan hasil perhitungan; untuk waktu resmi ikuti Kepresidenan Urusan Agama (Diyanet)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات حساب کیے گئے ہیں؛ سرکاری اوقات کے لیے ریاستِ امورِ دینیہ (دیانت) سے رجوع کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات محاسبه‌شده‌اند؛ برای اوقات رسمی از ریاست امور دینی (دیانت) پیروی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heures calculées ; pour les heures officielles, suivez la Présidence des affaires religieuses (Diyanet)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время рассчитано; официальное время публикует Управление по делам религии (Diyanet)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻は計算によるものです。正式な時刻はトルコ宗務庁（ディヤーネット）に従ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간은 계산값입니다. 공식 시간은 튀르키예 종교청(디야넷)을 따르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间为计算值；官方时间请以土耳其宗教事务局（迪亚内特）为准。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinakalkula ang mga oras; para sa opisyal na oras, sundin ang Presidency of Religious Affairs (Diyanet)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาเป็นค่าที่คำนวณ สำหรับเวลาอย่างเป็นทางการ ให้ยึดสำนักงานกิจการศาสนา (ดียาเนต)"
          }
        }
      }
    },
