    "tools.countdown.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri sayım iki biçimde çalışır: belirlediğiniz süre dolunca uyarı verir (zamanlayıcı) ya da seçtiğiniz tarihe kalan günü, saati ve saniyeyi canlı gösterir. Yeni yıla, bayrama ya da kendi tarihinize sayabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The countdown works in two ways: a timer that alerts you when your chosen duration ends, or a live display of the days, hours and seconds left until a date you pick. Count down to New Year, a bayram or your own date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Countdown funktioniert auf zwei Arten: als Timer, der Sie nach Ablauf der gewählten Dauer benachrichtigt, oder als Live-Anzeige der Tage, Stunden und Sekunden bis zu einem Datum Ihrer Wahl. Zählen Sie bis Neujahr, zu einem Bayram oder zu Ihrem eigenen Termin herunter."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Geriyə sayım iki üsulla işləyir: seçdiyiniz müddət bitəndə xəbərdarlıq edən taymer, yaxud seçdiyiniz tarixə qalan günləri, saatları və saniyələri canlı göstərən sayğac. Yeni ilə, bayrama və ya öz tarixinizə qədər geriyə sayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل العدّ التنازلي بطريقتين: مؤقت ينبّهك عند انتهاء المدة التي اخترتها، أو عرض مباشر للأيام والساعات والثواني المتبقية حتى تاريخ تحدده. ابدأ العدّ التنازلي لرأس السنة أو العيد أو لتاريخك الخاص."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung mundur bekerja dengan dua cara: pengatur waktu yang memberi peringatan saat durasi pilihan berakhir, atau tampilan langsung hari, jam, dan detik menuju tanggal yang Anda pilih. Hitung mundur menuju Tahun Baru, bayram, atau tanggal Anda sendiri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الٹی گنتی دو طریقوں سے کام کرتی ہے: ایک ٹائمر جو منتخب دورانیہ ختم ہونے پر آگاہ کرتا ہے، یا آپ کی منتخب تاریخ تک باقی دنوں، گھنٹوں اور سیکنڈوں کا براہِ راست ڈسپلے۔ نئے سال، کسی عید یا اپنی تاریخ تک گنیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شمارش معکوس دو حالت دارد: زمان‌سنجی که در پایان مدت انتخابی هشدار می‌دهد، یا نمایش زندهٔ روزها، ساعت‌ها و ثانیه‌های مانده تا تاریخی که برمی‌گزینید. تا سال نو، یک عید یا تاریخ دلخواه خود بشمارید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte à rebours fonctionne de deux façons : un minuteur qui vous alerte à la fin de la durée choisie, ou un affichage en direct des jours, heures et secondes restant jusqu’à une date. Comptez jusqu’au Nouvel An, à un bayram ou à votre propre date."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратный отсчёт работает двумя способами: таймер, который подаёт сигнал по истечении выбранного времени, или живое табло с днями, часами и секундами до выбранной даты. Отсчитывайте до Нового года, байрама или своей даты."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウントダウンには2つの使い方があります。選んだ時間が終わると知らせるタイマーと、選んだ日付までの日数・時間・秒をリアルタイムで表示する方法です。新年、バイラム、または好きな日付までカウントダウンできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운트다운은 두 가지로 씁니다. 고른 시간이 끝나면 알려 주는 타이머, 또는 고른 날짜까지 남은 일·시간·초를 실시간으로 보여 주는 방식입니다. 새해, 바이람 또는 원하는 날짜까지 세어 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倒计时有两种用法：在所选时长结束时提醒您的计时器，或实时显示距所选日期还有多少天、小时和秒。可以倒数到新年、节日或您自己的日期。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalawang paraan ang countdown: timer na nag-aabiso kapag natapos ang napili mong tagal, o live na pagpapakita ng natitirang araw, oras at segundo bago ang petsang pipiliin mo. Mag-countdown sa Bagong Taon, isang bayram o sarili mong petsa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับถอยหลังใช้ได้สองแบบ คือตัวจับเวลาที่เตือนเมื่อครบระยะเวลาที่เลือก หรือแสดงวัน ชั่วโมง และวินาทีที่เหลือถึงวันที่ที่เลือกแบบสด นับถอยหลังถึงปีใหม่ ไบรัม หรือวันที่ของคุณเองได้"
          }
        }
      }
    },
