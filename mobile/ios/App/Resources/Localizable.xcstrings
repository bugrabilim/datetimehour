    "perms.camera.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız alarm görevlerinde (kod ya da nesne gösterme) ve kıble kamerasında. Görüntü kaydedilmez, telefondan çıkmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for alarm tasks (showing a code or an object) and the qibla camera. Nothing is recorded or leaves your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Weckaufgaben (Code oder Gegenstand zeigen) und die Qibla-Kamera. Nichts wird aufgezeichnet oder verlässt Ihr Telefon."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız zəngli saat tapşırıqlarında (kod və ya əşya göstərmək) və qiblə kamerasında. Görüntü yazılmır, telefondan çıxmır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمهام المنبّه فقط (إظهار رمز أو شيء) ولكاميرا القبلة. لا يُسجَّل شيء ولا يغادر هاتفك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk tugas alarm (menunjukkan kode atau benda) dan kamera kiblat. Tidak ada yang direkam atau keluar dari ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف الارم کے کاموں (کوڈ یا چیز دکھانا) اور قبلہ کیمرے کے لیے۔ کچھ ریکارڈ نہیں ہوتا، فون سے باہر نہیں جاتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط برای کارهای هشدار (نشان دادن کد یا شیء) و دوربین قبله. چیزی ضبط نمی‌شود و از گوشی بیرون نمی‌رود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour les tâches d'alarme (montrer un code ou un objet) et la caméra de la qibla. Rien n'est enregistré ni ne quitte votre téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для заданий будильника (показать код или предмет) и камеры киблы. Ничего не записывается и не покидает телефон."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームのタスク（コードや物を見せる）とキブラのカメラ表示にだけ使います。映像は記録されず、端末の外に出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 과제(코드나 물건 보여 주기)와 키블라 카메라에만 써요. 아무것도 기록되지 않고 휴대폰 밖으로 나가지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于闹钟任务（出示二维码或物品）和朝向相机。不录制任何内容，也不会离开手机。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lang sa mga gawain ng alarm (pagpapakita ng code o bagay) at sa camera ng qibla. Walang nirerekord at hindi ito lumalabas sa telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เฉพาะภารกิจปลุก (แสดงโค้ดหรือสิ่งของ) และกล้องทิศกิบลัต ไม่มีการบันทึกและไม่ออกจากโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para las tareas de alarma (mostrar un código o un objeto) y la cámara de la alquibla. No se graba nada ni sale del teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para tarefas de alarme (mostrar um código ou objeto) e para a visão de câmera da qibla. Nada é gravado nem sai do celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ अलार्म के कामों (कोड या चीज़ दिखाना) और क़िबला कैमरे के लिए। तस्वीर सहेजी नहीं जाती और फ़ोन से बाहर नहीं जाती।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু অ্যালার্মের কাজ (কোড বা জিনিস দেখানো) ও কিবলা ক্যামেরার জন্য। কিছু রেকর্ড হয় না বা ফোন ছেড়ে যায় না।"
          }
        }
      }
    },
