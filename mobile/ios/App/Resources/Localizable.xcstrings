          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak pada hari libur resmi"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرکاری تعطیلات پر نہیں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نه در تعطیلات رسمی"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas les jours fériés"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не в праздники"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "祝日は鳴らさない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공휴일에는 울리지 않기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公共假日不响"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sa mga pampublikong holiday"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ปลุกในวันหยุดราชการ"
          }
        }
      }
    },
    "alarm.skipHolidaysNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiye'deki resmî tatillerde (bayramlar dahil) çalmaz; yarım gün arifelerde çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays silent on Turkish public holidays (including the Eids); still rings on half-day eves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt an türkischen gesetzlichen Feiertagen (auch an den Bayram-Festen) still; an halben Vorabend-Tagen klingelt er."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiyədəki rəsmi bayramlarda (bayramlar daxil) çalmır; yarımgünlük bayram ərəfələrində çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرن في العطلات الرسمية في تركيا (ومنها العيدان)؛ ويرن في أيام الوقفة ذات نصف الدوام."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak berbunyi pada hari libur resmi Turki (termasuk hari raya); tetap berbunyi pada setengah hari menjelang hari raya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترکی کی سرکاری تعطیلات (عیدوں سمیت) پر خاموش رہتا ہے؛ عید سے پہلے کی آدھی چھٹی پر بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تعطیلات رسمی ترکیه (از جمله عیدها) زنگ نمی‌زند؛ در نیمه‌تعطیل‌های پیش از عید زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste silencieuse les jours fériés turcs (y compris les Aïds) ; sonne quand même les demi-journées de veille."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Молчит в государственные праздники Турции (включая байрамы); в сокращённые кануны звонит."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トルコの祝日（イードを含む）は鳴りません。半日休みの前日は鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "튀르키예 공휴일(이드 포함)에는 울리지 않고, 반일 근무 전날에는 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "土耳其公共假日（包括开斋节和宰牲节）不响；半天的节日前夕仍会响。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahimik sa mga pampublikong holiday sa Türkiye (kasama ang mga Eid); tumutunog pa rin sa mga bisperas na kalahating araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ดังในวันหยุดราชการของตุรกี (รวมวันอีด) แต่ยังดังในวันก่อนหยุดครึ่งวัน"
          }
        }
      }
    },
