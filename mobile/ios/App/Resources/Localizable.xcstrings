    "list.ok": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay e-postası gönderdik; gelen kutunuzdaki bağlantıya tıklayınca listeye katılmış olursunuz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We have sent you a confirmation email; click the link in your inbox to complete joining the list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben Ihnen eine Bestätigungs-E-Mail gesendet; klicken Sie auf den Link darin, um die Anmeldung abzuschließen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizə təsdiq e-məktubu göndərdik; siyahıya qoşulmağı tamamlamaq üçün poçt qutunuzdakı keçidə klikləyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلنا إليك رسالة تأكيد؛ انقر الرابط في بريدك الوارد لإتمام الاشتراك في القائمة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami telah mengirim email konfirmasi; klik tautan di dalamnya untuk menyelesaikan pendaftaran."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم نے آپ کو تصدیقی ای میل بھیج دی ہے؛ فہرست میں شامل ہونے کے لیے اس میں دیے گئے لنک پر کلک کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایمیل تأیید برایتان فرستادیم؛ برای کامل شدن عضویت روی پیوند داخل آن کلیک کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous avons envoyé un e-mail de confirmation ; cliquez sur le lien qu’il contient pour terminer votre inscription."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы отправили вам письмо с подтверждением; перейдите по ссылке в нём, чтобы завершить подписку."
          }
        }
      }
    },
    "list.err": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydınız alınamadı. E-posta adresini ve onay kutusunu kontrol edip biraz sonra tekrar deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't save your sign-up. Please check the email address and the checkbox, then try again in a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Anmeldung konnte nicht gespeichert werden. Bitte prüfen Sie die E-Mail-Adresse und das Kontrollkästchen und versuchen Sie es gleich noch einmal."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeydiyyatınızı saxlaya bilmədik. E-poçt ünvanını və qeyd xanasını yoxlayın, sonra bir az sonra yenidən cəhd edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ اشتراكك. يُرجى التحقق من عنوان البريد الإلكتروني ومربع الاختيار، ثم المحاولة مرة أخرى بعد قليل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaftaran Anda tidak dapat disimpan. Periksa alamat email dan kotak centang, lalu coba lagi sebentar lagi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی رکنیت محفوظ نہیں ہو سکی۔ ای میل پتہ اور رضامندی کا خانہ چیک کریں، پھر کچھ دیر بعد دوبارہ کوشش کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عضویت شما ثبت نشد. نشانی ایمیل و گزینهٔ تأیید را بررسی کنید و کمی بعد دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre inscription n’a pas pu être enregistrée. Vérifiez l’adresse e-mail et la case à cocher, puis réessayez dans un instant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить подписку. Проверьте адрес и отметку согласия и через минуту попробуйте снова."
          }
        }
      }
    },
