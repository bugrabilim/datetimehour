    "prayer.method.asrHanafi": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanefî (asr-ı sânî; gölge iki katı)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanafi (shadow twice the length)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanafitisch (doppelte Schattenlänge)"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hənəfi (kölgə iki qat)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحنفي (ظل الشيء مثليه)"
          }
        }
      }
    },
    "prayer.method.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiye'de resmî vakitler Diyanet'in vakitleridir. Başka bir yöntem seçerseniz bu sayfadaki vakitler, aylık çizelge ve imsakiye o yönteme göre hesaplanır; seçim yalnız bu tarayıcıda saklanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Türkiye the official times are those of the Presidency of Religious Affairs (Diyanet). If you choose another method, the times, monthly table and Ramadan timetable on this page are calculated with it; your choice is stored only in this browser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Türkei gelten die Zeiten des Präsidiums für Religionsangelegenheiten (Diyanet). Wählen Sie eine andere Methode, werden die Zeiten, die Monatstabelle und der Ramadan-Kalender auf dieser Seite danach berechnet; die Auswahl wird nur in diesem Browser gespeichert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Türkiyədə rəsmi vaxtlar Diyanət İşləri Başkanlığının vaxtlarıdır. Başqa üsul seçsəniz, bu səhifədəki vaxtlar, aylıq cədvəl və imsakiyyə həmin üsulla hesablanır; seçim yalnız bu brauzerdə saxlanılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المواقيت الرسمية في تركيا هي مواقيت رئاسة الشؤون الدينية (ديانت). إذا اخترت طريقة أخرى تُحسب المواقيت والجدول الشهري وإمساكية رمضان في هذه الصفحة بها؛ ويُحفظ اختيارك في هذا المتصفح فقط."
          }
        }
      }
    },
