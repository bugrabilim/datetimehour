    "zakat.intro": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarları kendi para biriminizde girin. Nisab için gram altın fiyatını yazın; uygulama fiyatı internetten almaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter amounts in your own currency. Type the price of one gram of gold for the nisab; the app does not fetch prices online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Beträge in Ihrer Währung ein. Tragen Sie für den Nisab den Preis eines Gramms Gold ein; die App lädt keine Preise aus dem Internet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məbləğləri öz valyutanızda yazın. Nisab üçün qram qızılın qiymətini yazın; tətbiq qiyməti internetdən almır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل المبالغ بعملتك. اكتب سعر غرام الذهب لحساب النصاب؛ لا يجلب التطبيق الأسعار من الإنترنت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan jumlah dalam mata uang Anda. Ketik harga satu gram emas untuk nisab; aplikasi tidak mengambil harga dari internet."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رقوم اپنی کرنسی میں درج کریں۔ نصاب کے لیے ایک گرام سونے کی قیمت لکھیں؛ ایپ قیمتیں انٹرنیٹ سے نہیں لیتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مبالغ را به پول خودتان وارد کنید. برای نصاب، قیمت یک گرم طلا را بنویسید؛ برنامه قیمت‌ها را از اینترنت نمی‌گیرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez les montants dans votre monnaie. Indiquez le prix d’un gramme d’or pour le nisab ; l’app ne récupère pas les prix en ligne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводите суммы в своей валюте. Для нисаба укажите цену одного грамма золота; приложение не загружает цены из интернета."
          }
        }
      }
    },
