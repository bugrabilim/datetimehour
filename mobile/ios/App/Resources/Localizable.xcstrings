        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دلتان شاد و لبتان خندان باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que votre cœur soit léger et votre visage souriant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть на сердце будет легко, а на лице улыбка."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心は軽やかに、いつも笑顔でありますように。"
