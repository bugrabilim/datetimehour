        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei besten Bedingungen mit bloßem Auge sichtbar"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İdeal şəraitdə çılpaq gözlə görünür"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرى بالعين المجردة في ظروف مثالية"
          }
        },
        "id": {
