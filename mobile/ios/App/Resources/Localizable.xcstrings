    "geo.none": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz konum hatırlatıcısı yok. + ile bir yer seçin; oraya varınca ya da oradan ayrılınca uyarılırsınız."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No location reminders yet. Choose a place with +; you are alerted when you arrive there or leave it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Ortserinnerungen. Wählen Sie mit + einen Ort; Sie werden beim Ankommen oder Verlassen benachrichtigt."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ məkan xatırladıcısı yoxdur. + ilə yer seçin; ora çatanda ya da oradan ayrılanda xəbərdar olunursunuz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تذكيرات بالموقع بعد. اختر مكانًا بـ+؛ وستُنبَّه عند الوصول إليه أو مغادرته."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada pengingat lokasi. Pilih tempat dengan +; Anda diberi tahu saat tiba di sana atau meninggalkannya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی مقام کی یاد دہانی نہیں۔ + سے جگہ چنیں؛ وہاں پہنچنے یا نکلنے پر آپ کو اطلاع ملے گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز یادآور مکانی ندارید. با + مکانی برگزینید؛ هنگام رسیدن به آن یا ترکش آگاه می‌شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun rappel de lieu. Choisissez un lieu avec + ; vous êtes averti à votre arrivée ou à votre départ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминаний по месту пока нет. Выберите место кнопкой +; вы получите сигнал при прибытии или уходе."
          }
        }
      }
    },
