    "qibla.mosquesNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama Apple Haritalar ile yapılır: arama sözcüğü ve yaklaşık bölge Apple'a gider. Bir camiye dokununca Haritalar'da açılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The search uses Apple Maps: the search word and approximate area go to Apple. Tap a mosque to open it in Maps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche nutzt Apple Karten: Suchbegriff und ungefähres Gebiet gehen an Apple. Tippen Sie auf eine Moschee, um sie in Karten zu öffnen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Axtarış Apple Xəritələr ilə edilir: axtarış sözü və təxmini ərazi Apple-a gedir. Məscidə toxunanda Xəritələrdə açılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم البحث عبر خرائط Apple: تُرسل كلمة البحث والمنطقة التقريبية إلى Apple. اضغط على مسجد لفتحه في الخرائط."
          }
        }
      }
    },
    "qibla.mosquesNoteAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Camiler OpenStreetMap verisinden Overpass servisiyle aranır: yalnız yaklaşık bölge (iki ondalığa yuvarlanmış koordinat) bu servise gider. Bir camiye dokununca harita uygulamasında açılır. Veri © OpenStreetMap katkıcıları (ODbL)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosques are searched in OpenStreetMap data via the Overpass service: only the approximate area (coordinates rounded to two decimals) is sent. Tap a mosque to open it in your maps app. Data © OpenStreetMap contributors (ODbL)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Moscheen werden in OpenStreetMap-Daten über den Overpass-Dienst gesucht: Nur das ungefähre Gebiet (auf zwei Dezimalstellen gerundete Koordinaten) wird gesendet. Tippen Sie auf eine Moschee, um sie in Ihrer Karten-App zu öffnen. Daten © OpenStreetMap-Mitwirkende (ODbL)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məscidlər OpenStreetMap məlumatında Overpass xidməti ilə axtarılır: yalnız təxmini ərazi (iki onluğa yuvarlaqlaşdırılmış koordinat) göndərilir. Məscidə toxunanda xəritə tətbiqində açılır. Məlumat © OpenStreetMap iştirakçıları (ODbL)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم البحث عن المساجد في بيانات OpenStreetMap عبر خدمة Overpass: تُرسل المنطقة التقريبية فقط (إحداثيات مقرّبة إلى منزلتين عشريتين). اضغط على مسجد لفتحه في تطبيق الخرائط. البيانات © مساهمو OpenStreetMap ‏(ODbL)."
          }
        }
      }
    },
