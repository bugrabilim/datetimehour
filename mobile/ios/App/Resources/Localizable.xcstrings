    "panchang.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dilimler gelenektir; Saat Tarih astrolojik yorum yapmaz. Saatler dakikaya yuvarlanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These periods are tradition; Saat Tarih makes no astrological interpretation. Times are rounded to the minute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zeitabschnitte sind Tradition; Saat Tarih deutet sie nicht astrologisch. Die Zeiten sind auf die Minute gerundet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dilimlər ənənədir; Saat Tarih astroloji şərh vermir. Saatlar dəqiqəyə yuvarlaqlaşdırılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الفترات تقليد؛ ولا يقدّم «Saat Tarih» تفسيرًا تنجيميًا. الأوقات مقرّبة إلى الدقيقة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periode ini adalah tradisi; Saat Tarih tidak memberikan tafsiran astrologi. Waktu dibulatkan ke menit."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اوقات روایت ہیں؛ Saat Tarih کوئی نجومی تعبیر نہیں کرتا۔ اوقات منٹ تک گول کیے جاتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این بازه‌ها سنت‌اند؛ Saat Tarih تفسیر طالع‌بینی نمی‌کند. زمان‌ها به دقیقه گرد می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces périodes relèvent de la tradition ; Saat Tarih n'en fait aucune interprétation astrologique. Les horaires sont arrondis à la minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти периоды — традиция; Saat Tarih не даёт астрологических толкований. Время округляется до минуты."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの時間帯は伝統によるもので、Saat Tarih は占星術的な解釈をしません。時刻は分単位に丸めています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간대는 전통이며 Saat Tarih는 점성술적 해석을 하지 않습니다. 시간은 분 단위로 반올림합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些时段属于传统；Saat Tarih 不作任何占星解读。时间四舍五入到分钟。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tradisyon ang mga yugtong ito; walang astrolohikong interpretasyon ang Saat Tarih. Ini-round sa minuto ang mga oras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงเวลาเหล่านี้เป็นประเพณี Saat Tarih ไม่ตีความทางโหราศาสตร์ เวลาปัดเป็นนาที"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos periodos son tradición; Saat Tarih no hace interpretaciones astrológicas. Los horarios se redondean al minuto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses períodos são tradição; o Saat Tarih não faz interpretações astrológicas. Os horários são arredondados para o minuto."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये काल परंपरा हैं; Saat Tarih कोई ज्योतिषीय व्याख्या नहीं करता। समय मिनट तक पूर्णांकित है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কালগুলো ঐতিহ্য; Saat Tarih কোনো জ্যোতিষ ব্যাখ্যা দেয় না। সময় মিনিট পর্যন্ত পূর্ণ করা হয়।"
          }
        }
      }
    },
