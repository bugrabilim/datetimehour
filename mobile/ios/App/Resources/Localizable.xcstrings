    "wake.checkBody": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokunun; dokunmazsanız alarm 2 dakika sonra yeniden çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap here; otherwise the alarm rings again in 2 minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie hier; sonst klingelt der Wecker in 2 Minuten erneut."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Toxunun; toxunmasanız zəng 2 dəqiqə sonra yenidən çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس هنا؛ وإلا يرنّ المنبّه مجددًا بعد دقيقتين."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk di sini; jika tidak, alarm berbunyi lagi dalam 2 menit."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں ٹیپ کریں؛ ورنہ الارم 2 منٹ میں پھر بجے گا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اینجا بزنید؛ وگرنه هشدار 2 دقیقهٔ دیگر دوباره زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ici ; sinon l’alarme sonnera de nouveau dans 2 minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите здесь; иначе будильник зазвонит снова через 2 минуты."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここをタップしてください。タップしないと2分後にアラームがまた鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기를 누르세요. 그렇지 않으면 2분 뒤 알람이 다시 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点这里；否则闹钟会在2分钟后再次响起。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap dito; kung hindi, tutunog muli ang alarma sa loob ng 2 minuto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะที่นี่ ไม่เช่นนั้นนาฬิกาปลุกจะดังอีกครั้งใน 2 นาที"
          }
        }
      }
    },
