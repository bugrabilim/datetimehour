    "widget.next.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki vakit, saati ve kalan süre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next prayer, its time and the time left."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das nächste Gebet, seine Uhrzeit und die verbleibende Zeit."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Növbəti vaxt, saatı və qalan müddət."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصلاة التالية ووقتها والوقت المتبقي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salat berikutnya, waktunya, dan sisa waktunya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگلی نماز، اس کا وقت اور باقی وقت۔"
          }
        },
        "fa": {
          "stringUnit": {
