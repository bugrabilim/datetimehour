    "alarm.sleepLinked": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku planına bağlı: plan değişince bu alarm da değişir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linked to your sleep plan: it changes when the plan changes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Schlafplan verknüpft: ändert sich mit dem Plan."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuxu planına bağlıdır: plan dəyişəndə bu zəng də dəyişir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرتبط بخطة النوم: يتغير عند تغيّر الخطة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung ke rencana tidur: ikut berubah saat rencana berubah."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیند کے منصوبے سے جڑا: منصوبہ بدلے تو یہ بھی بدلتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به برنامه خواب وصل است: با تغییر برنامه تغییر می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lié au planning de sommeil : change avec lui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связан с планом сна: меняется вместе с ним."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠プランと連動：プランを変えるとこのアラームも変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 계획과 연결됨: 계획이 바뀌면 함께 바뀝니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
