          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visível a olho nu em condições perfeitas"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेहतरीन हालात में नंगी आँखों से दिखता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আদর্শ পরিস্থিতিতে খালি চোখে দেখা যায়"
