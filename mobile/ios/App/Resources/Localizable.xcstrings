    "account.badgesAsk": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda %1$@ rozet var, hesabınıza ekleyelim mi?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are %1$@ badges on this device. Shall we add them to your account?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät gibt es %1$@ Abzeichen. Sollen wir sie Ihrem Konto hinzufügen?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda %1$@ nişan var, hesabınıza əlavə edək?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على هذا الجهاز %1$@ شارة. هل نضيفها إلى حسابك؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada %1$@ lencana di perangkat ini. Tambahkan ke akun Anda?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلے پر %1$@ بیج ہیں۔ کیا انہیں آپ کے اکاؤنٹ میں شامل کریں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی این دستگاه %1$@ نشان هست. به حسابتان بیفزاییم؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil compte %1$@ badges. Les ajouter à votre compte ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве значков: %1$@. Добавить их в ваш аккаунт?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にはバッジが%1$@個あります。アカウントに追加しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 배지가 %1$@개 있습니다. 계정에 추가할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上有 %1$@ 个徽章。要添加到您的账户吗？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May %1$@ badge sa device na ito. Idagdag ba sa inyong account?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้มีเหรียญตรา %1$@ เหรียญ เพิ่มลงในบัญชีของคุณไหม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo tiene %1$@ insignias. ¿Las añadimos a su cuenta?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aparelho tem %1$@ selos. Vamos adicioná-los à sua conta?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर %1$@ बैज हैं। क्या इन्हें आपके खाते में जोड़ें?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে %1$@টি ব্যাজ আছে। আপনার অ্যাকাউন্টে যোগ করব?"
          }
        }
      }
    },
