    "metronome.tempoNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İtalyanca tempo adları yaklaşık aralıklardır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Italian tempo names are approximate ranges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die italienischen Tempobezeichnungen sind ungefähre Bereiche."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İtalyan temp adları təxmini aralıqlardır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسماء السرعات الإيطالية نطاقات تقريبية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama tempo dalam bahasa Italia menunjukkan rentang perkiraan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رفتار کے اطالوی نام اندازاً حدود ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام‌های ایتالیایی تمپو بازه‌هایی تقریبی‌اند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les indications de tempo italiennes sont des plages approximatives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итальянские обозначения темпа — приблизительные диапазоны."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イタリア語のテンポ表記はおおよその範囲です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이탈리아어 빠르기말은 대략적인 범위입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "意大利语速度术语为大致范围。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinatayang saklaw lang ang mga pangalan ng tempo sa Italyano."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อความเร็วภาษาอิตาลีเป็นช่วงโดยประมาณ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres italianos del tempo son intervalos aproximados."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes italianos de andamento são faixas aproximadas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतालवी टेम्पो नाम अनुमानित सीमाएँ हैं।"
