    "cals.tibetan.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tibet takvimine (Phugpa sistemi) göre tarih, Losar ve Budizm'in büyük günleri (düchen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date in the Tibetan calendar (Phugpa system), Losar and the great Buddhist days (düchen)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum im tibetischen Kalender (Phugpa-System), Losar und die großen buddhistischen Tage (Düchen)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tibet təqviminə (Phugpa sistemi) görə tarix, Losar və Buddizmin böyük günləri (düçen)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ في التقويم التبتي (نظام فوغبا)، ولوسار، والأيام البوذية الكبرى (دوتشن)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal menurut kalender Tibet (sistem Phugpa), Losar, dan hari-hari besar Buddhis (düchen)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تبتی کیلنڈر (پھگپا نظام) کے مطابق تاریخ، لوسار اور بدھ مت کے بڑے دن (دوچن)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ در گاه‌شماری تبتی (نظام فوگپا)، لوسار و روزهای بزرگ بودایی (دوچن)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date du calendrier tibétain (système Phugpa), Losar et les grands jours bouddhistes (düchen)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата по тибетскому календарю (система Пхугпа), Лосар и великие буддийские дни (дючен)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チベット暦（プクパ派）の日付、ロサル（新年）と仏教の四大祭日（ドゥーチェン）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "티베트력(푸그파 체계)의 날짜, 로사르(설날)와 불교의 큰 기념일(뒤첸)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "藏历（浦派历算）的日期、藏历新年和佛教的重大节日（四大节日）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang petsa sa kalendaryong Tibetano (sistemang Phugpa), ang Losar at ang mga dakilang araw ng Budismo (düchen)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ตามปฏิทินทิเบต (ระบบพุกปะ) วันโลซาร์ และวันสำคัญยิ่งทางพุทธศาสนา (ดือเชน)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha del calendario tibetano (sistema Phugpa), el Losar y los grandes días budistas (düchen)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A data no calendário tibetano (sistema Phugpa), o Losar e os grandes dias budistas (düchen)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिब्बती पंचांग (फुगपा पद्धति) के अनुसार तिथि, लोसर और बौद्ध धर्म के बड़े दिन (दुचेन)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তিব্বতি পঞ্জিকা (ফুগপা পদ্ধতি) অনুযায়ী তারিখ, লোসার এবং বৌদ্ধধর্মের বড় দিনগুলো (দুচেন)।"
          }
        }
      }
    },
    "cals.tibetan.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phugpa sistemiyle hesaplanır; Dalay Lama'nın kurumu Men-Tsee-Khang'ın yıllıkları bu sistemdedir. Bir ay iki kez gelirse bayramlar birincisinde tutulur; bazı gün numaraları atlanır ya da iki kez sayılır. Bhutan ve bazı topluluklar başka sürümler kullanır; Moğol yılbaşı Moğol takvimindedir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated with the Phugpa system, used by the almanacs of Men-Tsee-Khang, the Dalai Lama's institute. When a month occurs twice, festivals are kept in the first one; some day numbers are skipped or counted twice. Bhutan and some communities use other versions; the Mongolian New Year is in the Mongolian calendar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet nach dem Phugpa-System, das die Almanache von Men-Tsee-Khang, dem Institut des Dalai Lama, verwenden. Kommt ein Monat zweimal vor, werden Feste im ersten begangen; manche Tageszahlen werden übersprungen oder doppelt gezählt. Bhutan und einige Gemeinschaften nutzen andere Fassungen; das mongolische Neujahr steht im mongolischen Kalender."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Phugpa sistemi ilə hesablanır; Dalay Lamanın qurumu Men-Tsee-Khang-ın illikləri bu sistemdədir. Bir ay iki dəfə gəlirsə, bayramlar birincisində qeyd olunur; bəzi gün nömrələri buraxılır və ya iki dəfə sayılır. Butan və bəzi icmalar başqa variantlardan istifadə edir; Monqol yeni ili Monqol təqvimindədir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحسب بنظام فوغبا الذي تعتمده تقاويم منتسي‌خانغ، مؤسسة الدالاي لاما. إذا تكرر الشهر تُقام الأعياد في الأول منهما؛ وتُسقط بعض أرقام الأيام أو تُعدّ مرتين. تستخدم بوتان وبعض الجماعات صيغًا أخرى؛ ورأس السنة المنغولية في التقويم المنغولي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihitung dengan sistem Phugpa yang dipakai almanak Men-Tsee-Khang, lembaga Dalai Lama. Jika satu bulan muncul dua kali, hari raya dirayakan pada bulan yang pertama; beberapa nomor hari dilewati atau dihitung dua kali. Bhutan dan sebagian komunitas memakai versi lain; Tahun Baru Mongolia ada di kalender Mongolia."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پھگپا نظام سے حساب کیا جاتا ہے، جسے دلائی لامہ کے ادارے من سی کھانگ کی جنتریاں استعمال کرتی ہیں۔ اگر کوئی مہینہ دو بار آئے تو تہوار پہلے میں منائے جاتے ہیں؛ کچھ دنوں کے نمبر چھوڑ دیے جاتے ہیں یا دو بار گنے جاتے ہیں۔ بھوٹان اور کچھ برادریاں دوسرے نسخے استعمال کرتی ہیں؛ منگول نیا سال منگول کیلنڈر میں ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با نظام فوگپا حساب می‌شود که سالنامه‌های من‌سی‌خانگ، مؤسسهٔ دالایی لاما، به کار می‌برند. اگر ماهی دو بار بیاید، جشن‌ها در نخستین آن برگزار می‌شوند؛ برخی شماره‌های روز حذف یا دو بار شمرده می‌شوند. بوتان و برخی جوامع نسخه‌های دیگری دارند؛ سال نو مغولی در گاه‌شماری مغولی است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé selon le système Phugpa, celui des almanachs du Men-Tsee-Khang, l’institut du dalaï-lama. Quand un mois revient deux fois, les fêtes ont lieu dans le premier ; certains numéros de jour sont sautés ou comptés deux fois. Le Bhoutan et certaines communautés suivent d’autres versions ; le Nouvel An mongol figure dans le calendrier mongol."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расчёт по системе Пхугпа, которой следуют альманахи Мен-Ци-Кханга, института Далай-ламы. Если месяц повторяется, праздники отмечают в первом из них; некоторые номера дней пропускаются или повторяются. Бутан и некоторые общины пользуются другими версиями; монгольский Новый год — в монгольском календаре."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダライ・ラマの研究所メンツィーカンの暦書が用いるプクパ派の方式で計算しています。同じ月が2回ある年は、祭日を最初の月に置きます。日の番号が飛んだり重なったりすることがあります。ブータンや一部の地域は別の方式を使います。モンゴルの正月はモンゴル暦にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달라이 라마의 기관인 멘시캉의 역서가 쓰는 푸그파 체계로 계산합니다. 같은 달이 두 번 있으면 축일은 첫 번째 달에 지냅니다. 날짜 번호가 건너뛰거나 두 번 세어지기도 합니다. 부탄과 일부 공동체는 다른 체계를 씁니다. 몽골 설날은 몽골력에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按浦派历算法计算，达赖喇嘛的门孜康历书即用此法。同一个月重复时，节日在第一个月过；有些日序会跳过或重复。不丹和部分地区使用其他版本；蒙古新年见蒙古历。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinakalkula sa sistemang Phugpa na ginagamit ng mga almanac ng Men-Tsee-Khang, ang institusyon ng Dalai Lama. Kapag dalawang beses dumating ang isang buwan, sa una ipinagdiriwang ang mga pista; may mga numero ng araw na nilalaktawan o binibilang nang dalawang beses. Ibang bersiyon ang gamit ng Bhutan at ilang komunidad; nasa kalendaryong Mongol ang Bagong Taon ng Mongolia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำนวณด้วยระบบพุกปะ ซึ่งปฏิทินของเมนซีคัง สถาบันของดาไลลามะ ใช้อยู่ เมื่อเดือนใดมีซ้ำสองครั้ง เทศกาลจะจัดในเดือนแรก บางวันอาจถูกข้ามหรือนับซ้ำ ภูฏานและบางชุมชนใช้ระบบอื่น ส่วนปีใหม่มองโกลอยู่ในปฏิทินมองโกล"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se calcula con el sistema Phugpa, el de los almanaques del Men-Tsee-Khang, el instituto del dalái lama. Cuando un mes se repite, las fiestas se celebran en el primero; algunos números de día se saltan o se cuentan dos veces. Bután y algunas comunidades usan otras versiones; el Año Nuevo mongol está en el calendario mongol."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado pelo sistema Phugpa, o dos almanaques do Men-Tsee-Khang, o instituto do dalai-lama. Quando um mês se repete, as festas são no primeiro; alguns números de dia são pulados ou contados duas vezes. O Butão e algumas comunidades usam outras versões; o Ano-Novo mongol está no calendário mongol."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फुगपा पद्धति से गणना की जाती है, जिसे दलाई लामा की संस्था मेन-त्सी-खांग के पंचांग अपनाते हैं। कोई महीना दो बार आए तो पर्व पहले महीने में मनाए जाते हैं; कुछ तिथि-संख्याएँ छूट जाती हैं या दो बार गिनी जाती हैं। भूटान और कुछ समुदाय दूसरी पद्धतियाँ अपनाते हैं; मंगोल नववर्ष मंगोल पंचांग में है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফুগপা পদ্ধতিতে হিসাব করা হয়, যা দালাই লামার প্রতিষ্ঠান মেন-ৎসি-খাংয়ের পঞ্জিকা অনুসরণ করে। কোনো মাস দুবার এলে উৎসব প্রথম মাসে পালিত হয়; কিছু দিনের সংখ্যা বাদ পড়ে বা দুবার গোনা হয়। ভুটান ও কিছু সম্প্রদায় অন্য পদ্ধতি মানে; মঙ্গোল নববর্ষ মঙ্গোল পঞ্জিকায় আছে।"
          }
        }
      }
    },
