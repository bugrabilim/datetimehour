        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى التقويم متوقف؛ فعّله من «اعرض التقويمات على هاتفي» في تبويب التقويم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kalender nonaktif; aktifkan dengan \"Tampilkan kalender ponsel saya\" di tab Kalender."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر تک رسائی بند ہے؛ کیلنڈر ٹیب میں «میرے فون کے کیلنڈر دکھائیں» سے آن کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به تقویم خاموش است؛ با «نمایش تقویم‌های گوشی» در زبانهٔ تقویم روشنش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier est désactivé ; activez-le avec « Afficher les calendriers du téléphone » dans l’onglet Calendrier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю выключен; включите его кнопкой «Показать календари телефона» на вкладке «Календарь»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスがオフです。カレンダータブの「スマホのカレンダーを表示」でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력 접근이 꺼져 있습니다. 달력 탭의 \"휴대폰의 달력 보기\"로 켜세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历访问已关闭；请在日历标签页用“显示手机上的日历”开启。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang access sa kalendaryo; i-on ito gamit ang \"Ipakita ang mga kalendaryo ng aking telepono\" sa tab na Kalendaryo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงปฏิทินปิดอยู่ เปิดได้ด้วย \"แสดงปฏิทินในโทรศัพท์\" ในแท็บปฏิทิน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al calendario está desactivado; actívelo con \"Mostrar los calendarios de mi teléfono\" en la pestaña Calendario."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao calendário está desativado; ative com \"Mostrar os calendários do meu celular\" na aba Calendário."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर की पहुँच बंद है; कैलेंडर टैब में \"मेरे फ़ोन के कैलेंडर दिखाएँ\" से चालू करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডারের অনুমতি বন্ধ; ক্যালেন্ডার ট্যাবে \"আমার ফোনের ক্যালেন্ডার দেখান\" দিয়ে চালু করুন।"
          }
        }
      }
    },
