    "alarm.volumeNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun alarm ses düzeyine göre; kademeli seste ulaşılacak en yüksek düzey."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relative to the phone's alarm volume; with gradual volume, the loudest it gets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezogen auf die Weckerlautstärke des Telefons; bei ansteigender Lautstärke der Höchstwert."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun zəngli saat səs səviyyəsinə görə; tədricən artan səsdə ən yüksək səviyyə."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسبةً إلى مستوى صوت المنبه في الهاتف؛ وفي الصوت المتدرج هو أعلى مستوى."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Relatif terhadap volume alarm ponsel; pada volume bertahap, ini batas tertingginya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون کے الارم والیوم کے لحاظ سے؛ بتدریج آواز میں سب سے اونچی سطح۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسبت به صدای هشدار گوشی؛ در صدای تدریجی، بیشترین میزان."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par rapport au volume d'alarme du téléphone ; avec le volume progressif, le niveau maximal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Относительно громкости будильника телефона; при нарастании — максимальный уровень."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末のアラーム音量に対する割合。だんだん大きくする場合は最大音量。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰 알람 음량 기준이며, 점점 커지는 소리에서는 최대 음량입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对于手机闹钟音量；渐强时为最高音量。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Batay sa lakas ng alarma ng telepono; sa unti-unting paglakas, ito ang pinakamalakas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทียบกับระดับเสียงปลุกของโทรศัพท์ เมื่อเสียงค่อยๆ ดังขึ้นคือระดับสูงสุด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Relativo al volumen de alarma del teléfono; con volumen gradual, el máximo que alcanza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Relativo ao volume de alarme do celular; com volume gradual, o máximo que ele atinge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन के अलार्म वॉल्यूम के अनुसार; धीरे-धीरे बढ़ती आवाज़ में यह सबसे ऊँचा स्तर है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোনের অ্যালার্ম শব্দমাত্রার তুলনায়; ধীরে বাড়া শব্দে এটি সর্বোচ্চ মাত্রা।"
          }
        }
      }
    },
