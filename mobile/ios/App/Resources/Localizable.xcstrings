    "tools.alarm.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıda çalışan ücretsiz alarm: saat, etiket, hafta günlerine göre tekrar, 5 dakika erteleme ve bildirim. Alarm sayfa açıkken çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free alarm that runs in your browser: time, label, repeat on chosen weekdays, 5-minute snooze and notifications. The alarm rings while the page is open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenloser Browser-Wecker: Uhrzeit, Bezeichnung, Wiederholung an Wochentagen, 5 Min. Schlummern, Benachrichtigungen. Er klingelt bei geöffneter Seite."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Brauzerdə işləyən pulsuz zəngli saat: vaxt, ad, seçilmiş günlərdə təkrar, 5 dəqiqəlik təxirə salma və bildirişlər. Səhifə açıq olduqca çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منبّه مجاني يعمل في متصفحك: الوقت، والتسمية، والتكرار في أيام تختارها، وغفوة 5 دقائق، وإشعارات. يرنّ المنبّه ما دامت الصفحة مفتوحة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm gratis yang berjalan di peramban: waktu, label, ulangi pada hari pilihan, tunda 5 menit, dan notifikasi. Alarm berbunyi selama halaman terbuka."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "براؤزر میں چلنے والا مفت الارم: وقت، لیبل، منتخب دنوں پر دہرانا، 5 منٹ کا اسنوز اور اطلاعات۔ صفحہ کھلا رہنے تک الارم بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زنگ رایگانی که در مرورگر کار می‌کند: ساعت، برچسب، تکرار در روزهای دلخواه، تعویق 5 دقیقه‌ای و اعلان. زنگ فقط وقتی صفحه باز باشد به صدا درمی‌آید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réveil en ligne gratuit dans votre navigateur : heure, libellé, répétition, rappel de 5 minutes et notifications. Il ne sonne que si la page est ouverte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный будильник в браузере: время, подпись, повтор по выбранным дням, отсрочка на 5 минут и уведомления. Будильник звонит, пока страница открыта."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで動く無料のアラーム：時刻、ラベル、曜日ごとの繰り返し、5分スヌーズ、通知。アラームはページを開いている間に鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 동작하는 무료 알람: 시간, 라벨, 요일별 반복, 5분 다시 알림, 알림. 알람은 페이지가 열려 있는 동안 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器中运行的免费闹钟：时间、标签、按星期重复、5 分钟稍后提醒和通知。页面打开时闹钟才会响。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Libreng alarma na tumatakbo sa browser: oras, label, ulit sa piling araw, 5-minutong snooze at notifications. Tumutunog ang alarma habang bukas ang pahina."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาปลุกฟรีที่ทำงานในเบราว์เซอร์: เวลา ป้ายกำกับ ทำซ้ำตามวันในสัปดาห์ เลื่อนปลุก 5 นาที และการแจ้งเตือน นาฬิกาปลุกดังขณะเปิดหน้าอยู่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarma gratis en el navegador: hora, etiqueta, repetición en días elegidos, aplazamiento de 5 minutos y notificaciones. Suena con la página abierta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarme grátis que funciona no navegador: hora, rótulo, repetição nos dias escolhidos, soneca de 5 minutos e notificações. O alarme toca enquanto a página estiver aberta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउज़र में चलने वाला मुफ़्त अलार्म: समय, लेबल, चुने दिनों पर दोहराव, 5 मिनट का स्नूज़ और सूचनाएँ। पेज खुला रहने तक अलार्म बजता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ব্রাউজারে চলা বিনামূল্যের অ্যালার্ম: সময়, লেবেল, বাছাই করা বারে পুনরাবৃত্তি, 5 মিনিটের স্নুজ ও নোটিফিকেশন। পাতা খোলা থাকলে অ্যালার্ম বাজে।"
          }
        }
      }
    },
