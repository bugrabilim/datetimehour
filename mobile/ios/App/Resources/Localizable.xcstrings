    "track.pausedSince": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarihinden beri duraklatıldı; bu günler istatistiğe ve kazaya girmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused since %1$@; these days are left out of statistics and missed prayers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert seit %1$@; diese Tage zählen weder in der Statistik noch als nachzuholend."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarixindən bəri dayandırılıb; bu günlər statistikaya və qəzaya girmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف منذ %1$@؛ لا تُحسب هذه الأيام في الإحصاءات ولا الفوائت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda sejak %1$@; hari-hari ini tidak masuk statistik dan qada."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ سے رکی ہوئی؛ یہ دن اعداد و شمار اور قضا میں شامل نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از %1$@ متوقف است؛ این روزها در آمار و قضا شمرده نمی‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu depuis le %1$@ ; ces jours ne comptent ni dans les statistiques ni dans les rattrapages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановлено с %1$@; эти дни не входят в статистику и пропущенные."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@から停止中。この期間は統計にも補いにも含めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@부터 일시 중지됨. 이 기간은 통계와 보충에 들어가지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自 %1$@ 起暂停；这些天不计入统计和补礼。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-pause mula %1$@; hindi kasama ang mga araw na ito sa estadistika at qada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดตั้งแต่ %1$@ วันเหล่านี้จะไม่นับในสถิติและการชดใช้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa desde el %1$@; estos días quedan fuera de las estadísticas y las oraciones pendientes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado desde %1$@; esses dias ficam fora das estatísticas e das orações devidas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ से रुका है; ये दिन आँकड़ों और क़ज़ा नमाज़ों में नहीं गिने जाते।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ থেকে স্থগিত; এই দিনগুলো পরিসংখ্যান ও কাজা নামাজের বাইরে থাকে।"
          }
        }
      }
    },
