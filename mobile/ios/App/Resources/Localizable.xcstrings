    "dua.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur'an'dan olan duaların Arapçası Tanzil metninden alınmıştır; diğerleri yaygın metinlerle karşılaştırılmıştır. Anlamlar açıklama amaçlıdır; doğru okunuş için bir hocaya danışın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Arabic of Quranic prayers is taken from the Tanzil text; the others were checked against common sources. Meanings are explanatory; for correct recitation ask a teacher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der arabische Text der Koran-Bittgebete stammt aus dem Tanzil-Text; die übrigen wurden mit verbreiteten Quellen verglichen. Die Bedeutungen dienen der Erklärung; für die richtige Rezitation fragen Sie einen Lehrer."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qurandan olan duaların ərəbcəsi Tanzil mətnindən götürülüb; digərləri geniş yayılmış mənbələrlə müqayisə edilib. Mənalar izah məqsədlidir; düzgün oxunuş üçün müəllimə müraciət edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص العربي للأدعية القرآنية مأخوذ من نص تنزيل، وقوبلت الأدعية الأخرى بمصادر شائعة. للقراءة الصحيحة استشر معلمًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks Arab doa-doa dari Al-Qur'an diambil dari teks Tanzil; yang lain diperiksa dengan sumber umum. Makna bersifat penjelasan; untuk bacaan yang benar, tanyakan kepada guru."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قرآنی دعاؤں کا عربی متن تنزیل سے لیا گیا ہے؛ باقی عام ذرائع سے جانچی گئی ہیں۔ معانی وضاحتی ہیں؛ درست تلاوت کے لیے کسی استاد سے پوچھیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متن عربی دعاهای قرآنی از متن تنزیل گرفته شده؛ بقیه با منابع رایج سنجیده شده‌اند. معانی توضیحی‌اند؛ برای قرائت درست از استاد بپرسید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arabe des invocations coraniques provient du texte Tanzil ; les autres ont été vérifiées dans des sources courantes. Les significations sont données à titre explicatif ; pour une récitation correcte, demandez à un enseignant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Арабский текст коранических мольб взят из текста Tanzil; остальные сверены с распространёнными источниками. Значения даны как пояснения; за правильным чтением обратитесь к учителю."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クルアーンにある祈りのアラビア語はTanzilの本文から取り、それ以外は一般的な出典と照合しました。意味は説明のためのものです。正しい読誦は先生に習ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꾸란에 있는 기도문의 아랍어는 Tanzil 본문에서 가져왔고, 나머지는 널리 쓰이는 출처와 대조했습니다. 뜻은 설명용입니다. 바른 낭송은 선생님께 배우세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "古兰经中祈祷词的阿拉伯文取自Tanzil原文；其他祈祷词已与常见资料核对。释义仅作解释；正确诵读请向老师学习。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinuha sa tekstong Tanzil ang Arabic ng mga panalangin mula sa Quran; sinuri sa karaniwang sanggunian ang iba. Paliwanag lang ang mga kahulugan; para sa wastong pagbigkas, magtanong sa guro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาษาอาหรับของดุอาอ์จากอัลกุรอานนำมาจากตัวบท Tanzil ส่วนอื่นตรวจทานกับแหล่งที่ใช้กันทั่วไป ความหมายเป็นคำอธิบาย สำหรับการอ่านที่ถูกต้องโปรดเรียนกับครู"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El árabe de las súplicas coránicas procede del texto de Tanzil; las demás se cotejaron con fuentes habituales. Los significados son explicativos; para una recitación correcta, pregunte a un maestro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O árabe das súplicas do Alcorão vem do texto do Tanzil; as outras foram conferidas com fontes comuns. Os significados são explicativos; para a recitação correta, pergunte a um professor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क़ुरआनी दुआओं का अरबी पाठ Tanzil से लिया गया है; बाकी को आम स्रोतों से मिलाया गया है। अर्थ समझाने के लिए हैं; सही पढ़ने के लिए किसी उस्ताद से पूछें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কুরআনের দোয়াগুলোর আরবি তানজিল পাঠ থেকে নেওয়া; অন্যগুলো প্রচলিত উৎসের সঙ্গে মিলিয়ে দেখা। অর্থগুলো ব্যাখ্যামূলক; সঠিক তিলাওয়াতের জন্য একজন শিক্ষকের সাহায্য নিন।"
          }
        }
      }
    },
