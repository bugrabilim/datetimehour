          "stringUnit": {
            "state": "translated",
            "value": "Çox cəhd edildi. Bir az sonra yenidən cəhd edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة. حاول بعد قليل."
