    "notify.weatherAlerts.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarın belirgin şekilde soğuk ya da sıcaksa akşam 19.00'da; yağmur yaklaşınca 15 dakika önce (saatlik tahminden)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At 7 pm if tomorrow is noticeably colder or warmer; 15 minutes before rain (from the hourly forecast)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um 19 Uhr, wenn es morgen deutlich kälter oder wärmer wird; 15 Minuten vor Regen (laut Stundenprognose)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah nəzərəçarpacaq soyuq və ya isti olacaqsa axşam 19:00-da; yağışdan 15 dəqiqə əvvəl (saatlıq proqnozdan)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في السابعة مساءً إذا كان الغد أبرد أو أدفأ بوضوح؛ وقبل المطر بربع ساعة (من التوقعات بالساعة)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pukul 19.00 jika besok jauh lebih dingin atau panas; 15 menit sebelum hujan (dari prakiraan per jam)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر کل واضح طور پر ٹھنڈا یا گرم ہو تو شام 7 بجے؛ بارش سے 15 منٹ پہلے (گھنٹہ وار پیش گوئی سے)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر فردا به‌طور محسوسی سردتر یا گرم‌تر باشد ساعت 19؛ و 15 دقیقه پیش از باران (از پیش‌بینی ساعتی)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À 19 h si demain est nettement plus froid ou plus chaud ; 15 minutes avant la pluie (prévision horaire)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В 19:00, если завтра будет заметно холоднее или теплее; за 15 минут до дождя (по почасовому прогнозу)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日が大きく寒く・暖かくなる日は19時に、雨の15分前にも（1時間ごとの予報から）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일 눈에 띄게 춥거나 더우면 오후 7시에, 비 오기 15분 전에(시간별 예보 기준) 알려 드립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天明显变冷或变暖时晚上 7 点提醒；下雨前 15 分钟提醒（依据逐小时预报）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Alas-7 ng gabi kung mas malamig o mas mainit bukas; 15 minuto bago umulan (mula sa oras-oras na forecast)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลา 19:00 หากพรุ่งนี้หนาวหรือร้อนขึ้นชัดเจน และ 15 นาทีก่อนฝนตก (จากพยากรณ์รายชั่วโมง)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A las 19:00 si mañana va a hacer bastante más frío o calor; 15 minutos antes de la lluvia (según la previsión por horas)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Às 19:00 se amanhã for bem mais frio ou quente; 15 minutos antes da chuva (pela previsão por hora)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर कल काफ़ी ठंडा या गर्म हो तो शाम 19:00 बजे; बारिश से 15 मिनट पहले (घंटेवार पूर्वानुमान से)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাল যদি লক্ষণীয়ভাবে বেশি ঠান্ডা বা গরম হয় তবে সন্ধ্যা 7টায়; বৃষ্টির 15 মিনিট আগে (ঘণ্টাভিত্তিক পূর্বাভাস থেকে)।"
          }
        }
      }
    },
