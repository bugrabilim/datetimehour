            "value": "Циклов: %1$@ · %2$@ ч"
          }
        }
      }
    },
    "sleep.cycles.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku yaklaşık 90 dakikalık döngülerle ilerler; uykuya dalmak için 15 dakika eklenir. Bir döngünün sonunda uyanmak daha kolay olabilir. Bu bir öneridir, tıbbi bilgi değildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep moves in cycles of about 90 minutes; 15 minutes are added to fall asleep. Waking at the end of a cycle may feel easier. This is a suggestion, not medical advice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlaf verläuft in Zyklen von etwa 90 Minuten; zum Einschlafen werden 15 Minuten addiert. Am Ende eines Zyklus aufzuwachen kann leichter fallen. Das ist ein Vorschlag, kein medizinischer Rat."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuxu təxminən 90 dəqiqəlik dövrlərlə gedir; yuxuya getmək üçün 15 dəqiqə əlavə olunur. Dövrün sonunda oyanmaq daha asan ola bilər. Bu tövsiyədir, tibbi məlumat deyil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسير النوم في دورات مدتها نحو 90 دقيقة، وتُضاف 15 دقيقة للخلود إلى النوم. قد يكون الاستيقاظ في نهاية دورة أسهل. هذا اقتراح وليس نصيحة طبية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidur berjalan dalam siklus sekitar 90 menit; ditambah 15 menit untuk terlelap. Bangun di akhir siklus mungkin terasa lebih mudah. Ini saran, bukan nasihat medis."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیند تقریباً 90 منٹ کے چکروں میں چلتی ہے؛ سونے کے لیے 15 منٹ جوڑے گئے ہیں۔ چکر کے آخر میں جاگنا آسان لگ سکتا ہے۔ یہ مشورہ ہے، طبی رائے نہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خواب در چرخه‌هایی حدوداً 90 دقیقه‌ای پیش می‌رود؛ 15 دقیقه برای به خواب رفتن افزوده می‌شود. بیدار شدن در پایان یک چرخه ممکن است آسان‌تر باشد. این یک پیشنهاد است، نه توصیهٔ پزشکی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sommeil avance par cycles d’environ 90 minutes ; 15 minutes sont ajoutées pour s’endormir. Se réveiller en fin de cycle peut sembler plus facile. C’est une suggestion, pas un avis médical."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон идёт циклами примерно по 90 минут; добавлено 15 минут на засыпание. Просыпаться в конце цикла может быть легче. Это подсказка, а не медицинский совет."
          }
        }
      }
    },
    "sleep.sounds.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesler telefonda üretilir, dosya indirilmez. Ekran kilitliyken de sürer; seçilen sürenin sonunda son 30 saniyede kısılarak kapanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds are generated on your phone, nothing is downloaded. They keep playing with the screen locked and fade out over the last 30 seconds of the chosen time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geräusche werden auf dem Telefon erzeugt, nichts wird heruntergeladen. Sie laufen auch bei gesperrtem Bildschirm weiter und werden in den letzten 30 Sekunden ausgeblendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səslər telefonda yaradılır, fayl endirilmir. Ekran kilidli olanda da davam edir və seçilən müddətin son 30 saniyəsində səsi azalaraq bağlanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُولَّد الأصوات على هاتفك ولا يُنزَّل أي ملف. تستمر والشاشة مقفلة وتخفت تدريجيًا في آخر 30 ثانية من المدة المختارة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara dibuat di ponsel Anda, tidak ada yang diunduh. Tetap diputar saat layar terkunci dan memudar di 30 detik terakhir waktu yang dipilih."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آوازیں آپ کے فون پر بنتی ہیں، کچھ ڈاؤن لوڈ نہیں ہوتا۔ لاک اسکرین پر بھی چلتی رہتی ہیں اور منتخب وقت کے آخری 30 سیکنڈ میں مدھم ہو جاتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صداها روی گوشی شما ساخته می‌شوند و چیزی دانلود نمی‌شود. با صفحهٔ قفل هم پخش می‌شوند و در 30 ثانیهٔ آخر زمان انتخابی آرام محو می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sons sont générés sur votre téléphone, rien n’est téléchargé. Ils continuent écran verrouillé et s’estompent pendant les 30 dernières secondes de la durée choisie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звуки создаются на телефоне, ничего не загружается. Они звучат и на заблокированном экране и затихают в последние 30 секунд выбранного времени."
          }
        }
      }
    },
