    },
    "datecalc.description": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki tarih arası kaç gün, kaç iş günü? Tarihe gün, ay, yıl ekleyin ya da çıkarın; yaşınızı hesaplayın. Türkiye resmi tatilleri dikkate alınır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many days and working days between two dates? Add or subtract days, months or years from a date and calculate age. Turkish public holidays are taken into account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Tage und Arbeitstage liegen zwischen zwei Daten? Tage, Monate oder Jahre addieren und abziehen, Alter berechnen – mit türkischen Feiertagen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İki tarix arasında neçə gün və iş günü var? Tarixə gün, ay və ya il əlavə edin, çıxın, yaşı hesablayın. Türkiyənin rəsmi bayramları nəzərə alınır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم يومًا ويوم عمل بين تاريخين؟ أضف أيامًا أو شهورًا أو سنوات إلى تاريخ أو اطرحها منه، واحسب العمر، مع مراعاة العطل الرسمية في تركيا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa hari dan hari kerja antara dua tanggal? Tambah atau kurangi hari, bulan, atau tahun dari suatu tanggal dan hitung usia. Hari libur resmi Turki diperhitungkan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دو تاریخوں کے درمیان کتنے دن اور کام کے دن ہیں؟ کسی تاریخ میں دن، مہینے یا سال جمع یا تفریق کریں اور عمر نکالیں۔ ترکی کی سرکاری تعطیلات کا خیال رکھا جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میان دو تاریخ چند روز و چند روز کاری است؟ روز، ماه یا سال را به تاریخی بیفزایید یا از آن کم کنید و سن را حساب کنید. تعطیلات رسمی ترکیه در نظر گرفته می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours et jours ouvrés entre deux dates, ajout ou retrait de jours, mois ou années, et calcul d’âge. Les jours fériés turcs sont pris en compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько дней и рабочих дней между двумя датами? Прибавьте или вычтите дни, месяцы или годы и рассчитайте возраст. Учитываются государственные праздники Турции."
          }
        }
      }
    },
    "datecalc.h1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarih hesaplama"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
