    "account.downloadNote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız, profiliniz (fotoğraf dahil), onay kaydınız, oturumlarınız, kayıtlarınız ve rozetleriniz JSON dosyası olarak."
          }
        },
        "en": {
