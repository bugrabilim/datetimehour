          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行をタップして会議の時刻を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행을 눌러 회의 시간을 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一行选择会议时间。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang hilera para piliin ang oras ng pulong."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะแถวเพื่อเลือกเวลาประชุม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque una fila para elegir la hora de la reunión."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque numa linha para escolher o horário da reunião."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीटिंग का समय चुनने के लिए किसी पंक्ति पर टैप करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
