    "google.step2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar › Takvim › Takvim Hesapları'na girin (eski iOS'ta Takvim › Hesaplar)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Apps › Calendar › Calendar Accounts (on older iOS: Calendar › Accounts)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie zu Apps › Kalender › Kalenderaccounts (bei älterem iOS: Kalender › Accounts)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqlər › Təqvim › Təqvim hesabları bölməsinə keçin (köhnə iOS-da Təqvim › Hesablar)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى التطبيقات › التقويم › حسابات التقويم (في إصدارات iOS الأقدم: التقويم › الحسابات)."
          }
        }
      }
    },
    "google.step3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap Ekle › Google'ı seçin ve Google hesabınızla giriş yapın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Add Account › Google and sign in with your Google account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Account hinzufügen › Google und melden Sie sich mit Ihrem Google-Konto an."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesab əlavə et › Google seçin və Google hesabınızla daxil olun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر إضافة حساب › Google وسجّل الدخول بحساب Google."
          }
        }
      }
    },
    "google.step4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimler anahtarının açık olduğundan emin olun ve kaydedin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the Calendars switch is on, then save."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achten Sie darauf, dass der Schalter Kalender aktiviert ist, und sichern Sie."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təqvimlər açarının açıq olduğuna əmin olun və yadda saxlayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من تفعيل مفتاح التقويمات ثم احفظ."
          }
        }
      }
    },
    "google.step5": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya dönüp “Telefonumdaki takvimleri göster” düğmesine dokunun ve izin verin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back here, tap “Show calendars on my phone” and allow access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehren Sie hierher zurück, tippen Sie auf „Kalender auf meinem Telefon anzeigen“ und erlauben Sie den Zugriff."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bura qayıdın, “Telefonumdakı təqvimləri göstər” düyməsinə toxunun və icazə verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عد إلى هنا واضغط «اعرض التقويمات على هاتفي» ثم اسمح بالوصول."
          }
        }
      }
    },
    "google.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
