    "notify.cat.prayer.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz vakitlerde ya da birkaç dakika önce."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the times you choose, or a few minutes before."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu den gewählten Zeiten oder einige Minuten vorher."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçdiyiniz vaxtlarda və ya bir neçə dəqiqə əvvəl."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الأوقات التي تختارها أو قبلها ببضع دقائق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada waktu yang Anda pilih, atau beberapa menit sebelumnya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے منتخب اوقات پر، یا چند منٹ پہلے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در وقت‌هایی که برمی‌گزینید یا چند دقیقه پیش از آن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aux heures choisies, ou quelques minutes avant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выбранное время или за несколько минут до него."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ時刻ちょうど、または数分前に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 시간에, 또는 몇 분 전에."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您选择的时间，或提前几分钟。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa mga oras na pinili mo, o ilang minuto bago."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรงเวลาที่คุณเลือก หรือก่อนไม่กี่นาที"
          }
        }
      }
    },
