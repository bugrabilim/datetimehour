    "health.noteIos": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biten aralık antrenmanı ve rutin, Sağlık uygulamasına antrenman olarak yazılır (tür, başlangıç ve süre). Uygulama Sağlık verilerinizi okumaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each finished interval workout or routine is written to the Health app as a workout (type, start and duration). The app does not read your health data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes beendete Intervalltraining oder jede Routine wird als Training in Health eingetragen (Art, Beginn und Dauer). Die App liest Ihre Gesundheitsdaten nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitən aralıq məşqi və rutin Sağlamlıq tətbiqinə məşq kimi yazılır (növ, başlanğıc və müddət). Tətbiq sağlamlıq məlumatlarınızı oxumur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسجَّل كل تمرين متقطع أو روتين منتهٍ في تطبيق الصحة كتمرين (النوع والبداية والمدة). لا يقرأ التطبيق بياناتك الصحية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap latihan interval atau rutinitas yang selesai ditulis ke app Kesehatan sebagai latihan (jenis, mulai, dan durasi). Aplikasi tidak membaca data kesehatan Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر مکمل وقفہ وار ورزش یا روٹین ہیلتھ ایپ میں ورزش کے طور پر (قسم، آغاز اور دورانیہ) لکھی جاتی ہے۔ ایپ آپ کا صحت کا ڈیٹا نہیں پڑھتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر تمرین تناوبی یا برنامهٔ تمام‌شده به شکل تمرین (نوع، آغاز و مدت) در برنامهٔ سلامت نوشته می‌شود. برنامه دادهٔ سلامت شما را نمی‌خواند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque entraînement fractionné ou routine terminé est écrit dans l’app Santé comme entraînement (type, début et durée). L’app ne lit pas vos données de santé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая завершённая интервальная тренировка или программа записывается в приложение «Здоровье» как тренировка (тип, начало и длительность). Приложение не читает данные о здоровье."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終えたインターバルトレーニングやルーティンを、ワークアウト（種類、開始、時間）としてヘルスケアアプリに書き込みます。アプリがあなたの健康データを読むことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마친 인터벌 운동이나 루틴을 운동(종류, 시작, 시간)으로 건강 앱에 기록합니다. 앱은 건강 데이터를 읽지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次完成的间歇训练或训练计划会作为体能训练（类型、开始时间和时长）写入“健康”应用。应用不会读取您的健康数据。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isinusulat sa Health app ang bawat natapos na interval workout o routine bilang workout (uri, simula at tagal). Hindi binabasa ng app ang iyong datos pangkalusugan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การออกกำลังกายแบบอินเทอร์วัลหรือชุดที่ทำเสร็จจะบันทึกลงแอปสุขภาพเป็นการออกกำลังกาย (ประเภท เวลาเริ่ม ระยะเวลา) แอปไม่อ่านข้อมูลสุขภาพของคุณ"
          }
        }
      }
    },
    "health.noteAndroid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biten aralık antrenmanı ve rutin, Health Connect'e egzersiz oturumu olarak yazılır (tür, başlangıç ve süre). Uygulama sağlık verilerinizi okumaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each finished interval workout or routine is written to Health Connect as an exercise session (type, start and duration). The app does not read your health data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes beendete Intervalltraining oder jede Routine wird als Trainingseinheit in Health Connect eingetragen (Art, Beginn und Dauer). Die App liest Ihre Gesundheitsdaten nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitən aralıq məşqi və rutin Health Connect-ə məşq sessiyası kimi yazılır (növ, başlanğıc və müddət). Tətbiq sağlamlıq məlumatlarınızı oxumur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسجَّل كل تمرين متقطع أو روتين منتهٍ في Health Connect كجلسة تمرين (النوع والبداية والمدة). لا يقرأ التطبيق بياناتك الصحية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap latihan interval atau rutinitas yang selesai ditulis ke Health Connect sebagai sesi olahraga (jenis, mulai, dan durasi). Aplikasi tidak membaca data kesehatan Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر مکمل وقفہ وار ورزش یا روٹین Health Connect میں ورزش کے سیشن کے طور پر (قسم، آغاز اور دورانیہ) لکھی جاتی ہے۔ ایپ آپ کا صحت کا ڈیٹا نہیں پڑھتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر تمرین تناوبی یا برنامهٔ تمام‌شده به شکل جلسهٔ ورزش (نوع، آغاز و مدت) در Health Connect نوشته می‌شود. برنامه دادهٔ سلامت شما را نمی‌خواند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque entraînement fractionné ou routine terminé est écrit dans Santé Connect comme séance d’exercice (type, début et durée). L’app ne lit pas vos données de santé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая завершённая интервальная тренировка или программа записывается в Health Connect как сеанс упражнений (тип, начало и длительность). Приложение не читает данные о здоровье."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終えたインターバルトレーニングやルーティンを、エクササイズ（種類、開始、時間）としてヘルスコネクトに書き込みます。アプリがあなたの健康データを読むことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마친 인터벌 운동이나 루틴을 운동 세션(종류, 시작, 시간)으로 헬스 커넥트에 기록합니다. 앱은 건강 데이터를 읽지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次完成的间歇训练或训练计划会作为锻炼记录（类型、开始时间和时长）写入Health Connect。应用不会读取您的健康数据。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isinusulat sa Health Connect ang bawat natapos na interval workout o routine bilang exercise session (uri, simula at tagal). Hindi binabasa ng app ang iyong datos pangkalusugan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การออกกำลังกายแบบอินเทอร์วัลหรือชุดที่ทำเสร็จจะบันทึกลง Health Connect เป็นเซสชันออกกำลังกาย (ประเภท เวลาเริ่ม ระยะเวลา) แอปไม่อ่านข้อมูลสุขภาพของคุณ"
          }
        }
      }
    },
