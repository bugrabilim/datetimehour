    "intent.timer.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilen dakika için adlı bir zamanlayıcı başlatır; bitince alarm çalar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a named timer for the given minutes; an alarm rings when it ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet einen benannten Timer für die angegebenen Minuten; am Ende klingelt ein Alarm."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilən dəqiqə üçün adlı taymer başladır; bitəndə zəng çalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ مؤقتًا باسم تختاره للمدة المحددة بالدقائق؛ ويرن المنبه عند انتهائه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulai pengatur waktu bernama untuk jumlah menit yang ditentukan; alarm berbunyi saat selesai."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیے گئے منٹوں کے لیے نام والا ٹائمر شروع کرتا ہے؛ ختم ہونے پر الارم بجتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تایمری نام‌دار به مدت دقیقه‌های تعیین‌شده شروع می‌کند؛ در پایان، هشدار زنگ می‌زند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance un minuteur nommé pour le nombre de minutes indiqué ; une alarme sonne à la fin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает именованный таймер на указанное число минут; по окончании звонит сигнал."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定した分数の名前付きタイマーを開始し、終わるとアラームが鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지정한 분만큼 이름 있는 타이머를 시작하고, 끝나면 알람이 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按指定分钟数启动一个带名称的计时器，结束时闹钟会响。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagsisimula ng timer na may pangalan para sa ibinigay na minuto; tumutunog ang alarma pagkatapos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มตัวจับเวลาที่มีชื่อตามจำนวนนาทีที่กำหนด และนาฬิกาปลุกจะดังเมื่อหมดเวลา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia un temporizador con nombre y la duración en minutos indicada; al terminar suena una alarma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia um temporizador com nome pelos minutos indicados; um alarme toca no fim."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिए गए मिनटों के लिए नाम वाला टाइमर शुरू करता है; ख़त्म होने पर अलार्म बजता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেওয়া মিনিটের জন্য একটি নামযুক্ত টাইমার চালু করে; শেষ হলে অ্যালার্ম বাজে।"
          }
        }
      }
    },
