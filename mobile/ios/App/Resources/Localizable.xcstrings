    "list.lead": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Tarih'teki yenilikleri e-postayla almak ister misiniz? İstediğiniz zaman tek tıkla ayrılabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want updates about Saat Tarih by email? You can unsubscribe at any time with one click."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie Neuigkeiten zu Saat Tarih per E-Mail erhalten? Sie können sich jederzeit mit einem Klick wieder abmelden."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Tarih yenilikləri barədə e-poçtla məlumat almaq istəyirsiniz? İstənilən vaxt bir kliklə abunəlikdən çıxa bilərsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد تلقي أخبار Saat Tarih عبر البريد الإلكتروني؟ يمكنك إلغاء الاشتراك في أي وقت بنقرة واحدة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingin menerima kabar tentang Saat Tarih lewat email? Anda dapat berhenti berlangganan kapan saja dengan satu klik."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Tarih کی تازہ خبریں ای میل پر چاہتے ہیں؟ آپ کسی بھی وقت ایک کلک سے رکنیت ختم کر سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌خواهید خبرهای Saat Tarih را با ایمیل دریافت کنید؟ هر زمان بخواهید با یک کلیک می‌توانید لغو اشتراک کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous souhaitez recevoir les nouveautés de Saat Tarih par e-mail ? Vous pouvez vous désinscrire à tout moment en un clic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите получать новости Saat Tarih по электронной почте? Отписаться можно в любой момент одним нажатием."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Tarih の最新情報をメールで受け取りませんか？ワンクリックでいつでも登録を解除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Tarih 소식을 이메일로 받아 보시겠어요? 언제든 클릭 한 번으로 구독을 취소할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想通过电子邮件接收 Saat Tarih 的最新消息吗？您可以随时一键退订。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusto mo bang makatanggap ng balita tungkol sa Saat Tarih sa email? Puwede kang mag-unsubscribe anumang oras sa isang click."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยากรับข่าวสารเกี่ยวกับ Saat Tarih ทางอีเมลไหม? ยกเลิกการรับได้ทุกเมื่อด้วยการคลิกครั้งเดียว"
          }
        }
      }
    },
