          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اندھیرے میں چاند آسمان پر نہیں: مدھم ستاروں کے لیے اچھا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ماه در تاریکی در آسمان نیست: برای ستاره‌های کم‌نور خوب است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lune est couchée pendant la nuit noire : idéal pour les étoiles faibles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В темноте Луны нет на небе: хорошо для слабых звёзд."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗い時間帯に月がなく、暗い星の観測に向いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두운 시간에 달이 없어 어두운 별을 보기에 좋습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑暗时段月亮不在天空：适合观测暗星。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala ang Buwan sa langit sa dilim: maganda para sa malalabong bituin."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงมืดไม่มีดวงจันทร์บนฟ้า เหมาะกับดาวจาง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Luna está bajo el horizonte durante la oscuridad: bueno para las estrellas débiles."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Lua fica abaixo do horizonte nas horas escuras: bom para estrelas fracas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अँधेरे के दौरान चंद्रमा नीचे है: धुँधले तारों के लिए अच्छा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্ধকারের সময় চাঁদ অস্তে: ক্ষীণ তারার জন্য ভালো।"
          }
        }
      }
    },
    "sky.tipCloudy": {
