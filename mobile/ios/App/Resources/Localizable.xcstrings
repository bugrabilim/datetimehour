    "wake.light": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işığı açın ya da telefonu aydınlık bir yere tutun"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the light or hold the phone up to a bright spot"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht einschalten oder das Telefon an eine helle Stelle halten"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İşığı yandırın və ya telefonu işıqlı yerə tutun"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل الضوء أو وجّه الهاتف إلى مكان مضيء"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan lampu atau arahkan ponsel ke tempat terang"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روشنی جلائیں یا فون کو روشن جگہ کی طرف کریں"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چراغ را روشن کنید یا گوشی را رو به جای روشن بگیرید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allumez la lumière ou tenez le téléphone vers un endroit lumineux"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите свет или поднесите телефон к яркому месту"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明かりをつけるか、スマートフォンを明るい場所に向けてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불을 켜거나 휴대폰을 밝은 곳에 대세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开灯或把手机对准明亮处"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang ilaw o itapat ang telepono sa maliwanag na lugar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไฟหรือหันโทรศัพท์ไปทางที่สว่าง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encienda la luz o acerque el teléfono a un sitio luminoso"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acenda a luz ou aproxime o celular de um lugar claro"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बत्ती जलाएँ या फ़ोन को किसी रोशन जगह की ओर करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আলো জ্বালান বা ফোনটি উজ্জ্বল কোনো জায়গার দিকে ধরুন"
          }
        }
      }
    },
