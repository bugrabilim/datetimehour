    "panchang.defs.0": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün doğumundan gün batımına kadarki gündüz sekiz eşit parçaya bölünür. Rahu Kaal, Yamaganda ve Gulika haftanın gününe göre bu parçalardan biridir; örneğin Rahu Kaal pazartesi ikinci, pazar sekizinci parçadır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The daytime from sunrise to sunset is divided into eight equal parts. Rahu Kaal, Yamaganda and Gulika are each one of these parts, depending on the weekday; for example, Rahu Kaal is the second part on Monday and the eighth on Sunday."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tag von Sonnenaufgang bis Sonnenuntergang wird in acht gleiche Teile geteilt. Rahu Kaal, Yamaganda und Gulika sind je nach Wochentag einer dieser Teile; Rahu Kaal ist zum Beispiel am Montag der zweite und am Sonntag der achte Teil."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün çıxmasından gün batmasına qədər olan gündüz səkkiz bərabər hissəyə bölünür. Rahu Kaal, Yamaqanda və Qulika həftənin gününə görə bu hissələrdən biridir; məsələn, Rahu Kaal bazar ertəsi ikinci, bazar günü səkkizinci hissədir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقسَم النهار من الشروق إلى الغروب ثمانية أجزاء متساوية. راهو كال وياماغاندا وغوليكا كلٌّ منها جزء من هذه الأجزاء بحسب يوم الأسبوع؛ فمثلًا راهو كال هو الجزء الثاني يوم الاثنين والثامن يوم الأحد."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siang hari dari matahari terbit hingga terbenam dibagi menjadi delapan bagian sama panjang. Rahu Kaal, Yamaganda, dan Gulika masing-masing adalah salah satu bagian itu menurut hari dalam pekan; misalnya Rahu Kaal adalah bagian kedua pada hari Senin dan kedelapan pada hari Minggu."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "طلوع سے غروبِ آفتاب تک کے دن کو آٹھ برابر حصوں میں بانٹا جاتا ہے۔ راہو کال، یم گنڈ اور گلیک ہفتے کے دن کے لحاظ سے ان میں سے ایک ایک حصہ ہیں؛ مثلاً راہو کال پیر کو دوسرا اور اتوار کو آٹھواں حصہ ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روز از طلوع تا غروب خورشید به هشت بخش برابر تقسیم می‌شود. راهو کال، یاماگاندا و گولیکا بسته به روز هفته هر کدام یکی از این بخش‌ها هستند؛ مثلاً راهو کال در دوشنبه بخش دوم و در یکشنبه بخش هشتم است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La journée, du lever au coucher du soleil, est divisée en huit parts égales. Le Rahu Kaal, le Yamaganda et le Gulika correspondent chacun à l'une de ces parts selon le jour de la semaine ; par exemple, le Rahu Kaal est la deuxième part le lundi et la huitième le dimanche."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светлое время от восхода до захода Солнца делится на восемь равных частей. Раху-кала, Ямаганда и Гулика — каждая одна из этих частей в зависимости от дня недели; например, Раху-кала — вторая часть в понедельник и восьмая в воскресенье."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日の出から日の入りまでの昼間を8等分します。ラーフ・カーラ、ヤマガンダ、グリカは曜日によってそのうちの1つになります。たとえばラーフ・カーラは月曜日は2番目、日曜日は8番目です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일출부터 일몰까지의 낮을 여덟 등분합니다. 라후 칼라, 야마간다, 굴리카는 요일에 따라 그중 하나입니다. 예를 들어 라후 칼라는 월요일에는 두 번째, 일요일에는 여덟 번째 부분입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从日出到日落的白天平分为八段。罗睺时段、阎魔时段和古利卡时段按星期几各为其中一段；例如罗睺时段在星期一为第二段，在星期日为第八段。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinahati sa walong pantay na bahagi ang araw mula pagsikat hanggang paglubog. Ang Rahu Kaal, Yamaganda at Gulika ay isa sa mga bahaging ito depende sa araw ng linggo; halimbawa, ang Rahu Kaal ay ikalawang bahagi tuwing Lunes at ikawalo tuwing Linggo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงกลางวันตั้งแต่พระอาทิตย์ขึ้นถึงตกแบ่งเป็นแปดส่วนเท่ากัน ราหูกาล ยมคัณฑะ และคุลิกะ แต่ละช่วงคือส่วนหนึ่งตามวันในสัปดาห์ เช่น ราหูกาลเป็นส่วนที่สองในวันจันทร์และส่วนที่แปดในวันอาทิตย์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día, de la salida a la puesta del sol, se divide en ocho partes iguales. Rahu Kaal, Yamaganda y Gulika son cada uno una de esas partes según el día de la semana; por ejemplo, Rahu Kaal es la segunda parte el lunes y la octava el domingo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia, do nascer ao pôr do sol, é dividido em oito partes iguais. Rahu Kaal, Yamaganda e Gulika são cada um uma dessas partes conforme o dia da semana; por exemplo, o Rahu Kaal é a segunda parte na segunda-feira e a oitava no domingo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूर्योदय से सूर्यास्त तक के दिन को आठ बराबर भागों में बाँटा जाता है। राहु काल, यमगण्ड और गुलिक काल सप्ताह के दिन के अनुसार इनमें से एक-एक भाग हैं; जैसे राहु काल सोमवार को दूसरा और रविवार को आठवाँ भाग होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সূর্যোদয় থেকে সূর্যাস্ত পর্যন্ত দিনকে আটটি সমান ভাগে ভাগ করা হয়। রাহুকাল, যমগণ্ড ও গুলিক কাল সপ্তাহের দিন অনুযায়ী এর একেকটি ভাগ; যেমন রাহুকাল সোমবার দ্বিতীয় আর রবিবার অষ্টম ভাগ।"
          }
        }
      }
    },
    "panchang.defs.1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhijit muhurta, gündüzün on beş eşit parçasından sekizincisidir ve öğleye denk gelir. Brahma muhurta, gün doğumundan önceki gecenin on beş parçasından doğuştan önceki ikincisidir (yaklaşık 96 ile 48 dakika önce)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhijit muhurta is the eighth of fifteen equal parts of the daytime and falls around midday. Brahma muhurta is the second of the fifteen parts of the night counting back from sunrise (roughly 96 to 48 minutes before sunrise)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhijit Muhurta ist der achte von fünfzehn gleichen Teilen des Tages und liegt um die Mittagszeit. Brahma Muhurta ist der zweite der fünfzehn Teile der Nacht, vom Sonnenaufgang aus zurückgezählt (etwa 96 bis 48 Minuten vor Sonnenaufgang)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhicit muhurta gündüzün on beş bərabər hissəsindən səkkizincisidir və günortaya düşür. Brahma muhurta gün çıxmasından əvvəlki gecənin on beş hissəsindən doğuşdan əvvəlki ikincisidir (təxminən 96 ilə 48 dəqiqə əvvəl)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبهيجيت موهورتا هو الجزء الثامن من خمسة عشر جزءًا متساويًا من النهار ويقع قرب الظهر. وبراهما موهورتا هو الجزء الثاني من أجزاء الليل الخمسة عشر عدًّا إلى الوراء من الشروق (نحو 96 إلى 48 دقيقة قبل الشروق)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhijit muhurta adalah bagian kedelapan dari lima belas bagian sama panjang siang hari dan jatuh sekitar tengah hari. Brahma muhurta adalah bagian kedua dari lima belas bagian malam, dihitung mundur dari matahari terbit (sekitar 96 hingga 48 menit sebelum terbit)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھیجت مہورت دن کے پندرہ برابر حصوں میں آٹھواں ہے اور دوپہر کے قریب آتا ہے۔ برہم مہورت رات کے پندرہ حصوں میں، طلوع سے پیچھے گنتے ہوئے، دوسرا حصہ ہے (طلوع سے تقریباً 96 سے 48 منٹ پہلے)۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابهیجیت موهورتا بخش هشتم از پانزده بخش برابر روز است و نزدیک ظهر می‌افتد. برهما موهورتا بخش دوم از پانزده بخش شب است که از طلوع به عقب شمرده می‌شود (حدود 96 تا 48 دقیقه پیش از طلوع)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Abhijit muhurta est la huitième des quinze parts égales de la journée et tombe vers midi. Le Brahma muhurta est la deuxième des quinze parts de la nuit, en comptant à rebours depuis le lever du soleil (environ 96 à 48 minutes avant le lever)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Абхиджит-мухурта — восьмая из пятнадцати равных частей дня, она приходится на полдень. Брахма-мухурта — вторая из пятнадцати частей ночи, если считать назад от восхода (примерно за 96–48 минут до восхода)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アビジット・ムフールタは昼間を15等分した8番目で、正午ごろに当たります。ブラフマ・ムフールタは夜を15等分し、日の出からさかのぼって2番目の区分です（日の出のおよそ96〜48分前）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아비지트 무후르타는 낮을 열다섯 등분한 것 중 여덟 번째로, 정오 무렵입니다. 브라마 무후르타는 밤을 열다섯 등분해 일출에서 거꾸로 센 두 번째 부분입니다(일출 약 96~48분 전)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阿毗吉特吉时是白天十五等分中的第八段，在正午前后。梵天吉时是夜晚十五等分中从日出往前数的第二段（约在日出前96至48分钟）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Abhijit muhurta ay ikawalo sa labinlimang pantay na bahagi ng araw at tumatapat sa bandang tanghali. Ang Brahma muhurta ay ikalawa sa labinlimang bahagi ng gabi kung bibilang pabalik mula sa pagsikat (mga 96 hanggang 48 minuto bago sumikat ang araw)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อภิชิตมุหูรตะคือส่วนที่แปดจากสิบห้าส่วนเท่ากันของกลางวัน ตรงกับช่วงเที่ยง พรหมมุหูรตะคือส่วนที่สองจากสิบห้าส่วนของกลางคืนเมื่อนับย้อนจากพระอาทิตย์ขึ้น (ประมาณ 96 ถึง 48 นาทีก่อนพระอาทิตย์ขึ้น)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhijit muhurta es la octava de quince partes iguales del día y cae hacia el mediodía. Brahma muhurta es la segunda de las quince partes de la noche contando hacia atrás desde la salida del sol (unos 96 a 48 minutos antes)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Abhijit muhurta é a oitava de quinze partes iguais do dia e cai por volta do meio-dia. O Brahma muhurta é a segunda das quinze partes da noite contando para trás a partir do nascer do sol (cerca de 96 a 48 minutos antes)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभिजित मुहूर्त दिन के पंद्रह बराबर भागों में आठवाँ है और दोपहर के आसपास आता है। ब्रह्म मुहूर्त रात के पंद्रह भागों में, सूर्योदय से पीछे गिनने पर दूसरा भाग है (सूर्योदय से लगभग 96 से 48 मिनट पहले)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অভিজিৎ মুহূর্ত দিনের পনেরোটি সমান ভাগের অষ্টম এবং দুপুরের কাছাকাছি পড়ে। ব্রহ্ম মুহূর্ত রাতের পনেরো ভাগের মধ্যে সূর্যোদয় থেকে পেছন দিকে গুনলে দ্বিতীয় ভাগ (সূর্যোদয়ের প্রায় 96 থেকে 48 মিনিট আগে)।"
          }
        }
      }
    },
    "panchang.defs.2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün doğumu ve batımı, Güneş'in üst kenarının ufukta göründüğü andır (kırılma dahil); namaz vakitlerindeki tanımla aynıdır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise and sunset are the moments the upper edge of the Sun appears at the horizon (refraction included), the same definition as for prayer times."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonnenauf- und -untergang sind die Momente, in denen der obere Sonnenrand am Horizont erscheint (mit Refraktion), wie bei den Gebetszeiten."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün çıxması və batması Günəşin üst kənarının üfüqdə göründüyü andır (refraksiya daxil); namaz vaxtlarındakı təriflə eynidir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشروق والغروب هما لحظة ظهور الحافة العليا للشمس عند الأفق (مع الانكسار)، وهو التعريف نفسه المستخدم في أوقات الصلاة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matahari terbit dan terbenam adalah saat tepi atas Matahari tampak di cakrawala (termasuk refraksi), sama dengan definisi untuk waktu salat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "طلوع اور غروب وہ لمحے ہیں جب سورج کا اوپری کنارہ افق پر نظر آتا ہے (انعطاف سمیت)؛ نماز کے اوقات والی تعریف ہی ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "طلوع و غروب لحظه‌ای است که لبهٔ بالایی خورشید در افق دیده می‌شود (با شکست نور)؛ همان تعریفی که در اوقات نماز به کار می‌رود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lever et le coucher du soleil sont les instants où le bord supérieur du Soleil apparaît à l'horizon (réfraction comprise), comme pour les horaires de prière."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восход и заход — моменты, когда верхний край Солнца появляется на горизонте (с учётом рефракции); то же определение, что и для времени намаза."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日の出と日の入りは、太陽の上端が地平線に見える瞬間（大気差を含む）で、礼拝時刻と同じ定義です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일출과 일몰은 태양의 위쪽 가장자리가 지평선에 보이는 순간(대기 굴절 포함)이며, 기도 시간과 같은 정의입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日出和日落是太阳上缘出现在地平线的时刻（含大气折射），与礼拜时间的定义相同。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pagsikat at paglubog ay ang sandaling lumitaw sa abot-tanaw ang itaas na gilid ng Araw (kasama ang repraksiyon), katulad ng depinisyon sa oras ng pagdarasal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พระอาทิตย์ขึ้นและตกคือขณะที่ขอบบนของดวงอาทิตย์ปรากฏที่ขอบฟ้า (รวมการหักเหของแสง) ใช้นิยามเดียวกับเวลาละหมาด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida y la puesta del sol son los momentos en que el borde superior del Sol aparece en el horizonte (con refracción), la misma definición que para los horarios de oración."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O nascer e o pôr do sol são os momentos em que a borda superior do Sol aparece no horizonte (com refração), a mesma definição usada nos horários de oração."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूर्योदय और सूर्यास्त वे क्षण हैं जब सूर्य का ऊपरी किनारा क्षितिज पर दिखता है (अपवर्तन सहित); यही परिभाषा नमाज़ के समय में भी है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সূর্যোদয় ও সূর্যাস্ত হলো সেই মুহূর্ত যখন সূর্যের ওপরের প্রান্ত দিগন্তে দেখা যায় (প্রতিসরণসহ); নামাজের সময়ের সংজ্ঞাও একই।"
          }
        }
      }
    },
