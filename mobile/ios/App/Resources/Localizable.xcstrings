    "weather.error": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava durumu alınamadı. Bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "en": {
          "stringUnit": {
