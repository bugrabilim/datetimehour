    "perms.usage.why": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız odak engelinde, seçtiğiniz uygulama açılınca uyarmak için. Bu bilgi telefondan çıkmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for focus blocking, to warn you when a chosen app opens. This never leaves your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für die Fokussperre, um Sie zu warnen, wenn eine gewählte App geöffnet wird. Das verlässt Ihr Telefon nie."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız fokusda bloklamada, seçdiyiniz tətbiq açılanda xəbərdar etmək üçün. Bu məlumat telefondan çıxmır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للحظر أثناء التركيز فقط، لتنبيهك عند فتح تطبيق اخترته. لا تغادر هذه المعلومة هاتفك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk blokir saat fokus, yaitu memberi peringatan ketika aplikasi pilihan Anda dibuka. Informasi ini tidak keluar dari ponsel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف فوکس بلاک کے لیے، چنی ہوئی ایپ کھلنے پر خبردار کرنے کو۔ یہ معلومات فون سے باہر نہیں جاتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط برای مسدودسازی تمرکز، تا هنگام باز شدن برنامه‌ی انتخابی هشدار دهد. این اطلاعات از گوشی بیرون نمی‌رود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour le blocage de concentration, afin de vous prévenir quand une appli choisie s'ouvre. Cela ne quitte jamais votre téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для блокировки во время фокуса — предупредить, когда открыто выбранное приложение. Эти данные не покидают телефон."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中ブロック専用で、選んだアプリが開いたときに知らせます。この情報は端末の外に出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 차단에만 써요. 고른 앱이 열리면 알려 줘요. 이 정보는 휴대폰 밖으로 나가지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于专注拦截，在选中的应用打开时提醒您。此信息不会离开手机。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lang sa focus block, para magbabala kapag nabuksan ang napiling app. Hindi ito lumalabas sa telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เฉพาะการบล็อกขณะโฟกัส เพื่อเตือนเมื่อแอปที่เลือกถูกเปิด ข้อมูลนี้ไม่ออกจากโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para el bloqueo durante la concentración, para avisarle cuando se abre una app elegida. Esta información nunca sale del teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para o bloqueio de foco, para avisar quando um app escolhido abrir. Isso nunca sai do celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ फ़ोकस ब्लॉक के लिए, चुना हुआ ऐप खुलने पर चेताने को। यह जानकारी फ़ोन से बाहर नहीं जाती।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু মনোযোগের সময় ব্লকের জন্য, বাছা কোনো অ্যাপ খুললে সতর্ক করতে। এটি কখনো আপনার ফোন ছেড়ে যায় না।"
          }
        }
      }
    },
    "perms.dnd.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahatsız Etmeyin erişimi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do Not Disturb access"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf „Bitte nicht stören“"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Narahat etməyin girişi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
