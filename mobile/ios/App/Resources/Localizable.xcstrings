    "alarm.code.hint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yataktan kalkınca ulaşabileceğiniz bir kod seçin: banyodaki bir ürünün barkodu ya da kapıya astığınız bir QR kod gibi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a code you can only reach once you're up: a barcode on something in the bathroom, or a QR code stuck on a door."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Code, den Sie erst nach dem Aufstehen erreichen: etwa einen Barcode im Bad oder einen QR-Code an einer Tür."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yataqdan qalxanda çata biləcəyiniz kod seçin: hamamdakı bir məhsulun barkodu ya da qapıya yapışdırdığınız QR kod kimi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر رمزًا لا تصل إليه إلا بعد النهوض: كباركود منتج في الحمّام أو رمز QR ملصق على باب."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kode yang hanya bisa dijangkau setelah Anda bangun: barcode pada barang di kamar mandi, atau kode QR yang ditempel di pintu."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایسا کوڈ چنیں جس تک صرف اٹھ کر پہنچ سکیں: غسل خانے میں کسی چیز کا بارکوڈ، یا دروازے پر چپکا QR کوڈ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کدی برگزینید که فقط پس از بیدار شدن به آن برسید: بارکد چیزی در حمام یا کد QR چسبیده روی در."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un code que vous ne pouvez atteindre qu’une fois levé : un code-barres sur un objet de la salle de bains ou un QR code collé sur une porte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите код, до которого можно дойти, только встав: штрихкод на чём-то в ванной или QR-код на двери."
          }
        }
      }
    },
