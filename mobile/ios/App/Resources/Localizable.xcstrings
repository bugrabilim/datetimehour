    "zikir.undoHint": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayaca uzun basınca ya da telefonu sallayınca bir geri alır. Sağa-sola kaydırarak zikirler arasında geçin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press the counter or shake the phone to undo one. Swipe left or right to switch dhikrs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zähler lange drücken oder Telefon schütteln, um einen zurückzunehmen. Wischen wechselt den Dhikr."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayğaca uzun basanda ya da telefonu silkələyəndə birini geri alır. Sağa-sola sürüşdürərək zikrlər arasında keçin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على العدّاد أو هزّ الهاتف للتراجع واحدًا. اسحب يمينًا أو يسارًا للتنقل بين الأذكار."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama penghitung atau goyangkan ponsel untuk mengurangi satu. Geser kiri atau kanan untuk ganti zikir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کاؤنٹر کو دیر تک دبانے یا فون ہلانے سے ایک واپس ہوتا ہے۔ اذکار بدلنے کے لیے دائیں بائیں سوائپ کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با نگه‌داشتن شمارنده یا تکان دادن گوشی یکی برمی‌گردد. برای جابه‌جایی ذکرها به چپ و راست بکشید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appui long sur le compteur ou secouez le téléphone pour annuler un. Balayez pour changer de dhikr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долгое нажатие на счётчик или встряхивание отменяет один. Свайп влево-вправо меняет зикр."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウンターの長押しか端末を振ると1つ戻ります。左右にスワイプでズィクルを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운터를 길게 누르거나 휴대전화를 흔들면 하나 되돌립니다. 좌우로 밀어 디크르를 바꿉니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按计数器或摇动手机可撤销一次。左右滑动切换赞念。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindutin nang matagal ang counter o iyugyog ang telepono para bawiin ang isa. Mag-swipe pakaliwa o pakanan para lumipat ng dhikr."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดตัวนับค้างหรือเขย่าโทรศัพท์เพื่อย้อนหนึ่งครั้ง ปัดซ้ายขวาเพื่อเปลี่ยนซิกิร"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga pulsado el contador o agite el teléfono para deshacer uno. Deslice a izquierda o derecha para cambiar de dhikr."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure o contador ou chacoalhe o celular para desfazer um. Deslize para a esquerda ou direita para trocar de dhikr."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक वापस लेने के लिए काउंटर दबाकर रखें या फ़ोन हिलाएँ। ज़िक्र बदलने के लिए बाएँ या दाएँ स्वाइप करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ফেরত নিতে কাউন্টারে চেপে ধরুন বা ফোন ঝাঁকান। জিকির বদলাতে বাঁয়ে বা ডানে সোয়াইপ করুন।"
          }
        }
      }
    },
