    "zakat.fitrahText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS %1$@ yılı için zekât fitrahı kişi başı %2$@ olarak belirledi; bu yaklaşık 2,5 kg ya da 3,5 litre pirince denktir. İl ve ilçe BAZNAS'ları yerel pirinç fiyatına göre farklı tutar belirleyebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS set zakat al-fitr for %1$@ at %2$@ per person, roughly 2.5 kg or 3.5 litres of rice. Provincial and district BAZNAS offices may set a different amount based on local rice prices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS hat die Zakat al-Fitr für %1$@ auf %2$@ pro Person festgelegt, etwa 2,5 kg oder 3,5 Liter Reis. Provinz- und Bezirksstellen von BAZNAS können je nach örtlichem Reispreis einen anderen Betrag festlegen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS %1$@ ili üçün fitrə zəkatını adambaşına %2$@ müəyyən edib; bu, təxminən 2,5 kq və ya 3,5 litr düyüyə bərabərdir. Əyalət və rayon BAZNAS-ları yerli düyü qiymətinə görə fərqli məbləğ müəyyən edə bilər."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حددت BAZNAS زكاة الفطر لعام %1$@ بمبلغ %2$@ للفرد، أي نحو 2.5 كغ أو 3.5 لترات من الأرز. وقد تحدد مكاتب BAZNAS في المحافظات والمناطق مبلغًا مختلفًا حسب سعر الأرز المحلي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS menetapkan zakat fitrah %1$@ sebesar %2$@ per jiwa, setara sekitar 2,5 kg atau 3,5 liter beras. BAZNAS provinsi dan kabupaten/kota dapat menetapkan nilai berbeda sesuai harga beras setempat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS نے %1$@ کے لیے صدقۂ فطر فی کس %2$@ مقرر کیا ہے، جو تقریباً 2.5 کلو یا 3.5 لیٹر چاول کے برابر ہے۔ صوبائی اور ضلعی BAZNAS مقامی چاول کی قیمت کے مطابق مختلف رقم مقرر کر سکتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS زکات فطرهٔ سال %1$@ را برای هر نفر %2$@ تعیین کرده است که تقریباً برابر 2.5 کیلوگرم یا 3.5 لیتر برنج است. دفترهای استانی و شهرستانی BAZNAS ممکن است بسته به قیمت محلی برنج مبلغ دیگری تعیین کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS a fixé la zakat al-fitr %1$@ à %2$@ par personne, soit environ 2,5 kg ou 3,5 litres de riz. Les bureaux provinciaux et de district de BAZNAS peuvent fixer un autre montant selon le prix local du riz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS установил закят аль-фитр на %1$@ год в размере %2$@ на человека — примерно 2,5 кг или 3,5 литра риса. Провинциальные и районные отделения BAZNAS могут установить другую сумму с учётом местной цены риса."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNASは%1$@年のザカート・アル＝フィトルを1人あたり%2$@と定めました。これは米約2.5 kgまたは3.5リットルに相当します。州や県のBAZNASは地元の米価に応じて別の額を定めることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS는 %1$@년 자카트 알피트르를 1인당 %2$@(으)로 정했습니다. 이는 쌀 약 2.5kg 또는 3.5리터에 해당합니다. 주와 군의 BAZNAS는 지역 쌀값에 따라 다른 금액을 정할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS 将 %1$@ 年开斋捐定为每人 %2$@，约合大米 2.5 公斤或 3.5 升。省级和县级 BAZNAS 可根据当地米价规定不同金额。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinakda ng BAZNAS ang zakat al-fitr para sa %1$@ sa %2$@ bawat tao, katumbas ng mga 2.5 kg o 3.5 litro ng bigas. Maaaring magtakda ng ibang halaga ang mga BAZNAS ng lalawigan at distrito ayon sa lokal na presyo ng bigas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS กำหนดซะกาตฟิฏเราะฮ์ปี %1$@ ไว้ที่คนละ %2$@ เท่ากับข้าวประมาณ 2.5 กก. หรือ 3.5 ลิตร สำนักงาน BAZNAS ระดับจังหวัดและอำเภออาจกำหนดจำนวนต่างกันตามราคาข้าวในท้องถิ่น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS fijó el zakat al-fitr de %1$@ en %2$@ por persona, unos 2,5 kg o 3,5 litros de arroz. Las oficinas provinciales y de distrito de BAZNAS pueden fijar otra cantidad según el precio local del arroz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O BAZNAS fixou o zakat al-fitr de %1$@ em %2$@ por pessoa, cerca de 2,5 kg ou 3,5 litros de arroz. Os escritórios provinciais e distritais do BAZNAS podem fixar outro valor conforme o preço local do arroz."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS ने %1$@ के लिए सदक़ा-ए-फ़ित्र प्रति व्यक्ति %2$@ तय किया है, जो लगभग 2.5 किलो या 3.5 लीटर चावल के बराबर है। प्रांतीय और ज़िला BAZNAS स्थानीय चावल के दाम के अनुसार अलग राशि तय कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "BAZNAS %1$@ সালের সদকাতুল ফিতর মাথাপিছু %2$@ নির্ধারণ করেছে, যা প্রায় 2.5 কেজি বা 3.5 লিটার চালের সমান। প্রাদেশিক ও জেলা BAZNAS স্থানীয় চালের দাম অনুযায়ী ভিন্ন পরিমাণ নির্ধারণ করতে পারে।"
          }
        }
      }
    },
    "zakat.fidyahText": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruç tutamayanlar için fidye (BAZNAS %1$@): günlük kişi başı %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fidyah for those unable to fast (BAZNAS %1$@): %2$@ per person per day."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fidya für Menschen, die nicht fasten können (BAZNAS %1$@): %2$@ pro Person und Tag."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruc tuta bilməyənlər üçün fidyə (BAZNAS %1$@): adambaşına gündə %2$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفدية لمن لا يستطيع الصيام (BAZNAS %1$@): %2$@ للفرد عن كل يوم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fidyah bagi yang tidak mampu berpuasa (BAZNAS %1$@): %2$@ per jiwa per hari."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روزہ نہ رکھ سکنے والوں کے لیے فدیہ (BAZNAS %1$@): فی کس روزانہ %2$@۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فدیه برای کسانی که نمی‌توانند روزه بگیرند (BAZNAS %1$@): روزانه برای هر نفر %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fidya pour les personnes qui ne peuvent pas jeûner (BAZNAS %1$@) : %2$@ par personne et par jour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фидья для тех, кто не может поститься (BAZNAS, %1$@): %2$@ на человека в день."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食できない人のフィドヤ（BAZNAS %1$@年）：1人1日あたり%2$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식할 수 없는 사람을 위한 피드야(BAZNAS %1$@년): 1인당 하루 %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法斋戒者的罚赎（BAZNAS %1$@ 年）：每人每天 %2$@。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Fidyah para sa hindi makapag-ayuno (BAZNAS %1$@): %2$@ bawat tao bawat araw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟิดยะฮ์สำหรับผู้ที่ถือศีลอดไม่ได้ (BAZNAS %1$@): คนละ %2$@ ต่อวัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fidya para quienes no pueden ayunar (BAZNAS %1$@): %2$@ por persona y día."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fidya para quem não pode jejuar (BAZNAS %1$@): %2$@ por pessoa por dia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोज़ा न रख सकने वालों के लिए फ़िद्या (BAZNAS %1$@): प्रति व्यक्ति प्रतिदिन %2$@।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রোজা রাখতে অক্ষমদের জন্য ফিদিয়া (BAZNAS %1$@): মাথাপিছু দৈনিক %2$@।"
          }
        }
      }
    },
