        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้การละศีลอดอุดมสมบูรณ์และซะฮูรสงบสุข"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que sus iftares sean abundantes y sus suhur tranquilos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que os seus iftares sejam fartos e os seus suhur tranquilos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका इफ़्तार बरकत वाला और सहरी सुकून भरी हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ইফতার বরকতময় ও সাহরি শান্তিময় হোক।"
          }
        }
      }
    },
    "greet.m.ramadan.6": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahmet ayı hepimize hayırlar getirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May the month of mercy bring goodness to us all."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möge der Monat der Barmherzigkeit uns allen Gutes bringen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rəhmət ayı hamımıza xeyir gətirsin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جعل الله شهر الرحمة خيرًا لنا جميعًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga bulan rahmat membawa kebaikan bagi kita semua."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رحمت کا مہینہ ہم سب کے لیے خیر لائے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ماه رحمت برای همهٔ ما خیر بیاورد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que le mois de la miséricorde nous apporte à tous du bien."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть месяц милосердия принесёт добро всем нам."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "慈悲の月が私たちみんなに幸いをもたらしますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자비의 달이 우리 모두에게 좋은 일을 가져오길 바랍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "愿慈悯之月给我们所有人带来美好。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawa'y magdala ng kabutihan sa ating lahat ang buwan ng awa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้เดือนแห่งความเมตตานำสิ่งดีงามมาสู่พวกเราทุกคน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que el mes de la misericordia nos traiga bien a todos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que o mês da misericórdia traga o bem a todos nós."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रहमत का महीना हम सबके लिए भलाई लाए।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রহমতের মাস আমাদের সবার জন্য কল্যাণ বয়ে আনুক।"
          }
        }
      }
    },
    "greet.m.rb.1": {
