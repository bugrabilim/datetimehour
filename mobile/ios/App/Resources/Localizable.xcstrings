    "cals.zoroastrian.desc": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parsilerin çoğunun kullandığı Şehinşahi takvimine göre tarih, Navroz, Khordad Sal, Muktad ve altı Gahambar bayramı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date in the Shahenshahi calendar used by most Parsis, with Navroz, Khordad Sal, Muktad and the six Gahambars."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum im Shahenshahi-Kalender der meisten Parsen, mit Navroz, Khordad Sal, Muktad und den sechs Gahambars."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Parsilərin çoxunun istifadə etdiyi Şahənşahi təqviminə görə tarix, Navroz, Xordad Sal, Muktad və altı Qahambar bayramı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ في التقويم الشاهنشاهي الذي يستخدمه معظم البارسيين، مع نوروز وخرداد سال والمكتاد والغاهانبارات الستة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal menurut kalender Shahenshahi yang dipakai sebagian besar kaum Parsi, dengan Navroz, Khordad Sal, Muktad, dan enam Gahambar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ تر پارسیوں کے شہنشاہی کیلنڈر کے مطابق تاریخ، نوروز، خرداد سال، مکتاد اور چھ گہمبار۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ در گاه‌شماری شاهنشاهی که بیشتر پارسیان به کار می‌برند، با نوروز، خردادسال، مکتاد و شش گاهنبار."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date du calendrier shahenshahi suivi par la plupart des Parsis, avec Navroz, Khordad Sal, Muktad et les six Gahambars."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата по календарю шахеншахи, которым пользуется большинство парсов, с Навросом, Хордад Салом, Муктадом и шестью гахамбарами."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くのパールシーが用いるシャヘンシャーヒー暦の日付と、ナウローズ、ホルダード・サール、ムクタード、6つのガーハンバール。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 파르시가 쓰는 샤헨샤히력의 날짜와 나우로즈, 호르다드 살, 묵타드, 여섯 가함바르."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多数帕西人使用的沙恒沙希历日期，以及诺鲁孜节、霍尔达德萨尔、穆克塔德和六个加罕巴尔节。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang petsa sa kalendaryong Shahenshahi na gamit ng karamihan ng mga Parsi, kasama ang Navroz, Khordad Sal, Muktad at ang anim na Gahambar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ตามปฏิทินชาเฮนชาฮีที่ชาวปาร์ซีส่วนใหญ่ใช้ พร้อมนาวรอซ คอร์ดาดซาล มุกตาด และเทศกาลกาฮัมบาร์หกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha del calendario shahenshahi que usan la mayoría de los parsis, con Navroz, Khordad Sal, Muktad y los seis gahambars."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A data no calendário shahenshahi usado pela maioria dos parses, com Navroz, Khordad Sal, Muktad e os seis gahambars."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकांश पारसियों के शहंशाही पंचांग के अनुसार तिथि, नवरोज़, ख़ोरदाद साल, मुक्ताद और छह गहंबार।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেশিরভাগ পার্সির শাহেনশাহি পঞ্জিকা অনুযায়ী তারিখ, নওরোজ, খোরদাদ সাল, মুক্তাদ এবং ছয়টি গাহাম্বার।"
          }
        }
      }
    },
    "cals.zoroastrian.note": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şehinşahi takvimi 30 günlük 12 ay ve 5 Gatha gününden oluşur; artık gün olmadığı için yılbaşı dört yılda bir gün geriye kayar. Kadimi yılbaşı Şehinşahi'den 30 gün önce gelir. İran'daki Zerdüştlerin çoğu Fasli (Bastani) takvimini kullanır ve yılbaşını 21 Mart'ta kutlar. Yıl Yezdicerd çağına (YZ) göredir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Shahenshahi calendar has twelve 30-day months and five Gatha days; with no leap day, New Year moves back one day every four years. Kadmi New Year comes 30 days before the Shahenshahi one. Most Zoroastrians in Iran use the Fasli (Bastani) calendar and celebrate New Year on 21 March. Years count from the Yazdegerd era (YZ)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Shahenshahi-Kalender hat zwölf Monate zu 30 Tagen und fünf Gatha-Tage; ohne Schalttag rückt Neujahr alle vier Jahre um einen Tag zurück. Das Kadmi-Neujahr liegt 30 Tage vor dem Shahenshahi-Neujahr. Die meisten Zoroastrier in Iran nutzen den Fasli-(Bastani-)Kalender und feiern Neujahr am 21. März. Die Jahre zählen nach der Yazdegerd-Ära (YZ)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şahənşahi təqvimi 30 günlük 12 ay və 5 Qata günündən ibarətdir; artıq gün olmadığından yeni il dörd ildə bir gün geri sürüşür. Qədimi yeni ili Şahənşahidən 30 gün əvvəl gəlir. İrandakı zərdüştilərin çoxu Fasli (Bastani) təqvimindən istifadə edir və yeni ili 21 martda qeyd edir. İllər Yəzdəgerd erasına (YZ) görədir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتألف التقويم الشاهنشاهي من اثني عشر شهرًا كل منها 30 يومًا وخمسة أيام للغاثا؛ ولأنه بلا يوم كبيس يتراجع رأس السنة يومًا كل أربع سنوات. يأتي رأس السنة القديمي قبل الشاهنشاهي بثلاثين يومًا. يستخدم معظم زرادشتيي إيران التقويم الفصلي (الباستاني) ويحتفلون برأس السنة في 21 مارس. تُعدّ السنوات من العصر اليزدجردي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender Shahenshahi terdiri atas 12 bulan masing-masing 30 hari dan 5 hari Gatha; karena tanpa hari kabisat, Tahun Baru mundur sehari setiap empat tahun. Tahun Baru Kadmi jatuh 30 hari sebelum Tahun Baru Shahenshahi. Sebagian besar penganut Zoroaster di Iran memakai kalender Fasli (Bastani) dan merayakan Tahun Baru pada 21 Maret. Tahun dihitung menurut era Yazdegerd (YZ)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شہنشاہی کیلنڈر میں 30 دن کے بارہ مہینے اور پانچ گاتھا کے دن ہوتے ہیں؛ لیپ کا دن نہ ہونے سے نیا سال ہر چار سال میں ایک دن پیچھے آ جاتا ہے۔ قدیمی نیا سال شہنشاہی سے 30 دن پہلے آتا ہے۔ ایران کے زیادہ تر زرتشتی فصلی (باستانی) کیلنڈر استعمال کرتے ہیں اور نیا سال 21 مارچ کو مناتے ہیں۔ سال یزدگردی دور سے گنے جاتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گاه‌شماری شاهنشاهی دوازده ماه سی‌روزه و پنج روز گاتا دارد؛ چون روز کبیسه ندارد، آغاز سال هر چهار سال یک روز عقب می‌رود. سال نو قدیمی سی روز پیش از شاهنشاهی است. بیشتر زرتشتیان ایران گاه‌شماری فصلی (باستانی) را به کار می‌برند و نوروز را در 21 مارس (1 فروردین) جشن می‌گیرند. سال‌ها از مبدأ یزدگردی شمرده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier shahenshahi compte douze mois de 30 jours et cinq jours Gatha ; sans jour bissextile, le Nouvel An recule d’un jour tous les quatre ans. Le Nouvel An kadmi a lieu 30 jours avant le shahenshahi. La plupart des zoroastriens d’Iran suivent le calendrier fasli (bastani) et fêtent le Nouvel An le 21 mars. Les années comptent depuis l’ère de Yazdegerd (YZ)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В календаре шахеншахи двенадцать месяцев по 30 дней и пять дней Гат; високосного дня нет, поэтому Новый год каждые четыре года сдвигается на день назад. Новый год кадми наступает на 30 дней раньше. Большинство зороастрийцев Ирана пользуются календарём фасли (бастани) и встречают Новый год 21 марта. Годы считаются от эры Йездегерда (YZ)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャヘンシャーヒー暦は30日の月が12か月と5日のガーサーの日からなり、閏日がないため新年は4年ごとに1日早まります。カドミー暦の新年はシャヘンシャーヒー暦の30日前です。イランのゾロアスター教徒の多くはファスリー（バースターニー）暦を用い、3月21日に新年を祝います。年はヤズデギルド紀元（YZ）で数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샤헨샤히력은 30일짜리 열두 달과 닷새의 가타 날로 이루어지며, 윤일이 없어 새해가 4년마다 하루씩 앞당겨집니다. 카드미력 새해는 샤헨샤히력보다 30일 빠릅니다. 이란의 조로아스터교도 대부분은 파슬리(바스타니)력을 써서 3월 21일에 새해를 맞습니다. 해는 야즈데게르드 기원(YZ)으로 셉니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙恒沙希历有12个各30天的月和5个伽萨日；因为没有闰日，新年每四年提前一天。卡德米历新年比沙恒沙希历早30天。伊朗的琐罗亚斯德教徒多使用法斯利（巴斯塔尼）历，在3月21日庆祝新年。纪年采用伊嗣俟纪元（YZ）。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May labindalawang buwan na tig-30 araw at limang araw ng Gatha ang kalendaryong Shahenshahi; dahil walang leap day, umuurong nang isang araw ang Bagong Taon tuwing apat na taon. 30 araw na mas maaga ang Bagong Taon ng Kadmi. Kalendaryong Fasli (Bastani) ang gamit ng karamihan ng mga Zoroastriano sa Iran, at ipinagdiriwang nila ang Bagong Taon sa 21 Marso. Binibilang ang taon mula sa panahon ni Yazdegerd (YZ)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินชาเฮนชาฮีมี 12 เดือน เดือนละ 30 วัน และวันคาถาอีก 5 วัน ไม่มีวันอธิกสุรทิน วันขึ้นปีใหม่จึงเลื่อนเร็วขึ้นหนึ่งวันทุกสี่ปี ปีใหม่แบบกัดมีมาก่อนชาเฮนชาฮี 30 วัน ชาวโซโรอัสเตอร์ในอิหร่านส่วนใหญ่ใช้ปฏิทินฟัสลี (บัสตานี) และฉลองปีใหม่วันที่ 21 มีนาคม ปีนับตามศักราชยัซเดเกิร์ด (YZ)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario shahenshahi tiene doce meses de 30 días y cinco días gatha; como no tiene día bisiesto, el Año Nuevo retrocede un día cada cuatro años. El Año Nuevo kadmi llega 30 días antes que el shahenshahi. La mayoría de los zoroastrianos de Irán siguen el calendario fasli (bastani) y celebran el Año Nuevo el 21 de marzo. Los años se cuentan desde la era de Yazdegerd (YZ)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário shahenshahi tem doze meses de 30 dias e cinco dias gatha; sem dia bissexto, o Ano-Novo recua um dia a cada quatro anos. O Ano-Novo kadmi vem 30 dias antes do shahenshahi. A maioria dos zoroastristas do Irã usa o calendário fasli (bastani) e celebra o Ano-Novo em 21 de março. Os anos contam a partir da era de Yazdegerd (YZ)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शहंशाही पंचांग में 30 दिन के बारह महीने और पाँच गाथा दिवस होते हैं; अधिवर्ष का दिन न होने से नववर्ष हर चार वर्ष में एक दिन पीछे खिसकता है। क़दमी नववर्ष शहंशाही से 30 दिन पहले आता है। ईरान के अधिकांश ज़रथुश्त्री फ़सली (बास्तानी) पंचांग मानते हैं और 21 मार्च को नववर्ष मनाते हैं। वर्ष यज़्दगर्दी संवत (YZ) से गिने जाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শাহেনশাহি পঞ্জিকায় 30 দিনের বারোটি মাস ও পাঁচটি গাথা দিবস; অধিবর্ষের দিন না থাকায় নববর্ষ প্রতি চার বছরে এক দিন পিছিয়ে যায়। কাদমি নববর্ষ শাহেনশাহির 30 দিন আগে আসে। ইরানের বেশিরভাগ জরথুস্ত্রীয় ফাসলি (বাস্তানি) পঞ্জিকা মানেন এবং 21 মার্চ নববর্ষ পালন করেন। বছর গোনা হয় ইয়াজদেগার্দ অব্দ (YZ) থেকে।"
          }
        }
      }
    },
