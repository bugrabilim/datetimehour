    "nature.crescentCats.C": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce dürbünle bulunursa gözle görülebilir"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May need binoculars to find, then naked eye"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Evtl. erst mit Fernglas auffindbar, dann mit bloßem Auge sichtbar"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapmaq üçün durbin lazım ola bilər, sonra çılpaq gözlə görünür"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يحتاج إلى منظار لتحديد موضعه، ثم يُرى بالعين المجردة"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mungkin perlu teropong untuk menemukannya, lalu terlihat dengan mata telanjang"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈھونڈنے کے لیے بائنوکیولر درکار ہو سکتا ہے، پھر ننگی آنکھ سے نظر آتا ہے"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شاید برای یافتن آن دوربین دوچشمی لازم باشد، سپس با چشم غیرمسلح دیده می‌شود"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumelles parfois nécessaires pour le repérer, puis visible à l’œil nu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найти может помочь бинокль, затем виден невооружённым глазом"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つけるのに双眼鏡が必要な場合あり、その後は肉眼で見える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쌍안경으로 찾은 뒤 맨눈으로 보일 수 있음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需先用双筒望远镜找到，然后肉眼可见"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Baka kailangan ng binocular para mahanap, saka makikita ng mata"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาจต้องใช้กล้องสองตาหาก่อน แล้วจึงเห็นด้วยตาเปล่า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede requerir prismáticos para encontrarla, luego a simple vista"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode exigir binóculos para achar, depois a olho nu"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ढूँढने के लिए दूरबीन लग सकती है, फिर नंगी आँखों से"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খুঁজতে দুরবিন লাগতে পারে, তারপর খালি চোখে"
          }
        }
      }
    },
    "nature.crescentCats.D": {
      "extractionState": "manual",
      "localizations": {
