          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت و تاریخ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heure & Date"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время и дата"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻と日付"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간과 날짜"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
