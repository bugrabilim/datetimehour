{
  "sourceLanguage": "tr",
  "strings": {
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulunduğunuz yerin namaz vakitlerini, kıble yönünü, yakındaki camileri ve hava durumunu göstermek için. Vakitler ve kıble telefonda hesaplanır; hava durumu ve cami araması için yalnız yaklaşık konum Apple'ın servislerine gönderilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show prayer times, the qibla direction, nearby mosques and the weather for where you are. Prayer times and the qibla are calculated on your phone; for the weather and the mosque search only an approximate location is sent to Apple's services."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Gebetszeiten, die Qibla-Richtung, Moscheen in der Nähe und das Wetter für Ihren Ort anzuzeigen. Gebetszeiten und Qibla werden auf dem Telefon berechnet; für Wetter und Moscheesuche wird nur ein ungefährer Ort an Apples Dienste gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Olduğunuz yerin namaz vaxtlarını, qiblə istiqamətini, yaxınlıqdakı məscidləri və havasını göstərmək üçün. Vaxtlar və qiblə telefonda hesablanır; hava və məscid axtarışı üçün yalnız təxmini məkan Apple-ın xidmətlərinə göndərilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعرض أوقات الصلاة واتجاه القبلة والمساجد القريبة والطقس في مكانك. تُحسب الأوقات والقبلة على هاتفك؛ ولأجل الطقس والبحث عن المساجد يُرسل موقع تقريبي فقط إلى خدمات Apple."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Tarih"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time & Date"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhr & Datum"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Tarix"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوقت والتاريخ"
          }
        }
      }
    },
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurduğunuz alarm ve zamanlayıcıların telefon sessizdeyken de çalması için."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So that the alarms and timers you set ring even when the phone is silenced."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit Ihre Wecker und Timer auch im Stummmodus klingeln."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qurduğunuz alarm və taymerlərin telefon səssizdə olanda da çalması üçün."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى ترن المنبهات والمؤقتات التي تضبطها حتى عندما يكون الهاتف صامتًا."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimlerinizdeki etkinlikleri uygulamadaki takvimde göstermek ve silmenize izin vermek için. Etkinlikler yalnız telefonda kullanılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show the events in your calendars in the app's calendar and let you delete them. Events are used only on your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Termine Ihrer Kalender im Kalender der App anzuzeigen und Löschen zu ermöglichen. Termine werden nur auf dem Telefon verwendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təqvimlərinizdəki tədbirləri tətbiqin təqvimində göstərmək və silməyinizə icazə vermək üçün. Tədbirlər yalnız telefonda istifadə olunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعرض أحداث تقويماتك في تقويم التطبيق والسماح لك بحذفها. تُستخدم الأحداث على هاتفك فقط."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm kapatma görevi için kaydettiğiniz QR kodu ya da barkodu okumak için. Görüntü telefonda işlenir, kaydedilmez ve hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To scan the QR code or barcode you saved for an alarm's dismiss task. The image is processed on your phone, not stored and not sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Scannen des QR-Codes oder Barcodes, den Sie für die Aufgabe eines Weckers gespeichert haben. Das Bild wird auf dem Telefon verarbeitet, nicht gespeichert und nirgendwohin gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəngin söndürmə tapşırığı üçün yadda saxladığınız QR kodu ya da barkodu oxumaq üçün. Görüntü telefonda işlənir, saxlanılmır və heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمسح رمز QR أو الباركود الذي حفظته لمهمة إيقاف المنبّه. تُعالج الصورة على هاتفك ولا تُحفظ ولا تُرسل إلى أي مكان."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biten aralık antrenmanlarını ve rutinleri, siz açarsanız, Sağlık uygulamasına antrenman olarak yazmak için. Uygulama Sağlık verilerinizi okumaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To write finished interval workouts and routines to the Health app as workouts, if you turn it on. The app does not read your health data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um beendete Intervalltrainings und Routinen als Trainings in Health einzutragen, wenn Sie es einschalten. Die App liest Ihre Gesundheitsdaten nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz açsanız, bitən aralıq məşqlərini və rutinləri Sağlamlıq tətbiqinə məşq kimi yazmaq üçün. Tətbiq sağlamlıq məlumatlarınızı oxumur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتسجيل التمارين المتقطعة والروتينات المنتهية في تطبيق الصحة كتمارين، إذا فعّلت ذلك. لا يقرأ التطبيق بياناتك الصحية."
          }
        }
      }
    }
  },
  "version": "1.0"
}
