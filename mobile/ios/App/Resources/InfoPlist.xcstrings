    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurduğunuz alarm ve zamanlayıcıların telefon sessizdeyken de çalması için."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So that the alarms and timers you set ring even when the phone is silenced."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit Ihre Wecker und Timer auch im Stummmodus klingeln."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qurduğunuz alarm və taymerlərin telefon səssizdə olanda da çalması üçün."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكي ترن المنبهات والمؤقتات التي تضبطها حتى عندما يكون الهاتف صامتًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar alarm dan pengatur waktu yang Anda pasang tetap berbunyi meski ponsel dalam mode senyap."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاکہ آپ کے لگائے ہوئے الارم اور ٹائمر فون خاموش ہونے پر بھی بجیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا هشدارها و تایمرهایی که تنظیم می‌کنید حتی وقتی گوشی بی‌صداست زنگ بزنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que les alarmes et minuteurs que vous réglez sonnent même quand le téléphone est en silencieux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы заданные будильники и таймеры звонили, даже когда телефон в беззвучном режиме."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定したアラームとタイマーがマナーモードでも鳴るようにするためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 알람과 타이머가 무음 모드에서도 울리도록 하기 위해서입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让您设置的闹钟和计时器在手机静音时也能响起。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tumunog ang mga alarma at timer na itinakda mo kahit naka-silent ang telepono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้นาฬิกาปลุกและตัวจับเวลาที่คุณตั้งไว้ดังแม้ปิดเสียงโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que las alarmas y los temporizadores que ponga suenen aunque el teléfono esté en silencio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que os alarmes e temporizadores que você criar toquem mesmo com o celular no silencioso."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताकि आपके लगाए अलार्म और टाइमर फ़ोन साइलेंट होने पर भी बजें।"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimlerinizdeki etkinlikleri uygulamadaki takvimde göstermek ve silmenize izin vermek için. Etkinlikler yalnız telefonda kullanılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show the events in your calendars in the app's calendar and let you delete them. Events are used only on your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Termine Ihrer Kalender im Kalender der App anzuzeigen und Ihnen das Löschen zu ermöglichen. Termine werden nur auf dem Telefon verwendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təqvimlərinizdəki tədbirləri tətbiqin təqvimində göstərmək və silməyinizə icazə vermək üçün. Tədbirlər yalnız telefonda istifadə olunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعرض أحداث تقويماتك في تقويم التطبيق والسماح لك بحذفها. تُستخدم الأحداث على هاتفك فقط."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menampilkan acara di kalender Anda pada kalender aplikasi dan memungkinkan Anda menghapusnya. Acara hanya digunakan di ponsel Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کیلنڈرز کی تقریبات ایپ کے کیلنڈر میں دکھانے اور آپ کو انہیں حذف کرنے کی سہولت دینے کے لیے۔ تقریبات صرف آپ کے فون پر استعمال ہوتی ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای نمایش رویدادهای تقویم‌های شما در تقویم برنامه و امکان حذف آن‌ها. رویدادها فقط روی گوشی شما به کار می‌روند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour afficher les événements de vos calendriers dans le calendrier de l’app et vous permettre de les supprimer. Les événements sont utilisés uniquement sur votre téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы показывать события ваших календарей в календаре приложения и позволить их удалять. События используются только на телефоне."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーの予定をアプリのカレンダーに表示し、削除できるようにするためです。予定はスマホ上でだけ使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력의 일정을 앱 달력에 보여 주고 삭제할 수 있도록 하기 위해서입니다. 일정은 휴대폰에서만 쓰입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在应用的日历中显示您日历里的日程，并允许您删除。日程只在手机上使用。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ipakita ang mga event ng iyong mga kalendaryo sa kalendaryo ng app at para mabura mo ang mga ito. Sa telepono lang ginagamit ang mga event."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อแสดงกิจกรรมในปฏิทินของคุณในปฏิทินของแอปและให้คุณลบได้ กิจกรรมใช้บนโทรศัพท์เท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mostrar los eventos de sus calendarios en el calendario de la app y permitirle borrarlos. Los eventos solo se usan en su teléfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mostrar os eventos dos seus calendários no calendário do app e permitir que você os apague. Os eventos são usados só no seu celular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कैलेंडरों के इवेंट ऐप के कैलेंडर में दिखाने और आपको उन्हें हटाने देने के लिए। इवेंट केवल आपके फ़ोन पर इस्तेमाल होते हैं।"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm kapatma görevleri (QR kod, fotoğraf, nesne bulma) ve kıble kamera görünümü için. Görüntü telefonda işlenir, kaydedilmez ve hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For alarm dismiss tasks (QR code, photo, finding an object) and the qibla camera view. The image is processed on your phone, not stored and not sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Alarm-Aufgaben (QR-Code, Foto, Gegenstand finden) und die Qibla-Kameraansicht. Das Bild wird auf dem Telefon verarbeitet, nicht gespeichert und nirgendwohin gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəngli saatı söndürmə tapşırıqları (QR kod, şəkil, əşya tapma) və qiblə kamera görünüşü üçün. Görüntü telefonda işlənir, saxlanmır və heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمهام إيقاف المنبه (رمز QR، صورة، العثور على شيء) ولعرض القبلة بالكاميرا. تُعالَج الصورة على هاتفك ولا تُحفظ ولا تُرسل إلى أي مكان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk tugas mematikan alarm (kode QR, foto, menemukan benda) dan tampilan kamera kiblat. Gambar diproses di ponsel, tidak disimpan dan tidak dikirim ke mana pun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم بند کرنے کے کاموں (QR کوڈ، تصویر، چیز تلاش کرنا) اور قبلہ کیمرا منظر کے لیے۔ تصویر فون پر پروسیس ہوتی ہے، محفوظ نہیں ہوتی اور کہیں نہیں بھیجی جاتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای کارهای خاموش کردن هشدار (کد QR، عکس، پیدا کردن شیء) و نمای دوربین قبله. تصویر روی گوشی پردازش می‌شود، ذخیره نمی‌شود و به جایی فرستاده نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les tâches d'arrêt d'alarme (code QR, photo, trouver un objet) et la vue caméra de la qibla. L'image est traitée sur le téléphone, ni enregistrée ni envoyée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для заданий отключения будильника (QR-код, фото, поиск предмета) и вида киблы с камеры. Изображение обрабатывается на телефоне, не сохраняется и никуда не отправляется."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラーム停止タスク（QRコード、写真、物を探す）とキブラのカメラ表示のため。映像は端末内で処理され、保存も送信もされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 끄기 과제(QR 코드, 사진, 물건 찾기)와 키블라 카메라 보기에 사용합니다. 영상은 휴대폰에서 처리되며 저장되거나 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于关闭闹钟的任务（二维码、照片、找到物品）和朝向相机视图。图像在手机上处理，不会保存或发送。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa mga gawain sa pagpatay ng alarma (QR code, larawan, paghahanap ng bagay) at qibla camera view. Pinoproseso ang larawan sa telepono, hindi sine-save at hindi ipinapadala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับงานปิดนาฬิกาปลุก (คิวอาร์โค้ด รูปถ่าย หาสิ่งของ) และมุมมองกล้องกิบลัต ภาพถูกประมวลผลในโทรศัพท์ ไม่ถูกบันทึกและไม่ถูกส่งไปที่ใด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para las tareas que apagan la alarma (código QR, foto, buscar un objeto) y la vista de cámara de la alquibla. La imagen se procesa en su teléfono, no se guarda ni se envía a ninguna parte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para as tarefas que desligam o alarme (código QR, foto, encontrar um objeto) e a visão de câmera da qibla. A imagem é processada no seu celular, não é guardada nem enviada a lugar nenhum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म बंद करने वाले कार्यों (QR कोड, फ़ोटो, चीज़ ढूँढना) और क़िबला कैमरा दृश्य के लिए। तस्वीर आपके फ़ोन पर संसाधित होती है, न सहेजी जाती है न कहीं भेजी जाती है।"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biten aralık antrenmanlarını ve rutinleri, siz açarsanız, Sağlık uygulamasına antrenman olarak yazmak için. Uygulama Sağlık verilerinizi okumaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To write finished interval workouts and routines to the Health app as workouts, if you turn it on. The app does not read your health data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um beendete Intervalltrainings und Routinen als Trainings in Health einzutragen, wenn Sie es einschalten. Die App liest Ihre Gesundheitsdaten nicht."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz açsanız, bitən interval məşqlərini və rutinləri Sağlamlıq tətbiqinə məşq kimi yazmaq üçün. Tətbiq sağlamlıq məlumatlarınızı oxumur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتسجيل التمارين المتقطعة والروتينات المنتهية في تطبيق الصحة كتمارين، إذا فعّلت ذلك. لا يقرأ التطبيق بياناتك الصحية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menulis latihan interval dan rutinitas yang selesai ke app Kesehatan sebagai latihan, jika Anda mengaktifkannya. Aplikasi tidak membaca data kesehatan Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ آن کریں تو مکمل وقفہ وار ورزشیں اور روٹینز ہیلتھ ایپ میں ورزش کے طور پر لکھنے کے لیے۔ ایپ آپ کا صحت کا ڈیٹا نہیں پڑھتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای نوشتن تمرین‌های تناوبی و برنامه‌های تمام‌شده در برنامهٔ سلامت، اگر روشنش کنید. برنامه دادهٔ سلامت شما را نمی‌خواند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour écrire dans l’app Santé, si vous l’activez, les entraînements fractionnés et routines terminés. L’app ne lit pas vos données de santé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы записывать завершённые интервальные тренировки и программы в приложение «Здоровье» как тренировки, если вы включите эту функцию. Приложение не читает данные о здоровье."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにした場合に、終えたインターバルトレーニングとルーティンをワークアウトとしてヘルスケアアプリに書き込むためです。アプリがあなたの健康データを読むことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜 둔 경우, 마친 인터벌 운동과 루틴을 건강 앱에 운동으로 기록하기 위해서입니다. 앱은 건강 데이터를 읽지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您开启时，把完成的间歇训练和训练计划作为体能训练写入“健康”应用。应用不会读取您的健康数据。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para isulat sa Health app bilang workout ang natapos na interval workout at routine, kung io-on mo ito. Hindi binabasa ng app ang iyong datos pangkalusugan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อบันทึกการออกกำลังกายแบบอินเทอร์วัลและชุดที่ทำเสร็จลงแอปสุขภาพเป็นการออกกำลังกาย หากคุณเปิดใช้ แอปไม่อ่านข้อมูลสุขภาพของคุณ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escribir en la app Salud, como entrenamientos, los entrenamientos por intervalos y rutinas terminados, si lo activa. La app no lee sus datos de salud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para registrar no app Saúde, como treinos, os treinos intervalados e rotinas concluídos, se você ativar. O app não lê seus dados de saúde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप चालू करें, तो पूरे हुए इंटरवल वर्कआउट और रूटीन को Health ऐप में वर्कआउट के रूप में लिखने के लिए। ऐप आपका सेहत डेटा नहीं पढ़ता।"
          }
        }
      }
    },
    "NSAppleMusicUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm sesi olarak müzik arşivinizden bir şarkı seçebilmeniz için. Şarkıdan alınan kısa bölüm telefonda kalır, hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can choose a song from your music library as an alarm sound. The short part taken from the song stays on your phone and is not sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit Sie einen Titel aus Ihrer Musikmediathek als Weckton wählen können. Der kurze Ausschnitt bleibt auf dem Telefon und wird nirgendwohin gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəng səsi kimi musiqi arxivinizdən mahnı seçə biləsiniz deyə. Mahnıdan götürülən qısa hissə telefonda qalır, heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكي تختار أغنية من مكتبة الموسيقى صوتًا للمنبّه. يبقى الجزء القصير المأخوذ من الأغنية على هاتفك ولا يُرسل إلى أي مكان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar Anda dapat memilih lagu dari perpustakaan musik sebagai suara alarm. Potongan singkat dari lagu tetap di ponsel Anda dan tidak dikirim ke mana pun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاکہ آپ اپنی موسیقی لائبریری سے کوئی گانا الارم کی آواز کے طور پر چن سکیں۔ گانے سے لیا گیا مختصر حصہ آپ کے فون پر رہتا ہے اور کہیں نہیں بھیجا جاتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا بتوانید آهنگی از کتابخانهٔ موسیقی‌تان را به‌عنوان صدای هشدار برگزینید. بخش کوتاه برداشته‌شده از آهنگ روی گوشی شما می‌ماند و به جایی فرستاده نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour choisir un morceau de votre bibliothèque musicale comme son d’alarme. Le court extrait reste sur votre téléphone et n’est envoyé nulle part."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы выбрать песню из медиатеки как звук будильника. Короткий отрывок остаётся на телефоне и никуда не отправляется."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージックライブラリの曲をアラーム音に選べるようにするためです。曲から切り出した短い区間はスマホに残り、どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 보관함의 곡을 알람 소리로 고를 수 있도록 하기 위해서입니다. 곡에서 잘라 낸 짧은 구간은 휴대폰에 남으며 어디에도 보내지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让您可以从资料库中选择歌曲作为闹钟声音。从歌曲中截取的短片段留在手机上，不会发送到任何地方。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para makapili ka ng kanta mula sa iyong music library bilang tunog ng alarma. Nananatili sa iyong telepono ang maikling bahaging kinuha sa kanta at hindi ipinapadala kahit saan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้คุณเลือกเพลงจากคลังเพลงเป็นเสียงปลุก ช่วงสั้น ๆ ที่ตัดจากเพลงอยู่บนโทรศัพท์และไม่ส่งไปที่ใด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que pueda elegir una canción de su biblioteca de música como sonido de alarma. El breve fragmento tomado de la canción se queda en su teléfono y no se envía a ninguna parte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para você escolher uma música da sua biblioteca como som de alarme. O trecho curto tirado da música fica no seu celular e não é enviado a lugar nenhum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताकि आप अपनी संगीत लाइब्रेरी से कोई गाना अलार्म की आवाज़ के रूप में चुन सकें। गाने से लिया छोटा हिस्सा आपके फ़ोन पर रहता है और कहीं नहीं भेजा जाता।"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm kapatma görevindeki sözü sesli okuduğunuzu anlamak için. Ses yalnız telefonda tanınır, kaydedilmez ve hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To hear you read the saying aloud in the alarm dismiss task. Speech is recognised only on your phone, not recorded and not sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um zu hören, dass Sie den Spruch der Alarm-Aufgabe laut vorlesen. Sprache wird nur auf dem Telefon erkannt, nicht aufgezeichnet und nirgendwohin gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəngli saat tapşırığındakı sözü səsli oxuduğunuzu anlamaq üçün. Səs yalnız telefonda tanınır, yazılmır və heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لسماعك وأنت تقرأ العبارة بصوت عالٍ في مهمة إيقاف المنبه. يُتعرَّف على الكلام على هاتفك فقط، ولا يُسجَّل ولا يُرسل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mendengar Anda membacakan kalimat di tugas mematikan alarm. Suara hanya dikenali di ponsel, tidak direkam dan tidak dikirim."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم بند کرنے کے کام میں قول بلند آواز سے پڑھنا سننے کے لیے۔ آواز صرف فون پر پہچانی جاتی ہے، ریکارڈ نہیں ہوتی اور کہیں نہیں بھیجی جاتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای شنیدن خواندن بلند جمله در کار خاموش کردن هشدار. صدا فقط روی گوشی شناخته می‌شود، ضبط و ارسال نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour entendre la phrase lue à voix haute dans la tâche d'arrêt d'alarme. La voix est reconnue uniquement sur le téléphone, ni enregistrée ni envoyée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы услышать, как вы читаете фразу вслух в задании будильника. Речь распознаётся только на телефоне, не записывается и никуда не отправляется."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラーム停止タスクで言葉を声に出して読んだことを聞き取るため。音声は端末内でのみ認識され、録音も送信もされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 끄기 과제에서 문장을 소리 내어 읽는지 듣기 위해 사용합니다. 음성은 휴대폰에서만 인식되며 녹음되거나 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在关闭闹钟任务中听您大声朗读句子。语音仅在手机上识别，不录音也不发送。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para marinig na binabasa mo nang malakas ang kasabihan sa gawain ng alarma. Kinikilala lang ang boses sa telepono, hindi nire-record at hindi ipinapadala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อฟังว่าคุณอ่านประโยคออกเสียงในงานปิดนาฬิกาปลุก เสียงถูกจดจำในโทรศัพท์เท่านั้น ไม่ถูกบันทึกและไม่ถูกส่ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para oírle leer el refrán en voz alta en la tarea para apagar la alarma. La voz se reconoce solo en su teléfono; no se graba ni se envía a ningún sitio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ouvir você ler o ditado em voz alta na tarefa para desligar o alarme. A fala é reconhecida só no seu celular; não é gravada nem enviada para lugar nenhum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म बंद करने के काम में आपको कहावत ज़ोर से पढ़ते सुनने के लिए। आवाज़ सिर्फ़ आपके फ़ोन पर पहचानी जाती है, न रिकॉर्ड होती है न कहीं भेजी जाती है।"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm kapatma görevindeki sözü sesli okuduğunuzu anlamak için. Ses yalnız telefonda tanınır, kaydedilmez ve hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To hear you read the saying aloud in the alarm dismiss task. Speech is recognised only on your phone, not recorded and not sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um zu hören, dass Sie den Spruch der Alarm-Aufgabe laut vorlesen. Sprache wird nur auf dem Telefon erkannt, nicht aufgezeichnet und nirgendwohin gesendet."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəngli saat tapşırığındakı sözü səsli oxuduğunuzu anlamaq üçün. Səs yalnız telefonda tanınır, yazılmır və heç yerə göndərilmir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لسماعك وأنت تقرأ العبارة بصوت عالٍ في مهمة إيقاف المنبه. يُتعرَّف على الكلام على هاتفك فقط، ولا يُسجَّل ولا يُرسل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mendengar Anda membacakan kalimat di tugas mematikan alarm. Suara hanya dikenali di ponsel, tidak direkam dan tidak dikirim."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم بند کرنے کے کام میں قول بلند آواز سے پڑھنا سننے کے لیے۔ آواز صرف فون پر پہچانی جاتی ہے، ریکارڈ نہیں ہوتی اور کہیں نہیں بھیجی جاتی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای شنیدن خواندن بلند جمله در کار خاموش کردن هشدار. صدا فقط روی گوشی شناخته می‌شود، ضبط و ارسال نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour entendre la phrase lue à voix haute dans la tâche d'arrêt d'alarme. La voix est reconnue uniquement sur le téléphone, ni enregistrée ni envoyée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы услышать, как вы читаете фразу вслух в задании будильника. Речь распознаётся только на телефоне, не записывается и никуда не отправляется."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラーム停止タスクで言葉を声に出して読んだことを聞き取るため。音声は端末内でのみ認識され、録音も送信もされません。"
