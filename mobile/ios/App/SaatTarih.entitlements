<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Uygulamanın yetkileri. Arşiv imzasız alındığı için TestFlight iş akışı bu dosyayla geçici (ad hoc) imza atar;
     dağıtım imzası bu yetkileri korur. App ID'de aynı yetkiler açık olmalı (developer.apple.com → Identifiers). -->
<dict>
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<!-- iCloud anahtar-değer deposu (CloudSync.swift): iPhone, iPad ve Mac arasında ayar eşitleme. Değer elle yazılı
	     ($(TeamIdentifierPrefix) değişkeni geçici imzada açılmaz); App ID'de iCloud açık olmalı. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>3J9XN2P93D.tr.bumba.time</string>
	<!-- Apple Sağlık (HealthKit, Health.swift): biten aralık antrenmanı yalnız yazılır, okunmaz. App ID'de HealthKit açık olmalı. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<!-- App Group (2. analiz #76): şeffaf widget için duvar kâğıdı parçaları uygulama ile widget arasında paylaşılır
	     (WallpaperWidget.swift). App ID'lerde (tr.bumba.time, tr.bumba.time.widget) App Groups açık, grup kayıtlı. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.tr.bumba.time</string>
	</array>
	<!-- Ekran Süresi (FamilyControls, Distribution; Apple 4 Kasım 2026'da onayladı): odakta engelleme ve alarm
	     görevi sürerken silme engeli (FocusBlock.swift). App ID'de Family Controls (Distribution) açık olmalı. -->
	<key>com.apple.developer.family-controls</key>
	<true/>
</dict>
</plist>
