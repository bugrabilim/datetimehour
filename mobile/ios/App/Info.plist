<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Yalnız INFOPLIST_KEY_* ayarıyla verilemeyen anahtarlar; geri kalanı Xcode üretir (GENERATE_INFOPLIST_FILE).
     Diğer dillerdeki metinler App/Resources/InfoPlist.xcstrings içinde (gen-strings.mjs). -->
<dict>
	<key>NSAlarmKitUsageDescription</key>
	<string>Kurduğunuz alarm ve zamanlayıcıların telefon sessizdeyken de çalması için.</string>
	<!-- Başlık yazı tipi Literata (SIL OFL 1.1; Latin + Kiril alt kümesi, 500 ve 600) ve Kur'an/dua Arapçası için Amiri
	     (SIL OFL 1.1, Arapça alt kümesi); doğal tasarım, 4 Kasım 2026. Lisanslar App/Resources/Fonts/OFL-*.txt;
	     üretim mobile/shared/fonts/README.md -->
	<key>UIAppFonts</key>
	<array>
		<string>Literata-Medium.ttf</string>
		<string>Literata-SemiBold.ttf</string>
		<string>Amiri-Regular.ttf</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>tr.bumba.time.refresh</string>
	</array>
	<!-- Odakta engelleme ve alarm sürerken silme engeli (FamilyControls): Apple 4 Kasım 2026'da onayladı (FocusBlock.swift) -->
	<key>SaatFamilyControls</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<!-- Denetim Merkezi düğmeleri ve kısayollar uygulamayı saattarih://fullscreen|timer|stopwatch|alarm|prayer ile açar -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>tr.bumba.time</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>saattarih</string>
			</array>
		</dict>
	</array>
	<!-- Açılış ekranı (2. analiz #83): bekletme yok; boş ekran yerine sitedeki zemin rengi (açık/koyu) ve ortada simge
	     (Assets: LaunchBackground, LaunchIcon). Markayı anlatma yeri ilk açılış sihirbazıdır (#4). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchIcon</string>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Takvimlerinizdeki etkinlikleri uygulamadaki takvimde göstermek ve silmenize izin vermek için. Etkinlikler yalnız telefonda kullanılır.</string>
</dict>
</plist>
