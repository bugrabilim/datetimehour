            android:targetClass="tr.bumba.time.MainActivity"
            android:targetPackage="tr.bumba.time">
            <extra
                android:name="shortcut"
                android:value="timer" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_sc_alarm"
        android:shortcutId="alarm"
        android:shortcutShortLabel="@string/siri_short_alarm">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="tr.bumba.time.MainActivity"
            android:targetPackage="tr.bumba.time">
            <extra
                android:name="shortcut"
                android:value="alarm" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_sc_prayer"
        android:shortcutId="prayer"
        android:shortcutShortLabel="@string/siri_short_prayer">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="tr.bumba.time.MainActivity"
            android:targetPackage="tr.bumba.time">
            <extra
                android:name="shortcut"
                android:value="prayer" />
        </intent>
    </shortcut>
</shortcuts>
