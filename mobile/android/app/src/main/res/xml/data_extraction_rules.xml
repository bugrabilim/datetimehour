<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ yedek kuralları (sunucusuz eşitleme, 30 Ekim 2026): ayarlar ve kayıtlar ("prefs") ile fotoğraflar telefonun
     Google yedeğine ve telefondan telefona aktarıma girer. Telefonda yeniden üretilen bildirim sesleri ("sounds") girmez.
     Cihaza özgü birkaç kayıt geri yüklemeden sonra Prefs.clearRestoredDeviceKeys ile silinir. Hesabın oturumu ("account";
     anahtarı telefonun Keystore'unda, yeni telefonda açılamaz) yedeğe girmez (10 Kasım 2026). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="sounds" />
        <exclude domain="sharedpref" path="account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="sounds" />
        <exclude domain="sharedpref" path="account.xml" />
    </device-transfer>
</data-extraction-rules>
