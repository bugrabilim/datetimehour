<?xml version="1.0" encoding="utf-8"?>
<!-- Gün doğumu ve batımı (2. analiz #15) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView
        android:id="@+id/place"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_accent"
        android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
    <TextView
        android:id="@+id/riseLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" android:layout_marginTop="6dp" android:maxLines="1" />
    <TextView
        android:id="@+id/rise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="24sp" android:textStyle="bold" android:maxLines="1" />
    <TextView
        android:id="@+id/setLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" android:maxLines="1" />
    <TextView
        android:id="@+id/set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="24sp" android:textStyle="bold" android:maxLines="1" />
    <TextView
        android:id="@+id/length"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" android:maxLines="1" />
    <TextView
        android:id="@+id/turn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_accent"
        android:textSize="11sp" android:maxLines="1" />
</LinearLayout>
