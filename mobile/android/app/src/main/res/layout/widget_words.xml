<?xml version="1.0" encoding="utf-8"?>
<!-- Yazıyla tarih (2. analiz #172): gün adı, gün yazıyla, AY, yıl yazıyla -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:id="@+id/weekday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_accent"
        android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
    <TextView
        android:id="@+id/day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="26sp" android:textStyle="bold" android:fontFamily="serif" android:maxLines="2" />
    <TextView
        android:id="@+id/month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="16sp" android:textStyle="bold" android:letterSpacing="0.12" android:maxLines="1" />
    <TextView
        android:id="@+id/year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" android:layout_marginTop="4dp" android:maxLines="2" />
</LinearLayout>
