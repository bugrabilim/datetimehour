<?xml version="1.0" encoding="utf-8"?>
<!-- Günün içeriği (2. analiz #16): söz, ayet, esma ya da hadis; dokununca sıradaki tür -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_accent"
        android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
    <TextView
        android:id="@+id/arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="18sp" android:gravity="end" android:layoutDirection="rtl" android:layout_marginTop="4dp" android:maxLines="5" />
    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="14sp" android:fontFamily="serif" android:layout_marginTop="4dp" android:maxLines="8" />
    <TextView
        android:id="@+id/source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" android:layout_marginTop="4dp" android:maxLines="1" />
</LinearLayout>
