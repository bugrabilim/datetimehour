<?xml version="1.0" encoding="utf-8"?>
<!-- İki saat widget'ı (2. analiz #12): solda burası, sağda seçilen şehir. Android 12+ ikinci kadran şehrin
     diliminde döner (AnalogClock.setTimeZone); daha eskide ikinci şehir dijital (TextClock) gösterilir. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:baselineAligned="false"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <AnalogClock
            android:id="@+id/analog1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:dial="@drawable/widget_dial"
            android:hand_hour="@drawable/widget_hand_hour"
            android:hand_minute="@drawable/widget_hand_minute" />

        <TextView
            android:id="@+id/label1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <AnalogClock
            android:id="@+id/analog2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:dial="@drawable/widget_dial"
            android:hand_hour="@drawable/widget_hand_hour"
            android:hand_minute="@drawable/widget_hand_minute" />

        <TextClock
            android:id="@+id/digital2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="40sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/label2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
