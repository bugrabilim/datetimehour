<?xml version="1.0" encoding="utf-8"?>
<!-- Analog saat widget'ı (Android 12+): saniye ibresiyle; sistemin AnalogClock'u kendi kendine döner -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="6dp">

    <AnalogClock
        android:id="@+id/analog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:dial="@drawable/widget_dial"
        android:hand_hour="@drawable/widget_hand_hour"
        android:hand_minute="@drawable/widget_hand_minute"
        android:hand_second="@drawable/widget_hand_second" />
</FrameLayout>
